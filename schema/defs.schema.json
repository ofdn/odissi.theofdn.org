{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odissi.theofdn.org/schema/defs.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^oa-[a-z]+-[0-9]{6}$"
    },
    "ref_gita": {
      "type": "string",
      "pattern": "^oa-gita-[0-9]{6}$"
    },
    "ref_kabya": {
      "type": "string",
      "pattern": "^oa-kabya-[0-9]{6}$"
    },
    "ref_rendition": {
      "type": "string",
      "pattern": "^oa-rendition-[0-9]{6}$"
    },
    "ref_carrier": {
      "type": "string",
      "pattern": "^oa-carrier-[0-9]{6}$"
    },
    "ref_person": {
      "type": "string",
      "pattern": "^oa-person-[0-9]{6}$"
    },
    "ref_raga": {
      "type": "string",
      "pattern": "^oa-raga-[0-9]{6}$"
    },
    "ref_tala": {
      "type": "string",
      "pattern": "^oa-tala-[0-9]{6}$"
    },
    "ref_collection": {
      "type": "string",
      "pattern": "^oa-collection-[0-9]{6}$"
    },
    "ref_source": {
      "type": "string",
      "pattern": "^oa-source-[0-9]{6}$"
    },
    "name": {
      "description": "en is the romanised name with diacritics (Kāmodī, Tāḷa). or is the name in Odia script.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "or": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "description": "A historical title (upadhi) such as Kabisurjya or Gajapati. Marked where it is in the name, shown before the name where it is not.",
          "$ref": "#/$defs/text"
        },
        "alternates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "as_written": {
          "description": "True when a person's name has no surname, such as Kali Charan. Citations then keep the name as written, not surname first.",
          "const": true
        }
      }
    },
    "text": {
      "description": "A short text in English, Odia or both.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "or": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 2100
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "numbers": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "citation": {
      "description": "Points to a source record. url and archive_url point to the page used, such as one song page on a website.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/ref_source"
        },
        "pages": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "archive_url": {
          "type": "string",
          "format": "uri",
          "description": "Copy of url in the Internet Archive Wayback Machine."
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "entered_by": {
      "description": "Full names of the people who entered this record, or their GitHub usernames (such as @octocat) where no name is given. It records who entered the data and is never used in citations.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "online": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "youtube",
            "internet_archive",
            "spotify",
            "wikimedia_commons",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "uploaded_by": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Start offset in seconds when one upload holds several renditions."
        }
      },
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "record_status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "subtitle": {
          "description": "Shown under the title, such as the rest of a disc or upload title.",
          "$ref": "#/$defs/text"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "archival_note": {
          "description": "An archival note: a formal note on the record, shown under its own heading. Paragraphs are split by a blank line. Cite a source as [@oa-source-000001], with pages as [@oa-source-000001, 12-14]. by lists the people who wrote it.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "or": {
              "type": "string",
              "minLength": 1
            },
            "by": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^oa-person-\\d{6}$"
              }
            }
          }
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "entered_by": {
          "$ref": "#/$defs/entered_by"
        },
        "editors": {
          "description": "Full names of the editors who reviewed this record, cited as editors of The Odissi Archive. Leave it out when Prateek Pattanaik is the only editor. When someone edits with him, list both, him first.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "record_status": {
          "enum": [
            "active",
            "superseded",
            "withdrawn"
          ]
        },
        "superseded_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/date"
        },
        "updated_at": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "common": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        }
      ],
      "required": [
        "name"
      ]
    }
  }
}
