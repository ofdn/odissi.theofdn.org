{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odissi.theofdn.org/schema/gita.schema.json",
  "title": "Gīta",
  "description": "A song: one poem and its tune, made together by the poet.",
  "type": "object",
  "allOf": [
    {
      "$ref": "defs.schema.json#/$defs/common"
    }
  ],
  "required": [
    "poet"
  ],
  "properties": {
    "id": {
      "pattern": "^om-gita-[0-9]{6}$"
    },
    "poet": {
      "$ref": "defs.schema.json#/$defs/ref_person"
    },
    "mula_raga": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/ref_raga"
      },
      "description": "Rāga(s) as the poet marked them (mūḷa svara)."
    },
    "mula_tala": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/ref_tala"
      },
      "description": "Tāḷa(s) as the poet marked them."
    },
    "song_type": {
      "enum": [
        "chaupadi",
        "chhanda",
        "champu",
        "janana",
        "bhajana",
        "malasri",
        "koili",
        "other"
      ]
    },
    "kabya": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/ref_kabya"
        },
        "section": {
          "$ref": "defs.schema.json#/$defs/text",
          "description": "Chapter or part, e.g. Na paṭaḷa."
        },
        "position": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stanzas"
      ],
      "properties": {
        "edition": {
          "$ref": "defs.schema.json#/$defs/citation"
        },
        "stanzas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "lines"
            ],
            "properties": {
              "n": {
                "description": "Stanza number as printed. 0 is the ghoṣā (refrain).",
                "type": "integer",
                "minimum": 0
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        },
        "complete": {
          "type": "boolean",
          "description": "False when the text here is a selection of stanzas."
        }
      }
    },
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "stanzas"
      ],
      "properties": {
        "by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "stanzas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "text"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
