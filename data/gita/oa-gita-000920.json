{
  "id": "oa-gita-000920",
  "name": {
    "en": "Syamabandhu karuna rasa sindhu",
    "or": "ଶ୍ୟାମବନ୍ଧୁ କରୁଣା ରସସିନ୍ଧୁ"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000005"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syamabandhu-karuna-rasa-sindhu-sankarabharana-basanta-rahasa-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମବନ୍ଧୁ କରୁଣା ରସସିନ୍ଧୁ ହେ",
          "ଶ୍ରୀମୁଖ ନିର୍ଜିତ ପାର୍ବଣ ଇନ୍ଦୁ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯୁବାବୃନ୍ଦ ଶିରୋମଣି ମଣ୍ଡନ",
          "ବାସବ ଶ୍ୟାମଳ ରତନ ଶୋଭନ",
          "ନିଦ ଦାସୀ ଗଣେ କୃପାଳୁତା ଗୁଣ",
          "ପ୍ରକାଶିଲ ଆଜି ରାଜୀବଲୋଚନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାଶୀଶ୍ୱର ଶ୍ରୀପଦ ସେବା ଭାବେ",
          "ରସି କି ସୁକୃତ ଅର୍ଜିଥିଲୁଁ ପୂର୍ବେ",
          "ଯାହା ତୁମ୍ଭେ କେଳି ମୁରଲୀ ରବେ",
          "ଡାକିଲ ଆମ୍ଭଙ୍କୁ ରାସ ମହୋତ୍ସବେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜିତ କୋଟି କାମ ରୁଚିର ବେଶ",
          "ବିଲୋକି ଆମ୍ଭର ଧୈର୍ଯ୍ୟ ହୁଏ ନାଶ",
          "ନୃତ୍ୟ ରଙ୍ଗେ ରସି ଆମ୍ଭ ମାନସ",
          "ଭୃତ୍ୟବତ୍ସଳ ହେ ବେଗେ କର ସନ୍ତୋଷ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଞ୍ଜ ମଞ୍ଜତର ମୃଦୁ ଶ୍ରୀପଦ",
          "ରତନ ମଞ୍ଜୀର ମଧୁ ନିନାଦ",
          "ଶୁଣି ଶ୍ରୁତି ମତି ଭଜୁ ପ୍ରମୋଦ",
          "ରାଜେନ୍ଦ୍ର ବନ୍ଦିଲେ ନିତି କୃଷ୍ଣ ପ୍ରପଦ"
        ]
      }
    ]
  },
  "sources": [
    {
