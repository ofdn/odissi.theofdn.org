      "url": "https://odissimusic.co.in/index.php/song/sajani-re-ja-ja-tu-syamare-naata-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀରେ ଯା ଯା ତୁ ଶ୍ୟାମରେ ସମୁଜା",
          "ସାରିଦେଲେ ଲାଜେ ଯା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାଜିଲି କୁଞ୍ଜ ମୁଁ ଶେଯ ବିଛାଇଲି",
          "ଯାମିନୀ ଜାଗି ଉଜାଗରେ ଯାପିଲି",
          "ଅଦୋଷେ ସଜନୀ ବାଜେ ବରଜେ ବାଜା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୟନ କଜ୍ଜ୍ୱଳ ଗଣ୍ଡ ଭରେ ସଖି",
          "ନିଦ ଭୁଲି ଧାର ସାର ପୋଡ଼ା ଆଖି",
          "କବିଚନ୍ଦ୍ର ବୋଲେ ପୀରତିର ଏ ସଜା"
        ]
      }
    ]
  },
