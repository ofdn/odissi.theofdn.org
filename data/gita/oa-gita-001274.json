{
  "id": "oa-gita-001274",
  "name": {
    "en": "Brundabana mandala chhabiki ana",
    "or": "ବୃନ୍ଦାବନ ମଣ୍ଡଳ ଛବିକି ଅନା ଚନ୍ଦ୍ରବଦନା"
  },
  "composer": "oa-person-000152",
  "mula_raga": [
    "oa-raga-000140"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/brundabana-mandala-chhabiki-ana-jayakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବୃନ୍ଦାବନ ମଣ୍ଡଳ ଛବିକି ଅନା ଚନ୍ଦ୍ରବଦନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କିଏ ଜାତ କଲା ଏ ଗୋପ ନଗର",
          "ବଜ୍ର ନ ପଡ଼ିଲା ତାର ମସ୍ତକର",
          "ଇନ୍ଦ୍ରପଦ ଦେଲା ମାନବ ହସ୍ତର",
          "ବାଜିଲା ନାଗରା ବାନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁକକୁ ନିନ୍ଦଇ ନାସିକା ମୁକୁତା",
          "ବାଳ ଅର୍କଲତା ଅଧରେ ଶୋଭିତା",
          "ବାଙ୍କ ଚାହାଣୀ ମାର ଧନୁ ଭ୍ରୂଲତା",
          "କରେ ଶକ୍ର ଗର୍ବ ଚୂନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗଳେ ବନମାଳ କରେ ହେମ ବାଡ଼ି",
          "ଲାଜ ଭୟ ସିନା ଦେଉଛି ଘଉଡ଼ି",
          "ବାଜେ କଟୀରେ ରୁଣଝୁଣ ଘାଗୁଡ଼ି",
          "ହରାଏ ଚିତ୍ତୁ ଚେତନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ଉପଇନ୍ଦ୍ର ବିନୟ ଉତ୍ତର",
          "ଜାଣିଥିଲେ ଛାଡ଼ି ନ ଦିଅନ୍ତି ଏଥର",
          "ଏଥକୁ ଆସିଲେ ନ ହୋଇ କାହାର",
          "ବାଜିଲା ନାଗରା ବାନା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଜୟକୃଷ୍ଣ ଭଣି ରାଧା ବାଣୀ ଶୁଣି",
          "ଜାଣି ଶୁଣି ହେଲୁ ବରଜ ତରୁଣୀ",
          "ନ ରୁଚଇ ମୋତେ ନରୋତ୍ତମ ବାଣୀ",
          "ଯମୁନା କେ କଲା ମନା"
        ]
      }
    ]
  },
  "sources": [
    {
