{
  "id": "oa-gita-000616",
  "name": {
    "en": "Braja ballabha brunda nayaka he",
    "or": "ବ୍ରଜବଲ୍ଲଭ ବୃନ୍ଦ ନାୟକ ହେ"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000083"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/braja-ballabha-brunda-nayaka-he-mangala-gujjari-jadumani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବ୍ରଜବଲ୍ଲଭ ବୃନ୍ଦ ନାୟକ ହେ",
          "ପ୍ରଣତ ସର୍ବ ସୁଖ ଦାୟକ ହେ",
          "ବଲ୍ଲବ ରାଜକୁମାର ବୃନ୍ଦା ଅରଣ୍ୟର ମାର",
          "ବ୍ରଜେଶ୍ୱରୀଙ୍କ ଦୁଃଖ ତ୍ରାୟକ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସ୍ଫୁଟ ସରସୀରୁହ ଲୋଚନ ହେ",
          "ଅଖିଳ ଭବ ଭୟ ମୋଚନ ହେ",
          "ସ୍ୱପରିବାର ସମୂହ ପାଳିତ ସୌମ୍ୟ ବିଗ୍ରହ",
          "କୁଞ୍ଜେଶ୍ୱରୀ ପଦାବ୍ଜ ଅର୍ଚ୍ଚନ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବ ତରୁଣ ନବ ନାଗର ହେ",
          "ନଟ ତିଳକ ରସସାଗର ହେ",
          "ନୟନ ଆନନ୍ଦ ଘନସୁନ୍ଦର ଶ୍ରୀ ଅପଘନ",
          "ନୀଳେନ୍ଦୀବର ନେତ୍ର ଧାରକ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରସିକା କୁଳ ପରିହାସକ ହେ",
          "ରାସ ବିଳାସ ମୃଦୁ ଲାସ୍ୟକ ହେ",
          "ରମଣୀୟ ଲଳିତାଙ୍ଗ ଅନଙ୍ଗ ତରଙ୍ଗ ରଙ୍ଗ",
          "ରହସ୍ୟାମୃତ ଭାଷା ଭାଷକ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତପନ ସୁତା ତଟ ସନ୍ନଟ ହେ",
          "ଶକଟ ଭଞ୍ଜା ରତି ଲମ୍ପଟ ହେ",
          "ତପୀ ମାନସ ହଂସ ତୃଣାବର୍ତ୍ତାଦି ଧ୍ୱଂସ",
          "-କାରକ ମୁରଲୀକା ବାଦକ ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶିଖୀ ଶିଖଣ୍ଡ ପରିଲାଞ୍ଚିତ ହେ",
          "କର ଚିକୁର ଗଭା କୁଞ୍ଚିତ ହେ",
          "ଶ୍ରୀମତୀ ସ୍ତନ ହେମ କୁମ୍ଭ ଯୁଗ ସୁଷମ",
          "ମର୍ଦ୍ଦନକାରୀ ସୁଖ ବାଞ୍ଛିତ ହେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ମଧୁଦ୍ୱିଷ ମଦନ ଗୋପାଳ ହେ",
          "ମହା ନାଗର ରସ ଭୂପାଳ ହେ",
          "ମଧୁ ସୁବଳ ଦାମ ସଙ୍ଗିଆ ପୂର୍ଣ୍ଣକାମ",
          "ବାମ ଦକ୍ଷ ଶ୍ୟାମ କାମପାଳକ ହେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଯଦୁନନ୍ଦନ ଜଗଦ୍‌ବନ୍ଦନ ହେ",
          "ଯାମଳାର୍ଜ୍ଜୁନ ତରୁ ଭଞ୍ଜନ ହେ",
          "ଖେଦ ଯଦୁମଣିର ହର ଯାଦବ ବୀର",
          "ଶୋକ ପାପ ତାପ ବିମର୍ଦ୍ଦନ ହେ"
        ]
      }
    ]
  },
