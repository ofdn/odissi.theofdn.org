{
  "id": "oa-gita-000644",
  "name": {
    "en": "Re mo jibana mu ki",
    "or": "ରେ ମୋ ଜୀବନ ମୁଁ କି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000117"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/re-mo-jibana-mu-ki-bhatiari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରେ ମୋ ଜୀବନ",
          "ମୁଁ କି ମୀନ ମୀନନେତ୍ରା ତୁ ମୋ ଜୀବନ ରେ",
          "ମୋର ମାନସ ବିହଗରାଜି ବନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାକରସାର ମଧୁର ଭାଷୀ",
          "କାରକରକର କିରଣ ହାସୀ",
          "ନାକରମଣୀ କି ଟାକର ମାରୁଛି",
          "ତୋ କର ପଇଠଧରା ଦାସୀ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁସୁମୋତ୍ସବ ବିଚ୍ଛେଦ ଯୁଗୁ",
          "ଲାଗି ଡକାଇତ ଲାଗୁ ଲାଗୁ",
          "ଲଳନା କଳନା ନ ପଡ଼ି କଳା ନା",
          "-ଗବଲ୍ଲୀ ଗେଲେ ମାଗୁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଛାମୁରେ ଛାଇ ନ ପଡ଼ୁ ବୋଲି",
          "ଛଡ଼ା ହୋଇ ମୁଁ ଯେ ଛିଡ଼ା ହେଲି",
          "ଛୁଇଁଲ ଯେ ବୋଲି ଛଇଳୀ ହସି ମୋ",
          "ଛାତିକି ଉରଜେ ଦେଉ ପେଲି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୁ କାହା ଦୁଃଖପାଶୋରା କି ରେ",
          "ବୋଲି ମୁଁ ପଚାରେଁ ପ୍ରେମ ଗିରେ",
          "ତୁମ୍ଭର ବୋଲିବା ଦମ୍ଭରେ ଦମ୍ଭୋଳି",
          "କଚାଡ଼ୁ ମୋ ଦୁଃଖଗିରି ଶିରେ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମେଲାଣି ହେବି କି ଯେବେ ବୋଲେଁ",
          "ମୁଁ କି ଜାଣଇ ମା ଭାଷି ଗେଲେ",
          "ମୋ ପିନ୍ଧା ବାସ ଶେଷକୁ ଛନ୍ଦିଥାଉ",
          "ଅଙ୍ଗୁଳି ଅସ୍ଫୁଟ ଚମ୍ପାଫୁଲେ ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ସ୍ମିତ ସୁଧା ବିନ୍ଦୁ ଝଡ଼ୁଥାଇ",
          "ରତର ପ୍ରସଙ୍ଗ ବଢ଼ୁଥାଇ",
          "ଚିତ୍ତେ ତୋ ଯହିଁ ଦଉଡ଼ୁଥାଇ ଚାରୁ",
          "ଚାହାଣୀରୁ ଚିହ୍ନା ପଡ଼ୁଥାଇ ରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ପ୍ରତି ପ୍ରବନ୍ଧେ ମଜ୍ଜାଇ ମଜ୍ଜା",
          "ନିତି ହେଉଛୁ ବାସକସଜ୍ଜା",
          "ଗୋଟିକି ଗୋଟୀଏ ରାଣ ଲଙ୍ଘି ନଖି",
          "ବୋଲୁ ଯେ କାହିଁକି ଏଡ଼େ ଲଜ୍ଜା ରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କ୍ଷଣକେ ମୋ ଦୋଷ ଦଶ କୋଟି",
          "କ୍ଷମା ନ କଲେ ମୁଁ ସରିଲିଟି",
          "ଅଖଦଡ଼ ଅବଧାନରୁ ଶ୍ରୀଅଙ୍ଗେ",
          "ନଖଦନ୍ତ କ୍ଷତ କରଇଟି ରେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଏ ସ୍ନେହ ପୀୟୂଷ ବରଷାରୁ",
          "ଏହି ଅନୁରାଗ ଭରସାରୁ",
          "କର ସାରସ ଲୋଚନା କବିରବି",
          "ବଳାଇଛି ତୋତେ ଘରଷାରୁ ରେ"
        ]
      }
    ]
  },
  "sources": [
