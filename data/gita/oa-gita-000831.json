{
  "id": "oa-gita-000831",
  "name": {
    "en": "Teki mukha na bhasa",
    "or": "ଟେକି ମୁଖ ନ ଭାଷ"
  },
  "composer": "oa-person-000124",
  "mula_raga": [
    "oa-raga-000169"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/teki-mukha-na-bhasa-karunasri-dinamani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଟେକି ମୁଖ ନ ଭାଷ କପଟେ ଯଦୁପତି",
          "ଟଳିଛି ନିୟମ ଶଠପଣ ହେଲା ଖ୍ୟାତି",
          "ଟାଣ ଭାଙ୍ଗିଲା ଯେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଟେକ ଘନସ୍ତନା ସଙ୍ଗେ କରିଣ ପୀରତି",
          "ଟଷ୍କର ପରି ସୁରଙ୍ଗ ଦିଶେ ନେତ୍ର କାନ୍ତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଟମକ ପରି କିଙ୍କିଣୀ ବଜାଇ ସୁନ୍ଦରୀ",
          "ଟାଣିଛି କେଶ ଅଧରେ ଦନ୍ତଘାତ କରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଟିକି ଟିକି କରି ନଖେ ଚିରିଛି ତୋ ଦେହୀ",
          "ଟଳଟଳ ହେଉଅଛ ଉଜାଗର ରହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଟହଟହ ହସି ବସ ନିକଟେ ତା ଯାଇ",
          "ଟକାର ଚଉପଦୀକି ଦିନମଣି କହି"
        ]
      }
    ]
  },
  "sources": [
