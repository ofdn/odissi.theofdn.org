{
  "id": "oa-gita-000634",
  "name": {
    "en": "Phula sare na ja mote",
    "or": "ଫୁଲଶରେ ନ ଯା ମୋତେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000019"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/phula-sare-na-ja-mote-nata-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଫୁଲଶରେ ନ ଯା ମୋତେ ସୁକୁମାରୀ ମାରି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଫେଡ଼ି କହୁଛି ମୁଁ ସତେ ଘେନ ମୋ ବିନୟ ଚିତ୍ତେ",
          "ବଚନେ ନ ପାରି ତୋତେ ରହିଲି ମୁଁ ହାରି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଫିଟାଇ ସଜନୀ ମାନ ଗ୍ରନ୍ଥୀକି ରାମାରତନ",
          "ମୋତେ ଏ ବିପଦୁଁ ବେଗେ ନିଅ ତୁ ଉଦ୍ଧାରି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଫନ୍ଦା କରିଛି ମୁଁ ତୋତେ ନାହିଁ ତୋ ବିନା ଜଗତେ",
          "ମୋତେ କାମ ପାରାବାରୁ କରିବାକୁ ପାରି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଫୁଟାଇ ନ ଦେଉ ତମ ବାଣୀରେ ମୋର ମରମ",
          "ଦେଖାଅ ସଖୀକି ବାରେ ଉପାୟ ବିଚାରି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଫରମାସ ଆଜି ବେଶେ ଶ୍ରୀ ହରିଚନ୍ଦନ ଭାଷେ",
          "ଶରଣ କେ ଅଛି ମୋର ବିନା ରେ ତୋହରି ରେ"
        ]
      }
    ]
  },
