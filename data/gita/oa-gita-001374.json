{
  "id": "oa-gita-001374",
  "name": {
    "en": "Syama priti gharabuda re",
    "or": "ଶ୍ୟାମ ପ୍ରୀତି ଘରବୁଡ଼ା ରେ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000196"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-priti-gharabuda-re-rajahansi-chokhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ପ୍ରୀତି ଘରବୁଡ଼ା ରେ ସଙ୍ଗାତ",
          "ଶ୍ୟାମ ପ୍ରୀତି ଘରବୁଡ଼ା",
          "ନୀପମୂଳେ ରହି ମୁରଲୀ ବଜାଏ",
          "ଜାତି କୁଳ ଗୋତ୍ର ଛଡ଼ାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତା ଯେଉଁ ଚାହାଣୀ ପୁଣି ଠିଆ ଠାଣି",
          "ଯୁବତୀ ଜ୍ଞାନ ଘଉଡ଼ା ରେ",
          "ପତିବ୍ରତା ହେଲେ କେ ନ ଭୁଲିବ କି",
          "ଦେଖି ତା ଛବି ମଉଡ଼ା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଲ୍ଲୀମାଳ ବେଢ଼ା ସେବତୀ ପାଖୁଡ଼ା",
          "କେତକୀ ଦଳେ ସଜଡ଼ା ରେ",
          "ଶିଖୀପୁଚ୍ଛ ଗୁଚ୍ଛ ଜ୍ଞାନ କରେ ତୁଚ୍ଛ",
          "ସେ ଯେଉଁ ଚନ୍ଦ୍ରିକା ଚୂଡ଼ା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରୀତିପଙ୍କେ ଲାଖି ଯିବୁ ଚନ୍ଦ୍ରମୁଖୀ",
          "ପଦ ତେଣିକି ନ ବଢ଼ାରେ",
          "ଅପବାଦ ଜଳେ ଭସାଇ ଦେବାକୁ",
          "ତା ନେତ୍ର ପ୍ରେମ ଲହଡ଼ା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନେବ ହୁରୂମତ ସାରିବ ମହତ",
          "ଚାଲ ଚାଲ ନୁହଁ ଛିଡ଼ାରେ",
          "ବୋଲେ ବେଣୁଧର ସେ ଶ୍ୟାମ ନାଗର",
          "ଅଟନ୍ତି କେଡ଼େ ଲେଭଡ଼ାରେ"
        ]
      }
    ]
  },
  "sources": [
