{
  "id": "oa-gita-001422",
  "name": {
    "en": "Manjula manjari kunja punja bhari",
    "or": "ମଞ୍ଜୁଳ ମଞ୍ଜରୀ କୁଞ୍ଜ ପୁଞ୍ଜ ଭରି"
  },
  "composer": "oa-person-000035",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manjula-manjari-kunja-punja-bhari-kedara-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଞ୍ଜୁଳ ମଞ୍ଜରୀ କୁଞ୍ଜ ପୁଞ୍ଜ ଭରି",
          "ସଞ୍ଜ ପ୍ରଭଞ୍ଜନ ବହୁଥିବ",
          "ଆନନ୍ଦରେ ଚାନ୍ଦ ନଚାଇ କୁମୁଦ",
          "ଅରବିନ୍ଦେ ମନ୍ଦ ଶୋହୁଥିବ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସରସୀର ଅଙ୍ଗେ ନୀଳ ଜଳ ସଙ୍ଗେ",
          "ନାଚିବ ତରଙ୍ଗେ ଇନ୍ଦୁ ବିମ୍ବ ରଙ୍ଗେ",
          "ଚୂତ ଡାଳେ ମଧୁଦୂତ ସୁଧାବିନ୍ଦୁ",
          "ରୁତଛଳେ ପ୍ରାଣେ ଦେଉଥିବ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଉପବନ ଶିରୀ ପ୍ରସୂନ ସୁନ୍ଦରୀ",
          "ଯଉବନ ଧରି ପବନ ଆଦରି",
          "ମନ୍ଦେ ମନ୍ଦେ ହସି ମକରନ୍ଦେ ତୋଷ",
          "ଗନ୍ଧେ ଗନ୍ଧବହ ମୋହୁଥିବ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପବନ ପରଶେ ସୁମନ ହରଷେ",
          "ଫୁଲି ନବରସେ ଝୁଲିବ ସରସେ",
          "ଗଲେ ତହିଁ ଅଳି ବଳେ ଚାହିଁ ବାଳୀ",
          "ଛଳେ ନାହିଁ ବୋଲି କହୁଥିବ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୋଲୁଥିବ ଧିଟପୁରୁଷ ଲମ୍ପଟ",
          "ଗୁଣ ମଧୁଲିଟ ନ କର ପ୍ରକଟ",
          "ବିଟଳ ଗୁଞ୍ଜନେ ବିଟସ୍ନେହୀ ମନେ",
          "ବିଟପୀ ପ୍ରସୂତା ହେଉଥିବ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେ କାଳ ସୌରଭ ଅତୁଳ ବିଭବ",
          "କରାଏ ସମ୍ଭବ ଅପରୂପ ଭାବ",
          "ମାଧବୀ କାନନେ ବାନ୍ଧବୀ ଗହଣେ",
          "ବନ୍ଧୁ ସୁଖେ କାଳ ନେଉଥିବ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
