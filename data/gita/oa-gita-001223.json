  "name": {
    "en": "Niparudha braja sasi",
    "or": "ନୀପାରୂଢ଼ ବ୍ରଜ ଶଶୀ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000081"
  ],
  "mula_tala": [
