  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/niparudha-braja-sasi-bihagada-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ନୀପାରୂଢ଼ ବ୍ରଜ ଶଶୀ କରୁ ବାସ କେ ଆକର୍ଷି",
          "ମନ୍ଦ ମନ୍ଦ ହସି ହସି ଲାଜେ ମଜ୍ଜି ନବ ବୟସୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଞ୍ଚିତ କରି ଭ୍ରୂଲତା ପୁଣ ପୁଣ ହୋଇ ବନିତା",
          "ସରାଗରେ ମାଗିବାର ହୃଦେ କୁନ୍ତଳ ବିନ୍ୟାସି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ରୀ ପ୍ରତାପରୁଦ୍ର ଦେବ ଭାବି ସ୍ୱାନ୍ତରେ ଏ ଭାବ",
          "ପ୍ରେମ ସୁଧାବ୍ଧି ମଧ୍ୟରେ ମଜ୍ଜିଲେ ଦିବସ ନିଶି"
        ]
      }
    ]
  },
  "sources": [
