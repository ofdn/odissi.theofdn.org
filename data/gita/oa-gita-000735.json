{
  "id": "oa-gita-000735",
  "name": {
    "en": "Rase esana dise",
    "or": "ରାସେ ଏସନ ଦିଶେ"
  },
  "composer": "oa-person-000038",
  "mula_raga": [
    "oa-raga-000045"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rase-esana-dise/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାସେ ଏସନ ଦିଶେ ବ୍ରଜଯୁବତୀ",
          "କଟାକ୍ଷ ପ୍ରତି ଏ ଭାଷେ",
          "ଅଞ୍ଜନ ନବଘନ ଗଞ୍ଜନନିଭ ତନୁ",
          "ଖଞ୍ଜନ ଲୋଚନ ରଞ୍ଜନ ମୋହନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୀଳୋତ୍ପଳ ଅଞ୍ଜଳି ଧରିକି ସକଳ ବାଳୀ",
          "ପଦେ ସୁସ୍ନେହେ ଢାଳି ଦେବାରୁ ଶୋଭାବଳୀ",
          "ନାଭି ସରସୀ ଉପରେ ମୀନ ପରି ସେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାନ୍ତି ରୁଚିର ତର କୌସ୍ତୁଭ ମଣିବର",
          "କଣ୍ଠ ଭୂଷଣ ହାର ଅନଙ୍ଗର କି ଗାର",
          "ନୀଳମଣି ପ୍ରଖରେ କି ଶୋଭା ସେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚିକୁରରେ ମଞ୍ଜୁଳ ଶିଖୀ ଚନ୍ଦ୍ରିକା ଚୂଳ",
          "ଚକ୍ଷୁଭୃଙ୍ଗେ ବିଭ୍ରାଜ ନବ ପଲ୍ଲବାମ୍ବୁଜ",
          "କହଇ ପଦ୍ମନାଭ ଲପନ କି ସେ"
        ]
      }
    ]
  },
  "sources": [
