{
  "id": "oa-gita-000547",
  "name": {
    "en": "Parana chhara ki loda",
    "or": "ପରାଣ ଛାର କି ଲୋଡ଼ା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000045"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/parana-chhara-ki-loda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପରାଣ ଛାର କି ଲୋଡ଼ା ରେ ସଙ୍ଗାତ",
          "ପ୍ରିୟଜନ ପ୍ରୀତି ପୀୟୂଷରୁ ଅତି",
          "ହୁଅଇ ଯେବେ ଖଦଡ଼ା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପାଶୋରେ ହୃଦୟ ଭିତରୁ ସଦୟ",
          "ପଣ ପରମ ମୁହାଁସ",
          "ପେଟ ଯାକେ ପୂରିଥିବ ଯେବେ କୂଟ",
          "ମୁଖେ ଥିବ ମନ୍ଦ ହାସ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛଳ ପୂର୍ଣ୍ଣ କରି ମୃଦୁ ବାଣୀ ଝରି",
          "ବିରହୀ ହୃଦେ ଢାଳିବା",
          "ନିଦାଘେ ତାପିତ ବନ ଲତା ହିତ",
          "ହାତଟେକା ଜଳ କିବା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରଣୟ ପରୀକ୍ଷା କରି ଲକ୍ଷ ଲକ୍ଷ",
          "ସବୁ ବୁଝି ଅନୁଭବେ",
          "ପ୍ରୀତି ଠାରୁ ବଡ଼ କେହି ନାହିଁ ବୋଲି",
          "ବିବେଚନା ନାହିଁ ଯେବେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବି ଦିନକର ରାୟଗୁରୁ ବୋଲେ",
          "ଏବେ ସବୁ ଜଣାଗଲା",
          "ପକାଇ ପବିତ୍ର ସ୍ଥଳେ ସ୍ଥଳଗାତ୍ର",
          "ପରମ ପଦକୁ ଚଳା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
