{
  "id": "oa-gita-000252",
  "name": {
    "en": "Galabele mo jiba",
    "or": "ଗଲାବେଳେ ମୋ ଜୀବ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/galabele-mo-jiba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗଲାବେଳେ ମୋ ଜୀବ ଶ୍ରୀ ରାଧେ ଦିଶା ଯିବ",
          "ରହି ଶ୍ରୀ ଗୋଷ୍ଠାଚଳଚନ୍ଦ୍ର କୋଳରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦଶନେ ଦଂଶି ତୃଣ ଜଣାଉଛି ଜଣାଣ",
          "ଶ୍ରୀ ବୃନ୍ଦାବନେଶ୍ୱରୀ ପଦ ତଳରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରାସ ଅବସାନରେ ଆଉଜାଇ ହୃଦରେ",
          "ମୋହନ ବିଞ୍ଚୁଥିବେ ପଦ ତଳରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୋଟି କୋଟି ଜନ୍ମର ସୁକୃତ ଫଳ ମୋର",
          "ଦୟାମୟୀ ବଞ୍ଚାଅ କୃପା ବଳରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୀନ ହୀନ ପାମର ବୋଲି ହେଲେ ଉଦ୍ଧର",
          "ରାସେଶ୍ୱରୀ ବିଲୋକି ନେତ୍ରାଞ୍ଚଳରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମୋ ମତେ ମୁଁ କିଙ୍କରୀ ହେବାକୁ ଆଶା କରି",
          "ଚାହିଁଛି ଚିର କାଳୁ ମୁଁ ଆକୁଳରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପ୍ରାର୍ଥନା ବାରବାର ଏ ଗୋପାଳକୃଷ୍ଣର",
          "କହି ହେଲେ ପ୍ରାଣେଶ ଶ୍ରୁତିମୂଳରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
