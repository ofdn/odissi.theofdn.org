{
  "id": "oa-gita-000383",
  "name": {
    "en": "Jaha ichha taha heu re sangata",
    "or": "ଯାହା ଇଚ୍ଛା ତାହା ହେଉ ରେ ସଙ୍ଗାତ"
  },
  "composer": "oa-person-000060",
  "mula_raga": [
    "oa-raga-000106"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaha-ichha-taha-heu-re-sangata/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯାହା ଇଚ୍ଛା ତାହା ହେଉ ରେ ସଙ୍ଗାତ",
          "ଜଳିଗଲା ବନ ବଳିଗଲା ମନ",
          "ଲେଉଟି ଆସେ କି ଆଉ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲସିଲେ ଲସୁ ମୋ ଗୁରୁତ୍ତ୍ୱ ବସିଲେ",
          "ବସୁ ହଟହଟା ହାଟ",
          "ହସିଲେ ହସନ୍ତୁ ଅସହଣୀମାନେ",
          "ନ ତେଜିବି ନନ୍ଦଚାଟ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶିରୀଷ ଗିରୀଶ ଶୀରୀଷରେ ଦେଇ",
          "ତୁଳସୀ ଚମ୍ପକରାଶି",
          "ନାଗରବର ଅମୂଲ୍ୟ ହେମ ପ୍ରେମ",
          "ମିଳିଛି ସେ ଫଳେ ଆସି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତିଆଗ ମୁଁ ଆଗ କରି ଲାଜ ବ୍ୟାଜ",
          "ଘର ଦରବ ସ୍ନେହକୁ",
          "ଶ୍ୟାମ ତାମରସ ପାଦରେ ସାଦରେ",
          "ବିକିଅଛି ଏ ଦେହକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପୀତବାସ ବାସ କଲେଣି ଈକ୍ଷଣେ",
          "କ୍ଷଣେହେଁ ନୋହି ଅନ୍ତର",
          "ସ୍ମରଣ ଅନ୍ତରଗତେ ସେ ମନ୍ତର",
          "-ବତ ସତ ନିରନ୍ତର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଧରାଧର ପ୍ରୀତି ବରଧନ ବରଧନେ",
          "ଏ କାରଣେ ଗତି",
          "ଭାଷେ ହରି ରାସେଶ୍ୱରୀ ରାଧା ସହୀ",
          "ଆଗେ ଏ ଭାଷା ଭାଷନ୍ତି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
