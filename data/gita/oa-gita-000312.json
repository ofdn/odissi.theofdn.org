    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଜୀବାକ୍ଷି ରାଧେ ବିନୋଦେ",
          "ରାଜ ହୃଦାନନ୍ଦେ",
          "ରାଜ ବହନ ବରଜି ମାନ",
          "ସଜଳ ଜଳଦକେଶୀ ମୋଦେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାଜ ସାଜ ସୁନାଗରୀ ରାଜ",
          "ରାଜିବେ ବରଜ ଯୁବରାଜ",
          "ଆଜି ରାଜି ହୁଅ ବେଗେ",
          "ଭଜେ ତାରିଣୀ ଶ୍ରୀ ଯୁଗଳ ପାଦେ"
        ]
      }
    ]
  },
