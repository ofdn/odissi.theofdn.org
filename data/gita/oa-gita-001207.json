{
  "id": "oa-gita-001207",
  "name": {
    "en": "Madanmohana manmohini re e ki nutana riti",
    "or": "ମଦନ୍ମୋହନ ମନ୍ମୋହିନୀ ରେ ଏ କି ନୂତନ ରୀତି । ଘୋଷା ।"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madanmohana-manmohini-re-e-ki-nutana-riti-jhinjoti-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଦନ୍ମୋହନ ମନ୍ମୋହିନୀ ରେ ଏ କି ନୂତନ ରୀତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାରି ଦେଶ ଅଭିସାର କଲା ବେଳକୁ ଅସାର",
          "ବୁହାଇ ନେତ୍ର ଯୁଗଳରୁ ବସିଲୁ ଶ୍ରୀମୁଖ ପୋତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏହି ପରି କରଭୋରୁ ଆସୁଛି ତ ମୁଁ ଛାମୁରୁ",
          "ଘେନ ଦେଇଛନ୍ତି ବଂଶୀକି କରିବାକୁ ତୁ ପ୍ରତୀତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାନନେ ପଶୁ ପକ୍ଷୀଙ୍କି ପ୍ରତି ବିଟପୀ ବଲ୍ଲୀକି",
          "ଜନକଜା ଭିନ୍ନ ଶ୍ରୀରାମ ପରି ପଚାରୁ ଅଛନ୍ତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷନ୍ତି ଶ୍ରୀମତୀ ଧୀରେ ଚିତ୍ରପଟ ଦର୍ପଣରେ",
          "ଶ୍ୟାମ ବାମେ ମୋ ଛାଇକି ମୁଁ ଚାହୁଁ ଭ୍ରମ ହେଲା ମତି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ସରଣୀ ମଣାଇ ନେତ୍ର ତରଣୀ",
          "ତନୟା ତଟେ ଭେଟିଲେ ସେ ପ୍ରିୟକୁ ଅଧପଦ୍ଧତି"
        ]
      }
    ]
  },
  "sources": [
