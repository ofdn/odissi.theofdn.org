{
  "id": "oa-gita-001458",
  "name": {
    "en": "Kisori go tu ta nutana bali",
    "or": "କିଶୋରି ଗୋ ତୁ ତ ନୂତନା ବାଳୀ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000189"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kisori-go-tu-ta-nutana-bali-abhiri/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କିଶୋରି ଗୋ ତୁ ତ ନୂତନା ବାଳୀ",
          "ବସିଲୁଣି କଳା ତନୁକୁ ଭାଳି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାଣି ନାହୁଁ ଧନ ତାର ସ୍ୱଭାବ",
          "କେତେ ନିନ୍ଦା ହାଟ ବସାଇଦେବ",
          "ତା ଦାଉକୁ ପାରିବୁଟି କି ସମ୍ଭାଳି",
          "ଜାତି କୁଳ ଛଡ଼ା ସେ ବନମାଳୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଳ ମହତକୁ ଥିଲେ ତୋ ଡର",
          "ନନ୍ଦନନ୍ଦନକୁ ତୁ ଆଶା କର",
          "ଶୁଣିଛୁ ନା ବ୍ରଜେ ଚନ୍ଦ୍ରାର ଚରିତ",
          "ହେଲାଣି ଯା ନାମେ ଗୀତ ଢମାଳି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବୋଲେ ବେଣୁଧର ଆଗୋ ରାଧିକେ",
          "ମରଣୁ ବଳିବ ଲାଜ ଅଧିକେ",
          "ମାନ ମୋ ବଚନ ପରାଣବାନ୍ଧବି",
          "ସେ ଦିଗେ ନ ଯିବୁ ପହଣ୍ଡେ ଚାଳି"
        ]
      }
    ]
  },
  "sources": [
