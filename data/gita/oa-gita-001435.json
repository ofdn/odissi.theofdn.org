{
  "id": "oa-gita-001435",
  "name": {
    "en": "Dekhi naba kalika",
    "or": "ଦେଖି ନବକାଳିକା ବକାଳିକା ମାଳିକାଆଳି କାଳିକା କାନ୍ତ ସ୍ମରିରକ୍ଷା କେମନ୍ତେ କରି କରିବା ମତ୍ତକରୀଗତିକି ଏମନ୍ତ ବିଚାରିରେ ସହଚରି ।ଭାବେ ବଞ୍ଚିଲେ ଏ କାଳକୁକଥା ଥିବ କାଳ କାଳକୁଏତେକ କ୍ଷୀଣ ଦିନ ହେଲା ଦୁର୍ଦ୍ଦିନ ଦିନନ ଲଭୁ ବଲ୍ଲଭମେଳକୁ ରେ ।୧। ହିତ ଆନମାନଙ୍କୁ ସତ କାମିଜନଙ୍କୁଅହି ପରା ଅହିତ ଏହିହତ କୃଶାନୁ ସାନୁମାନରୁ ଭାନୁ ଭାନୁତାପରୁ ନିସ୍ତରିଲା ମହୀରେ ସହଚରି ।ବିରହାନଳ ହୃଦସ୍ଥଳେଜଳେ ସେ ହତ ନୋହେ ଜଳେକରୁଛି ଜାତ ଜାତ ବେଦକୁ ସତ ସତହ୍ରଦା-ଛଳରେ […]"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekhi-naba-kalika/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଦେଖି ନବକାଳିକା ବକାଳିକା ମାଳିକା",
          "ଆଳି କାଳିକା କାନ୍ତ ସ୍ମରି",
          "ରକ୍ଷା କେମନ୍ତେ କରି କରିବା ମତ୍ତକରୀ",
          "ଗତିକି ଏମନ୍ତ ବିଚାରି",
          "ରେ ସହଚରି ।",
          "ଭାବେ ବଞ୍ଚିଲେ ଏ କାଳକୁ",
          "କଥା ଥିବ କାଳ କାଳକୁ",
          "ଏତେକ କ୍ଷୀଣ ଦିନ ହେଲା ଦୁର୍ଦ୍ଦିନ ଦିନ",
          "ନ ଲଭୁ ବଲ୍ଲଭମେଳକୁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହିତ ଆନମାନଙ୍କୁ ସତ କାମିଜନଙ୍କୁ",
          "ଅହି ପରା ଅହିତ ଏହି",
          "ହତ କୃଶାନୁ ସାନୁମାନରୁ ଭାନୁ ଭାନୁ",
          "ତାପରୁ ନିସ୍ତରିଲା ମହୀ",
          "ରେ ସହଚରି ।",
          "ବିରହାନଳ ହୃଦସ୍ଥଳେ",
          "ଜଳେ ସେ ହତ ନୋହେ ଜଳେ",
          "କରୁଛି ଜାତ ଜାତ ବେଦକୁ ସତ ସତ",
          "ହ୍ରଦା-ଛଳରେ ଘନ କୋଳେ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯେଉଁ ସୁନ୍ଦରୀ ଦରୀଭୂତରୁ ଗଣ୍ଡ ଧରି",
          "ଧରିତ୍ରୀ ଶୟନ କରିଛି",
          "କଣ୍ଠେ ଜୀବନ ବନ ପୂର୍ଣ୍ଣ ନୟନ ଘନ",
          "ଘନ ନିଶ୍ଵାସକୁ ଛାଡ଼ୁଛି",
          "ରେ ସହଚରି ।",
          "ପକାଇ ଆପଣା ଅଙ୍କର",
          "ଲୋଡ଼ିଲେ ନ ଲଗାଇ କର",
          "ଯେହୁ ଏଡ଼େ ଦୁର୍ବଳ ଝଞ୍ଜାନିଳ ପ୍ରବଳ",
          "ଉଡ଼ିଯାଇଟି ଯତ୍ନ କର ରେ"
        ]
      }
    ]
  },
