{
  "id": "oa-gita-000231",
  "name": {
    "en": "Pamara mana rama anuja namaku",
    "or": "ପାମର ମନ ରାମ ଅନୁଜ ନାମକୁ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000077"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pamara-mana-rama-anuja-namaku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପାମର ମନ ରାମ ଅନୁଜ ନାମକୁ ରଟୁଥାରେ",
          "ବାମ ନୋହିବ ତାମରସର ବନ୍ଧୁଜ ତୋହଠାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାମମୋହନ ଶ୍ୟାମସୁନ୍ଦର ଦାମ ଉଦର ମନ୍ଦରଧର",
          "ଧାମକୁ ଯାଇ କୁଟୀର ବନାଇ ବସ ହଂସଜା ପନ୍ତାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗ୍ରାମ ଯାବଟ ଶ୍ରୀନନ୍ଦୀଶ୍ୱର ମୁଖରାଇ ବରଷାଣ ନବର",
          "ବୁଲି ଝୁଲି ଧରି ମାଗି ମଧୁକରୀ ଭୁଞ୍ଜ ରାଧେଶ୍ୟାମ ନାଁରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସମର୍ଥ ଆଉ ପଳାଇଯା ଯା ପରିହରି ସୁତ ବିତ୍ତ ଭାରିଯା",
          "ଉନମତ୍ତ ହୋଇ କରେ ତାଳି ବାଇ କୃଷ୍ଣଗୁଣ ଗୀତ ଗାଆରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାମ ଯାମକେ କର ସ୍ମରଣ ଶ୍ରୀ ଯୁଗଳ ଲୀଳା ରସ କଥନ",
          "ସାଧନେ ସ୍ୱତନ୍ତ୍ର କାମ ବୀଜମନ୍ତ୍ର ଗୋପାଳକୃଷ୍ଣେ ଜପାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
