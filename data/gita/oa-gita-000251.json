{
  "id": "oa-gita-000251",
  "name": {
    "en": "To pirati lagi re hebi jogi",
    "or": "ତୋ ପୀରତି ଲାଗି ରେ ହେବି ଯୋଗୀ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000043"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/to-pirati-lagi-re-hebi-jogi-gopalakrusna-basanta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତୋ ପୀରତି ଲାଗି ରେ ହେବି ଯୋଗୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧରି ଜପାମାଳୀ ତୋ ଗୁଣ ଆବଳୀ",
          "ନିରତେ ଜପିବି ଜୀବସଙ୍ଗୀ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଙ୍କେ ସୁରତାନ୍ତେ ପହୁଡ଼ାଇ ମୋତେ",
          "ନିଶିଯାକ ବସିଥାଉ ଜଗି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦୂରୁ ମୋତେ ଚାହିଁ ହସୁ ଚନ୍ଦ୍ରମୁହିଁ",
          "ମୁଖ ନାଗବଲ୍ଲୀ ଦେଉ ଫିଙ୍ଗି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷଇ ଗୋପାଳକୃଷ୍ଣ ବଂଶୀକୁଳ",
          "ହେଲେ ମୋହିପାରେ ଭୂରୁଭଙ୍ଗୀରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
