{
  "id": "oa-gita-001085",
  "name": {
    "en": "Syama bandhu mohini kala",
    "or": "ଶ୍ୟାମ ବନ୍ଧୁ ମୋହିନୀ କଲା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000142"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-bandhu-mohini-kala-banamali-khanda-bangalasri/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ବନ୍ଧୁ ମୋହିନୀ କଲା",
          "ଚାହିଁବା ମାତ୍ରକେ ମନ ମୋହିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାଳିନ୍ଦୀ କୂଳରେ କଦମ୍ବ ମୂଳରେ",
          "ତ୍ରିଭଙ୍ଗିମା ରୂପ ଭଲା ହୋଇଲା",
          "ସ୍ତମ୍ଭନ ମୋହନ ବଶ ଉଚ୍ଚାଟନ",
          "ଚାରି ଛନ୍ଦେ ତହିଁ ବେଣୁ ବାଇଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତରୁ ପଲ୍ଲବିତ ଯମୁନା ସ୍ଥକିତ",
          "କୁଳବତୀ କୁଳଶୀଳ ନାଶିଲା",
          "କେକୀ କୋକିଳ ମୂକ କଣ୍ଠ ହୋଇଣ",
          "ପାଷାଣ ତରଳି ଧାରା ବହିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେଉଁ ଗୋପାଙ୍ଗନା ଯାଇଣ ଯମୁନା",
          "ଜଳ ମଧ୍ୟେ ତା କଳସୀ ଖସିଲା",
          "ଲେଉଟି କଦମ୍ବ ମୂଳକୁ ଚାହିଁଣ",
          "ଚମକି ଚତୁରୀ ତଳେ ପଡ଼ିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋହନ ଚରଣ ଅଷ୍ଟାଦଶ ଚିହ୍ନ",
          "ବନମାଳୀ ଦାସ ଚିତ୍ତେ ଧ୍ୟାଇଲା",
          "ଶିବ ସୁର ମୁନି ଯାହାକୁ ନ ପାନ୍ତି",
          "ମାତା ଯଶୋବନ୍ତୀ ତାହା ପାଇଲା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
