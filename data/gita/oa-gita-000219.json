{
  "id": "oa-gita-000219",
  "name": {
    "en": "To daya thau re dhana",
    "or": "ତୋ ଦୟା ଥାଉ ରେ ଧନ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/to-daya-thau-re-dhana-dhanasri-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତୋ ଦୟା ଥାଉ ରେ ଧନ ହେଲି ମେଲାଣି",
          "ଅରୁଣାଧରୀ ନୟନୁଁ ନ ବୁହା ପାଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁଖ ଶୁଖାନା ରେ ବାଳୀ ହରିଣେକ୍ଷଣୀ",
          "ଦାରୁଣ ବିହି ବିହିଲା କି ଦଣ୍ଡ ଆଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦୂରେ ଥିଲେ ପାଶେ ଅଛି ଥିବୁ ରେ ଜାଣି",
          "ଲେଖି ଲେଖା ପଠାଇବି ସେ ତ ଚିତ୍ରସାରଣୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଖକୁ ଅନାଇଁ ଥରେ କହରେ ବାଣୀ",
          "ସୁନାଶୀର ସମ୍ପତ୍ତି ତୁ ଲୋଡ଼ୁ ଧରଣୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷନ୍ତି ଗୋପାଳକୃଷ୍ଣ ଶୁଣ ରମଣୀ",
          "ସୁମନେ ମେଲାଣି ଦିଅ ଧରୁଛି ପାଣି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
