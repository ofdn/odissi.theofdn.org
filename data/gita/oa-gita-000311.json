{
  "id": "oa-gita-000311",
  "name": {
    "en": "Ebe sajani ki hela",
    "or": "ଏବେ ସଜନୀ କି ହେଲା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000095"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ebe-sajani-ki-hela/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏବେ ସଜନୀ କି ହେଲା",
          "ଶ୍ଯାମ ପ୍ରୀତିରେ ସୁଖ ନୋହିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେଲା ବଡ଼ ପରମାଦ । କେ ସହିବ ଅପବାଦ ।",
          "ଦାଣ୍ଡ ଲୋକ ଶୁଣି ବାଦ । କରି କଥା ତ ମୋତେ କହିଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚିନ୍ତା କରି ଦିବା ନିଶି । ଦିନ ସରୁ ନାହିଁ ବସି ।",
          "ଚାହିଁ ନୟନୁ ନୀର ଖସି । ଉରକୁ ଯାହା ଦହିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନଇଲେ ସେ ପୀତପଟ । କାହୁଁ ଶିଖିଲେ କପଟ ।",
          "ଚାହିଁ ଚାହିଁ ଯେତେ ବାଟ । ଆସି ସଙ୍କେତ ରାତି ପାହିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସେ ମୋହନ ଲୋଭେ ପାଣି । ଯାଉଥାଏ ସିନା ଆଣି ।",
          "ବନମାଳୀ ଦାସ ଭଣି । ଆଉ ଯମୁନା ଯିବା ନୋହିଲା"
        ]
      }
    ]
  },
