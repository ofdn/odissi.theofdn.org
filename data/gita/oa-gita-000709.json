{
  "id": "oa-gita-000709",
  "name": {
    "en": "Ana ana re mote",
    "or": "ଅନା ଅନା ରେ ମୋତେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ana-ana-re-mote-mukhari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନା ଅନା ରେ ମୋତେ",
          "ବସୁଧାକୁ ଅନାଅ ନା ରେ",
          "କେଉଁ ଖଳଜନ କହିଛି କି ମନ",
          "ମୋହନା କିଛି ମୋହ ନାଁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖଳଭାଷିତକୁ ସରସ ଚିତ୍ତକୁ",
          "ଆଣିବୁ ନାହିଁ ନବୀନା ରେ",
          "ଘେନ ତ କ୍ଷିତିରେ କେ ରସେ ରୀତିରେ",
          "ସୁନ୍ଦର କୁନ୍ଦନ ବିନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋ ଅଙ୍କ ପର୍ଯ୍ୟଙ୍କ ଛାଡ଼ି ହରିଣାଙ୍କ",
          "ବଦନା ତଳେ ବସ ନା ରେ",
          "ଇନ୍ଦୁକର କାନ୍ତି ପଟଳୀ ନିନ୍ଦକ",
          "କୁନ୍ଦକଳିକା ଦଶନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଳିଏ ଥିବାରେ ଚାଳିଦେଲି ଯାହା",
          "ଦଶନାମ୍ବରେ ରସନା ରେ",
          "କ୍ଷିତିକି କରଜେ ମୋ ବନ୍ଧୁ ଚିରୁ ଯେ",
          "ଏତିକି ମୋ ଦୋଷ ସିନା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପରଖି ଦେବାର ଦୋଷୀକି ସୁନ୍ଦର",
          "ନ ରଖି ମନେ କୁହନା ରେ",
          "ଅସ୍ତ କରି ବୃଥା ସଉଭାଗ୍ୟ କଥା",
          "ମସ୍ତକ ପୋତି ରହ ନା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆଦର ଚାଦର ପରି ପରିଜନେ",
          "ଆଦର ଊଣା କର ନା ରେ",
          "କମ୍ପି କଉତୁକ ଝଲକା ମଣ୍ଡନା",
          "ଚମ୍ପକ ବରବରନା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ହରି ଚାଟୁ ଘେନି ହେଲେ ଅମାନିନୀ",
          "ପରିଣତ ଚନ୍ଦ୍ରାନନା ରେ",
          "ଅଷ୍ଟଦୁର୍ଗ ଲେଖାଧିପ ହେଲେ ଲେଖା",
          "ତୁଷ୍ଟ ପ୍ରମୁଦିତ ମନା ରେ"
        ]
      }
    ]
  },
  "sources": [
