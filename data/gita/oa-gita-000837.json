{
  "id": "oa-gita-000837",
  "name": {
    "en": "Prana mitani dala ketebele",
    "or": "ପ୍ରାଣ ମିତଣୀ ଡାଳ କେତେବେଳେ"
  },
  "composer": "oa-person-000050",
  "mula_raga": [
    "oa-raga-000178"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prana-mitani-dala-ketebele-lalita-basanta-dinakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣ ମିତଣୀ ଡାଳ କେତେବେଳେ କି ନ କରେ ପୁଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପହିଲି ପ୍ରୀତି ସମୟେ ଅହର୍ନିଶି ଆସିବାୟେ",
          "ଏହି ପୁରେ ଦିଶୁଥାଇ ପାଦ ପଦ୍ମ ଚିହ୍ନମୟେ",
          "କାହିଁ ଗଲା ସେ ସମୟେ ସପନ ଧନ ପରାୟେ",
          "ଖଳ କୁସୁମ କାଣ୍ଡକୁ ଭୋଗ ହେଲା ଆମ୍ଭ କାୟେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏବେ ବସନ୍ତ ସମୟେ ନଇଲେ ମୋହନ ରାଏ",
          "ନୀରସ ତରୁରେ ଆସି ସରସ ପଲ୍ଲବ ହୋଏ",
          "ଦୟାଳୁ ହୋଇଣ କିମ୍ପା ଏଡ଼େ ନିଷ୍ଠୁର ହୃଦୟେ",
          "ଭଲା କଲା କୁବୁଜାର ମୋହନ ମନ୍ତ୍ର ଉପାୟେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଫୁଲରେ ଭ୍ରମର ରଙ୍ଗ ଫଳ ବୃକ୍ଷେ ପକ୍ଷୀ ସଙ୍ଗ",
          "ଯଉବନ ଥିଲେ ପର ପୁରୁଷେ ପ୍ରୀତି ଅଭଙ୍ଗ",
          "ବୋଲେ ଦୀନକୃଷ୍ଣ ଯେହ୍ନେ ସରିତ ପରି ତରଙ୍ଗ",
          "ଆସଇ ଅତି ଉଚ୍ଚରେ ବଡ଼ ବେଗେ ହୋଏ ଭଙ୍ଗ"
        ]
      }
    ]
  },
  "sources": [
    {
