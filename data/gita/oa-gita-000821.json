  "name": {
    "en": "Murali baje re",
    "or": "ମୁରଲୀ ବାଜେ ରେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000048"
  ],
  "mula_tala": [
