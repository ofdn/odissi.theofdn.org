{
  "id": "oa-gita-000100",
  "name": {
    "en": "Kuhu kuhu ke sajani",
    "or": "କୁହୁ କୁହୁ କେ ସଜନୀ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000043"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kuhu-kuhu-ke-sajani-ke-se-bole/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁହୁ କୁହୁ କେ ସଜନୀ କେ ସେ ବୋଲେ",
          "କୁହୁ କୁହୁ ବୋଲେ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପହୁଡ଼ିଥିଲି ଅଳସେ । ଆସି ବାତାୟନ ପାଶେ ।",
          "ଦୋହଲାଇ ଦେଲା ତନୁ ଗେଲେ ।",
          "(ପଡ଼ି)",
          "ସପନ ଚେତି ସତେ ଚାହିଁଲି ସଜନୀ",
          "ଗୋପନ ମନ ତଳେ ଛୁଆଁକେ ଦେଲା ଆଣି",
          "ଘେନାଇ ମନ କେ ସେ ପରଶ ଯାଚିଲାଣି",
          "ପାଶେ ଆସି । ହସେ ବସି । ରସେ ରସି ।",
          "ପଚାର ସଖି ତୁ ଥରେ",
          "ପରାଣ ମୋର ଚହଲେ",
          "ବସନ୍ତ ହେବ ସେ ହେଲେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କବିଚନ୍ଦ୍ର ବୋଲେ ମିତ । ଆଣିଛି କୋଇଲି ଗୀତ ।",
          "ନାରୀମରା ମୁକୁଟ ତା ଭାଲେ ।",
          "(ପଡ଼ି)",
          "କରୁଣା ବୋଲି ପଦ ନାହିଁ ତା ମରମେ",
          "ମଦନପାଳିଆ ସେ ନାରୀମରା ଧରମେ",
          "ବିରହୀ ଜନମନ ଲୁଟେ ସେ ଜୀବଧନ",
          "ସୁନାଗୋରୀ । ଆନ ଦେଲି । ବସ ଫେରି ।",
          "ତା ନାଁ ଧରନାରେ ମୁଖେ",
          "ଦୂରନ୍ତ ତାର ପରା କେ",
          "ହିଆ ଚମକେ ଥମକେ"
        ]
      }
    ]
  },
  "sources": [
    {
