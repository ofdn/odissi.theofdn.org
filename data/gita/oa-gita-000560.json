{
  "id": "oa-gita-000560",
  "name": {
    "en": "Bhabile bhabila pari re manasa",
    "or": "ଭାବିଲେ ଭାବିଲା ପରି ରେ ମାନସ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000139"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhabile-bhabila-pari-re-manasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭାବିଲେ ଭାବିଲା ପରି ରେ ମାନସ",
          "ଶ୍ରୀ ରାଧା ଗୋବିନ୍ଦ କଥା ହୋଇବାର",
          "ହସି ଧୀର ଧୀର କରି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିଭୃତ କୁଞ୍ଜରେ ସୁମନ ଶେଯରେ",
          "ରାତି ଥାଉ ଚେତା ହୋଇ",
          "ବୃକ୍ଷରେ ବଲ୍ଲୀ ବେଢ଼ିଲା ସନେ ରହି",
          "ଶ୍ରୀମୁଖେ ମୁଖ ଲଗାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆଳୀମାନେ ଥିଲାବେଳେ କେଣେ",
          "ମୋର ନିକଟକୁ ଆସିବାର",
          "କିଛି ଲାଜ ନାହିଁ ବୋଲୁ ବ୍ରଜବଧୂ",
          "ସରୁ ଚୁମ୍ବନ ଦେଲାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ଲାଜ ନାଚିବା ଲୋକର ବରଜ",
          "ରାଜପଥେ ଚାଲି ଚାଲି",
          "ବୋଲୁଁ ଶ୍ରୀ ପ୍ରାଣେଶ ଗଣ୍ଡେ ଗଣ୍ଡ",
          "ଦେଇ ମଜ୍ଜିବାର ଝୁଲି ଝୁଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଟିଳା ଆସୁଛି ବୋଇଲେ ପଳାଇ",
          "ସପ୍ତପର୍ଣ୍ଣ କୁଟ୍ଟିମରେ",
          "ଦୁହେଁ ଯାକ ଲୁଚି ପାହୁରି ହେଲାର",
          "କିଶୋରୀମଣି ବାସରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ୟାମଳ ବେଶରେ ପୁରକୁ ଯିବାରେ",
          "ଗତ ରାତିର ଚରିତ",
          "ନାରୀ ଭୂଷଣ କାହୁଁ ବୋଲୁ ଭାଷନ୍ତି",
          "କୁନ୍ଦଲତା କଲା ଦତ୍ତ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଘନସୁନ୍ଦର ଶ୍ରୀମତୀ ହୋଇ",
          "କନିଅର ତଳେ ଭେଟାଭେଟି",
          "ପରିଷ୍ୱଙ୍ଗ ରଙ୍ଗେ ମଜ୍ଜି ପୁର ଆଡ଼େ",
          "ଭୟେ ଢାଳି ଢାଳି ଦୃଷ୍ଟି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହେ ଶ୍ରୀରାଧାକୃଷ୍ଣ",
          "ପ୍ରେମ ରସ ସୁଧାବ୍ଧିର",
          "ଶ୍ରୀକର ଯାର ରସନା ସ୍ୱରସିତ",
          "ସେ ଜାଣିବ ଏ ମଧୁର"
        ]
      }
    ]
  },
  "sources": [
    {
