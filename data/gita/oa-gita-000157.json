{
  "id": "oa-gita-000157",
  "name": {
    "en": "Manda malayanila bahila",
    "or": "ମନ୍ଦମଳୟାନିଳ ବହିଲା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000017"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manda-malayanila-bahila-ahari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନ୍ଦମଳୟାନିଳ ବହିଲା",
          "ଚନ୍ଦ୍ରବଦନା ଦୂରେ ରହିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖାଇ ନୂଆ ଚୂତ ବକୁଳକୁଳ",
          "କଳକଣ୍ଠ କରେ ଯା କଳକଳ",
          "କରି କଳକଳ ପ୍ରବାସୀ ବିକଳ",
          "କରିବ ବୋଲି ବୋଇଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଙ୍କ ଜଗତିରେ ପଙ୍କଜମୁଖୀ",
          "ପହୁଡ଼ିଲେ ମୋର ହୁଏ ଯେ ସୁଖୀ",
          "ମୃଦୁ ସରସିଜ କିଶଳୟ ଶେଯ",
          "ଧନକୁ ଯୋଗ୍ୟ ହୋଇଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆହା ତାହା ସାହା ବାରେ ତ ମୋତେ",
          "ବନରୁ ଚମ୍ପକମାଳା କିଞ୍ଚିତେ",
          "ମନମଥ ବଶେ ଏବେ ସେ ଅବଶେ",
          "ଦୁଃସହ ଦୁଃଖ ସହିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଲ୍ଲବକୁ ଦଣ୍ଡଧର ରସନା",
          "ବଲ୍ଲୀରୁ କିଶୋରୀ ମଣିବ ସିନା",
          "କିଂଶୁକ ସ୍ତବକ ଅନଳ ଯାବକ",
          "ତୁଲ୍ୟ ତ ଦେହ ଦହିଲା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭଣିଲେ ଅଷ୍ଟଦୁର୍ଗ ପୁରୁହୂତ",
          "ଦୁଃଖ ତେଜିଲେ ବ୍ରଜରାଜସୁତ",
          "ମୃଦୁଳ କନ୍ଦଳୀ ବଜ୍ରେ ଦେଲେ ଦଳି",
          "ହେବାର ବିହି ବିହିଲା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
