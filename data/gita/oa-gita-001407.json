  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bajiba-bhusa-pada-jayadeba-jayadeva/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାଜିବ ଭୂଷା ପଦ ରାଜୀବ ଯୁଗଳରେ",
          "ଆଜ ବରଜରାଜ ବରନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିକୁଞ୍ଜକୁ ସଜନୀ ଚାଲ ମୋ କଥା ମାନି",
          "ମୁଁ ତୋର ସଙ୍ଗେ ଅଛି ଡରନାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛଣା ବିଧୂବଦନା ଜଣା ନ ଗଲା ସିନା",
          "ଜଣାଇ ଦେବି ରାମା ଘେନନାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କହଇ ଜୟଦେବ ନିନ୍ଦା ସଫଳ ହେବ",
          "ଆଉ ମୋ ନାମେ ବଂଶୀ ବଜାନାରେ"
        ]
      }
    ]
  },
  "sources": [
