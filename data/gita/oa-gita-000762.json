{
  "id": "oa-gita-000762",
  "name": {
    "en": "Ana lo sahi kanhai",
    "or": "ଅନା ଲୋ ସହି କହ୍ନାଇ"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ana-lo-sahi-kanhai-khambaja-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନା ଲୋ ସହି କହ୍ନାଇ ଠିଆ ଠାଣକି",
          "ସରି କେ ହୋଇବ ତିନି ଭୁବନେ ବଂଶୀପାଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତା ଯେଉଁ ତ୍ରିଭଙ୍ଗୀ ଛଇ ବିଲୋକିଲେ ଆଖିଆଇ",
          "ଏ ଗୋପରେ କେଉଁ ଗୋଈ ରଖିପାରିବ ଆଣିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବୃନ୍ଦାବନ କଳାକର ନଟନାଗର ଶେଖର",
          "ଭାଙ୍ଗିଦେବ ସତୀଙ୍କର ବରତ ଥାଅ ଜାଣିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାର ମୋହନ ମୂରତି ଚାହିଁ କେ ପତିବରତୀ",
          "ନ ଇଚ୍ଛିବ ଅବା ପ୍ରୀତି ବଳେ ଭାଷିଣ ବାଣୀକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରସେ ଗୌର ଦ୍ୱିଜ କହି ମିଛ ନୁହେ ଆଲୋ ସହି",
          "କେ ଶୁଣିବ ଧୈର୍ଯ୍ୟ ବହି ତା ଢମାଳି କାହାଣୀକି"
        ]
      }
    ]
  },
