{
  "id": "oa-gita-000442",
  "name": {
    "en": "Saja saja saroja siri mukhiki",
    "or": "ସାଜ ସଜ ସରୋଜ ଶିରୀମୁଖୀକି"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/saja-saja-saroja-siri-mukhiki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଜ ସଜ ସରୋଜ ଶିରୀମୁଖୀକି",
          "ଲାଜ ଲାଜ ଆଉ କି ସାଜେ ସଖୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତମାଳ ତଳେ ପରା ଝୁରେ ମୁରଲୀଧରା",
          "ଧୀରା ତୋ ପଥ ସାରା ରହେ ଟାକି ।",
          "(ପଡ଼ି)",
          "କୁହୁକୁ କୁହୁ ବୋଲି କୋଇଲି ଗାଏ",
          "କୁଞ୍ଜବନ ବାସ ଫୁଲ ବିଛାଏ",
          "ଗଗନେ ରସି ଶଶୀ ଗଲାନି ପରଶି",
          "ବରଜ ମଲ୍ଲୀ । ନାଚିଲା ଫୁଲି । ଛବି ନିରେଖି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସରସ ଗଜଗତି । ଆରେ ସୁରସବତୀ ।",
          "ମନ ମୋହନା ଗତି ତୁହି ସିନା ।",
          "(ପଡ଼ି)",
          "କଞ୍ଜ ପଦତଳେ ଅଳତା ରଞ୍ଜ",
          "ମାଧବୀ ବନେ ଢଳି ଆସିଲା ସଞ୍ଜ",
          "ମଧୁ ମୁରଲୀ ଧନୀ ତୋ ନାମ ଫୁକାରି",
          "କାନନ ଭରି । ଶୁଣରେ ଗୋରୀ । ଥକିଲା ଡାକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଉଛୁର କରନାରେ । କେତକୀ ବରନାରେ ।",
          "ଅନା ଥରେ ଅନା ରେ ମେଲି ଆଖି ।",
          "(ପଡ଼ି)",
          "ବନ୍ଦେ କବିଶଶୀ ଚରଣ ଧ୍ୟାୟି",
          "ମୋହନ ଗତି ଧନୀ ତୋ ବିନୁ ନାହିଁ",
          "ମାନ ବରଜି ଚଳ ସରାଗ ସରଜି",
          "ମଦନ ଛାର । ପରାଣ ତାର । ଦେବଟି ବିକି"
        ]
      }
    ]
  },
