  "name": {
    "en": "Sajanie na kaha se krusna",
    "or": "ସଜନୀଏ ନ କହ ସେ କୃଷ୍ଣ"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000053"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000007"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajanie-na-kaha-se-krusna-katha-soma-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀଏ ନ କହ ସେ କୃଷ୍ଣ କଥା ଏଣିକି",
          "ଜୁହାର କରୁଛି ଧରି ତୁମ୍ଭ ବେନି ପାଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁହିଁ ନୃପନନ୍ଦିନୀ ଚନ୍ଦ୍ରାବଳୀ ଗୋପାଳୁଣୀ",
          "ଆମ୍ଭ ତାରତମ୍ୟ ଶ୍ୟାମ ଜାଣି ନାହିଁ ସତେ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସେ ହରି ଭୁଜଙ୍ଗମଣି ପରତେ କରି ତା ବାଣୀ",
          "ବାସ ବିଷ ମଣି ଦୁଃଖେ ବନେ ନେଲି ରାତିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୋ ଦେହ ଯତେ କଷଣ ସହିଲା ତ ତାହା ଜାଣ",
          "ଆବର ବୋଲ କିପରି ଏବେ ପାଳ ପ୍ରୀତିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୁରଲୀ ଛୁଇଁ ନିୟମ କରି କରାଇ ଭରମ",
          "କରିବା ଫଳ ମୋତେ ଆଉରି ଅଣ୍ଟି ନାହିଁକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେ ଶ୍ରୀ ବିକ୍ରମ ପାଳକ ଶଠ ଲମ୍ପଟ ନାୟକ",
          "ତାର ମୋର ଭେଟ ଆଉ ଏ ଜନ୍ମରେ ଏତିକି"
        ]
      }
    ]
  },
