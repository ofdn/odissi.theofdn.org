{
  "id": "oa-gita-001040",
  "name": {
    "en": "Ede bimukha mo thare",
    "or": "ଏଡ଼େ ବିମୁଖ ମୋ ଠାରେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ede-bimukha-mo-thare-dhanasri-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏଡ଼େ ବିମୁଖ ମୋ ଠାରେ କାହିଁ ପାଇଁ ଗୋ",
          "ତେଡ଼େ ଅପରାଧୀ ମୁହିଁ ହୋଇ ନାହିଁ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଙ୍କେଳି କୁଞ୍ଜରେ ବୋଲି କହିଥିଲା କୁନ୍ଦବଲ୍ଲୀ",
          "ସଙ୍କେତ କଥା ମନେ ରହିଲା ନାହିଁ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବକୁଳକୁ ଜବା ବୋଲି ବଞ୍ଜୁଳ କୁଞ୍ଜକୁ ଗଲି",
          "ସୁକୁମାରୀକି ଲୋଡ଼ିଲି କେତେ ଠାଇଁ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲଳିତାନନ୍ଦଦା କୁଞ୍ଜେ ଲୋଡ଼ି ଲୋଡ଼ି ଗଲି ମୁଁ ଯେ",
          "ଅଳୀକ ନୁହଇ ସହି ସତ ଏହି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହେ ରସେ ରଘୁନାଥ କବି କୁମୁଦିନୀ ନାଥ",
          "ରହେ କାହାର ଆୟତ୍ତ ହେଲେ ସ୍ନେହୀ ଗୋ"
        ]
      }
    ]
  },
