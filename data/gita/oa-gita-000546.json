{
  "id": "oa-gita-000546",
  "name": {
    "en": "Balabara re sankha kanthi tu",
    "or": "ବାଳାବର ରେ ଶଙ୍ଖକଣ୍ଠୀ ତୁ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/balabara-re-sankha-kanthi-tu-mukhabari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାଳାବର ରେ",
          "ଶଙ୍ଖକଣ୍ଠି ତୁ ସଙ୍ଖାଳି ମୋର ରେ ।",
          "ନ ଥାଇ ତୁ କୋଳେ କି ସମ୍ପତ୍ତି ବଳେ",
          "ଇନ୍ଦ୍ର ହେଲେ ସୁରେଶ୍ଵର ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚନ୍ଦ୍ରମା ଚନ୍ଦନ କଳକଣ୍ଠ ସ୍ବନ",
          "ମିଳିନ୍ଦବୃନ୍ଦ ଝଙ୍କାର ରେ",
          "ଏବେ ମୁଁ କଟାକ୍ଷ ଫିଙ୍ଗୁ ନାହିଁ ପକ୍ଷ",
          "ହେବାରୁ ତୁ ସହକାର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସୁରଭି ଋତୁର ମରୁତ ମରୁ ତ",
          "ଜୀଉ ତ ସେ ମୋ କିଙ୍କର ରେ",
          "ତରୁଣୀ ତୋତେ ମୋ ଧନ କଲେ ଯହୁଁ",
          "କରୁଣାନିଧି ଶଙ୍କର ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅସୁର ସୁରଙ୍କ ରମ୍ୟ ଦ୍ରବ୍ୟ ରଙ୍କ",
          "-ପଣ ଶୁଣି ସିନ୍ଧୁ ଜୂର ରେ",
          "ମୋ ପାଇଁ ତୁ ଲୁକି ଯତନେ ଥିଲୁ କି",
          "ଲାବଣ୍ୟ ପୀୟୂଷପୂର ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୁଲକ୍ଷଣ ବଧୂମାନଙ୍କର ମଧୁ",
          "ଥାଏ ଜାଣି ରଦାମ୍ବରରେ",
          "ପୂରିଅଛି ତୋର ପ୍ରପଦୁଁ ଚିକୁର",
          "ପାଶ ଯାଏ ସୁଧାଝର ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଫୁଲା ମନମଥ ଗୁଲାମରୁ ମୋର",
          "ଏଣିକି ଆଉ କି ଡର ରେ",
          "ଝୁଲା ମଞ୍ଜୁଳ ତୋ ଲଲାମ ଛବିକି",
          "ସଲାମ ସହସ୍ରେ ଥର ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏପରି ପ୍ରଶଂସାମୃତ ସ୍ଫୁରୁ କଂସା",
          "-ହିତ ମୁଖ ଶଶଧରରେ",
          "ଅଷ୍ଟଦୁର୍ଗପତି ରଚିଲେ ଶ୍ରୀମତୀ",
          "ସଙ୍କୁଚିଲେ ଲଜ୍ଜାଭରରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
