{
  "id": "oa-gita-001364",
  "name": {
    "en": "Jachi katha kuha jiba re",
    "or": "ଯାଚି କଥା କୁହାଯିବରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000194"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jachi-katha-kuha-jiba-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯାଚି କଥା କୁହାଯିବରେ ଜାଣିମୁ ଥା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲଳିତ ତ୍ରିଭଙ୍ଗ ଭଙ୍ଗୀ ନଟବର ସଜ",
          "ବରହ ଉତ୍ତଂଶ ବଂଶୀବସା ମୁଖାମ୍ଭୋଜ",
          "ଯଦି ମନରେ ପଡ଼ିବରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଧୁ ଉଦୟରେ କି କୁମୁଦ ନ ଫୁଟିବ",
          "ଚନ୍ଦ୍ରକାନ୍ତ ମଣିକି ଦରବି ନ ସ୍ରବିବ",
          "ଆସନ୍ତୁ ସେ ଜଣାଯିବରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କ୍ଷଣ ନ ଦେଖିଲେ ଯାହାଙ୍କୁ କୋଡ଼ିଏ ଥର",
          "ଆଳୀଙ୍କି ପଟାଇ ଅଣାଉ ଥାଇ ଖବର",
          "ସେ ଲୋଭ କି ଛାଡ଼ିହେବରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାଳୀୟ ମଥାରେ କଲା ଦିନ ସେ ନର୍ତ୍ତନ",
          "ଯାହା ହୋଇଗଲୁ କରିଥିଲୁ ଯେ ଗୁମାନ",
          "ଚିନ୍ତା ଚିତ୍ତେ କି ନ ଥିବରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଭିମନ୍ୟୁ ସକୁଟୁମ୍ବ ହୋଇ ମଥୁରାକୁ",
          "ଯିବ ବୋଲି କାଲି କହୁଥିଲା ଜଟିଳାକୁ",
          "ପଡ଼ିଛି ତ ଉପଦ୍ରବରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଛନ୍ନ ହୋଇ ଶ୍ରୀ ରାଧିକା ଆଳୀଙ୍କି ପଚାରୁ",
          "ସେ କହନ୍ତି ପଠାଇଛି ପୂର୍ଣ୍ଣମାସୀ ଠାରୁ",
          "ଗୋପାଳକୃଷ୍ଣ ଆସିବରେ"
        ]
      }
    ]
  },
  "sources": [
    {
