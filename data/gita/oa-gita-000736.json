{
  "id": "oa-gita-000736",
  "name": {
    "en": "Bandhu tu mora sina",
    "or": "ବନ୍ଧୁ ତୁ ମୋର ସିନା"
  },
  "composer": "oa-person-000029",
  "mula_raga": [
    "oa-raga-000172"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bandhu-tu-mora-sina-sabari-ramachandra-deba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବନ୍ଧୁ ତୁ ମୋର ସିନା ରସାଣ ସୁନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦାସ ଦୋଷକୁ ଧରି ରୋଷ ନ କର ଗୋରୀ",
          "ବାସ ବଦନେ ଦେଇ ଘୁଞ୍ଚି ବସନାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶାଣି ମଦନ ଶର ଟାଣି ବିନ୍ଧଇ ଉର",
          "ଜାଣି ସମୟ ବନ୍ଧୁ ପାଣି ଦିଅନାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ଦୋଷ କଲି କହ ବିନାଶ କଲୁ ସ୍ନେହ",
          "କେ କି କହିଛି ତୋତେ ଘେନା କରନା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଜନ୍ମସୁଖୀ ଆସ ଆଜ ସୁରତେ ତୋଷ",
          "ରାମଚନ୍ଦ୍ର ମହୀନ୍ଦ୍ର ମନ କାମନା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
