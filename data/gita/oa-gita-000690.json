{
  "id": "oa-gita-000690",
  "name": {
    "en": "Asa nahi banchibi ki para",
    "or": "ଆଶା ନାହିଁ ବଞ୍ଚିବି କି ପରା"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000169"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asa-nahi-banchibi-ki-para-karunasri-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଶା ନାହିଁ ବଞ୍ଚିବି କି ପରା ରେ ଜବାଧରା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏ ତ ଅଖଣ୍ଡ ବିପତ୍ତି ଆସିଲା କି ପରିସ୍ଥିତି",
          "ଗୁଣି ଗୁଣି ତୋର ରୀତି ବରତିବି କି ମୁଁ ଏଥି",
          "ତାହା ବିନା ଅଛି କେ ମୋ ଧରାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତା ଭଙ୍ଗୀ ଅନୁକ୍ଷଣରେ ନୃତ୍ୟ କଲା ନୟନରେ",
          "ଲବେ ପାଶୋରା ମନରେ ନ ହେଲା ସଖୀ ଜାଣରେ",
          "ଏ ଜଗତ ହେଲା ମୋତେ କାରା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହରାରି ହେଲା ବଇରି ମାନସେ ରୋଷ ବିଚାରି",
          "ଶର ବିନ୍ଧୁଛି ଓଟାରି କେହୁ ପାରିବ ଉଦ୍ଧରି",
          "ପାଶେ ନାହିଁ ଏବେ ସେ ସୁଧୀରା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତା ସେବାରେ ଥିବି ରହି ବୋଲି ଅତି ଆଶା ବହି",
          "ଥିଲି ଭଙ୍ଗାଇଲା ବିହି ବୀରବିକ୍ରମ ବୋଲଇ",
          "ଦୂର ହେଲା ମୋ ପ୍ରେମ ପସରା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
