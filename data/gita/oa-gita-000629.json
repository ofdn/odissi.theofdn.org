{
  "id": "oa-gita-000629",
  "name": {
    "en": "Dekha sakhi kede sobha",
    "or": "ଦେଖ ସଖି କେଡ଼େ ଶୋଭା"
  },
  "composer": "oa-person-000117",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-sakhi-kede-sobha-saranga/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖ ସଖି କେଡ଼େ ଶୋଭା ନନ୍ଦନନ୍ଦନ ଗୋ",
          "ଧୀରେ ଧୀରେ କରେ ଗତି ମତି ମୋହନ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହୋଇ ନଟବର ବେଶ କଟି ତଟେ ପୀତବାସ",
          "ସୁରଭି ରେଣୁ ଶ୍ରୀଅଙ୍ଗେ ଦିଶେ ଶୋଭନ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭୂଷଣ କେକୀ ପୁଚ୍ଛରେ ଗୋପ ଗୋବତ୍ସା ପଛରେ",
          "ଆସେ କି ଆଶେ ଧରଣୀ କରି ମଣ୍ଡନ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଧରେ ମୁରଲୀ ଦେଇ ମଧୁରେ ଧ୍ୱନି କରଇ",
          "ପତିବରତା ବରତ ହେବ ଖଣ୍ଡନ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅସ୍ଥିର ହେଉଛି ଦେହ ଏ ଶୋଭା ଚାହିଁ ବିଦେହ",
          "ଶରେ କେ ନୋହିବ ମୋହ କହ ବହନ ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭୃଙ୍ଗବର ରାୟ କହି ତୁ ଅଛୁ ଏକା ସୁମୁହୀଁ",
          "କହି ଶ୍ରୀ କୃଷ୍ଣ ବିଜୟେ ନିଜ ସଦନ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-sakhi-kede-sobha-saranga/"
    }
  ],
