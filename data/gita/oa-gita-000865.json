  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hiraka-nibha-deham-kalyana-sanskrit-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହୀରକ-ନିଭ-ଦେହଂ ଭଜାମ୍ୟହଂ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୌନି-ଗଣାର୍ଚ୍ଚିତଂ ନିର୍ଜର-ସେବିତଂ",
          "ବାରଣମୁଖ-ତାତଂ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୋପତି-ବାହନଂ ପାବକ-ଲୋଚନଂ",
          "ଭୂମିଧର ସୁତେନଂ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପନ୍ନଗ-ଭୂଷଣଂ ପାତକ-ଶୋଷଣଂ",
          "ମାରିତ ସୁମ-ବାଣଂ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାଣ୍ଡବ-ଲାଳସଂ କୋମଳ-ମାନସଂ",
          "ତାରଧର-ନିବାସଂ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅନ୍ଧକ-ନାଶକଂ ବିକ୍ରମ-ପାଳକଂ",
          "ପାଣିଧୃତ ପିନାକଂ"
        ]
      }
    ]
  },
  "sources": [
    {
