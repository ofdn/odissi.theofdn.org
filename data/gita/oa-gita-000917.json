{
  "id": "oa-gita-000917",
  "name": {
    "en": "Are sarasija mukhi",
    "or": "ଆରେ ସରସିଜ ମୁଖୀ"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000005"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/are-sarasija-mukhi-bhairabi-kisorachandra-basanta-rahasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆରେ ସରସିଜ ମୁଖୀ ମନୋଜ କେଳି ଲାଳସୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅମୂଲ୍ୟ ମନ ଚିନ୍ତା ରତନ କରେ ନିବେଶି",
          "ସଂପୁଟେ ଅତି ଆଗ୍ରହ ତତି",
          "ଯୁକ୍ତ କି ମଧୁରହାସୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲୋକ ନିପୁଣ ବଦାନ୍ୟପଣ ଗୁଣ ପ୍ରକାଶି",
          "ତନୁ ଦାନରେ ନୁହ ଧନରେ",
          "କୃପଣ ଭାବେ ଲାଳସୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆୟାସୀ କେତେ ହେଲେନି ସତେ କୁଞ୍ଜବିଳାସୀ",
          "ପ୍ରବଳ କୃପା ନିଧାନି ତ୍ରପା",
          "ଚିତ୍ତୁ ଦିଅ ବରକାଶି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୋ ପୁଣ୍ୟ ବାର ନର ଆକାର ଧରି ସୁକେଶୀ",
          "ଅଛନ୍ତି ଆଗେ ନ ତେଜି ରାଗେ",
          "ରାଜେନ୍ଦ୍ର ନାମ ଭରସି"
        ]
      }
    ]
  },
  "sources": [
