{
  "id": "oa-gita-000027",
  "name": {
    "en": "Dinabandhaba daitari",
    "or": "ଦୀନବାନ୍ଧବ ଦଇତାରି"
  },
  "composer": "oa-person-000019",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dinabandhaba-daitari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦୀନବାନ୍ଧବ ଦଇତାରି",
          "ଦୁଷ୍ଟଦାନବ ଦର୍ପଦଳନ",
          "ଦୁଃସହଦୁଃଖହାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦମ୍ଭଶିଖରୀ କର ହେ ଚୂର୍ଣ୍ଣ",
          "ପୁଣ୍ୟେ ଅନ୍ତର କର ହେ ପୂର୍ଣ୍ଣ",
          "ଦୁର୍ଗମ ପଥ କର ହେ ସୁଗମ",
          "ସୁଦର୍ଶନଚକ୍ରଧାରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସତ୍ୟ ସୁନ୍ଦର କର ହେ ଦାନ",
          "ମଙ୍ଗଳରୂପୀ ହେ ଭଗବାନ",
          "ସଂସାରଜନ ଚିତ୍ତେ ବରଷ",
          "ଶୁଭ ଆଶିଷ ବାରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜନମ ମରଣ ମାୟାପାଶ",
          "ବନ୍ଧନ ପ୍ରଭୁ କର ହେ ନାଶ",
          "ଦୁସ୍ତର ଭବସାଗରୁଁ କୃଷ୍ଣ",
          "କେଶବ କର ପାରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଖଣ୍ଡନ କର କରମଲେଖା",
          "ମର୍ମଦେବତା ଦିଅ ହେ ଦେଖା",
          "ବଜାଅ ମୋହନ ମୁରଲୀ ମାନସ",
          "କୁଞ୍ଜକାନନଚାରୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dinabandhaba-daitari/"
    }
  ],
