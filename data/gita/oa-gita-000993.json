  "name": {
    "en": "Tikaka dosaku rama",
    "or": "ଟିକାକ ଦୋଷକୁ ରାମା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000038"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000004"
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tikaka-dosaku-rama-kede-rusa-ratnakara-champu-desakhya-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଟିକାକ ଦୋଷକୁ ରାମା କେଡ଼େ ରୁଷା ରୁଷିଲାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଟୋପରେ ପକାଇ ଗୋପେ ନିଗ୍ରହ ଶଲ୍ୟ ବିଶେଷେ",
          "ମୋ ସୁଖମୃଗକୁ ତ ସେ ଧରାଭୂଷା ଭୁଷିଲାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଟାକର ମାରି ମୋ ଆଶା ମୁଣ୍ଡେ ଖଞ୍ଜରୀଟ ଦୃଶା",
          "ପରିପନ୍ଥୀ ଲୋକହସା କରିବାକୁ ବସିଲାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଟିକିଏ ହେଲେ ବିବେକ ନ କରି ସେବକ ବେକ",
          "କରତ ବୋଲି ଦର୍ପକ ଦାରୁଣକୁ ପେଷିଲାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଟମକ ଯେ ବାଜେ ବ୍ରଜବଜାରେ ଦୟାଳୁରାଜ",
          "ବୋଲି ମୋ ଦଣ୍ଡରୁ ଆଜ ଦାଣ୍ଡକୁ କି ଦିଶିଲାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଟୋକୀଏ ଥିଲେ ଗହଣେ ଟାକି ଉରୋଜ ଅଗ୍ରଣେ",
          "ଟିପିଦେଲି ନଖ ସେହି କଥାକୁ କି ଘୋଷିଲାରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଟେକାନ୍ତା ବିବେକବତୀ ମଣ୍ଡଳେ ବଳକ୍ଷଛତି",
          "ବୋଲେ କବିରବି ସବୁ କ୍ରୋଧନଦେ ଭାସିଲାରେ"
        ]
      }
    ]
  },
