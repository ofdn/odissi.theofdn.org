{
  "id": "oa-gita-001257",
  "name": {
    "en": "Kinchita hele ta chitta to snehe",
    "or": "କିଞ୍ଚିତ ହେଲେ ତା ଚିତ୍ତ ତୋ ସ୍ନେହେ"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000053"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kinchita-hele-ta-chitta-to-snehe-raga-soma-adatali-biramitrodaya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କିଞ୍ଚିତ ହେଲେ ତା ଚିତ୍ତ ତୋ ସ୍ନେହେ ନ ରସିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭାଷୁଁ ତୋର ଅନୁନୟ ଅସୁଖ ମଣି ହୃଦୟ",
          "ଭିତରେ ଦ୍ୱିଗୁଣ ରୋଷ ଧରି ରଦ କଷିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭଙ୍ଗୀରୁ ହେଲେ ତାହାର ଅଙ୍ଗୀକାର କରିବାର",
          "ଜଣା ନ ଗଲା କେବଳ ମନ୍ଦମନ୍ଦ ହସିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶଙ୍କା ନ ରଖି ଚିତ୍ତରେ ଏକା ତୁ କାନନାନ୍ତରେ",
          "ଆସିଲୁ କି ହେତୁ ବୋଲି ବାରବାର ଘୋଷିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବଳରେ ତାହା ପୟର ତଳରେ ଲଗାଉଁ ଶିର",
          "କେହି ସଖୀ ମୋତେ ପଛ କରି ବସିଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତପନୀୟ ପୁର ଯୁବ ଭୂପତି ରଚେ ଏ ଭାବ",
          "କହୁ କି ଗୁଣରେ ତାକୁ ଭଜିଲୁ ତୁ ସୁଶୀଳା ରେ"
        ]
      }
    ]
  },
