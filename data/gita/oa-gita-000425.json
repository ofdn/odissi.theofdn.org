{
  "id": "oa-gita-000425",
  "name": {
    "en": "Parana sangini aja",
    "or": "ପରାଣ ସଙ୍ଗିନୀ ଆଜ"
  },
  "composer": "oa-person-000027",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/parana-sangini-aja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପରାଣ ସଙ୍ଗିନୀ ଆଜ",
          "ପର ପରା ଯା କଲେ ଗୋ ବ୍ରଜ ରସିକରାଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖରାଂଶୁ ତନୟା ତଟେ । ଧରା ପଡ଼ିଗଲି ବାଟେ ।",
          "ସରାଗର ଚାହିଁଦେଲି ନନ୍ଦଆତ୍ମଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହରାରି ହୋଇଣ ବାଦୀ । ଶରାସନେ ଶର ସନ୍ଧି ।",
          "ପରାଭବ ଦେଲା ଯେତେ କହିବା ଲାଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମରାଳଗତି ନବୀନା । ବରାଙ୍ଗିନୀ ମୁଁ ତୋ କିଣା ।",
          "ଥରାଇଲେ ଏହା କହି ସଖୀ ସମାଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହରାଇ ବସିଲି ବୁଦ୍ଧି । ସରାଇ ଲାଜ ଅବଧି ।",
          "କରାଇଲେ ଯାହା ନ ରହିଲା ଧଇର୍ଯ୍ୟ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତାରାପତି ବେଣୁଧର । ସେ ରାଜୀବାକ୍ଷ ପୟର ।",
          "ବେରାଜି ହେବ କି ଶ୍ୟାମ ଧଇଲେ ଭୁଜ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
