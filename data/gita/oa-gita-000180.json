    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନାରେ ମୀନବରନୟନା",
          "ମନରୁ ପରିହର ବିମନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୃଦୁଳେ ଥରେ କହି ଭାରତୀ",
          "ହୃଦରୁ ହରରେ କାମଭୀତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗଣ୍ଡରେ ଗଣ୍ଡକୁ ଯୋଖି ଧନ",
          "ଦଣ୍ଡକୁ ହର ଦେଇ ଚୁମ୍ବନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ବିନା କେ ଅଛି ମୋର ଗତି",
          "ନବୀନା କହ ଥରେ ଭାରତୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଗନ୍ନାଥ ରାଜମଣି ସୁତ",
          "ସରାଗରେ କହିଲେ ଏ ଗୀତ"
        ]
      }
    ]
  },
