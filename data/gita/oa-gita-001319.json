{
  "id": "oa-gita-001319",
  "name": {
    "en": "Madana mohana brundabana dhana",
    "or": "ମଦନ ମୋହନ ବୃନ୍ଦାବନ ଧନ"
  },
  "composer": "oa-person-000132",
  "mula_raga": [
    "oa-raga-000138"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madana-mohana-brundabana-dhana-malaba-kousika/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଦନ ମୋହନ ବୃନ୍ଦାବନ ଧନ",
          "ନମାମି ହେ ଶ୍ରୀହରି",
          "(ପଡ଼ି)",
          "କାନ୍ତି ନବଘନ ପଦ୍ମ ଲୋଚନ",
          "ଭାଲେ ଚନ୍ଦନ ଇନ୍ଦୁ ନିନ୍ଦନ",
          "ଅଧର ମୋହନ ବଂଶୀ ବଦନ",
          "କୋଟି ରତିପତି ଦର୍ପହାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବହୁ ରତ୍ନ ହାର ଦେଲି ଉପହାର",
          "ସୁସମାଦି ଏ ସାରି",
          "(ପଡ଼ି)",
          "ରସିକ ନାଗର ସୁରସ ସାଗର",
          "ଗୋବର୍ଦ୍ଧନ ଧର କାଳୀ ବିଷହର",
          "ନନ୍ଦକୁମର ଯୁବତୀ ଚିତ୍ତଚୋର",
          "ଦୟା କର ବାରେ ରାବଣାରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ରୀ ରାଧା ନାୟକ ଭକ୍ତି ପ୍ରଦାୟକ",
          "ଜୟ ନୀଳାଦ୍ରି ବିହାରୀ",
          "(ପଡ଼ି)",
          "ଯାମଳାର୍ଜ୍ଜୁନ ଭଞ୍ଜନ ଘନ",
          "ଶ୍ୟାମ ହେ ଦେବ ଦେବ ବନ୍ଦନ",
          "କେଶବ ମର୍ଦ୍ଦନ ତ୍ରିତାପ ଖଣ୍ଡନ",
          "ଦୟା ହେଉ ଦୀନେ ପ୍ରେମ ବାରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନ କଲେ କରୁଣା ଆହେ ଦୀନବନ୍ଧୁ",
          "ନିଶ୍ଚେ ଗଲିଟି ସରି",
          "(ପଡ଼ି)",
          "ଭାଷଇ ମୋହନ ହେ ମଧୁସୂଦନ",
          "ଗୋପୀ ଭାବେ ହୃଦ ହୁଅଇ ଉଚ୍ଛନ୍ନ",
          "ନିକୁଞ୍ଜ କାନନେ କରି ବଂଶୀ ସ୍ୱନ",
          "ଦେଖିବା ନୟନେ ବାରେ ରାସେଶ୍ୱରୀ"
        ]
      }
    ]
  },
