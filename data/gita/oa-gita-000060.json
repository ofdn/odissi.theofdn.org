{
  "id": "oa-gita-000060",
  "name": {
    "en": "Krusna krusna krusna bhasare",
    "or": "କୃଷ୍ଣ କୃଷ୍ଣ କୃଷ୍ଣ ଭାଷରେ"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/krusna-krusna-krusna-bhasare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୃଷ୍ଣ କୃଷ୍ଣ କୃଷ୍ଣ ଭାଷରେ । ମୂଢ଼ମାନସ ।",
          "ତଦ ଦାସ ପାଶେ ବସି ତୁ ତୋଷରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଷ୍ଟ ଘୁଞ୍ଚିବ ହୃଷ୍ଟ ହୋଇ",
          "ସନ୍ତୁଷ୍ଟରେ ଭଜ ଦୁଷ୍ଟ ତୋର",
          "ଅଦୃଷ୍ଟ ନାଶିବେ ନଷ୍ଟ ଆଚରି",
          "ଭ୍ରଷ୍ଟ ନ କର ସ୍ପଷ୍ଟେ କହୁଛି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରେମାଞ୍ଜନ ରଞ୍ଜି ନୟନରେ । କୁଞ୍ଜବନରେ ।",
          "ଅଞ୍ଜନ ନିଭ ନବ ମୋହନରେ ।",
          "କଞ୍ଜଚରଣ ମଞ୍ଜୁଳ ଅତି",
          "ଗଞ୍ଜିତ ରମା ଉମାର କାନ୍ତି",
          "ଖଞ୍ଜନାକ୍ଷି ରାଧିକାରେ",
          "ସୁସଞ୍ଜିତ ହୋଇଛନ୍ତି ଭାବି ଧୀରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଙ୍ଗିନୀ ରସରଙ୍ଗିନୀ ସଙ୍ଗରେ । ତ୍ରଭିଙ୍ଗୀଭଙ୍ଗରେ ।",
          "ଅଙ୍ଗୀକୃତ ହେବାର ରଙ୍ଗରେ ।",
          "ରଙ୍ଗଣୀମାଳା ଅଙ୍ଗ ପରେ",
          "ଅନଙ୍ଗ ଦରପ ଭାଙ୍ଗିଦେବାରେ",
          "ତୁଙ୍ଗ ମଧୁର ମଙ୍ଗଳବଂଶୀ",
          "ଗାନ ଶୁଣିବୁ ଅତି ହରଷରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନ୍ଦ ଶ୍ରୀଗୁରୁ ପାଦ ବନ୍ଧରେ । ମାୟାବନ ତେଜି ।",
          "ଆନନ୍ଦରେ କର ହରି ର୍ଦ୍ଧନରେ ।",
          "ନନ୍ଦନନ୍ଦନ ଚନ୍ଦ୍ରବଦନ",
          "ମନ୍ଦରଧର କୁନ୍ଦରଦନ",
          "ସୁନ୍ଦର ସେ ଶିଖଣ୍ଡମଣ୍ଡନ",
          "ଭାବିତ ହରିବନ୍ଧୁ ବଚନ"
        ]
      }
    ]
  },
  "sources": [
    {
