{
  "id": "oa-gita-000893",
  "name": {
    "en": "Nabina nirada garajila",
    "or": "ନବୀନ ନୀରଦ ଗରଜିଲା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000124"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nabina-nirada-garajila-mallara-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବୀନ ନୀରଦ ଗରଜିଲା ରେ",
          "ନିରତ ନୀର ଝରାଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରସି ନୀଳଶାଢ଼ୀ ତନୁରେ ସଜାଡ଼ି",
          "ଘୋଷିଲାରେ ଘୋଷିଲା ବିଜୟ ସୌଦାମିନୀ",
          "ବର ବିଳାସିନୀ ସେ ଯେ ଗରବିଣୀ",
          "ହସି ଭୂରୁଭଙ୍ଗୀ ସରଜିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରୂପା ଜରି ବୁଟା ଖଞ୍ଜି ଗୋଟେ ଗୋଟା",
          "ବାସିଲାରେ ବାସିଲା ମାଳତୀ ସୋହାଗିନୀ",
          "ଚୋର ମଧୁକର ଚାଟୁ ଭଣିବାର",
          "ନାଗରପଣ ତ ଅରଜିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାଗରବର ହିଆ ଚିରି ଦେବ କିଆ",
          "କରତ ଧାରାରେ ଡରାଇଲା",
          "କହେ କବିଶଶୀ ବାରିରେ ବିଳସି",
          "ମଧୁ ମକରନ୍ଦ ବରଜିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
