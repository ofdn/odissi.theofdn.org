{
  "id": "oa-gita-001121",
  "name": {
    "en": "Aa re phula toli jiba brundabana",
    "or": "ଆ ରେ ଫୁଲ ତୋଳି ଯିବା ବୃନ୍ଦାବନ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000135"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aa-re-phula-toli-jiba-brundabana-gopalakrusna-nalinigouda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆ ରେ ଫୁଲ ତୋଳି ଯିବା ବୃନ୍ଦାବନ",
          "ଆସିଲେନି ଆଳୀ ନିକର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତମାଳ ବନଟି ଘନ ପରି ଦିଶେ ଶୋଭାବନ",
          "ବିଦ୍ୟୁ ପରି ଫୁଟିଅଛି ସୁମନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୀଳ ଶାଢ଼ୀକି ତୋ ତନୁ ବିରାଜୁ ଅଛି ସୁତନୁ",
          "ଦେଖି ଡରି ପଳାଇବ ମଦନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୁଣି ଯମୁନାରେ ପଶି ସ୍ନାନ କରିବା ସୁବେଶି",
          "ମାଳା ଲାଗି କରିଦେବି ବହନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଳା ଡୋଳାକୁ ଢଳାଇ ଭୋଳା କରି ଦେବୁ ତୁହି",
          "ହେଳା ମାତ୍ରେ ମୋହ ହେବେ ମୋହନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଡାକୁ ଲଳିତାଙ୍କ ଗିରେ ଶୁଣି ଚଳିଲେ ସତ୍ୱରେ",
          "ଭାବି ଗୋପାଳକୃଷ୍ଣର କଥନ"
        ]
      }
    ]
  },
  "sources": [
