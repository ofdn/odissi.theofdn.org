{
  "id": "oa-gita-000047",
  "name": {
    "en": "He janardana bhagabana",
    "or": "ହେ ଜନାର୍ଦ୍ଦନ ଭଗବାନ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/he-janardana-bhagabana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହେ ଜନାର୍ଦ୍ଦନ ଭଗବାନ",
          "ଅନ୍ତର୍ଯ୍ୟାମୀ ନାରାୟଣ",
          "କାରଣ ତାରଣ ଶରଣ ରକ୍ଷଣ",
          "ପରମ କାରଣ ପରମ ଧାରଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଶ୍ୱସ୍ଥିତି କାରଣ ବିଶ୍ୱଜନ ପାଳନ",
          "ବିଶ୍ୱ ଈଶ୍ୱର ଦୀନ ନିଃସ୍ୱ ନିସ୍ତାରଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପତିତପାବନ ଗତି ପରାୟଣ ।",
          "ଦୁର୍ଜ୍ଜନଦଳନ ସଜ୍ଜନଜୀବନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜଗଜ୍ଜନ ପରାଣ ଭବଭୟ ମୋଚନ ।",
          "ଭକ୍ତ ହୃଦ ଅଧୀନ ଭାବବିନୋଦନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନିତ୍ୟ ନିରଞ୍ଜନ ବିପଦ ଭଞ୍ଜନ ।",
          "ବନ୍ଦେ ନିଶିଦିନ ତାରିଣୀ ଚରଣ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
