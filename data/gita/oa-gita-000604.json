{
  "id": "oa-gita-000604",
  "name": {
    "en": "Sri hari he rajani pahila",
    "or": "ଶ୍ରୀ ହରି ହେ ରଜନୀ ପାହିଲା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "kabya": {
    "id": "oa-kabya-000004"
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-hari-he-rajani-pahila/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ରୀ ହରି ହେ ରଜନୀ ପାହିଲା",
          "ଶତପତ୍ର ବନରୁ ପବନ ମନ୍ଦ ମନ୍ଦ ବହିଲା",
          "ଶମନ ଭଗିନୀର ନୀରଜାଙ୍ଘ୍ରି ନୂପୁର",
          "ପରିପୂରିତ ମନୋରଥ ରଥାଙ୍ଗ ସ୍ୱର",
          "ଶଶିକର ଶୀକର ନିକର ଅସ୍ତଧର",
          "ବରଚୂଳକୁ ମାତ୍ର ଚାହିଁଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରମ ସିନ୍ଧୁ ମଧ୍ୟେ କେ ସାହସ ତରୀ ବାହିଲା",
          "ଶଙ୍କା ଲେଶ ହେଲେ ଦିବ୍ୟ ଚିତ୍ତକୁ ନ ପାଇଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶମ୍ଭୁ ପରିପନ୍ଥୀ ତୂଣେ କେତେ ବାଣ ବହିଲା",
          "ଶୃଙ୍ଗାର ଶାସ୍ତ୍ରକୁ ନିଶି ସମୟ ନ ସହିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶାବକ ମୃଗାକ୍ଷୀ କେତେ ଜନ୍ମ ତପେ ଦାହିଲା",
          "ଶମ୍ବାୟୁଧ ମଣି ଶ୍ୟାମ ତନୁ ମନ ମୋହିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶରଦିନ୍ଦୁ ସୁଧାସୂତନାଳକୁ କି ବହିଲା",
          "ଶ୍ରବଅବତଂସ କଳହଂସ ଧ୍ୱନି ନୋହିଲା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶମ୍ବରାରି ସଉଚିକ ଏ ଭୀତିକି ବହିଲା",
          "ଶର ସୂଚୀରେ ଶରୀର ଯୁଗ ଗାଢ଼େ ସିଇଁଲା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶୂର କବିକର ପଦକଞ୍ଜ ତଳେ କହିଲା",
          "ଶେଷ ଆଜ ନିଶାକୁ ରହିଲେ ପଛେ ରହିଲା"
        ]
      }
    ]
  },
  "sources": [
