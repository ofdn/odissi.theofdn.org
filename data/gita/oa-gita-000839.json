{
  "id": "oa-gita-000839",
  "name": {
    "en": "Madhu rutu sangare bije",
    "or": "ମଧୁ ଋତୁ ସଙ୍ଗରେ ବିଜେ"
  },
  "composer": "oa-person-000043",
  "mula_raga": [
    "oa-raga-000089"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madhu-rutu-sangare-bije-mohana-kedara-dinabandhuraja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଧୁ ଋତୁ ସଙ୍ଗରେ ବିଜେ",
          "ରାଜ ରାଜ ଅନଙ୍ଗ",
          "ମଲ୍ଲୀ କୋରକ ଶଙ୍ଖ ଧରି କରେ",
          "ନାଦ ମାଳିକ ଭୃଙ୍ଗ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମନ୍ଦ ପବନ ଗୁରୁରେ ପ୍ରେରିତ",
          "କୁସୁମ ଭୂଷଣ ଗଣେ ସୁଭୂଷିତ",
          "ବଲ୍ଲୀ କାମିନୀ ନାଚେ ଅବିରତ",
          "ହୋଇ ହରଷିତ ଅଙ୍ଗ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମତ୍ତ କୋକିଳ ଡିଣ୍ଡିମ",
          "ପକ୍ଷୀକୁଳ ରବ ବାଦ୍ୟ ମନୋରମ",
          "ନାଗକେଶର ପଲ୍ଲବ ଧ୍ୱଜ",
          "ବୃନ୍ଦ ଶୋଭଇ ତୁଙ୍ଗ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚାରୁ କେତକୀ କୁନ୍ତ ମଧୁକର",
          "ପନ୍ତି ମଞ୍ଜୁଳ କାନ୍ତି ଅସିବର",
          "କୁସୁମେ ମଣ୍ଡିତ ଅଶୋକ ତରୁକୁଳ",
          "ଚାରୁ ଚିତ୍ତ ସତାଙ୍ଗ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମାଧବୀ ସୁନିଆଳି ସେବତୀ",
          "କୁନ୍ଦ ଚମ୍ପକ ସୈନ୍ୟ ବିଳସତି",
          "କି ଏ ତରୁଣ ତମାଳ ତରୁବର",
          "ବାର ମତ୍ତ ମାତଙ୍ଗ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହଇ ଦୀନବନ୍ଧୁ ହରିଚନ୍ଦନ",
          "ଧନ୍ୟ ଏହୁ ଋତୁରାଜ ଶୋଭନ",
          "ରଚିଲେ ଯହିଁ ବ୍ରଜ କାମିନୀ",
          "ଘେନି ହୋରି ତରଙ୍ଗ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madhu-rutu-sangare-bije-mohana-kedara-dinabandhuraja/"
    }
  ],
