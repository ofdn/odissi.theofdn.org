{
  "id": "oa-gita-000433",
  "name": {
    "en": "Nahi nahi mu ja kahili",
    "or": "ନାହିଁ ନାହିଁ ମୁଁ ଯା କହିଲି"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000122"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nahi-nahi-mu-ja-kahili/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାହିଁ ନାହିଁ ମୁଁ ଯା କହିଲି",
          "ମାନ ମାରି ଆନ ମାନ ଦେଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାଧବୀ ଚାନ୍ଦିନୀ ରାତି । ମାଧବ ଥିଲେ ମୋ ସାଥୀ ।",
          "ପଥରେ ବନ୍ଧାଇ ଛତି ଗୁମାନେ ଯା ନ ଚାହିଁଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କର ଧରି କେତେ ମୋର । ରଚିଲେ ଗୋ ଚାଟୁ ଗିର ।",
          "ପର ପରା କରି ତାର ପରାଭବ ମୁଁ ସହିଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦୂରେ ଯା ବସିଲି ଘୁଞ୍ଚି । ଗରବ ରଖିଲି ସଞ୍ଚି ।",
          "ଧାର ଆଖି ନୀର ସିଞ୍ଚି ଜୀବେ ଯା ବଞ୍ଚି ରହିଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଚନ୍ଦ୍ର କହେ ଧୀରା । ଆପେ ତୁ ନ ଦେଲୁ ଧରା ।",
          "ଏ ନୁହେଁ ସୁଆଗ ଧରା ହୁଡ଼ିଲୁ ପୀରତି ଚାଲି"
        ]
      }
    ]
  },
  "sources": [
