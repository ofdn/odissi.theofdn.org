    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ଏ ଗୁମାନ ସଜନୀ ରେ",
          "ଆଜ କେ ଶିଖାଇଲା ମୋ ଗୁଣମଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘେନ ବିନତି ରତିଲାଳସୀ ରେ",
          "ହସି ଭାଷ ପଦେ ବୀଣାବାଣୀକି ।",
          "ତୁ ତ ଚତୁରୀ ଚିତ୍ତେ ବିଚାର ରେ",
          "ଅପରାଧ ହୁଅନ୍ତି ମୁଁ ଜାଣି କି"
        ]
      }
    ]
  },
