{
  "id": "oa-gita-000686",
  "name": {
    "en": "Aja saja saji tha re",
    "or": "ଆଜ ସଜ ସାଜିଥାରେ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000054"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-saja-saji-tha-re-kedaragouda-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ ସଜ ସାଜିଥାରେ ଝଟକ ହାଟକ ଗୋରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାନ୍ଧି ଅଭିରାମ ବେଣୀ ଖଞ୍ଜି ଶିରେ ମଥାମଣି",
          "ମାଙ୍ଗ ଭାଙ୍ଗ ମଧ୍ୟେ ପୁଣି ଲଗାଇ ସିନ୍ଦୂର ଶିରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କର୍ଣ୍ଣେ ଫଳକ ମଣ୍ଡନ ରଞ୍ଜି ନୟନେ ଅଞ୍ଜନ",
          "କଣ୍ଠରେ କଣ୍ଠ ଭୂଷଣ ଖଞ୍ଜିଣ ଯତନ କରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପିନ୍ଧି ନୀଳ ପୀତ ଶାଢ଼ୀ ହସ୍ତରେ ସୁବର୍ଣ୍ଣ ଚୂଡ଼ି",
          "ମଣିବନ୍ଧେ ଥିବ ଜଡ଼ି କଙ୍କଣ ଯେ ହୋଇ ବାରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଟିତଟରେ କିଙ୍କିଣୀ ପାଦରେ ବଳା ବାଜେଣୀ",
          "ଝୁଣ୍ଟିଆ ତଳେ ଖୁଣ୍ଟଣୀ କେବେ ନୁହଇଁ ପାଶୋରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୀରବିକ୍ରମର ବାଣୀ ଥାଅ ମନେ ନିଶ୍ଚେଁ ଜାଣି",
          "ଆସିବେଟି ବେଣୁପାଣି ଯାମିନୀ କି ଅର୍ଦ୍ଧ କରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
