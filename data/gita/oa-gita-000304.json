{
  "id": "oa-gita-000304",
  "name": {
    "en": "Sajani go na jani pirati jaha kali",
    "or": "ସଜନୀ ଗୋ ନ ଜାଣି ପୀରତି ଯାହା କଲି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000035"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-go-na-jani-pirati-jaha-kali-sindhu-kamodi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ଗୋ ନ ଜାଣି ପୀରତି ଯାହା କଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ନବନାଗର କାହ୍ନୁ କି ରଙ୍ଗେ ବଜାନ୍ତି ବେଣୁ",
          "ଶୁଣିଲା ବେଳରୁ ହୁଡ଼ିଗଲି ସଜନୀ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି କଲି ମୁଁ ମୂଢ଼ ମତି ହୋଇ ଏଡ଼େ କୁଳବତୀ",
          "କୁଳଶୀଳ ରଖି ନ ପାରିଲି ସଜନୀ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାହାରେ କହିବି ଏହା କେହି ନାହିଁ ମୋର ସାହା",
          "ଆହା ଆହା ବୋଲି ଝୁରି ମଲି ସଜନୀ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଦାସ କହେ ନାହିଁ ନା ଏବେ ଉପାୟେ",
          "ବେଳହୁଁ ତ ମୁହିଁ ହୁଡ଼ିଗଲି ସଜନୀ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
