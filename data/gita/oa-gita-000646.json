{
  "id": "oa-gita-000646",
  "name": {
    "en": "Nanda nandana badana chandramaku",
    "or": "ନନ୍ଦନନ୍ଦନ ବଦନ ଚନ୍ଦ୍ରମାକୁ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000161"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-nandana-badana-chandramaku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନନ୍ଦନନ୍ଦନ ବଦନ ଚନ୍ଦ୍ରମାକୁ",
          "ଦେଖି ସଖି ବାଇ ହୋଇଲୁ କି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘନବରନଙ୍କୁ ମନମୋହନା ତୁ",
          "ହୃଦ ସମ୍ପୁଟରେ ଥୋଇଲୁ କି ଗୋ",
          "ମନ ଛନ୍ନଛନ୍ନେ ନେତ୍ର ଥନଥନେ",
          "ପ୍ରିୟ ସଖୀ କର ଧଇଲୁ କି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅନବରତେ ତା ସନମତ୍ତ ପାଇଁ",
          "ଯମୁନା ପାଣିକି ଧାଇଁଲୁ କି ଗୋ",
          "ଜନ ଶୂନ୍ୟ ପଥେ ମନସିଜ ହାତେ",
          "ଏତେ ପରାଭବ ପାଇଲୁ କି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅନୁରାଗ ଛଳେ ବନୁ ଫୁଲ ତୋଳି",
          "ଉପହାର ଦେବି ବୋଇଲୁ କି ଗୋ",
          "ତନୁ ତା ତନୁରେ ମିଶାଇବା ପାଇଁ",
          "ଧନୁ ଭୂରୁ ଚାଳି ଚାହିଁଲୁ କି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାନୁସୁତା କୂଳେ କେଳି ନୀପ ମୂଳେ",
          "କାହ୍ନୁ ସ୍ନେହ ଭାଳି ହୋଇଲୁ କି ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦିନୁ ଦିନ ତୋର କି ନୂତନ ପ୍ରୀତି",
          "କଳ୍ପଲତାକୁ ବଢ଼ାଇଲୁ କି ଗୋ",
          "ମନୁ ପାଶୋରିବୁ ନାହିଁ ବେଣୁଧର",
          "ବିନତିକି ମାନି ରହିଲୁ କି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
