{
  "id": "oa-gita-000129",
  "name": {
    "en": "Ka mane thila e katha go",
    "or": "କା ମନେ ଥିଲା ଏ କଥା ଗୋ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000061"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ka-mane-thila-e-katha-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କା ମନେ ଥିଲା ଏ କଥା ଗୋ",
          "କଳା ଅଙ୍ଗ ସଙ୍ଗ* ହେବ ଅନ୍ୟଥା ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସସ୍ମିତ ମୃଦୁଳ ସରସ ଭାଷା",
          "ଶୁଣିବେ ମଥୁରାନଗରୀ ଯୋଷା ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ୱପ୍ନ ହୋଇବ ଶିଖଣ୍ଡମଣ୍ଡନ",
          "ନୋହିବ ନେତ୍ର ବିପଦ ଖଣ୍ଡନ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କସ୍ତୂରୀ ନୀଳୋତ୍ପଳ ମିଶା ବାସ",
          "ବ୍ରଜମଣ୍ଡଳେ ହେବ ଇତିହାସ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଙ୍କଜବାସିନୀ ଦାସୀ* ଯାର ସେ",
          "ମଜ୍ଜିଯିବେ ବୋଲ କୁବ୍ଜୀଟା ପାଶେ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସ୍ମରଜ୍ୱର ଶେଷେ ଜୀବନ ଯିବ",
          "ମଧୁରାଧର ଢୋକେ ନ ମିଳିବ ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଭାଜି ହେଉଥିବା କାମ ଦହନେ",
          "ରାଜୀବପଦ ନ ଲଦିବା ସ୍ତନେ ଗୋ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କେ ଜାଣିଥିଲା ଏ ଦଣ୍ଡ ପହିଲେ",
          "ଅଷ୍ଟଦୁର୍ଗ ଧରାଧୀଶ କହିଲେ ଗୋ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "*ପାଠାନ୍ତର : ଶ୍ୟାମ ଅଙ୍ଗ ସୁଖ, ପ୍ରିୟା ଯାର ସେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ka-mane-thila-e-katha-go/"
