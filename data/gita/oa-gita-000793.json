{
  "id": "oa-gita-000793",
  "name": {
    "en": "Bira bese go kali syama",
    "or": "ବୀର ବେଶେ ଗୋ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000131"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bira-bese-go-kali-syama-kokila-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବୀର ବେଶେ ଗୋ",
          "କାଲି ଶ୍ୟାମ ଆସିଥିଲେ ମୋର ପାଶେ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବେନି ଚରଣକୁ କରି ଯୋଡ଼ା",
          "କି ଭଙ୍ଗୀରେ ଯାଇ ହେଲା ଛିଡ଼ା",
          "(ପଡ଼ି)",
          "ପୟରେ ନୂପୁର ବାଜୁବନ୍ଧ ଘୁଙ୍ଗୁର",
          "ଝୁମୁଝୁମୁ ଝଙ୍କାର କରି ଗୁଣ ଟଙ୍କାର",
          "ଧୋ ଧ୍ରୀମି ତା ଧ୍ରୀମି ଧ୍ରୀମି ଧ୍ରୀମି ଥଲାଙ୍ଗୁ ଦଧିଘନ ତା",
          "କୁସୁମରେ ନେଇ ରଖାଇଲା ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲମ୍ବୋଦର ତାତ ରିପୁ ଯାର",
          "ସେନାପତି କହେ ତତପର",
          "(ପଡ଼ି)",
          "ରମଣୀ କି ଦେଖିଲି ସ୍ମରବାଣ ଯୋଖିଲି",
          "ମରମରେ ଭେଦିଲି ମନ କଥା କହିଲି",
          "ଧୋ ଧ୍ରୀମି ତା ଧ୍ରୀମି ଧ୍ରୀମି ଧ୍ରୀମି ଥଲାଙ୍ଗୁ ଦଧିଘନ ତା",
          "ରତିରସେ ନିଶି ପୁହାଇଲା ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୋଇଥିଲା ଶଶୀଧର ନାରୀ",
          "ଗଜଦନ୍ତ ରିପୁ ପଲଙ୍କାରି",
          "(ପଡ଼ି)",
          "ଦେଖିଥିଲି ପଲଙ୍କେ ଶୋଇଥିଲା ଉଲଙ୍ଗେ",
          "ଡାକ ଦେଲି ଆତଙ୍କେ ରଖ ତୁମ୍ଭେ ଏ ସଙ୍ଗେ",
          "ଧୋ ଧ୍ରୀମି ତା ଧ୍ରୀମି ଧ୍ରୀମି ଧ୍ରୀମି ଥଲାଙ୍ଗୁ ଦଧିଘନ ତା",
          "ପୁଣି ମନ ହେଲା ରତି ରସେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଏହୁ ରସେ ଭଣି",
          "ମୋ ପୁରେ ବିଜୟ କମ୍ବୁପାଣି",
          "(ପଡ଼ି)",
          "କାଲି ରାତି ଅର୍ଦ୍ଧରେ ଆସିଣ ମୋ ପାଶରେ",
          "ରତିପତି ଭଣ୍ଡାରେ କରିଣ ନାରଖାରେ",
          "ଧୋ ଧ୍ରୀମି ତା ଧ୍ରୀମି ଧ୍ରୀମି ଧ୍ରୀମି ଥଲାଙ୍ଗୁ ଦଧିଘନ ତା",
          "ପ୍ରବନ୍ଧରେ ପୁହାଇଲେ ନିଶି ଗୋ"
        ]
      }
    ]
  },
