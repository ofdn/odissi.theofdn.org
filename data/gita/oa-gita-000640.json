  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinki-e-gumana-re-ananda-kedara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ଏ ଗୁମାନ ରେ ସୁନାବରନା",
          "ବିନା ଦୋଷେ ସଜନୀ ଦାସରେ ତୁ ବିମନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ଦୋଷ ଦେଖି ସଖୀ ନ ଚାହୁଁ ମୁଖ ଟେକି",
          "ଚନ୍ଦ୍ରବଦନ ଶୁଖିଅଛିଟି ରେ ନବୀନା ।",
          "(ପଡ଼ି)",
          "ଆନ ନ ଘେନ ଚିତ୍ତେ ଅନା ହସି କିଞ୍ଚିତେ",
          "ମାନ ତେଜ ମାନସେ ମୁଞ୍ଚନା ସଖୀ ମୋତେ",
          "ଘୁଞ୍ଚି ବସନା ଘନକେଶୀ ମିନତି ଘେନା",
          "ରସବତୀ ରୁଷନା ରସରାଜରେ ଅନା"
        ]
      }
    ]
  },
