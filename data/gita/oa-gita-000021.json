{
  "id": "oa-gita-000021",
  "name": {
    "en": "Anti jaichi koti gunare",
    "or": "ଅଣ୍ଟିଯାଇଛି କୋଟିଗୁଣରେ"
  },
  "composer": "oa-person-000017",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/anti-jaichi-koti-gunare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅଣ୍ଟିଯାଇଛି କୋଟିଗୁଣରେ ପ୍ରିୟସଖି",
          "ଜଟି କହିଲେ ଆଉ କି ହେବ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପାଞ୍ଚିଥିଲି ମୁଁ ଚିତ୍ତେ ସ୍ନେହ ବଳିଛି ଯେତେ",
          "ସେ କି ମନରୁ ଭିନ୍ନ ହୋଇବ ଗୋ",
          "ସଞ୍ଚିଥିବାର ଚିନ୍ତାମଣି କି ଦୋଷ ମଣି",
          "ଛଡ଼ାଇ ନେଲା ପୁଣି ଦଇବ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେ ଜାଣିବ ମାନସ ବିଚ୍ଛେଦାନଳ ତ୍ରାସ",
          "ସେ ସିନା ସାରାସାର କହିବ ଗୋ",
          "ହେଜି କାଚକଳଶ ତୁଟିଲା ପରି ଆଶ",
          "ନାଶଗଲେ କି ଯୋଡ଼ିହୋଇବ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହେଲି ଅପରାଧିନୀ ଶ୍ୟାମରେ ଗୋ ସଜନୀ",
          "ତାହା ପଛକେ ଦେହ ସହିବ ଗୋ",
          "କେବେ ନୋହୁ ମାନିନୀ ଆମ୍ଭ ଚନ୍ଦ୍ରା ସଜନୀ",
          "ଏତିକି ମୋ ବିନତି କହିବ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କା ଆଗେ ଏହା କହି ଯାହା କଲେ ଗୋ ସେହି",
          "ତାହା ଭାବିଲେ ହୃଦ ଦହିବ ଗୋ",
          "ଲୋଡ଼ିଲେ ସୁଖ କାହିଁ ଶ୍ୟାମସୁନ୍ଦର କହି",
          "ଯାହାରେ ଯାହା ମନ ମୋହିବ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
