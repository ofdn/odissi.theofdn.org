{
  "id": "oa-gita-000456",
  "name": {
    "en": "Dara nahin ki he",
    "or": "ଡର ନାହିଁକି ହେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ḍa Patala",
      "or": "ଡ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dara-nahin-ki-he-para-taruni-haranu-bilahari-kabisurjya-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଡର ନାହିଁକି ହେ ପର ତରୁଣୀ ହରଣୁ",
          "ଡୋର ଲାଗି ଘେର ପଡ଼ିବ ଯେ ହେବ",
          "ଚୋର ପରି ଆଚରଣୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଡୋଳା ପ୍ରତିମାକୁ ପରାୟେ ତୁମ୍ଭଙ୍କୁ",
          "ଯଶୋଦା ଅଛନ୍ତି ପାଳି",
          "ଡୁବିବଟି ଧନ କେଳିକି ମୋହନ",
          "ଲୋଡ଼ୁଛ ଯେ କୁଳପାଳି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଡକା ଦେବା ଦିନେ ଅରିଷ୍ଟେ ଉତ୍ତାନେ",
          "ଦେଖିଛୁ ଶକଟ ଦଶା",
          "ଡାକିମଧ୍ୟମାକୁ ଡାକି ଆଣିବାକୁ",
          "ଏଠାକୁ କାହା ଭରସା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଡବ ଡବ ବାରି ନିଃସରିବ ଚାରି",
          "ପହରେ ନୟନ ଯୁଗୁଁ",
          "ଡହ ଡହ ହେବ ମୃଦୁ ଅବୟବ",
          "ଶ୍ୟାମ ଶ୍ରୀଅଙ୍ଗୁଟି ଭୋଗୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଡାକି ତ ଜାଣ ମୋହନ ବଂଶୀରବେ",
          "ବିହର ସୁଖେ ଏ ବନେ",
          "ଡୁଇଁ ହେବୁଁ ସିନା ଆମ୍ଭେ ଫଳ ବିନା",
          "ନ ପଡ଼ୁ ତା ଆମ୍ଭ କାନେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଡାଳିମ୍ବ ମଞ୍ଜି ମଞ୍ଜୁଳ ଦଶନା ସେ",
          "ଖେଳୁଥାଉ ତୁମ୍ଭ ତୁଲେ",
          "ଡେଉଁଥାଅ ବନଯାକ ତୁମ୍ଭ ମନ",
          "ଶ୍ରୀ ହରିଚନ୍ଦନ ବୋଲେ"
        ]
      }
    ]
  },
  "sources": [
    {
