{
  "id": "oa-gita-000491",
  "name": {
    "en": "Mohana riti chinha padila ma",
    "or": "ମୋହନ ରୀତି ଚିହ୍ନା ପଡ଼ିଲା ମା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohana-riti-chinha-padila-ma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନ ରୀତି ଚିହ୍ନା ପଡ଼ିଲା ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅପାର ରଜନୀ ହେଲା ରେ ସଜନୀ",
          "ପ୍ରାଚୀ ବଧୂକୁ ବିଧୁ ଚୁମ୍ବିଲା ମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ଯୋଗରେ ଆଜ ସାଜିଥିଲି ସଜ",
          "କାନନ ମଲ୍ଲୀ ଦଶା ଘଟିଲା ମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋଳିଦେ ଗୋ ତଳ୍ପ ପୂରିଲା ସଂକଳ୍ପ",
          "ନିକୁଞ୍ଜ ଭାଗ୍ୟ ଭୋଗ ଅଣ୍ଟିଲା ମା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପର ପୀରତିକି ପୁରୁଷ ଜାତିକି",
          "ପରତେ କଲା ଫଳ ମିଳିଲା ମା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ସେ ସମୟରେ ଭାଷେ",
          "ଲୁଚିଛନ୍ତିଟି ସବୁ ଶୁଭିଲା ମା"
        ]
      }
    ]
  },
  "sources": [
    {
