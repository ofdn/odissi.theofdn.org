{
  "id": "oa-gita-000716",
  "name": {
    "en": "Bandhu adose rasa na rose",
    "or": "ବନ୍ଧୁ ଅଦୋଷେ ରସ ନା ରୋଷେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000051"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bandhu-adose-rasa-na-rose-gujjari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବନ୍ଧୁ ଅଦୋଷେ ରସ ନା ରୋଷେ",
          "ଧରୁଛି ପଙ୍କଜ ପାଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜନମରୁ ବୀଣା ବଚନୀ ମୁଁ ଊଣା",
          "ଜନ କି ନ ଜାଣୁ ତାହା ରେ",
          "ସ୍ମର ଶର ଧାରେ ସରିଲିଟି ବାରେ",
          "ଧନ ତୁ ନ ବୋଲୁ ଆହା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରିଥିଲୁ ପରା ମୋତେ ଜବାଧରା",
          "ଜଣେ ତୋ ଚରଣ ଦାସୀ ରେ",
          "ଟିକିଏ ବିକଳା ହୋଇ ନାହୁଁ କଳା",
          "କୁନ୍ତଳା ନୂଆ ବୟସୀ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅରଜିଛି ତୋତେ ବନ୍ଧୁ କେତେ କେତେ",
          "ଜନ୍ମେ ତପ କରି କାଶୀରେ",
          "ତୁ ଚିତ୍ତ ପଥର କଲେ ତ ଏଥର",
          "ଭଗାରିଏ ଦେବେ ହସି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଖୀବନ୍ଧା ବେଣୀ ଫେଡ଼ି କୋଳେ ଆଣି",
          "ନ ଦେଲେ ମୁଁ ଖୋଷା ଖୋସି ରେ",
          "କୃପା ଥାଉଁ ଚିତ୍ତେ ତୁହି ପରା ମୋତେ",
          "ଗେଲେ ବସୁଥାଉ ରୁଷି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତେଡ଼େ ବଡ଼ ସ୍ନେହ କି ଦୋଷରୁ କହ",
          "ତୋ ମନୁ ଯାଉଛି ଖସି ରେ",
          "ଜଗଦ୍ଦେବ ବୋଲେ ଶ୍ୟାମ ଜଣାଇଲେ",
          "ପଡ଼ି ଦୁଃଖ ଜଳରାଶିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bandhu-adose-rasa-na-rose-gujjari-kabisurjya/"
    }
  ],
