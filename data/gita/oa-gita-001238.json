{
  "id": "oa-gita-001238",
  "name": {
    "en": "Tosita mati hoi chandrasekhara",
    "or": "ତୋଷିତମତି ହୋଇ ଚନ୍ଦ୍ରଶେଖର"
  },
  "composer": "oa-person-000150",
  "mula_raga": [
    "oa-raga-000031"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tosita-mati-hoi-chandrasekhara-baradi-sankara-bihara-prabandha-kabiratna-narayana-misra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶଙ୍କରବିହାରପ୍ରବନ୍ଧ, ବରାଡ଼ିରାଗେଣ",
          "ତୋଷିତମତି ହୋଇ ଚନ୍ଦ୍ରଶେଖର ଭଗତିରେ",
          "ପୀତବସନ କୃଷ୍ଣ ଆଜ୍ଞା ଘେନି ତୁରିତରେ । ପ୍ରଥମଖଣ୍ଡଃ ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପୁରୁଷୋତ୍ତମ ସମୀପ ଏକ ଆମ୍ର କାନନରେ",
          "ପ୍ରମଥ ସହିତ ଝଟିତି ଚିତ୍ତ ଦେଲେ ଗମନରେ । ଉଚ୍ଚଖଣ୍ଡୋ ଧ୍ରୁବଃ ।"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନନ୍ଦୀଶ୍ୱର ଆଦି ପ୍ରମଥଯୂଥ ସଙ୍ଗତରେ",
          "ବୃଷଭ ଆରୋହି ଚଳିଲେ ଈଶ ଗୌରୀ ମିଳିତରେ । ଆଭୋଗଃ ।"
        ]
      }
    ]
  },
