{
  "id": "oa-gita-000647",
  "name": {
    "en": "Jaya he jaya radha syamasundara",
    "or": "ଜୟ ହେ ଜୟ ରାଧା ଶ୍ୟାମସୁନ୍ଦର"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000142"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaya-he-jaya-radha-syamasundara-khanda-bangalasri-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୟ ହେ ଜୟ ରାଧା ଶ୍ୟାମସୁନ୍ଦର ମୂର୍ତ୍ତି ହେ",
          "ଶ୍ରୀ ବୃନ୍ଦା କାନନ ପ୍ରେମ ଦମ୍ପତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଷିତ ତପତ କାଞ୍ଚନ ବରନୀ",
          "ନବ ଜଳଧର ଶ୍ୟାମଳ କାନ୍ତି",
          "ବ୍ରଜବାସୀଙ୍କର ନୟନ ରଞ୍ଜନ",
          "ଭକ୍ତମାନଙ୍କର ହୃଦ ସମ୍ପତ୍ତି ।",
          "ଅଗତି ଗତି ରାଇ ଶ୍ରୀପତି",
          "ଗୋଲକ ଶୋଭା ମଣ୍ଡିଲ ଧରିତ୍ରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶିରେ ଶିଖିପୁଚ୍ଛ ସୁମଞ୍ଜୁଳ ବେଣୀ",
          "ଗଳେ ବନମାଳ ଶ୍ରୀ ବୈଜୟନ୍ତୀ",
          "ନୀଳ ପୀତ ପଟ ଦିଶେ ଝଟ ଝଟ",
          "ଅଧରେ ମୋହନ ମୁରଲୀ ଗୀତି ।",
          "ଯୁଗଳ ଛାତି ଦର୍ଶନେ ଯତି",
          "ଆନନ୍ଦ ସାଗରେ ନିମଜ୍ଜି ଯାନ୍ତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାଳିନ୍ଦୀର କୂଳେ କେଳି ନୀପ ମୂଳେ",
          "ବିଜୟେ ବେଷ୍ଟିତା ବ୍ରଜ ଯୁବତୀ",
          "ଯୁଗଳ ଚରଣ ଛନ୍ଦିବା ମାଧୁରୀ",
          "ଆହା କି ସୁନ୍ଦର ମଧୁର ଗତି ।",
          "ସଖୀଙ୍କ ପ୍ରତି ମଞ୍ଜୁ ଭାରତୀ",
          "ଭାଷିବାର ଆହା କୋମଳ ଅତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯେ ଯାହାର ସେବା ବିଧାନେ ଖଟିବା",
          "କି ଅପୂର୍ବ ଭାବ ହୃଦେ ଆଣନ୍ତି",
          "ମଞ୍ଜରୀ ନିକର ମଧ୍ୟେ ବେଣୁଧର",
          "ସେବିବ କି ସତେ କରି ବିନତି ।",
          "ଶ୍ରୀ ଗୁରୁ ଉକ୍ତି ମାନସେ ଚିନ୍ତି",
          "ଲଭିବ କି ଅନ୍ତେ ବ୍ରଜ ବିଭୂତି"
        ]
      }
    ]
  },
  "sources": [
