{
  "id": "oa-gita-000910",
  "name": {
    "en": "Kahin achanti mo prana sankhali",
    "or": "କାହିଁ ଅଛନ୍ତି ମୋ ପ୍ରାଣସଙ୍ଖାଳି"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000005"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahin-achanti-mo-prana-sankhali-kisorachandra-rajendradeba-anandabhairabi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁ ଅଛନ୍ତି ମୋ ପ୍ରାଣସଙ୍ଖାଳି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେବେ ଏ ନିକୁଞ୍ଜେ କରିଥାନ୍ତେଟି ବିଜେ",
          "ବଳି ଆସନ୍ତେନି ଦେହଳୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସୂଚୀଭେଦ ତମେ ଲୁଚି କି ଅବା ପ୍ରେମେ",
          "ରହିଛନ୍ତି ରସଖିଆଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନ ଲାଗେ ପରତେ ଥିଲା ପରି ଗୋ ସତେ",
          "ଦିଶେ କେଳି ନିକୁଞ୍ଜ ଖାଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶଙ୍କେ ତ ମୋ ଚିତ୍ତ ସଙ୍କେତକୁ କି ମିତ",
          "ଜାଣିଥିଲା ସେ ଚନ୍ଦ୍ରାବଳୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଛଦ୍ମ କରି ନିଜ ସଦ୍ମକୁ କି ଆଜ",
          "ପଦ୍ମା ପେଷି ନେଲା କଟାଳି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପୁଣି ସେ ଭାଷିଲେ ରାଜଇନ୍ଦ୍ର ବୋଲେ",
          "କରି ଶ୍ରୀ କୃଷ୍ଣେ ନିଉଛାଳି"
        ]
      }
    ]
  },
