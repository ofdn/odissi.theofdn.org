{
  "id": "oa-gita-001336",
  "name": {
    "en": "Aja e brundabane baja re bansi baja",
    "or": "ଆଜ ଏ ବୃନ୍ଦାବନେ ବାଜରେ ବଂଶୀ ବାଜ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000043"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-e-brundabane-baja-re-bansi-baja-basanta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ ଏ ବୃନ୍ଦାବନେ ବାଜରେ ବଂଶୀ ବାଜ",
          "ସପ୍ତ ସ୍ୱର ଉଚ୍ଚାରି ବାଜରେ ବଂଶୀ ବାଜ",
          "ସା ରେ ଗା ମା ପା ଧା ନି",
          "ସା ନି ଧା ପା ମା ଗା ରେ ସା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାଜ ସୁସ୍ୱରେ ବାଜ ଶ୍ରୀ ରାଧେ ରାଧେ ବାଜ",
          "କାମ ଗାୟତ୍ରୀ ଛନ୍ଦେ ବାଜରେ ବଂଶୀ ବାଜ",
          "ନୀଳ ଯମୁନା ପାଣି ବହିଯାଉ ଉଜାଣି",
          "ପାଷାଣ ତରଳାଇ ବାଜରେ ବଂଶୀ ବାଜ",
          "(ପଡ଼ି)",
          "ବ୍ରଜକାମିନୀ ଗଣ ଆସନ୍ତୁ ହୋଇ ଛନ୍ନ",
          "ସୁସ୍ୱରେ ଘନଘନ ବାଜରେ ବଂଶୀ ବାଜ",
          "ଯୋଗୀଙ୍କ ଧ୍ୟାନ ତୁଟୁ କୁସୁମ କଳି ଫୁଟୁ",
          "ମୃଦୁ ମନ୍ଦ ମଧୁରେ ବାଜରେ ବଂଶୀ ବାଜ"
        ]
      }
    ]
  },
