{
  "id": "oa-gita-000350",
  "name": {
    "en": "Bhala ta mukha chhabi nahi kahin re",
    "or": "ଭଲା ତା ମୁଖଛବି ନାହିଁ କାହିଁ ରେ"
  },
  "composer": "oa-person-000064",
  "mula_raga": [
    "oa-raga-000102"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-ta-mukha-chhabi-nahi-kahin-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଲା ତା ମୁଖଛବି ନାହିଁ କାହିଁ ରେ",
          "ଗଲା ରଜନୀ ପାହି ଚାହିଁ ଚାହିଁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାନ୍ତି କମଳରଜ ଲାବଣ୍ୟ ସରସିଜ",
          "ମତି ମୋହିଲା ମନ୍ଦବାତ ବହି ରେ",
          "ଜଙ୍ଗମ ହେମଲତା ପରେ ଚନ୍ଦ୍ରମୁକୁତା",
          "ଫୁଲ କି ଫୁଟି ଲୋଟୁଅଛି ମହୀରେ",
          "(ପଡ଼ି)",
          "ଭ୍ରୂଲତା ଭଙ୍ଗୀ ତାର ଇନ୍ଦ୍ରଧନୁ ଆକାର",
          "ଶର ବିନ୍ଧିଲା ମୋର ଊରକୁ ସେହି ରେ",
          "ଭଣେ ପୁରୁଷୋତ୍ତମ କବି ସେ ଘନଶ୍ୟାମ",
          "ଭଲା ଯତନେ ଗଢ଼ିଅଛି ବିହି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପାଠାନ୍ତର :",
          "ଭଣି ପୁରୁଷୋତ୍ତମ ବଦତି ଶୋଭା ଧାମ"
        ]
      }
    ]
  },
  "sources": [
