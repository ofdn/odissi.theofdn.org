{
  "id": "oa-gita-001203",
  "name": {
    "en": "Chitta chinta jagannatha kala mukhaku",
    "or": "ଚିତ୍ତ ଚିନ୍ତ ଜଗନ୍ନାଥ କଳା ମୁଖକୁ"
  },
  "composer": "oa-person-000148",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chitta-chinta-jagannatha-kala-mukhaku-brajanatha-badajena/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚିତ୍ତ ଚିନ୍ତ ଜଗନ୍ନାଥ କଳା ମୁଖକୁ",
          "ପାଇବୁ ପରମାନନ୍ଦ ସୁଖକୁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅରୁଣ ରଙ୍ଗ ଅଧର ଆହା କେଡ଼େ ମନୋହର",
          "ହସୁଥିଲା ପ୍ରାୟେ ଦିଶେ ପାଖକୁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରବଳ ବିପୁଳ ବାହା ଟେକିବା ଭଙ୍ଗୀକି ଚାହାଁ",
          "ଯାହା ତଳେ ରଖନ୍ତି ଅରକ୍ଷକୁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୁନିଶ୍ଚଳ ଚକା ଆଖି ଚାହିଁଲେ କରି ନିରେଖି",
          "ନ ଯିବୁ ଯମଦଣ୍ଡ ପାଖକୁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରୁଣାରେ ପରିପୂର୍ଣ୍ଣ ଢାଳେ ପଙ୍କଜ ନୟନ",
          "ତାରୁଛନ୍ତି ପାପୀ ଲକ୍ଷ ଲକ୍ଷକୁ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଟନ୍ତି କି ଭାବଗ୍ରାହୀ ଶ୍ରୀବତ୍ସ ପାଦକୁ ବହି",
          "ଅଛନ୍ତି ଅନାଉ କିନା ବକ୍ଷକୁ ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କର୍ଣ୍ଣେ ମକର କୁଣ୍ଡଳ ଝଲକେ ଗଣ୍ଡ ମଣ୍ଡଳ",
          "ନାହିଁ ତ ଉପମା ଦେବା ଲକ୍ଷ୍ୟକୁ ରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କପୋଳେ ରତନ ଚିତା ଦେଖି ଧରି ନୋହେ ଚେତା",
          "ତଥି ପରେ ହେମ ରାହୁରେଖକୁ ରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ବ୍ରଜନାଥ ବୋଲେ କାଳଦେବତା ନ ଧରୁଁ ବାଳ",
          "କରିଥା କରୁଣାସିନ୍ଧୁ ପକ୍ଷକୁ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chitta-chinta-jagannatha-kala-mukhaku-brajanatha-badajena/"
