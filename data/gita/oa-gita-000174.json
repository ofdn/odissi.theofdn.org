{
  "id": "oa-gita-000174",
  "name": {
    "en": "Jathartha kari syama kahuchi he",
    "or": "ଯଥାର୍ଥ କରି ଶ୍ୟାମ କହୁଛି ହେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000002"
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jathartha-re-syama-kahuchi-he/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯଥାର୍ଥ କରି ଶ୍ୟାମ କହୁଛି ହେ",
          "ଜେମାର ଅଙ୍ଗୀକାର ନୋହୁଛି ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାମକୁ ଯାମ ତାମରସ ନେତ୍ରାକୁ କାମ",
          "ବିନ୍ଧି ମରମେ ଶର ମୋହୁଛି ହେ",
          "ତେମନ୍ତେ ହେଲେ ଯାହା କରିଅଛି ସୁଦେହା",
          "ଚିତ୍ତେ ନିବିଡ଼େ ଶଙ୍କା ରହିଛି ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯତ୍ନ କଲେ ନ ରହି ନିରତେ ପ୍ରିୟସହି",
          "ନୟନୁ ଅଶ୍ରୁଧାରା ବହୁଛି ହେ",
          "ଯାବକ ଚିତ୍ର ଚାରୁ ଚରଣ ପଙ୍କଜରୁ",
          "ପଡ଼ିବା ପ୍ରବାହରେ ଧୋଉଛି ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯାବତ ସୁବିନୟ କହିଲେ ମୁଁ ସଦୟ",
          "ନ କରି ତୁନି ହୋଇ ରହିଛି ହେ",
          "ନବ ନଳିନୀ ଦଳେ ପହୁଡ଼ିଛି ବିକଳେ",
          "ନିଃଶ୍ୱାସ ମାତ୍ର ତାର ବହୁଛି ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାମିନୀଶ ବସନ୍ତ ମଧୁପ ପରଭୃତ",
          "ରୁତ ଜାତ ସନ୍ତାପ ସହୁଛି ହେ",
          "ନବପଲ୍ଲବ କରେ ଅବିରତେ ଶୋକରେ",
          "ଚାରୁ ଖଣ୍ଡମଣ୍ଡଳ ବହୁଛି ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯାତନା ଦେଇ କୁମ୍ଭଜିତସ୍ତନାକୁ ତୁମ୍ଭ",
          "ବିରହ ହୁତବହ ଦହୁଛି ହେ",
          "ଜଗଦ୍ଦେବ ଭାଷଇ ତାର ସହାୟ ହୋଇ",
          "ମଳୟ ଗନ୍ଧବହ ବହୁଛି ହେ"
        ]
      }
    ]
  },
  "sources": [
