{
  "id": "oa-gita-001350",
  "name": {
    "en": "Radhakanta radha mohana",
    "or": "ରାଧାକାନ୍ତ ରାଧାମୋହନ ହେ ଗୋବିନ୍ଦ"
  },
  "composer": "oa-person-000069",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhakanta-radha-mohana-he-gobinda/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ରାଧାକାନ୍ତ ରାଧାମୋହନ ହେ ଗୋବିନ୍ଦ",
          "ଲବେ ଦୟା ନାହିଁକି",
          "(ପଡ଼ି)",
          "କଞ୍ଜ ଖଞ୍ଜନ ଗଞ୍ଜନାକ୍ଷଣ",
          "ରଞ୍ଜନୀୟ ଗଜେନ୍ଦ୍ର ମୋକ୍ଷଣ",
          "ଯାମଳାର୍ଜ୍ଜୁନ ଭଞ୍ଜନାଚ୍ୟୁତ",
          "ଶ୍ୟାମଘନ ଅଭିରାମ କୃଷ୍ଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହେ ନନ୍ଦନନ୍ଦନ ବ୍ରହ୍ମାଦି ବନ୍ଦନ",
          "ଏ ନିରାଶ କାହିଁକି",
          "(ପଡ଼ି)",
          "ହାର କୌସ୍ତୁଭ ଗାର ଶୋଭିତ",
          "ନାରକାଦି ନିବାରଣ କୃତ",
          "ସାର ମୁରଲୀଧାରୀ ଦୁଷ୍କୃତ",
          "ଭାର ହର ଦନୁଜାରି ରାମ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଜନ୍ମ କାଳରୁ ତୁମ୍ଭ ସେବା ବିନୁ",
          "ଆନେ ମୋର ଚାହିଁକି",
          "(ପଡ଼ି)",
          "ରାସଉତ୍ସବକାରୀ ଶୋଭିତ",
          "ହାସ ଶୋଭନ ଦାସ ବାଞ୍ଛିତ",
          "ଦାସକୁ ନ ବିନାଶ କିଞ୍ଚିତ",
          "ଆଶ ହୁଅ ବ୍ରଜବାସ ଶ୍ୟାମ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲକ୍ଷ୍ମୀନାରାୟଣ ଦେବ ମହାରାଣ",
          "ରାଜନକୁ ନ ଚାହିଁକି",
          "(ପଡ଼ି)",
          "ଶ୍ୟାମସୁନ୍ଦର ଛାମୁରେ ରହି",
          "ନାମ କୀର୍ତ୍ତନ କାମନା ଏହି",
          "ତାମରସ ପଦେ ଧ୍ୟାନ ରହୁ ମତି",
          "ବାମ ନୁହଁ କୋଟି କାମ ମୂର୍ତ୍ତି"
        ]
      }
    ]
  },
  "sources": [
    {
