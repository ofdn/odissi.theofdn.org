{
  "id": "oa-gita-000664",
  "name": {
    "en": "Tribhangi aja mote ki bhangi",
    "or": "ତ୍ରିଭଙ୍ଗୀ ଆଜ ମୋତେ କି ଭଙ୍ଗୀ"
  },
  "composer": "oa-person-000118",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tribhangi-aja-mote-ki-bhangi-surjya-jema/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତ୍ରିଭଙ୍ଗୀ ଆଜ ମୋତେ କି ଭଙ୍ଗୀ କଲାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେତେବେଳେ ଦକଦକ ହେଉଥିଲା ହୃଦର",
          "କି ଯୋଗରେ ପଡ଼ିଗଲି ସରୁଥିଲା ବେଭାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେତେବେଳେ ସ୍ଥିର କରି ଚାହିଁଦେଲି ଭୁଜକୁ",
          "କୁହୁକ ଲଗାଇ ଧନ ଧରିଥିଲା କୋଳକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନବୀନ କିଶୋରୀ ବେଳେ ଦେଖି ତାର ଛବିକି",
          "ପାଦ ନ ଚଳଇ କେହି ଯିବି ନିଜ ପୁରୀକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରସିକ ଆଗରେ ମୁହିଁ କି ଯୋଗରେ ପଡ଼ିଲି",
          "ବୋଲେ ସୂର୍ଯ୍ୟମଣି ଜେମା ଏହି ଘରେ ସଢ଼ିଲି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tribhangi-aja-mote-ki-bhangi-surjya-jema/"
    }
  ],
