{
  "id": "oa-gita-001136",
  "name": {
    "en": "Ke mun ki janai ma gostha chandrama",
    "or": "କେ ମୁଁ କି ଜାଣଇ ମା ଗୋଷ୍ଠ ଚନ୍ଦ୍ରମା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ke-mun-ki-janai-ma-gostha-chandrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେ ମୁଁ କି ଜାଣଇ ମା ଗୋଷ୍ଠ ଚନ୍ଦ୍ରମା",
          "ତୋ ମୁଖରୁ ସିନା ଏବେ ଶୁଣୁଛି ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜିଣି ନାହିଁ ଦେହଳୀ ସହୀ ଆଜକୁ ବୋଲି",
          "କୁଟିଳା କଟାଳକୁ ଡରି",
          "ଛବିକି ଦେଇଛି ଥରେ ଅନାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଲା କେ କି ମନ୍ତର ପରା ହୃଦେ ମୋହର",
          "ରହି ଦିଶୁଛି ଦିଶେ ଦିଶେ",
          "ପଳାଇଲେ ଆଗର ପଥ ଓଗାଳିଲେ ମୋର",
          "ଶ୍ୟାମସୁନ୍ଦର ଭୁଜ ପ୍ରସାରି ଦେଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଳିନ୍ଦ ତନୟାକୁ କାଲି ଗାଧୋଇବାକୁ",
          "ଗଲା ବେଳେ ଏକା ହୋଇ",
          "ପ୍ରତିଛନ୍ଦ ମୂରତି ପରି ହେଲା ପ୍ରତୀତି",
          "ଦିଶୁଥିଲା ତ୍ରିଭଙ୍ଗ ଭଙ୍ଗିମା ହୋଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେଉଁଠାରେ ସଦନ ସେ କାହାର ନନ୍ଦନ",
          "ଚାହୁଁଥିଲା ବେଣୁ ବଜାଇ",
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷେ ପ୍ରାଣନାଥ ହେବେ ସେ",
          "ଲୋଡ଼ା ଲାଗିଲାନି ଦୂତୀ ତୁମ୍ଭ ପାଇଁ"
        ]
      }
    ]
  },
  "sources": [
    {
