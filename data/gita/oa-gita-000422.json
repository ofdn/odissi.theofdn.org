{
  "id": "oa-gita-000422",
  "name": {
    "en": "Chhanda charana mote tariba ki",
    "or": "ଛନ୍ଦା ଚରଣ ମୋତେ ତାରିବ କି"
  },
  "composer": "oa-person-000132",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhanda-charana-mote-tariba-ki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛନ୍ଦା ଚରଣ ମୋତେ ତାରିବ କି",
          "କନ୍ଦାଇ କନ୍ଦାଇ ମାରିବ କି",
          "ଫନ୍ଦା କଲି ବୋଲି ପଦାରବିନ୍ଦକୁ",
          "ଧନ୍ଦାରେ ପକାଇ ସାରିବ କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବନ୍ଧା ଦେଇଛି ଏ ଜୀବନକୁ",
          "ବୃନ୍ଦାବନ ମଦନମୋହନଙ୍କୁ",
          "ନିନ୍ଦା ତେଜି ପ୍ରେମ ମନ୍ଦାକିନୀ ଧାରା",
          "ନୟନୁ ଝରି ତନୁ ଘାରିବ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କନ୍ଦାଇଲ ମୋହ ମାୟା ପାଶେ",
          "ନନ୍ଦାତ୍ମଜ ପ୍ରଭୁ ନିଜ ଦାସେ",
          "ବନ୍ଦାଇବା ଲାଗି ବନ୍ଦାଣ ତଣ୍ଡୁଳ",
          "(ଦାସୀ) ଥାଳି ଧରି ରହି ପାରିବ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନ୍ଦାର ଅଧରା ବ୍ରଜବାଳୀ",
          "ପିନ୍ଧାବାସ ଚୋରା ବନମାଳୀ",
          "ଚନ୍ଦ୍ରାବଳୀ ନାଥ ବୋଲି ଗରବରେ",
          "ରାଧା ଦାସୀକି ନ ଠାରିବ କି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅନ୍ଦାଜେ ନ ଜାଣେ ଅନ୍ଧ ମୁହିଁ",
          "ଛନ୍ଦା ଚରଣ ପାଇବି କାହିଁ",
          "ବୃନ୍ଦାବନେଶ୍ୱରୀ ସେବକୀ ମୋହନା",
          "ଯମୁନାରେ ଜୀବ ହାରିବ କି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhanda-charana-mote-tariba-ki/"
    }
  ],
