{
  "id": "oa-gita-000586",
  "name": {
    "en": "Daya kara he nabadwipa",
    "or": "ଦୟା କର ହେ ନବଦ୍ୱୀପ"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/daya-kara-he-haribandhu-punnaga/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦୟା କର ହେ ନବଦ୍ୱୀପ ଚନ୍ଦ୍ରମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହୃଦୟ କନ୍ଦରେ ସ୍ଫୁରୁ ଆନନ୍ଦରେ",
          "ତୁମ୍ଭ କୀର୍ତ୍ତି ହେ କନକ ଧାମା",
          "ଶ୍ରୀ ଶଚୀ ନନ୍ଦନ ସ୍ୱଭକ୍ତ ଜୀବନ",
          "ଜୟ ଶ୍ରୀ କୃଷ୍ଣ ଚୈତନ୍ୟ ନାମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆନନ୍ଦ ଚିନ୍ମୟ ପରଂ ପ୍ରେମମୟ",
          "ସଦା ଯା ରୂପେ ଲୋଭିତ ରାମା",
          "ବ୍ରହ୍ମା ଈଶ ଶେଷ ସନକାଦି ବ୍ୟାସ",
          "ଲଭି ନାହାନ୍ତି ଯାହା ମହିମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିତ୍ୟାନନ୍ଦାଦ୍ୱୈତ ପ୍ରଭୁ ଆଦି ଭକ୍ତ",
          "ସ୍ମରୁ ଅଛନ୍ତି ଯାହା ସୁଷମା",
          "ଶ୍ରୀ ଗୌରଚନ୍ଦ୍ର ଗଜପତିଙ୍କ ମତି",
          "ରହୁ ପଦାବ୍ଜେ ଦିନ ତ୍ରିଯାମା"
        ]
      }
    ]
  },
