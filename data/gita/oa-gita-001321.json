  "name": {
    "en": "Braja raja nandana radha binodana",
    "or": "ବ୍ରଜରାଜ ନନ୍ଦନ ରାଧା ବିନୋଦନ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/braja-raja-nandana-radha-binodana-tarini-charan-patra-anandabhairabi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଜ ବ୍ରଜରାଜ ନନ୍ଦନ ରାଧା ବିନୋଦନ",
          "ମଦନମୋହନ ବନମାଳୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁନିମନ ରଞ୍ଜନ ଭବଭୟ ଭଞ୍ଜନ",
          "ମୁରଲୀ ଗୁଞ୍ଜନ ମୁରଅରି",
          "ଗିରିବର ଧାରଣ କରୀବର ତାରଣ",
          "ଗୋପିନୀ ଜୀବନ ଦୁଃଖହାରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚଞ୍ଚଳ କୁଣ୍ଡଳ ଝଲମଲ ମଞ୍ଜୁଳ",
          "ନଟବର ବେଶ ମନୋହାରୀ",
          "ନୀଳାଞ୍ଜନ ତନୁ ଗୋଷ୍ଠାଚଳେ ଧେନୁ",
          "ଚାରଣ ତାରିଣୀ ମୋକ୍ଷକାରୀ"
        ]
      }
    ]
  },
  "sources": [
    {
