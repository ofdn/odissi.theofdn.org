{
  "id": "oa-gita-000495",
  "name": {
    "en": "Trahi trahi madanamohana",
    "or": "ତ୍ରାହି ତ୍ରାହି ମଦନମୋହନ"
  },
  "composer": "oa-person-000038",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/trahi-trahi-madanamohana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତ୍ରାହି ତ୍ରାହି ମଦନମୋହନ",
          "ତ୍ରାହି ଶ୍ରୀ ସଚ୍ଚିଦାନନ୍ଦ",
          "ତ୍ରାହି ନବଦ୍ୱୀପ ଜିଣିତ ସୁଧାକର",
          "ତ୍ରାହି ତ୍ରିଭୁବନ ବନ୍ଦନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗରୁଡ଼ଗମନ ସୁଧର୍ମାପାଳନ",
          "ଭକ୍ତଜନରଙ୍କର ପାଳନ",
          "ମାନଗୋବିନ୍ଦ ଗର୍ବଗଞ୍ଜନ",
          "କାଳୀ ଶିରେ କଲ ନର୍ତ୍ତନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜନମ କାଳରେ ଇନ୍ତୁଡ଼ିଶାଳରେ",
          "ପୂତନେ ଦେଲା କ୍ଷୀର ପାନେଣ",
          "କାଳରୂପେ ହରି ମାୟା ତାକୁ କରି",
          "କ୍ଷୀର ସଙ୍ଗତେ ପ୍ରାଣ ଶୋଷିଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅର୍ଘା ବକା ଷଣ୍ଢା ଶକଟା ନାଶିଲ",
          "ତୃଣାସୁରକୁ କଲ ବନ୍ଧନ",
          "କଂସ କେଶୀ ମାରି ମାୟା ତାକୁ କରି",
          "ମାଈଁଙ୍କ କୋଳେ କଲ ରୋଦନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀଗୁରୁ ବୈଷ୍ଣବ ଯା ପାଦ ପଙ୍କଜ",
          "ଭଜିଣ ଯିବା ବୃନ୍ଦାବନେଣ",
          "ତ୍ରାହି ମାନସ ସାର ସାରସ",
          "ପଦ୍ମନାଭ କରେ ବନ୍ଦନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
