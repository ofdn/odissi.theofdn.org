{
  "id": "oa-gita-000592",
  "name": {
    "en": "Edi deichi je adi brusabhanu jema",
    "or": "ଏଡ଼ି ଦେଇଛି ଯେ ଅଡ଼ି ବୃଷଭାନୁ ଜେମା"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/edi-deichi-je-adi-brusabhanu-jema/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏଡ଼ି ଦେଇଛି ଯେ ଅଡ଼ି ବୃଷଭାନୁ ଜେମା",
          "ବଢ଼ି କହିଲେ ଲପନକୁ ନ ଟେକି",
          "ବୋଲେ ସେ କଥା ଛାଡ଼ ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେଉଁ ନାଗରୀର ସଙ୍ଗ ସୁଖ ପାଇ",
          "ମାତି ରହିଲେ ତ୍ରିଯାମା",
          "ବୋଲି ନ ଦେଖି ନ ଶୁଣି ପ୍ରାଣସହି",
          "ଲୋଡ଼ି ଦୁଃଖ ସୁଖସୀମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଭିସାର କାଳେ ସେ ଶ୍ୟାମ ଅଙ୍ଗରେ",
          "ସ୍ୱବିମ୍ବ ଦେଖି ଏ ରାମା",
          "ତେଣେ ରୋଷ ବହି ଭାରି ଆସି ଏଣେ",
          "ଶୁଖାଇ ମୁଖ ସୁଷମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯାହାକୁ ତ୍ରୁଟିଏ ନ ଦେଖି କୋଟିଏ",
          "ଯୁଗ ମଣଇଁ ଏ ଶ୍ୟାମା",
          "ତାହାର ଗୁହାରି ନ ଶୁଣି ତିଆରି",
          "କହିଲେ ରଖି ଗାରିମା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୃନ୍ଦାବନ ଅଧିକାରୀ କହେ ହେ ଶ୍ରୀ",
          "ବୃନ୍ଦାବନେଶ୍ୱରୀ ବାମା",
          "ବେଶ ହୋଇ ବିଜେ କର ସେ ମୋହନ",
          "ଦୋଷ ଥିଲେ କର କ୍ଷମା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
