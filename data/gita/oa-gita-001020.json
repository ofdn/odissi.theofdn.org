{
  "id": "oa-gita-001020",
  "name": {
    "en": "Jiba sangini mote tu budailu re",
    "or": "ଜୀବ ସଙ୍ଗିନୀ ମତେ ତୁ ବୁଡ଼ାଇଲୁ ରେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000177"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jiba-sangini-mote-tu-budailu-re-sindhuda-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୀବ ସଙ୍ଗିନୀ ମତେ ତୁ ବୁଡ଼ାଇଲୁ ରେ",
          "କୁଳଶୀଳ ଧରମ ଛଡ଼ାଇଲୁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ମୋହନର ପ୍ରସଙ୍ଗ ଶୁଣାଇ ମୋହର ଅଙ୍ଗ",
          "ଦିନୁ ଦିନୁ ଚିନ୍ତାରେ ସଡ଼ାଇଲୁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତା ନଟ କୂଟରେ ପଡ଼ି ଅନୁବରତରେ ଅଡ଼ି",
          "ତା ଠାରେ ମୋ ସରାଗ ବଢ଼ାଇଲୁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜାଣୁ ଅବା କି ମନ୍ତର ମତେ ତୁ କରି ଯନ୍ତର",
          "ସେ ପ୍ରୀତିରେ ମୋ ମତି ଜଡ଼ାଇଲୁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦ୍ୱିଜ ରଘୁନାଥ କହି ତାର କଥା କହି କହି",
          "ନିରନ୍ତରେ ପଛରେ ଗୋଡ଼ାଇଲୁ ରେ"
        ]
      }
    ]
  },
