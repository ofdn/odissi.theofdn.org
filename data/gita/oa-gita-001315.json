{
  "id": "oa-gita-001315",
  "name": {
    "en": "Ramani ratana meghaku chahin",
    "or": "ରମଣୀ ରତନ ମେଘକୁ ଚାହିଁ"
  },
  "composer": "oa-person-000023",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ramani-ratana-meghaku-chahin/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ରମଣୀ ରତନ ମେଘକୁ ଚାହିଁ",
          "କହିବୁରେ ମେଘ କାନ୍ତକୁ ଯାଇ",
          "ଏତେ ଦିନ କିମ୍ପା ବିଳମ୍ବ କଲେ",
          "କାଲି ପରିକି କଣ୍ଟ କରିଥିଲେ",
          "କରି ମୋତେ ପର",
          "କି ବିଚାରୁ ଥିବେ ଦିନୁଁ ଅନ୍ତର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଲାଣି ଘୋର ଦୁର୍ଦ୍ଦିନ ଚମକ",
          "ନାଦ କଲେଣି କୋକିଲା ଡାହୁକ",
          "କହିଥିଲେ ବନ୍ଧୁ ନିୟମ କରି",
          "କେବେହେଁ ନ ଯିବି ପ୍ରବାସ କରି",
          "କି ବିଚାରି ମନ",
          "କେଉଁ ନାରୀ ସଙ୍ଗେ ବଞ୍ଚିଲେ ଦିନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାମେ ବଶ କଲା କେଉଁ ଚତୁରୀ",
          "କେ ରମଣୀ ରଖିଲା ମନ ହରି",
          "କେହୁ ଦଧି ଫଳ ଭୁଞ୍ଜାନ୍ତେ ବସି",
          "ପିଣ୍ଡରୁ ପରାଣ ଯାଉଛି ଖସି",
          "କେଉଁ ଉପାୟରେ",
          "କାନ୍ତକୁ ଭେଟିବି ନେତ୍ର ପଥରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସତେ କି କରିବେ ହର ଗଉରୀ",
          "ପ୍ରବାସୁ ମୋ କାନ୍ତ ଆସିବେ ଫେରି",
          "କରିବେ ଅଙ୍କ ପଲଙ୍କେ ଶୟନ",
          "ସତେ କି ମୋ ଦୁଃଖ ହେବ ମୋଚନ",
          "କରି ରସକେଳି",
          "ଭଣେ ଉପଇନ୍ଦ୍ର ଏ ରସେ ଭାଳି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ramani-ratana-meghaku-chahin/"
    }
  ],
