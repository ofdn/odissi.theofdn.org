{
  "id": "oa-gita-001134",
  "name": {
    "en": "Mo jibara jibana mitani re",
    "or": "ମୋ ଜୀବର ଜୀବନ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mo-jibara-jibana-mitani-re-gopalakrusna-mohana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋ ଜୀବର ଜୀବନ",
          "କାହିଁକି ଆଜ ସଜ ସରସିଜ",
          "ମୁଖ କରିଛନ୍ତି ମ୍ଳାନ ମିତଣୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲେଉଟାଇ ଗୋଧନ",
          "ଆସୁ ସଦନକୁ ସବୁ ଦିନ ପରି",
          "ଶୁଭୁ ନାହିଁ ବଂଶୀ ସ୍ୱନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆରାଧି ବିକର୍ତ୍ତନ",
          "ଆସିଲା ବେଳେ ହସି ହସି ଯାଚି",
          "ଦେଇ ଅଇଲି ଚୁମ୍ବନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପର୍ଣ୍ଣ ସହ ପ୍ରସୂନ",
          "କର୍ଣ୍ଣରେ ମୋର କରି ଅବତଂସ",
          "ଚଳିଗଲେନି ବହନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋ ଆନଟି ମୁଁ ମାନ",
          "କରି ନାହିଁ ଚନ୍ଦ୍ରାବଳୀ ମନେ ରହି",
          "ଥିବ ପରାଟି ଗୁମାନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତେଜି ବ୍ରଜ ସଦନ",
          "ଗେହପତି ମଥୁରାକୁ ଯିବା କଥା",
          "କଲେ କି ଅନୁସନ୍ଧାନ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କଥନ",
          "ପୌର୍ଣ୍ଣମାସୀ ଆସି ତା ଯାକ ନିଷେଧି",
          "କଲେନି ତ ସମାଧାନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
