{
  "id": "oa-gita-001297",
  "name": {
    "en": "Bhala sobha nandighosa",
    "or": "ଭଲା ଶୋଭା ନନ୍ଦିଘୋଷ"
  },
  "composer": "oa-person-000154",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-sobha-nandighosa-hadi-dasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଲା ଶୋଭା ନନ୍ଦିଘୋଷ",
          "ଦୂରକୁ ଦିଶଇ କେଡ଼େ ସୁବେଶ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀ ନୀଳକନ୍ଦରେ ବିଜେ କରିଛନ୍ତି",
          "ଅଖିଳର ମଣି ଜଗୁନିବାସ",
          "ଗରୁଡ଼ ପଛରେ ବ୍ରହ୍ମା ସ୍ତୁତି କରେ",
          "ଛତିଶ ନିଯୋଗୀ କରନ୍ତି ବେଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୋଳେ ପ୍ରେମେ ଲକ୍ଷ୍ମୀ ଜାନୁ ପରେ ବସି",
          "ଶ୍ରୀମୁଖ ଚାହିଁ ମୃଦୁମୃଦୁ ହାସ୍ୟ",
          "ବରୁଣ ଛତ୍ର ପାଦପଦ୍ମେ ଯୋଗାନ୍ତେ",
          "ନିଧି ବରଷଇ ରସ ରସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତ୍ରିଅଦେବ ଘେନି ବଡ଼ଦାଣ୍ଡେ ଯାଇ",
          "ଦେବଙ୍କ ସଙ୍ଗରେ ଯାତ୍ରା ରହସ୍ୟ",
          "ତିନିପୁର ଲୋକ ଦଉଡ଼ି ଧରନ୍ତେ",
          "ସ୍ୱର୍ଗକୁ ଶୁଭଇ ଚକ ଘୋଷ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଛତିଆ ଗ୍ରାମରେ ରହି ହୀନ ହାଡ଼ି",
          "ସେହି ଦାଣ୍ଡକୁ କରିଛି ଆଶ",
          "ସୁଜ୍ଞଜନ ପାଦେ ମୋର ଆଶା ଥାଉ",
          "ଚାହିଁଲେ ଜନ୍ମର କଳୁଷ ନାଶ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-sobha-nandighosa-hadi-dasa/"
    }
  ],
