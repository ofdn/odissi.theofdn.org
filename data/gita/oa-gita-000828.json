{
  "id": "oa-gita-000828",
  "name": {
    "en": "Sajani naile ta baraja raja",
    "or": "ସଜନୀ ନଇଲେ ତ ବରଜରାଜ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000040"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-naile-ta-baraja-raja-ramakeri-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ନଇଲେ ତ ବରଜରାଜ",
          "ବିଫଳ ଏ ଯଉବନ କି ଫଳ ସରାଗ ସଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେତେ ଅନୁରାଗେ ସତେ ବଚନ ଗଲି ପରତେ",
          "ବରଜି ବରଜେ କୁଳ ଲାଜ",
          "ନ ମାନି ନିଝୁମ ନିଶା ଲଭିଲି ଅନା କି ଦଶା",
          "ଶିରେ ଯାହା ନ ପଡ଼ିଲା ବାଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ ହେଲା ନ ଥିଲେ ନାହିଁ କାହିଁକି ରେ ଆଶା ଦେଇ",
          "ନିପଟ କପଟ କଲେ ଆଜ",
          "ତୋଳି କାନନ ନିଆଳୀ ଯତନେ ସଜାଡ଼ିଥିଲି",
          "ବାସି ହେଲା ଆସି ଫୁଲ ଶେଯ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଉ ସତେ ନିଧୁବନେ ନ ଆସିବି କେବେ ଦିନେ",
          "କଳିବି ସଜନୀ କଳା ଓଜ",
          "ଅନା ଛପି ଛପି ଆସେ ଜହ୍ନ ତ ନୀଳ ଆକାଶେ",
          "ଆଉ କି ଆଶା ଲୋ କୁଞ୍ଜ ତେଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଚନ୍ଦ୍ର ଯୋଡ଼ି କର କହେ ଧନୀ ଘେନା କର",
          "ଆଜରୁ ଗରବ ମନୁ ତେଜ",
          "ବନ୍ଧା ତୋର ଶ୍ୟାମ ଭାଳି ନ ଯାଅ ଗୋ ମନୁ ଭୁଲି",
          "ଭାବ ବିନୋଦିଆ ରସରାଜ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
