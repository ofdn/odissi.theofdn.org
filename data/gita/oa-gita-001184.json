{
  "id": "oa-gita-001184",
  "name": {
    "en": "Rasa nidhi re basa mohara sannidhi",
    "or": "ରସ ନିଧିରେ ବସ"
  },
  "composer": "oa-person-000043",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasa-nidhi-re-basa-mohara-sannidhi-dinabandhuraja-harichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରସ ନିଧିରେ ବସ ମୋହର ସନ୍ନିଧିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁମଧୁରା ଧରା",
          "ଧରୁ କର ହସିତ କୁସୁମ ମଧୁରାଧରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁଖ କଳାକର",
          "ଟେକି ପଞ୍ଚଶୀଳ ମୁଖ ମୁଖ କଳାକର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନବ ସୁରସାରେ",
          "ତୁ ପରା ମୋ ଅଙ୍ଗ ବିନା ନ ବସୁ ରସାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରମ୍ଭା ଉରୁବସି",
          "ଥିଲେ କୋଳେ ମୁଁ ନ ଗଣେ ରମ୍ଭା ଉରୁବଶୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତୋର ପରିକର",
          "ମାଗୁଅଛି ମୋତେ ରତେ ତୋର ପରିକର"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦିଅ ଧନ କର",
          "ଅବଲମ୍ବ ମୋର ସୁଆଦିଆ ଧନ କର"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ହାସ ଆନନରେ",
          "କର ନ କରାଅ ପରି ଆସ ଆନନରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ତତ୍ କାଳଯାକ",
          "ରୁଷିବାର ନୋହେ ଉଚିତ ଉତ୍‌କାଳଯାକ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଅତନୁ ପୁରକୁ",
          "ପୁଲକାଇ ଥରେ ଯାଅ ଅତନୁ ପୁରକୁ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଅନ୍ତର ସମୟ",
          "କରନା ପୂରାଅ ମତେ ଅନ୍ତର ସମୟ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ବସୁଅନିଦାନ",
          "ପରି ମତେ ଜଣାଅ ନବ ସୁଖ ନିଦାନରେ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ଦୀପ ରାଜ ଗତେ",
          "ତୋ ସ୍ନେହ ମୁଁ ଏକ ନାହିଁ ଦୀପରାଜଗତେ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ହରିଚନ୍ଦନଙ୍କୁ",
          "ଘେନ ଯଥା ବସନ୍ତେ ବିହରି ଚନ୍ଦନଙ୍କୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasa-nidhi-re-basa-mohara-sannidhi-dinabandhuraja-harichandana/"
    }
  ],
