{
  "id": "oa-gita-001153",
  "name": {
    "en": "Syama ghana suna he",
    "or": "ଶ୍ୟାମଘନ ଶୁଣ ହେ"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-ghana-suna-he-mohanaa-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମଘନ ଶୁଣ ହେ ବିକାଶିଲ କି ଗୁଣ",
          "ବ୍ରଜ ଯୁବରାଜ ହୋଇଣ ଆପଣ",
          "କରିଅଛ ଆଚ୍ଛା ଉତ୍ତମପଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆମ୍ଭେ ସକଳ କୁଳବତୀ ନାରୀ",
          "ନିତି ପୂଜା କରୁ ହର ଗଉରୀ",
          "ଆମ୍ଭ କଉତୁକ ଆମ୍ଭେ କରୁଥିଲୁଁ",
          "ତୁମ୍ଭଙ୍କୁ କେ କରୁଥିଲା ବରଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଥାଉ ଭଲପଣ ବସନ ଦିଅ",
          "ତୁନି ହୋଇ ଗୋପ ପୁରକୁ ଯାଅ",
          "ରଖିଥାଅ ମନେ ଆଉ କେଉଁ ଦିନେ",
          "ନ କରିବ ଏଡ଼େ ଅନୀତିପଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାହାକୁ ଏମାନ କହିବା ଆଉ",
          "ସ୍ନାନ ଘାଟରେ ଡକାଇତ ଦାଉ",
          "ସରିଲା ଏ ଗୋପ ମହତ୍ତ୍ୱ ମର୍ଯ୍ୟାଦା",
          "ଏଣିକି ଏମାନ ହେଲା ଭିଆଣ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବ୍ରଜରାଜ ସୁତ ହୋଇଛ ତେଣୁ",
          "ଅତି ଅନୀତି କରୁଅଛ ତେଣୁ",
          "ଏ ଗୁମାନ ରହିବ ନାହିଁଟି ମାନଟି",
          "କି କଂସ ରାଜନ ରାଣ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦେବ କି ନ ଦେବ ବହନ କହ",
          "ଶୀତେ ଆମ୍ଭର କମ୍ପୁଅଛି ଦେହ",
          "ଯାହା ହେବ ତାହା ପଛନ୍ତେ ଜାଣିବ",
          "କହଇ ଦ୍ୱିଜ ଗଉରଚରଣ"
        ]
      }
    ]
  },
