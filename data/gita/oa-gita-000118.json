{
  "id": "oa-gita-000118",
  "name": {
    "en": "Chatara to gala keniki go",
    "or": "ଚାତର ତୋ ଗଲା କେଣିକି ଗୋ"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000054"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chatara-to-gala-keniki-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାତର ତୋ ଗଲା କେଣିକି ଗୋ",
          "କାତର ତ ହେଉ ଏଣିକି ଗୋ",
          "ପାତର ନୋହିଲି ନଜରକୁ ବୋଲି",
          "ଖାତର ନ କଲୁ ବାଣୀକି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହଜାର ବାର ମନା କରୁ କରୁ",
          "ହଜାଇଣ ଦେହ ବୁଦ୍ଧି ରମ୍ଭୋରୁ",
          "ମଜ୍ଜାଇଲୁ ମନ ବିଟମୁକୁଟରେ",
          "କି କହିବି ଗୁଣମଣିକି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାତି କୁଳଶୀଳ ଲାଜ ମହତ",
          "ମାତି ଶ୍ୟାମ ସଙ୍ଗେ କଲୁ ଯେ ହତ",
          "କାତି ଚଢ଼ାଇଲୁ ଆପଣା ଛାତିକି",
          "ମଣ୍ଡୁ କିମ୍ପା ଗଣ୍ଡେ ପାଣିକି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାଟ ଚାଲି ନୁହେଁ ତୁଣ୍ଡ ବଜାରେ",
          "ହାଟ ବସିଲାଣି ବ୍ରଜବଜାରେ",
          "ପାଟକ କୁଳେ କଳଙ୍କ ଲଗାଇଲୁ",
          "କୋଳେ ଧରି କାଳଫଣୀକି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷେ ଶ୍ରୀ ଭ୍ରମରବର ଏ ରସେ",
          "ଭାଷେ ଯା ହୃଦରେ ଚେତନା ବସେ",
          "ଭାସେ ସେ ଅବଶ୍ୟ ଖେଦସରିତେ",
          "ହସି ମହାଦୁଃଖ ଶ୍ରେଣୀକି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
