{
  "id": "oa-gita-001211",
  "name": {
    "en": "Mahabhaba rupa bhaba re manasa",
    "or": "ମହାଭାବ ରୂପ ଭାବରେ ମାନସ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mahabhaba-rupa-bhaba-re-manasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମହାଭାବ ରୂପ ଭାବରେ ମାନସ",
          "ଯାହା ସଙ୍ଗେ ଶୁଚି ରସ ରହିଛନ୍ତି",
          "ସଦା ବହି ଅବୟବରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସନକ ସନନ୍ଦନ ସନତ୍କୁମାର",
          "ସନ ବସି ରହସ୍ୟରେ",
          "ବ୍ରହ୍ମାନନ୍ଦ ସୁଖ ବରଜି ମଜ୍ଜିଲେ",
          "ଯା ଲୀଳା ରସ କଥାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯା ସୁଷମା ଗଣ ଗୁଣି ଗୁଣି ଗୀତ",
          "କରି ଗାଉ ନାରଦ ବୀଣାରେ",
          "କଳେବର ପୁଷ୍ଟ ହୋଇ ଉପବୀତ",
          "ଛିନ୍ନ ହେଉଅଛି ଶ୍ରଦ୍ଧାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବ୍ରଜ ଜନଙ୍କର କୋଟିଏ ଜନ୍ମର",
          "ପୁଣ୍ୟ ବିଟପିର ଫଳ",
          "ନିକୁଞ୍ଜ ଶେଯରେ ବିଜେ କରିବାର",
          "ବେଢ଼ାରେ ଆଳୀ ମଣ୍ଡଳ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସ୍ୱାମିନୀ ଶରଣ ହେଲି ମୁଁ ବୋଲି ଯେ",
          "ବୋଲୁଛି ଥରେ ଜୁହାରି",
          "ବ୍ରଜେନ୍ଦ୍ର ଲାକ୍ଷା ଲେଖିବା ପଦେ ସଦା",
          "ହୋଇ ରହୁଛି କିଙ୍କରୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋଷ୍ଠେନ୍ଦ୍ର ନନ୍ଦନ ସେବା ସୌଭାଗ୍ୟ",
          "ତୋ ଲଭିବାକୁ ଯଦି ଆଶା",
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ଶ୍ରୀ ରାଧିକା",
          "ପଦେ ରହି ଅହନିଶା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
