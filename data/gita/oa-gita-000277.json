{
  "id": "oa-gita-000277",
  "name": {
    "en": "Syama bansi to namaku",
    "or": "ଶ୍ୟାମ ବଂଶୀ ତୋ ନାମକୁ"
  },
  "composer": "oa-person-000029",
  "mula_raga": [
    "oa-raga-000072"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-bansi-to-namaku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ବଂଶୀ ତୋ ନାମକୁ",
          "ଧରି କରେ ମହତସରା ରେ ସଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କରି ସୁସ୍ୱର ସ୍ୱନକୁ । ଦହି ନିଅଇ ମନକୁ ।",
          "ଡାକି ନିଅଇ ପାଶକୁ ହୋଇ କେଡ଼େ ତ୍ୱରା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାରଦ ବିପଞ୍ଚୀଠାରୁ । ନାଦ ଶୁଭେ ଅତି ଗୁରୁ ।",
          "କୃଷ୍ଣ ବଶ ନ ହେବାରୁ ବାଇ ହେଲୁ ପରା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସପତ ସ୍ୱରକୁ ବାହି । ପତିବ୍ରତା ହେଲେ ମୋହି ।",
          "ମୋହନ ଶ୍ରୀକରେ ରହି ଦିଶେ କେଡ଼େ ତୋରା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭଣେ ରାମଚନ୍ଦ୍ର ଦେଉ । କରେ ମୁରଲୀ ବଜାଉ ।",
          "ତାଙ୍କ ପାଦେ ଚିତ୍ତ ରହୁ ପାଇ ସେ ଆସରା ରେ"
        ]
      }
    ]
  },
  "sources": [
