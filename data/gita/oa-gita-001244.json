{
  "id": "oa-gita-001244",
  "name": {
    "en": "Asa asa dhana re pase basa re",
    "or": "ଆସ ଆସ ଧନ ରେ ପାଶେ ବସ ରେ"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000124"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asa-asa-dhana-re-pase-basa-re-mallara-biramitrodaya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସ ଆସ ଧନ ରେ ପାଶେ ବସ ରେ",
          "କି କହିଛନ୍ତି ମୁରଲୀଧର ଥରେ ଭାଷ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅତରକିତ ଭାବରେ ଯାଉଁ ତାଙ୍କ ପାଶରେ",
          "ଦେଖାଗଲା କି ମଧୁର ରଙ୍ଗାଧରେ ହାସ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜଣାଗଲା ସ୍ନେହ ଥିବା ପରି କି ତାଙ୍କର ରେ",
          "ପଚାରିଲେ କି ଆଦରେ ଧରି ତୋହ କର ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ବାଣୀ ଶ୍ରବଣେ ଧରି ପୂରୁବ କରୁଣା ରେ",
          "କଲେ କି ନାଗରମଣି ହୃଦୟ ଫୁରୁଣା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରିପାରିଲୁ କି ସଖୀ ଅଳପ କଳଣା ରେ",
          "କରିବା ପୀରତି ହୋଇ ନାହିଁ କି ଅଲଗା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମୋହ ପରି ଅବଶରେ କୁସୁମ ନାରାଜରେ",
          "କରଇ କି କିଛି ହେଲେ ମନକୁ ନାରାଜ ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କରି ଅଙ୍ଗୀକାର ଥରେ କୁଞ୍ଜେ ଆସିବାକୁ ରେ",
          "କରିବେ କି ଅନୁକମ୍ପା ପାଶେ ବସିବାକୁ ରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କହେ ବୀରମିତ୍ରୋଦୟ ଦେବ ଯୁବରାଜ ରେ",
          "ସତେ କି ସେ ପ୍ରିୟ ମୋତେ ଦେଖା ଦେବେ ଆଜ ରେ"
        ]
      }
    ]
  },
