{
  "id": "oa-gita-000989",
  "name": {
    "en": "Mora janure basi",
    "or": "ମୋର ଜାନୁରେ ବସି"
  },
  "composer": "oa-person-000095",
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mora-janure-basi-gobinda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋର ଜାନୁରେ ବସି ଦନୁଜାରି ନନ୍ଦନନ୍ଦନ",
          "ଯାହା କଲେ ବଂଶୀବଦନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବୋଲନ୍ତି ଗୋ ରାଧେ ଶୁଣ ବିଧିରେ",
          "ଆଜ ମୁଁ ଅଧୀର ବିଷମ ଶରେ",
          "କରି ନିସ୍ତାର ପ୍ରେୟସୀବର",
          "କର କେଳି ପ୍ରଦାନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଉରଜରେ ଖରେ କରଜ ଚାଳି",
          "ଚିନ୍ତେ ଭଳି କେତେ କୌଶଳ ଭାଳି",
          "ରସନାଗରେ ଥରେ କର୍ଣ୍ଣମୂଳରେ",
          "ସଖୀ କଲେ ଚାଳନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଇସି ଇସି ବୋଲି କଲି ଶୟନ",
          "ନାଭିରେ କନିଷ୍ଠା କଲେ ପ୍ରଦାନ",
          "ଉରରେ ତା ଉର କରରେ ତା କର",
          "ସଖି କଲେ ବନ୍ଦନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଚେତନ ମୁଁ ହୋଇଗଲି ପଡ଼ି",
          "ନ ସହିଲି ସହି ତା ଭିଡ଼ାଭିଡ଼ି",
          "ସେ ବ୍ରଜରାଜ ଏଡ଼େ ନିର୍ଲ୍ଲଜ",
          "ଦେଖିଲା ମୋ ନୟନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ହୁଂକୃତ ଭାବ ଯେତେ ପ୍ରକାଶି",
          "ଯାହା ମୋତେ କଲା ସେ କାଲି ନିଶି",
          "ଭାଷଇ ଗୋବିନ୍ଦ ହେ ସନାତନ",
          "ନାଶ ମାୟା ବନ୍ଧନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mora-janure-basi-gobinda/"
    }
  ],
