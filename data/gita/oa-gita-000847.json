{
  "id": "oa-gita-000847",
  "name": {
    "en": "To bina dehe",
    "or": "ତୋ ବିନା ଦେହେ"
  },
  "composer": "oa-person-000125",
  "mula_raga": [
    "oa-raga-000104"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/to-bina-dehe-bangalasri-phakira-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତୋ ବିନା ଦେହେ",
          "କେଉଁ ଦଶା ଅନୁଭବ ନୋହେ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନ ରହିବାରୁ ତୋ ପାଶରେ କଞ୍ଜଲୋଚନା",
          "ସନ୍ତତ ଚିତ୍ତ ଥୟ ନୋହେ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହେବାରୁ ତୋ ସଙ୍ଗ ଭଙ୍ଗରେ କଞ୍ଜଲୋଚନା",
          "ଦର୍ପକ ଦର୍ପ କରିଣ ବହେ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋହ ଭାବ ଭାବୁଁ ଚିତ୍ତରେ କଞ୍ଜଲୋଚନା",
          "ନୟନୁଁ ନିରତେ ନୀର ବହେ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନ ଦେଖି ତୋ ବିଧୁମୁଖରେ କଞ୍ଜଲୋଚନା",
          "ଦୁଃସହ ସ୍ମର ଯାତନା ସହେ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚିନ୍ତିବାରୁ ତୋତେ ପ୍ରୀତିରେ କଞ୍ଜଲୋଚନା",
          "କ୍ଷଣକୁ କ୍ଷଣ ପଡ଼ଇ ମୋହେ ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଫକୀର ଭଞ୍ଜ ବଦତିରେ କଞ୍ଜଲୋଚନା",
          "ତୋ ବିଚ୍ଛେଦ ଦୁଃଖ ଥାଇ ରହେ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
