{
  "id": "oa-gita-001239",
  "name": {
    "en": "Matta bala kama chapala",
    "or": "ମତ୍ତ ବଳ କାମ ଚପଳ"
  },
  "composer": "oa-person-000150",
  "mula_raga": [
    "oa-raga-000009"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/matta-bala-kama-chapala-kedara-kabiratna-narayana-misra-balabhadra-bijaya-prabandha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଳଭଦ୍ରବିଜୟପ୍ରବନ୍ଧ, କେଦାରରାଗେଣ",
          "ମତ୍ତ ବଳ କାମ ଚପଳ ମତି ଆନନ୍ଦେ",
          "ବର ରମଣୀ ସଙ୍ଗେ ଖେଳତି ଆ",
          "ଚୁମ୍ବତେ ଚମକତି ପୁଣ ପୁଣ ଶ୍ଳିଷ୍ୟତି",
          "ରହି ରହି ମହୀତଳେ ତୋଳତି ଆ । ଉଦ୍ଗ୍ରାହଃ ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପୂରିତ ମଦନ ମହୋତ୍ସବ ବଳଦେବ",
          "ସର୍ବ କାମିନୀ ଘେନି ଚଳିଲେ ରେ",
          "ବିଳସତି ବିହସତି ଗାୟତି ସୁଖଭରେ",
          "ନିଜ ମନ୍ଦିରେ ଧୀରେ ମିଳିଲେ ରେ",
          "ଦୁର୍ମଦ ଦ୍ୱିବିଦ ବଳୀ ମୁଖ ସଂହରି",
          "ନିଜ ଜନ ମନୋରଥ ପୂରିଲେ ରେ । ସାର୍ଦ୍ଧଦ୍ୱିଗୁଣମାତ୍ରୋ ଧ୍ରୁବଃ ।"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସା ସା ସା ନି ସା ନ୍ନି ନ୍ନି ମ ପ ଧ ପ ନି ନି ନି ମ ଗ ରି ଗ ଧ ନ୍ନି ଧ ନି ଧ ପ",
          "ଧରେ ଝା କୁ ନା କୁ ଝେ ତ୍ରିଣ କିଟ ତ୍ରି ଟ ଠ ଗତେ ନା ତେନା ନଂ ନ ନା ତେ ନା ରେ । ଆଭୋଗଃ ।"
        ]
      }
    ]
  },
