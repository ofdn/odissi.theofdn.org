{
  "id": "oa-gita-000282",
  "name": {
    "en": "Nanda nandana he bansi badana he",
    "or": "ନନ୍ଦନନ୍ଦନ ହେ ବଂଶୀବଦନ ହେ"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000055"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-nandana-he-bansi-badana-he/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନନ୍ଦନନ୍ଦନ ହେ ବଂଶୀବଦନ ହେ",
          "ଛାଡ଼ିଯାଉଛ ଗୋପଭୁବନ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅକ୍ରୂର ଆଣିଛି ରଥ । ନେବ ବୋଲି ଗୋପୀନାଥ ।",
          "କେମନ୍ତେ ଧରିବୁ ଯୁବା ଜୀବନ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅକ୍ରୂର ଯାଉ ବାହୁଡ଼ି । ନ ଦେବା କୃଷ୍ଣଙ୍କୁ ଛାଡ଼ି ।",
          "କି କରି ପାରିବ କଂସରାଜନ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯଦି କଂସ କରେ କୋପ । ସମସ୍ତେ ତେଜିବା ଗୋପ ।",
          "ଅରଣ୍ୟେ ରଚିବା ନିଜ ସଦନ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାମକୃଷ୍ଣ ଗୀତେ ଭଣି । ଶୁଣ ଗୋ ବ୍ରଜତରୁଣୀ ।",
          "ସେହି ରାମ କୃଷ୍ଣ ଜଗନ୍ମୋହନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
