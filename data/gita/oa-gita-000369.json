{
  "id": "oa-gita-000369",
  "name": {
    "en": "Lajare sarigali aja sajani",
    "or": "ଲାଜରେ ସରିଗଲି ଆଜ ସଜନୀ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/lajare-sarigali-aja-sajani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଲାଜରେ ସରିଗଲି ଆଜ । ସଜନୀ ଗୋ ।",
          "ବଳେ କୋଳେ ବସାଇଲେ ନାଗରରାଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବଜାଇ ମୁରଲୀ ସ୍ୱନ । ହରିନେଲେ ମୋ ଚେତନ ।",
          "ନ ରହି ସଦନେ ମନ ହେଲା ବେଗେ ସଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଣି ତା ମୃଦୁ ବଚନ । କେ କରି ପାରିବ ଆନ ।",
          "କେତେ ଛନ୍ଦ କଲି ବୋଲି ବରତିଲି ଆଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯିବାରୁ କୁଞ୍ଜ ନିଳୟ । ନ ରହିଲା ମୋର ଭୟ ।",
          "ଜାଣି ନ ଜାଣି ହୋଇ ଧଇଲେ କରକଞ୍ଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶୁଣି ଦୂତୀ କହେ ଭାଷା । ପୁଣି ଏ କି ଲୋକହସା ।",
          "ଏ ରସରେ ଭାବି କହେ କବି ଦ୍ୱିଜରାଜ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
