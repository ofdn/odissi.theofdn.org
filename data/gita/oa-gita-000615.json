  "name": {
    "en": "Sangini to priti gheni",
    "or": "ସଙ୍ଗିନୀ ତୋ ପ୍ରୀତି ଘେନି"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000158"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangini-to-priti-gheni-ghantaraba-ekatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗିନୀ ତୋ ପ୍ରୀତି ଘେନି",
          "ମୋହନ ନିରତେ ଝୁରୁଛି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୋରୀରେ ତୋର ଗୁଣଗଣ ଗୁଣି",
          "ଗୁଣି ନୟନୁ ଲୋତକ ଝୁରଛି ରେ",
          "ଫୁଲଶର ଅତନୁ ମାରିବାରୁ ସୁତନୁ",
          "ତା ତନୁ ଅଥିରେ ଥରୁଛି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସରୁଚିର ହାର ପୂର ତାହାର",
          "ଆହାର ହେଲାଣି ଅରୁଚି ରେ",
          "କୁଞ୍ଜରଗମନୀରେ କୁଞ୍ଜରେ ବସି ଧୀରେ",
          "ତୋ ନାମ ଗାନ କରୁଛି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଳକଳ କୋକିଳ ବାଣୀରେ କେବଳ",
          "ବିବେକପଣ ହିଁ ସରୁଛି ରେ",
          "ମନ୍ଦ ଗନ୍ଧ ଶୀତ ପବନ ବହି ମିତ",
          "ଦେହରୁ ଚେତନା ହରୁଛି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆସ ଆସ ସଖି ତ୍ରାସ ମନେ ନ ରଖି",
          "ତା ଲାଗି ତୋ କର ଧରୁଛି ରେ",
          "ରଘୁନାଥ ନିତି ଯୁଗଳ ରସେ ମତି",
          "ବଳାଇ କି ଅନୁସରୁଛି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
