{
  "id": "oa-gita-000940",
  "name": {
    "en": "Kunje kunje gheni",
    "or": "କୁଞ୍ଜେ କୁଞ୍ଜେ ଘେନି"
  },
  "composer": "oa-person-000130",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunje-kunje-gheni-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁଞ୍ଜେ କୁଞ୍ଜେ ଘେନି କୁଞ୍ଜରଗମନୀ",
          "କ୍ରୀଡ଼ା କରେ କୁଞ୍ଜ ବିନୋଦିଆ",
          "କୁନ୍ଦନ କମରେ ମର୍କତ ନାୟକ",
          "ନିବିଡ଼ରେ ହେଲା ପ୍ରାୟେ ଜୂଆ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ହେମଲତିକା ତମାଳେ ଜଡ଼ିତ",
          "କଳାମେଘ କୋଳେ ବିଜୁଳି ସ୍ଥକିତ",
          "ନୀଳପଞ୍ଜରୀରେ ବସନ୍ତ ପକ୍ଷୀକି",
          "ଅଥୟ ହେଉଛି ନିଶ୍ଚେ ନୂଆ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭ୍ରମ ହେଲା ବୁଦ୍ଧି ଚେତନା ନିକର",
          "ଚମ୍ପାଫୁଲେ କିବା ଜଡ଼ିଲା ଭ୍ରମର",
          "ନିକସା ଉପରେ ଜମ୍ବୁନଦ ଗାର",
          "ମିହ୍ନା ଫୁଙ୍କା ସୁନା ତାର ହିଆ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରସଗର୍ଭ ବାଣୀ ମନ୍ତର ଉଚ୍ଚାରି",
          "ନୀଳମଣି ସ୍ଥଳେ ବିଚାରି ବିଚାରି",
          "ନାଗ ନାଗରୀକି ଉଚ୍ଚାଟ କରିକି",
          "ଖେଳାଇଛି ମୋର ଗାରଡ଼ିଆ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯେତେ ଲୀଳା କଲେ ମାଧବୀ ମାଧବ",
          "ରତି କାମ ତ୍ରାସେ ପଡ଼ି ସେ ନବ",
          "ଭାଷେ ଦୀନ ହୀନ କବି ଶ୍ରୀଚନ୍ଦନ",
          "ଧ୍ୟାନ କରି ଘନଶ୍ୟାମଳିଆ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunje-kunje-gheni-srichandana/"
    }
  ],
