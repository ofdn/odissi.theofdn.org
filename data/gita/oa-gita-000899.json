{
  "id": "oa-gita-000899",
  "name": {
    "en": "Anana mohana syame",
    "or": "ଅନାନା ମୋହନ ଶ୍ୟାମେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/anana-mohana-syame-khambaja-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନାନା ମୋହନ ଶ୍ୟାମେ କେତେ ମୁଁ କଲି ମନା",
          "ତୋ ନାଁରେ ଗୋପପୁରେ ନାଗରେ ବାଜେ କା ନାଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆଖିରେ ତା ଅଛି କଳା ଲାଖିଲେ ତୁ ହେବୁ ଭୋଳା",
          "ମୁଦି ଦେ ତୁ ଆରେ ବନ୍ଧୁ କାନେ ପଡ଼ିଲେ ତା ନାଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାହିଁ କୁଳ ନାହିଁ ରୀତି ବାଇ ବଂଶୀ ଡାକେ ନିତି",
          "ନ ଜାଣେ କି କୁଳବତୀ ବ୍ରଜେ ଉଜୁଡ଼େ ତୋ ନାଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କବିଚନ୍ଦ୍ର କହେ ରାଇ ଲଭି ସଙ୍ଗ ଲଭ ନାହିଁ",
          "କାହାରି ନୁହେଁ ସେ ହରି ଖଣ୍ଟଶେଖର ଯା ନାଁ"
        ]
      }
    ]
  },
  "sources": [
