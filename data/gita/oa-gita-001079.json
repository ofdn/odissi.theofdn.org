{
  "id": "oa-gita-001079",
  "name": {
    "en": "Chhada he pani janithila ke",
    "or": "ଛାଡ଼ ହେ ପାଣି ଜାଣିଥିଲା କେ"
  },
  "composer": "oa-person-000075",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhada-he-pani-janithila-somanatha-singha-sankarabharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛାଡ଼ ହେ ପାଣି ଜାଣିଥିଲା କେ ଏହା",
          "ପାଷାଣରୁ କର୍କଶ ପୁରୁଷଙ୍କ ମାନସ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାଇ ଦୂର ବିଦେଶେ ଥାଇ ହରଷେ",
          "ନାହିଁ ଏ ଜ୍ଞାନ ଲେଶେ",
          "ଶିରୀଷ ସୁକୋମଳା ସ୍ୱଭାବେ ଯେ ଅବଳା",
          "ସେ ପୁଣି ଅବହେଳା କୁଳିଶେ ହେବ ଦଳା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯା ବିନୟ ବଚନେ ଶୁଣଇ କାନେ",
          "ତାକୁ ମାର ଜୀବନେ",
          "ଯେହି ଏଡ଼େ ଦାରୁଣ ସେହି ମନ୍ମଥ ବାଣ",
          "ବିହି ଯହିଁ କଷଣ କେହି ରହିବ ପ୍ରାଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କହଇ ସୋମନାଥ କି ମନୋରଥ",
          "ଭାଳି କହ ହେ ନାଥ",
          "ଉଠ ନ କର ମଠ ଶଠ ଚାଟ ନ ଗଠ",
          "ପଠନେ ହେବ କାଠ ମୋ ସେ ବିରହ ପାଠ"
        ]
      }
    ]
  },
  "sources": [
