{
  "id": "oa-gita-001431",
  "name": {
    "en": "Radhadhara sumadhura",
    "or": "ରାଧାଧର ସୁମଧୁରା"
  },
  "composer": "oa-person-000108",
  "mula_raga": [
    "oa-raga-000017"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhadhara-sumadhura-ahari-krusnachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧାଧର ସୁମଧୁରାମୃତରସିକ ମୁରଲୀଧରା",
          "ହେ ମାରସୁନ୍ଦର ସୁକୁମାର ବ୍ରଜରାଜକୁମାର ସୁରନାରୀମନୋହାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହରି ହେ ନନ୍ଦ ହୃଦୟାନନ୍ଦ ସୁରଭିବୃନ୍ଦ ବାଳଗୋବିନ୍ଦ ତବ ଶ୍ରୀପଦ",
          "ସୁରାସୁରମୁନୀନ୍ଦ୍ରନୁତ ମୁରାରି ପରାତ୍ପର ପୁଣ୍ୟପୁରୁଷ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହରି ହେ ଶ୍ୟାମାବ୍ଜନିଭଧାମା ଗୋକୁଳବାମା ନିକର ନୟନମନୋସୁଖସୀମା",
          "ରମା ଉମା ନାଗବାମାବାଞ୍ଛିତ ସୁଷମା ମନୋରମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହରି ହେ ଚୌରି ହେ ଗିରିଧାରୀ ରାସବିହାରୀ ନାଗର ବ୍ରଜପୁର ନାରୀଙ୍କ ଗତି",
          "କରେ ନତି ଶ୍ରୀ କୃଷ୍ଣଚନ୍ଦ୍ର ନାରାୟଣ ଦେବ ଗଜପତି"
        ]
      }
    ]
  },
