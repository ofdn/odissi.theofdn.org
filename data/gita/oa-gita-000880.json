{
  "id": "oa-gita-000880",
  "name": {
    "en": "Kahare radha ede mana",
    "or": "କାହାରେ ରାଧା ଏଡ଼େ ମା"
  },
  "composer": "oa-person-000129",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000016"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahare-radha-ede-mana-asabari-gobardhana-ratha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହାରେ ରାଧା ଏଡ଼େ ମାନ ତୋରରେ",
          "ସାର ବୋଲି ବିଚାରୁଛୁ ହେବଟି ଅସାରରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲବେ ନ ଦେଖିଲେ ଯାକୁ କଳ୍ପ ହୁଏ ତୋରରେ",
          "ବିନୟ କରୁଛି ସେହି ନ କରୁ ଆଦରରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯା ଘେନି କୁଞ୍ଜେ ତୁ ଜାଗରିଣୀ ତେଜି ପୁରରେ",
          "ଚାହଁ ସେହି ଉଭା ହୋଇଛି ଆଗେ ତୋହରରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୁଳଶୀଳ ଜାତି ପତିବ୍ରତା ଧର୍ମ ସାରରେ",
          "ଛାଡ଼ି ଯାହାକୁ ରସିଲୁ ସେ କି ତୋର ପରରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାହା ପାଇଁ ଗୁରୁଭୟ ଲାଜ କରି ଦୂରରେ",
          "ବନେ ଅଛୁ ତାକୁ କିମ୍ପା କରୁ ତିରସ୍କାରରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତୋର ପରି ନାରୀ ତାର ନୁହଇ କନ୍ତାରରେ",
          "ଶ୍ରୀଦେବୀ ଭୂଦେବୀ ଯାର ଖଟନ୍ତି ପୟରରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ତୋତେ ମାର ଶରାନଳେ ଦହିବ ନିକରରେ",
          "ତେଜିଲେ ଗୋବର୍ଦ୍ଧନ ରଥ ଚିତ୍ତାବ୍ଜ ସୂରରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahare-radha-ede-mana-asabari-gobardhana-ratha/"
    }
  ],
