{
  "id": "oa-gita-000954",
  "name": {
    "en": "Nabaghane pulaka badane",
    "or": "ନବଘନେ ପୁଲକ ବଦନେ"
  },
  "composer": "oa-person-000132",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nabaghane-pulaka-badane-mohana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବଘନେ ପୁଲକ ବଦନେ ଚାହୁଁ କାହିଁକି",
          "ମନରେଗରେ ଅନୁରାଗରେ",
          "ଥରେ ଥରେ ଥରିଉଠୁ ଚମକି",
          "ମୋତେ କହିବୁ ନାହିଁକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁଁ ତ ଜାଣେ ତୋ ଚିତ୍ତ ମୋର ପରାଣମିତ",
          "ମନ ବଜାଇଲୁ ତ ମନମୋହନଙ୍କୁ ତ",
          "ନୋହିଲେ ଏପରି ହୁଅନ୍ତୁ ବାଇ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରଜକିଶୋରବର ସହି ନୁହେଁ କାହାର",
          "ହୋଇ ଜୀବନ ଚୋର ଜୀବନ ତୋର",
          "ଶେଷେ ଝୁରିବୁ ତା ଆଶାପଥ ଚାହିଁକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କପଟିଆଙ୍କ ଗୁରୁ ତାଙ୍କୁ ଜୁହାର ଦୂରୁ",
          "କି ମିଳିବ ସେ ପ୍ରୀତିରୁ ଭୁଲିଯାଅ ମନରୁ",
          "ପରତେ ନାହିଁ କାଳିଆ କହ୍ନାଇକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ମୋହନ ଦୟିନୀ ଶୁଣ କିଶୋରୀମଣି",
          "ନେତ୍ରୁ ବହିବ ପାଣି ତାଙ୍କ ଗୁଣକୁ ଗୁଣି",
          "ପଛେ ହେଜିବୁ ସଙ୍ଗିନୀ ମୋ ବାଣୀକି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
