{
  "id": "oa-gita-000487",
  "name": {
    "en": "Brajaraja rajaki bharame lo sakhi",
    "or": "ବ୍ରଜରାଜ ରଜକୀ ଭରମେ ଲୋ ସଖୀ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000130"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/brajaraja-rajaki-bharame-lo-sakhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବ୍ରଜରାଜ ରଜକୀ ଭରମେ ଲୋ ସଖୀ",
          "ସୁଖ ଦେଲା ଯେତେ",
          "ସେ ମୁରଲୀପାଣି ବସନ ନ ଜାଣି",
          "ଭ୍ରମେ ଆଣି ଦେଲା ମୋତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ସୁଖରେ ରାତି ବଞ୍ଚିଲି ମୁଁ ଛାତି",
          "ଉପରେ ଦେଇ ଅମ୍ବର",
          "ହେଲା ମୋତେ ପ୍ରତେ ସତେ କି ପୁରତେ",
          "ବିଜୟ ନାଗରବର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରଭାତୁଁ ଉଠନ୍ତେ ରଜକୀ ପ୍ରବେଶ",
          "ସଭ୍ରମେ ମାଗନ୍ତେ ବାସ",
          "ହାର ଲାଞ୍ଚ ଦେଇ କହିଲି ମଣାଇଁ",
          "ଆଜକ ଥାଉ ମୋ ପାଶ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏହିପରି ଯେତେ ଅଳଙ୍କାର ମୋର",
          "ଦିଅଇ ଦିନକୁ ଦିନ",
          "ରଖି ସେ ବସନ ତୋଷୁଥାଏଁ ମନ",
          "ହୋଇଲି ଭୂଷଣହୀନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଟିଳା ପୁଚ୍ଛିବେ ଯେତେବେଳେ ମୋତେ",
          "କି ବୋଲି ଦେବି ଉତ୍ତର",
          "ବୋଲେ ବନମାଳୀ ବୋଲ ଠାକୁରାଣୀ",
          "ଶୋଇଥିଲି ନେଲା ଚୋର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/brajaraja-rajaki-bharame-lo-sakhi/"
    }
  ],
