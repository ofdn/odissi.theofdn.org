{
  "id": "oa-gita-000259",
  "name": {
    "en": "Radha gobinda bhaja re manasa",
    "or": "ରାଧାଗୋବିନ୍ଦ ଭଜରେ ମାନସ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radha-gobinda-bhaja-re-manasa-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧାଗୋବିନ୍ଦ ଭଜରେ ମାନସ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତେଜ କୂଟ କପଟ ଲୋଟ ଯମୁନା ତଟ",
          "ଶ୍ରୀ ରାସସ୍ଥଳୀ ରଜରେ ମାନସ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ୱେଶ୍ୱରୀ କୁଣ୍ଡ ତୀର ବନେ ବସତି କର",
          "ହର ଏ ଭବ ରୁଜରେ ମାନସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗଳି ପଡ଼ିଥିବାର ତଳେ ମୁକୁତା ହାର",
          "ଗୋଟାଇ ଗୁନ୍ଥ ସ୍ରଜରେ ମାନସ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୋଳା ଲୀଲା କାଳରେ ଧରି ଡୋରି ସଧୀରେ",
          "ପଞ୍ଚାଇ ସୁଖେ ମଜ୍ଜରେ ମାନସ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାସ ଅବସାନରେ କୁସୁମ ବ୍ୟଜନରେ",
          "ରହି ସହୀ ସମାଜରେ ମାନସ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କଥା କରନାଟି ଅନ୍ୟଥା",
          "ନିଭୃତ କୁଞ୍ଜ ଶେଯରେ ମାନସ"
        ]
      }
    ]
  },
