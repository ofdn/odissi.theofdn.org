{
  "id": "oa-gita-000896",
  "name": {
    "en": "Ase basanta sakhi re",
    "or": "ଆସେ ବସନ୍ତ ସଖିରେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000181"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ase-basanta-sakhi-re-dipaka-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସେ ବସନ୍ତ ସଖିରେ",
          "କି ଦୁରନ୍ତ ନାହିଁ ମୋର କାନ୍ତ",
          "ସଜନୀ ମୁଁ ଏକା ତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "(ପଡ଼ି)",
          "କୁଞ୍ଜେ କୁଞ୍ଜେ ପିକ ଗୁଞ୍ଜରିଲା କୁହୁ",
          "ଚମକି ଚମକି ବିରହିଣୀ କହିଲା ଉହୁ",
          "ଥମକି ଥମକି ମରେ କି ସତେ ମୁହୁର୍ମୁହୁଃ",
          "ଅଞ୍ଜନ ଗଞ୍ଜନ ନୟନ ତେଜିଲା ବନ ତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାମ ନାଗରା ପିଟିଲା ତାମରସ ପ୍ରକଟିଲା",
          "କବିଚନ୍ଦ୍ର ବୋଲେ ବାମା ଜୀବନୁ ଜୀବ ତୁଟିଲା",
          "(ପଡ଼ି)",
          "ବନେ ବନେ ଛାଇଲା କୁସୁମ ଶିରୀ",
          "ଚନ୍ଦନ କାନନେ ମଳୟ ଗଲା ଭରି",
          "ଗିରିବନ ଅପଘନ ନିଶିଦିନ ଛନ୍ନଛନ୍ନ",
          "ହସେ ଭରା ଧରା ସାରା ଦରଦର ନିରତ"
        ]
      }
    ]
  },
