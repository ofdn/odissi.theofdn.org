{
  "id": "oa-gita-001405",
  "name": {
    "en": "Jaya sri sarada go",
    "or": "ଜୟ ଶ୍ରୀ ଶାରଦା ଗୋ"
  },
  "composer": "oa-person-000131",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaya-sri-sarada-go-radha-prema-leela-lila/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "( ରାଧାପ୍ରେମ ଲୀଳା )",
          "ଜୟ ଶ୍ରୀ ଶାରଦା ଗୋ ସଜକଞ୍ଜଲୋଚନା",
          "କୁନ୍ଦରଦନା ବିଧୁବଦନା ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିବ୍ୟ ଗାନକୁଶଳା କୁନ୍ଦଇନ୍ଦୁଧବଳା",
          "ଦୀନଜନବତ୍ସଳା ଅମରୀ ଶିରମାଳା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଣିହାର ମଣ୍ଡିତ କୁଚକୁମ୍ଭମଣ୍ଡଳା",
          "ଦଳିତାଞ୍ଜନରେଖା ମଞ୍ଜୁନେତ୍ରଯୁଗଳା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାଣିକ୍ୟ ବୀଣା ଗୁଣାଙ୍ଗୁଳି ଚାଳନ କଳା",
          "କଉତୁକିନୀ ହରିମନମୋହିନୀ ବାଳା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତବ କରୁଣା ଲେଶ ସମ୍ପାଦି ଆଦି ଶେଷ",
          "ରଚି ମହତ ଭାଷ ଭବେ ରଖିଲେ ଯଶ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଧନ୍ୟ ସେ ବୃହସ୍ପତି ବିରଚି ନାନା ସ୍ତୁତି",
          "ଅରଜି ଗୁରୁ ଖ୍ୟାତି ସରଜିଲେ କୀରତି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପଡ଼ି ସେ ପଦ ତଳେ କିଶୋରଚନ୍ଦ୍ର ବୋଲେ",
          "ସଦୟ ନେତ୍ରାଞ୍ଚଳେ ଅନାଇଁ ଦିଅ ବେଳେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaya-sri-sarada-go-radha-prema-leela-lila/"
    }
  ],
