{
  "id": "oa-gita-000147",
  "name": {
    "en": "Dosa bina mo nabina",
    "or": "ଦୋଷ ବିନା ମୋ ନବୀନା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dosa-bina-mo-nabina/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦୋଷ ବିନା ମୋ ନବୀନା",
          "ରୋଷ କିମ୍ପାଇଁ ବହିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗେଲାଇ ନାଗରୀମେଳେ",
          "ଗଜରାଜଗତି ଗଲାବେଳେ",
          "ମୋ ଆଡ଼କୁ ଫେରି ଥରେ",
          "ହେଲେ ମୋତେ ନ ଚାହିଁଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମନୋହର ବେଶ ପାଇଁ",
          "ସୁମନସ ଖୋଜି ଦେଲି ନେଇ",
          "ତା ନ ଘେନି ଜୀବଧନୀ",
          "ମଥା ପୋତିରହିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦିନେ ବସି ସଖୀ ସଙ୍ଗେ",
          "ହରୁଥିଲା କାଳ ନାନାରଙ୍ଗେ",
          "ସେ ସମୟେ ମୋତେ ଦେଖି",
          "ହସି ଉଭା ତ ନୋହିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତା ପ୍ରୀତି ଲଭିବା ଦିନୁ",
          "ଲବେ ନ ମାନଇ ଫୁଲଧନୁ",
          "ସେ କଷଣ ସହ ବୋଲି",
          "ବିହି ଏହା କି ଲିହିଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନ ସହି ମୋର ତ ଶିରୀ",
          "କି ବିଚାରି ସେ ତ କୋପ କରି",
          "ମୋଦେ ପଞ୍ଚଶରେ ରଚି",
          "ତାକୁ କି ଅବା କହିଲା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବୋଲେ ଅଷ୍ଟଦୁର୍ଗନାଥ",
          "କି କରିବି ନ ଦିଶଇ ପଥ",
          "ଚାହୁଁ ଚାହୁଁ ଦଶଦିଶ",
          "କାମ ଅନ୍ଧାର ପିହିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
