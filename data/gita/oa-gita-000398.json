{
  "id": "oa-gita-000398",
  "name": {
    "en": "Na jani mun kali pirati",
    "or": "ନ ଜାଣି ମୁଁ କଲି ପୀରତି"
  },
  "composer": "oa-person-000043",
  "mula_raga": [
    "oa-raga-000089"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-jani-mun-kali-pirati-mohana-kedara-dinabandhuraja-harichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ ଜାଣି ମୁଁ କଲି ପୀରତି",
          "କେ ଜାଣିଥିଲା ଗୋ ଏହା",
          "ଭଜିଲେ ହେବ ବିପତ୍ତି",
          "ତେଜିଲେ ତ ନାହିଁ ସାହା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସରଜି ନିଷେଧ ଗିର",
          "ତରଜିଲେ ସଖୀ ମୋର",
          "ବରଜି ବୋଲ ତାଙ୍କର",
          "ଅରଜିଲି ସଖି ଏହା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରସିଲା ଦିନୁ ମୋ ଚିତ୍ତ",
          "ଭାସିଲା ସତୀ ବରତ",
          "ଖସିଲା ଧର୍ଯ୍ୟ ଜୀବୁତ",
          "ନାଶିଲା ମୋର ଉତ୍ସାହା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରିବାରୁଁ ପରପ୍ରୀତି",
          "ମରିବାର ଭଲ ଗତି",
          "ସରିବା ନୁହେଁ ବିପତ୍ତି",
          "ତରିବାକୁ ନାହିଁ ରାହା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନରମେ ଦିବସ ନିଶି",
          "ସରମେ ମୁଁ ଥିଲି ବସି",
          "ଭରମେ ପଡ଼ିଲି ଆସି",
          "କରମେ ମୋ ଥିଲା ଯାହା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭୁଲି ତ ଗଲା ମୋ ମତି",
          "ମଲି ତ ଏବେ ମୁଁ ନିତି",
          "ହେଲି ତ ଦୁଃଖୀ ପୀରତି",
          "କଲି ତ ମୁଁ କଥା ରୁହା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏସନ ଏ ସଖୀ କହି",
          "ତୋଷ ମନେ ବହି ସହୀ",
          "ଲେଶ ମଧୁରତା ନାହିଁ",
          "ବିଷମ ପୀରତି ସ୍ପୃହା"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଦୀନବନ୍ଧୁ ରାଜ ଭଣି",
          "ମୀନବର ନେତ୍ରୀ ଶୁଣି",
          "ଦିନେ ବଞ୍ଚିଲେ ସେ ପୁଣି",
          "ସୁ-ନବ-ନୀରଦ ଦେହା"
        ]
      }
    ]
  },
  "sources": [
    {
