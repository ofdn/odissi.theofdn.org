{
  "id": "oa-gita-000769",
  "name": {
    "en": "Sri radha sangare sri hari rangare",
    "or": "ଶ୍ରୀ ରାଧା ସଙ୍ଗରେ ଶ୍ରୀ ହରି ରଙ୍ଗରେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-radha-sangare-sri-hari-rangare-hori-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ରୀ ରାଧା ସଙ୍ଗରେ ଶ୍ରୀ ହରି ରଙ୍ଗରେ",
          "ହୋରି ଖେଳିଲେ ସୁଧାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀ ପଦ ଗାନ କରେ କେ ତହିଁ ବସନ୍ତ ରାଗରେ",
          "ମନ୍ଦ୍ର ମଧ୍ୟ ସୁତାନରେ",
          "ତାତା ଥେଇ ଥେଇ ମୃଦଙ୍ଗ ବାଜଇ",
          "ମନ୍ଦ୍ର ମଧ୍ୟ ଦ୍ରୁତ ମାନରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଙ୍ଗିନୀ ରଙ୍ଗିନୀ ପୁରତେ ରହି ରହି",
          "ତୁଙ୍ଗବିଦ୍ୟା ନାନା ବାଦ୍ୟେ",
          "ମୋହିତ କରିବାରେ ଇନ୍ଦୁଲେଖା ମୁଖ",
          "ଇନ୍ଦୁ ଢାଳି ନାଚେ ମଧ୍ୟେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦ୍ୱନ୍ଦ ଦ୍ୱନ୍ଦ ବୃନ୍ଦ ବୃନ୍ଦ ସୁନ୍ଦରୀ",
          "ନନ୍ଦଲାଲଙ୍କୁ",
          "ଚୂଆ ଚନ୍ଦନ ଅତର ପନୀର",
          "ଅବିର ସଙ୍ଗେ ଗୁଲାଲକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେ ଢାଳେ ବଳେ କେ ଛକେ କୁତୂହଳେ",
          "ମୋହନ ମୁରଲୀ ଛଡ଼ାଇ",
          "ଚଞ୍ଚଳେ ଅଞ୍ଚଳ ଧରି କହେ ବନମାଳୀ",
          "କାହାକୁ ଧରନ୍ତି ଗୋଡ଼ାଇ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
