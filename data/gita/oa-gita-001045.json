{
  "id": "oa-gita-001045",
  "name": {
    "en": "E ki bhangi",
    "or": "ଏ କି ଭଙ୍ଗୀ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-ki-bhangi-tu-angikara-sri-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ କି ଭଙ୍ଗୀ ତୁ ଅଙ୍ଗୀକାର ନ କରୁ",
          "ରଙ୍ଗିମାଧରୀ ଜୀବ ସଙ୍ଗିନୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଙ୍ଗରେ ମୋହର ରଙ୍ଗରେ ବିହାର",
          "ତୁଙ୍ଗସ୍ତନୀରେ ତୁ ନ ଭାଙ୍ଗ ଆଶାକୁ ଭୂରୁଭଙ୍ଗିନୀ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାମନୟନୀ ତୋ ବାମ ଦେଖି କାମ",
          "ଯାମ ଯାମକରେ ଝାମ ଦେଉଛି ହେମବରନୀ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୁନ୍ଦରୀମଣି ଅସୁନ୍ଦର ଏ ରୀତି",
          "ମନ୍ଦ ଦ୍ୱନ୍ଦ ବନ୍ଦ ବହୁ କୁନ୍ଦରଦନୀ ଗୁଣବନ୍ଦିନୀ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପାଶରେ ତୁ ବସ ଦୋଷକୁ ନ ଘୋଷ",
          "ଭାଷଇ ରଘୁନାଥ ଭାଷ ଭାଷ ବିଧୁହାସିନୀ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
