  "id": "oa-gita-000622",
  "name": {
    "en": "Rachithila eha biranchi",
    "or": "ରଚିଥିଲା ଏହା ବିରଞ୍ଚି"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000050"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rachithila-eha-biranchi-jadumani-saranga/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରଚିଥିଲା ଏହା ବିରଞ୍ଚି",
          "ବିପଞ୍ଚୀ ଗିରାକୁ ଅଇଲି ମୁଞ୍ଚି",
          "କୁଞ୍ଚିତ ମୋ ତପ ସଙ୍କୁଚିତ ହେଲା",
          "କୁଚିତ୍କାରେ ଯାହା ଆସିଲି ଘୁଞ୍ଚି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାଚିଲି ମୁଁ ତାକୁ ପୁରୁଷାୟିତ",
          "ସୁଚିତ୍ତରେ ଦେଲା ହସି କିଞ୍ଚିତ",
          "ରଞ୍ଚିଥିଲା ତାହା ସେ ମୃଣାଳବାହା",
          "ଏବେ ଏ କାଳରେ ଥିବ କି ବଞ୍ଚି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରୁଚିତଦେହାର ମୁକୁତା ହାର",
          "ଛିଞ୍ଚିବଣି ଗଳୁ ହୋଇ ବାହାର",
          "ଖଚିତ ଭୂଷଣ ହେବଣି ଦୂଷଣ",
          "ରଖିଥିବ ତାହା ପୂରୁବୁଁ ସଞ୍ଚି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିଶି ଦିବସରେ ଲୋତକ ମୁଞ୍ଚି",
          "ମୁଞ୍ଚି ଦେଉଥିବ ଧରାରେ ବିଞ୍ଚି",
          "ନବଦୁର୍ଗେଶ୍ୱର ଭଣିଲା ଏ ଗିର",
          "ଫେଡ଼ିବ ସେ ଦୁଃଖ ଯାଇ ପହଞ୍ଚି"
        ]
      }
    ]
  },
  "sources": [
