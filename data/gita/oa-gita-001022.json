{
  "id": "oa-gita-001022",
  "name": {
    "en": "Se mohananku snehe ke mohila",
    "or": "ସେ ମୋହନଙ୍କୁ ସ୍ନେହେ କେ ମୋହିଲା"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-mohananku-snehe-ke-mohila-sri-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ ମୋହନଙ୍କୁ ସ୍ନେହେ କେ ମୋହିଲା ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସ୍ନେହେ କେ ମୋହିଲା ସୁରତି ବିହିଲା",
          "ତାର କାମନା ଯେତେ ସଫଳ ହୋଇଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସରାଗେ କହିଲା କୁଞ୍ଜରେ ରହିଲା",
          "ତା ତନୁକୁ ଅତନୁ ଶରେ ନ ଦହିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଙ୍କରେ ବସିଲା ଅଙ୍ଗରେ ମିଶିଲା",
          "ସଜନୀ ଏ ରଜନୀ ହରଷରେ ବଞ୍ଚିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କିଶୋରୀ ଭାସିଲା ଭାବକୁ କଷିଲା",
          "କବି ରଜନୀନାଥ ରଘୁନାଥ ଭଣିଲା"
        ]
      }
    ]
  },
  "sources": [
    {
