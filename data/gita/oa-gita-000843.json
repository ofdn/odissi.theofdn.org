{
  "id": "oa-gita-000843",
  "name": {
    "en": "Ago sakha suna krusna",
    "or": "ଆଗୋ ସଖା ଶୁଣ କୃଷ୍ଣ"
  },
  "composer": "oa-person-000083",
  "mula_raga": [
    "oa-raga-000145"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ago-sakha-suna-krusna-soka-kamodi-narayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଗୋ ସଖା ଶୁଣ",
          "କୃଷ୍ଣ ରୂପର ମହା ଅଦ୍ଭୁତ ଗୁଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେଉଁ ଶୋଭା ଦେଖି ପଶୁ ପକ୍ଷୀ",
          "ନ ଥାନ୍ତି ନେତ୍ରେ ପଲକ ରଖି",
          "ହୋଇ ଅଶ୍ରୁମୁଖୀ ହୁଅନ୍ତି ସେ ଲେଖି",
          "ଦେବା ପ୍ରତିମା ପରାୟେ ଲକ୍ଷି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଥାଉ କହିବାର ମନୋହର",
          "ସୁରବର ପୁର ନାରୀବାର",
          "ହେଲେହେଁ ସଦାର ଚାହିଁ ସେ ମନ୍ଦାର",
          "ଚରଣ ଘୋଟେ କାମ ଅନ୍ଧାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସାଧ୍ୱୀ ଶିରୋମଣି ରମା ପୁଣି",
          "କେଉଁ ଭାବକୁ ସେ ମନେ ଘେନି",
          "ଯେଉଁ ପଦ ବେନି କୁଚେ ଧରି ଆଣି",
          "କରିଅଛନ୍ତି ପଦକ ମଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାବିବାର କେଉଁ ପ୍ରୟୋଜନ",
          "ଯେ ପାଷାଣ ଶ୍ରେଣୀ ହୃଦଶୂନ୍ୟ",
          "ଲାଗିଲେ ସେ ପାଦ ଆରମ୍ଭନ୍ତି ବାଦ",
          "ହ୍ରଦ ପଙ୍କିଳ ସଙ୍ଗରେ ପୁଣ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବାଳ କାଳୁ ମିତ କାହା ଚିତ୍ତ",
          "ନ ଦ୍ରବୁଛି କହ ତା ଦେଖି ତ",
          "କହେ ନାରାୟଣ ବନ୍ଧୁର ଶରଣ",
          "ବାଣ ପ୍ରସାରଣ ବେନି ନେତ୍ର"
        ]
      }
    ]
  },
  "sources": [
    {
