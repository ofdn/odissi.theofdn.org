{
  "id": "oa-gita-000371",
  "name": {
    "en": "Kie se sahi e mana mohana",
    "or": "କିଏ ସେ ସହି ଏ ମନମୋହନ"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kie-se-sahi-e-mana-mohana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କିଏ ସେ ସହି ଏ ମନମୋହନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯା ମଧୁର ବଂଶୀସ୍ୱନ । ଆସି ପଡ଼ିବାରୁ କର୍ଣ୍ଣ ।",
          "ପଥରେ ମଜ୍ଜାଇ ମନ ହଜାଇ ଦେଲା ମୋ ଜ୍ଞାନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗତ କାଲି କୁଞ୍ଜବନ । ମିଶିଯାଇ ଗୋ ସୁମନ ।",
          "ତୋଳୁ ତୋଳୁ ଯା ଆନନ ଦେଖି ହୋଇଗଲି ଛନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମତ୍ତ ମୟୂର ନର୍ତ୍ତନ । ବୋଲି ବୁଲାଇ ବଦନ ।",
          "ଚାହୁଁ ଚାହୁଁ ଅଚେତନ ହେଲିରେ ଜୀବଜୀବନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅନୁମାନି ଯା ଲାବଣ୍ୟ । ମୂର୍ତ୍ତି ଛଟା ପରସନ୍ନ ।",
          "ଲେଖିରେ ନାରୀରତନ କରାଇଲୁ ଦରଶନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀ ରାଧା ନେତ୍ର ମିଳନ । ହେଉ ଶ୍ରୀ ନନ୍ଦନନ୍ଦନ ।",
          "ଭାବି ଶୋଭା ନିଶି ଦିନ କଲା ହରିବନ୍ଧୁ ଧ୍ୟାନ"
        ]
      }
    ]
  },
