{
  "id": "oa-gita-000987",
  "name": {
    "en": "Madana nauka pare",
    "or": "ମଦନ ନଉକା ପରେ"
  },
  "composer": "oa-person-000126",
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madana-nauka-pare-mardaraja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଦନ ନଉକା ପରେ ବସାଇ ଭସାଇଦେଲୁ",
          "ସଙ୍ଗିନୀ ତୁ ଏ ରୀତି କଲୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେବେ ଦୋଷ ହେଲା ମୋହର",
          "ଜଣାଉଛି ଭାରତୀରେ ଅପରାଧ କ୍ଷମା କର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କର ବଚନ ସତ ମଣି",
          "କି ପାଇଁ ମହୀକି ଚାହିଁ ବସିଅଛୁ ତୁ ଗୁମାନୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋହ ବିନା ସାହା ମୋହର ନାହିଁ",
          "ଚନ୍ଦ୍ରମୁଖ ଟେକି ବାରେ ସୀଉକାର କର ତୁହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମର୍ଦ୍ଦରାଜ ଭାଷେ ଏ ଗୀତେ",
          "ହରଷେ ମେଲାଣି କର ଜଣାଉଛି ଧନ ତୋତେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madana-nauka-pare-mardaraja/"
    }
  ],
