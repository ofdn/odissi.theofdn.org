{
  "id": "oa-gita-000728",
  "name": {
    "en": "Manini radhe nikunje asa",
    "or": "ମାନିନୀ ରାଧେ ନିକୁଞ୍ଜେ ଆସ ଗୋ"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manini-radhe-nikunje-asa-kalyana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନିନୀ ରାଧେ ନିକୁଞ୍ଜେ ଆସ ଗୋ",
          "କହିଛନ୍ତି ପୀତବାସ",
          "ବସିଛନ୍ତି ଭାଳି ତୋର ଗଳାମାଳି",
          "ହାହା ପ୍ରିୟେ ବୋଲି",
          "ତେଜି ଦୀର୍ଘ ନିଶ୍ୱାସ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ନନ୍ଦନନ୍ଦନ ମୁରଲୀ ବଦନ",
          "ମଦନେ କଦନ ଲଭୁଛନ୍ତି ଧନ",
          "(ପଡ଼ି)",
          "ତେଜ ତେଜ ମାନ ମୋ ମିନତୀ ଘେନ",
          "ଗତି ନାହିଁ ଆନ ନ କରରେ ନିରାଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସେ ଶ୍ୟାମଳ ଶଶୀ ନୀଳକଇଁ ବାସୀ",
          "ହେଲା ପରି ଦିଶି ଗଲେଣି ସୁକେଶୀ",
          "(ପଡ଼ି)",
          "ରାଧାର ମୁଁ ଦୋଷୀ ବୋଲି ଦିବା ନିଶି",
          "ହେଉଛନ୍ତି ଘୋଷୀ ଆକୁଳେ ଲଭି ତ୍ରାସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେ ଗୋପ ସଙ୍ଖାଳୀ କାହ୍ନୁ ବନମାଳୀ",
          "କେତେ ନିଉଛାଳି ହେଲେ ଧନମାଳି",
          "(ପଡ଼ି)",
          "ନେତ୍ରୁ ଅଶ୍ରୁ ଢାଳି ତୋ ନାମକୁ ମାଳି",
          "କରି ଭାଳି ଭାଳି ଆହା ଲଭେ କି ପ୍ରାସ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୂତିକା ଦଇନୀ ମାନି ବିନୋଦିନୀ",
          "ସର୍ବ ସଖୀ ଘେନି ଚଳିଲେ ସେକ୍ଷଣି",
          "(ପଡ଼ି)",
          "ବେଣୁଧର ଭଣି ଚିନ୍ତି ଚିନ୍ତାମଣି",
          "ସେ ଯୁଗଳ ଠାଣି ଦେଖି ଲଭିବି ତୋଷ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
