      {
        "n": 0,
        "lines": [
          "ସକଳ ଶୁଦ୍ଧ ସ୍ୱର ଯୋଗରେ",
          "ସାଧ ଅନୁରାଗରେ",
          "ଜାତି ଔଡ଼ବ ସମ୍ପୂର୍ଣ୍ଣ ମେଳ ଶ୍ରୀ ଅଙ୍ଗରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସମୟ ନିଶି ଦ୍ୱିତୀୟ ଭାଗ",
          "ଗାଅ ଦେଶାକ୍ଷ ରାଗ",
          "ବାଦୀ ସଂବାଦୀ କରି ଗାନ୍ଧାର ଧୈବତ ସ୍ୱରେ"
        ]
      }
    ]
