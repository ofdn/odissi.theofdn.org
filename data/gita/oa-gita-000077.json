{
  "id": "oa-gita-000077",
  "name": {
    "en": "Chahan chahan re bandhu",
    "or": "ଚାହାଁ ଚାହାଁରେ ବନ୍ଧୁ"
  },
  "composer": "oa-person-000036",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-chahan-re-bandhu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁ ଚାହାଁରେ ବନ୍ଧୁ । ଚାହାଁ ଏ ନୀପମୂଳକୁ ।",
          "ଥୟ କରି ଥରେ ମାତ୍ର ନେତ୍ରାଞ୍ଚଳକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ଯୋଗେ ବାଳୀମଉଳି ।",
          "କୁସୁମ ଆଳି କାଳିନ୍ଦୀର କୂଳକୁ । କଲୁ ଅନୁକୂଳକୁ ।",
          "ସୁନ୍ଦରବୃନ୍ଦପୁରନ୍ଦର ମନ୍ଦରଗିରିଧର ଚନ୍ଦ୍ରକଚାରୁଚୂଳକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲୁଚି ଲୁଚି ତୋ ଚଞ୍ଚଳ ।",
          "ସୁକୁଞ୍ଚିତ ଅଞ୍ଚଳ ପୀତଚେଳକୁ । ପୁଣି କାଞ୍ଚିମେଳକୁ ।",
          "ଦଣ୍ଡିତ ଚିତ୍ରଶିଖଣ୍ଡୀ ତ ମଣ୍ଡିତ ମୌକ୍ତିକମଣିମୟ ନାସାତିଳକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
