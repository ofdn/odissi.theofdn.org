  "id": "oa-gita-000836",
  "name": {
    "en": "Mita chahan e para",
    "or": "ମିତ ଚାହାଁ ଏ ପରା"
  },
  "composer": "oa-person-000050",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mita-chahan-e-para-bilahari-dinakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମିତ ଚାହାଁ ଏ ପରା",
          "ବ୍ରଜ ଯୁବତୀମାନଙ୍କ ଚିତ୍ତଚୋରା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁରଲୀ କରେ ଧରି ମାରି ନେତ୍ର କଟାରୀ",
          "ପତିବରତ ହରି ନିଅଇ ଜୂର କରି",
          "ତା ପାଲରୁ ଉବୁରି ଅଛି କେ ବ୍ରଜନାରୀ",
          "ନ ପଡ଼ି ଧରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତ୍ରିଭଙ୍ଗୀ ଛନ୍ଦେ ଉଭା ହୋଇ ଦିଶନ୍ତି ଶୋଭା",
          "ନୋହିବ କେ ବା ଲୋଭା ନୀଳମଣି ପ୍ରତିଭା",
          "ଅଧର ଜିଣି ଜବା ଜାତି କୁସୁମ ଗଭା",
          "କି ଦିଶେ ତୋରା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଟିତଟେ କିଙ୍କିଣୀ ବାଜଇ କିଣି କିଣି",
          "ଶୁଣି କେଉଁ ରମଣୀ କିଣି ନୋହିବ ପୁଣି",
          "ଆହା ତ୍ରିଭଙ୍ଗୀ ଠାଣି ବାଙ୍କ ବାଙ୍କ ଚାହାଣୀ",
          "ନେତ୍ର ପସରା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜାଳିଣ ଯେ ଜାଗର ପୂଜି ପାର୍ବତୀ ବର",
          "ପାଇବ ଏ ନାଗର ଠାରୁ ସେ ସୁଆଦର",
          "ଦୀନକୃଷ୍ଣ ଏ ଗିର ଭାଷନ୍ତି ବାରମ୍ବାର",
          "ମୋ କଣ୍ଠହାରା"
        ]
      }
    ]
  },
  "sources": [
