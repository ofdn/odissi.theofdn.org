{
  "id": "oa-gita-001197",
  "name": {
    "en": "Motidanti dantibara gati",
    "or": "ମୋତିଦନ୍ତୀ ଦନ୍ତୀବର ଗତି"
  },
  "composer": "oa-person-000148",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/motidanti-dantibara-gati-brajanatha-badajena/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋତିଦନ୍ତୀ ଦନ୍ତୀବର ଗତି ତ ସେ",
          "କାଲି ରାତି ହେଲା ବାଈ",
          "ଶ୍ୟାମଳ କମଳଦଳ ନେତ୍ରୀ କାମ",
          "ଅମଳ ବା ଥିଲା ଖାଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲାଜେ ପାଶେ ସେ ଯେ ନ ବସଇ ଶେଯେ",
          "ପଲଙ୍କେ ଅଙ୍କେ ନ ରହେ",
          "କୁଚ ଯୋଡ଼ି ଯୋଡ଼ି ନିବିଡ଼ରେ ଭିଡ଼ି",
          "ଜଡ଼ିଗଲା ମୋର ଦେହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋ ବନ୍ଧୁ ପରାଣଧନ କହି ରାଣ",
          "ଦେଲେ ଅବା ଚୁମ୍ବ ଦିଏ",
          "ଚାରୁ ସରୁଚୁମ୍ବ ଶତ ଶତ ବିମ୍ବ",
          "ଓଷ୍ଠୀ ଦେଲା କେତେ ସ୍ନେହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚାଟୁ କରି ଦିନଯାକ ଅବା ପୀନ",
          "ଜଙ୍ଘରୁ ଖସାଇ ବାସ",
          "ଅଚୀର ସର୍ବାଙ୍ଗେ ଚିରକାଳ ରଙ୍ଗେ",
          "ବିହରିଲା ଏ ମୋ ଦୃଶ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲାଗିଲେ ବିନତି କରି ଯେ ସୁରତି",
          "ସମ୍ମତି କରଇ ନାହିଁ",
          "ବିପରୀତେ ମାତି ଝୁଲି ଝୁଲି ଛାତି",
          "ପରେ ଶୁଏ ଶ୍ରମ ପାଇ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏ ଅମଳ ଖାଇ ପ୍ରତି ରାତି ବାଈ",
          "ହୋଇଥାନ୍ତା ବାଳା ଯେବେ",
          "ବ୍ରଜନାଥ ଭାଷେ ମନୋଜକୁ ଲେଶେ",
          "ଭୟ ହୁଅନ୍ତାନି ତେବେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/motidanti-dantibara-gati-brajanatha-badajena/"
    }
  ],
