{
  "id": "oa-gita-000700",
  "name": {
    "en": "Sari gala je laje",
    "or": "ସରି ଗଲା ଯେ ଲାଜେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000009"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sari-gala-je-laje-kedara-adatali-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରି ଗଲା ଯେ ଲାଜେ",
          "ରହି ନ ପାରେ ସହୀ ସମାଜେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନଗତିଳକ ଉରୋଜାଏ ଅଛନ୍ତି",
          "ଅଗଣିତେ ଅନୁସରି ହେ",
          "ଜଗତୀ ଲଲାମ ଚମ୍ପାଝରା ନାମ",
          "ଯୋଗ୍ୟ କି ଏକା କିଶୋରୀ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘେନାଇ କହିଲେ ହେଲେ ନେତ୍ରାଞ୍ଚଳେ",
          "ଅନାଇ ତ ସେ ନ ଜାଣୈ ହେ",
          "ତାକୁ ନଟ ଖଞ୍ଜରୀଟ ନେତ୍ରା ବୋଲି",
          "ଡାକୁଥାଅ ତୁମ୍ଭେ କେଣେ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁମ୍ଭ ଉରେ ସ୍ତନ କୁମ୍ଭ ନତ ତନୁ",
          "ଲତା ଯେ ମଣ୍ଡାଏ ନାହିଁ ହେ",
          "ବହିଯିବ ବୋଲି ଶୋଭା ପୀୟୂଷ କି",
          "ରହିଥାଅ ଏକା ଚାହିଁ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାରୁଣ୍ୟ ଗରବେ ବାଳା ସେ ତ କେବେ",
          "ଚାଲିକି ନ କରେ ଚାରୁ ହେ",
          "ସଡ଼ୁଅଛି କେଳି ଲାଳସୀ ମରାଳୀ",
          "ଗତି ବୋଲି ଡାକିବାରୁ ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଧର ମାଧୁରୀ ଅଭିମାନେ ପୂରି",
          "କେତେ ନାଗରୀ ନାହାନ୍ତି ହେ",
          "ତା ଦଶନ ଅଙ୍କ ଥିବା ପାନ ରଙ୍କ",
          "ପରି ମାଗିବାର ନିତି ହେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପ୍ରେମାଦରେ ଅବା ପ୍ରମାଦରେ ବାଣୀ",
          "ଶୁଣିବା ଚିତ୍ତ କାହିଁକି ହେ",
          "ସରସ ଶ୍ଳେଷ ମଦ କଳକୋକିଳ",
          "ବଚନା ବୋଲି ନାହିଁକି ହେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଜଗଦ୍ଦେବ ବନ୍ଦି ଜଣାଇଲେ ଇନ୍ଦୀ",
          "-ବର ଶ୍ୟାମ ବଂଶୀପାଣି ହେ",
          "ତୁମ୍ଭେ ସେ ତରୁଣୀ ଚାଲିବା ସରଣୀ",
          "ପରାଗେ ଗଡ଼ିବା ଜାଣି ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
