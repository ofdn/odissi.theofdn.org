    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରସମୟୀ ଶ୍ରୀକିଶୋରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଢଳି ଢଳି ମନ୍ଥର ଗମନେ ସୁକୁମାରୀ",
          "ଧୀର ବାଣୀ ଭାଷିବାର ନାହିଁ ତିନିପୁରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲଳିତା ସଜନୀ କରେ ତାମ୍ବୁଳ ବିଟିକା",
          "ସାଦରେ ଗନ୍ଧଚନ୍ଦନ ଧରେ ବିଶାଖିକା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ରୀଗୁରୁରୂପା ସଙ୍ଗିନୀ ଆଜ୍ଞା ଶିରେ ଘେନି",
          "ଦୁଃଖୀ ବେଣୁଧର ଚଳେ ଧରି ପିକଦାନୀ"
        ]
      }
    ]
  },
