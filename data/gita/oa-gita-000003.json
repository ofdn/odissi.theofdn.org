    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନମୋହନେ ନୁହଁ ଅଭିମାନିନୀ",
          "ତାଙ୍କ ସମୟକୁ ଅଣ୍ଟିଗଲାଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାନମୟୀ ତେଜ ମାନ",
          "ଧନୀ ମୋ ବଚନ ମାନ",
          "କି ହୋଇବ କେତେ କଲେ ଭାଳେଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଞ୍ଜ ସମୟ ହେଲାଣି",
          "କଞ୍ଜ ତ ଘୁମାଇଲାଣି",
          "କୁଞ୍ଜେ ହେଟି ଶ୍ୟାମ ବିଜେ ବୋଲେ ତାରିଣୀ"
        ]
      }
    ]
  },
