{
  "id": "oa-gita-000080",
  "name": {
    "en": "Kaha kaha ki karibi priyasahi",
    "or": "କହ କହ କି କରିବି ପ୍ରିୟସହି"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000034"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-kaha-ki-karibi-priyasahi-krusna-kedara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ କହ କି କରିବି ପ୍ରିୟସହି",
          "ଶ୍ୟାମ ପ୍ରୀତି ମନୁ ଗଲା ତ ନାହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିନ ଦିନକର ଭାବ ଗୋ",
          "ଭାବିଲେ କିଏ ସେ ଦେବ ଗୋ",
          "ବେଳକୁ ବେଳ ତ ମରମ ହେଉଛି ଦହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦିନେ ମୁଁ ଯମୁନା ପାଣିକି",
          "ଯାଆନ୍ତେ ସେ ବେଣୁପାଣିକି",
          "ଦେଖି ତ ପାଦ ତେଣିକି ଚଳିଲା ନାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦିନେ ବନେ ବନମାଳୀ ଗୋ",
          "ଥିଲେ ଗଲି ଫୁଲ ତୋଳି ଗୋ",
          "ଯାହା କଲେ ଆଗୋ ଆଳି ନୁହଇଁ କହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦିନେ ସଜନୀ ସୁବେଶରେ",
          "ପ୍ରବେଶିଲେ ସେ ମୋ ପାଶରେ",
          "କରକୁ ଧରିଣ କେତେ ଗୋ ହେଲେ ବିନୟୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୋଲେ ବେଣୁଧର ପରା ଗୋ",
          "ସେ ତୁମ୍ଭ ହୃଦୟହାରା ଗୋ",
          "କି ଦୋଷେ ତେଜିଣ ମଥୁରା ରହିଲେ ଯାଇ"
        ]
      }
    ]
  },
  "sources": [
