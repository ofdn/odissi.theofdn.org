{
  "id": "oa-gita-001132",
  "name": {
    "en": "Tote kahila pari mote charama kari",
    "or": "ତୋତେ କହିଲା ପରି ମୋତେ ଚରମ କରି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tote-kahila-pari-mote-charama-kari-gopalakrusna-kirabani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତୋତେ କହିଲା ପରି ମୋତେ ଚରମ କରି",
          "ମରମ ବିଦାରି ପକାଇଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାଟ ପାଶୋରିଲୁ ପରା ଯେ ଅଇଲୁ",
          "କେତେ ଦିନକୁ ଦୟା ହୋଇଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରାଇଛି ବ୍ରତ ଆଜ ପୁରୋହିତ",
          "ପୁରୁଷକୁ ଅନାନା ବୋଇଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁ ଭାଷନ୍ତେ ଧୀରେ କଥା ହେଲେ ଥରେ",
          "ନିଷେଧି ମଥା ତ କମ୍ପାଇଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋହନଙ୍କୁ ଚାହିଁ ଚାହିଁବି ତ ନାହିଁ",
          "ତୋ ମୁଖେ ଯାଆନ୍ତୁ ବୋଇଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୁଶଳ କି ମିତ ତୁମ୍ଭର ଯାବନ୍ତ",
          "ସଂଖୁଳିଲା ଆଗହୁଁ ଛଇଳା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ସେ ବାଣୀ ଶୁଣି ଭାଷେ",
          "ଆପଣ ରୀତିକି ଯୋଗାଇଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
