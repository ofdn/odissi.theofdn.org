{
  "id": "oa-gita-000651",
  "name": {
    "en": "Nanda suta chhandare kali",
    "or": "ନନ୍ଦସୁତ ଛନ୍ଦରେ କାଲି"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000144"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-suta-chhandare-kali-lalita-kedara-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନନ୍ଦସୁତ ଛନ୍ଦରେ କାଲି",
          "କି ଯୋଗରେ ସଖୀ ମୁଁ ପଡ଼ି ଗଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏକା ହୋଇ ଗଲି ଯମୁନା",
          "କେଳି ନୀପ ମୂଳରେ କହ୍ନା",
          "ଉଭା ହୋଇଥିଲା ଶୋଭା ଚାହିଁ ଭଲା",
          "ଲୋଭା ହୋଇ ଧୈର୍ଯ୍ୟ ହଜାଇ ଦେଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତାର ବଂଶୀ ସ୍ୱନକୁ ଶୁଣି",
          "ନ ଚଳିଲା ମୋ ପାଦ ପାଣି",
          "ଲଭିଲି ବିଷାଦ ମନେ ହେଲା ଖେଦ",
          "ବିବେକ ହରାଇ ଦେଇ ବସିଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେତେବେଳେ ମୋହନ ବଂଶୀ",
          "-ଧାରୀ ମୋହ ପଛରୁ ଆସି",
          "ବେନି କରେ ମୋର ବେନି ଚକ୍ଷୁ ବୁଜି",
          "ନ ଛାଡ଼ିଲେ ଯେତେ ବିନୟୀ ହେଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୋଇଲେ ତୁ ନିୟମ କର",
          "ମୁଁ ତୋ ହୋଇଥିବି ଚାକର",
          "ତେବେ ନୟନରୁ ଛାଡ଼ିଦେବି କର",
          "ବେଣୁଧର ବୋଲେ ସମ୍ମତ କଲି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-suta-chhandare-kali-lalita-kedara-benudhara/"
    }
  ],
