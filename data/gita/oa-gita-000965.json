{
  "id": "oa-gita-000965",
  "name": {
    "en": "Thila kahin he syama",
    "or": "ଥିଲ କାହିଁ ହେ ଶ୍ୟାମ"
  },
  "composer": "oa-person-000083",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/thila-kahin-he-syama-narayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଥିଲ କାହିଁ ହେ ଶ୍ୟାମ ଥିଲ କାହିଁ",
          "ତୁମ୍ଭ ପରି ଆଉ ଜଣେ ଦେଖା ନାହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାଳିଣ ଜାଗର ହୋଇ ଉଜାଗର",
          "ବସି ଚାହିଁ ଚାହିଁ ନିଶି ଗଲା ପାହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କହ ହେ ମୋହନ ଏ କାହା ବସନ",
          "ପିନ୍ଧିଅଛ ତୁମ୍ଭ ମୁଖେ ଲାଜ ନାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହେ ଲବଣୀଚୋରା ଏହି ମୁଖେ ପରା",
          "କହିଥିଲ ମୁଁ ଆସିବି ଦେହ ଛୁଇଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନ ରହି ନିମିଷେ ଯାଅ ତାର ପାଶେ",
          "ନାରାୟଣ ଭାଷେ ଯୁଗ୍ମ ପଦ ଧ୍ୟାୟି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/thila-kahin-he-syama-narayana/"
    }
  ],
