{
  "id": "oa-gita-000550",
  "name": {
    "en": "Re murali kede daruna pana",
    "or": "ରେ ମୁରଲୀ କେଡ଼େ ଦାରୁଣ ପଣ"
  },
  "composer": "oa-person-000033",
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/re-murali-kede-daruna-pana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରେ ମୁରଲୀ",
          "କେଡ଼େ ଦାରୁଣ ପଣ ତୁ କଲୁ ଭାଳି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପତି ସୁତ କୋଳରୁ ଅନ୍ତର",
          "କରାଇ ଆଣିଲୁ ଏ ବନ ଘୋର",
          "ଏ ଜାତି ନିଷ୍ଠୁର ନିର୍ଦ୍ଦୟା ଯା କଲୁ",
          "ଧିକ ଧିକ ହେଉ ତୋର ଶରୀର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାତି କୁଳ ଆମ୍ଭର ତୁହି ନେଇ",
          "ମରମକୁ କିମ୍ପା ଅଛୁ ଦହି",
          "ଗୋପାଙ୍ଗନାର ନିଃଶ୍ୱାସେ ଅବଶ୍ୟ",
          "ନାଶ ହୋଇବୁ ସତେ ଥିଲେ ବିହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସହଜେ ତ ବାଂଶ ଜାତ ତୋର",
          "କଣ୍ଟକାଦି ବହୁତ ୟେ ଅଙ୍ଗର",
          "ଅଦ୍ଧ ବରାଟିକା ମୂଲ୍ୟ ନୋହିବୁ ତୁ",
          "କିମ୍ପା ବହିଅଛୁ ୟେ ନାଗର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାଳ ସର୍ପର ଯେତେକ ଗୁଣ",
          "ଧରି ଅଛି ତୋ ହୃଦୟ ଜାଣ",
          "ନୋହିଲେ କିମ୍ପାଇଁ ୟେ ଅବଳା କୁଳ",
          "କରମେ ଘାରନ୍ତା ତୋର ସ୍ୱନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସାଜି କରି ତୋତେ ଏ ମୋହନ",
          "କହିଥିଲେ ଯେତେକ କଥାମାନ",
          "ବାରେ ହେଲେ ନ କହିଲୁ ତୁ ଶ୍ୟାମେ",
          "ଅବଶ୍ୟ ହେବୁ ତୁରେ ଉଚ୍ଛନ୍ନ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କେ ବୋଲେ ନୀରସଠାରୁ ଜାତ",
          "ନିରାଶ ହୃଦୟେ ବହିଛି ତ",
          "ନିରାଶ କରି କହିବାର କିମ୍ପାଇଁ",
          "ନୋହିବ ୟେ ପାପିଷ୍ଠ ଚିତ୍ତ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ନିର୍ଲ୍ଲଜ୍ଜ ସ୍ୱଭାବ ନୋହିଥିଲେ",
          "ଡାକନ୍ତା କିମ୍ପା ୟେ ରାତ୍ରି କାଳେ",
          "ଛିଦ୍ର ରନ୍ଧ୍ରେ ପରିପୂର୍ଣ୍ଣ ହୁଏ ଯେ ତନୁ",
          "ଛିଦ୍ର ଲାଗେ ୟେ ଆମ୍ଭର କୁଳେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କେବେ ହେଲେ ଏ ଦିନେ ପଡ଼ିଲେ",
          "ବୁଡ଼ାଇବା ନିଶ୍ଚେ ଯମୁନା ଜଳେ",
          "ବିରହ ବିକଳେ ବଂଶୀନିନ୍ଦା ଗୋପୀ",
          "ବ୍ୟାଜେ ହନୁମାନ ଦାସ ବୋଲେ"
        ]
      }
    ]
  },
