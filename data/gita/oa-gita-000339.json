{
  "id": "oa-gita-000339",
  "name": {
    "en": "Ghenai kahile jete",
    "or": "ଘେନାଇ କହିଲେ ଯେତେ"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ghenai-kahile-jete/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘେନାଇ କହିଲେ ଯେତେ",
          "ଘେନିବି କି ମୁଁ ଚିତ୍ତେ",
          "ନିତି ଏହି ପରି ହେଲେ ସହିବି ମୁଁ ଦାଉ କେତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଗାରୁ ଆଣି ମୋତେ",
          "ଜଗାଇ କୁଞ୍ଜେ ନିଶାନ୍ତେ",
          "ଭଗାରି ହସାଇ ସେହି ଦଗା କରିଅଛି ଯେତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲେଖ ତା ଦେଖି ନିରତେ",
          "ଦେଖା କରିବାରୁ ସତେ",
          "ସୁଖକୁ ଲଭିବା ଥାଉ ଦୁଃଖେ ପଡ଼ିଲି ସନ୍ତତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେଉଁ କାମିନୀ ସଙ୍ଗତେ",
          "ନେଉ ଯାମିନୀକି ରତେ",
          "ଥାଉ କହିବାର ଆସ ଶ୍ରୀମୁଖ ଦେଖାଇ ପ୍ରତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଦ୍ମନାଭ ଦେବ ଗୀତେ",
          "ଭାଷନ୍ତି ରାଧା ସୁଚିତ୍ତେ",
          "ଆସିଛନ୍ତି ଶ୍ୟାମ ଚାହାଁ କୃପା କଟାକ୍ଷେ କିଞ୍ଚିତେ"
        ]
      }
    ]
  },
  "sources": [
