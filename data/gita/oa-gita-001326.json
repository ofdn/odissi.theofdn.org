    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣ ସଙ୍ଗିନୀ ମୋ ଗୁଣମଣି",
          "ନ ସରଇ ଗୁଣ ଗୁଣି ରେ",
          "ମୋ ହୃଦଶୋଭିନୀ ଆନନ୍ଦ ଦାୟିନୀ",
          "ଦୁଃଖନିଶି ନିଶାମଣି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋ ନୟନାନନ୍ଦ ରମ୍ୟ ଅରବିନ୍ଦ",
          "ଗୃହ ସରଣୀ ଶୋଭିନୀ ରେ",
          "ରମଣୀ ନନ୍ଦନକାନନ ସୁମନ",
          "ପାରିଜାତ ସମ ଗଣି ରେ",
          "ତୋ ବିନେ ସଂସାର ଦିଶେ ଛାରଖାର",
          "ଜୀବନ ଅସାର ମଣି ରେ"
        ]
      }
    ]
  },
