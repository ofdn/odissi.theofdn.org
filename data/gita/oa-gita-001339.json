  "id": "oa-gita-001339",
  "name": {
    "en": "Kaha sahi kahin pain mohana",
    "or": "କହ ସହି କାହିଁ ପାଇଁ ମୋହନ"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000158"
  ],
  "mula_tala": [
    "oa-tala-000005"
