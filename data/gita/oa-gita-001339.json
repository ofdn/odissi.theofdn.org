  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-sahi-kahin-pain-mohana-ghantaraba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ ସହି କାହିଁ ପାଇଁ ମୋହନ ନଇଲେ ଗୋ",
          "ପ୍ରହରୁ ଚଳିଲା ନିଶି କାହିଁ ସେ ରହିଲେ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦହଇ ବିରହାନଳ କେତେ ହେବି କଲବଲ",
          "ସହିବି କେମନ୍ତେ ଏହା ସେ ଭେଟ ନୋହିଲେ ଗୋ ।",
          "(ପଡ଼ି)",
          "ସ୍ନେହରେ ଭୁଲାଇ କେହି ଗୋ",
          "ରଖିଲେ କି ଅଟକାଇ ଗୋ ?",
          "ଦେହ ତ ମୋ ସହୁ ନାହିଁ ଗୋ",
          "କି ଦଣ୍ଡ ମୋହନ ବିହିଲେ ଗୋ"
        ]
      }
    ]
  },
