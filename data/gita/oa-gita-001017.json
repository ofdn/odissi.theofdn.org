  "id": "oa-gita-001017",
  "name": {
    "en": "Asibe mote tosibe sate",
    "or": "ଆସିବେ ମତେ ତୋଷିବେ ସତେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000017"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asibe-mote-tosibe-sate-ahari-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସିବେ ମତେ ତୋଷିବେ ସତେ କି କାନ୍ତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିଶି ରସି ମୋଦେ ମିଶି ମୋର ହୃଦେ",
          "ହସି ହସି ପଦେ ଭାଷିବେ ସାନନ୍ଦେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାମ ଫୁଲଶରେ ବାମ ହୋଇ ମୋରେ",
          "ଯାମ ଯାମକରେ ଝାମ ଦେଉଛି ବାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏ ମଧୁକାଳରେ ପ୍ରେମରେ ଭୋଳରେ",
          "ମୋହନ ମୋହିବାରେ ଶ୍ୟାମବନ୍ଧୁ ଥରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାବି ରଘୁନାଥ କବି ନିଶାନାଥ",
          "ଏ ବିଧି ରଚିତ ଅବିଳମ୍ବେ ସେ ତ"
        ]
      }
    ]
  },
  "sources": [
