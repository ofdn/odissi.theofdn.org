{
  "id": "oa-gita-000567",
  "name": {
    "en": "Braja banaku mana ja chali re",
    "or": "ବ୍ରଜ ବନକୁ ମନ ଯା ଚାଲିରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/braja-banaku-mana-ja-chali-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବ୍ରଜ ବନକୁ ମନ ଯା ଚାଲିରେ",
          "ଜୟ ରାଧେ କୃଷ୍ଣ ବୋଲିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭାଳନା ଏଥିରେ କିଛି ନାହିଁ ସୁଖ",
          "ମୁରୁଖ ସବୁଟି ଦୁଃଖରେ",
          "ନିଭୃତ କୁଞ୍ଜରେ ବିଜେ କରିଛନ୍ତି",
          "ରହି ଦେଖ ଚନ୍ଦ୍ର ମୁଖରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚିନ୍ମୟ ଚିଦ୍‌ଘନ ରସମୟ କୃଷ୍ଣ",
          "ଆନନ୍ଦରୂପିଣୀ ରାଧା",
          "ସଖୀ ମଞ୍ଜରୀଙ୍କ ସଙ୍ଗତେ ରହିବୁ",
          "ନାଶିବେ ସକଳ ବାଧାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିଶାନ୍ତରୁ ରାସାବସାନ ପର୍ଯ୍ୟନ୍ତେ",
          "ସେବାରେ ଥିବୁ ସନ୍ତତରେ",
          "ନିଷ୍କାମ ହୋଇଣ ସାଧୁଜନେ ପୁଣ",
          "ରହିଣ ଭାଳ ତୁ ଅନ୍ତରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ଗୁରୁଦତ୍ତ ବୀଜମନ୍ତ୍ର ଆଧାର",
          "କରିଣ ହୃଦରେ ରଖରେ",
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷଇ ସେ ଯୁଗଳ",
          "ରସକୁ ଭାବି ତୁ ସୁଖରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
