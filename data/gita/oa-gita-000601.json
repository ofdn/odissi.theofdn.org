{
  "id": "oa-gita-000601",
  "name": {
    "en": "Radhe ananga ranga ranaku",
    "or": "ରାଧେ ଅନଙ୍ଗ ରଙ୍ଗ ରଣକୁ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000051"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhe-ananga-ranga-ranaku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧେ ଅନଙ୍ଗ ରଙ୍ଗ ରଣକୁ ଆଜ ସାଜରେ",
          "ରାଜବଦନ ମୋଜ ସଖୀ ସମାଜରେ",
          "ମନୁ ଲାଜ ତେଜ ହାଜର କରି",
          "ତାଜ ଧରି ବିରାଜ ଆଜରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଞ୍ଜୁଳତର କୁଞ୍ଜନିଳୟ ମଣ୍ଡ ଆଦରେ",
          "କଞ୍ଜ କୁସୁମ ଗଞ୍ଜନ କମନୀୟ ପାଦରେ",
          "ଅଞ୍ଜନ ରୁଚିପୁଞ୍ଜ ବିହଦ ପଞ୍ଜରନିଭ",
          "କୁଞ୍ଜରେନ୍ଦ୍ର ରଞ୍ଜନଗୁଣ ଗର୍ବିତ ମତ ନିର୍ବିବାଦରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁନ୍ଦ ସଦୃଶ ସୁନ୍ଦରତର ମନ୍ଦହାସିରେ",
          "ଶ୍ରୀଚନ୍ଦନ ଘନସାର ସକଳ ବୃନ୍ଦା ବାସରେ",
          "ନନ୍ଦନିଳୟ ଚନ୍ଦ୍ରମୁଖ ପସନ୍ଦ ସୁଅରବିନ୍ଦ",
          "ସୂନ ନିର୍ଗତ ମକରନ୍ଦର ହୁଅ ଯା ପିପାସୀ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଞ୍ଚ ସୁଦନ୍ତି ରଞ୍ଜନ ନିଶୀ ରଚ ଖେଳରେ",
          "ଆକୁଞ୍ଚିତ ଭୂରୁଭଙ୍ଗୀଜିତ ବିରଚ କୁଳରେ",
          "ଚଞ୍ଚଳ ନୟନାଞ୍ଚଳ ମିଶା ସଞ୍ଚିତ ମଦ ଚଞ୍ଚରୀକ",
          "ସଞ୍ଚରୁ ନବ କାଞ୍ଚନନିଭ ଚାରୁ ଚେଳରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶାନ୍ତ ରସ ପିଚିଣ୍ଡିଳ ମତି ମନ୍ତ୍ରପାଳିରେ",
          "ସୀମନ୍ତ ମଣି ସୁକୁନ୍ତଳ ମତି ତୁଟି ଆଳିରେ",
          "ଦନ୍ତକ ତୃଣବନ୍ତ କରୁ ନିରନ୍ତର ସେ ଦୁରନ୍ତ",
          "କାମକୁନ୍ତ ସଦୃଶ ପାଣିରୁହ ନିତାନ୍ତ କେଳିରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବାରଣଗତି ହାରରେ କୁଚଭାର ମଣ୍ଡରେ",
          "ନିକାଲ ମୁଦିରବାରତନୁରୁ ମାର ଦଣ୍ଡରେ",
          "ଆରକତ ସୁସାରସ ବାର ବାର ବିଜୟୀ ସାରପଦ",
          "ଦ୍ୱନ୍ଦ୍ୱକୁ ଦ୍ରବି ବନ୍ଦଇ କବି ମାରତଣ୍ଡରେ"
        ]
      }
    ]
  },
