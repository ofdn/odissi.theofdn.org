{
  "id": "oa-gita-000739",
  "name": {
    "en": "Ekakini naba bala",
    "or": "ଏକାକିନୀ ନବ ବାଳା"
  },
  "composer": "oa-person-000122",
  "mula_raga": [
    "oa-raga-000050"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ekakini-naba-bala-saranga-jagannatha-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏକାକିନୀ ନବ ବାଳା",
          "ମୁଁ କେହି ସହିବି ସ୍ମର ଜ୍ୱାଳା",
          "ଆହା ଏ କାଳରେ ନବକିଶୋର ମୋରେ",
          "କି ବିଚାରି କଲେ ହେଳା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁସୁମ ଶେଯ ସଜାଇ",
          "କୁଞ୍ଜେ ବସିଛି ପଥକୁ ଚାହିଁ",
          "ଭଲା ମୋ ରମଣୀ ପ୍ରେମ ରସେ କିଣି",
          "ରଖିଲା ମୋ କାନ୍ତ ମୋହି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାନା ଭୂଷଣ ମଣ୍ଡି ଅଙ୍ଗେ",
          "ନିଶି ବଞ୍ଚିଲି ରସ ପ୍ରସଙ୍ଗେ",
          "ପାଞ୍ଚିଥିଲି ଚିତ୍ତେ ବିହରିବି ସତେ",
          "ସେ ଚତୁରବର ସଙ୍ଗେ ମୁଁ ରଙ୍ଗେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଧରି କରେ ଫୁଲ ଧନୁ",
          "ଶର ଯୋଖି ବିନ୍ଧଇ ଅତନୁ",
          "ହୃଦୟର ହାର ହେଲା ଅତି ଭାର",
          "ସେ ନାଗବରବର ବିନୁ ସୁତନୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀମତୀ ବିରହ ରୀତି",
          "ଦୂତୀ କହିଲା ମୋହନ କତି",
          "ଶୁଣି ଶ୍ୟାମଘନ କୁଞ୍ଜେ ମିଳି ବହନ",
          "ଶ୍ରୀ ଜଗନ୍ନାଥ ନୃପ କହନ୍ତି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
