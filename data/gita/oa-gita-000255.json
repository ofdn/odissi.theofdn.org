{
  "id": "oa-gita-000255",
  "name": {
    "en": "Mu ta jani jani karichi mana",
    "or": "ମୁଁ ତ ଜାଣି ଜାଣି କରିଛି ମାନ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mu-ta-jani-jani-karichi-mana-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୁଁ ତ ଜାଣି ଜାଣି କରିଛି ମାନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହାକୁ ବୋଲିବି କିସ ମୋହରି କରମ ଦୋଷ",
          "ସ୍ୱହସ୍ତେ କରିଛି ବିଷପାନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଛି ତ ସତେ ଏ ଯୋଗ ଆନ କେ କରିବ ଭୋଗ",
          "ଲୁହ ପୋଛି ହୋଇବାକୁ ଗ୍ଳାନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆହା ହାତ ଧରି ମୋତେ ଏହି ରୁଷା ଲାଗି କେତେ",
          "ଦେଇଥିଲେ ନ ପାଳିଲି ଆନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବ୍ରଜବିଧୁ ଦୁଃଖ ଦେଖି ହୋଇବି ବୋଲି ତ ସୁଖୀ",
          "ଆନକୁ ବଢ଼ାଇଦେଲେ କାନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ଆଣିଲେନି ଲେଉଟାଇ",
          "ସଜନୀ କର ସେହି ଗୁମାନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
