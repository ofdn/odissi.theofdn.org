{
  "id": "oa-gita-001290",
  "name": {
    "en": "Asa tu khare priya sakhi re",
    "or": "ଆସ ତୁ ଖରେ ପ୍ରିୟ ସଖୀ ରେ"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000187"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asa-tu-khare-priya-sakhi-re-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସ ତୁ ଖରେ ପ୍ରିୟ ସଖୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଭିନବ ବୟସୀ ସଙ୍କେତ କାଳ ଆସି",
          "ବଳିଲାନି କରୁ ବିଳମ୍ବ କାହିଁକି ଏର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏକା ହୋଇ ମୋହନ ତୋ ଦିଗରେ ନୟନ",
          "ଦେଇ ରହିଥିବେ କେଳି କୁଞ୍ଜଦୁଆରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋର ଶ୍ରୀଅଙ୍ଗ ଝଳି କ୍ଷଣରୁଚିକି ବଳି",
          "ପ୍ରକାଶେ ଘୋଡ଼ାଇଦିଅ ନୀଳ ଶାଢ଼ୀରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଦୁ ମଣି ମଞ୍ଜୀର ଫେଇଦିଅ ମୋ କର",
          "ଧ୍ୱନି ଯୋଗୁଁ ଜଣା ପଡ଼ିବାଟି ପଥରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାଧା ଯାଇ ହରଷେ ମିଳୁ ସେ କୁଞ୍ଜ ପାଶେ",
          "ଭାଷେ ଶ୍ରୀ କୃଷ୍ଣଙ୍କୁ ରାଜଇନ୍ଦ୍ର ଜୁହାରେ"
        ]
      }
    ]
  },
