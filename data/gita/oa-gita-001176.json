{
  "id": "oa-gita-001176",
  "name": {
    "en": "Mata janani go jauchi bane",
    "or": "ମାତ ଜନନୀ ଗୋ ଯାଉଛି ବନେ"
  },
  "composer": "oa-person-000076",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mata-janani-go-jauchi-bane/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାତ ଜନନୀ ଗୋ ଯାଉଛି ବନେ",
          "ଚଉଦ ବରଷେ ଫେରି ମୁଁ ଆସିବି",
          "ବଞ୍ଚିଥିଲେ ତୋ କଲ୍ୟାଣେ ଜୀବନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରଭାତି ଉଠି ମେବା କେ ଦେବ",
          "ନୀଳମଣି ବୋଲି କିଏ ଡାକିବ",
          "ଆଦର କରି କେ କୋଳେ ବସାଇବ",
          "କେ ମୁଖ ଚୁମ୍ବିବ ତବ ବିହୁନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାଳକ ଅବସ୍ଥା ବଡ଼ କଠିନ",
          "କେତେ ଯତନେ କରିଛି ପାଳନ",
          "ଏକାଳେ ବିଧାତା କରୁଅଛି ଭିନ୍ନ",
          "କୃପା କରିଥିବ ଦାସେ ସୁମନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେବଳ ଦୁଃଖ ରହିଲା ମୋ ମନେ",
          "ସେବା କରିନାହିଁ ଶ୍ରୀପଦେ ଦିନେ",
          "ହୋଇ ପରିତ୍ରାଣ ନାହିଁ ମୋତେ ଦିନେ",
          "କି କହିବେ ମୋତେ ତ୍ରୟ ଭୁବନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନମସ୍କାର କରି ମାତା ପୟରେ",
          "ନମି ସୀତା ଲକ୍ଷ୍ମଣ ସହିତରେ",
          "କୈକେୟୀ ମାତା ଭାଷା କପଟରେ",
          "ଅସ୍ତାଚଳେ ହେରି ଗଲେ ଯେମନେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସଦାନନ୍ଦ ଦାସ ଭାଷେ ଏ ଶୋକେ",
          "ପ୍ରଣମିଲେ ପାଦେ ଅଯୋଧ୍ୟା ଲୋକେ",
          "ଆକୁଳେ ଜପିଲେ ରାମଙ୍କୁ ଥୋକେ",
          "ନ ରହିଲେ ଦଣ୍ଡେ ଆଉ ମଦନେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
