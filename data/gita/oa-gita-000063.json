{
  "id": "oa-gita-000063",
  "name": {
    "en": "Radhamadhaba he adhara",
    "or": "ରାଧାମାଧବ ହେଆଧାର ତୁମ୍ଭେ ତ ମୋତେସାଧାରଣେ ନ ଭଜିଲି ବୋଲିକି ମୋବାଧା ନ ଗଲା କିଞ୍ଚିତେ । ଘୋଷା । ପତିହୀନ କରି ଗତିକି ନ ଦେଲପତିତପାବନ ନାମମତିକି କେହି ନ ଆଣିମେ ଏତିକିଜାଣିଥାଅ ଘନଶ୍ୟାମ । ୧ । ଯେତିକି କହିଲି ଏତିକି ସିନା ମୋକହିବାର ରହୁ ଚିତ୍ତେସତୀକି ଅସତୀ ବୋଲିବା କାଳ ଏମତି ରହୁ ତୁମ୍ଭ ଗୀତେ । ୨ । ରତିୟେ ତୁମ୍ଭ ଶ୍ରୀଚରଣ ସେବା ତକିଛି ନ କରିଛି ମୁହିଁଯତି ପରି […]"
  },
  "composer": "oa-person-000033",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhamadhaba-he-adhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧାମାଧବ ହେ",
          "ଆଧାର ତୁମ୍ଭେ ତ ମୋତେ",
          "ସାଧାରଣେ ନ ଭଜିଲି ବୋଲିକି ମୋ",
          "ବାଧା ନ ଗଲା କିଞ୍ଚିତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପତିହୀନ କରି ଗତିକି ନ ଦେଲ",
          "ପତିତପାବନ ନାମ",
          "ମତିକି କେହି ନ ଆଣିମେ ଏତିକି",
          "ଜାଣିଥାଅ ଘନଶ୍ୟାମ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେତିକି କହିଲି ଏତିକି ସିନା ମୋ",
          "କହିବାର ରହୁ ଚିତ୍ତେ",
          "ସତୀକି ଅସତୀ ବୋଲିବା କାଳ ଏ",
          "ମତି ରହୁ ତୁମ୍ଭ ଗୀତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରତିୟେ ତୁମ୍ଭ ଶ୍ରୀଚରଣ ସେବା ତ",
          "କିଛି ନ କରିଛି ମୁହିଁ",
          "ଯତି ପରି ମାତ୍ର କତିରେ ତୁମ୍ଭର",
          "ବସିବାକୁ ଅଛି ଧାଇଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅତି ପାତକିନୀ ପାମରୀ ମୋ ଦୋଷ",
          "କ୍ଷମା କର ଆହେ ହରି",
          "ସ୍ତୁତିକରି ନିହି କହେ ଧରାକୋଟ",
          "ରାଜନମାତ ଏପରି"
        ]
      }
    ]
  },
  "sources": [
