{
  "id": "oa-gita-001157",
  "name": {
    "en": "Chhada madakhia buddhi he",
    "or": "ଛାଡ଼ ମାଡ଼ଖିଆ ବୁଦ୍ଧି ହେ"
  },
  "composer": "oa-person-000141",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhada-madakhia-buddhi-he-bada-deula-baisnaba-pani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛାଡ଼ ମାଡ଼ଖିଆ ବୁଦ୍ଧି ହେ ବଡ଼ଦେଉଳ ବଡ଼ ଗୋସାଇଁ",
          "ଯେ ମାଇଲା ମାଡ଼ ସେ ହୋଇଲା ବଡ଼",
          "ବଡ଼ ବାଡ଼ ହେଲୁ ତାକୁ ତୁହି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାଡ଼ ଦେଲା ଗୋପେ ଗଉଡ଼ୁଣୀ ରାଧା",
          "ତା ଗୋଡ଼ ଧଇଲୁ ତୁହି",
          "ନନ୍ଦଖୁଡ଼ ଛାଟ ଆଣ୍ଟେ ପିଟିବାରୁ",
          "ଦେଲୁ ବଇକୁଣ୍ଠ ଭୂଇଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାମୁଡ଼ିଲା କାଳୀ ପାଦେ ବନମାଳୀ",
          "କାଳିନ୍ଦୀ ହ୍ରଦରେ ଥୋଇ",
          "କଠାଉର ଚିହ୍ନ ତା ଶିରେ ମୋହନ",
          "ନେଲା କୀର୍ତ୍ତି ଅଛି ରହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଉଗ୍ରପଣେ ଉଗ୍ରସେନ ଓଗାଳିଲା",
          "ଲହୁଡ଼ି କରେ ଉଞ୍ଚାଇ",
          "ତାର ଶିରେ ପାଟ ଦେଲୁ ନନ୍ଦଚାଟ",
          "କରିଣ ମଥୁରା ସାଇଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପାଣ୍ଡବଙ୍କ ପାଇଁ ପଡ଼ା ମାଗି ମାଡ଼",
          "ଖାଇ କଲୁ ରଣଜୟୀ",
          "ପାଦ ପ୍ରତାରନ୍ତେ ଶ୍ରୀବତ୍ସ ବ୍ରାହ୍ମଣ",
          "ତା ନାମକୁ ଅଛୁ ବହି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମାଡ଼ୁଆ ମୋହନ ମାଡ଼ ବିନୁ ଆନ",
          "ଯୋଗ ତୋ କରମେ କାହିଁ",
          "ବଇଷ୍ଣବ ଉକ୍ତି କଡ଼ିଆ ଧରିଛି",
          "କରେ ଲଗାଇବା ପାଇଁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhada-madakhia-buddhi-he-bada-deula-baisnaba-pani/"
    }
  ],
