{
  "id": "oa-gita-001032",
  "name": {
    "en": "Ali parama sukhare",
    "or": "ଅଳି ପରମ ସୁଖରେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ali-parama-sukhare-kamodi-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଭ୍ରମର ନିନ୍ଦା",
          "ଅଳି ପରମ ସୁଖରେ ନଳିନ ପୂର୍ଣ୍ଣ କାସାରେ",
          "ମିଳି ମନ ଆନନ୍ଦରେ କେଳି କର ଅତ୍ୟନ୍ତରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେତେ କରୁଛୁ ଝଙ୍କାର ମତେ କରି ଅହଙ୍କାର",
          "ଏତେ ସରି ହେଲେ ତୋର ଚିତ୍ତେ କିଛି ନୋହେ ଥିର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାନବତୀଙ୍କର ଚିତ୍ତ ଗାନରେ କରୁ ବ୍ୟଥିତ",
          "ଅନବରତରେ ଧୂର୍ତ୍ତ ତୁ ନ କର ସନ୍ତାପିତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହେ କବି ନିଶାନାଥ ଗୁଣି ଶ୍ରୀ କୃଷ୍ଣଚରିତ",
          "ରହେ ଶ୍ରୀ କିଶୋରୀ ପୁଣି ରୋଷେ କହେ ଏ ଭାଷିତ"
        ]
      }
    ]
  },
  "sources": [
