{
  "id": "oa-gita-000979",
  "name": {
    "en": "Narama hoile garama hoibu",
    "or": "ନରମ ହୋଇଲେ ଗରମ ହୋଇବୁ"
  },
  "composer": "oa-person-000132",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/narama-hoile-garama-hoibu-mohana-gosain/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନରମ ହୋଇଲେ ଗରମ ହୋଇବୁ",
          "ଶରମେ ଭରମି ଯିବୁ ନାହିଁ",
          "ପରମ ଆଦରେ ପରଶିଲେ ତୋତେ",
          "ପରସନ୍ନେ ପରଶିବୁ ନାହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମନ୍ଦରଧର ମନ୍ଦ ମଧୁରେ ତୋ",
          "ମଧୁରାଧରେ ଦେଲେ ଚାହିଁ",
          "ତରକି ରହିବୁ ତାର ତୋର ଦିନେ",
          "ଯେପରିକି ଦେଖା ହୋଇ ନାହିଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବରଜଧୂଳିଆ ନୀରଜମାଳିଆ",
          "ସୁନ୍ଦର ତୋ କାଳିଆ କହ୍ନାଇ",
          "ହୁନ୍ଦର ଲଗାଇ ମୁରଲୀ ବାଇଲେ",
          "ଶ୍ରବଣେ ଶୁଣି ଚମକିବୁ ନାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତରତର ହୋଇ ତରଳାକ୍ଷୀ ମୋର",
          "ଯମୁନା ତଟକୁ ନ ଯିବୁ ଧାଇଁ",
          "ପ୍ରଭାତ କୁସୁମେ ଗୁନ୍ଥି ପ୍ରୀତିମାଳା",
          "ଅନୁରାଗେ ଯାଚି ଦେବୁ ନାହିଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କର କରୁଣା ବୋଲି କାତରେ କହିଲେ",
          "ସେ କର ଯୋଡ଼ି ଜଣାଇବୁ ନାହିଁ",
          "ତୋ ବିରହେ ଅଶ୍ରୁ ବହିଲେ ନୟନୁ",
          "ସଜନୀ ତରଳି ଯିବୁ ନାହିଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅତି ଅଧୀରେ ଫେରିଗଲେ ପରାଣ",
          "-ବନ୍ଧୁ ନ ଚାହିଁଲା ପରି ଦେବୁ ଚାହିଁ",
          "ଆଦରେ କହିବୁ ଅଛିଟି କୁଶଳେ",
          "ଆଦରିଣୀ ତବ ଚନ୍ଦ୍ରାସ୍ନେହୀ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କିଏ ସେ ଜାଣିମ ଅପ୍ରାକୃତ ପ୍ରେମ",
          "ରସ ସାଗରେ ଯେ ବୁଡ଼ି ନାହିଁ",
          "ଶ୍ରୀଗୁରୁ ଆଶ୍ରୟ ହେଲେ ହେବ ଲୟ",
          "ଦୀନ ହୀନ ଏ ମୋହନ କହି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/narama-hoile-garama-hoibu-mohana-gosain/"
    }
  ],
