  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-go-tuhi-jaa-go-ahari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ ଗୋ ତୁହି ଯାଅ ଗୋ ସହୀକି ଥରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କହ ସରାଗରେ ରହ ତା ଆଗରେ",
          "କୁହନା ନ କର ମୋହ ବିଷୟରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମନ୍ଦପାଳ ରୁତ ମନ୍ଦ ମନ୍ଦ ରୁତ",
          "ଦ୍ୱନ୍ଦ କରୁଛି ଏବେ ସୁନ୍ଦରୀ ବିରହେ ତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୁଣି ବିନୟ ମୋର ଜାଣି ଦୁଃଖ ନିକର",
          "ଏଣୀ ସୁନୟନାର ପାଣି ଧରି ସତ୍ୱର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହେ ରଘୁନାଥ କବି ନିଶାନାଥ",
          "ମୋହନ ସଖୀକି କହିବା ଚରିତ"
        ]
      }
    ]
  },
  "sources": [
