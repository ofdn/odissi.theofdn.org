{
  "id": "oa-gita-000694",
  "name": {
    "en": "Kahibe sahi syama chhamure",
    "or": "କହିବେ ସହି ଶ୍ୟାମ ଛାମୁରେ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000130"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahibe-sahi-syama-chhamure-kumbha-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହିବେ ସହି ଶ୍ୟାମ ଛାମୁରେ ଯାଇ",
          "କିଞ୍ଚିତ ବିଳମ୍ବ ଦେଖି ସଖୀ",
          "ଆନ ପାଞ୍ଚିଲାନି ବୋଲି",
          "ଆହେ ନବଘନ ସୁନ୍ଦର ଗାତ୍ର",
          "ରାତ୍ର ନୋହୁ ଆଉ ଆସ ଯିବା ବୋଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଞ୍ଜନିଭ ନେତ୍ର ଆସିବା ହେଜି",
          "କୁଞ୍ଜ ମଣ୍ଡପକୁ ଯତନେ ସାଜି",
          "କଞ୍ଜଶର ଶର ତାପକୁ ଭଜି",
          "ସଞ୍ଜବେଳୁଁ ଚାହିଁ ରହିଅଛି ବୋଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦେବକୀ ନନ୍ଦନ ନିଖିଳ ଈଶ",
          "ସେବକୀ ଭାବରେ ହେବାର ବଶ",
          "ହେବକି ମର୍ଦ୍ଦନ ହେବକି ଦୋଷ",
          "କର ଯୋଡ଼ି ସହି ଜଣାଉଛି ବୋଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଙ୍କେଳି କୁଞ୍ଜରେ ମୁରଲୀପାଣି",
          "ଅଙ୍କେ ବସାଇ କହିଥିବା ବାଣୀ",
          "ସଙ୍କେତ ହୋଇଛି ମନେ ତା ଜାଣି",
          "ପଙ୍କେରୁହ ନେତ୍ର ଭୁଲିଲ କି ବୋଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଘନକୁ ଚାତକ ଧ୍ୟାୟିଲା ପରି",
          "ମନ ତୁମ୍ଭ ଠାରେ ଦେଇ କିଶୋରୀ",
          "ଅନୁବ୍ରତେ ଅଛି ପ୍ରେମରେ ପୂରି",
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ବୋଲୁଥିଲା ବୋଲି"
        ]
      }
    ]
  },
