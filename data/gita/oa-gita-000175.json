{
  "id": "oa-gita-000175",
  "name": {
    "en": "Hoithare besa kunjaku jibu para",
    "or": "ହୋଇଥାରେ ବେଶ କୁଞ୍ଜକୁ ଯିବୁ ପରା"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000133"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hoithare-besa-kunjaku-jibu-para/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହୋଇଥାରେ ବେଶ କୁଞ୍ଜକୁ ଯିବୁ ପରା",
          "ଦେଇଛନ୍ତି ସଙ୍କେତ ସେ ମୁରଲୀଧରା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାମ ଚାମରକୁ ଜିଣିବାର କୁନ୍ତଳକୁ ବେଣୀ",
          "ଯତନେ ସଜାଡ଼ି ଖଞ୍ଜି କେତକୀଝରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଞ୍ଜ ଖଞ୍ଜରୀଟ ନେତ୍ରଯୁଗଳେ କରି ରଞ୍ଜିତ",
          "ସ୍ମର କାଣ୍ଡ ମାର୍ଗ ତୁଲ୍ୟ ଅଞ୍ଜନ ଗିରା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଉଚ୍ଚ କୁଚଯୁଗେ ଚିତ୍ର ଲେଖି ମୃଗନାଭି ପତ୍ର",
          "ଉରରେ ଲମ୍ବାଇ ସ୍ଥୂଳ ମୁକୁତାହାରା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭଜ ଆଜ ଶ୍ୟାମ ପାଶେ ପିନ୍ଧି ନୀଳଚେଳ ତୋଷେ",
          "ପ୍ରତି ଅଙ୍ଗ ଆଭରଣରେ କରି ତୋରା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୌରହରି ଭାଷେ ଗୀତେ ଦୂତୀ ବୋଇଲେ ସୁରତେ",
          "କାନ୍ତ ସଙ୍ଗରେ ମଜ୍ଜିବୁ ନାଗରୀହୀରା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
