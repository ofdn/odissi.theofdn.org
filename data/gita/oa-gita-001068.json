{
  "id": "oa-gita-001068",
  "name": {
    "en": "Khanjana nayani chahan",
    "or": "ଖଞ୍ଜନ ନୟନୀ ଚାହାଁ"
  },
  "composer": "oa-person-000139",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/khanjana-nayani-chahan-sankarabharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନ ତେଜ ସୁନାଗୋରୀ ସରାଗେ ରମଣୀମଣି",
          "ଖଞ୍ଜନ ନୟନୀ ଚାହାଁ",
          "ଦଣ୍ଡନା ଆଉ ମହୀମଣ୍ଡନା ରେ ସୁମତି",
          "ମଣ୍ଡ ତୁଣ୍ଡେ ମଧୁ ହାସ ସୁରସବତୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଣ୍ଠୀରବ ମଧ୍ୟମା ରାମାରତନ ବାମା",
          "ଗଣ୍ଠିଧନ ମୋ ସୁଷମାନନୀ କର କ୍ଷମା",
          "(ପଡ଼ି)",
          "ନାଶ ମୋ ମନୁ ପରାଶ ଅତନୁ ତନୁ",
          "କାଶବିଜିତ ମୃଦୁହାସ ପୀରତି ଧନୁ",
          "ନିନ୍ଦି ଇନ୍ଦୁ ଗୁରୁବାଣୀ ଶଶୀବଦନୀ",
          "ବିତରି ତୁରିତେ ପୁରତେ ପରତେ ଜବାଧରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁସୁମଚାପ ଜିଣି ଠାଣି ତ୍ରିଭଙ୍ଗ ଆଣି",
          "ତେଜି ମରୁତସୁତ ସଘନେ ବାମ ପାଣି",
          "(ପଡ଼ି)",
          "ଆଣି ଏଣୀନୟନା ଜାଣି ହରବଦନା",
          "ବାଣୀ ପାଣି ପରମାଣି ସୁରସଦନା",
          "ରାଣୀ ରମଣୀମଣି କୁଳକୁଳରଦନା",
          "ପରତେ ଅରତେ ସୁରତେ ପରତେ ରସବତୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଳକଣ୍ଠ ନିନାଦେ ସଜାଇ ତୁ ପାଦେ",
          "ସଜାଇ କବରୀ ହଜାଇ ଚେତନା ମଖି",
          "(ପଡ଼ି)",
          "ଶାନ୍ତିପ୍ରଦାନ ହରଭ୍ରାନ୍ତିରେ ଜରଜର",
          "କାନ୍ତି ଛବିରେ ନଖ ଶାନ୍ତି ପୁରନ୍ଦର",
          "ରମଣୀ ନିନ୍ଦି ସୁଖ ଇନ୍ଦି ଇନ୍ଦୀବର",
          "ବଦନ ସଦନ ରଦନା ବଦନା ରେ ସୁମନା"
        ]
      }
    ]
  },
  "sources": [
