{
  "id": "oa-gita-001281",
  "name": {
    "en": "Ebe gumane mukha modu kahinki",
    "or": "ଏବେ ଗୁମାନେ ମୁଖ ମୋଡ଼ୁ କାହିଁକି"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000165"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ebe-gumane-mukha-modu-kahinki-todi-punnaga-gourachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏବେ ଗୁମାନେ ମୁଖ ମୋଡ଼ୁ କାହିଁକି",
          "କେ ତୋତେ ବ୍ରଜେ ଜାଣି ନାହିଁକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶୁଣି ପ୍ରସଙ୍ଗ ତାର ହୋଇ ଅତି କାତର",
          "ଲୋଡ଼ୁଥାଉ ବଂଶୀପାଣିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯମୁନା ଯିବା ବେଳେ ଦେଖି ତା ରୂପ ଡୋଳେ",
          "ଭ୍ରମିବାର ଗଲା କେଣିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କହିଲେ କେତେ ଥର ନ ଘେନୁ ମୋର ଗୀର",
          "ସତେ ଧରିବୁକି ଧୃତିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାହାର ବଂଶୀସ୍ୱନ ତ୍ରିଭୁବନ ମୋହନ",
          "ଶୁଣି ନ ଯିବୁକି କତିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୌରଚନ୍ଦ୍ର ଭୂପତି ବୋଲେ ଆଜ ଶ୍ରୀମତୀ",
          "କୁଞ୍ଜବନେ କର ଗତିକି"
        ]
      }
    ]
  },
  "sources": [
