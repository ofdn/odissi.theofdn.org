{
  "id": "oa-gita-000138",
  "name": {
    "en": "Chanda sundara mukhi re",
    "or": "ଚାନ୍ଦସୁନ୍ଦରମୁଖୀରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chanda-sundara-mukhi-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାନ୍ଦସୁନ୍ଦରମୁଖୀ ରେ",
          "ବୃନ୍ଦ ବୃନ୍ଦ କନ୍ଦର୍ପଶରମୟସର୍ପ",
          "ସର୍ପ ନ ଦିଏ ମୋ ଦର୍ପ ରଖି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରସାଇ ସାରସଦୃସା ଲସା ମୋ ଦୁର୍ଦ୍ଦଶାରେ",
          "ଦଶାରେ ତୋ ଲାଭ ମୋ ଭରସା ରସାଳସା ରେ",
          "(ପଡ଼ି)",
          "ନିଶାରମଣକର ବିଶାଳ ମଦହର",
          "ହସା ବିଭବଭର ମିଶା ମଧୁରତର",
          "ପ୍ରସାଦ ପରିହର ରୁଷାରୁତ ନ କର",
          "ତୃଷା ମୋହର ହର କୃଶାନୁବର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଳାହକବିଜୟୀକୁନ୍ତଳା ଲୀଳାବତୀ ରେ",
          "ଝଳାଅ କୁଞ୍ଜରକୁମ୍ଭସ୍ଥଳାକୃତି ଛାତିରେ",
          "(ପଡ଼ି)",
          "ଗଳା ନବରତନ କଳାପ ଅନୁଦିନ",
          "ଚଳାଚଳ ନୟନ ଢଳା ରସକୁ ମନ",
          "ବଳାଅ ରେ ମଦନ କଳାନିଧି ବହନ",
          "ବଳାପହକଦନ ପଳାଉ ଧନ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚରାଚରବିଭୂଷଣା ଧରାଧରସ୍ତନା ରେ",
          "ପରାଣ ଅଛି ତୁ ଦେବା କରାରରୁ ସିନା ରେ",
          "(ପଡ଼ି)",
          "ଧରାତଳେ ମୋ ଗତି ପରା ତୁ ଗଜଗତି",
          "ହରାରିଶରେ ନିତି ମରାଇ ଅକୀରତି",
          "ପରାଗରେ ଜଗତି କରାଉଛୁ ଭରତି",
          "ଅରାଳ ଭୂରୁତତି ଝରା ସୁଦତି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହେ ଅଷ୍ଟଦୁର୍ଗନାଥ ସ୍ନେହେ ତୁ ଅଧୀନା ରେ",
          "ଅହେତୁକ ରୋଷ ଛାଡ଼ ମହେଶମୋହନା ରେ",
          "(ପଡ଼ି)",
          "ବହେ ଅନବରତ ଦହେ ମୃଦୁ ମରୁତ",
          "ସହେମ ମରକତ ଗୃହେ ହୋଇ ମିଳିତ",
          "ତୁ ହେବୁ ରସ ରତ ଦୁହେଁ ହେବା ସଙ୍ଗତ",
          "ମୁଁ ହେବି ମହୀଗତ ମହେନ୍ଦ୍ରବତ ରେ"
        ]
      }
    ]
  },
  "sources": [
