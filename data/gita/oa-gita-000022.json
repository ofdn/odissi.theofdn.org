{
  "id": "oa-gita-000022",
  "name": {
    "en": "Mane na dhara ete antaku go",
    "or": "ମନେ ନ ଧର ଏତେ ଆଣ୍ଟକୁ ଗୋ"
  },
  "composer": "oa-person-000017",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mane-na-dhara-ete-antaku-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନେ ନ ଧର ଏତେ ଆଣ୍ଟକୁ ଗୋ",
          "ଦିନେ ସେ ହୋଇବ ନଅଣ୍ଟକୁ ଗୋ",
          "ଭାଳି ହୋଇବୁ ସିନା ନ ପୂରିବ କାମନା",
          "ବିଚ୍ଛେଦେ ହେବୁ ଛଟପଟକୁ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାନେ ଶୁଣାଇଁ ବଂଶୀ ତୋ ଚିତ୍ତକୁ ଆଶ୍ୱାସି",
          "ଡାକନେବ ଯମୁନାତଟକୁ ଗୋ",
          "ମାନ ମହତ୍ୱ ସାରିଦେବ ପୁଣି ଆହୁରି",
          "ବସାଇବ କଳଙ୍କ ହାଟକୁ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆଳି ସଙ୍ଗେ ପାଣିକି ଗଲେ ପଣନ୍ତ ଝିଙ୍କି",
          "ନେଇ କରିବ କେତେ ହଟକୁ ଗୋ",
          "କହୁଛି ଘେନ ଏତେ ନ କରିବୁ ପରତେ",
          "ସହି ତୁହି ସେ ପୀତପଟକୁ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଖେ ମଧୁର ହାସ ବାଣୀ ଛଣାପୀୟୂଷ",
          "କହି ତୋଷିବ ତୋର ଘଟକୁ ଗୋ",
          "ଦେବ ଗୁମାନ ସାରି ଆରେ ନବକିଶୋରୀ",
          "କେବଳ ଜଗି ଘାଟ ବାଟକୁ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ୟାମସୁନ୍ଦର ନତ ଶିର କରି ନିୟତ",
          "ଜୁହାରୁଛି ତାଙ୍କ କପଟକୁ ଗୋ",
          "ମୁଁ କହିବାର ଥାଉ ଯେବେ ବଳିବ ଦାଉ",
          "ଜାଣିବୁ ତେବେ ନଟକୂଟକୁ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
