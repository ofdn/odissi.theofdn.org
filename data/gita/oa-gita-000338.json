  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-karuthiba-mo-sajani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି କରୁଥିବ ମୋ ସଜନୀ ପ୍ରାଣସଜନୀ",
          "ଏକା ମୋ ବିହୁନେ ନ ସରୁଥିବ ରଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବନ୍ଧୁ ମୋ ବନଜମୁଖୀ ଘୋର ହିମ କାଳ ଦେଖି",
          "ମୋ ବିଚ୍ଛେଦେ ହୋଇ ଦୁଃଖୀ ଯିବନି ଶୁଖି ।",
          "ନ ବିଚାରି ମନକୁ ସେ ସମୟେ ଯାହା ତାକୁ",
          "ଛାଡ଼ି ମୁଁ ଅଇଲି",
          "କାହିଁ ପାଇଁକି ପ୍ରାଣସହୀକି ଶଶୀମୁହୀଁକି ।",
          "ଆଉ ମୋ ବିଚ୍ଛେଦେ ଥିବ ଜୀଇଁ କି"
        ]
      }
    ]
  },
