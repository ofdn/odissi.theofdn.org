{
  "id": "oa-gita-001148",
  "name": {
    "en": "Gopi dei karataliki",
    "or": "ଗୋପୀ ଦେଇ କରତାଳିକି"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000091"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gopi-dei-karataliki-kolahala-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୋପୀ ଦେଇ କରତାଳିକି",
          "ନଚାଇଲେ ବନମାଳୀକି",
          "କରେ ବାଇ ତାଳ ନାଚନ୍ତି ଗୋପାଳ",
          "ଅନାଇ ମନାଇ ବ୍ରଜବାଳୀଙ୍କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେ କରେ ଉକୁଟ ତାନରେ",
          "କେହୁ ରସେ ଗୀତ ଗାନରେ",
          "ବାଜେ କିଣିକିଣି କଟୀର କିଙ୍କିଣୀ",
          "ନାଚିବାର ତାନମାନରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରାମ ନାଚୁଛନ୍ତି ବାଦରେ",
          "କୃଷ୍ଣଙ୍କୁ ଅନାଇ ଆଦରେ",
          "ବାଜେ ଝୁମୁଝୁମୁ ଝୁମୁକି ନୂପୁର",
          "ରୋହିଣୀ ନନ୍ଦନ ପାଦରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀକୃଷ୍ଣ ମୁଖକୁ ଅନାଇଁ",
          "କେଉଁ ଗୋପୀ କହେ ଘେନାଇ",
          "ରାମଙ୍କର ନାଟ ଅଧିକ ହେଲା ତ",
          "ତୁମ୍ଭେ କି ନାଚିଲ କହ୍ନାଇଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପୀମାନେ ଛଳବାଣୀକି",
          "କହିବାର ବେଣୁପାଣିକି",
          "ପାଦ ଛନ୍ଦି ନାଟ କଲେ ନନ୍ଦଚାଟ",
          "ପ୍ରକାଶି ତ୍ରିଭଙ୍ଗ ଠାଣୀକି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କେ ବୋଲେ ରେ ଧନ୍ୟ କାଳିଆ",
          "ଭଲାରେ କାଇଞ୍ଚ ମାଳିଆ",
          "କାହିଁ ରଖିଥିଲୁ ଏ ଭଙ୍ଗୀ ନର୍ତ୍ତନ",
          "ଗୋପସୁତ ସଙ୍ଗ ମେଳିଆ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଯାହା ଶ୍ରୀଚରଣ ଧ୍ୟାନରେ",
          "ବ୍ରହ୍ମା ଶିବ ସାବଧାନରେ",
          "ସେ ପୁଣି ଗୋପରେ ନୃତ୍ୟ କରୁଛନ୍ତି",
          "ଗୋପୀଙ୍କର ଅବଧାନରେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଗଉରଚରଣ ମାନକୁ",
          "ନ କହିବ ଆଉ ଆନକୁ",
          "ଆହେ ଦୀନବନ୍ଧୁ କରୁଣାନିଧାନ",
          "କର ଏହି ଅବଧାନକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
