{
  "id": "oa-gita-000671",
  "name": {
    "en": "Sakhi kahi nuhai",
    "or": "ସଖୀ କହି ନୁହଇଁ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000164"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-kahi-nuhai/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ କହି ନୁହଇଁ ଯେ ଜାଣିଛି ସେ ଜାଣିଛି",
          "କେତେବେଳେ ସେ ସମୟ ମନୁ ନୁହଇଁ ମୂରୁଛି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରଖି ପ୍ରୀତି ପ୍ରତିଆଶ ଧରି ମନୋହର ବେଶ",
          "ଲାଭ ଭୟେ ତୁନି ତୁନି ଚାଲିବାର ବାଟି ବାଛି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଙ୍କେତ ସ୍ଥାନକୁ ଯାଇ ଚଉପାଶକୁ ଅନାଇ",
          "କର୍ଣ୍ଣ ଡେରି ରହିବାର ଭାଳିବାର କେ ଆସୁଛି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦଇବେ ନୋହିଲେ ଭେଟ ଅବା ବଳି ଗଲେ କଣ୍ଟ",
          "ବେଳୁଁ ବେଳ ବଳେ କଷ୍ଟ ଉପାୟ ନ ଦିଶେ କିଛି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଗି ଜଗି ବସିବାର ବାରମ୍ବାର ଉଠିବାର",
          "ନିମିଷକୁ ପାଞ୍ଚିବାର ଯୁଗ ସମ କି ହେଉଛି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୋଲଇ ବୀରବିକ୍ରମ ପର ପୀରତି ବିଷମ",
          "ଚୋର ପରି ଲୁଚିବାର ନୟନେ ମୋ ନାଚୁଅଛି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-kahi-nuhai/"
    }
  ],
