    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣନାଥ ମୋର ବଂଶୀଧାରୀ ଜାଣ",
          "ମୁରଲୀଧାରୀ ଜାଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୁପତେ କଲି ମୁଁ ଇଚ୍ଛା ବରଣ ରେ ସଜନୀ",
          "ରଖି ତ ନ ଦେଲା କାମ ବାଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁରଲୀ ଭାଙ୍ଗିଲା ସବୁ ଗୁମାନ ରେ ସଜନୀ",
          "ମୋ ଦୁଃଖ ଜଣାଇ ତାଙ୍କୁ ଆଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କହେ କବିରବି ବ୍ରହ୍ମା ଈକ୍ଷଣରେ ସଜନୀ",
          "ରାଧାକୃଷ୍ଣ ଚରଣେ ପ୍ରୟାଣ"
        ]
      }
    ]
  },
