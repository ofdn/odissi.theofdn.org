{
  "id": "oa-gita-001443",
  "name": {
    "en": "Radha name mohana benu",
    "or": "ରାଧା ନାମେ ମୋହନ ବେଣୁ"
  },
  "composer": "oa-person-000027",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radha-name-mohana-benu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧା ନାମେ ମୋହନ ବେଣୁ",
          "ବାଜୁଛି ଲୋ ମା ।",
          "ସତେ ପତିବରତ ଦୂର",
          "ହଜୁଛି ଲୋ ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭଲା ସେ ଶ୍ୟାମସୁନ୍ଦର",
          "ଜାଣିଥାଇ କେତେ ହୁନ୍ଦର",
          "କି ଯାତନା ପ୍ରେମସାଗରେ",
          "ମଜ୍ଜୁଛି ଲୋ ମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ମନ୍ତର ଶିଖିଛି କାହୁଁ",
          "ଭୁଲାଏ ଅନାଉଁ ଅନାଉଁ",
          "ନାରୀକୁଳେ କଳଙ୍କ ଆଣି",
          "ଖଞ୍ଜୁଛି ଲୋ ମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଉ ଏ ଯମୁନା ପାଣିକି",
          "ଆସିବା ନୋହୁଁ ଗୋ ଏଣିକି",
          "ବେଣୁଧର ସେ ପାଦ ଯୁଗ",
          "ଭଜୁଛି ଲୋ ମା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
