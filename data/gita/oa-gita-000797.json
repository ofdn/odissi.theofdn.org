  "name": {
    "en": "Manasa ghena hita baniki",
    "or": "ମାନସ ଘେନ ହିତ ବାଣୀକି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manasa-ghena-hita-baniki-punnaga-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନସ ଘେନ ହିତ ବାଣୀକି",
          "ଆନନ୍ଦେ ଭଜ ଶ୍ରୀ ବଂଶୀପାଣିଙ୍କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାନକିନୀ ଗୁରୁଦତ୍ତ ଆଦେଶ",
          "ଆନ ସଙ୍ଗତିକି ଦୂରେ ନିବେଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପାନ କରି ସଦା ଶ୍ରୀନାମାମୃତ",
          "ଗାନ କର ରାଧାକୃଷ୍ଣ ଚରିତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାନଦ ଅମାନୀ ନିରଭିମାନେ",
          "ଧ୍ୟାନରତ ହୁଅ ତୁ ସାବଧାନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାନମାନେ କରତାଳି ବଜାଇ",
          "ବନମାଳୀ ନାଚୁ ଲଜ୍ଜା ହଜାଇ"
        ]
      }
    ]
  },
  "sources": [
