{
  "id": "oa-gita-000353",
  "name": {
    "en": "Bina dose kariachu mana re jibadhana",
    "or": "ବିନା ଦୋଷେ କରିଅଛୁ ମାନ ରେ ଜୀବଧନ"
  },
  "composer": "oa-person-000029",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bina-dose-kariachu-mana-re-jibadhana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୀବଧନ",
          "ବିନା ଦୋଷେ କରିଅଛୁ ମାନ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହିଁକି କରୁଣା ଉଣା । ମୁଁ ତୋହର ଅଟେ କିଣା ।",
          "ଜନ ଧ୍ୟେ ଗଲା ଶୁଣା । ଟଙ୍କଧର ରିପୁ ଜିଣା ।",
          "ମାର ଶରେ ହଜିଗଲା ଜ୍ଞାନ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦିଅ ତୁ ଅଧରୁ ପାନ । ଯାଉ ମୋ ଦୁର୍ଦ୍ଦଶାମାନ ।",
          "ସତ୍ୟ କହୁଅଛି ଘେନ । ତୋର ମଧୁର ବଚନ ।",
          "ନ ଶୁଣିଲେ ଗଲାଟି ଜୀବନ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଜନମ ସୁକୁମାରୀ । କହୁଛି ଚିବୁକ ଧରି ।",
          "ଏବେ ହେଲେ ଦୟା କରି । ପାଶେ ରଖ ଛାଇ ପରି ।",
          "ଏହି ଦଶା ଦେଲାଟି ମଦନ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିମ୍ବାଧରୀ ମଦାଳସୀ । ବସ ମୋ ଅଙ୍କରେ ଆସି ।",
          "ଚୁମ୍ବ ଦିଅ ମନ୍ଦେ ହସି । ମୋ ଗଣ୍ଡରେ ଘନକେଶୀ ।",
          "ଦେଇ ରଖ ମୋତେ ରତିଦାନ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାମଚନ୍ଦ୍ର ଦେବ ଭଣି । ଶୁଣି ସେ ରମଣୀମଣି ।",
          "ମାନସରେ ନେଲେ କିଣି । ମାନ ଶର ଦେଇ ହାଣି ।",
          "କି ଭଙ୍ଗୀରେ ଢାଳି ଚନ୍ଦ୍ରାନନ ରେ"
        ]
      }
    ]
  },
