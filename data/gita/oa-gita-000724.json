{
  "id": "oa-gita-000724",
  "name": {
    "en": "Pranabandhu kara garaba kahinki",
    "or": "ପ୍ରାଣବନ୍ଧୁ କର ଗରବ କାହିଁକି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000035"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pranabandhu-kara-garaba-kahinki-sindhu-kamodi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣବନ୍ଧୁ କର ଗରବ କାହିଁକି ରେ",
          "ପରବ ଚନ୍ଦ୍ରମା ଚିତ୍ତେ",
          "ବଳିଲାନି କି ତୋ ଝଳି ଲାବଣ୍ୟାଦି",
          "ଗୁଣଗଣରୁ କିଞ୍ଚିତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜଳଧିର ପଙ୍କ କି ଅବା କଳଙ୍କ",
          "ଖଣ୍ଡେ ଶିରୀ କରି ଫୁଲେ",
          "ନାହିଁକି ନଜର ରସାଳସା ତୋର",
          "ନେତ୍ର ଇନ୍ଦୀବର ଫୁଲେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋ ସୁଧା ତୁଳରେ ବସୁଧା ତଳରେ",
          "କେ ଅଛି ବୋଲି ଯା ଭାବେ",
          "କର୍ଣ୍ଣେ ନାହିଁ ଶୁଣି ତୋ ମୃଦୁଳ",
          "ବାଣୀବିଳାସକୁ ପରା ଲବେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରିଛି କି ମନେ ଏ ତିନି ଭୁବନେ",
          "ମୁଁ ଏକା ରଜନୀକର",
          "ଫୁଲଶେଯ ରତେ ତୋ ଚରଣ କେତେ",
          "ଲାଗଇ ରଜନିକର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଗତୀରେ ଏକା ମୋହରି ଚନ୍ଦ୍ରିକା",
          "ରୁଚିର ବୋଲି ଯେ ବୋଲେ",
          "କୁନ୍ଦବିକାଶକୁ ନିନ୍ଦିବା ହାସକୁ",
          "ଖେଳାଇ ଦେବୁଟି ଗେଲେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭାବୁଅଛି ଚିତ୍ତେ ଭଜିଛନ୍ତି ମୋତେ",
          "ଅନେକ ନକ୍ଷତ୍ରମାନେ",
          "ଶ୍ରୀହସ୍ତ ଚରଣ କଞ୍ଜ ନଖଗଣ",
          "ଶୋଭା ଚାହିଁ ନାହିଁ ଦିନେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଟେକିଦିଅ ମୁଖ ଏ ଶୀତମୟୂଖ",
          "ଜିତ ହୋଇ ମରୁ ଚଳି",
          "ନିତି ନିଧୁବନେ ଅନେକ ବିଧାନେ",
          "କେତେ ଚନ୍ଦ୍ର ଥାଇ ଚାଳି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଚକୋର ଏହାର ବଡ଼ ପରିଚାର",
          "ତୁ ସେବା ଦେଇଛୁ ମୋତେ",
          "ଅଷ୍ଟଦୁର୍ଗ ଧରାମଣ୍ଡଳୀ ଅମରା",
          "-ବତୀ ପତି ବୋଲେ ଗୀତେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
