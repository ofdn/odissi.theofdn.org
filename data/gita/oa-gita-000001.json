{
  "id": "oa-gita-000001",
  "name": {
    "en": "Kadamba bane bansi bajila re",
    "or": "କଦମ୍ବ ବନେ ବଂଶୀ ବାଜିଲାରେ",
    "alternates": [
      "Kadamba Bane Banshi Bajilare"
    ]
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "song_type": "chaupadi",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kadamba-bane-bansi-bajila-re-gopalakrusna-dhanasri/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କଦମ୍ବ ବନେ ବଂଶୀ ବାଜିଲାରେ",
          "ରାଧା ଦମ୍ଭ ଶିଖରୀ ଭାଜିଲାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୋ ବିନା ପ୍ରତିକାର ଆନ କେ ନାହିଁ ମୋର",
          "ବିବେକ ରତନ ମୋ ହଜିଲାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଢ଼ା ମୋତେ ସରଣୀ ଆରେ ପ୍ରାଣମିତଣୀ",
          "ତୋ ବିନା ଜୀବନ ବରଜିଲାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଖି ବ୍ରଜେନ୍ଦୁ ମୁଖ ଲିଭାଇବିରେ ଦୁଃଖ",
          "ସ୍ମରାନଳରେ ତନୁ ଭାଜିଲାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଳାଇଲାନି ମନ ବେଣୁପତି ଶୋଭନ",
          "ପୀୟୂଷ ବାରିଧିରେ ମଜ୍ଜିଲାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚାଲ ଯିବା ଲଳିତା ବୋଲୁଁ କୀର୍ତ୍ତିଦା ସୁତା",
          "ମୁଖ ସୁବର୍ଣ୍ଣାବ୍ଜ ବିରାଜିଲାରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏକାନ୍ତ ଶ୍ରୀ ଲଳିତା ଶ୍ରୀ ବୃଷଭାନୁ ସୁତା",
          "ଗୋପାଳକୃଷ୍ଣ ରହି ହେଜିଲାରେ"
        ]
      }
    ]
  },
  "note": {
    "en": "Prateek Pattanaik gives the mūḷa tāḷa as Aṭhatāḷi. The Odissi Music page for this song gives Jati."
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kadamba-bane-bansi-bajila-re-gopalakrusna-dhanasri/"
    }
  ],
