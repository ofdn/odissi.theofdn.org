{
  "id": "oa-gita-001077",
  "name": {
    "en": "Nagara mohana rupa mohila",
    "or": "ନାଗର ମୋହନ ରୂପ ମୋହିଲା"
  },
  "composer": "oa-person-000075",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nagara-mohana-rupa-mohila-somanatha-singha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାଗର ମୋହନ ରୂପ ମୋହିଲା ରେ",
          "ମୋହିଲା କ୍ଷଣି ଅତନୁ ଦହିଲା ରେ",
          "ଥରଥର କରି ଦେଲା ଦହି ଝରଝର ନେତ୍ରୁ ନୀର ବହି",
          "ମାର ମାରଣ ତ କହି ନୋହିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଦନେ ରହି ନୁହଇ ଅନୁକ୍ଷଣେ",
          "ଚିତ୍ତ ବିଚଳିତ ହୁଏ ତାହା ଘେନି",
          "ରସେ ରସିବାକୁ ଚିତ୍ତ ହୁଅଇ ଅନବରତ",
          "ନ ରଖେ ଦୂତ ବରତ କି ହେଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦମ୍ଭ ଜୀବ ବିବେକ ପାଶୋରାଇ",
          "ଅଧିକେ ଲୋଭ ଯତନେ ପଲ୍ଲବାଇ",
          "ପାରିବ କେ ଏହା ସହି ସହିଲେ ନ ରହେ ରହି",
          "ଆଉ କାହିଁ ଏ ତ ଦେଖା ନୋହିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିଷମ ହେଲାଣି ଦଶାର ସାଗରେ",
          "ମୋହର ଜ୍ଞାନ ଉଡ଼ୁଛି ସନ୍ତାପରେ",
          "ଥିଲା ଏତେ କାଳେ ଏହା କହିଲେ କମ୍ପୁଛି ହିଆ",
          "ଆନ କେହି ନାହିଁ ସାହା କହିଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପରମାଦ ପୀରତିକି କରେ ଭୀତି",
          "ଏବେ ହେଲାଣି ନିକର ସେହି ଗତି",
          "କି କରିବି କରେ ମୋହ ଥିଲେ କି ଉପାୟ କହ",
          "ଏବେ ବହୁତ ସନ୍ଦେହ ଲାଗିଲା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଜଣାଗଲାଣି ଏଥର ବଞ୍ଚି ନୋହେ",
          "ଜାଣ ବୁଡ଼ିବି ନିଶ୍ଚୟ ତାଙ୍କ ସ୍ନେହେ",
          "ଏଣିକି ନାହିଁ ବିଚାର ମୋହିଲେ ଶ୍ୟାମସୁନ୍ଦର",
          "ସୋମନାଥ ବୀରବର ଭାଷିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nagara-mohana-rupa-mohila-somanatha-singha/"
    }
  ],
