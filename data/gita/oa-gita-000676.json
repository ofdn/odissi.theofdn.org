  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ghana-kale-ghanakesi-surata/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘନ କାଳେ ଘନକେଶୀ",
          "ମୋହ ବିନା କି କରିବ ସଜନୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନଭେ ଘୋଟି ନବଘନ ନିରନ୍ତରେ ତେଜି ବନ",
          "ଲଙ୍ଘି ନଦୀ କୂଳ ମାନ କାମୀ କୁଳ ବୁଡ଼ାଇବ ସଜନୀରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘଡ଼ିଘଡ଼ି ଗରଜନ ଚଞ୍ଚଳା ଚମକ ପୁଣ",
          "ମାନସ କରଇ ଛନ୍ନ ତହିଁ ପୁଣି ଭେକ ରବ ସଜନୀରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଦନ କୋଦଣ୍ଡ ସାଜି ବାଛି ଫୁଲଶର ରାଜି",
          "ମର୍ମ ସ୍ଥାନ ଖୋଜି ଖୋଜି ଅବିରତେ ବିନ୍ଧୁଥିବ ସଜନୀରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ଦେବ ବୋଲେ ଭାବିଲେ କି ହେବ",
          "ସତେ କି କରିବେ ଶିବ ସହି ଶୁଭେ ଭେଟ ହେବ ସଜନୀରେ"
        ]
      }
    ]
  },
