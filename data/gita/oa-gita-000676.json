  "name": {
    "en": "Ghana kale ghanakesi",
    "or": "ଘନ କାଳେ ଘନକେଶୀ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000065"
  ],
  "mula_tala": [
    "oa-tala-000002"
