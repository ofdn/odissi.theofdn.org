  "name": {
    "en": "Khanjarita nayana alape chahan re",
    "or": "ଖଞ୍ଜରୀଟନୟନା ଅଳପେ ଚାହାଁରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/khanjarita-nayana-alape-chahan-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଖଞ୍ଜରୀଟ ନୟନା ଅଳପେ ଚାହାଁରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଞ୍ଜନରୁଚି ମଦଗଞ୍ଜନ କେଶା",
          "କଞ୍ଜସୁନ୍ଦର ମୁଖରଞ୍ଜନ ବେଶା",
          "ସଞ୍ଜ କୁମୁଦ ସମ ହାସବିଳାସା",
          "ତୁ ସିନା ସାହା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦନ୍ତବସନ ରୁଚି ସନ୍ତତ ଚାଖି",
          "ସନ୍ତତ ତବ ତନୁ କାନ୍ତିରେ ଲାଖି",
          "କାହିଁ ଭରସି ରସି ନାହିଁ ମୋ ଆଖି",
          "ତୋହର ବାହାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାରଣବର ଗମନା ରସକାରା",
          "ପରିଚିତ ରଣରଣ ଧରଣୀ ବିହାରା",
          "ରଚ ବଚନାମୃତ ନିର୍ଗତ ଧାରା",
          "ମିଶ ହୃଦ ହାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚଣ୍ଡମଦନକର ଦାରୁଣ ବାଣେ",
          "ଦଣ୍ଡକୁ ସମୁଚିତ ନୁହଇ ମୁଁ ଟାଣେ",
          "ମଣ୍ଡ ଗଳକୁ କହେ ଅଗଣିତ ରାଣେ",
          "ମୃଦୁଳ ବାହାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମଗ୍ନ ମୁଁ ତୋର ରସ ନିର୍ଝର କୂପେ",
          "ତନୁରୁଚି ନିର୍ଧୂତ ହାଟକ ରୂପେ",
          "ସକରୁଣ ହୁଅ ହରିଚନ୍ଦନ ଭୂପେ",
          "ମୋ ସୁଖରାହା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
