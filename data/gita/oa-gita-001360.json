{
  "id": "oa-gita-001360",
  "name": {
    "en": "Chala sighre nikunja bhabanaku",
    "or": "ଚଳ ଶୀଘ୍ରେ ନିକୁଞ୍ଜ ଭବନକୁ"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000164"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chala-sighre-nikunja-bhabanaku-sena-gourahari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚଳ ଶୀଘ୍ରେ ନିକୁଞ୍ଜ ଭବନକୁ ଗୋ ରାଧେ",
          "ଚାହିଁ ରହିଛନ୍ତି ଶ୍ୟାମ ତୁମ୍ଭ ଆସିବା ଦିନକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଦନ ମନୋହର ବେଶକୁ ନାଗର",
          "ଧରି ଧୀର ସମୀରେ ପ୍ରବେଶି",
          "ବଂଶୀରେ କିଶୋରୀ ବୋଲି ନାମକୁ ଉଚ୍ଚାରି",
          "ଡାକୁଛନ୍ତି କେତେ ପରଶଂସି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚିତ୍ତ ଅନୁସାରେ ତିମିର କ୍ରମରେ",
          "ଘୋଟିଦେଲାନି ଦିଗ ବିଦିଗକୁ",
          "ଅତିଶୟେ ମୁଖର ହେବା ରତ୍ନ ନୂପୁର",
          "ପରିହରି କରି ଗୋପନକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଭିସାରେ ଉଚିତ ସମୟ ଏପରି ତ",
          "କହୁଛି ନାହିଁ ନୋହିବ ଆଉ",
          "ପିନ୍ଧି ଅସିତ ବସନ ମୃଗମଗ ଲପନ",
          "ହୋଇ ସୁବେଶ ହେବା ଥାଉ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସ୍ଫୁରେ ବାମ ନୟନ ବିଳମ୍ବ ନ କର ଧନ",
          "ସ୍ୱାର୍ଥ ଲଭିବୁଟି ଜାଣ",
          "କହେ ଗୌରହରି କାନ୍ତ କୋଳେ ବିହରି",
          "ମନୋରଥ କରିବୁ ପୂର୍ଣ୍ଣ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chala-sighre-nikunja-bhabanaku-sena-gourahari/"
    }
  ],
