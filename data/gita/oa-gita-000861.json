{
  "id": "oa-gita-000861",
  "name": {
    "en": "Sangini syama bharame",
    "or": "ସଙ୍ଗିନୀ ଶ୍ୟାମ ଭରମେ"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangini-syama-bharame-khambaja-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗିନୀ ଶ୍ୟାମ ଭରମେ କି ପଡ଼ିଲି",
          "କୁଳ ଧରମକୁ ଏଡ଼ିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁରଲୀ ଗାନେ ରସିଥାଇ ମୁଁ ଦିବା ନିଶି",
          "ଆନ ବିଷୟ ଛାଡ଼ିଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁସୁମ ତୋଳିବା ଛଳେ ଯାଇ ଯମୁନା କୂଳେ",
          "ମୋହନଙ୍କୁ ସଦା ଲୋଡ଼ିଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତା ଲାଗି ହେଲି ମୁଁ ବାଇ ସଜନୀ ତାକୁ ନ ପାଇ",
          "ଅନବରତରେ ସଡ଼ିଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ବିକ୍ରମଦେବ ନେତ୍ର ନବ ନୀରଜାତ ମିତ୍ର",
          "ପଛରେ କେଡ଼େ ଦଉଡ଼ିଲି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
