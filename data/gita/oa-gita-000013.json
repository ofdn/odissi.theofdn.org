  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pada-bande-gananatha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପଦ ବନ୍ଦେ ଗଣନାଥ ଗୁଣଧାମ ଜୟ ହେ",
          "କୁନ୍ଦଜିତ ଗୌରତନୁ ଗୌରୀସୁତ ଜୟ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେବବର ବିଘ୍ନହର ଯଶ ଗାଏ ନାଗ ନର",
          "ପାଶଧର ନାଶ ଦର ନାଗଶିର ଜୟ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଦ୍ଧମତି ବୁଦ୍ଧ ଅତି ପଦ ବନ୍ଦେ ସୁର ଯତି",
          "ଘେନ ନତି ମୂଢ଼ ଗତି ଗୁଞ୍ଜେ ଜଗ ଜୟ ହେ"
        ]
      }
    ]
  },
  "sources": [
