{
  "id": "oa-gita-000008",
  "name": {
    "en": "Sakhi jiba para dekhi",
    "or": "ସଖି ଯିବା ପରା ଦେଖି"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000006"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-jiba-para-dekhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖି ଯିବା ପରା ଦେଖି ମନମୋହନେ",
          "ତୁଟୁ ସବୁରି ଶ୍ରମ ସଘନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଫୁଟୁ ମଲ୍ଲୀ ମାଳତୀ",
          "ଜାଈ ଜୂଈ ସେବତୀ",
          "ଛୁଟୁ ସୁବାସ କୁଞ୍ଜ କାନନେ",
          "(ପଡ଼ି)",
          "ସଞ୍ଜ ବେଳ ହେଲାଣି କଞ୍ଜ ଶୋଇଗଲାଣି",
          "ଖଞ୍ଜନ ନୟନରେ ଅଞ୍ଜନ ଦିଅ ଧନୀ",
          "ଅଞ୍ଜନ କେଶିନୀ କୁଞ୍ଜର ଗାମିନୀ",
          "ଭଞ୍ଜନ ହେଉ ଦୁଃଖ ମଞ୍ଜୁଳ ମିଳନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହସୁ ଯମୁନା ତଟ",
          "କଦମ୍ବ ବଂଶୀ ବଟ",
          "ରସୁ ମିଳନ ଗାନ କୀର୍ତ୍ତନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମିଶୁ ଗଉର ଶ୍ୟାମ",
          "ଜ୍ୟୋତି ଭାତି ସୁଷମ",
          "ଦିଶୁ ତାରିଣୀ ହୃଦ ଲୋଚନେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
