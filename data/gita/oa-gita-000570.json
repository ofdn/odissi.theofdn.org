{
  "id": "oa-gita-000570",
  "name": {
    "en": "Bhuja tale mote rakha mahabahu",
    "or": "ଭୁଜ ତଳେ ମୋତେ ରଖ ମହାବାହୁ"
  },
  "composer": "oa-person-000026",
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhuja-tale-mote-rakha-mahabahu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭୁଜ ତଳେ ମୋତେ ରଖ ମହାବାହୁ",
          "ବାହୁ ତଳେ ମୋତେ ରଖ",
          "ବିପୁଳ ଭୁଜ ବିସ୍ତାରି ଦେଲେ ଛାର",
          "କି କରି ପାରିବ ଦୁଃଖ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଜ ହୋଇଥିବ ନନ୍ଦିଘୋଷ ରଥ",
          "ମୁଁ ଥିବି ତୁମ୍ଭ ସେବାରେ",
          "ତୁମ୍ଭେ ଦୀନବନ୍ଧୁ ନିର୍ଦ୍ଦୟ ହୋଇଲେ",
          "କି ବୋଲିବେ ଏ ସଂସାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏ ଗଜରାଜି କ୍ଷିତି ପତି ସମ୍ପତ୍ତି",
          "ରତିଏ ରୁଚଇ ନାହିଁ",
          "ଭୁବନ ମୋହନ ଚକାନୟନକୁ",
          "ଯେତେବେଳେ ଦିଏ ଚାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦିନକୁ ଦିନ ତ ଦୁଃଖ ଅତିରେକ",
          "ସୁଖ ତ ଦିଶଇ ନାହିଁ",
          "ଭାସି ଯାଉଅଛି ଏ ଭବସାଗରେ",
          "ରକ୍ଷାକର ଭାବଗ୍ରାହୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀକ୍ଷେତ୍ର ନବରେ ମହା ଐଶ୍ୱର୍ଯ୍ୟରେ",
          "ଥିଲେହେଁ କମଳା ସାଇଁ",
          "ବାଇଶି ପାବଚ୍ଛ ନ ଉଠିବା ଯାଏଁ",
          "ଆନନ୍ଦ ନ ପାଏ କାହିଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେବାରୁ ଅନ୍ତର ହେଲି ଯେବେ ପ୍ରଭୁ",
          "ଏ ପ୍ରାଣ ଥିବ କିପାଇଁ",
          "ଓହ୍ଲାଇ ନ ଦିଅ କିପାଁ ମୋ ମଥାରୁ",
          "ଜଞ୍ଜାଳ ଭାର ଗୋସାଇଁ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ମୁଁ ଛାର ପତିତ ଭରସା ରଖିଛି",
          "ଶ୍ରୀରଙ୍ଗା ଚରଣ ତଳେ",
          "ଶ୍ରୀ ବୀରକେଶରୀ ମହାରାଜା ଭଣେ",
          "ରକ୍ଷା କର ଏତେ ବେଳେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhuja-tale-mote-rakha-mahabahu/"
    }
  ],
