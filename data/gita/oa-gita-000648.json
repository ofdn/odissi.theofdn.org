{
  "id": "oa-gita-000648",
  "name": {
    "en": "Jaya jagajjana hitakari",
    "or": "ଜୟ ଜଗଜ୍ଜନ ହିତକାରୀ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000051"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaya-jagajjana-hitakari-gujjari-ekatali-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୟ ଜଗଜ୍ଜନ ହିତକାରୀ ହେ ପ୍ରଭୁ",
          "ଶ୍ରୀ ନୀଳାଚଳ ବିହାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୈତ୍ୟକୁଳ ବିନାଶକାରୀ",
          "ନାମ ବହିଅଛ ଦଇତ୍ୟାରି",
          "ଶଙ୍କାସୁରକୁ ହେଳେ ସଂହାରି ହେ ପ୍ରଭୁ",
          "ବେଦ ଆଣିଲ ଉଦ୍ଧାରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୁଣି କଚ୍ଛପ ରୂପେ ଶ୍ରୀ ହରି",
          "ଚକ୍ରାକାରେ ଅବନୀକି ଧରି",
          "ହୋଇ ବରାହ ରୂପ ମୁରାରି ହେ ପ୍ରଭୁ",
          "ଦନ୍ତେ ମହୀ ରକ୍ଷା କରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନରସିଂହ ମୂର୍ତ୍ତି ହୋଇ କରି",
          "ଭକ୍ତ ଛଳେ ହିରଣ୍ୟ ବିଦାରି",
          "ପ୍ରହ୍ଲାଦକୁ ସ୍ୱର୍ଗେ ଇନ୍ଦ୍ର କରି ହେ ପ୍ରଭୁ",
          "ଭୁଞ୍ଜାଇଲ ସୁଖ ଶିରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦିବ୍ୟ ବାମନ ମୂରତି ଧରି",
          "ବଳି ଦ୍ୱାରେ ହୋଇଲ ଭିକାରୀ",
          "ତିନି ପାଦ ଦାନ ମାଗି କରି ହେ ପ୍ରଭୁ",
          "ଚାପିଲ ପାତାଳ ପୁରୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପର୍ଶୁରାମ ରୂପେ ପର୍ଶୁ ଧରି",
          "କ୍ଷତ୍ରିୟଙ୍କୁ ରଣେ ଜିଣି କରି",
          "ରାମ ରୂପେ ଲଙ୍କା ଧ୍ୱଂସ କରି ହେ ପ୍ରଭୁ",
          "ସୀତା ଆଣିଲ ଉଦ୍ଧାରି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପେ ନନ୍ଦ ଘରେ ଜନ୍ମି କରି",
          "ହଳ ମୂଷଳ ଧାରଣ କାରୀ",
          "ବୌଦ୍ଧ ରୂପେ ରହି ନୀଳଗିରି ହେ ପ୍ରଭୁ",
          "ମହିମା ଅଛ ବିସ୍ତାରି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କଳି ଶେଷେ କଳ୍କି ଅବତରି",
          "ମ୍ଳେଚ୍ଛ ସିଂହାରିବ ଖଡ଼୍‌ଗ ଧରି",
          "ବେଣୁଧର ଶ୍ରୀପଦେ ଭିକାରୀ ହେ ପ୍ରଭୁ",
          "ଭବାବ୍ଧିରୁ କର ପାରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
