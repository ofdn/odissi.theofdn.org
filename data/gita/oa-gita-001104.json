  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ha Patala",
      "or": "ହ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hari-ambhara-e-ta-pranara-dhana-ha-champu-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହରି ଆମ୍ଭର ଏ ତ ପ୍ରାଣର ଧନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହରିହୟ ମଣିକି ଜିଣିଛି ଅପଘନ",
          "ନିନ୍ଦୁଅଛି ଇନ୍ଦୁକୁ ବଦନ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହଜାର ସଂଖ୍ୟକ ହେଲେ ହେଲେହେଁ ମଦନ",
          "ନୋହିବ ଏ ମୋହନ ସମାନ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହଜି ନ ଯିବ ଜୀମୂତ କେଶାର କି ଜ୍ଞାନ",
          "ଶୁଣୁ ଶୁଣୁ ମୃଦୁ ବେଣୁଗାନ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହଟି ଥରେ କରିବା କି ରଦାମ୍ବର ପାନ",
          "ହେଉ ଫଳବନ୍ତ ଯଉବନ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ହାର ମଧ୍ୟରେ ଆମ୍ଭ ତରଳ ରତନ ଗୋ",
          "ହେବେ କି ଏ ଯୁବତୀ ଜୀବନ ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ହୃଷ୍ଟ ହୋଇ ଅଷ୍ଟଦୁର୍ଗ ନମୁଚି ସୂଦନ ଗୋ",
          "କରେ ଏ ରସରେ ବିରଚନ ଗୋ"
        ]
      }
    ]
  },
