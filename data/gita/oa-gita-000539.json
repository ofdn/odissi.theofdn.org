{
  "id": "oa-gita-000539",
  "name": {
    "en": "Priti jediki suada",
    "or": "ପ୍ରୀତି ଯେଡ଼ିକି ସୁଆଦ"
  },
  "composer": "oa-person-000026",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priti-jediki-suada/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରୀତି ଯେଡ଼ିକି ସୁଆଦ",
          "ତେଡ଼ିକି ତା ପରମାଦ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆଖି ଆଖି ମେଳ ହୋଇବା କାଳରେ",
          "ସେ ସୁଖରେ ଥିଲେ ମଜ୍ଜି",
          "ଆନକୁ ଅଳପ କରି ଅନାଇଁଲେ",
          "ଜ୍ଞାନ ଯାଉଥାଏ ହଜି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବେନି ଅନୁରୂପେ ବଚନ କହିଲେ",
          "ଦୁହିଁଙ୍କର ବଡ଼ ସୁଖ",
          "କଥା ପଦକ ଯା ବୃଥା ହେଲା ବୋଲି",
          "ମରଣ ପରମସୁଖ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନ୍ଦେ ମନ୍ଦେ ହସି କହୁଥିଲେ କଥା",
          "ଲଭଇ କୋଟି ସମ୍ପତ୍ତି",
          "ଲପନ ମଳିନ ଦେଖିଲେ ମଦନ",
          "ଛାତିକି ମାରଇ କାତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଂସାର ଭିତରେ ଯେତେ ସାରାସାର",
          "ଅଙ୍ଗେ ଥିଲା ପରି ମଣେ",
          "ବନମାଳୀ ବୋଲେ ଏହା ଛଦ୍ମ ନୋହେଁ",
          "ଏକା ଅନୁଭବୀ ଜାଣେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priti-jediki-suada/"
    }
  ],
