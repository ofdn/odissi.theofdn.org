{
  "id": "oa-gita-000189",
  "name": {
    "en": "Aau kaha kara dharibi",
    "or": "ଆଉ କାହା କର ଧରିବି"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aau-kaha-kara-dharibi-bhanja-mukhari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଉ କାହା କର ଧରିବି ସଜନୀ ଗୋ",
          "ଛାଡ଼ିଗଲେ ଗୁଣମଣି ଝୁରି ଝୁରି ମରିବି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୁ ମୋହର ମୁଁ ତୋର ନ କରିବୁ ଅନ୍ତର",
          "ମାରୁଅଛି ପଞ୍ଚଶର ଦହୁଅଛି ଶରୀର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସୁନ୍ଦର ତୋ ଲଲାଟ ପଡ଼ୁଛି ଆଲଟ",
          "ଗଜଦନ୍ତ ପଲଙ୍କରେ ଆଉ ନାହିଁ ତୋ ଭେଟ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୋକିଳ ପରି ବାଣୀ କହୁ ଚତୁରୀମଣି",
          "ଭ୍ରୂଲତା ଶୋଭା ତୋହର ଇନ୍ଦ୍ରଧନୁକୁ ଜିଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କି ସୁନ୍ଦର ଧନକୁ ଚାହିଁ ତୋ ବଦନକୁ",
          "ଯେତେ ଯେତେ ଦୋଷ କଲି ନ ଘେନିବୁ ମନକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରସବତୀ ରସିବ କାନ୍ତ କୋଳେ ବସିବ",
          "ଭଣେ ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ ଚାରିଚକ୍ଷୁ ମିଶିବ"
        ]
      }
    ]
  },
  "sources": [
