    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାମ କୋଟି ଶ୍ୟାମ ସୁନ୍ଦର",
          "କ୍ରୀତ ଦାସୀଜନେ କରୁଣା ବିତରଣେ",
          "କାହିଁକି କୁଣ୍ଠିତ ବ୍ରଜରାଜ କିଶୋର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚାହିଁ ତବ ସରଣୀ ସାରା ଦିନ ରଜନୀ",
          "ଚକ୍ଷୁ କୋଣେ ଧନୀର ଲୋତକ ମଲାଣି",
          "ଚଞ୍ଚଳ ହୁଅ ସଜ ଛଳନା ତେଜି ଆଜ",
          "ନିଧୁବନେ ବିରାଜ ମାଗୁଣି ତାରିଣୀର"
        ]
      }
    ]
  },
