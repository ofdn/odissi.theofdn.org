{
  "id": "oa-gita-000370",
  "name": {
    "en": "Hela ki dasa re bandhu",
    "or": "ହେଲା କି ଦଶାରେ ବନ୍ଧୁ"
  },
  "composer": "oa-person-000060",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hela-ki-dasa-re-bandhu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହେଲା କି ଦଶାରେ ବନ୍ଧୁ ଶ୍ୟାମ ଆଶାରେ",
          "ଗଲା ତ ସଜନୀ ସରି ଆମ୍ଭର ଲୋକହସାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଜ୍ଜିଗଲା ତ ସୁସ୍ୱାଦୁ ମୃଦୁଭାଷାରେ",
          "ହଜିଲା ବିବେକ ଯାକ କହିଲେ ହେଲା ଘୋଷାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଏ ଯେ ତୁଳି ରଜନୀକର ମିଶାରେ",
          "ଲୁଳଇ ଧୂଳି ପରେ କି ହେଲା ଯୋଷା ଭୂଷାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିରତେ ନୀର ନୟନୁ ହେଲା ବର୍ଷାରେ",
          "ସରିଲା ସୁଖ ଏଣିକି ନିକୁଞ୍ଜବନ ବସାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଥିବ କି ରହିବ ଜୀବ ଆଉ ସଂସାରେ",
          "ବୋଲଇ ହରି କରିବେ କି ଦୂର ଦୁରଦଶାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
