{
  "id": "oa-gita-000393",
  "name": {
    "en": "Syama nagara tu niskamare au mora",
    "or": "ଶ୍ୟାମ ନାଗର ତୁ ନିଷ୍କାମରେ ଆଉ ମୋର"
  },
  "composer": "oa-person-000049",
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-nagara-tu-niskamare-au-mora/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ନାଗର ତୁ ନିଷ୍କାମରେ ଆଉ ମୋର",
          "ନାମେ ମୁରଲୀ ନ ବଜା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାରମ୍ବାର ମୁଁ ତୋତେ । ବାରଣ କଲି ଚିତ୍ତେ ।",
          "ବାରଣ ପଦ ନ ଭଞ୍ଜା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଣି ତୋ ବଂଶୀସ୍ୱନ । ଦହଇ ପଞ୍ଚମନ ।",
          "କନ୍ଦର୍ପ ଦର୍ପକୁ ଗଞ୍ଜା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାଜୁଛି କାମ୍ବାଣ । ଭାଜୁଛି ସବୁ ଟାଣ ।",
          "ବିନୟ ମନେ ତୁ ବୁଝା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହେ ଶ୍ୟାମ ନବଘନ । ତୋ ଶ୍ରୀରଙ୍ଗ ଚରଣ ।",
          "ପଦନ ଚିତ୍ତକୁ ମଜ୍ଜା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-nagara-tu-niskamare-au-mora/"
    }
  ],
