  "id": "oa-gita-001340",
  "name": {
    "en": "Garaje badala bhima garajane",
    "or": "ଗରଜେ ବାଦଲ ଭୀମ ଗରଜନେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000123"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/garaje-badala-bhima-garajane-megha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗରଜେ ବାଦଲ ଭୀମ ଗରଜନେ",
          "ଘନ ତିମିର ଘେରି ଆସେ ରେ",
          "ସାଗର ବନ ଗିରି ଗହନ ପ୍ରାନ୍ତର",
          "ଥରଇ ଦାନବ ପ୍ରାସରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲୁପ୍ତ ଶଶଧର ସୁପ୍ତ ତାରା",
          "ଦୀପ୍ତ ରବିକର ଦୀପ୍ତିହରା",
          "ପ୍ରଳୟ ତାଣ୍ଡବେ କମ୍ପେ ଧରଣୀ",
          "ଅଟ୍ଟ ଉତ୍କଟ ହାସରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତ୍ରାହି ରବ ଶୁଭେ ଭୁବନେ ଭୁବନେ",
          "ଜାଗେ ଶିହରଣ ଜୀବନ ଜୀବନେ",
          "ଶାନ୍ତି ସୁଖ ଶିରୀ ନେଲା ସେ ଅପସରି",
          "ତରୀ ଅଥଳ ଜଳେ ଭାସେ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
