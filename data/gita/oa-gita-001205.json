{
  "id": "oa-gita-001205",
  "name": {
    "en": "Syamaku juhara tara premaku juhara",
    "or": "ଶ୍ୟାମକୁ ଜୁହାର ତାର ପ୍ରେମକୁ ଜୁହାର"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syamaku-juhara-tara-premaku-juhara-ma-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମକୁ ଜୁହାର ତାର ପ୍ରେମକୁ ଜୁହାର ମା",
          "ସେ କରୁ ଗୋ ସେ ପୀରତି ଯା ଦେହ ଲୁହାର ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶୁଣିଛି ପ୍ରସଙ୍ଗରେ ଚନ୍ଦ୍ରାବଳୀର ସଙ୍ଗରେ",
          "ନାଗରା ବାଜୁଛି ବ୍ରଜଯାକରେ ଯାହାର ମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଥୁରାକୁ ଦଧି ବିକି ପଥେ ଗଲା ଗୁଆଳୀକି",
          "ଶେଯେ ଶୁଆଉଛି ସେ ଗୋବର୍ଦ୍ଧନ ଗୁହାର ମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଡ଼ିଲେ କା ଆଗରେ ବୁଡ଼ିବି ଦୁଃଖ ସାଗରେ",
          "ପ୍ରାଣ ଧରି ଚାହିଁବି ମୁଁ ମୁଖକୁ କାହାର ମା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଳିନ୍ଦଜା କୂଳରେ ଚାହିଁଲି ନୀପ ମୂଳରେ",
          "ପଳାଇ ଆସିଲି ଠାରି ଜାଗୁଥିଲେ ଦ୍ୱାର ମା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷେ ସ୍ୱାମିନୀ ତୁମ୍ଭ ପାଇଁ ସେ",
          "ବ୍ରଜବିଧୁ ହୋଇଛନ୍ତି ସୁରଭି ମାହାର ମା"
        ]
      }
    ]
  },
  "sources": [
