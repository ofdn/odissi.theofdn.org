{
  "id": "oa-gita-000274",
  "name": {
    "en": "Mo nida kene delu bhangi re",
    "or": "ମୋ ନିଦ କେଣେ ଦେଲୁ ଭାଙ୍ଗିରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mo-nida-kene-delu-bhangi-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋ ନିଦ କେଣେ ଦେଲୁ ଭାଙ୍ଗିରେ",
          "ସ୍ୱପ୍ନ ଦେଖୁଥିଲି ଭଙ୍ଗୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭେଟିଲାକ୍ଷଣିରେ ଯାହା ବିଲୋକିଲି",
          "ଆହା ସେ ସଞ୍ଜର ପଙ୍ଗୀରେ",
          "ଭବ ପରାଭବି ଛବିର ଗରବ",
          "ଲବକରେ ଯିବ ଭାଙ୍ଗିରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହସି ନେଲେ ଆସି ତଳପରେ ବସି",
          "ଲକ୍ଷମୂଳର ବରାଙ୍ଗୀରେ",
          "ନକ୍ଷତ୍ରମାଳା ବକ୍ଷରୁ ଦେଇ ମୋତେ",
          "କରୁଥିଲେ ସେ ଉତ୍ସଙ୍ଗୀରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପରସିବା ବିଧି ସେ ଦିନ ବୋଲି ମୁଁ",
          "ଭାଳି ହେଉ ଉଦବେଗିରେ",
          "ହେଜି ଦିବ୍ୟ ଭୋଜ୍ୟ ସମ୍ପାଦି ଲଳିତା",
          "ତେଣେ ରହିଥିଲା ଜଗିରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମାନ କରି ଆଜ ଦିନଯାକ ମୁହିଁ",
          "ହୋଇଥିଲି ବିପ୍ର ଯୋଗୀରେ",
          "ଦୟାଳୁ କଞ୍ଜସମ୍ଭବ ସଂବେଶରେ",
          "କରାଇଥିଲା ସଂଯୋଗୀରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ସାବଧାନ",
          "ହୁଅ ଚାରୁ ଚଳାପାଙ୍ଗୀରେ",
          "ଘନତମସୀରେ ପଞ୍ଚପାଳି ତଳେ",
          "ଦେଖୁଛନ୍ତି ଚଳ ବେଗିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
