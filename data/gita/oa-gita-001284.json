{
  "id": "oa-gita-001284",
  "name": {
    "en": "Bhaja mana re radha gobinda",
    "or": "ଭଜ ମନ ରେ ରାଧା ଗୋବିନ୍ଦ"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhaja-mana-re-radha-gobinda-punnaga-gourachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଜ ମନ ରେ ରାଧା ଗୋବିନ୍ଦ",
          "ସଦା ଅଚିରେ ପାଇବୁ ପଦାରବିନ୍ଦ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀଗୁରୁ ନଳିନ ଚରଣେ ଶରଣ",
          "ପଶି ସେ ବସୁଧା ବୃନ୍ଦ",
          "ରଙ୍ଗେ ନିଅ କାଳ କାଳଦଣ୍ଡ ଭୟ",
          "ଘୁଞ୍ଚିବ ତେଜି ତୁ ଦ୍ୱନ୍ଦ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ୱପ୍ନର ପ୍ରକାର ତୁଟିଯିବ ତୋର",
          "ନ ବାନ୍ଧିବ ଭବବନ୍ଧ",
          "ଯମୁନା ତଟରେ ରାସ ନିକଟରେ",
          "ଦେଖିବୁ ହୋଇ ଆନନ୍ଦ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯା ଧୂଳିଖେଳାରେ ଚକ୍ଷୁ ଯୁଗଳକୁ",
          "ଦାନ ଲଭିଅଛି ଅନ୍ଧ",
          "ଗୌରଚନ୍ଦ୍ର ଗଜପତି କହନ୍ତି",
          "ଦୟା କରିବେ ମୁକୁନ୍ଦ"
        ]
      }
    ]
  },
  "sources": [
