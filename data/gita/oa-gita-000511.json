{
  "id": "oa-gita-000511",
  "name": {
    "en": "Jiba bandhabi re prana bandhabi re",
    "or": "ଜୀବବାନ୍ଧବୀ ରେ ପ୍ରାଣବାନ୍ଧବୀ ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000091"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jiba-bandhabi-re-prana-bandhabi-re-kolahala-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୀବବାନ୍ଧବୀ ରେ ପ୍ରାଣବାନ୍ଧବୀ ରେ",
          "ତୋ ବିନା ମୋତେ ନ ଦିଶେ ଆନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜଗତେ ନାଗରୀମାନଙ୍କ ମାଧୁରୀ",
          "କରୁଥାଏ ମୁଁ ଯେ ଅନୁମାନ",
          "ଗୋଟିଏ ଗୁଣରେ ତୋ ନଖ କୋଣରେ",
          "ତୁଳିବାକୁ ନ ବଳଇ ମନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୂର୍ବ ତପ ବଳେ କରିବ ଯେ ବଳେ",
          "ତୋ ମଧୁର ରଦଚ୍ଛଦ ପାନ",
          "ସୁଧା ନିର୍ଝରୀକି ମଧୁର କରି କି",
          "ଲେଖିବ ନ ଧରି ଅଭିମାନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତରୁଣୀ ତୋ ବାଣୀ ମୃଦୁ ମୃଦୁ ଠାଣି",
          "ଶୁଣିଥିବ ପୁଣି ଯାହା କାନ",
          "ସେ କି ଗଉରବ ଯୋଗ୍ୟ ବିଚାରିବ",
          "ଶୁକ ପିକ ବେଣୁ ବୀଣା ଗାନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଥରେ ଯାହା ଉର କରିଥିବ ତୋର",
          "ଘନ ପୀନ ସ୍ତନ ଆଲିଙ୍ଗନ",
          "କୁମ୍ଭି କୁମ୍ଭସ୍ଥଳ ଯୁଗଳକୁ ସ୍ଥୂଳ",
          "ମଣିବ କି ନ ବିଚାରି ନ୍ୟୂନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମଧ୍ୟ ଥିଲେ ସିନା ତୋର ସୁଦର୍ଶନୀ",
          "ଘଟନା କରନ୍ତି ଉପମାନ",
          "ହରିକଟି ଡାକି ବେଦୀ ମଧ୍ୟରେ କି",
          "କୃତାର୍ଥ କରନ୍ତେ ରୂପମାନ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ହେଳେ ଯେ ମନ୍ଦରସ୍ତନା ତୋ ସୁନ୍ଦର",
          "ଚାଲିରେ କରିବ ଦୃଷ୍ଟିହୀନ",
          "ଯେବେ ଥିବ ଲାଜ ରୁଚିବ କି ରାଜ",
          "-ହଂସ ଗଜରାଜ ଲୀଳା ଯାନ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଜଣାଇବି କିସ ଶେଷ ମୁଖେ ଶେଷ",
          "ହେବାର ଆୟାସ ଯେ ବିଧାନ",
          "କହେ ଜଳନ୍ତର ମହୀ ପୁରନ୍ଦର",
          "ଥିବ ମାତ୍ର କିଛି ଅବଧାନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
