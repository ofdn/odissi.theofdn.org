{
  "id": "oa-gita-000428",
  "name": {
    "en": "E ghana dina sakhi chahan",
    "or": "ଏ ଘନ ଦିନ ସଖୀ ଚାହାଁ"
  },
  "composer": "oa-person-000096",
  "mula_raga": [
    "oa-raga-000054"
  ],
  "mula_tala": [
    "oa-tala-000010"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-ghana-dina-sakhi-chahan/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ ଘନ ଦିନ ସଖୀ ଚାହାଁ",
          "ବଞ୍ଚିବି ଏକାଳେ କେହି ମୋ କୋଳେ ନାହିଁ ନାହା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଝଙ୍କାଇ ଝଞ୍ଜା ମରୁତ ଝଙ୍କରୀ ରୁତ",
          "ଶାମୁକ ଡାକ ବହୁତ କାରା ଭବନ ।",
          "ଏକେ ଦମ୍ଭୋଳି ଦମକ ଦୁଜେ ଚଞ୍ଚଳା ଚମକ",
          "ମିଶିଛି କାମ ଧମକ ଯିବ ଜୀବନ ।",
          "(ପଡ଼ି)",
          "ଦୁର୍ଦ୍ଦିନ ଦିନ ଦେଖି ମୁଦି ନୟନ ରଖି",
          "ମୁଁ ଦୀନ ହେଲି ସଖୀ ବୁଦ୍ଧି ନ ଦିଶେ ଆହା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଡାହୁକ ଭେକ ବରହୀ ରଟୁଛନ୍ତି ଆଗେ ରହି",
          "ଜଗି ବିନ୍ଧୁଛି ସ୍ମର ହିଁ । କେତେ ସହିବି ।",
          "କହ କହ ପ୍ରତିକାର ବଢ଼େ ବରିହ ବିକାର",
          "ଦିଶଇ କୃଷ୍ଣ ଆକାର ଯେଣେ ଚାହିଁବି ।",
          "(ପଡ଼ି)",
          "କରକା ପଡ଼ିବାର ତରକା ନୁହେ ଘୋର",
          "ବରକାମିନୀଙ୍କର ପର କାମେ ଉତ୍ସାହା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଡ଼ିଛି କାମ ମୁଖରେ କେ ଦୁଃଖୀ ମୋ ଦୁଃଖରେ",
          "ସଜନୀ ଏଥୁଁ ରଖ ରେ । ହେଲା ଅବଶେ ।",
          "ହେଲେ ଗୋ କାନ୍ତ ଭରମ କଲେ ଗୋ ଏଡ଼େ କରମ",
          "ଦେବେ ଗୋ ମୋତେ ଚରମ ଦଶା ଅବଶେ ।",
          "(ପଡ଼ି)",
          "ଗରଜି ଘନମାଳ ବରଷୁଅଛି ଜଳ",
          "ମୋର ଜୀବ ଆକୁଳ ତରଜେ ରତିନାହା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଲ୍ଲବ ଶେଯ ତେଜିବି ଦୁର୍ଲ୍ଲଭ ବେଶ ସାଜିବି",
          "ବଲ୍ଲଭ କୋଳେ ମଜ୍ଜିବି ବିହି କରିବ ।",
          "ସତେହେଁ ଦୁଃଖ ମୁଞ୍ଚିବି ଦାରୁ କାଳ ବଞ୍ଚିବି",
          "ପ୍ରିୟାର ସ୍ନେହ ସଞ୍ଚିବି ପ୍ରାଣ ଧରିବି ।",
          "(ପଡ଼ି)",
          "ଯତନ କରି ଗୁଣିରତନ ସୁତ ଭଣି",
          "ନୂତନ ବିରହିଣୀ ମୁଁ ତ ନ ଜାଣେ ଏହା"
        ]
      }
    ]
  },
