{
  "id": "oa-gita-000160",
  "name": {
    "en": "Mana sumana",
    "or": "ମାନ ସୁମନା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-sumana-karide-manasu-mana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନ ସୁମନା",
          "କରିଦେ ମାନସୁଁ ମନା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗିରିସମ ଜାଇ ରେ ରାମା । ଗିରିସମ ଜାଇ ।",
          "ଦେଇ ମୁଁ ପାଇଛି ତୋତେ ଗିରୀଶ ମଜ୍ଜାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାଗରାଜ ଗତେ ରେ ରାମା । ନାଗରାଜ ଗତେ ।",
          "ମୁଁ ତୋର ବୋଲି ବାଜୁଛି ନାଗରା ଜଗତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋର ପରିକର ରେ ରାମା । ତୋର ପରିକର ।",
          "ଆଜି ସିନା ରତେ ମୋତେ ତୋର ପରି କର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଫୁଟିଲେ ନିଆଳି ରେ ରାମା । ଫୁଟିଲେ ନିଆଳି ।",
          "ଜଳପି ଜଳପି ତୋତେ ଫୁଟିଲେନି ଆଳି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରମ୍ଭାଉରୁ ବସି ରେ ରାମା । ରମ୍ଭାଉରୁ ବସି ।",
          "ଅଙ୍କେ ଥିଲେ ନ ଗଣେ ମୁଁ ରମ୍ଭା ଉରୁବଶୀ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ନବ ସୁରସା ରେ ରାମା । ନବ ସୁରସା ।",
          "ତୁ ପରା ମୋ ଅଙ୍କ ବିନା ନ ବସୁ ରସାରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ହରିଚନ୍ଦନକୁ ରେ ରାମା । ହରିଚନ୍ଦନକୁ ।",
          "ଘେନ ଯଥା ବସନ୍ତରେ ହରି ଚନ୍ଦନକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
