{
  "id": "oa-gita-000713",
  "name": {
    "en": "Guna nidhi labanya lahari re",
    "or": "ଗୁଣନିଧି ଲାବଣ୍ୟଲହରୀ ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000035"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/guna-nidhi-labanya-lahari-re-sindhu-kamodi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୁଣନିଧି ଲାବଣ୍ୟଲହରୀ ରେ",
          "ମୋ ରାଣଟି କହ କହ",
          "ଦିବ୍ୟ ଅବଧାନେ ଯେବେ ହେଲେ ଧାନେ",
          "ଅଛି ମୋରେ ଅନୁଗ୍ରହ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲୀଲା ସଉଧରେ ଆରମ୍ଭି ଥିଲୁ ତ",
          "ବିଳାସ ମଧୁର ଗାନ",
          "ହରିଣାଙ୍କ ବିମ୍ବ ଚାହିଁ କିପାଁ ବିମ୍ବ",
          "-ଅଧରା ହେଲୁ ମଉନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶଶାଙ୍କ ନିବାସ ଛାଡ଼ି କରି ଶଶ",
          "କଲେ ଶ୍ରୀମୁଖ ଆଶ୍ରୟ",
          "ବିମଳ ବଦନ ହେବ ସଲାଞ୍ଛନ",
          "ବୋଲି ଲଭିଲୁ କି ଭୟ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଲକେ ପଲଙ୍କେ ମୁଁ ପ୍ରିୟଙ୍କ ଅଙ୍କେ",
          "ନିଶି ନୋହିଥିଲେ ସ୍ଥିତ",
          "ଏହି ନିଶାଚର ପିଅଇ ରୁଧିର",
          "ବୋଲି ହେଲୁ କି ଚକିତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରକଶତର ଅକର୍ମ ପଥର",
          "ଦ୍ରବାଏ ମୋ କଣ୍ଠ ଧ୍ୱନି",
          "ପୀୟୂଷ ମୃଦୁଳ ବିଧୁର କି ବଳ",
          "ବିଚାରି ହେଲୁ କି ତୁନି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗ ପତି ବୋଲେ ଗଜଗତି",
          "ନ କରି କପଟ ଲେଶ",
          "କରି ଚନ୍ଦ୍ରାଲୋକ ତୁ ହେବାରୁ ମୂକ",
          "ହୁଏ ସନ୍ଦେହ ଅଶେଷ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
