{
  "id": "oa-gita-000780",
  "name": {
    "en": "Priti kale karuthiba bachi bachi",
    "or": "ପ୍ରୀତି କଲେ କରୁଥିବ ବାଛି ବାଛି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000145"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priti-kale-karuthiba-bachi-bachi-soka-kamodi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରୀତି କଲେ କରୁଥିବ ବାଛି ବାଛି ଗୋ ପ୍ରିୟସଖୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚୂନ ହଳଦୀ ମିଶିଲା ପରି",
          "ବେନି ପ୍ରୀତି ନୋହୁଥିବ ବାରି",
          "ଏବେ କି ପ୍ରୀତିରୁ ଆନ ବଞ୍ଚିବାରୁ",
          "ମରିଯିବା ସଖୀ ମାଧୁରୀ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷଣକେ ହସା କ୍ଷଣକେ ରୁଷା",
          "କ୍ଷଣେ ନିନ୍ଦା କ୍ଷଣେ ପରଶଂସା",
          "ଏମନ୍ତ ପ୍ରୀତିଆ ସଙ୍ଗେ ପ୍ରୀତି କଲେ",
          "ଜୀବ ଥାଉଁ ହୁଏ ଲୋକହସା ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେ ପୁଣି ତାହାକୁ ଝୁରୁଥିବ",
          "ଦଣ୍ଡେ ନ ଦେଖିଲେ ମରୁଥିବ",
          "ପୁଣି ସେ ତାହାଙ୍କୁ ଦାଣ୍ଡରେ ଦେଖିଲେ",
          "ଆନ ବାଟେ ମୁଖ ପୋତିଯିବ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋଟି ଜନ୍ମ ଥିଲେ କୋଟି ଜାଗ",
          "ମିଳୁଥାଇ ସମ ଅନୁରାଗ",
          "ବୋଲେ ବନମାଳୀ ଏହି ପ୍ରୀତି ପାଳି",
          "ଆଣି କଲାଣି ଅନଙ୍ଗ ଯୋଗ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
