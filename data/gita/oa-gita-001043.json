  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-rasamaya-basanta-kalyana-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଏ ରସମୟ ବସନ୍ତ ବିରସ ନ କର ଚିତ୍ତ",
          "ସରସରେ ପ୍ରାଣମିତ ହରଷ କର ଉଦିତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭ୍ରମର ଝଙ୍କାର ଶୁଣି କାମର ବଢ଼ିଛି ଆଣି",
          "ପାମରପଣରେ ପୁଣି ମୋ ମରମେ ବିନ୍ଧେ ଟାଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାନନପ୍ରିୟ ଡାଳରେ ମନ ନ ରହେ ଥିରରେ",
          "ଦିନ ନ ସରେ ଦୁଃଖରେ ଆନନକୁ ଟେକ ବାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଚନ୍ଦ୍ର ରଘୁନାଥ ଭାବି କହେ ମନୋରଥ",
          "ଅବିଳମ୍ବେ ହେବ ସାର୍ଥ ସେବିଲେ ଯୁଗଳ ପଥ"
        ]
      }
    ]
  },
  "sources": [
