  "id": "oa-gita-001043",
  "name": {
    "en": "E rasamaya basanta",
    "or": "ଏ ରସମୟ ବସନ୍ତ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
