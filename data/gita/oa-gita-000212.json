    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ କିସ ହେ ଶ୍ୟାମ",
          "କହୁଥାଅ ପରା ଆନେ ନାହିଁ ପ୍ରୀତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନଳିନ ନୟନ ଦିଶୁଛି ଥନଥନ",
          "କୁଙ୍କୁମରେ ଜରଜର ଦିଶେ ଛାତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଧର ସୁରଙ୍ଗ ଦିଶୁଛି ବିଭଙ୍ଗ",
          "ମୋହନ ମାଦକେ ପାହିବାରୁ ରାତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆହେ ବାସଚୋରା ପଡ଼ିଗଲ ଧରା",
          "କାହା ପୁରେ ରହି ପୁହାଇଲ ରାତି"
        ]
      }
    ]
  },
