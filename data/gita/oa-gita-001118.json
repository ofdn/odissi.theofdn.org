{
  "id": "oa-gita-001118",
  "name": {
    "en": "Hasi hasi re chahinba",
    "or": "ହସି ହସି ରେ ଚାହିଁବା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hasi-hasi-re-chahinba-disuchi-gopalakrusna-punnaga/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହସି ହସି ରେ ଚାହିଁବା ଦିଶୁଛି ଚାରୁବେଶୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆଳୀ ଠାରିଦେଲେ ମୋର ଯିବାର ସତ୍ୱର",
          "ଆସୁ ଧନ କେଶ ଖୋସି ଖୋସି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦୂରୁ ଶୁଣି ମୋର ବାଣୀ ପଞ୍ଜର ସରଣୀ",
          "ପାଶେ ରଖିଥାଇ ମୁଖ ଶଶୀ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲଲାଟ ସିନ୍ଦୂର ତୋର କପାଳରେ ମୋର",
          "ଲାଗି ଯାଇଥିଲେ ଘନକେଶୀ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରତି ଶେଷେ ବାସ ପିନ୍ଧୁ ଉଭା ହୋଇ ବନ୍ଧ",
          "ରଦେ ରଦବାସ ଲାଜେ ଦଂଶି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣଙ୍କୁ କଥା କହି ପୋତୁ ମଥା",
          "ଶାଢ଼ୀ ବାଡ଼ ନଖେ ଘଷି ଘଷି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
