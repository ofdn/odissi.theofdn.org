{
  "id": "oa-gita-001060",
  "name": {
    "en": "Na kahile pade nipata bipade",
    "or": "ନ କହିଲେ ପଦେ ନିପଟ ବିପଦେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-kahile-pade-nipata-bipade-asabari-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ କହିଲେ ପଦେ ନିପଟ ବିପଦେ",
          "ନିକର ବୁଡ଼ାଇ ଦେବୁ ସିନା ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନ ଜାଣି ଜାଣିବା ଦୋଷ ହେଲେ ସେବା",
          "ନ କରିବ କ୍ଷମା ଯଦି ନବୀନା ରେ",
          "ବୁଝାମଣା ହେଲେ ଊଣା ବୋଲିବେ",
          "ଲୋକେ କେତେ ଭାବନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୁ ତାର ସଜନୀ ମୁଁ ତୋର ଭଜନୀ",
          "ତୋ ଚିତ୍ତେ କରୁଣା କରୁ କି ନା ଗୋ",
          "ସେ ତ ଦୟାବତୀକି ଘେନ ବିନତି",
          "ବୋଲିବୁ ଗତି ନାହିଁ ତୋ ବିନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୁଞ୍ଜରେ ବସିଛି ତୋ ବାଟ ଚାହୁଁଛି",
          "ନ କହିଲେ ତୁ ମୋ ନିବେଦନା ରେ",
          "କୁଞ୍ଜରଗତି ହେଜ ମିଥ୍ୟା ମନୁ ହେ ଆଜ",
          "ଯମୁନାରେ ଝାସ ଦେବି ତୋ ନାଁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହେ ରଘୁନାଥ କବି ନିଶାନାଥ",
          "ମୋହନ ନିଷ୍ଠୁର ଜଳପନାରେ",
          "କହିଲେ ସଜନୀ ଆଣିବି ରଜନୀ",
          "କହି ବିନୟନୟ କଳପନାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
