{
  "id": "oa-gita-000518",
  "name": {
    "en": "Aha ki danda asi padila",
    "or": "ଆହା କି ଦଣ୍ଡ ଆସି ପଡ଼ିଲା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-ki-danda-asi-padila-paraja-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା କି ଦଣ୍ଡ ଆସି ପଡ଼ିଲା",
          "କାନ୍ତ ଆସିବା କଣ୍ଟ ଗଡ଼ିଲା",
          "କଣ୍ଠୁ ରତନ ହାର ତୁଟିଲା",
          "କେଶୁ କୁସୁମ ଗଭା ଲୁଟିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଦେଶେ ଗଲା ବେଳେ କହିଗଲେ",
          "ଯାଇଣ ଆସିବି ବୋଲି ବୋଇଲେ",
          "କେଉଁ ନାରୀ ତାଙ୍କୁ କି ମନ୍ତ୍ର ପଢ଼ାଇ",
          "ମୋର ଗଳାକୁ କାଟିଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାଥର ହୃଦୟ ପଥର ହେଲା",
          "କେ ପ୍ରୀତି ପାସୋରା ମନ୍ତର ଦେଲା",
          "ଏକାଳେ ଏକାକୀ କିପରି ବଞ୍ଚିବି",
          "ଭୁଜଙ୍ଗ ଭକ୍ଷ ରଟିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସାହା କେହି ନାହିଁ ନାହା ବାହାରେ",
          "ଯାହା ହୁଏ ଦେହ ସ୍ମର ଦାହାରେ",
          "ହୃଦର ବେଦନା କାହାକୁ କହିବି",
          "ନୀରେ ଉରଜ ବୁଡ଼ିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାଧା ବିରହ ବ୍ୟାଧି ସଖୀ ଦେଖି",
          "ବନମାଳୀ ବୋଲେ ଶୁଣ ଗୋ ସଖୀ",
          "ମଥୁରାରୁ କୃଷ୍ଣ ଲେଉଟି ଆସନ୍ତେ",
          "କୁବୁଜା ମନ ମୋହିଲା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-ki-danda-asi-padila-paraja-banamali/"
