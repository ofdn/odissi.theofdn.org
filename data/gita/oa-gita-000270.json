{
  "id": "oa-gita-000270",
  "name": {
    "en": "Mane paduchi re sehi chandramukha",
    "or": "ମନେ ପଡ଼ୁଛି ରେ ସେହି ଚନ୍ଦ୍ରମୁଖ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000068"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mane-paduchi-re-sehi-chandramukha-gopalakrusna-suddhadesi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନେ ପଡ଼ୁଛି ରେ ସେହି ଚନ୍ଦ୍ରମୁଖ",
          "ପାଶୋରିବା ପାଇଁ କେତେ ହେଲି ମୁଁ ବିମୁଖ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିଟିଳ ଅଳକାବଳୀ ଗଣ୍ଡ ମଣ୍ଡଳର ଝଳି",
          "ନାସା ପୁଟର ଦ୍ୱିରଜ ମୁକୁତା ମୟୂଖ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚାରୁ ଗୋରଚନା ଚିତା ନର୍ତ୍ତନରତ ଭ୍ରୂଲତା",
          "ମନ୍ଦେ ହସି ଫିଙ୍ଗିବାର କଟାକ୍ଷ ବିଶିଖ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୋଭା ରତ୍ନ କୁଣ୍ଡଳର ବଂଶୀ ବିନ୍ୟାସ ଅଧର",
          "ନୂଆ ବରହ ମୁକୁଟ ଦରଶନ ସୁଖ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଙ୍ଗି ଦେଉଥିଲି ପାନ ବୋଲି ଦେଖିଲି ସ୍ୱପନ",
          "ସରିଲା ଉତ୍ତାରୁ ପୁଣି ମନମଥ ମଖ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯାଅ ବୋଇଲା ଉତ୍ତାରୁ ଲୁହ ବୁହାଇ ଆଖିରୁ",
          "ହୋଇବାର ସଖୀମାନଙ୍କର ପାଖ ପାଖ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶୁଣ ସର୍ବେ ସହଚରୀ କରି କରୁଣା ମଞ୍ଜରୀ",
          "ଅପରାଧିନୀ ରାଧାର ଯିବା ଜୀବ ରଖ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷଣ ଉଠି ସମସ୍ତେ ତକ୍ଷଣ",
          "ମିଳିଲେ କୁଞ୍ଜେ ରମଣ ଲେଖୁଥିଲେ ରଖ"
        ]
      }
    ]
  },
  "sources": [
    {
