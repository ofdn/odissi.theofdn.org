{
  "id": "oa-gita-001019",
  "name": {
    "en": "E dasa mora to gheni",
    "or": "ୟେ ଦଶା ମୋର ତୋ ଘେନି"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-dasa-mora-to-gheni-anandabhairabi-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ୟେ ଦଶା ମୋର ତୋ ଘେନି",
          "ଆସିବେ ବୋଲି ଜଗାଇଦେଲୁ ଯା ଆଜ ରଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଲୁ ତାହା ଆନ ଦେଲୁ ଯେତେ ଆନ",
          "ମୋର ଅଭିମାନ କରାଇଲୁ ମ୍ଳାନ",
          "ମୁଁ ସତୀପଣକୁ ନ ଗଣେ ଜଣକୁ",
          "ଏବେ ତାହା ହେଲେ ହାନି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ନେହ ବଳାଇଲୁ ମନ ଝଳାଇଲୁ",
          "ମତେ ଛଳାଇଲୁ ଦୁଃଖେ ଦଳାଇଲୁ",
          "ଏବେ ତୋର କଥା ହୋଇଗଲା ବୃଥା",
          "ଆସିଥିଲି ସତ ମାନି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାଇ ତୋ ଆଦେଶ ହୋଇ ମୁଁ ସୁବେଶ",
          "ପିନ୍ଧି ନୀଳବାସ ଲଭିଥିଲି ରୋଷ",
          "ମୋର ପ୍ରତିଆଶା",
          "ହୋଇଗଲା ସିନା ଗ୍ଳାନି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପୁରେ ରହିଥିଲି କାଳ ବଞ୍ଚୁଥିଲି",
          "ଏଥିକି ଆସିଲି ଚିନ୍ତାରେ ଭାସିଲି",
          "କହେ ରଘୁନାଥ ଏ ବନେ ଅନାଥ",
          "କରିଦେଇ ହେଲୁ ତୁନି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
