{
  "id": "oa-gita-000485",
  "name": {
    "en": "Syama nagara he e besa hoiba nahi",
    "or": "ଶ୍ୟାମ ନାଗର ହେ ଏ ବେଶ ହୋଇବ ନାହିଁ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000024"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-nagara-he-e-besa-hoiba-nahi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ନାଗର ହେ ଏ ବେଶ ହୋଇବ ନାହିଁ",
          "ଏ ବେଶ ହୋଇଲେ ପାଷାଣ ତରଳେ",
          "ଯୁବତୀ ବଞ୍ଚିବେ କାହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଉଭା ହୋଇଥିବ କଦମ୍ବର ମୂଳେ",
          "ନଟବର ବେଶ ହୋଇ",
          "ଘେନିଥିବ ଯେବେ ମୋହନ ମୁରଲୀ",
          "ଅଧରେ ଚୁମ୍ବିବ ନାହିଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପିନ୍ଧିଥିବ ଯେବେ ପୀତାମ୍ବର ତୁମ୍ଭେ",
          "ଭୂମିରେ ଲୋଟିବ ନାହିଁ",
          "ହସୁଥିବ ଯେବେ ମୃଦୁ ମୃଦୁ ହୋଇ",
          "ତେରଛେ ଚାହିଁବ ନାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଘେନିଥିବ ଯେବେ ଚନ୍ଦନର ବିନ୍ଦୁ",
          "ଗୋରଚନା ଥିବ ନାହିଁ",
          "ବାନ୍ଧିଥିବ ଯେବେ ତ୍ରିଭଙ୍ଗିମା ଚୂଳ",
          "ଚନ୍ଦ୍ରିକା ଖୋଷିବ ନାହିଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯେତେ ବେଶ ତୋତେ ମନା କଲି ଶ୍ୟାମ",
          "ତେତେ ବେଶ ହେଲୁ ତୁହି",
          "ବୋଲେ ବନମାଳୀ ଶୁଣ ଗୋ ରାଧିକେ",
          "ଏ ବେଶ ତୁମ୍ଭରି ପାଇଁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
