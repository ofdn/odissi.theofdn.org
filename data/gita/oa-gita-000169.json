{
  "id": "oa-gita-000169",
  "name": {
    "en": "Sajani aja rajani re",
    "or": "ସଜନୀ ଆଜ ରଜନୀରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000075"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-aja-rajani-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ଆଜ ରଜନୀରେ ନଇଲେ ବ୍ରଜମୋହନ",
          "ମନ କେହୁ ମୋହିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋ ଦେହେ ଦେଇ କରକମଳ ବାରମ୍ବାର",
          "ନିୟମ କରି କେତେ କହିଲା ରେ",
          "କପଟ ମତି କରି ସାହସେ ସେ କିପରି",
          "ଧରମ ତାକୁ ସହି ସହିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲଗାଇ ପ୍ରେମରସ ମଧୁ ଜନ୍ମାଇ ବିଷ",
          "ନୟନୁ ଅଶ୍ରୁ ବରଷାଇଲା ରେ",
          "ଭଜି ମୁଁ ନିଶା ଦିବା କି ଅପରାଧୁଁ ଅବା",
          "ମୋ ଠାରେ ଅବଧାନ ନୋହିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାଙ୍ଗି ରଖିଛି ପାନ କର୍ପୂର ଶ୍ରୀଚନ୍ଦନ",
          "ଏବେ ତ ବେଶ ବାସି ହୋଇଲା ରେ",
          "କାହା ସୁରତେ ମାତି ଆସି ହେଲା ପାହାନ୍ତି",
          "କୁକ୍କୁଟ କୁଆ ରାବେ ରଟିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ପାପ କାମ ମୋତେ ଦଣ୍ଡ ଦେଲାଣି ଯେତେ",
          "ପରାଣ ତୁଲେ ପିଣ୍ଡ ଦହିଲା ରେ",
          "କବିମିହିର ଚିନ୍ତା ଆହା ବ୍ରଜବନିତା",
          "କପାଳେ ବିହି ଏହା ଲିହିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
