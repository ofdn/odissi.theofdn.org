  "name": {
    "en": "Jagi rajani pahe sajani",
    "or": "ଜାଗି ରଜନୀ ପାହେ ସଜନୀ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000087"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jagi-rajani-pahe-sajani-jayasri-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜାଗି ରଜନୀ ପାହେ ସଜନୀ",
          "ମଉଳେ ନିତି ପରା ଗୁନ୍ଥା ଫୁଲହାରା",
          "ପଲକ ଆଖି ତାରା ପାଶୋରି ଦେଲାଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାଳି ଜାଗର ସାଜି ଶେଯ",
          "ମରମେ ମଲିଣି ମୁଁ ବରଜି ଲାଜ",
          "କୋଇଲି କାନେ ମୋ କୁହୁ ଗାଇଲାଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚନ୍ଦ୍ର ଚନ୍ଦନ ଗନ୍ଧ ବିଷ ମୋର",
          "ନୀର ସାଥି ଅଞ୍ଜନେ",
          "ଦୂରୁ ଦୂରୁ ଭିରୁ ମନ ଘାରେ",
          "ସପନେ ନିତି ସେ ନୟନେ ନାଚିଲାଣି"
        ]
      }
    ]
  },
  "sources": [
