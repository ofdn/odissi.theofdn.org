{
  "id": "oa-gita-000360",
  "name": {
    "en": "Jauchi ramaratana na ghenibu mane ana",
    "or": "ଯାଉଛି ରାମାରତନ ନ ଘେନିବୁ ମନେ ଆନ"
  },
  "composer": "oa-person-000070",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jauchi-ramaratana-na-ghenibu-mane-ana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯାଉଛି ରାମାରତନ ନ ଘେନିବୁ ମନେ ଆନ",
          "ପିଣ୍ଡକୁ ସିନାରେ ଧନ ନେଉଛି ରଖି ଜୀବନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରାଣ ବିନୁ ମୋ ଭରସା । ତୋ ବିନା କେ ଅଛି ରସା ।",
          "ନେତ୍ରୁଁ ନୀର ନ ବରଷା ଆସିବି ନୋହୁଁ ବରଷା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅତନୁ ସନ୍ତାପ ସହା । ନୁହଁରେ ମୃଣାଳବାହା ।",
          "ଥିଲା ମୋ କରମେ ଏହା କି କଲା ଦଇବ ଆହା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୋ ଛାର ପାଇଁକି ଦୁଃଖୀ । ହେଉରେ ଆଜନ୍ମସୁଖୀ ।",
          "ମୁଁ ସିନା ତୋ ପ୍ରୀତି ରଖିପାରିଲି ନାହିଁ ସୁମୁଖୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଙ୍ଗୀତପ୍ରବୀଣା ସହୀ । ସଙ୍ଗୀ ତ ନ ଥିଲା ହୋଇ ।",
          "ଭାଙ୍ଗି ତ ଦେଉଛି ବିହି ଆଦିତ୍ୟ ନୃପତି କହି"
        ]
      }
    ]
  },
