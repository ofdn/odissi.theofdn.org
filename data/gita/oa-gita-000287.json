{
  "id": "oa-gita-000287",
  "name": {
    "en": "Daruna netrantaku mu enu daruthai",
    "or": "ଦାରୁଣ ନେତ୍ରାନ୍ତକୁ ମୁଁ ଏଣୁ ଡରୁଥାଇ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/daruna-netrantaku-mu-enu-daruthai/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦାରୁଣ ନେତ୍ରାନ୍ତକୁ ମୁଁ ଏଣୁ ଡରୁଥାଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯହିଁକି କରଇ ମନା । ତହିଁକି କରି କାମନା ।",
          "ଅଗମ୍ୟ ପଥକୁ ଗମୁଥାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦେବତା ଦୁର୍ଲ୍ଲଭ ଚିଜେ । ଏ ପାପମନ ନ ବୁଝେ ।",
          "ଆଶା କରି ଲୋଭେ ମରୁଥାଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଡ଼ିଲେ ବୁଡ଼ି ରହଇ । ଲୋଡ଼ିଲେ ମିଳଇ ନାହିଁ ।",
          "କାନ ସେହୁ ରସେ ରସିଥାଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୃଗମଦ ନୀଳୋତ୍ପଳ । ତା ଶ୍ରୀଅଙ୍ଗ ପରିମଳ ।",
          "ନାସା ମୋର ଆଶା କରୁଥାଇ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତାର ଚର୍ବିତ ତାମ୍ବୂଳ । ଅଧ ଅଧରୁ କେବଳ ।",
          "ଚାଖିବାକୁ ଜିହ୍ୱା ଝୁରୁଥାଇ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବନମାଳୀ ବୋଲେ ମନ । ହେବାରୁ ତାର ଅଧୀନ ।",
          "ଜୀଇବା ଭରସା ଦିଶୁ ନାହିଁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
