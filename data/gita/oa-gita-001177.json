{
  "id": "oa-gita-001177",
  "name": {
    "en": "Adya margasira sisire sita",
    "or": "ଆଦ୍ୟ ମାର୍ଗଶୀର ଶିଶିରେ ଶୀତ"
  },
  "composer": "oa-person-000145",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/baramasi-adya-margasira-sisire-sita-adya-magusira-mahapurusa-achyutananda/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ବାରମାସୀ ଗୀତ",
          "ଆଦ୍ୟ ମାର୍ଗଶୀର ଶିଶିରେ ଶୀତ",
          "ଶ୍ରୀକୃଷ୍ଣ ଜାଣନ୍ତି ରାଧିକା ଚିତ୍ତ",
          "ଦୁଃଖୀର ଜୀବନ ଦୁଃଖୀ ସଙ୍ଗାତ",
          "କାହୁଁ ଆଣିଦେବି କମଳାକାନ୍ତ ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୌଷେ ଚନ୍ଦ୍ରାବଳୀ ଜପଇ ବସି",
          "ହସ୍ତେ ବର୍ଣ୍ଣମାଳା କଣ୍ଠେ ତୁଳସୀ",
          "ସେଦିନ ଗାଇବ ଗୋବିନ୍ଦବର",
          "କୃଷ୍ଣ କଥାଯାକ ପଡ଼େ ମନର ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାଘରେ ମାଧୋଇ ଆସିବେ ବୋଲି",
          "ଶେଯ ଶେଯାଇଲି ପାଖୁଡ଼ା ମଲ୍ଲୀ",
          "ଜାଳି ବସାଇଲି ମାଣିକ୍ୟବତୀ",
          "ଚକ୍ଷୁ ଉଜାଗରେ ରାତି ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଫଗୁଣ ମାସରେ ଦୋଳଗୋବିନ୍ଦ",
          "ଫଗୁ ଖେଳୁଥାନ୍ତି ପରମାନନ୍ଦ",
          "ଅବିର ସଙ୍ଗରେ ଝାଲେରୀ ମିଶାଇ",
          "ଫଗୁ ଖେଳୁଥାନ୍ତି ଯଦୁ ଗୋସାଇଁ ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚଇତ୍ର ମାସରେ ଫୁଟଇ ମଲ୍ଲୀ",
          "ଚୂଆ ଚନ୍ଦନକୁ ମୁଁ ତେଜ୍ୟା କଲି",
          "ମଲ୍ଲୀ ପୁଷ୍ପରେ ମୁଁ କରି ବିଞ୍ଚଣୀ",
          "ଯୋଗେ ଭେଟ ହେଲେ ଶାରଙ୍ଗପାଣି ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବୈଶାଖ ମାସରେ ଖରା ଗ୍ରୀଷମ",
          "ଚନ୍ଦନ କର୍ପୂର ଅଙ୍ଗେ ଲେପନ",
          "ଆଲଟ ଚାମର ଧରନ୍ତି ବାଳୀ",
          "ମୋ ପୁରେ ବିଜୟ ଶ୍ରୀ ବନମାଳୀ ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଜ୍ୟେଷ୍ଠ ମାସରେ ହୁଏ ଗୁଳଗୁଳି",
          "ସ୍ନାହାନକୁ ବିଜେ ଶ୍ରୀ ବନମାଳୀ",
          "ସ୍ନାହାନ ସାରି ଅଣସର ଗଲେ",
          "ଗୋପ ଯୁବତୀଙ୍କି ଅନାଥ କଲେ ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଆଷାଢ଼ ମାସରେ ଗୁଣ୍ଡିଚା ଯାତ",
          "ରଥେ ବିଜେ କଲେ ଶ୍ରୀ ଜଗନ୍ନାଥ",
          "ଆଗେ ବଳଭଦ୍ର ବସିଲେ ଯାଇ",
          "ମଧ୍ୟେ ସୁଭଦ୍ରା ଦେବୀ ପଛେ କହ୍ନାଇ ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଶ୍ରାବଣ ମାସରେ ଘୋର ବରଷା",
          "ସକଳେ ଛାଡ଼ି କୃଷ୍ଣରେ ଆଶା",
          "ନ ରୁଚଇ ମୋତେ ସୁବାସ ବାସ",
          "ଅନ୍ନ ପାଣିଯାକ ଲାଗୁଛି ବିଷ ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଭାଦ୍ରବ ମାସରେ ହରି ଜନମ",
          "ପରେ ପରେ ପ୍ରଭୁ ହେଲେ ଜନମ",
          "ଜନମ ହୋଇ ଗୋପରେ ବଢ଼ିଲେ",
          "କଂସାସୁରକୁ ଶେଷରେ ନାଶିଲେ ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ଆଶ୍ୱିନ ମାସରେ କୁଆଁରୀ ଜହ୍ନ",
          "ପଶା ଖେଳିବାକୁ ବଳୁଛି ମନ",
          "ଚନ୍ଦ୍ର କିରଣରେ ଖେଳନ୍ତି ପଶା",
          "କୃଷ୍ଣ କଲେ ମୋତେ ଭଗାରିହସା ମୋ କାହ୍ନୁରେ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "କାର୍ତ୍ତିକେ ସମ୍ପୂର୍ଣ୍ଣ ଏ ବାର ମାସ",
          "ବାଲୁକା ପୂଜି କରନ୍ତି ହବିଷ୍ୟ",
          "ଦାମୋଦର ପୂଜାଠାରେ ମୋର ଆଶ",
          "ଭାବରେ ଭଣିଲେ ଅଚ୍ୟୁତ ଦାସ ମୋ କାହ୍ନୁରେ"
        ]
      }
    ]
  },
