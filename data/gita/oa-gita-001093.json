{
  "id": "oa-gita-001093",
  "name": {
    "en": "Tana pana kara sara",
    "or": "ଟାଣ ପଣ କର ସାର"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000036"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ṭa Patala",
      "or": "ଟ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tana-pana-kara-sara-ta-champu-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଟାଣ ପଣ କର ସାର ହେ ମୋହନ",
          "ଟାଣ ପଣ କର ସାର",
          "ଟିକାଏ ମଦନ କଦନକୁ ସହୀ",
          "ସଦନକୁ ବିଜେ କର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଟଙ୍କାରି କି ଶ୍ରବସରିକି ବାସବ",
          "କୋଦଣ୍ଡରୁ ଚଣ୍ଡ ଧନୁ",
          "ଟାଣେ ବିନ୍ଧେ ଶମ୍ବ ସଦୃଶ କଳମ୍ବ",
          "ତୁମ୍ଭଙ୍କୁ ଏକା ଅତନୁ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଟେକି ଏ ସୁନ୍ଦର ଶ୍ରୀମୁଖଟି ପର",
          "ଘରବୁଡ଼ା ଫରମାସ",
          "ଟିକାଏ ହେଲେ ଯେ ହୃଦୟ ସରୋଜେ",
          "ନୋହିଲା ତ୍ରାସବିଳାସ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଟେକାଟେକି ମୋତେ କରି ନାନା ମତେ",
          "ତୁମ୍ଭ କାମନା ପୁରିବ",
          "ଟାଣଖୁଣ୍ଟା ଗୁରୁଜନ ଗଞ୍ଜନାରୁ",
          "ମୋ ପ୍ରାଣସଖି ସରିବ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଟପା ଥିବା ଚାର ବଚନୁ ଗୋଚର",
          "ଯେତେ ସମାଚାର ଗୋପେ",
          "ଟିପିଦେଲେ କଂସ ଆଗେ କେ ନୃଶଂସ",
          "ନନ୍ଦ ବନ୍ଦୀ ହେବେ ଟୋପେ ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଟାକିଛି ସୁଧାଂଶୁ କଳାକୁ ଆକାଶୁଁ",
          "କରିବାକୁ ପାଣିଗତ",
          "ଟିକାୟିତ ଅଷ୍ଟଦୁର୍ଗର କହଇ ଶ୍ୟାମ",
          "ଏ କି ଆଚରିତ ହେ"
        ]
      }
    ]
  },
  "sources": [
