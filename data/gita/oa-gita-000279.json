{
  "id": "oa-gita-000279",
  "name": {
    "en": "Saraswati binapani",
    "or": "ସରସ୍ୱତୀ ବୀଣାପାଣି"
  },
  "composer": "oa-person-000054",
  "mula_raga": [
    "oa-raga-000086"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/saraswati-binapani-harihara-rayaguru/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରସ୍ୱତୀ ବୀଣାପାଣି ଦେବୀ ତ୍ରିଭୁବନ ଚିନ୍ତାମଣି",
          "ଶରଣରକ୍ଷଣୀ ବିଦ୍ୟା ପ୍ରଦାୟିନୀ",
          "ବିଷ୍ଣୁଙ୍କ ଭାବିନୀ ଜନନୀ ନମାମି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୱେତବର୍ଣ୍ଣ ତନୁ କାନ୍ତି ଶୁକ୍ଳବସ୍ତ୍ର ପରିଧାନେ ମତି",
          "ସୁରାସୁର ନର ଗନ୍ଧର୍ବ କିନ୍ନର",
          "ତୁମ୍ଭ ପାଦପଦ୍ମେ କରନ୍ତି ଦଇନୀ",
          "(ପଡ଼ି)",
          "ସାରିଗାମାପାଧାନି ରାଗ ରାଗିଣୀ",
          "ମୂର୍ଚ୍ଛନା ଶ୍ରୁତି ଆଳାପକୁ ଘେନି",
          "ଉଦାରା ମୁଦାରା ତାର ଏ ତିନି",
          "କୋମଳାତି କୋମଳ ତୀବ୍ରାଦି ପ୍ରଚାରିଣୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁମୁଦବାନ୍ଧବାନନୀ ମାତ ଧବଳାମ୍ବୁଜ ଈକ୍ଷଣୀ",
          "ସୃଷ୍ଟିର ଜନନୀ ବ୍ରହ୍ମାଙ୍କ ନନ୍ଦିନୀ",
          "କବିକୁଳ ଚିନ୍ତାସମୁଦ୍ର ନାଶିନୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅରୁଣାଧର ମୃଦୁବାଣୀ ସିନ୍ଧୁଫଳ ରଜନୀ ନାରାୟଣୀ",
          "ଗରୁଡ଼ଧ୍ୱଜ ରକ୍ଷିଣୀ ବିଜୟେ କ୍ଷୀରାବ୍ଧି",
          "ତନୟା ସପ୍ତଣୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତବ ଶ୍ରୀଚରଣ ବେନି ହରିହର ରାୟଗୁରୁ ଭଣି",
          "ସଦା ଅପରାଧୀ ଅପରାଧ ମାନ",
          "କ୍ଷମ ପାଣି ଯୋଡ଼ି କରୁଛି ଦଇନୀ"
        ]
      }
    ]
  },
