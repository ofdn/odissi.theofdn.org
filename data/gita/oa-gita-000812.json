  "id": "oa-gita-000812",
  "name": {
    "en": "Sajani mun ki hudili",
    "or": "ସଜନୀ ମୁଁ କି ହୁଡ଼ିଲି"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000009"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-mun-ki-hudili-kedara-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ମୁଁ କି ହୁଡ଼ିଲି",
          "କରଗତ ଚିନ୍ତାମଣି ଜାଣୁ ଜାଣୁ ଛାଡ଼ିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେତେ ଯେ ବିନୟ କରି କହିଲେ ସେ କର ଧରି",
          "ଗରବ ଗୁମାନେ ଯାହା ଅକାରଣେ ବୁଡ଼ିଲି",
          "(ପଡ଼ି)",
          "ରୁଷି ବସି ମୁଁ କଥା କହିଲି ନାହିଁ ସହି",
          "ଖସି ଆସିଲି କୋଳୁ ପର ପରାଏ ବିହି",
          "କଲା କରମ ଫଳ ଏବେ ଭୋଗିଲି ମୁହିଁ",
          "ପୋଡ଼ୁ ବିବେକ ଧିକ ଜୀଇ ଯା ହେଲି ଦହି",
          "ଜାଣୁ ଜାଣୁ ପରମାଦ ଖଣାରେ ପଡ଼ିଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କହ ଯା ତୁ ସମୁଜାଇ ଅବଳା ମତି ହଜାଇ",
          "ବନ୍ଧୁରେ ବିମୁଖ କରି ମରଣ ମୁଁ ଲୋଡ଼ିଲି",
          "(ପଡ଼ି)",
          "ଧରି ବସିବେ କଲା ଅପରାଧ କି ମୋର",
          "ବରିଛି ପରା ସହି ସେ ମୋର ଚିତ୍ତଚୋର",
          "କାର ହେବି ମୁଁ ସେ ଗୋ କଲେ ଦୂର ବିଚାର",
          "ରୁଷିବି ନାହିଁ ଦିନେ କଲି ମୁଁ ସୀଉକାର",
          "ଭାଷେ ତୋଷେ କବିଚନ୍ଦ୍ର ତୋ ମନ ବିଡ଼ିଲି"
        ]
      }
    ]
  },
