{
  "id": "oa-gita-000388",
  "name": {
    "en": "Bhala bhulilu ta pritire",
    "or": "ଭଲା ଭୁଲିଲୁ ତା ପ୍ରୀତିରେ"
  },
  "composer": "oa-person-000082",
  "mula_raga": [
    "oa-raga-000068"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-bhulilu-ta-pritire-suddhadesi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଲା ଭୁଲିଲୁ ତା ପ୍ରୀତିରେ ପ୍ରାଣ ସଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲଗାଇ ପ୍ରେମ ମାଦକ ଭଗାରି ହସାକୁ ଦେଖ",
          "ଜଗାଇଦେଲୁ ଯା ରାତିରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କପଟୀ ଜନଙ୍କ ରୀତି ଶପଥପକା ଭାରତୀ",
          "ନିପଟ ନିରାଶ ରୀତିରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୁରୁଷ ଜାତି ବିଶ୍ୱାସ ପୂରୁବରୁ ନାହିଁ ଲେଶ",
          "ଜାର ପୁରୁଷଙ୍କ ମତି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସାମନ୍ତରା ନୃପ ଭଣି କାମ କାତି ଜାଣି ଶୁଣି",
          "ସମର୍ପି ଦେଲୁ ଯା ଛାତିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-bhulilu-ta-pritire-suddhadesi/"
    }
  ],
