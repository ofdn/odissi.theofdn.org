{
  "id": "oa-gita-001325",
  "name": {
    "en": "Sanchibi mu kehi e dine",
    "or": "ସଞ୍ଚିବି ମୁଁ କେହି ଏ ଦିନେ"
  },
  "composer": "oa-person-000074",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sanchibi-mu-kehi-e-dine-jhinjoti/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଞ୍ଚିବି ମୁଁ କେହି ଏ ଦିନେ, ସଜନୀ",
          "ଆରେ କହ ତୁ ଯାଇ ମୋହନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରସିକ ନାଗର ଏତେ ଦୁଃଖକୁ ଯା ଦେଲେ ମୋତେ",
          "କପଟ କଲେ ସେ କେତେ ଅଭିନ୍ନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପିଣ୍ଡ ପ୍ରାଣ ଥିଲି ବିକି ହୋଇ ଚରଣ ସେବକୀ",
          "ଜୀବ ନ ରହଇ ନିକି ଜୀବନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚିନ୍ତାମଣି କଳ୍ପଦ୍ରୁମ କର୍ମକୁ ଯା ହେଲେ ବାମ",
          "ଅରଜିବ ସିନା ଧର୍ମ ମଦନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବଡ଼ ହୃଦୟ ସରସ ମଣିଲ କି ହେ କୁଳିଶ",
          "ସଦୟ ନୋହିଲ ଲେଶ ସୁମନେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କରି ସ୍ନେହେ ଗଳାହାର ଛିଣ୍ଡାଇ ଦେଲା ତସ୍କର",
          "ଏବେ କଲ ପର ପର ବଚନେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଚତୁର ପଣ୍ଡିତ ଗୁଣବନ୍ତ ହେଲ ହେ କୃପଣ",
          "ଶିଖିଛ ପରା ଏ ଗୁଣ ନୂତନେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କ୍ଷୀରନୀରୁ ବଳି ଅତି ବଢ଼ାଇଲ ଭାବେ ପ୍ରୀତି",
          "କଲ ମଧୁଲିଟ ରୀତି ଗୁମାନେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ତୁଙ୍ଗ ଦକ୍ଷିଣରା ଭାଷି ଦୂତୀ ଶ୍ରୀମତୀଙ୍କ ତୋଷ",
          "ଆସିବେ ସୁକେଶି କେଶୀମନ୍ଥନେ"
        ]
      }
    ]
  },
  "sources": [
