{
  "id": "oa-gita-001038",
  "name": {
    "en": "Ehi pari sneha kari",
    "or": "ଏହି ପରି ସ୍ନେହ କରି"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000070"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ehi-pari-sneha-kari-thile-bihaga-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏହି ପରି ସ୍ନେହ କରି",
          "ଥିଲେ ଦୁଃଖ କି ରହିବ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜଗି ବସିଥିବ ଯାହା ପାଇଁ",
          "ରଜନୀ ଗଲା ଉତ୍ତାରୁ ପାହି (ପାଇ)",
          "ସେହି ଆସି ହସି ହସି",
          "ଯେବେ ବଚନ କହିବ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅନେକ ଯତ୍ନେ ଲୋଡ଼ାଇ ପୁଣି",
          "ପକ୍ୱ ତାମ୍ବୂଳ କୁସୁମ ଆଣି",
          "ରଖି ରଖି ଗଲେ ଶୁଖି",
          "ତହିଁକି ସୁଖ ନୋହିବ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଉ ଜଣକର ସଖୀ ତୁଲେ",
          "ଏକାନ୍ତରେ ବସି ଭାଳୁଥିଲେ",
          "ଜାଣି ଜାଣି ଶୁଣି ଶୁଣି",
          "ତାହା ଦେହ କି ସହିବ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରଘୁନାଥ କବି ନିଶାନାଥ",
          "କହଇ ସକଳ ମନୋରଥ",
          "ପୂର୍ଣ୍ଣ ହେବା ପାଇଁ ଦିବା",
          "ନିଶି ପଥ କେ ଚାହିଁବ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
