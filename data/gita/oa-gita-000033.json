{
  "id": "oa-gita-000033",
  "name": {
    "en": "Prana sajani kehi banchiba jamini",
    "or": "ପ୍ରାଣସଜନୀ କେହି ବଞ୍ଚିବ ଯାମିନୀ"
  },
  "composer": "oa-person-000022",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prana-sajani-kehi-banchiba-jamini-kedara-kamodi-tripata/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣସଜନୀ କେହି ବଞ୍ଚିବ ଯାମିନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖି ନବ କାଳିକା ଆହା ବାଳିକା",
          "କେମନ୍ତେ ବଞ୍ଚିବ ଏକା",
          "(ପଡ଼ି)",
          "ଝର ଝର ବରଷା ଦେଖି ଏ ରସାଭୂଷା",
          "ଏକା ମୋ କୋଳ ଆଶା",
          "ଏହିକାଳେ କି ଦଶା ହେଲା ଖଞ୍ଜନଦୃଶା",
          "କି କରୁଥିବ ବନ୍ଧୁ",
          "ଆହା ରସିକାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋ ହୃଦୟ ତମାଳକେଶୀ ତମାଳ",
          "ଦେଖନ୍ତେ ଏଖତମାଳ",
          "(ପଡ଼ି)",
          "ଏ ମହାଝଞ୍ଜାନଳ ଲାଗନ୍ତେ ନାରୀକୁଳ",
          "ମଦନେ କି ଆକୁଳ ହେବେ ପିନ୍ଧା ଦୁକୂଳ",
          "ଗରୁ ମଣି ସକଳ ଗଡ଼ୁଥିବ କମଳ",
          "ଜାତ ହୋଇ ନୟନୁ",
          "ଆହା ରସିକାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚଞ୍ଚଳରେ ଚଞ୍ଚଳା ଚମକ ଚାହିଁ",
          "ଆହା ମୋ ସ୍ନେହୀ ଚମକୁ ଥିବ ଯେ ସେହି ।",
          "(ପଡ଼ି)",
          "ଏ ଘନ ଘଡ଼ଘଡ଼ି ଭେକ ଡାହୁକ ରଡ଼ି",
          "ଶୁଣି ତନୁରେ ପୀଡ଼ି ଆଳି ପଦକୁ ଏଡ଼ି",
          "ଅଳିପରାଏ ବେଢ଼ି ଥିବେ ନିଶି ବାସରେ",
          "ଆହା ରସିକାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରଜେ ଚିରିବ ଧରା ବିମ୍ବା ଅଧରା",
          "କହୁଥିବ ପରା ଧୀରା",
          "(ପଡ଼ି)",
          "ଶ୍ରୀ ବରଜସୁନ୍ଦର ବ୍ରଜବନ୍ଧୁ ନରେନ୍ଦ୍ର",
          "ଅନୁଜ ବୋଲେ ଇନ୍ଦ୍ର ହେବି ରସିକବୃନ୍ଦ",
          "ମଧ୍ୟରେ ସେ ମୁକୁନ୍ଦ ଦର୍ଶନେ ପୂର୍ଣ୍ଣଚନ୍ଦ୍ର",
          "ଚୁମ୍ବିବା ବଳେ ମୋତେ",
          "ଆହା ରସିକାରେ"
        ]
      }
    ]
  },
