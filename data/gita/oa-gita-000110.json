{
  "id": "oa-gita-000110",
  "name": {
    "en": "Naba nagara kanha murali bajae",
    "or": "ନବ ନାଗର କାହ୍ନା ମୁରଲୀ ବଜାଏ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000047"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/naba-nagara-kanha-murali-bajae/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବ ନାଗର କାହ୍ନା ମୁରଲୀ ବଜାଏ",
          "ଶୁଖିଲା ତରୁକୁ ପଲ୍ଲବାଏ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶୀତ ଋତୁ ନୋହେ ତନୁ କମ୍ପାଏ",
          "ବିଶିଖ ନୋହେ ମରମକୁ ପାଏ",
          "ଶିଖୀ ନୋହେ ମାନସ ତତାଏ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେବା ଜାଣେ କେହୁ ମନ୍ତର ଗାଏ",
          "କର୍ଣ୍ଣେ ବାଜି ଆଉ ନ ଚଳେ ପାଏ",
          "ବଳେ ଧରି ମଦନେ ମତାଏ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହଟ କରି ଜଳଘାଟକୁ ଯାଏ",
          "ଆଭିରୀ କୁଳେ କଳଙ୍କ ଲଗାଏ",
          "ନୀପମୂଳେ ଉଭା ଶୋଭା ପାଏ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଏହୁ ରସରେ ଗାଏ",
          "ଅସତ କଥାକୁ ସତ କରାଏ",
          "ତାହା ଘେନି ଏତେ ଦୁଃଖ ପାଏ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
