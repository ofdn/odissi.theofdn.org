  "name": {
    "en": "Pasori deluki sate sajani",
    "or": "ପାଶୋରି ଦେଲୁକି ସତେ ସଜନୀ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pasori-deluki-sate-sajani-asabari-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପାଶୋରି ଦେଲୁକି ସତେ ସଜନୀ",
          "ସେ ତ ନ ଭୁଲେ ତୋ ନାଁ",
          "ଯମୁନା କଲା କେ ମନା ନ ଯିବୁ କହୁ ନବୀନା",
          "ହସିବେ ସଖୀ ସିନା ଜନେ ନିରେଖି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିହରି କଦମ୍ବ ବନ ଆସେ ଏ ମୁରଲୀ ସ୍ୱନ",
          "କେ ବୋଲେ ଏ ଗୁମାନ ହେଲା ତୋ ଲାଖି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କହିବୁ କଲା ସେ ଦୂର ପଚାର ଅନ୍ତରେ ତୋର",
          "ଗଗନ ଶଶୀ ତାର ଅଛି ତ ସାକ୍ଷୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରତନ ଜାଣି ହରାନା ନୟନୁ ବାରି ଝରାନା",
          "ଚାନ୍ଦନୀ ହସେ ଅନା ଅନା ସୁମୁଖୀ"
        ]
      }
    ]
  },
  "sources": [
    {
