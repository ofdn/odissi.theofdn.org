  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pahi-pahia-dinabandhuraja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପାହି ପାହିଆ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପାହି ବ୍ରଜପୁର ଯୁବ ପୁରନ୍ଦର",
          "ପାହି କରଧୃତ ମନ୍ଦରଂ",
          "ପାହି କୃତ ଅଭିସାର କନ୍ଦର",
          "ପାହି ନବଘନ ସୁନ୍ଦରଂ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମତ୍ତ ବାରଣ ଗର୍ବ ନାଶନ",
          "ଗମନ ଜନମନ ରଞ୍ଜନ",
          "ମୀନ କେତନ ଝଷ ନିକେତନ",
          "ଯାମଳାର୍ଜ୍ଜୁନ ଭଞ୍ଜନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନନ୍ଦନନ୍ଦନ ଜଗତ ବନ୍ଦନ",
          "ମୁରଲୀଧର ବ୍ରଜନାଗର",
          "କମଳ ଲୋଚନ ଶୋକନାଶନ",
          "ସକଳ ଗୁଣଗଣ ସାଗର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୋଟି ଶାରଦ ଚନ୍ଦ୍ରମା ମୁଦ",
          "ବନଜ ରୁଚି ମୁଖ ଶ୍ୟାମଳ",
          "ଗଣ୍ଡ ସୁଶୋଭିତ ରତନ ସୁଜଡ଼ିତ",
          "ମକର ସୁରୁଚିର କୁଣ୍ଡଳ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନାଗରୀ ଜନ ଚିତ୍ତ ମୋହନ",
          "ବସନ ରୁଚି ଜିତ କୁନ୍ଦନ",
          "ନିତ୍ୟ ନର୍ତ୍ତନ ଶରଣ ତବ",
          "ଦୀନବନ୍ଧୁରାଜ ହରିଚନ୍ଦନ"
        ]
      }
    ]
  },
  "sources": [
