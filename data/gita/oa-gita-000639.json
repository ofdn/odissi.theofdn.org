  ],
  "kabya": {
    "id": "oa-kabya-000002",
    "section": {
      "en": "Ga Patala",
      "or": "ଗ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gumana-kariba-brutha-re-gujjari-nihsari-kabisurjya-premodaya-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୁମାନ କରିବା ବୃଥା ରେ ସଙ୍ଗିନୀ",
          "ଗୁମାନ କରିବା ବୃଥା",
          "ଗତି ତ ନ ଥିବ ଘନଶ୍ୟାମ ବିନୁ",
          "ଖଣ୍ଡିବାକୁ କାମ ବ୍ୟଥା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗରବ ପରବ ଚନ୍ଦ୍ରମାକୁ ନିନ୍ଦେ",
          "ଯେଉଁ ଶିରୀମୁଖ ଦ୍ୟୁତି",
          "ଗଲେ ଯିବ ପଛେ ଜୀବ ଆଉ ଥରେ",
          "ଦେଖିବାକୁ ବଳେ ମତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗଗନ ମଣି ତନୟା ତଟଚାରୀ",
          "ବାରିରୁହ ଚାରୁ ନେତ୍ର",
          "ଗାଢ଼ ପରିରମ୍ଭ ବିନା ସଖି ଦମ୍ଭ",
          "ଭଜି ପାରେ କି ମୋ ଗାତ୍ର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୁରୁ ହେଲାନି ପିନ୍ଧିବା ସରୁ ବାସ",
          "ବାସରେ ନ ରହେ ମତି",
          "ଗୋଟିଏ ବାସର କଳପ ମଣଇଁ",
          "ଦେଖି ବାସନ୍ତୀକ ରୀତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗରଳ ପରି ଉପବନ ପବନ",
          "ଲାଗୁଅଛି ମୋତେ ସଖି",
          "ଗଲାଟି ଜୀବନ ଭଣେ ଜଗଦ୍ଦେବ",
          "ଆଉ ନ ପାରେ ମୁଁ ରଖି"
        ]
      }
    ]
  },
  "sources": [
    {
