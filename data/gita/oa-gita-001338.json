      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahachari-re-achi-ete-manoratha-kabisurjya-kamoda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହଚରୀ ରେ ଅଛି ଏତେ ମନୋରଥ କରି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତମାଳ ମହେନ୍ଦ୍ର ମଣି ଅପଘନ",
          "ପରିରମ୍ଭଙ୍କୁ ମୁଁ ଅଟେ କି ଭାର୍ଜନ",
          "କେବଳ ଡାକିବ ଥରେ ସେ ମୋହନ",
          "ମୁରଲୀ ମୋ ନାମ ଧରି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପଲ୍ଲବ ବିଦ୍ରୁମ ବନ୍ଧୁକ ସଙ୍କାଶ",
          "ଅଧର ମଧୁକୁ ନାହିଁ ମୋର ଆଶ",
          "ପିଉ ଥରେ ଶ୍ୟାମ ମୁଖଚନ୍ଦ୍ର ହାସ",
          "ଶୋଭା ମୋ ନେତ୍ର ଚକୋରୀ ରେ"
        ]
      }
    ]
  },
