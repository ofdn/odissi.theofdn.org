{
  "id": "oa-gita-000564",
  "name": {
    "en": "Jagabandhu dayalu thau mana",
    "or": "ଜଗବନ୍ଧୁ ଦୟାଳୁ ଥାଉ ମନ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jagabandhu-dayalu-thau-mana-gopalakrusna-sankarabharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଗବନ୍ଧୁ ଦୟାଳୁ",
          "ଥାଉ ମନ କାହିଁ ପାଇଁ ଭାଳୁରେ",
          "ରହ ଉଦ୍ଧରିବେ ଏ ଜଞ୍ଜାଳୁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିରୂପାଧି କୃପାକର ମହିମାବଧି",
          "ନୀଳାଚଳ ସୁଧାକର",
          "ନିଖିଳ ପ୍ରାଣୀ ହିତକାରୀ ତୋ",
          "ଛାର କଦନ କି ତାକୁ ଘୋର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରତିବଦାନ୍ୟେଶ ସ୍ୱରୂପ ଆର୍ଥିଙ୍କ",
          "କରୁଣା ନୃପେ ପ୍ରସନ୍ନେ",
          "ଯୁବତୀଙ୍କ କାମ ସଖାକୁହିଁ ସମ",
          "ଅଧୀନ ସ୍ୱଭକ୍ତଜନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦାମୋଦର ଗଲେ ନ ମାଗୁ ଯା",
          "ଦେଲେ ଶୁଣିତ ଥିବ ପୁରାଣେ",
          "ବୃଥା ହୋଇବ କପି ଜଣାଇବାର",
          "ତୁ ପ୍ରଣାମ କରି ଚରଣେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୃପାଳୁ ପଣ କେ କଳିବ ପିଆଇ",
          "ଦେଇଥିଲା ବିଷ ବକୀ",
          "ଦୋଷ ଘେନି କିସ ଦଣ୍ଡିବେ",
          "ଜନନୀଗଣରେ ଦେଲେ ଗତିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନୃପମଣି ଗୋପି ସୀତା ପିତୃଙ୍କର",
          "ଶତ୍ରୁ କ୍ଷୟ ଆତ୍ମ ମୋକ୍ଷ",
          "କରିଛି ଯା ନାମ ମାତ୍ରକେ ସେ ପ୍ରଭୁ",
          "ହୋଇଅଛନ୍ତି ପ୍ରତ୍ୟକ୍ଷ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବାରଣକର ପରିତ୍ରାଣ ଘୋଷଣ",
          "ବ୍ରହ୍ମାଣ୍ଡ ଭିତ୍ତି ଫିଟାଇ",
          "ବାହାରି ଯାଇଛି ନ କରି ସ୍ମରଣ ଦୁଃଖୀ",
          "ଦୁଃଖୀହେଉ କାହିଁପାଇଁ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କୁରୁସଭା ତଳେ ଡାକିବାର ବେଳେ",
          "ଯାହା ଦେଲେ ଦ୍ରୌପଦୀଙ୍କି",
          "ଆଉ ତାହା ପୁଣି ବୋଲି ମୁଁ ତା ଋଣି",
          "କହୁଅଛନ୍ତି ଯେ ଡାକି"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଭକ୍ତ ବନ୍ଧୁ ପଣ ଭାରତ ଯୁଦ୍ଧରେ",
          "ଭୀଷ୍ମଠାରେ ଦିଶାଇଲେ",
          "ନିୟମ ଲଙ୍ଘି ରଥରୁ ଡେଇଁ",
          "ରଥଚରଣ ଧରି ଧାଇଁଲେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଶରଣ ପଶି ବିଭୀଷଣ ଆସିଛି",
          "ବୋଲି କହୁଁ ଶ୍ରୀଛାମୁରେ",
          "ଦେଲେନି ସେତେବେଳକୁ ତାକୁ",
          "ଲଙ୍କପଦବୀ ଭୁରୁ ଲୀଳାରେ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ବିଧି ପଦ ସୁଖ ବୋଲି ହନୁମାନ",
          "କଲାରୁ ଅନୁମୋଦନ",
          "ବ୍ରହ୍ମା କରିବେ ରଖିଛନ୍ତି ପ୍ରଭୁ",
          "କେ ଏପରି ଜାଣିବ ମନ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ଧ୍ରୁବ ମନୋରଥ ପୂର୍ଣ୍ଣ କରିବାରେ",
          "ପ୍ରତ୍ୟକ୍ଷରେ ତ ଦିଶୁଛି",
          "ଚରଣ ପଙ୍କଜ ରଜରେ ପଥରେ",
          "ପଥର ନାରୀ ତରିଛି"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ପ୍ରହର ଅର୍ଦ୍ଧକେ ଧୂଳି କଲେ ଭକ୍ତ",
          "ବଇରୀ ରାକ୍ଷସ ମେରୁ",
          "ସେ ପ୍ରହଲାଦଙ୍କ ବିପଦଠାରୁ ତ",
          "ନୁହଁଇ ତୋ ଖେଦ ଗୁରୁ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ଭଜନ କୀର୍ତ୍ତନ ଆତ୍ମସମର୍ପଣ",
          "ଦାସ୍ୟ ସଖ୍ୟାଭିବାଦନ",
          "ସ୍ମରଣ ପୂଜା ଶ୍ରବଣ ନବରତ୍ନ",
          "କୂଟ କରିଛନ୍ତି ଦାନ"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ରମା ଶୁକ ବଳି ହୁନମାନାର୍ଜ୍ଜୁନ",
          "ଅକ୍ରୂର ଦୈତ୍ୟ ତନୁଜ",
          "ପୃଥୁ ପରୀକ୍ଷତ ହୋଇ ଅଳଂକୃତ",
          "ଲଭିଛନ୍ତି ପଦକଞ୍ଜ"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ବୋଲିବୁ ମୁଁ ଦୀନ ଭଜନ ସାଧନ",
          "ନ ଜାଣଇ ଜନମରୁ",
          "ଅଜାମିଳ ଯାମଳାର୍ଜ୍ଜୁନ କି ତପ",
          "କରିଥିଲେଟି ପୂର୍ବରୁ"
        ]
      },
      {
        "n": 16,
        "lines": [
          "ଯା ଗୁଣାର୍ଣ୍ଣବରୁ ବିନ୍ଦୁଏ ବର୍ଣ୍ଣିଲେ",
          "ଶେଷରେ ନ ହେବ ଶେଷ",
          "କି କହିବି ତାହା ଗୋପାଳକୃଷ୍ଣ ତ",
          "ନୁହଁଇ କୀଟ ସଦୃଶ"
        ]
      }
    ]
  },
