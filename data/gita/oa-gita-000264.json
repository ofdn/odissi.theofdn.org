{
  "id": "oa-gita-000264",
  "name": {
    "en": "Bandhu mo na bhanga asa re",
    "or": "ବନ୍ଧୁ ମୋ ନ ଭାଙ୍ଗ ଆଶା ରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bandhu-mo-na-bhanga-asa-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବନ୍ଧୁ ମୋ ନ ଭାଙ୍ଗ ଆଶା ରେ",
          "ଯୋଷାରତନ ରସାଭୂଷା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚନ୍ଦ୍ର ଚକୋର ପରାଏ ତୋର",
          "ପଥ ଚାହୁଁଛି ମୃଗଦୃଶା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜନମାନ୍ତର ସୁକୃତ ମୋର",
          "ତୋ କୃପା କଟାକ୍ଷରେ ଦିଶା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୋତି ବଦନ ସ୍ମର କଦନ",
          "ଅକୂଳ ନଦୀରେ ନ ଭସା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୁଧା କଳପ କଥା ଅଳପ",
          "କହି ନିବାର ଚିର ତୃଷା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ହେଲେ ସମ୍ମୁଖ କହିବି ଦୁଃଖ",
          "ଘେନିବୁ ଥାଇ ଏ ଭରସା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶୁଣି ଲପିତ ଦେଲା ସଙ୍କେତ",
          "ଗୋପାଳକୃଷ୍ଣକୁ ସୁରସା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
