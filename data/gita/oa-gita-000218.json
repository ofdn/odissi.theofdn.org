{
  "id": "oa-gita-000218",
  "name": {
    "en": "Gopie arghya bandanti",
    "or": "ଗୋପୀଏ ଅର୍ଘ୍ୟ ବନ୍ଦାନ୍ତି"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gopie-arghya-bandanti/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୋପୀଏ ଅର୍ଘ୍ୟ ବନ୍ଦାନ୍ତି",
          "ମଙ୍ଗଳ ଶୁଭ ମଙ୍ଗଳ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୋଧନ ବାହୁଡ଼ା ବେଳେ",
          "ଗୋରୁ ଗୋପାଳଙ୍କ ମେଳେ",
          "ପଛେ ଶ୍ରୀକୃଷ୍ଣ ଗୋପାଳେ",
          "ଖୋଷି ଜାମୁଡାଳେ ଡାଳେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଜାଇ ଖେମଟା ତାଳ",
          "କରତାଳି କୁତୂହଳ",
          "ନାଚନ୍ତି ନନ୍ଦଦୁଲାଳ",
          "ଗୋପନଗର ଚହଳ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କର୍ଣ୍ଣରେ କୁଣ୍ଡଳ ଲୋଳେ",
          "ତୃପ୍ତ ତାଳ ପଡ଼ିତାଳେ",
          "ବଂଶୀ ବାଇ ନେତ୍ର ଢାଳେ",
          "ହରଷେ ମନକୁ ହରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଦ୍ମନାଭ ଦେବ ବୋଲେ",
          "ଏହା ନୁହେଁ କେତେବେଳେ",
          "ଶ୍ରୀକୃଷ୍ଣ ରସେ ରସିଲେ",
          "ପାଇ ଅବା ଭାଗ୍ୟ ଥିଲେ"
        ]
      }
    ]
  },
  "sources": [
