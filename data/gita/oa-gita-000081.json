{
  "id": "oa-gita-000081",
  "name": {
    "en": "Saji tanu maji rajila ta aji",
    "or": "ସାଜି ତନୁ ମାଜି ରାଜିଲା ତ ଆଜି"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/saji-tanu-maji-rajila-ta-aji/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଜି ତନୁ ମାଜି ରାଜିଲା ତ ଆଜି",
          "ମହୀରେ ସଜ ବସନ୍ତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଉଡ଼ାଇ ରଙ୍ଗ ବାନାରେ ସଜନୀ",
          "ରସାଳ କୁଞ୍ଜେ ଅନାରେ । ନବସୁମନା ।",
          "(ପଡ଼ି)",
          "ଭାଲ ମୁନ ସଳଖି ତୀର କି ଦେଲା ଯୋଖି",
          "ପିକ ଡଗରା ସାକ୍ଷୀ ଗାଏ କୁହୁକୁ ଡାକି",
          "ଅଧୀର ମଳୟ ସତେ ସାରିଦେଲା ଲାଜ ମହତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବୀନ ଜନ ନିଆଳିରେ ସଜନୀ",
          "ତୋ ହେଲେ ଗେଲେ ଛଇଳୀରେ । ସରାଗେ ଫୁଲିରେ ।",
          "(ପଡ଼ି)",
          "ଅଳି ବସୁଛି ମିତ ଶତ ବାଇଆ ସେ ତ",
          "ଚାଟୁବାଣୀ ଭଣିତ ଗାଇବ ଗୁଞୀତ",
          "ହରିବ ସାରିବ ମାନ ଝୁରି ମରିବାର ତ ସତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚାରୁ ଚାନ୍ଦିନୀ ରାତିରେ ସଜନୀ",
          "ଉଲ୍ଲସି ଉଠେ ଛାତିରେ । ହେଲେ ମତିରେ ।",
          "(ପଡ଼ି)",
          "ଚିହ୍ନାପରି କେ ମୋତେ ଛୁଇଁଗଲା ଚକିତେ",
          "ଗୋପନ କଥା ଯେତେ ଚେତି ଅନୁବରତେ",
          "ନୟନେ ଲେଖିଲା ଭାଷା କବିଶଶୀ ବାରିଗଲା ତ"
        ]
      }
    ]
  },
  "sources": [
