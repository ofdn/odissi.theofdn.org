    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରଥମ ପ୍ରଭାତେ ଉଦାସିଆ ସୁରେ",
          "ଗାଅରେ ରାଗ ସାବେରୀ",
          "ଋଷଭ ଧୈବତ କୋମଳ କରି",
          "ବିହରେ ବିରସେ ମେଳ ଗୌରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଔଡ଼ବ ଜାତି ଘେନି ଆରୋହରେ",
          "ପୂର୍ଣ୍ଣ ସ୍ୱରୂପ ମାନ ଅବରୋହରେ",
          "ମଧ୍ୟମ ଷଡ଼ଜ ନରେଶ ସଚିବ",
          "ମଳିନ ନିଷାଦ ଗାନ୍ଧାର କରି"
        ]
      }
    ]
  },
