  "name": {
    "en": "Hari pasare sajani",
    "or": "ହରି ପାଶରେ ସଜନୀ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000040"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000002",
    "section": {
      "en": "Ha Patala",
      "or": "ହ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hari-pasare-sajani-ramakeri-ekatali-kabisurjya-premodaya-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହରି ପାଶରେ ସଜନୀ ଥାଉ ଗୋ ଆଜ ରଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେଲାନି ସଖୀର ହାସ ବଦନ ଚନ୍ଦ୍ର ପ୍ରକାଶ",
          "ତେଜିଲାଣି ଶ୍ୟାମ ରୋଷ ଏଠାରୁ ଗୋ ଯିବା ଆସ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହଟିଛି ମଦନ ରାଜି ବିନ୍ଧି ଶାୟକ ସମାଜ",
          "ନାଶିବାକୁ ସଖୀ ଲାଜ କଲା କି ଗୋ ଧନୁ ସଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହିମ ବିନା କମ୍ପେ ତନୁ ସ୍ୱେଦ ସଖୀ ଅପଘନୁ",
          "ବହଇ ସନ୍ତାପ କିନୁ ନ ସ୍ଫୁରେ ବାଣୀ ମଦନୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହେବାରୁ ସ୍ମର ଆୟତ୍ତ ହେଲେହେଁ ପ୍ରିୟ ସଙ୍ଗାତ",
          "ଆମ୍ଭଙ୍କୁ ତେଜିବା ଚିତ୍ତ କଲାନି ଗୋ ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ହରଷରେ ରାମ ସୋମ ଧରି ନିଜ ହୃଦେ ପ୍ରେମ",
          "ଭାବିଲାନି ଘନଶ୍ୟାମ ପଦ ଅଷ୍ଟଦୁର୍ଗ ଧାମ"
        ]
      }
    ]
  },
