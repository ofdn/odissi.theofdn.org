{
  "id": "oa-gita-000178",
  "name": {
    "en": "Ke bhajana karu kahaku",
    "or": "କେ ଭଜନ କରୁ କାହାକୁ"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ke-bhajana-karu-kahaku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେ ଭଜନ କରୁ କାହାକୁ",
          "ମୋ ମନ ମଜ୍ଜିଲା କୃଷ୍ଣପଦକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପୁରନ୍ଦରମଣି ଜିଣା ବରନ",
          "କେବଳ ମାତ୍ର ମୋହର ଶରଣ",
          "ଶ୍ରୀରାଧାଗୋବିନ୍ଦ ଦୁହିଁଙ୍କ ବିନାରେ",
          "ସ୍ମରଣେ ଆଣିବି ନାହିଁ ଚିତ୍ତକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବୀନ କିଶୋର ଶ୍ୟାମସୁନ୍ଦର",
          "ଚରଣ ଯୁଗଳେ ନିତ୍ୟ କିଙ୍କର",
          "-ପଣେ ଏକା ଦିନ ଯିବ ଏହି ମନ",
          "ବାଞ୍ଛା କରିଅଛି ପୂର୍ଣ୍ଣ ହେବାକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରକାଶ କରିବା କଥା ଏ ନୋହେ",
          "ସ୍ମରଣା କରୁଥିବି ମାତ୍ର ସ୍ନେହେ",
          "ବାହ୍ୟ ଭିତରେ ଯେ କରନ୍ତି ସଞ୍ଚାର",
          "ସେ ଜାଣନ୍ତୁ ଏକା ମୋର ନିଷ୍ଠାକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନିନ୍ଦା ବନ୍ଦନାରେ କି ହେବ ଫଳ",
          "ଦୋଷ ମାତ୍ର ସିନା ହୋଇବ ଠୂଳ",
          "ଜାଣି ଜାଣି କେଉଁ କାରଣେ ଅନଳ",
          "ଆଣି ବଢ଼ାଇ ଘେନିବି କରକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ଗୌରହରି ପ୍ରତି ଜନ୍ମରେ",
          "ଏହି ଅନୁକମ୍ପା ଥାଉ ମୋ ଠାରେ",
          "ମୋ ପରିରେ ହେଲେ ଜଣେ ପତିତରେ",
          "ଅଛି ବୋଲି କେ ନେବ ବଦନକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
