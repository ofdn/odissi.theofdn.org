  "id": "oa-gita-000607",
  "name": {
    "en": "Nanda sutaku chahan",
    "or": "ନନ୍ଦସୁତକୁ ଚାହାଁ"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000009"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-sutaku-chahan-raga-punnaga/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନନ୍ଦସୁତକୁ ଚାହାଁ",
          "ଇନ୍ଦ୍ରର ନୀଳମଣି ପ୍ରଶଂସୁ ଯାହା ।",
          "ସରସ ସରୋରୁହ ଶରଦ ଶଶୀ ସ୍ନେହ",
          "ସାରଇ ମନୁ ଶୋଭା ସାର ଶ୍ରୀମୁଖ ଆଭା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୁଳ ଚନ୍ଦ୍ରକ ମୂଳରୁ ଏ ବକୁଳ ମାଳତୀ କୁଳରୁଚିକି",
          "ବହୁଳରେ ଅତି ଠୂଳ ସୌରଭ ତୁଲ ନାହିଁ ଅତୁଳ ସତ ସହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରାତ ଅରୁଣର ତାତ କି ଅଧର",
          "ଜାତ ହେଲା ଯହୁଁ ଖ୍ୟାତ ସୁରୁଚିର",
          "ପାତଳ ହିଙ୍ଗଳ ପାତଳକୁ ନୋହେ",
          "ତାତ ଦେଖି ତନୁ କାତରକୁ ବହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାରିଚୟ କୁଳବାରି ଦେଇ ନ",
          "ପଚାରି ହେବେ ପରିଚାରୀ ଏ ବକାରି",
          "ଛବିକି ତ ଚାରି ଦଶ ପୁରେ",
          "ପାରିବ କେ କହି ହାରିଯିବ ବିହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ୟାମ ନବଘନ କାମ ମଦହର",
          "ବାମନେତ୍ରୀର କାମଦ ରୁଚିର",
          "ଧାମ ଛବି ଅନୁପାମ ଏ ଅଭିରାମ",
          "ଏ ଦୀନ ରାମକୃଷ୍ଣର"
        ]
      }
    ]
  },
  "sources": [
