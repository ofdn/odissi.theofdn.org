{
  "id": "oa-gita-001069",
  "name": {
    "en": "Krusnakali malasri",
    "or": "କୃଷ୍ଣକାଳୀ ମାଳଶ୍ରୀ"
  },
  "composer": "oa-person-000083",
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/krusnakali-malasri-jaya-krusnakali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୟ କୃଷ୍ଣକାଳୀ ଧୃତ ମୁଣ୍ଡମାଳୀ",
          "ତ୍ରିଭଙ୍ଗ ଛନ୍ଦେ ବିହାର",
          "ମାଗୋ ଅଭୟ ବର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାଗୋ ହସ୍ତକେ ଅଭୟ ହସ୍ତକେ ବର",
          "ପୁଣି ହସ୍ତକେ ଖଣ୍ଡା ଦୈତ୍ୟ ଶିର",
          "ଚତୁର୍ଭୁଜେ ଶୋହେ ଆୟୁଧ",
          "ପୁଣି ନୈବେଦ୍ୟ ଲବଣୀସର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମାଗୋ ନିଶି ଅର୍ଦ୍ଧରେ ତ ମହୀବିହାର",
          "ପୁଣି ରାଧିକା ଦୂତିକା ସଙ୍ଗରେ ତୁମ୍ଭର",
          "ମନୋରଥ ପୂର୍ଣ୍ଣ କର ସତ୍ୱର",
          "ପୁଣି ବିଜେ କରିଯାଉ ସିଂହ ପୃଷ୍ଠର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାଗୋ ଆଜନ୍ମ କାଳରୁ ବିକଳ",
          "ପୁଣି ଦୁଃସହ ସଙ୍ଗରୁ ମୋତେ ଉଦ୍ଧର",
          "ଦୀନ ନାରାୟଣ ବିନୟ ଶିର",
          "ପୁଣି ସଙ୍କଟ ତାରିଣୀ ବାନା ତୁମ୍ଭର"
        ]
      }
    ]
  },
  "sources": [
