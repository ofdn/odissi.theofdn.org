{
  "id": "oa-gita-001347",
  "name": {
    "en": "Syama pritire sajani galiti sari",
    "or": "ଶ୍ୟାମ ପ୍ରୀତିରେ ସଜନୀ ଗଲିଟି ସରି"
  },
  "composer": "oa-person-000050",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-pritire-sajani-galiti-sari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ପ୍ରୀତିରେ ସଜନୀ ଗଲିଟି ସରି",
          "ବଂଶୀ ଦେଲା ମୋ ଧଇର୍ଯ୍ୟକୁ ଜୂର କରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେ ଜାଣିଥିଲା ଏପରି ହଟିଆ ନାଗର ହରି",
          "କି ମନ୍ତ୍ର କରି ସେ ମୋ ଗୁମାନକୁ ଦେଲା ସାରି",
          "(ପଡ଼ି)",
          "ଲାଜ ଭୟ ଦୂର କରି ତା ଗୁଣ ହୃଦେ ସୁମରି",
          "ଦିବା ନିଶି ଝୁରି ଝୁରି ନେତ୍ରୁ ଏବେ ବହେ ବାରି",
          "ଏ ଗୋପପୁରେ ମୋ ପରି ନାହାନ୍ତି ରେ ସହଚରୀ",
          "ଯେଣେ ଗଲେ ଅପବାଦ କଳଙ୍କ ରହିଛି ପୂରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦୀନକୃଷ୍ଣ ବୋଲେ ସରି ଗଲିଟିରେ ସହଚରୀ",
          "ତା ନେତ୍ର କଟାରୀ ମାରି ହୃଦେ ମୋର ଦେଲା ଘାରି"
        ]
      }
    ]
  },
