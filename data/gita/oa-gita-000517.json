{
  "id": "oa-gita-000517",
  "name": {
    "en": "Alo parana sahi tuchhaku sina e rosa",
    "or": "ଆଲୋ ପରାଣ ସହୀ ତୁଚ୍ଛାକୁ ସିନା ଏ ରୋଷ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/alo-parana-sahi-tuchhaku-sina-e-rosa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଲୋ ପରାଣ ସହୀ",
          "ତୁଚ୍ଛାକୁ ସିନା ଏ ରୋଷ ଅଛି ବହି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଲେ ମୁଁ ନିରାଶ ରାସବିହାରୀଙ୍କି",
          "ଜାଣି ତା ହୁଅଇ ଦୀନ",
          "ଜଗି କେତେ କରେ ଦୈନ୍ୟ",
          "ମୋତେ ଚାହିଁ ପ୍ରତିଦିନ",
          "ସଖୀ ଏ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଢ଼ାଉଛି ମୁହିଁ ଯେତେ ଅନାଦର",
          "ବଢ଼ାଇଲା ମନେ ତାର",
          "ସବୁ ଏ ପ୍ରେମ ସଞ୍ଚାର",
          "ପୂରୁବୁଁ ଅଧିକେ କଲା ଆଦର",
          "ସଖୀ ଏ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାନା ଗାଳି ଦେଲେ ମଣେ ପରିହାସ",
          "ତେଜ ମୁଖ ପରସନ୍ନ",
          "କରଇ ତା ଦରଶନ",
          "ପ୍ରଣୟ କୋପ ଏ ବୋଲି ହୁଏ ତୋଷ",
          "ସଖୀ ଏ କି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୂରୁ ଚାହିଁ ଅନ୍ତର ମୁଁ ହେଲି ସଖୀ",
          "ଜାଣଇ ମୋହର ଲୋଭ",
          "ବଢ଼ିବାକୁ ଏ ଆରମ୍ଭ",
          "କରେ କରୀନ୍ଦ୍ରଗମନା ହୁଏ ସୁଖୀ",
          "ସଖୀ ଏ କି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦେଲେ ଅପବାଦ ଅସହଣୀମାନେ",
          "ସେ ତ ଅତ୍ୟନ୍ତ ଲମ୍ପଟ",
          "ମଣଇଁ ହେଲି ମୁଁ ଶ୍ରେଷ୍ଠ",
          "ଏଥି ମୋ କି ଦୋଷ ନ ବିଚାର ମନେ",
          "ସଖୀ ଏ କି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶୁଣ ପ୍ରିୟ ଆଳି ବୋଲେ ଗଲା ଜଣା",
          "ଆମ୍ଭେ ତା ନ ଦେଖୁଁ ଦିନେ",
          "ନ ଶୁଣୁ ତାହା ଶ୍ରବଣେ",
          "ବନମାଳୀକି ପରତେ ପ୍ରତାରଣା",
          "ସଖୀ ଏ କି"
        ]
      }
    ]
  },
  "sources": [
    {
