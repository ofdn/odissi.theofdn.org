  "name": {
    "en": "Na bhanga re subhangi",
    "or": "ନ ଭାଙ୍ଗ ରେ ଶୁଭାଙ୍ଗୀ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ña Patala",
      "or": "ଞ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-bhanga-re-subhangi-kabisurjya-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ ଭାଙ୍ଗ ରେ ଶୁଭାଙ୍ଗୀ ଭାରତୀ ହୁଅ ସାହା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୋହିଲେ ତୁ ପରିତ୍ରାଣ ନିର୍ଦ୍ଦୟ ନତନୁ ବାଣ",
          "ନିଃଶେଷ କଲାଟି ଦେହ ଲାହା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୀପକୁଞ୍ଜ ଉପକଣ୍ଠେ ନ୍ୟସ୍ତ କରାଅ ମୋ କଣ୍ଠେ",
          "ନାଗରୀନ୍ଦ୍ର ନିରୁପମ ବାହା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନେତ୍ରାନ୍ତ ବିଳାସ ତାର ନିଦାନ ଏ ଅବସ୍ଥାର",
          "ନିରେଖି ଉଚ୍ଚାରୁ ଥରେ ଆହା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନିଶ୍ଚୟ ଏ ଘେନ ଚିତ୍ତେ ନ ଜୀଇବି କଦାଚିତେ",
          "ନ ବତାଇଲେ ତୁ ସୁଖ ରାହା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନାଥ ଅଷ୍ଟଦୁର୍ଗର ଯେ ନିତି ସେ ମୋ ପାଦେ ଭଜେ",
          "ନିନ୍ଦିବଟି ନ କଲେ ତୁ ତାହା"
        ]
      }
    ]
  },
  "sources": [
