  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-jara-riti-janili-saranga-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ ଜାର ରୀତି ଜାଣିଲି ଏଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାର ସହିତ ରଜନୀଯାକ",
          "ଜାଗର କଲେ ହେ ରସିକ",
          "ତାର ତାର କରଜ ଗାର",
          "ହାର ହୋଇଛି ହୃଦୟ ଉପର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦନ୍ତ ଚିହ୍ନ ଅଧରେ ଦେଖି",
          "ଅନ୍ତରେ ମୁନେ ହୋଇଛି ଦୁଃଖୀ",
          "ଅନ୍ତର ନୋହିବାକୁ ଚଣ୍ଡୀକାନ୍ତ",
          "ପରର ଯନ୍ତର ଏ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାଥୋଜ ମୁଖୀ କିଶୋର କଥିତ",
          "ଏଥର ହେଲେ ହୁଅ ନିବର୍ତ୍ତ",
          "ହାତ ଧରି କହେ ରଘୁନାଥ",
          "କବି ଯାମିନୀନାଥ ଏତିକି"
        ]
      }
    ]
  },
