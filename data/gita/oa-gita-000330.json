{
  "id": "oa-gita-000330",
  "name": {
    "en": "Se syama nagarabara",
    "or": "ସେ ଶ୍ୟାମ ନାଗରବର"
  },
  "composer": "oa-person-000058",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-syama-nagarabara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ ଶ୍ୟାମ ନାଗରବର ପ୍ରୀତିରେ ମୁଁ ଗଲି ସଢ଼ି",
          "ଜାଣି ନଥିଲି ସଜନୀ ହେବି ବୋଲି ଏତେ ସରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୟାମ ପ୍ରୀତି ବଡ଼ ମନ୍ଦ ନିତି ପ୍ରତିଦ୍ୱନ୍ଦ କଲି",
          "ନନ୍ଦସୁତ ଛନ୍ଦରେ ମୁଁ ପଡ଼ିଗଲି ସହଚରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଶନ ବସନେ ମନ ପ୍ରସନ୍ନ ନୁହେଁ ମୋହରି",
          "ଝରୁଥାଇ ନିରନ୍ତର ନୟନ ଯୁଗଳୁଁ ବାରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଘରଦ୍ୱାର ବନ ବ୍ୟାଧବେଶେ ଦିଶେ ଶମ୍ବରାରି",
          "ଖଣ୍ଡ ଖଣ୍ଡ କରେ କାଣ୍ଡ ପିଣ୍ଡକୁ ମୋ ସହଚରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦିନୁ ଦିନ ହେଲି କ୍ଷୀଣ କି କଲି ମୁଁ ନ ବିଚାରି",
          "ବୋଲେ ରାମାନୁଜ ସିଂହ ପ୍ରୀତିକି ଦୂରୁ ଜୁହାରି"
        ]
      }
    ]
  },
