{
  "id": "oa-gita-000016",
  "name": {
    "en": "Manju madhu bhasile",
    "or": "ମଞ୍ଜୁ ମଧୁ ଭାଷିଲେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manju-madhu-bhasile/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଞ୍ଜୁ ମଧୁ ଭାଷିଲେ । ସରସ ରଦ ଚନ୍ଦ୍ରିକା ।",
          "ହରଇ ମମ ମନତିମିର ଯାମେ ।",
          "ଚନ୍ଦ୍ରବଦନା ଅଧର । ମଧୁର ମଧୁ ଧାର ଗୋ ।",
          "ନୟନ ତ ଚକୋର ସରି କାମେ ।",
          "ହେ ପ୍ରିୟେ । ଚାରୁଶୀଳେ ।",
          "ତେଜ ମନୁ ମାନିନୀ । ଗୁମାନେ ।",
          "କାମ ଖର ତାପ ସହି । ଦହଇ ମମ ମାନସେ ।",
          "ଦାନ କର ବଦନ ମଧୁ ପାନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାମଗର ଖଣ୍ଡନ । ଭାଲ ପଟ ମଣ୍ଡନ ।",
          "ଦେହି ପଦପଲ୍ଲବ ସୁହାସି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜଳଇ ବିକଳେ ଅତି । ମଦନ ଅନଳେ ସଖି ।",
          "ତ୍ରାଣ କର ତାପୁ ମଧୁ ଭାଷି"
        ]
      }
    ]
  },
  "sources": [
    {
