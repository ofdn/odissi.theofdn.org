    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁ ପାଇଁ ଏ ରୁଷା ରମଣୀ ବରପଟୀର ହାସିନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅକାରଣେ ତୋର ମୁଖାମ୍ବୁଜାତର",
          "ଅତୁଳ ସୁନ୍ଦର ଝଳି ହେଲା ଦୂର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବୀନ ନଳିନ ସମାନ ନୟନ",
          "ଯୁଗଳରୁ ବନ ବହେ ଅନୁକ୍ଷଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିକ୍ରମ ବିନୁତ ମଦନ ଶପଥ",
          "ନ କର ଗୁପତ କାରଣ କହ ତ"
        ]
      }
    ]
  },
