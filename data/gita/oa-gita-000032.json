{
  "id": "oa-gita-000032",
  "name": {
    "en": "Sadha siddha suddha swara",
    "or": "ସାଧ ସିଦ୍ଧ ଶୁଦ୍ଧ ସ୍ୱର"
  },
  "composer": "oa-person-000021",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000010"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sadha-siddha-suddha-swara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଧ ସିଦ୍ଧ ଶୁଦ୍ଧ ସ୍ୱର",
          "ଷଡ଼ଜ ଋଷଭ ଗାନ୍ଧାର",
          "ମଧ୍ୟମ ପଞ୍ଚମ ଧୈବତ",
          "ନିଷାଦ ସରବସ୍ୱର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଔଡ଼ବ ଷାଡ଼ବ ପୂର୍ଣ୍ଣ",
          "ରାଗ ଜାତ ସୁକାଗଣ",
          "ତାନ ମାନ ନ୍ୟାସ ବର୍ଣ୍ଣ",
          "ଶୁଦ୍ଧ ଛାୟାଲଗ ଗାନ । ଅନ୍ତରା ।"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଇବାଡ଼ ତିରିଭଙ୍ଗ",
          "ପ୍ରବନ୍ଧ ସରବ ଅଙ୍ଗ",
          "ତାନ ଲୟ ରସ ରାଗ",
          "ଗୁଣିଜନ ଯୋଗାଯୋଗ । ସଞ୍ଚାରୀ ।"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚିତ୍ରକଳା ଚିତ୍ରପଦା",
          "ପାଞ୍ଚାଳୀ ଧୂରୁବପଦା",
          "କ୍ଷୁଦ୍ରଗୀତ ସୁମମତ",
          "ଶ୍ୟାମ ଧୀର ବଦେ ସଦା । ଆଭୋଗ ।"
        ]
      }
    ]
  },
  "sources": [
    {
