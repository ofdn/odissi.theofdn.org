{
  "id": "oa-gita-000754",
  "name": {
    "en": "Jibana pradipa hela",
    "or": "ଜୀବନ ପ୍ରଦୀପ ହେଲା"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000169"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jibana-pradipa-hela-karunasri-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୀବନ ପ୍ରଦୀପ ହେଲା ଦପଦପ",
          "ପ୍ରବେଶ ହୋଇଲା ଶେଷ ଯାମ",
          "ଶ୍ରୀ ବଂଶୀବଦନ ଶ୍ରୀ ମଧୁସୂଦନ",
          "ରଟ ରେ ରସନା ନୋହି ଭ୍ରମ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବୋଲ ବୋଲ କୃଷ୍ଣ କେଶବ ମୁରାରି",
          "ହୃଷୀକେଶ ଦୀନବନ୍ଧୁ ଦଇତାରି",
          "ନୃସିଂହ ବାମନ ଶଙ୍ଖଚକ୍ରଧାରୀ",
          "ବଳିଧ୍ୱଂସୀ ରାମ ଘନଶ୍ୟାମ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବୋଲ ବାରମ୍ବାର ମାଧବ ମୁକୁନ୍ଦ",
          "କେଶବ ଅଚ୍ୟୁତ ଶ୍ରୀ ସଚ୍ଚିଦାନନ୍ଦ",
          "ଶ୍ରୀ ଗୋପୀଜନବଲ୍ଲଭ ଆଦିକନ୍ଦ",
          "ବୈକୁଣ୍ଠ ଶ୍ରୀପତି ଅଭିରାମ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିତ୍ୟ ନିରଞ୍ଜନ ସତ୍ୟ ସନାତନ",
          "ଗୋବର୍ଦ୍ଧନ ଧାରୀ ଶ୍ରୀ ନନ୍ଦନନ୍ଦନ",
          "କାଳୀୟ ଗଞ୍ଜନ ଯାମଳା ଭଞ୍ଜନ",
          "ବୃନ୍ଦାବନଚନ୍ଦ୍ର କୋଟିକାମ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରସରାଜ ରସମୟ ରସିକେନ୍ଦ୍ର",
          "ଗୋକୁଳକୁଳ କୁମୁଦ ପୂର୍ଣ୍ଣଚନ୍ଦ୍ର",
          "ଦ୍ୱିଜ ଗୌର ମତି ପ୍ରମତ୍ତ ମିଳିନ୍ଦ",
          "ଯୁଗ୍ମ ପଦେ ପୂର୍ଣ୍ଣ କରୁ କାମ"
        ]
      }
    ]
  },
