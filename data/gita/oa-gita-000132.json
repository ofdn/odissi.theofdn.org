{
  "id": "oa-gita-000132",
  "name": {
    "en": "Ki na kare prema riti",
    "or": "କି ନ କରେ ପ୍ରେମରୀତି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000062"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-na-kare-prema-riti/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ନ କରେ ପ୍ରେମରୀତିରେ ସଜନୀ",
          "ସେ ଶ୍ୟାମ ଅନୁସରଣେ ସଖୀ ମୋର",
          "ହେଉଛି ଯେତେ ଅନୀତିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିରୀଷ କୁସୁମ ତାଡ଼ନରେ ସହୀ",
          "-ମେଳେ ଯେ ମୋହକୁ ଯାଇ",
          "ସେ କରକାମିଶା ପ୍ରଖର ବରଷା",
          "ସହି ତ୍ୱରା ତ୍ୱରା ଯାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଉଠେ ଯେ ସଜନୀ କରେ କର ଦେଇ",
          "ଦେହଳୀ ଲଙ୍ଘିବା ପାଇଁ",
          "ସେ କଣ୍ଟା ଅବାଟ ନିଗଡ଼ ନିପଟ",
          "ନ ମାନି ସଙ୍କେତେ ଯାଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦିବସେ ଯେ ଡରେ ସହଚରୀ ମେଳେ",
          "ତମଧାମେ ନ ପଶଇ",
          "ସେ ବିଜୁଳୀ ଦେଖା ହୋଇଣ ଅଶାଖା",
          "ନିତି ବୃନ୍ଦାବନେ ଧାଇଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭିତ୍ତିରେ ଚିତ୍ରରେ ଲେଖା ଉରଗରେ",
          "ଭୟେ ଯେ ନ ଦିଏ ପାଣି",
          "ସେ ଶାଢ଼ୀ ଶେଷରେ ତନୁ ଛପାଉଛି",
          "ଫଣିମଣି ତେଜ ଜାଣି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କବିରବି ବୋଲେ ସେ ମୋହନ ଛବି",
          "ଯେ ଦେଖେ ନୟନ ଭୁଲେ",
          "କହିଲେ କି ବାଳୀ ମାନିବ ଏ କଥା",
          "ବୃଥା ହେବ କଥା ତୁଲେ"
        ]
      }
    ]
  },
  "sources": [
    {
