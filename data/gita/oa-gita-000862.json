{
  "id": "oa-gita-000862",
  "name": {
    "en": "Dekha hemanta samaya",
    "or": "ଦେଖ ହେମନ୍ତ ସମୟ"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-hemanta-samaya-punnaga-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖ ହେମନ୍ତ ସମୟ",
          "ଆଖଣ୍ଡଳ ଚାପଶୂନ୍ୟ ଶୂନ୍ୟ ହିମମୟ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସର ସ୍ୱଚ୍ଛ ଜଳେ ହଂସକୁଳ ସୁଶୋଭିତ",
          "ପୁରବ୍ରଜ ଅବିରତେ ହସନ୍ତୀ ସଂଯୁତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନର ଚିତ୍ତ ଗୁରୁପଟ ଧାରଣେ ଆସକ୍ତ",
          "କର ଦେଇ କୃଷକାଳି ଋଣରୁ ବିମୁକ୍ତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅରବିନ୍ଦମିତ୍ର କରେ ମାନସ ସରାଗ",
          "ସରସିଜାତ ଶାକ୍ରବ କରେ ସେ ବିରାଗ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୀର ଶ୍ରୀ ବିକ୍ରମଦେବ ବର୍ମାର ମାନସ",
          "ନିରନ୍ତର ଶ୍ରୀ କେଶବ ଧ୍ୟାନେ ଲଭେ ତୋଷ"
        ]
      }
    ]
  },
  "sources": [
