{
  "id": "oa-gita-000464",
  "name": {
    "en": "Akhya lila lakhya kalu",
    "or": "ଅକ୍ଷ ଲୀଳା ଲକ୍ଷ୍ୟ କଲୁ ଯା ମୋହନ ରାଜରେ"
  },
  "composer": "oa-person-000050",
  "mula_raga": [
    "oa-raga-000105"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/akhya-lila-lakhya-kalu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅକ୍ଷ ଲୀଳା ଲକ୍ଷ୍ୟ କଲୁ ଯା ମୋହନ ରାଜ ରେ",
          "ଅର୍ଯ୍ୟମା ରାଜଦୁଲ୍ଲଣୀ କି ଯୋଗରେ ଆଜ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅପୂର୍ବ କୀର୍ତ୍ତି କେତନ ଉଡ଼ିବଟି ଜୀବଧନ",
          "ଅବଶ୍ୟ ତୋ ନାମରେ ଏ ଅଖିଳ ବ୍ରଜରାଜ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅତନୁ ଅମଳେ ବାଇଆଣୀ ହୋଇଯିବୁ ରାଈ",
          "ଅଡ଼ିବ ବିରହ ବ୍ୟାଧି ସଢ଼ିଯିବୁ ଲାଜରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଳି ନୀଳ କୁନ୍ତଳାଟି ଅଲ୍ୟଳୀ ପ୍ରବାଳ ଓଷ୍ଠୀ",
          "ଅକଥନ ରଟିବେ ତ ଆଭିରୀ ସମାଜରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅକଳଙ୍କ ଚନ୍ଦ୍ରବଂଶେ ଅଠା ଲାଗିବ ବିଶେଷେ",
          "ଅଡ଼ୁଆରେ ପଡ଼ିଗଲୁ (ଭଲା) ନ ରଖି ନିହାଜରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଅଶ୍ରୁଧାର କର ପଛେ ପୋଛିବୁ ଜାଣିଲି ସ୍ୱଚ୍ଛେ",
          "ଅସମ୍ଭାଳ ହେଲୁ ଦୀନକୃଷ୍ଣ କରି ତ୍ୟାଜ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
