{
  "id": "oa-gita-000596",
  "name": {
    "en": "Taku chahan na lo mita kahuchhi sata",
    "or": "ତାକୁ ଚାହାଁନା ଲୋ ମିତ କହୁଛି ସତ"
  },
  "composer": "oa-person-000077",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/taku-chahan-na-lo-mita-kahuchhi-sata/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତାକୁ ଚାହାଁନା ଲୋ ମିତ କହୁଛି ସତ",
          "ଘରବୁଡ଼ା କୁଳଛଡ଼ା ତା ପାଶେ ଯାଆନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳାବନ୍ତ ଲୋକ ଯେହି",
          "ଦୂରନ୍ତ ଅଟଇ ସେହି",
          "ନାହିଁ ତାହାଠାରେ ପରାପର ବିବେଚନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆମ୍ଭ ବସନ ଚୋରାଇ",
          "ମାଗିଲେ ସେ ନ ଦିଅଇ",
          "ଯେତେ ସ୍ନେହ କଲେ ତାର ପାଶକୁ ଯାଆ ନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଣି ସ୍ନେହେ ଧରି କୋଳେ",
          "ଜାଣିଛୁ ତା ବାଳ କାଳେ",
          "କ୍ଷୀରପାନ ଦେଲା ବେଳେ ମାରିଛି ପୂତନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମାନ ସଜନୀ ମୋ ଗିର",
          "ଅଟଇ ସେ ଦଗାଦାର",
          "ଉଡ଼ୁଛି ଅକୀର୍ତ୍ତି କେତେ ଗୋପପୁରେ ତା ନାଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାଜଇନ୍ଦ୍ର ଦେବ କହି",
          "ଶୁଣି ତା ପରାଣ ସହି",
          "ବୋଲେ ସେ ମୋହର ସବୁ ତା ମୋତେ କହନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/taku-chahan-na-lo-mita-kahuchhi-sata/"
    }
  ],
