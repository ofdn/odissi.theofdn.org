    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗଲି ସରି ରେ ମଲ୍ଲୀବରନା",
          "ପାରି କର ପରିଚାର ଜନେ ଯତିମୋହନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାର ପଞ୍ଚଶର ଧାର ସାରିଲା ଅତନୁ ସାର",
          "ଘୋର ତାପ ମଦନର ଜାଳିଲା ମରମ ସିନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୋ ବିନା ପ୍ରତିକାର ଆନ କେ ନାହିଁ ମୋର",
          "ରଖ ଜୀବନ ଧନ ଚନ୍ଦ୍ରବଦନା"
        ]
      }
    ]
  },
