  "id": "oa-gita-000453",
  "name": {
    "en": "Jhagadi matra hela he syama",
    "or": "ଝଗଡ଼ି ମାତ୍ର ହେଲ ହେ ଶ୍ୟାମ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000126"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Jha Patala",
      "or": "ଝ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jhagadi-matra-hela-he-syama-jha-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଝଗଡ଼ି ମାତ୍ର ହେଲ ହେ ଶ୍ୟାମ",
          "ଝିମୁଟ ହେବାକୁ ସହସ୍ର ଯାମ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଝାଉଁଳିବା ନବ ତମାଳ ରମା",
          "ଝିଙ୍କି ଆଣି ଅଙ୍ଗେ କଲଣି ଜମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଝଡ଼ିବ ବଳ କୋମଳ ଛାତିରୁ",
          "ଝଷଧ୍ୱଜ ପୀଡ଼ା ଝାଞ୍ଜି ତାତିରୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଝୁମି ଝୁମି ଲୁଠି ପୃଷ୍ଠେ ରସାର",
          "ଝୁରିବାର ଏକା ହୋଇବ ସାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଝଳି ପାଞ୍ଚାଳୀ ଝଟକେ ନାହିଁ କି",
          "ଝୋଲା ମାଇଲା ତୁମ୍ଭଙ୍କୁ କାହିଁକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଝଲକି ଗଲ କୃଷ୍ଣ ଅକାରଣେ",
          "ଝାଡ଼ଖଣ୍ଡ ରସା ବାଦସା ଭଣେ"
        ]
      }
    ]
  },
  "sources": [
