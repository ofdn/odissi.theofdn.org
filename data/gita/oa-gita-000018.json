  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gagane-ghana-ghoti/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗଗନେ ଘନ ଘୋଟି ଆସିଲାରେ",
          "ସଖୀ । ରସି ବିଜୁ ବିଳସିଲା ।",
          "ପ୍ରଫୁଲ୍ଲ ମାଳତୀ ବନେ ଫୁଟି ହସିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେକୀ କାନନରେ ରଟିଲା",
          "ବିରହିଣୀ ମନୁ ଟାଣ ମାନ ତୁଟିଲା",
          "ଗରଜି ଘୋର ଦମ୍ଭୋଳି ଫିଟିଲା",
          "ଧଇର୍ଯ୍ୟଲତା ମନୁ ଖସିଲାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭେକ ପ୍ରବଳ ଘୋଷିଲା",
          "ଜୀବର ଜୀବନ ବିନେ ଜୀବ ଲସିଲା",
          "ଆସି ସତେ କି ପ୍ରମାଦ ଘୋଟିଲା",
          "କବିଶଶୀ ଖେଦେ ଭାଷିଲାରେ"
        ]
      }
    ]
  },
  "sources": [
