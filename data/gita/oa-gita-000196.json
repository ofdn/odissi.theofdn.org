{
  "id": "oa-gita-000196",
  "name": {
    "en": "Aha mo labanya nidhi re",
    "or": "ଆହା ମୋ ଲାବଣ୍ୟନିଧି ରେ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-mo-labanya-nidhi-re-kalyana-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା ମୋ ଲାବଣ୍ୟନିଧି ରେ",
          "ହରାଇ ବସିଲି ବୁଦ୍ଧି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିବ ସେବି ଅନୁବ୍ରତେ ପାଇଥିଲି ଧନ ତୋତେ",
          "ଏବେ କେମନ୍ତେ ମୂର୍ଚ୍ଛିବି ତୋତେ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେ ଦିଗେ ଚାହିଁଲେ ଧନ ଦିଶେ ତୋ ଚନ୍ଦ୍ରବଦନ",
          "ଏବେ କେମନ୍ତେ ବଞ୍ଚିବି ଦିନ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଖୀ ମୁଁ ଧରୁଛି କର ଏଥକୁ ଉପାୟ କର",
          "ଏବେ ତୋ ଚିନ୍ତା ମୋ ହୃଦେ ଗାର ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚିନ୍ତାମଣି ବାଣୀ ଶୁଣି ହରଷ ରମଣୀମଣି",
          "ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ ଭଣି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
