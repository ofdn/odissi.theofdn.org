{
  "id": "oa-gita-000968",
  "name": {
    "en": "Madhu kala hoila sajani",
    "or": "ମଧୁ କାଳ ହୋଇଲା ସଜନୀ"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000041"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madhu-kala-hoila-sajani-lalita/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଧୁ କାଳ ହୋଇଲା ସଜନୀ",
          "ଦିଶେ ସୁନ୍ଦର ଦିବା ରଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଋତୁପତି ରସ ଘେନି କଲେଣି ବିଜେ",
          "ସକଳ ପ୍ରାଣୀଙ୍କ ଚିତ୍ତେ ସୁଖ ଉପୁଜେ",
          "ସରୋବରେ ଶୋଭିତ ନଳିନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବକୁଳ ଚମ୍ପା ଅଶୋକ ନିଆଳୀ",
          "ଫୁଟି ଶୋଭା ପାଉଛନ୍ତି ଭଳିକି ଭଳି",
          "କାହିଁ ରହିଲେ ମୋ ବେଣୁପାଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆନନ୍ଦେ ଭ୍ରମେ ଭ୍ରମର କୁସୁମ ବନେ",
          "ମକରନ୍ଦ ପାନ କରେ ସରାଗ ମନେ",
          "କରି ନିଜେ ପ୍ରଫୁଲ୍ଲେ ଦଇନୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷନ୍ତି ରାଧିକା ଦୂତୀ ଯାଅ ବହନ",
          "ଆଣି ଭେଟାଅ ମୋହରେ ମୋ ପ୍ରାଣଧନ",
          "ଦୂତୀ ଚଳେ ଆଣି ବେଣୁପାଣି"
        ]
      }
    ]
  },
