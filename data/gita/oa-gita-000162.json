{
  "id": "oa-gita-000162",
  "name": {
    "en": "Mu harili heu etiki go",
    "or": "ମୁଁ ହାରିଲି ହେଉ ଏତିକି ଗୋ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mu-harili-heu-etiki-go-mun-harili/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୁଁ ହାରିଲି ହେଉ ଏତିକି ଗୋ",
          "ଜୁହାରିଲି ଶ୍ୟାମ ପ୍ରୀତିକି ଗୋ",
          "ଗୁହାରି କରିବି କାହା ଆଗେ କେତେ",
          "ଲୁହାରେ ବନାଇଁ ଛାତିକି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେହକୁ ସମରପି ପ୍ରାଣ ତୁଲେ",
          "ସ୍ନେହକୁ ସମ୍ପାଦିବା ସିନା ଭଲେ",
          "ଏ ହଟହଟାରେ କେ ମରିବ କରି",
          "ସଙ୍ଖାଳି ବିଶ୍ୱାସଘାତୀକି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିୟମ କରି ନ ପାଳଇ ଯାହା",
          "କି ଅମଳଖିଆ କରଇ ତାହା",
          "ଦିଅ ମୋତେ ଗାଳି ପଛେ ମୁଁ ନ ପାରେ",
          "ପରୁଷ ପୁରୁଷ ଜାତିକି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦୁଆଗଲା ଶାଳୀବନେ କି ରଙ୍ଗ",
          "ସୁଆଗ ନ ଥିବା ଜନେ କି ସଙ୍ଗ",
          "ମୁଁ ଆଗ ବିବେକ ହୁଡ଼ି ହୃଦୟକୁ",
          "ସମର୍ପିଲି କାମକାତିକି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହଟିଲା ରାଧାର ଏ କଞ୍ଜନେତ୍ର",
          "ଘଟିଲା ମୋ କର୍ମ୍ମେ ଏ ଦଶା ମାତ୍ର",
          "ଜଟିଳା ଜାଣିଲେ ସଂସାରୁ ସରିବି",
          "ପାଇ ଘୋର ଅପଖ୍ୟାତିକି ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶତ ପଦରେ ପଦେ ନାହିଁ ସତ",
          "ସତ ପରି ହୋଇବାରୁ ପ୍ରତୀତ",
          "ଅତପଃଶୀଳା ମୁଁ ଅନୁଭବ କଲି",
          "ଏ ତପତି ଉତପତ୍ତିକି ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶିଖଣ୍ଡଚୂଳିଆର ଗୁଣ ତୁଲେ",
          "ଏ ଖଣ୍ଡ ଅଛି ବୋଲି ଜାଣିଥିଲେ",
          "ଅଖଣ୍ଡ ବିଶ୍ୱାସ କରନ୍ତି କି ଭଲେ",
          "ଜଗଦ୍ଦେବ ଏ ଭାରତୀକି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
