{
  "id": "oa-gita-000704",
  "name": {
    "en": "Anarata sarasa mana mo dhana",
    "or": "ଅନାରତ ସରସମନା ମୋ ଧନ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/anarata-sarasa-mana-mo-dhana-todi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନାରତ ସରସମନା ମୋ ଧନ କିସ",
          "ମନାସି ପରିଜନେ ରୁଷିଲା ରେ",
          "ନିଶାରମଣଜୟ ବିଶାରଦ ବଦନ",
          "ନବାରୁଣ ସଦୃଶ ଦିଶିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବଳାହକ ଗରବଦଳା କୁନ୍ତଳେ ନବ",
          "କଳାପ ସୁମୁଖୀ ନ ଖୋଷିଲା ରେ",
          "ଢଳାଗୁଣ ମୋହନ ଚଳାଚଳ ନୟନ",
          "ଦଳାନ୍ତରୁଚି ବଳି ଖସିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘୋଷଯାକ ଭିତରେ ମୋ ସଙ୍ଗମ ଇତରେ",
          "ଅଛି କି ନାହିଁ ତ ନ କଷିଲା ରେ",
          "ଦୋଷ ବିନା ଏପରି ରୋଷ କଲେ କି ପରି",
          "-ଜନ ବଞ୍ଚିବ କହ ସୁଶୀଳା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯେଉଁଦିନୁ ମୋତେ ସେ କଉତୁକିନୀ ରସେ",
          "ନେତ୍ରାନ୍ତ ବରଛିରେ ଭୁଷିଲା ରେ",
          "ପଉରୁଷ ମୋହର ନଉକରୀ ତାହାର",
          "ଚରଣ ମାଜିବାର ସୁଶିଳାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦିବା ସମୟେ ଦିନେ ବିବାସ କଲି ମନେ",
          "କିବା ସତତ ତା ହିଁ ଘୋଷିଲା ରେ",
          "କାହିଁକିଟି ଧରଣୀ ଚାହିଁ କିଶୋରୀମଣି",
          "ଗୁମାନକୁ ମାନସେ ପୋଷିଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ବସୁଦୁର୍ଗେଶ ଅହେତୁକ ତା ରୋଷ",
          "ଶହେ ଗୁଣରେ ସମୁଲ୍ଲାସିଲା ରେ",
          "ପ୍ରାଣ ନେବାକୁ ମୋର ବାଣ ମୀନରଥର",
          "ଶାଣରେ ନିରନ୍ତର କଷିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
