{
  "id": "oa-gita-000410",
  "name": {
    "en": "Dekha sahi rahi go",
    "or": "ଦେଖ ସହି ରହି ଗୋ ଶ୍ରୀ କୃଷ୍ଣଟି ଏହି"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000090"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-sahi-rahi-go-ramakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖ ସହି ରହି ଗୋ ଶ୍ରୀ କୃଷ୍ଣଟି ଏହି",
          "କୁଞ୍ଜେ କୁଞ୍ଜେ ଝୁଲୁଛନ୍ତି ରହି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏହି ପରା ନନ୍ଦସୁତ ଜନମର କାଳେ",
          "ପୂତନା ପରାଣ ଛନ୍ତି ନେଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶିରରେ ମୟୂର ଚୂଳ ଦିଶେ ଶୋଭାବନ",
          "ନାସାରେ ମୁକୁତା ଲୁଳେ ରହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଷଣ୍ଢା ଅଘା ବକା ତୃଣା ଶକଟାକୁ ନାଶି",
          "କାଳୀକି କାଳିନ୍ଦୀ ଜଳେ ଦଳି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭଣେ ଭାଗୀରଥୀ ସୁତ ରାମକୃଷ୍ଣ ଧ୍ୟାୟି",
          "ଏହି ପରା ବଳରାମ ଭାଇ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-sahi-rahi-go-ramakrusna/"
    }
  ],
