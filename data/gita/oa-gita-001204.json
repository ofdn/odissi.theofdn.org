{
  "id": "oa-gita-001204",
  "name": {
    "en": "Nirasa ritiki chhada go janani",
    "or": "ନିରାଶ ରୀତିକି ଛାଡ଼ ଗୋ ଜନନୀ"
  },
  "composer": "oa-person-000148",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nirasa-ritiki-chhada-go-janani-brajanatha-badajena/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନିରାଶ ରୀତିକି ଛାଡ଼ ଗୋ ଜନନୀ",
          "ନୀଳାଦ୍ରି କ୍ଷେତ୍ର ବଦନୀ ମୋହ ଘେନି",
          "ନିନ୍ଦା ପାଇବୁଟି ବଡ଼ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପକାଇ ଦେଲେ ମୁଁ ପେଲି ପଶୁଥିବି",
          "ଧରି ଚରଣ ପାହୁଡ଼",
          "ନାହିଁ ମୋର ଗତି ତ୍ରାହି ଭଗବତୀ",
          "ତୁହି ଏଥର ନ ହୁଡ଼ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଖୋଜି ଖୋଜି କେତେ ଦେଖିଲି ଜଗତେ",
          "ଦୟାକୁ ତୋତେ ମୁଁ ବଡ଼",
          "ନ ରଖିବୁ ଯେବେ ଅରକ୍ଷିତ ତେବେ",
          "ଭାସିଲା ଏ କଥା ଦୃଢ଼ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସିଂହଦୁଆର ଏ ପାଖେ ପକାଇବୁ",
          "କରିଣ କାଙ୍ଗାଳ ଧେଡ଼ି",
          "ତୋ ଭାବେ ମଜ୍ଜନ ହେବ କି ଜୀବନ",
          "ଅନ୍ନ ବିନା ଦିଶୁ ବାଡ଼ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସେଠାରେ ପଡ଼ିବା ଯାଏ ଚଳୁଥାଉ",
          "ପଛେ ଭାଜିଯାଉ ଗୋଡ଼",
          "କବଳେ କବଳେ କଇବଲ୍ୟ ଦେବୁ",
          "କଟୀକି ଛିଡ଼ା କାପଡ଼ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆନ ମନ ନ କରିଣ ତୋ ଧିଆନ",
          "ଭାବେ ହୋଇଯିବ ଜଡ଼",
          "ବ୍ରଜନାଥ ବୋଲେ ପତିତପାବନୀ",
          "ନାମର ଏ କୃପା ବଡ଼ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
