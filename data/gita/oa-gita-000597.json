{
  "id": "oa-gita-000597",
  "name": {
    "en": "Ki nirmala sarada kumuda",
    "or": "କି ନିର୍ମଳ ଶରଦ କୁମୁଦ"
  },
  "composer": "oa-person-000096",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-nirmala-sarada-kumuda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ନିର୍ମଳ ଶରଦ କୁମୁଦବନ୍ଧୁ",
          "ଅନା ଟେକି ବଦନ ଇନ୍ଦୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିଗ ରସିକିନୀ କି ଅଛି ଘେନି",
          "ଭାଲପଟେ ଚନ୍ଦନ ବିନ୍ଦୁ ।",
          "(ପଡ଼ି)",
          "ବ୍ୟୋମ ଶୟନରେ ହଂସ ହଂସୁଲି",
          "ତୁଳିରେ ସିଞ୍ଚିଛି ତାରକା ମଲ୍ଲୀ",
          "ପତ୍ନୀଶର୍ବରୀ ସଙ୍ଗେ ବିଳସତି",
          "ବିବିଧ କଉତୁକ କେଳି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ କହୁଁ ବାଣୀ ମନେ କି ଆଣି",
          "କାହୁଁ ଶିଖିଅଛୁ ଏ ଠାଣି ।",
          "(ପଡ଼ି)",
          "ସୁର ସରଣୀରେ ସରସ ସଂପ୍ରତି",
          "ହଂସ ରଞ୍ଜ କି ଭବନେ ବିଳସତି",
          "ହଂସ କୁଳ ଅବତଂସ କୀରତି",
          "ଥରେ ନ କଲୁ ତହୁଁ ପ୍ରତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସ୍ମର ନୃପତି ଟେକାଇଛି ଛତି",
          "ମାରେ ବିରହୀ ଅରିତତି ।",
          "(ପଡ଼ି)",
          "ମାନ ନିଶ୍ଚୟେ ମଉନ ବାରଣ",
          "କରିବ କୁମ୍ଭ ନିଶ୍ଚେଁ ବିଦାରଣ",
          "ଗର୍ବ ମୋତିକି କରିବ ଚର୍ବଣ",
          "ନ ଭାବ ନରସିଂହ ଜାଣ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶୁଣି ସୁଶୀଳା ମନ୍ଦେ ହସିଲା",
          "ଶ୍ରୀ କୃଷ୍ଣଙ୍କୁ ଚାହିଁ ଭାଷିଲା ।",
          "(ପଡ଼ି)",
          "କୋଟି କମନୀୟ କାମ ମାଦକ",
          "କୋଟି ଚନ୍ଦ୍ର ଆହ୍ଲାଦ ତାରକ",
          "କୃଷ୍ଣ ବିନୁ ମମ ଚିତ୍ତ ତୋଷକ",
          "ଭାଷଇ ଗୁଣୀରତ୍ନ ଗୀତ",
          "(ସ୍ୱର)",
          "ମା ମା ପା ପା ମା ଗା ରେ ସା",
          "ରେ ମା ରେ ମା ମା ପା ପା…",
          "(ବିରୁଦ)",
          "ଭବଜିତ ସୁରଗୁରୁ",
          "ବନ୍ଦିତ ଚରଣମ୍…",
          "(ପାଟ)",
          "ଝେଁକିଟ ଧିନାକିଟ…"
        ]
      }
    ]
  },
  "sources": [
    {
