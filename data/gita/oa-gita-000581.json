  "id": "oa-gita-000581",
  "name": {
    "en": "Sindhuradhipa bira taba",
    "or": "ସିନ୍ଧୁରାଧିପ ବୀର ତବ"
  },
  "composer": "oa-person-000114",
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sindhuradhipa-bira-taba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସିନ୍ଧୁରାଧିପ ବୀର ତବ ରିପୁନାଗରୀନୟନାମ୍ବୁନିବହୈ",
          "-ର୍ମୃଣ୍ମୟଂ ମହିମଣ୍ଡଳଂ ମୃଦୁ କିମିତି ନୈବ ବିଲୀୟତେ ।",
          "ଜ୍ଞାତମତ୍ର ମହୀଶ ସନ୍ତତମମ୍ବୁ ଶୁଷ୍ୟତି ତେଜସା ତବ",
          "ତି ଆ ଇ ଅଇ ଅଇ ଅଇଇ ଅଇ ଅଇ",
          "ତିଅଇ ଅଇ ଅଇ ଇଅ ଇଅ ଇଅ ଇଅ",
          "ଇ ଆ ଆ ଆ ଆ ଆ ଆ ଆ ଆ ଆ ଆ ଆ",
          "ତପନଶତସମରୋଚିଷା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚିତ୍ରମେମନ୍ନ ଖଳୁ ନିରୁପମନିଖିଳବିକ୍ରମଶାଳିନି ତ୍ୱୟି",
          "ତି ଆ ଇ ଅଇ ଅଇ ଅଇ ଅଈ ଅଈ ଈୟ ଇ ଅଈ",
          "କୃଷ୍ଣଦାସ କବିନା ଭଣିତମିତି ରେ ।"
        ]
      }
    ]
  },
  "sources": [
