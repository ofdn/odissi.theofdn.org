  "name": {
    "en": "Bhala se mana mohana",
    "or": "ଭଲା ସେ ମନମୋହନ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000029"
  ],
  "mula_tala": [
