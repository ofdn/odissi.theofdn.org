    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-se-mana-mohana-sokabaradi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଲା ସେ ମନମୋହନ",
          "ପୀରତିରେ ରସିଲୁ ଗୋ",
          "ଜାଣି ଶୁଣି ଯାହା ରାଧେ",
          "ଅପବାଦେ ଭାସିଲୁ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ଶ୍ୟାମ ପ୍ରେମ ଗଞ୍ଜାଇ",
          "ମାଦକେ ହେଲୁ ରଞ୍ଜାଇ",
          "କହୁଥିଲି ସମଝଇ",
          "ତା ମନେ ନ କଷିଲୁ ଗୋ",
          "(ପଡ଼ି)",
          "ବାମନୟନା ମୋ ମନା",
          "ନ ଘେନିଲୁ ରେ ସୁମନା",
          "କାମ ଅସିଧାରକୁ ଯା",
          "ହେମ ଅଙ୍ଗରେ ଘଷିଲୁ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
