{
  "id": "oa-gita-000424",
  "name": {
    "en": "Syama lagi e jibana jiba go",
    "or": "ଶ୍ୟାମ ଲାଗି ଏ ଜୀବନ ଯିବ ଗୋ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000119"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-lagi-e-jibana-jiba-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ଲାଗି ଏ ଜୀବନ ଯିବ ଗୋ",
          "ଏତିକି ତାହାଙ୍କୁ ଜଣାଇଦେବ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତାଙ୍କୁ କରି ଗଳାହାର କୁଳରୁ ହେଲି ବାହାର",
          "ଜାଣିନଥିଲି ତା କୂଟ ଭାବ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସେ ନଟନାଗର ବର କରିଦେଲେ ମନୁ ପର",
          "ମଦନ ଦେଉଛି ପରାଭବ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଖୀ ସେ ମୁରଲୀଧାରୀ କରିବେ ବୋଲି ଏପରି",
          "କାହା ମନେ ଥିଲେ ଭାବ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବି ବେଣୁଧର ଭଣି କେ ଆନ କରିବ ପୁଣି",
          "କପାଳରେ ଯାହା ଲେଖା ଥିବ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
