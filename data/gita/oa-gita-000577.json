    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "(ଅକ୍ଷମୟୀ ଚଉପଦୀ)"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅନା ମୋତେ ଥରେ",
          "ଆଶ ନ ନାଶରେ",
          "ଇଷିତେ ଭାଷି",
          "ଈନ୍ଦ୍ରଭୂତିକି ଦିଅ ବାରେ",
          "ଉରୁଶୋଭୀ ମୁଁ ତୋ କିଣା",
          "ଊଣା ନ କର କରୁଣା",
          "ଋକ୍ଷପତି ମୁଖୀ",
          "ୠଷନା ମୋ ଅଙ୍କେ ବସ",
          "ୡ ମଧ୍ୟମା ଠିକ",
          "ଲୁଆଁନା ଶ୍ରୀମୁଖ",
          "ଏ ତୋତେ ଅବଧି ଘନ",
          "ଐରାବତ ଗମନାରେ",
          "ଓଜ ଭାଙ୍ଗେ ମାର ଜୂର",
          "ଔଷଧ ବାଳା କେବଳ ।"
        ]
      }
    ]
  },
