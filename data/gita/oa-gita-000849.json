{
  "id": "oa-gita-000849",
  "name": {
    "en": "Dhanya sehi bara tanu",
    "or": "ଧନ୍ୟ ସେହି ବରତନୁ"
  },
  "composer": "oa-person-000126",
  "mula_raga": [
    "oa-raga-000179"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhanya-sehi-bara-tanu-kousika-mardaraja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧନ୍ୟ ସେହି ବରତନୁ ମୋହନା",
          "ତାର ରୂପ ଲାଗି ଆର୍ତ୍ତ ନୟନ ମୋହର ନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୟାମ ବନ୍ଧୁ ନା ତାର ବଦନ ନିନ୍ଦଇ",
          "ପୂର୍ଣ୍ଣ ଇନ୍ଦୁ ନା",
          "ଚାରୁ କପୋଳରେ ମଳୟଜ ବିନ୍ଦୁ ନା",
          "ଚାରୁ ଚାହାଣୀରେ ନାଶେ କୁଳବଧୁ ନା",
          "ରୂପ ଲାବଣ୍ୟ ତରଙ୍ଗ ରସସିନ୍ଧୁ ନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଟିଳ କୁନ୍ତଳ ଶିରେ ଶିଖୀଦଳ ଗୋ",
          "ବେଢ଼ି ନବ ବକୁଳର ମାଳ ଗୋ",
          "ନାସାରେ ମୋତି ସଜଳ କର୍ଣ୍ଣରେ କୁଣ୍ଡଳ ଗୋ",
          "ଅଧର ସୁରଙ୍ଗ ବିମ୍ବଫଳ ନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଙ୍କଣ ଅଙ୍ଗଦ ଶୋହେ ବାହୁ ମୃଣାଳରେ ଗୋ",
          "ଗଳେ ନବ କୁସୁମରେ ମାଳ",
          "ନବ ଜଳଧିରେ କିବା କ୍ଷଣପ୍ରଭା ଆଭା ଗୋ",
          "ତନୁରେ ଶୋହେ ପୀତ ଦୁକୂଳ ନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚରଣ କଞ୍ଜରେ ମଣିମଞ୍ଜୀର ବାଜେଣି ଗୋ",
          "ମନମଥ ଜଗିଛି କି ଜାଣି",
          "ଭଣେ ମର୍ଦ୍ଦରାଜ ନିଶ୍ଚେ ପଞ୍ଚଶର ତୋଳି ଗୋ",
          "ବଧିବ ସେ କୁଳର ରମଣୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
