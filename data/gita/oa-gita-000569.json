{
  "id": "oa-gita-000569",
  "name": {
    "en": "Bhaja mana braja bana dwijarajanku",
    "or": "ଭଜ ମନ ବ୍ରଜବନ ଦ୍ୱିଜରାଜଙ୍କୁ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhaja-mana-braja-bana-dwijarajanku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଜ ମନ ବ୍ରଜବନ ଦ୍ୱିଜରାଜଙ୍କୁ",
          "ଅଜ ଶେଷ ଭବ ବନ୍ଦ୍ୟ ପଦକଞ୍ଜକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନେତ୍ରେ ରଞ୍ଜି ଦିବ୍ୟାଞ୍ଜନ ପ୍ରେମରେ କର ଲୋକନ",
          "ବକ୍ରେ ବଂଶୀ ହୃଦେ ଚାରୁ ଗୁଞ୍ଜ ସ୍ରଜକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅମ୍ବୁଜ କୁଟୁମ୍ବ କନ୍ୟା ପ୍ରତୀର କଦମ୍ବ ବନ୍ୟା",
          "ନଭଚର ରାଧା ସ୍କନ୍ଧ ନ୍ୟସ୍ତ ଭୁଜକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଶୁପୀ ନକ୍ଷତ୍ରାବଳୀ ହୋଇ ସର୍ବତ୍ର ମଣ୍ଡଳୀ",
          "ସାଜିଛନ୍ତି ସ୍ମର ପରାଜୟ ସଜକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଖିଳ ରସ ଶ୍ରୀମୂର୍ତ୍ତି କୋଟିଏ ମଦନଦ୍ୟୁତି",
          "ଅନା ସେ ନବ ଶିଖଣ୍ଡଚୂଳ ଧ୍ୱଜକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀ ପ୍ରତାପରୁଦ୍ର ଦେବ ଭାଷନ୍ତି ସନ୍ତତ ଭାବ",
          "ହର ଜନ୍ମାନ୍ତର ଅହଂ ତମ ପୁଞ୍ଜକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhaja-mana-braja-bana-dwijarajanku/"
    }
  ],
