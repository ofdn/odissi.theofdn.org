{
  "id": "oa-gita-001448",
  "name": {
    "en": "Arunambuja charana",
    "or": "ଅରୁଣାମ୍ବୁଜ ଚରଣା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000016"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/arunambuja-charana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅରୁଣାମ୍ବୁଜ ଚରଣା ତୁ ରସାରେ ଭରସାରେ",
          "କରୁଣାନିଧି ଶରଣାଗତଠାରେ କି ରୁଷାରେ ।ପଦ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅସିତ କେଶି ମୁଁ ତୋ ପରିଚାର",
          "ରୁଷିକି ନ କରି କିଛି ବିଚାର",
          "ସ୍ଵଗୁଣ ସରିତ ପତି ତୋ ପରିତ ନାହିଁ ସରସାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ ରହି ସୁଦନ୍ତି ବଦନ ପୋତି",
          "କଳପ ଅଳପ ହସନ ମୋତି",
          "ମୃଦୁଳ-ସରସ-ରସ ହୃଦୟା ତୁ ହୋ ନା ପରୁଷାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନନେ ଉନ୍ମାଦ ଧୃତିକି ଛାଣି",
          "ଗରଳ ଗିଳିବଟି ପିକବାଣି",
          "ତରକି ହୃଦୟ କର କିଶଳୟ ଗଣ୍ଡେ ତ ରସାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନକର ମୁକୁରମୁଖୀ ନିରାଶ",
          "ବିଷମ ବଡ଼ କୁସୁମ ଶରାସ",
          "ସହଜରେ ମିତ ବଚନ ଅମୃତ ଧାରା ବରଷାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅତିରତି ପରି ଚିନ୍ତି ସୁଧୀର",
          "ନୀତି ପୁଣି ମୁରମଥ ନ ଗୀର",
          "ଅଷ୍ଟଦୁର୍ଗପତି କହେ ସ୍ମିତବତୀ ହେଲେ ତରସାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/arunambuja-charana/"
    }
  ],
