{
  "id": "oa-gita-001057",
  "name": {
    "en": "Janaibi sina bare bare",
    "or": "ଜଣାଇବି ସିନା ବାରେ ବାରେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/janaibi-sina-bare-bare-khambaja-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଣାଇବି ସିନା ବାରେ ବାରେ ରସବତୀକି",
          "ଶୁଣା ନୋହିଲେ ମୋର କି ଉପାୟ ଅଛି ଏଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିଖାଇ ପ୍ରଣୟ ରୀତି ଦେଖାଇ ଅନେକ ନୀତି",
          "ଦେଖାଦେଖି ହେଲା ପରି ଉଚିତ ଭାରତୀ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଝଳାଇ ମନ ମନ୍ଦରେ ଛଳାଇ ତାକୁ ପ୍ରେମରେ",
          "ହେଳା ତେଜି ବାଳା ବଳାଇଲା ପରି ମତିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ଲାଗି ମୁରଲୀଧର ହେଲା ଏଥର ଅଥିର",
          "ଭୁଲାଭୁଲି କରିବାର ହୋଉ ବୋଲି ଏତିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦ୍ୱିଜ ରଘୁନାଥ ଭାଷି ଦୂତୀ କିଶୋରଙ୍କୁ ତୋଷି",
          "ଗଜଗତି ନିକଟକୁ କଲେ ବେଗେ ଗତିକି"
        ]
      }
    ]
  },
  "sources": [
