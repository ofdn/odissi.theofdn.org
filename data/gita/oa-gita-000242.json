{
  "id": "oa-gita-000242",
  "name": {
    "en": "Jibana bandhu maguni",
    "or": "ଜୀବନବନ୍ଧୁ ମାଗୁଣି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000055"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jibana-bandhu-maguni-maguchi-re-etiki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୀବନବନ୍ଧୁ ମାଗୁଣି ମାଗୁଛି ରେ ଏତିକି",
          "ନାହିଁ କରିବୁ ନାହିଁଟି କହିଲା ବିନତିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନଚାଇ ଚରମେ ବେଣୀ ବଜାଇ ବଟି କିଙ୍କିଣୀ",
          "ଝୁଲାଇବୁ ବିପରୀତେ ଭୁଲାକିର ମୋତିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ତନ ତୁଲେ ତୋରା ହାରା ତାଟଙ୍କ ଝଲକା ଝରା",
          "ଚଳାଇବୁ ଚାହିଁ ମୋତେ ନ ଲିଭାଇ ବତୀକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିଲୋକିଛି ଦରାଧର ଭିଡ଼ା ମୁଖ ସୁଧାକର",
          "ସ୍ୱେଦ ଜରଜର ଅନମ୍ବର ଦେହ ଦ୍ୟୁତିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲତା ମଧ୍ୟରେ ନେଇ ଖଞ୍ଜନ ଡୋଳା ଖେଳାଇ",
          "ଯାହା ବୋଲୁଥିବୁ ଶୁଭୁଥିବଟି ମୋ ଶ୍ରୁତିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦୁଃଖରୁ ଉଦ୍ଧରିବାକୁ ଥିଲେ ଗୋପାଳକୃଷ୍ଣକୁ",
          "ଅଙ୍ଗୀକାର କରି ଥରେ ପଠିଆଅ ଦୂତୀକି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
