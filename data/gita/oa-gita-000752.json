{
  "id": "oa-gita-000752",
  "name": {
    "en": "Tanku kie boluthai go",
    "or": "ତାଙ୍କୁ କିଏ ବୋଲୁଥାଇ ଗୋ"
  },
  "composer": "oa-person-000110",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tanku-kie-boluthai-go-parama-dayalu-hari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତାଙ୍କୁ କିଏ ବୋଲୁଥାଇ ଗୋ ପରମ ଦୟାଳୁ ହରି",
          "କାହିଁ ଦେଖିଅଛ ମାମୁକୁ ଭଣଜା",
          "ଜୀବନେ ପକାଏ ମାରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାକ କୋଳେ ପିକ ପାଳିଲା ପରାୟେ",
          "ସେବିଥିଲେ ଗୋପନାରୀ",
          "ପୋଷନ୍ତା କାଳକୁ ଛାଡ଼ି ପଳାଇଲେ",
          "ରହିଲେ ମଥୁରାପୁରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଭା ଲୋଭେ ଶିଶୁପାଳ ବୀର ଆସି",
          "ଥିଲା ବରବେଶ ଧରି",
          "ଚଣ୍ଡୀ ପୁରୁ ଭଣ୍ଡି କନ୍ୟା ଘେନିଗଲେ",
          "ଲାଜରେ ସେ ଗଲା ଫେରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରାମ ଅଭିରାମ ରୂପ ଦେଖି କାମ",
          "ଲୋଭେ ଶୂର୍ପଣଖା ନାରୀ",
          "ଆସିଥିଲା ଆଶା କରି ତାର ନାସା",
          "କାଟି କଲେ ହତଶିରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୈଲୋଚନ ବୋଲି ଏକ ବୀର ଥିଲା",
          "ହେଲେ ତାର ମନୋହାରୀ",
          "କୂଟ କରି ଚୁଟି ଓପାଡ଼ି ତାହାକୁ",
          "କେଶକାଟ ଦେଖି ମାରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କାନନ ମଧ୍ୟରୁ ଜନକ ସୁତାକୁ",
          "ରାବଣ ଯେ ନେଲା ହରି",
          "ବିନା ଦୋଷେ ସିନ୍ଧୁ ବାନ୍ଧି ପକାଇଲେ",
          "ବାଳୀକି ବିନାଶ କରି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବଳୀ ମନ୍ଦିରକୁ ଛଳି ବିଜେ କଲେ",
          "ବାମନ ମୂରତି ଧରି",
          "ଭିକାରୀ ହୋଇଣ ଧିକ୍କାରି ଚାପିଲେ",
          "ରଖିଲେ ପାତାଳ ପୁରୀ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଜଳନ୍ଧର ବୀର ଶାଳକ ତାଙ୍କର",
          "ଭାବେ ରହି ତାର ପୁରୀ",
          "ହରି ତା ସତୀକି ପୁଣି ତା ପତିକି",
          "ହର କରେ ବଧ କରି"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ପାଣ୍ଡବେ ତାଙ୍କର ସୁହୃଦ ବାନ୍ଧବ",
          "ଜାଣନ୍ତି ଏ ତିନି ପୁରୀ",
          "ଭୀମ ସୁତ ବେଲାବଳୀକି ମାଇଲେ",
          "କେଉଁ ଅବିଗୁଣ ଧରି"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ପୁତ୍ର ହତ ଶୁଣି ଗୁରୁ ଦ୍ରୋଣ ପୁଣି",
          "ପଡ଼ିଥିଲେ ଜ୍ଞାନ ହାରି",
          "ମାର ବୋଲି ଧୃଷ୍ଟଦ୍ୟୁମନଙ୍କୁ ପରା",
          "ଦେଖି ଦେଲେ ଆଖି ଠାରି"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ରାସମଣ୍ଡଳରୁ ବ୍ରଜଦେବୀଙ୍କି ଯେ",
          "ଘେନି ଗଲେ ଭୁଜ ଧରି",
          "ଏକା କରି ଗିରିଟେକା ଛାଡ଼ି ଗଲେ",
          "କନ୍ଧରୁ ପକାଇ କରି"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ଶୁକ୍ରଠାରେ ବକ୍ର ହୋଇ କୁଶମୁନ",
          "ଭୂଷି ଦେଲେ ସ୍ଥିର କରି",
          "ବ୍ରାହ୍ମଣକୁ କଣା କଲେ କାହିଁପାଇଁ",
          "କେଉଁ ଅବିଗୁଣ ଧରି"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ଯେଉଁ ଗୋରୁହତ୍ୟା ଈଶ୍ୱରେ ଲାଗିଲା",
          "ଗଲେ କୈଳାସୁଁ ବାହାରି",
          "କଉତୁକେ ଷଣ୍ଢାସୁରକୁ ମାଇଲେ",
          "ପାପ ପୁଣ୍ୟ ନ ବିଚାରି"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ଆମ୍ଭେ ଗୋପୀମାନେ ଯମୁନାରେ ଦିନେ",
          "କରୁଥିଲୁଁ ଜଳକେଳି",
          "ବସନ ଚୋରାଇ ବୃକ୍ଷରେ ବାନ୍ଧିଲେ",
          "ମହତ ନେଲେ ଆମ୍ଭରି"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ଗଉରଚରଣ ବୋଲେ ଗୋପୀଗଣ",
          "ହରିଙ୍କି ନିନ୍ଦା ନ କରି",
          "ଜଗତଯାକର ପ୍ରଭୁ ସେ ଅଟନ୍ତି",
          "ମହା ମହିମା ତାଙ୍କରି"
        ]
      }
    ]
  },
