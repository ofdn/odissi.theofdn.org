    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାର ଫୁଲଶର ନ ମାର",
          "ସାର ଯଶ ନ ସାର",
          "ସାରସ ଗମନୀ ନିରାଶ ପରାଶରେ",
          "ଧୀର ହଜାଇ ଅଥିର ହୋଇଛି ମୁହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହର ସିନା ପର ତୋହର",
          "ପର ହାର ତାପର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭାବ ଛାଡ଼ି ନୁହଁ ଅଭାବ",
          "ଭାବ ତେଜି ପ୍ରଭାବ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭଣି କବିଚନ୍ଦ୍ର ନ ଭଣି",
          "ବାଣୀ ରହୁ ସୁବାଣି"
        ]
      }
    ]
  },
