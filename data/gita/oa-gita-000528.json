{
  "id": "oa-gita-000528",
  "name": {
    "en": "Kaha go ki buddhi karibi",
    "or": "କହ ଗୋ କି ବୁଦ୍ଧି କରିବି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-go-ki-buddhi-karibi-prananatha-naile-ta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ ଗୋ କି ବୁଦ୍ଧି କରିବି",
          "ପ୍ରାଣନାଥ ନଇଲେ ତ ଜୀବନ ହାରିବି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେ ଦେଶରେ ରହିଛନ୍ତି ମୋର ପ୍ରାଣପତି",
          "ସେ ଦେଶରେ ନାହିଁ ପରା ମାର ଶର ଭୀତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେତିକି ଟେକନ୍ତି କାନ୍ତ ତେତିକି ପକାନ୍ତି",
          "ଭ୍ରମରଙ୍କ ପରି ସିନା ପୁରୁଷଙ୍କ ମତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଙ୍କ ବିନା ମୋତେ କାନ୍ତ ନ ବସାନ୍ତି ଆନେ",
          "ସେ ଏଡ଼େ ନିଷ୍ଠୁର ବୋଲି ଥିଲା କାହା ମନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅବଧି ତ ବଳିଗଲା କାନ୍ତ ମୋ ନଇଲେ",
          "କାହା ସୁଖ ଅଭିଳାଷେ ମୋତେ ପାସୋରିଲେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ବନମାଳୀ ଦାସ ସ୍ଥିର କରି ମତି",
          "ଅବଶ୍ୟ ଆସିବେ ଶ୍ୟାମ ନ ଭାଳ ଶ୍ରୀମତୀ"
        ]
      }
    ]
  },
  "sources": [
