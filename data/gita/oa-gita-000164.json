{
  "id": "oa-gita-000164",
  "name": {
    "en": "Jebe nabaghana syama bansi swana",
    "or": "ଯେବେ ନବଘନ ଶ୍ୟାମ ବଂଶୀସ୍ୱନ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jebe-nabaghana-syama-bansi-swana-kedara-kamodi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯେବେ ନବଘନ ଶ୍ୟାମ ବଂଶୀସ୍ୱନ",
          "ନିଶୀଥରେ ଥରେ ଶୁଣାଯିବ",
          "ସଖୀ ସୁଖେ ବନେ ମୋଦମୟ ମନେ",
          "ବିହରିବୁ ତୋର ଉଣା ଯିବ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରସରିବ ମତ୍ତ ମିଳିନ୍ଦ ସଙ୍ଗୀତ",
          "କଳପିକ ରୁତ ମଳୟ ମରୁତ",
          "ଚରାଚର ଲୋକ ଧରାରେ ପୁଲକ",
          "ପରାନନ୍ଦ ବୀଜ ବୁଣାଯିବ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଳିନ୍ଦଜା କୂଳ ବିପିନ ବକୁଳ",
          "ମଞ୍ଜୁଳ ମଞ୍ଜରୀ ନିଳୟ ବଳୟେ",
          "ସୁରଭି ସୁଷମ ବିବିଧ କୁସୁମ",
          "-ମୟ ଚନ୍ଦ୍ରାତପ ଟଣାଯିବ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆମ୍ଭେମାନେ ଘେରିଥିବୁ ପରିଚାରୀ",
          "ଜନ ପରି ଚାରି ପାରୁଶରେ ଘେରି",
          "ଲକୁଚ କୁଚାରେ ନୃପ ଉପଚାରେ",
          "ଏ ପଦ ପହଣ୍ଡ ମଣାଯିବ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହେବ ସ୍ମର ବଳ ଜନ୍ୟ ମହୋଜ୍ଜ୍ୱଳ",
          "ଶୃଙ୍ଗାର ମଙ୍ଗଳମୟ ବନସ୍ଥଳ",
          "କଳାବତୀ କୁଳବ୍ରତ ତରୁ ମୂଳ",
          "ଜଟାତଟୀଠାରୁ ହଣାଯିବ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କିଶୋର ଅରୁଣ ପଙ୍କଜ ଚରଣ",
          "ସ୍ତନେ ଲଗାଇବା ତା ତୁଲେ ଗାଇବା",
          "ବ୍ରଜ ବରାରୋହା ସମୁଦୟ ମହା",
          "ଧନ୍ୟ ମୂର୍ଦ୍ଧନ୍ୟରେ ଗଣାଯିବ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗପତି କହେ ଗୋ ସୁଦତି",
          "ଦୁଇ ହୃଦ ସ୍ନେହ ପୀୟୂଷ ପ୍ରବାହ",
          "ବଇଶାଖ ରାକା ରଜନୀରେ ଏକା",
          "ଛଣାଗଲା ପରି ଜଣାଯିବ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
