{
  "id": "oa-gita-001010",
  "name": {
    "en": "Jaya brusabhanu nandini",
    "or": "ଜୟ ବୃଷଭାନୁ ନନ୍ଦିନି"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000031"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaya-brusabhanu-nandini-radhe-baradi-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଜୟ ବୃଷଭାନୁ ନନ୍ଦିନି ରାଧେ",
          "ଜୟ ସୁଷମା ଗୁଣ ବନ୍ଦିନି ରାଧେ",
          "ଜୟ ବିଷମାଶୁଗ ମାନସମୋହିନି",
          "ଜୟ ରସନାଗରୀ ପଙ୍କଜବାସିନି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନନ୍ଦତନୟ ଜଗଦ୍‌ବନ୍ଦନ",
          "ମନ୍ଦରଧର ଆନନ୍ଦକାରିଣି",
          "ସୁନ୍ଦରୀମଣି ଅରବିନ୍ଦବଦନି",
          "ମଦ ସିନ୍ଧୂର ଗାମିନି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବ୍ରଜମଣ୍ଡନି ଧନି ସଜନି କୁମୁଦବ୍ରଜ",
          "ରଜନୀକର ସମ ଉଲ୍ଲାସିନି",
          "ନଜର ରଖ କୃପାରେ କବିଦ୍ୱିଜରାଜ ରଘୁନାଥକୁ",
          "ମନେ ନିଜ ଦାସୀ ବୋଲି ଏ ଘେନି"
        ]
      }
    ]
  },
  "sources": [
