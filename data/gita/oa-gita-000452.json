  "name": {
    "en": "Chhalabahinisa he chhada",
    "or": "ଛଳବାହିନୀଶ ହେ ଛାଡ଼"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000003"
