  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Chha Patala",
      "or": "ଛ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhalabahinisa-he-chhada-e-sahasa-he-chha-champu-mukhabari-mukhari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛଳବାହିନୀଶ ହେ",
          "ଛାଡ଼ ଏ ସାହସ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଛବି ତ ଆବିଳ ଦିଶେ",
          "ଛପିବାରେ ଅଛି କି ସେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛଟା କାହା କଟାକ୍ଷର",
          "ଛୁରୀ ହେଲା କି ବକ୍ଷର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଛେଲରୁ ତ ଚିନ୍ତା ବଳି",
          "ଛାତିରେ ଗଲାଣି ଗଳି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଛୁଟିଯାଇ ବିଚେତନା",
          "ଛଟପଟ ହେବ ସିନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଛଣା ସୁଧା ପରି ଦିଶେ",
          "ଛୁଇଁଦେଲେ ବିଷଟି ସେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଛନ୍ଦି ମନ ତୁମ୍ଭ ଗୁଣେ",
          "ଛ ଦୁଇ ଦୁର୍ଗେଶ ଭଣେ"
        ]
      }
    ]
  },
  "sources": [
