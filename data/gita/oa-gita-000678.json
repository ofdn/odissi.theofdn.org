{
  "id": "oa-gita-000678",
  "name": {
    "en": "Ki hela go mote chahun chahun",
    "or": "କି ହେଲା ଗୋ ମୋତେ ଚାହୁଁ ଚାହୁଁ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000165"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-hela-go-mote-chahun-chahun-todipunnaga-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ହେଲା ଗୋ ମୋତେ ଚାହୁଁ ଚାହୁଁ",
          "ଏପରି ତ ହେଲି ସହୁ ସହୁ",
          "ତନୁଗୋଟି ଯାକ ପୂରୁଛି ପୁଲକ",
          "ଏବେ ସେ କଥାକୁ ଭାବି ଦେଉଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତପନସୁତା ତଟ ନିକଟେ",
          "ଶ୍ୟାମ ବସିଥିଲେ ବଂଶୀ ବଟେ",
          "ଅଜାଣେ ସେ ତରୁ ମୂଳକୁ ଯିବାକୁ",
          "ଉପରାଣ ଧରି ଟାଣି ନେଉଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଞ୍ଜବନରେ କୁସୁମ ତୋଳୁଁ",
          "ମାଧବ ଆସି ମାଧବୀ ତଳୁ",
          "ଅଜଣାରେ ମୋର ନେତ୍ର ବୁଜି କର",
          "କିଏ ଚିହ୍ନ ବୋଲି ଥରେ କହୁଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯମୁନାକୁ ଯାଉଁ ନୀର ଆଣି",
          "ସଙ୍ଗତେ ଥିଲେ ସଜନୀ ଶ୍ରେଣୀ",
          "ମୋ ଆଡ଼େ ଅନାଇଁ ନନ୍ଦର କହ୍ନାଇ",
          "ମୋହନ ମୁରଲୀ ବାଉଁ ବାଉଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଙ୍ଗ ସଖାମାନଙ୍କର ମେଳେ",
          "ଗୋରୁ ଗୋଷ୍ଠରୁ ଫେରିବା ବେଳେ",
          "ସେ ବାଙ୍କଚୂଳିଆ ପୀତ ଦୁକୂଳିଆ",
          "ନୟନ ତେରଛେ ଢାଳି ଯାଉଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅନାୟତ ହୋଇ ଗଲି ସହି",
          "ବୁଦ୍ଧି ଆଉ କିଛି ଦିଶୁ ନାହିଁ",
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ବୋଲଇ ବିଷମ",
          "ଦଶା ପଡ଼ିଗଲା ପ୍ରୀତି ନୋହୁ"
        ]
      }
    ]
  },
  "sources": [
    {
