{
  "id": "oa-gita-000046",
  "name": {
    "en": "Rusa baraja mrudukrusangi",
    "or": "ରୁଷା ବରଜ ମୃଦୁକୃଶାଙ୍ଗୀ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rusa-baraja-mrudukrusangi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରୁଷା ବରଜ ମୃଦୁକୃଶାଙ୍ଗୀ",
          "ଶିଶୁମୃଗଦୃଶାଟି ବିଚକିଳହସାଟି ରେ ।",
          "ଭସାଇ ନ ଦିଅ ସରସାପ୍ରବର",
          "ଅଭରସାଜଳେ ମୋ ଶୁଭଦଶାଟି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପରାଭବରୁ ମୋତେ ଖରାବ ନ କର ରେ",
          "ତରାବରମୁଖୀ ମୁଁ ତୋ ଶାଟୀରେ",
          "ଧରାମାଣିକ୍ୟମଣିଝରା ମଦନ କରେ",
          "ମରାଇ ହେବୁ ଲୋକହସାଟି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷମାଜଳଧି ଭିଡ଼ି ଜମାଇ ଊରଜ",
          "ଭରମାଚଳରେ ନିଅ ନିଶାଟି ରେ",
          "ଗୁମାନକୁ ନୁହଇଁ ସମାନ ମୁଁ ତୋହର",
          "ତମାଳକିଶଳୟକେଶାଟି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନା ନ କର ସୁନୟନା ସଦୟ ରସ",
          "ଅନାଉଣିକି ବରଯୋଷାଟି ରେ",
          "ଅନାଅ ପରି ଦୀନମନା ହେଉଛି ଧନ",
          "ଅନାଇ ନତମୁଖ ବସାଟି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅକାରଣେ ସଦ୍ୟୁତି ଚକା ଲପନ ପୋତି",
          "ନ କାନ୍ଦ ବସୁମତୀଭୂଷାଟି ରେ",
          "ଜକାଜକି ଚୁମ୍ବନ ସକାମେ ରଚି ଧନ",
          "ପକାଅ ହରି ମୋର ତୃଷାଟି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରସାଅ ରସରେ ତ ରସା ହେଉଛି",
          "ମଧୁରସା ସଦୃଶ୍ୟ ରସ କଷାଟି ରେ",
          "ରସାତିଳକ ହରିଚନ୍ଦନ ଦେବ ଗୋରୀ",
          "ତୋ ଚରଣ ଶରଣପଶାଟି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
