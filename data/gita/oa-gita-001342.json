  "name": {
    "en": "Ki kahibi sahi go mora mana katha",
    "or": "କି କହିବି ସହି ଗୋ ମୋର ମନ କଥା"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000172"
  ],
  "mula_tala": [
