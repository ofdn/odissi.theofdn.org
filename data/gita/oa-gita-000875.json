{
  "id": "oa-gita-000875",
  "name": {
    "en": "Balamani mun kari nahin",
    "or": "ବାଳାମଣି ମୁଁ କରି ନାହିଁ"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000130"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000007"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/balamani-mun-kari-nahin-kumbha-kamodi-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାଳାମଣି ମୁଁ କରି ନାହିଁ ଦୋଷ",
          "ଅକାରଣେ କିମ୍ପା ବହିଛୁ ରୋଷ",
          "ବୃଷଭାନୁ ତନୟା ହେଲେ ନିର୍ଦ୍ଦୟ ହିଆ",
          "ବିରହାନଳେ ମୁଁ ଗଲିଟି ନାଶ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗତ ରାତ୍ରରେ ଆସୁଁ ତୁମ୍ଭ ପାଶ",
          "ନିକୁଞ୍ଜ ପଥୁଁ ମୋତେ ନୀଳବାସ",
          "ସଖାଗଣ ସଙ୍ଗରେ ଖେଳିବାକୁ ରଙ୍ଗରେ",
          "ବଳେ ନେଇ କଲେ ଏ ନାରୀ ବେଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତରଣି ତନୟା ତଟେ ମହେଶ",
          "ପ୍ରିୟା ପୂଜୁଁ ହେବାରୁ ନିଶି ଶେଷ",
          "ସଖାଗଣକୁ ଛାଡ଼ି ଆସିଲି ମୁଁ ଦଉଡ଼ି",
          "ହୋଇଣ ଶଙ୍କା ପଙ୍କିଳ ମାନସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହେଠ କର କିମ୍ପା ମୁଖ ସାରସ",
          "କଟୁ ବାଣୀଗଣ କାହିଁକି ଭାଷ",
          "ଶ୍ରୀ ବିକ୍ରମ ବନ୍ଦିନୀ ରାସ ବିନୋଦିନୀ",
          "ତରେ କୋଳ କରି ଦାସକୁ ତୋଷ"
        ]
      }
    ]
  },
  "sources": [
    {
