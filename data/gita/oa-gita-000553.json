{
  "id": "oa-gita-000553",
  "name": {
    "en": "Jala ani jai kali kalinda sutaku",
    "or": "ଜଳ ଆଣି ଯାଇ କାଲି କଳିନ୍ଦ ସୁତାକୁ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000137"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jala-ani-jai-kali-kalinda-sutaku-gopalakrusna-nagaballi/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଜଳ ଆଣି ଯାଇ କାଲି କଳିନ୍ଦ ସୁତାକୁ",
          "ଫଳ ପାଇଲି ଅନାଇ ରେ ସଙ୍ଗାତ",
          "କଦମ୍ବ ମୂଳକୁ ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୀରଦଟି ନୀଳମଣି ପ୍ରତିମା ସେ କିଛି",
          "ବାରି ପାରିଲି ନାହିଁ ରେ ସଙ୍ଗାତ",
          "ନୟନେ ନାଚୁଛି ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଘମ ଘମ ନୀଳୋତ୍ପଳ କସ୍ତୁରୀ ସୁବାସ",
          "ଘନ ଘନ ଆସୁଥିଲା ରେ ସଙ୍ଗାତ",
          "ହୋଇଲି ଅବଶ ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଛେ ପଛେ କେକୀ ବୃନ୍ଦ ମତ୍ତେ ପୁଚ୍ଛ ଟେକି",
          "ଡାକି ଡାକି ନାଚୁଥିଲେ ରେ ସଙ୍ଗାତ",
          "କହ ସେ କାହିଁକି ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଛପି ଛପି ନିକୁଞ୍ଜ ପୁଞ୍ଜ ତଳ ତଳରେ",
          "ଆସି ଆସି ପାଇଗଲେ ରେ ସଙ୍ଗାତ",
          "ଆଗେ କି ବେଗରେ ସଙ୍ଗୀତ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଝୁମୁ ଝୁମୁ ଧ୍ୱନି ଶୁଣି ଏଣେ ତେଣେ ମୁହଁ",
          "ଅନାଉ ଅନାଉ ରହି ରେ ସଙ୍ଗାତ",
          "ବୋଇଲେ କେ ନାହିଁ ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଦର ଦରଶନ କରି ଚମକି ପଡ଼ିଲି",
          "ଦମ ଦମ ହେଲା ଛାତି ରେ ସଙ୍ଗାତ",
          "ମଥା ପୋତିଦେଲି ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ପ୍ରଚଳାଗ୍ର ପ୍ରଚଳାକ କମନୀୟ ଚୂଳ",
          "ଢଳ ଢଳ ଖେଳୁଥିଲା ରେ ସଙ୍ଗାତ",
          "ଗଣ୍ଡରେ କୁଣ୍ଡଳ ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଥରି ଥରି ଥରିଗଲି ବିବେକ ହଜିଲା",
          "ଜର ଜର ହୋଇଗଲି ରେ ସଙ୍ଗାତ",
          "ଝାଳ ବୁଡ଼ାଇଲା ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ପ୍ରତି ପ୍ରତୀକ ଯାକରେ ପୁଲକ ପୂରିଲା",
          "ତର ତର କେତେ ହେଲି ରେ ସଙ୍ଗାତ",
          "ପଦ ନ ଚଳିଲା ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "କରକ ରଦନା କର ପ୍ରସାରୁ ସେ ପୁଣି",
          "କହୁ କହୁ କିସଟି ମୁଁ ସଙ୍ଗାତ",
          "ବାଣୀ ହେଲା ବଟି ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ଶୃଙ୍ଗାର ରସ କି ସ୍ମର ହେବେ ସେ ମୁରତି",
          "ଚାହୁଁ ଚାହୁଁ ଡାକିଦେଲା ରେ ସଙ୍ଗାତ",
          "ଜଟିଳା ଜରତୀ ରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ଆସୁ ଆସୁ ପୁରକୁ ପଥରେ ପଚାରିଲି",
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ରେ ସଙ୍ଗାତ",
          "ବ୍ରଜବିଧୁ ବୋଲିରେ ସଙ୍ଗାତ"
        ]
      }
    ]
  },
