{
  "id": "oa-gita-001034",
  "name": {
    "en": "Samirana suna bare",
    "or": "ସମୀରଣ ଶୁଣ ବାରେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000017"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/samirana-suna-bare-ahari-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପବନ ନିନ୍ଦା",
          "ସମୀରଣ ଶୁଣ ବାରେ ରେ",
          "ଏବେ ବାମ ନୁହ ମୋଠାରେ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୈତ୍ୟ ନାମ ଯେବେ ସତ୍ୟ ବହୁ ତେବେ",
          "ଦୈତ୍ୟାରି କି ବାମକର ମନ୍ଦ ଭାବେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜଗତପ୍ରାଣ ତୁ ଜଗତେ ପ୍ରମାଣ",
          "ଅଗତି ନ କର ଦୁଃଖିନୀକି ପୁଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅବଳାରେ କିମ୍ପା ତୁ ବଳୀ ନୋହିବୁ",
          "କବଳୁ ବଳିରୁ ଭୁଜଙ୍ଗରା ଠାବୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହେ ରଘୁନାଥ କବି ନିଶାନାଥ",
          "ରହେ ଶ୍ରୀ କିଶୋରୀ କହିବା ତ୍ୱରିତ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
