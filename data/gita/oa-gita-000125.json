{
  "id": "oa-gita-000125",
  "name": {
    "en": "Kariba ki buddhi",
    "or": "କରିବା କି ବୁଦ୍ଧି ଶ୍ୟାମ ଜାଣିଲାଣି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kariba-ki-buddhi-syama-janilani-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କରିବା କି ବୁଦ୍ଧି",
          "ଶ୍ୟାମ ଜାଣିଲାଣି ପୁଣି ଲୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁନା ସରୋରୁହ ଲତା । ହୋଇବାରୁ କୁସୁମିତା ।",
          "ସଞ୍ଚରିବାର ଚଞ୍ଚଳେ ଚଞ୍ଚରୀକ ଶ୍ରେଣୀ ଲୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଖଣ୍ଡରସ ସରସରେ । ନ ରସେ ସତ ରସରେ ।",
          "ଅରୁଚି କରୁଚି ପୀୟୂଷକୁ ମଣି ଲୁଣୀ ଲୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କିଶୋରୀର ରଦାମ୍ବର । ଧ୍ୟାନେ ପୁଣି ପୀତାମ୍ବର ।",
          "ଉପରେ ପକ୍ୱବିମ୍ବର ଚୁମ୍ବେ ଗଣି ଗଣି ଲୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୁଚକୁ ଚିତ୍ତରେ ଧ୍ୟାୟି । ଚୁଚକ ଉରେ ଲଗାଇ ।",
          "ଲୋଚନ ବୁଜୁଛି ପରିରମ୍ଭ ସୁଖ ମଣି ଲୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନବଲତାକୁ ନିବିଡ଼େ । ପ୍ରବଳ ଉନ୍ମାଦେ ଭିଡ଼େ ।",
          "ପ୍ରାଣେଶ୍ୱରୀ ହା କିଶୋରୀ ବୋଲି ହୁଏ ଗୁଣି ଲୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଆମ୍ଭ ଆଳିର ତ ବେଶ । ଉଚିତ ହେଲା ବୟସ ।",
          "ଧରି ହୃଦେ ମଣ୍ଡିବ କି ହର ନୀଳମଣି ଲୋ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗ ପୁରନ୍ଦର । କହେ ଦୂରୁଁ ଯୋଡ଼ି କର ।",
          "ଭୀରୁମଦଗଜକୁ ତା ଭୂରୁଭଙ୍ଗୀ ଶାଣି ଲୋ"
        ]
      }
    ]
  },
  "sources": [
    {
