{
  "id": "oa-gita-000895",
  "name": {
    "en": "Sajili seja sajani",
    "or": "ସାଜିଲି ଶେଯ ସଜନୀ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000122"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajili-seja-sajani-bageswari-bagesri-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଜିଲି ଶେଯ ସଜନୀ",
          "ନଇଲେ ମୋ ବରଜରାଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୟନ କଜଳ ଘେନା ଅଧା ତ ରହିଛି ଅନା",
          "ଅଧା ଗୁନ୍ଥା ହାର ମୋର ଶୁଖିଲା ସିନା",
          "(ପଡ଼ି)",
          "ଅଧ ଗଗନେ ଅଧ ଅଧରେ ହସି ଶଶୀ",
          "ଅଧ ନିଶିରେ ଆସି ବସିଲାନି",
          "ରସି ଚକୋରୀ ମନ ସେ ତ ତୋଷିଲାନି",
          "ଉଲାଗି କର ଫୁଲ ସାଜରେ ସଜନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏକା ମୁଁ ହତଭାଗିନୀ ଏକାଳେ ସିନା ସଙ୍ଗିନୀ",
          "ନ ଘେନି ବଚନ ତୋର ଅପରାଧିନୀ",
          "(ପଡ଼ି)",
          "ସାର ତ ଅପବାଦ ମାର ସାଧିଲା ବାଦ",
          "ଛାର ମୁରଲୀ ନାଦ ସାରିଲାନି",
          "କବିଶଶୀ ବଦତି ରାଧା ରୁଷିଲାନି",
          "ଶ୍ୟାମ ନଇଲେ ପୁରେ ଆଜରେ ସଜନୀ"
        ]
      }
    ]
  },
