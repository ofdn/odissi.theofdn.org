  "id": "oa-gita-000367",
  "name": {
    "en": "Prana sangini re hela bada paramada",
    "or": "ପ୍ରାଣସଙ୍ଗିନୀ ରେ ହେଲା ବଡ଼ ପରମାଦ"
  },
  "composer": "oa-person-000029",
  "mula_raga": [
    "oa-raga-000084"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prana-sangini-re-hela-bada-paramada/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣସଙ୍ଗିନୀ ରେ ହେଲା ବଡ଼ ପରମାଦ",
          "ଶୁଭେ କି ରଞ୍ଜନ ଧଇର୍ଯ୍ୟ କମ୍ପନ",
          "ମୋହନ ମୁରଲୀ ନାଦ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଡାକେ ସରସରେ ନ ରଖେ ବାସରେ",
          "ନିରତେ ଲାଗି ବିବାଦ",
          "ଶୁଣିବା ମାତ୍ରକେ ଅନ୍ୟ ତା ବ୍ୟତ୍ରକେ",
          "ମନରେ ହୁଏ ବିଷାଦ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଥିଲେ ଗୁରୁଜନ ହେଲେ ତ ରଞ୍ଜନ",
          "ଝିଙ୍କିନିଏ କରି ପାଦ",
          "ହୋଇଣ ପ୍ରବଳ କରାଏ କେବଳ",
          "ମଦନ ମଦ ଉନ୍ମାଦ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ମଧୁର ଧ୍ୱନି ଲାଗଇ ମୋ ଧୁନି",
          "ବାସରୁ ବଳି ସୁଆଦ",
          "ମରାଇ ରତିରେ ପତିବରତୀରେ",
          "ନିତି କରେ ପରିବାଦ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାମଚନ୍ଦ୍ର ଦେଉ ବୋଲେ କହେ ଆଉ",
          "ଚିନ୍ତି ସେ ଗୁଣାନୁବାଦ",
          "ବୋଲଇ କିଶୋରୀ ତିଳେ କି ପାସୋରି",
          "ଲୋଡ଼େ କାହା ଆହାଲାଦ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prana-sangini-re-hela-bada-paramada/"
    }
  ],
