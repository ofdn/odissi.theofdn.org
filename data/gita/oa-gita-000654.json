{
  "id": "oa-gita-000654",
  "name": {
    "en": "Kaha ki upaya aau re sangini",
    "or": "କହ କି ଉପାୟ ଆଉ ରେ ସଙ୍ଗିନୀ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-ki-upaya-aau-re-sangini-sri-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ କି ଉପାୟ ଆଉ ରେ ସଙ୍ଗିନୀ",
          "କହ କି ଉପାୟ ଆଉ",
          "ଦେଖିଲା ବେଳୁ ସେ ମୋହନ ମୂରତି",
          "ମଦନ ଦେଲାଣି ଦାଉ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁଳଶୀଳ ଲାଜ ମହତ ଆବର",
          "ଜାତି ପଛକେ ମୋ ଯାଉ",
          "ମୁଁ ଯେ ମୂରୁଛିଲେ ନେତ୍ର ନ ମୂର୍ଚ୍ଛଇ",
          "ସେ ମୋ ମନକୁ ମଜ୍ଜାଉ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋ ମନ ତ ତହିଁ ବୁଡ଼ି ରହିଲାଣି",
          "ଥରେ ଅନାଉଁ ଅନାଉଁ",
          "ଅପକୀରତି ଶୋଚନା ମୋ ନାହିଁ",
          "ତୁ କିମ୍ପା ମୋତେ ଭଙ୍ଗାଉ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତ୍ରିଭଙ୍ଗିମା ଠାଣି ବଙ୍କିମା ଚାହାଣୀ",
          "ଅଙ୍ଗ ଦିଶେ ଦାଉ ଦାଉ",
          "ଛବି ନଟବର ନବୀନ ସୁନ୍ଦର",
          "ମୋ ଗଳେ ଭୁଜ ବେଢ଼ାଉ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୋଟି କାମ ଶିରୀ ଯା ବିଗ୍ରହେ ପୂରି",
          "ତା ପ୍ରୀତିରେ ଦିନ ଯାଉ",
          "ବେଣୁଧର ଭାଷି ହେବି ତାଙ୍କ ଦାସୀ",
          "ପିଣ୍ଡେ ପ୍ରାଣ ଥାଉଁ ଥାଉଁ"
        ]
      }
    ]
  },
  "sources": [
