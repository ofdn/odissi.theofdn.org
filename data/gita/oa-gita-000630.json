{
  "id": "oa-gita-000630",
  "name": {
    "en": "Ase ki range dhali",
    "or": "ଆସେ କି ରଙ୍ଗେ ଢଳି"
  },
  "composer": "oa-person-000117",
  "mula_raga": [
    "oa-raga-000083"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ase-ki-range-dhali-mangala-gujjari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସେ କି ରଙ୍ଗେ ଢଳି ରସ ରଙ୍ଗିନୀ ରେ",
          "ହୁଅନ୍ତା କି ଏ ମୋ ପ୍ରାଣ ସଙ୍ଗିନୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ନବରଙ୍ଗିନୀ ବର କୁନ୍ଦନ ଅଙ୍ଗିନୀ",
          "ଯୋଗେଶ ଯୋଗ ଭଙ୍ଗିନୀ ଚାରୁ ଭ୍ରୂଭଙ୍ଗିନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାଳାର ଚାତୁର୍ଯ୍ୟ ଭଙ୍ଗୀ କନ୍ଦର୍ପ କତୁରୀ",
          "ସିଦ୍ଧ ବ୍ରହ୍ମଚାରୀ ଧୈର୍ଯ୍ୟ ଦେବ ତ କତୁରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅନୁକ୍ଷଣେ ତା ତୀକ୍ଷଣ ଈକ୍ଷଣ ଅଞ୍ଚଳ",
          "ବନୁ ବଣା ଏଣୀ ଚାହାଣୀରୁ ତ ଚଞ୍ଚଳ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲାବଣ୍ୟ ରସନିଧିର ଭାବ ଚମତ୍କାର",
          "ବିଲୋକନେ ଅଙ୍ଗେ ଜନ୍ମେ ମଦନ ବିକାର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପ୍ରିୟସଖି କରେ କର ଭାର ଦେଇ ରଙ୍ଗେ",
          "କି କଥା ହୁଅଇ ସ୍ମିତ ହାସେ କି ପ୍ରସଙ୍ଗେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଭଲା ସୁଯୋଗରେ ଭେଟ ପଡ଼ିଛି ଛଇଳୀ",
          "କରନ୍ତି କି ତାକୁ ମୋର ଗଳା ସୁନାମାଳି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କହେ ଭୃଙ୍ଗବର କୁଞ୍ଜବିହାରୀ କେଶରୀ",
          "ରସିକ ରାଜ୍ୟେ ମୋ ତୁଲେ ହୁଅନ୍ତା କେ ସରି"
        ]
      }
    ]
  },
