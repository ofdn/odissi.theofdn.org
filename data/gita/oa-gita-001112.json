{
  "id": "oa-gita-001112",
  "name": {
    "en": "Kaha bachana kalakantha jita bani",
    "or": "କହ ବଚନ କଳକଣ୍ଠ ଜିତ ବାଣୀ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000179"
  ],
  "mula_tala": [
    "oa-tala-000009"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-bachana-kalakantha-jita-bani-kousika-upendra-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସମ୍ପୂର୍ଣ୍ଣ ଚୁମ୍ବନ ଲକ୍ଷଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କହ ବଚନ",
          "କଳକଣ୍ଠ ଜିତ ବାଣୀ ନୋହି ମଉନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରରେ ଗଣ୍ଡ ନ ଧର କମ୍ପାନା ରଙ୍ଗ ଅଧର",
          "ଘେନ ମୋ ବିନୟ ଧରାସ୍ତନା",
          "କି କାରଣେ ମାନ କରିଅଛୁ ଆରେ ମତ୍ତ କରୀ",
          "-ଗତି ଏ ମାନ ନ କରି ଅନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଜ୍ଜ୍ୱଳ ମିଶ୍ରିତ ବାରି ଖସଇ ରଖ ନିବାରି",
          "ନେତ୍ର ପରା ତୋର ବାରିରୁହ",
          "କର ମନରେ ମନ୍ଦରସ୍ତନା କି ତୋର ସୁନ୍ଦର",
          "ଦିଶିଲାଣି ଅସୁନ୍ଦର ଦେହ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାନ୍ତ ଧରି କାନ୍ତା କର ବୋଇଲା ରୋଷ ନ କର",
          "ବନ୍ଧୁ ମୁଁ ତୋ ପରିକର ପରି",
          "କହୁଁ ଏମନ୍ତ ହସିଲା ଦଇତ କୋଳେ ବସିଲା",
          "ରତି ରସରେ ରସିଲା ଗୋରୀ ସେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୃତ ସମ୍ମୁଖେ ରସନା ଚାଳୁଁ ଉଭୟେ ରସନା",
          "ବଜାଇ ନୀଳବସନା ମୋହି",
          "କହି ସମ୍ପୂର୍ଣ୍ଣ ଚୁମ୍ବିତ ଉପେନ୍ଦ୍ର ସୁଗ୍ରୀବ ମିତ୍ର",
          "ଭଜଇ ସୁଖ ଅମିତ ବହି"
        ]
      }
    ]
  },
  "sources": [
