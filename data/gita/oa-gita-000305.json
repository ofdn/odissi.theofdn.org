{
  "id": "oa-gita-000305",
  "name": {
    "en": "Sajani mohana murati chhai lo",
    "or": "ସଜନୀ ମୋହନ ମୂରତି ଛଇ ଲୋ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-mohana-murati-chhai-lo-bhairabi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ମୋହନ ମୂରତି ଛଇ ଲୋ",
          "ଉପମା ଦେବାକୁ ନାହିଁ ଲୋ",
          "ଇନ୍ଦୀବର ନୀଳରତନ ମୁଦିରେ",
          "ଏ ମାଦକ ଅବା କାହିଁ ଲୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ସୁନ୍ଦର ନେତ୍ର ଦୁହେଁ ଲୋ ସଜନୀ",
          "କର୍ଣ୍ଣ ସରି ଯାଏଁ ରହେ",
          "ଫୁଟିଯାଏ ହୃଦ ମଦନ ବିଶିଖେ",
          "ଗ୍ରୀବା ଢାଳି ଯେବେ ଚାହେଁ ଲୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ସୁନ୍ଦର ମୃଦୁବାଣୀ ଲୋ ସଜନୀ",
          "ସତେ କି ପୀୟୂଷ ଛାଣି",
          "ଅନଙ୍ଗ ଅଙ୍ଗ ପାଇବାକୁ ରଖିଛି",
          "ଏହି ଠାରେ ବିହି ଆଣି ଲୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ଭଙ୍ଗୀରେ ହୁଏ ଛିଡ଼ା ଲୋ ସଜନୀ",
          "କି ଶୋଭା ତା ବାଙ୍କଚୂଡ଼ା",
          "ବାନ୍ଧିଥାଇ ତହିଁ ମିଶାଇ ଶିଖଣ୍ଡ",
          "କାମିନୀଙ୍କ ବ୍ରୀଡ଼ାଛଡ଼ା ଲୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରମ୍ୟ ଅଶ୍ୱିନୀକୁମାର ଲୋ ସଜନୀ",
          "କେ ବୋଲେ ସୁନ୍ଦର ମାର",
          "ନନ୍ଦପୁଅ ଅଙ୍ଗ ସୁନ୍ଦରପଣକୁ",
          "ଲକ୍ଷ ଅଂଶେ କାହା ଛାର ଲୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅର୍ବୁଦେ ଥାନ୍ତା ନୟନ ଲୋ ସଜନୀ",
          "ଦେଖୁଥାନ୍ତି ତା ବଦନ",
          "ବନମାଳୀ କହେ ତେବେହେଁ ସନ୍ତୋଷ",
          "ନୁହନ୍ତା କେବେହେଁ ମନ ଲୋ"
        ]
      }
    ]
  },
  "sources": [
    {
