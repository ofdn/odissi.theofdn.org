{
  "id": "oa-gita-001139",
  "name": {
    "en": "Syama aparadhini mun sangini",
    "or": "ଶ୍ୟାମ ଅପରାଧିନୀ ମୁଁ ସଙ୍ଗିନୀ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-aparadhini-mun-sangini-bilahari-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ଅପରାଧିନୀ ମୁଁ ସଙ୍ଗିନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚନ୍ଦ୍ରାବଳୀକି ଅଣାନ୍ତୁ ସେ ଡାକି",
          "ସେ ସିନା ହୃଦର ବିଳାସିନୀ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗଲେ ଯିବ ଯେଣେ ନ ଛାଡ଼ିବ କ୍ଷଣେ",
          "ଗହଣେ ଥିବ ଦିନ ରଜନୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୋର ତହୁଁ ବଳି ଅଛନ୍ତି ଗୁଆଳୀ",
          "ଯିବେ ତ କଲେ ମୁରଲୀ ଧ୍ୱନି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମଥା ମୋର ବ୍ୟଥା କହି ନୁହେ କଥା",
          "ତୋ କୁନ୍ଦମାଳା ତୁ ନିଅ ଘେନି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହଇ ଗୋପାଳକୃଷ୍ଣ ସହୀ ଚଳ",
          "ପ୍ରୀତିର ଫଳ ତ ମିଳିଲାନି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
