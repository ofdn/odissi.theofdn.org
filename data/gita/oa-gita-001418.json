    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସୁରଠ ରାଗ ସୁର ମନୋରମ",
          "ଦ୍ୱିତୀୟ ପ୍ରହର ଯାମିନୀରେ ଗାଅ",
          "ବାଦୀ ସମ୍ବାଦୀ ଋଷଭ ପଞ୍ଚମ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାତି ଔଡ଼ବ ସମ୍ପୂର୍ଣ୍ଣ ରୂପ",
          "ଶ୍ରୀମେଳ ଧରି ସାଧ ସ୍ୱରୂପ",
          "ଶୁଦ୍ଧ ସକଳ ସ୍ୱର ସହିତ",
          "ଉଭୟ ନିଷାଦ ଗାନ୍ଧାର ଗୁପତ",
          "ସଙ୍ଗତି ସ୍ୱର ମାପାନିଧାମାପା",
          "ରେମା ପାସା ପାନି ଧାପା ଧାମା ପାମା ରେସା"
        ]
      }
    ]
  },
