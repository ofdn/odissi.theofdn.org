{
  "id": "oa-gita-001273",
  "name": {
    "en": "Syama jati mahata dela dhwansi ta",
    "or": "ଶ୍ୟାମ ଜାତି ମହତ ଦେଲା ଧ୍ୱଂସି ତ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000186"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-jati-mahata-dela-dhwansi-ta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ଜାତି ମହତ ଦେଲା ଧ୍ୱଂସି ତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ଭଙ୍ଗୀରେ ହୁଏ ଛିଡ଼ା ନ ରଖେ ଆଖି ପିଛଡ଼ା",
          "କୁଳବତୀ ବ୍ରୀଡ଼ାଛଡ଼ା ଛାଡ଼ି ଆସି ତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ୱର୍ଗେ ନ ଥିବେ ସୁଧାରେ ନ ଦିଶଇ ବସୁଧାରେ",
          "ବହେ ଯା ପୀୟୂଷ ଧାରେ ଭାଷିତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାମ ଛୁରୀ ଚାହିଁବାର ହୃଦେ ପଶେ ବାରବାର",
          "ଥରେ ଅନାଇଲେ ବାରମାସୀ ତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲାଞ୍ଚ ଦେବି ଦେବତାରେ କେ ବୋଲିବ ସେବ ତାରେ",
          "ନାହିଁ ମୁଁ ଜହ୍ନୁ ସୁତାରେ ଭାସି ତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ବନମାଳୀ ସାର ବ୍ରଜନରେନ୍ଦ୍ର କୁମାର",
          "ଶ୍ରୀଅଙ୍ଗକୁ ଛାର ମାର ଭର୍ତ୍ସିତ"
        ]
      }
    ]
  },
  "sources": [
