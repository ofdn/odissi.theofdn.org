{
  "id": "oa-gita-001219",
  "name": {
    "en": "Piyusa bhasi bhasi jauchi",
    "or": "ପୀୟୂଷ ଭାଷୀ ଭାସିଯାଉଛି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/piyusa-bhasi-bhasi-jauchi-todi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପୀୟୂଷ ଭାଷୀ ଭାସିଯାଉଛି ରଖରେ ଆସି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମନମଥ ତଟିନୀରେ ପଡ଼ିଛି ଅଗାଧ ନୀରେ",
          "ରଖ କୀର୍ତ୍ତି ଅବନୀରେ ଉଦ୍ଧରି କୁମୁଦହାସୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବନ୍ଧୁ ମୁଁ ଯାଚକ ପରି ମାଗୁଛି ବାସ ପ୍ରସାରି",
          "ତ୍ରାଣ କର ଶମ୍ବରାରି କୁନ୍ଦୀର ସୁଖ ସୁବେଶି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସ୍ତନ ସ୍ୱର୍ଣ୍ଣ କୁମ୍ଭ ଭେଳା ଅବଲମ୍ବ ଦେଇ ବାଳା",
          "କୋଳ କୂଳକୁ ସୁଶୀଳା ଲଗାରେ ଦୁଃଖ ବିନାଶି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଖିଳ ଅବନୀ ଠରି ସଖୀକି ଡାକିଲା ପରି",
          "ଅଗଣାକୁ ବିଜେ କର ଦେଖାରେ ଶ୍ରୀମୁଖ ଶଶୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ନ ସରୁ କରୁଣା ଦୃଷ୍ଟି ପ୍ରସରୁ",
          "ଅନଙ୍ଗ କ୍ଳେଶ ନିଃସରୁ ପ୍ରଫୁଲ୍ଲ ପଙ୍କଜବାସୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
