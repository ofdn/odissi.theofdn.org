{
  "id": "oa-gita-001095",
  "name": {
    "en": "To gheni tamala syama",
    "or": "ତୋ ଘେନି ତମାଳ ଶ୍ୟାମ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000038"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ta Patala",
      "or": "ତ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/to-gheni-tamala-syama-ta-champu-kabisurjya-desakhya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତୋ ଘେନି ତମାଳ ଶ୍ୟାମ ମୋ ମରଜି କଷିଲା ରେ",
          "ତଥାପି ତ ତିଳେ ହେଲେ ତୋ ସ୍ନେହେ ନ ରସିଲା ରେ ।ପଦ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତଳେ ବସନ ପ୍ରସାରି ତୃଣ ଦଶନାନ୍ତେ ଧରି",
          "କହିଲେହେଁ ଅନୁସରି ରାଜି ତ ନ ଦିଶିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତହୁଁ କି ବିଷମ ଭାବ ତର୍କିଲା ମୋ ଚାଟୁ ଶ୍ରବ",
          "ତଟକୁ ଘଟନ୍ତେ ଅବଧାନ ବିନା ହସିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତପନଜା ତଟକୁ ତୁ ତରୁଣୀଟା କେଉଁ କୁତୂ-",
          "ହଳରୁ ଆସିଲୁ ହେତୁ କହ ବୋଲି ଘୋଷିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାର ତୋର ସୁଲୋଚନା ତାରତମ୍ୟ ବିବେଚନା",
          "ଲବ ହୋଇ ନାହିଁ ତହିଁ ତୋ ଚିତ୍ତ କେ ପେଷିଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତିରସ୍କାର ପୂର୍ବ ଭାଷା ତରଲାଇ ସୁଖ ଆଶା",
          "ତୋଟିକି ଚୁମ୍ବିଲା ତୃଷା ତିମିର ବିଳସିଲା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ତୁଚ୍ଛ ସ୍ନେହ ମନ ଜନ ତୋ ସଙ୍ଗକୁ କି ଭାଜନ",
          "ପ୍ରପନ୍ନ ହରିଚନ୍ଦନ ଜଗଦ୍ଦେବ ଭାଷିଲା ରେ"
        ]
      }
    ]
  },
