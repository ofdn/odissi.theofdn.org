{
  "id": "oa-gita-000386",
  "name": {
    "en": "Prananatha he melani je",
    "or": "ପ୍ରାଣନାଥ ହେ ମେଲାଣି ଯେ"
  },
  "composer": "oa-person-000079",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prananatha-he-melani-je/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣନାଥ ହେ ମେଲାଣି ଯେ ମାଗୁଥାଅ ମୋତେ",
          "ନ ଯା ବୋଲି ଅମଙ୍ଗଳ ବୋଲିଲି କେମନ୍ତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମେଲାଣି ମାଗନ୍ତେ କାନ୍ତ କି ବୋଲନ୍ତି ତରୁଣୀ",
          "ଜାଣିଥିଲେ ସିନା ମୁହିଁ ଶିଖିଥାନ୍ତି ଏ ବାଣୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯାଅ ବୋଲି ବୋଇଲେ ତ ସ୍ନେହ ଊଣା ହେଉଛି",
          "ଥାଅ ବୋଲି କହିଲେ ପ୍ରଭୁତ୍ୱପଣ ଦିଶୁଛି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯାହା ଇଚ୍ଛା ତାହା କର ବୋଲି ଯେବେ ବୋଲିବି",
          "ତୁମ୍ଭ ଦାସୀ ହୋଇକି ମୁଁ ଉଦାସିନୀ ହୋଇବି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନୃସିଂହ ଭ୍ରମରବର ଶୁଣି ରାମା ବଚନ",
          "ସଜଳ କଜଳ ନେତ୍ରୀ ଗଣ୍ଡେ ଦେଲା ଚୁମ୍ବନ"
        ]
      }
    ]
  },
  "sources": [
    {
