{
  "id": "oa-gita-000744",
  "name": {
    "en": "Nisedha karuchi dhana",
    "or": "ନିଷେଧ କରୁଛି ଧନ"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nisedha-karuchi-dhana-ramakrusna-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନିଷେଧ କରୁଛି ଧନ ମନ ତହିଁ ମଜ୍ଜାନା ରେ",
          "ପର ସଙ୍ଗେ ପ୍ରୀତି କରି ଜାତି କୁଳ ହଜାନା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେବ କୁଳକୁ କଳଙ୍କ ହସିବେ ଜଗତ ଲୋକ",
          "ଅପକୀରତି ଟମକ ନଗରେ ତୁ ବଜାନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କହୁଛି ରେ ସଖୀ ଘେନ କେବେ ନ ବଳାଅ ମନ",
          "ଏବେ କହୁଅଛି ଘେନ ସେ ଅଟେ ନନ୍ଦକହ୍ନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦିନେ ଦେଖିଥିଲି ଡୋଳେ ସେ ଥିଲେ କଦମ୍ବ ମୂଳେ",
          "ବଂଶୀ ସ୍ୱନେ ମୋର ଚିତ୍ତ ଚୋରାଇ ନେଲେ ସିନା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଳି ନ ସରଇ ଦିନ ଦିନୁ ଦିନୁ ତନୁ କ୍ଷୀଣ",
          "ରାମକୃଷ୍ଣ ବୋଲେ ହୀନ ମୁଁ ତୋର କିଣା ସିନା ରେ"
        ]
      }
    ]
  },
