{
  "id": "oa-gita-000459",
  "name": {
    "en": "Ghana kuntala ago kahinki kara go hela",
    "or": "ଘନକୁନ୍ତଳା ଆଗୋ କାହିଁକି କର ଗୋ ହେଳା"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000127"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ghana-kuntala-ago-kahinki-kara-go-hela/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘନକୁନ୍ତଳା ଆଗୋ",
          "କାହିଁକି କର ଗୋ ହେଳା",
          "ଯିବା ପରା ଯମୁନା ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆସରେ କୁନ୍ଦନାଙ୍ଗୀ ମୋହନ ପ୍ରାଣସଙ୍ଗୀ",
          "ସୁହାସୀ ରାସରଙ୍ଗୀ ଦେଖିବା ଶ୍ୟାମ ଭଙ୍ଗୀ ।",
          "(ପଡ଼ି)",
          "ସେ ଚିତ୍ତଚୋରା ହରି ସଙ୍ଗେ କୁଞ୍ଜେ ବିହରି",
          "ତାଙ୍କ ସେବକୀ ପରି ଚଉପାଶରେ ଘେରି",
          "ନୃତ୍ୟ ସଙ୍ଗୀତ କରି ମୋହିବା ଏ ଶର୍ବରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆହା ସେ ନବଘନ ଜିତ ଶ୍ୟାମ ବରନ",
          "ମୂରତି କି ଶୋଭନ ହରେ ନୟନ ମନ ।",
          "(ପଡ଼ି)",
          "ବିରହ ବଂଶୀସ୍ୱନ ହଜାଇ ଦିଏ ଜ୍ଞାନ",
          "ମାନବତୀ ଗୁମାନ କରି ଦିଅଇ ଶୂନ୍ୟ",
          "କୁଳବତୀଙ୍କ ଛିନ୍ନ କରେ ଧୈର୍ଯ୍ୟ ଉଚ୍ଛନ୍ନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆହା ସେ ଶ୍ୟାମ ଶୋଭା ଜାତି କୁସୁମ ଗଭା",
          "ଦେଖି କେ ଅବା ଲୋଭା ନୋହିବ ତା ପ୍ରତିଭା ।",
          "(ପଡ଼ି)",
          "ଭାଷଇ ବେଣୁଧର ତାଙ୍କୁ ହୃଦରେ ହାର",
          "କରନ୍ତି ନିରନ୍ତର ସେ ଭାଗ୍ୟ କାହିଁ ମୋର",
          "ସେବି ଛନ୍ଦା ପୟର ହେବି ଏ ଭବୁଁ ପାର"
        ]
      }
    ]
  },
