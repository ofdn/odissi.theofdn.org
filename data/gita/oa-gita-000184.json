{
  "id": "oa-gita-000184",
  "name": {
    "en": "Rakhila mana bimbadhari dhari re",
    "or": "ରଖିଲା ମନ ବିମ୍ବାଧରୀ ଧରିରେ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000034"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rakhila-mana-bimbadhari-dhari-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରଖିଲା ମନ ବିମ୍ବାଧରୀ ଧରିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରମଣୀ ସେ କାହାର । ନୂଆ ହୋଇ ବାହାର ।",
          "ଗତି ମନ୍ଥରେ ନିନ୍ଦା କରି କରୀରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରସାଣିଲା ହାଟକ । ପରି କାନ୍ତି ଝଟକ ।",
          "ଛବିକି ନିକି ଅପସରୀ ସରିରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରଦବାସେ ପ୍ରକାଶ । ଝଟକ ମୃଦୁହାସ ।",
          "ପଲକ ତାକୁ ଅନୁସରି ସରିରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରଙ୍ଗେ ନେତ୍ର କୁଞ୍ଚିତ । ଢାଳୁ କି ଆଣି କୁନ୍ତ ।",
          "ଦେଲା ମରମେ ସୁକୁମାରୀ ମାରିରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରହନ୍ତି ମୁଁ ସେବାରେ । ଏତେ ଜଣାନ୍ତି ବାରେ ।",
          "ସଙ୍ଗତେ ଥିଲେ ଅନୁଚାରୀ ଚାରିରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଉପଇନ୍ଦ୍ର କହଇ । ଲଭିବା ଯୋଗ ନାହିଁ ।",
          "ମଲିଟି ହେଲା ହରଅରି ଅରିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
