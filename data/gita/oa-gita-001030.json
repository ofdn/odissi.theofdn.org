{
  "id": "oa-gita-001030",
  "name": {
    "en": "Bidhure bada badhure",
    "or": "ବିଧୁରେ ବଡ଼ ବାଧୁରେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000017"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bidhure-bada-badhure-ahari-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚନ୍ଦ୍ର ନିନ୍ଦା",
          "ବିଧୁରେ ବଡ଼ ବାଧୁରେ ବିରହିଣୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଧୁର ହାସକୁ ମୋହନର ଧ୍ୟାଇ",
          "ଅଧୁନା ପାଉଛି ଅନୁତାପ ମୁହିଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆଶା ହରିଣର ହରି ତୁ କଳଙ୍କୀ",
          "ନାଶିଲେ ତୁ ମତେ ଦୋଷୀ ନୋହିବୁ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୀତକର ତୋର ସଂସାରେ ପ୍ରଚାର",
          "ହିରକର ନୋହି ହେଲୁ ବାଧାକର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବଡ଼ବାନଳର ଭ୍ରାତ ତୁ ନିକର",
          "ପୀଡ଼ିବୁ ନାହିଁ କି ବିଷଧର ପରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କବି ନିଶାନାଥ କହେ ଭାଷିତ",
          "ଅବିରତ ଭାବି ହରିଙ୍କ ଚରିତ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
