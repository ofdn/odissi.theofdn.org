{
  "id": "oa-gita-000246",
  "name": {
    "en": "Bihi nari kari mote",
    "or": "ବିହି ନାରୀ କରି ମୋତେ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bihi-nari-kari-mote/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିହି ନାରୀ କରି ମୋତେ କାହିଁ ପାଇଁ ଗଢ଼ିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଧୁ ନିଶି ମଧୁ କାଳ ବହଇ ଦକ୍ଷିଣାନିଳ",
          "ଏକାକିନୀ ନାରୀ ନାଶ ଦଶା ଆସି ପଡ଼ିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏ ବୟସ ଅକାରଣ ଗଲାରେ ସଜନୀ ଜାଣ",
          "ବନର ମାଳତୀ ପରି ବନେ ଫୁଟି ଝଡ଼ିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିତି ଦିନ ରାତି ସହି ଭାଳୁ ଗଲା କାଳ ବହି",
          "ମନର କଥା ମନରେ ରହି ଦେହ ସଡ଼ିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୁଁ ହେଲି ପର ଆୟତ୍ତ ସ୍ୱାଧୀନ ନୋହିଲା ଚିତ୍ତ",
          "ମଦନ ହନ୍ତକ ଖୋଜି ଅନୁବ୍ରତେ ପୀଡ଼ିଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣକୁ ବେଳେ ଦେଖିବି ବୋଇଲେ ଡୋଳେ",
          "କୁଳ ଭୟ ଲାଜ କ୍ଷଣେ ଚିତ୍ତରୁ ନ ଛାଡ଼ିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
