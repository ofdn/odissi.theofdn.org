{
  "id": "oa-gita-000990",
  "name": {
    "en": "Syama apabada mote lagithau",
    "or": "ଶ୍ୟାମ ଅପବାଦ ମୋତେ ଲାଗିଥାଉ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-apabada-mote-lagithau-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ଅପବାଦ ମୋତେ ଲାଗିଥାଉ ରେ ପ୍ରାଣସହି",
          "ନିତି ସେହି ଚିନ୍ତାରେ ମୋ ଦିନ ଯାଉ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚାହିଁଦେଲେ ଥରେ ସେ ଶ୍ରୀମୁଖ",
          "କୋଟିଏ କୋଟି ଜନ୍ମର ଦୁଃଖ",
          "ଲିଭିଯାଉଛିରେ ପରାଣ ମିତଣୀ",
          "ଯେ ଯେତେ ବୋଲିବ ବୋଲୁଥାଉ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିନୟ ବାରାଧି ମୃଦୁବାଣୀ",
          "ଶ୍ରୁତିପଥରେ ଯେ ଥିବ ଶୁଣି",
          "ପୀୟୂଷାଶନ ଜନଙ୍କୁ ଧନ୍ୟ ବୋଲି",
          "ବୋଲିବ କି ତା ମୁଖରେ ଆଉ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାଡ଼ଭିତ୍ତିକି ବୋଇଲା ପରି",
          "ବୋଲୁଥିଲେ ହେଲେ ବ୍ରଜନାରୀ",
          "ଶୁଣି ନ ଶୁଣିଲା ପରି ମୁଁ ଯାଉଛି",
          "ଆଡ଼ ଉହାଡ଼ରେ ଶବଦାଉ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ବୋଲଇ ଧୀରେ",
          "ବାଚାଳୀ କୁଟିଳା ଚାପଲ୍ୟରେ",
          "ବରଜ ନଗରଯାକ ସ୍ଫୁଟ ହେଲା",
          "ସଦାବେଳେ ହେଉ ରାଉରାଉ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-apabada-mote-lagithau-gopalakrusna/"
    }
  ],
