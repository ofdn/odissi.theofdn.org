{
  "id": "oa-gita-000155",
  "name": {
    "en": "Barijakhi manaru mana",
    "or": "ବାରିଜାକ୍ଷୀ ମନରୁ ମାନ ବାରି ଦେ ରେ"
  },
  "composer": "oa-person-000002",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/barijakhi-manaru-mana-bari-de-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାରିଜାକ୍ଷୀ ମନରୁ ମାନ ବାରି ଦେ ରେ",
          "ଦେଖ କାଳ ହେଲା କଳା ବାରିଦେ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦାସ ନାଶରେ ମାନସ । ବଳିଛି ଯେବେ ନାରୀଶ ।",
          "କରଜ ନାରାଚ ମାରି ଚିରି ଦେ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୋ ଚରଣ ସେବା ଭଳି । ନୋହିଲି ଯେବେ ରେ ଆଳି ।",
          "ଗାଳି ଦିଆଇ ମହତ ସାରି ଦେ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏବେ ବନ୍ଧୁ ଅନାଥରେ । ଦୟା ଥିଲେ ଅନା ଥରେ ।",
          "କରୁଣା କଟାକ୍ଷ ନେତ୍ରେ ଠାରି ଦେ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମହିଳାମଣି ଜଗତେ । ତୋ ବିନା ସାହା କେ ମୋତେ ।",
          "ମାର ମୁଖୁଁ ବଞ୍ଚାଇବି ଗାରି ଦେ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦ୍ୱିଜ କବିରବି ବାଣୀ । ଶୁଣି ସେ ରମଣୀମଣି ।",
          "ସ୍ନେହେ ଦ୍ରବି ବହିଗଲା ବାରି ଦେରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/barijakhi-manaru-mana-bari-de-re/"
    }
  ],
