{
  "id": "oa-gita-000956",
  "name": {
    "en": "Nena nena sakhi e kusuma hara",
    "or": "ନେନା ନେନା ସଖି ଏ କୁସୁମ ହାର"
  },
  "composer": "oa-person-000132",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nena-nena-sakhi-e-kusuma-hara-mohana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନେନା ନେନା ସଖି ଏ କୁସୁମ ହାର",
          "ମନମୋହନକୁ ଦେନା ଲୋ",
          "ସ୍ନେହାଧୀନା ଏହାକୁ ଗୁନ୍ଥିଛି ବୋଲି",
          "କାଳିଆ ସୁନାକୁ କହନା ଲୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପୁଚ୍ଛିଲେ କହିବୁ ଦେଇଛି ହେ ତବ",
          "ଚନ୍ଦ୍ରାବଳୀ ଚନ୍ଦ୍ରବଦନା ଲୋ",
          "ହୋଇ ମହତସରା କଳଙ୍କ ପସରା",
          "ମୋହ ପରି ଶିରେ ବହନା ଲୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଞ୍ଜବିହାରୀଙ୍କ କଣ୍ଠେ ଦେଇ ସହି",
          "କିଞ୍ଚିତେ ଚାହିଁ ଆଉ ଚାହାଁନା ଲୋ",
          "ତା କର ପରଶମାଳା ହୃଦରେ ପରଶିଲେ",
          "ହେଉଛି କି ବିରହ ବେଦନା ଲୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରେମମୟ ରୂପକୁ ବିଲୋକନ କରି",
          "ମଉନେ ରହି କିଛି କହନା ଲୋ",
          "ଚନ୍ଦ୍ରା ନାମ ଶ୍ରବଣେ ଚମକି ଉଠିଲେ",
          "ମୋ ସଖୀ ହୁଅନ୍ତା ବିମନା ଲୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ରାଧାରମଣ ଚରଣକୁ ସ୍ମରି",
          "ଏ ରସେ ଭାଷଇ ମୋହନା ଲୋ",
          "ଦେଖିବିକି ସତେ ଏ ପାପ ନୟନେ",
          "ସାଧୁଜନ ଚିତ୍ତଚନ୍ଦନା ଲୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nena-nena-sakhi-e-kusuma-hara-mohana/"
    }
  ],
