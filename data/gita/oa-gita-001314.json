{
  "id": "oa-gita-001314",
  "name": {
    "en": "Janichi mu kanha",
    "or": "ଜାଣିଛି ମୁଁ କାହ୍ନା"
  },
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/janichi-mu-kanha-to-mana-saberi-ekatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜାଣିଛି ମୁଁ କାହ୍ନା ତୋ ମନ କାମନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୋ ବିନା ନାରୀ ରାଜକୁମାରୀ",
          "ଯାଏ ସେ ଯେବେ ଯମୁନା ପାଣି",
          "(ପଡ଼ି)",
          "ତାରେ ଓଗାଳୁ ବାଟ ଲମ୍ପଟ ପୀତପଟ",
          "ଘାଟ କଉଡ଼ି ନାମେ ଗୋପେ ବସିଛି ହାଟ",
          "ଯେତେ କଲେ ଆକଟ ତିଳେ ନ ମାନୁ ମନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିକୁଞ୍ଜେ ବସି ବଜାଉ ବଂଶୀ",
          "ତା ନାମ ଘୋଷି ବରଜ ଶଶୀ",
          "(ପଡ଼ି)",
          "ଶୁଣି ସେ ବେଣୁ ଗୀତି ବିଚଳିତ ଶ୍ରୀମତୀ",
          "ଘର ସଂସାରେ ତାର ତିଳେ ନ ଲାଗେ ମତି",
          "ନିର୍ଦ୍ଦୟ ରତିପତି ଛାତି ଦିଏ କରତୀ",
          "ଝୁରି ମରେ ଶ୍ରୀମତୀ ନିରତେ ମୀନନୟନା"
        ]
      }
    ]
  },
