{
  "id": "oa-gita-000177",
  "name": {
    "en": "More ehi anugraha kara he radhabara",
    "or": "ମୋରେ ଏହି ଅନୁଗ୍ରହ କର ହେ ରାଧାବର"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/more-ehi-anugraha-kara-he-radhabara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋରେ ଏହି",
          "ଅନୁଗ୍ରହ କର ହେ ରାଧାବର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅନେକ ଜନ୍ମରୁ ମୁହିଁ ସତ୍ସଙ୍ଗ ତ କରି ନାହିଁ",
          "ବିଷୟା ବିଷକୁ ପିଇଦେଇଛି ହେ ଭାବଗ୍ରାହୀ",
          "କିପରିରେ । ହେବିଟି ଉଦ୍ଧାର ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆନ ଉପାସନା ବାର ଛାଡ଼ି କେବଳ ତୁମ୍ଭର",
          "ଚରଣକଞ୍ଜେ କିଙ୍କରପଣେ ଦିନ ଯାଉ ମୋର",
          "ଏହି ବାଞ୍ଛା । ଏକା ହେଉ ସାର ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏକାନ୍ତରେ ବସି ଭକ୍ତି କରୁଥିବି ବହି ପ୍ରୀତି",
          "ଶୁଦ୍ଧ ଭାବନାରେ ଶାନ୍ତି ହେଉଥିବ ସଦା ମତି",
          "କାମନା ହୃଦରୁ କରି ଦୂର ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବ୍ରଜେ ବ୍ରଜେନ୍ଦ୍ରକୁମର ବିନା ଚିତ୍ତେ ସ୍ମରିବାର",
          "ନୋହୁ ଜନ୍ମ ଜନ୍ମାନ୍ତର ଦେବ ମାତ୍ର ଏହି ବର",
          "ମାଗୁଅଛି । ହେବ ଅଙ୍ଗୀକାର ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅନିତ୍ୟ ତ ଏ ଶରୀର ଅଟେ କିପରି ତୁମ୍ଭର",
          "ନାମକୁ ମୁଖେ ଉଚ୍ଚାର କରି ହୋଇଯିବି ପାର",
          "ଗୌରହରି । କହେ ଯୋଡ଼ି କର ହେ"
        ]
      }
    ]
  },
  "sources": [
