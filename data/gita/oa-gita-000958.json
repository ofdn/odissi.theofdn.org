{
  "id": "oa-gita-000958",
  "name": {
    "en": "Dekhile kahinki laja made",
    "or": "ଦେଖିଲେ କାହିଁକି ଲାଜ ମାଡ଼େ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekhile-kahinki-laja-made-sahi-kedara-kamodi-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖିଲେ କାହିଁକି ଲାଜ ମାଡ଼େ ସହି",
          "ନ ଦେଖିଲେ ଝୁରି ମରୁଥାଇ",
          "କି ମନ୍ତ୍ର କରିଛି କି ଯନ୍ତ୍ର କରିଛି",
          "ସେ କାଳିଆ ନନ୍ଦର କହ୍ନାଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯମୁନା ପାଣିକି ମନା ହେଲ ମୋତେ",
          "ଟିକିଏ ତାଙ୍କୁ ଦେବାରୁ ଚାହିଁ",
          "ଫଟା କପାଳରେ ଏହା ଲେଖାଥିଲା",
          "କେ କେତେ ଯମୁନା ଯାଉ ନାହିଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପାଟକ କୁଳରେ ହଟା ବସିଅଛି",
          "କଳଙ୍କିନୀ ହେଲା ବୋଲି ରାଇ",
          "କୁଳବଧୂ ହୋଇ କେ ଘରେ ବସିଛି",
          "ବଂଶୀ ସ୍ୱନେ କେ ନୋହିଛି ବାଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସହି ସହି ଛାତି ପଥର କଲିଣି",
          "କହିଲେ କେ ଦୁଃଖ ନେବ ସହି",
          "ରହିଅଛି ସିନା କରମ ଆଦରି",
          "ଅହି ଗରଳ ଦିଅନ୍ତି ଖାଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଂସାରଯାକରେ ଖୋଜିଲେ ସଜନୀ",
          "ମୋ ପରି ଦୁଃଖୀ କେ ଅଛି କାହିଁ",
          "ସେହି ବନମାଳୀ ପାଦପଦ୍ମେ ଭାଳି",
          "ବେଣୁଧର ଜୀବ ଯାଉ ନାହିଁ"
        ]
      }
    ]
  },
  "sources": [
    {
