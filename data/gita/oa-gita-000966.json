{
  "id": "oa-gita-000966",
  "name": {
    "en": "Aja rajanire brajarajaku ani",
    "or": "ଆଜ ରଜନୀରେ ବ୍ରଜରାଜକୁ ଆଣି"
  },
  "composer": "oa-person-000061",
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-rajanire-brajarajaku-ani-raghunatha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ ରଜନୀରେ ବ୍ରଜରାଜକୁ ଆଣି",
          "ଭେଟାଇବି ଗୋ ମିତଣୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭୁଲାଇ ନାନା ପ୍ରକାର ବୁଲାଇ କହିବି ଗିର",
          "ଭୁଲାଇବି ଦୋଷ ତୋର ଧରି ତା ପାଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅନାଇ ହସି ହରଷେ ମନାଇ ଦେବି ତୋ ପାଶେ",
          "କହ୍ନାଇର ମାନ ଲେଶେ ନ ଥିବ ପୁଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଥାକୁ ପୋତିଛୁ ଛାର କଥାକୁ କରିଛୁ ଗାର",
          "ବୃଥାକୁ କହୁଛୁ ବାରବାର ଏ ବାଣୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚିତ୍ତରେ ଭାବି ଏମନ୍ତ ମିତରେ କହେ ଏହି ତ",
          "ଗୀତରେ ଯେ ରଘୁନାଥ ଏ ପଦ ଭଣି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-rajanire-brajarajaku-ani-raghunatha/"
    }
  ],
