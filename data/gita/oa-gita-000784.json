{
  "id": "oa-gita-000784",
  "name": {
    "en": "Bichitra kathae suna sakhi",
    "or": "ବିଚିତ୍ର କଥାଏ ଶୁଣ ସଖୀ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000145"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bichitra-kathae-suna-sakhi-soka-kamodi-banamali/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ବିଚିତ୍ର କଥାଏ ଶୁଣ ସଖୀ",
          "ବ୍ରହ୍ମାଣ୍ଡ ଯାକେ ନ ଥିବେ ଦେଖି",
          "କାହାଗେ କହିବି ନ ବୁଝନ୍ତି କେହି",
          "ଏହି ଭାବରେ ମୁଁ ଗଲି ଶୁଖି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରିୟ ଚିତ୍ତ ଚିତ୍ର ଅଳଙ୍କାର",
          "ଅନାଇ ଲୋଭ ବଢ଼ିଲା ମୋର",
          "ମୋର ମନ ମଣି ବନ୍ଧା ରଙ୍ଗେ ଅଣି",
          "ମଣ୍ଡିହେବି କଲି ଏ ବିଚାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭଲ ଲୋକ ପରି ପାଶେ ଦେଖି",
          "ଖଳ ମଦନକୁ କଲି ସାକ୍ଷୀ",
          "ଦେଲି ମୁଁ ନବ ଲାବଣ୍ୟ କଳନ୍ତର",
          "ଭୋଗ କରୁଥାଅ ବୋଲି ଲେଖି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏବେ ସେ ଚିତ୍ତ ଅନ୍ତରହିତ",
          "ହରାଇଲି ମାତ୍ର ନିଜ ବିତ୍ତ",
          "ଯେ ଗଲା ସେ ଯାଉ ପଛକେ ମୋ ଚିନ୍ତା",
          "ନାହିଁ ଶୁଣ ଏବେ ବିପରୀତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସଖୀ କିମ୍ପାଇଁ ସନ୍ତତ ଚଳି",
          "କମ୍ପାଇ ତନୁ ଦେଉଛି ଦଳି",
          "ବନମାଳୀ ବୋଲେ କା ଆଗେ କହିବି",
          "ରସନା ନାଶିଲେ ଦନ୍ତାବଳୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bichitra-kathae-suna-sakhi-soka-kamodi-banamali/"
    }
  ],
