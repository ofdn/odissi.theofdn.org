{
  "id": "oa-gita-000142",
  "name": {
    "en": "Chi chi para pirati",
    "or": "ଛି ଛି ପର ପୀରତି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000065"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhi-chhi-chi-chi-para-pirati-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛି ଛି ପର ପୀରତି",
          "କିଛି ନ ରଖଇ ମତି ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦାଉ ଘେନିଣ ତା ଗୁରୁଜନଙ୍କର",
          "ଯାଉ ପଛେ ଜାତି ରୀତି ମା",
          "ସ୍ନେହରେ ଶ୍ରୀମୁଖ ଦେଖିଦେଲା ଯାଏ",
          "ଦେହରେ କି ଥାଏ ଗତି ମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭାଜି ହୋଇଯାଏ ତା ବିନୁ ତନୁଟି",
          "ବାଜି ବିରହାଗ୍ନି ତାତି ମା",
          "ରାଜି ନ ଥାଏ କି ତା ସଙ୍ଗ ସୁଖରେ",
          "ଲାଜ ମିତ ହୁଏ କ୍ଷାତି ମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କହଇ ଅବଶ୍ୟ ଆସିବି ବୋଲି ମୁଁ",
          "ରହଇ ଇତରେ ମାତି ମା",
          "ଦାସୀ ପରି ଅନୁସରି ବସୁ ଆସି",
          "ପାହିଯାଏ ସିନା ରାତି ମା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନୁ ତେଜି ଦିନୁ ଦିନୁ ବଳିବାର",
          "ଆନ ନାହିଁଟି ସୁମତି ମା",
          "ଆଖରକୁ ଫଳ ମଦନ ଶରକୁ",
          "ଲାଖ କରିବାର ଛାତି ମା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବସଇ ବସୁଧା ତଳ ତେଜି ଗଜ",
          "-ଦନ୍ତ ପଲଙ୍କ ସୁପାତି ମା",
          "ଦଶା ହୋଇଯାଏ ଅତି ବିପରୀତ",
          "ମଶା ହୋଇଯାଏ ହାତୀ ମା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏ କାହାକୁ ଜଣା ଟେକାଏ ମାରଣା",
          "ମଣ୍ଡଳେ ହୋଇବ ଖ୍ୟାତି ମା",
          "ସହି ତୁ ଅଇଲୁ ପଦେ ନ କହିଲୁ",
          "ବୋଲେ ବସୁଦୁର୍ଗପତି ମା"
        ]
      }
    ]
  },
  "sources": [
