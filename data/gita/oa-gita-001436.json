{
  "id": "oa-gita-001436",
  "name": {
    "en": "Chhada mote bata",
    "or": "ଛାଡ଼ ମୋତେ ବାଟ"
  },
  "composer": "oa-person-000050",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhada-mote-bata/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛାଡ଼ ମୋତେ ବାଟ",
          "ନଟନାଗର ଲମ୍ପଟ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯିବି ଯମୁନା ପାଣିକି",
          "ନ ଧର ମୋର ପାଣିକି",
          "କହୁଛି ମୃଦୁ ବାଣୀକି",
          "ଘେନ ନନ୍ଦଚାଟ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏ ଗୋପପୁରେ ନାରୀ",
          "ଅଛି କେ ଜଣେ ମୋପରି",
          "ଯେଣେ ଗଲେ ଅପବାଦ",
          "ହୁଅଇ ପ୍ରକଟ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାଳି ନ ସରଇ ଦିନ",
          "ହୋଇଣ ମୁଁ ଅତି ହୀନ",
          "ନଣନ୍ଦ ଭର୍ତ୍ସନା ସହି",
          "ଚାଲୁଥାଇ ବାଟ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାବି ଦୀନକୃଷ୍ଣ କହି",
          "ତୁମ୍ଭରେ ଗୋ ନୁହେ ସ୍ନେହୀ",
          "ଏ କଳଙ୍କ ବାଦ ଲେଖା",
          "ଥିଲା ମୋ ଲଲାଟ ହେ"
        ]
      }
    ]
  },
  "sources": [
