{
  "id": "oa-gita-000466",
  "name": {
    "en": "Ki bhangire chahinla se mana mohane",
    "or": "କି ଭଙ୍ଗୀରେ ଚାହିଁଲା ସେ ମନମୋହନେ"
  },
  "composer": "oa-person-000024",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-bhangire-chahinla-se-mana-mohane/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଭଙ୍ଗୀରେ ଚାହିଁଲା ସେ ମନମୋହନେ",
          "ନେତ୍ର ଲାଖି ରହିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେଳି ନୀପମୂଳରେ ଥିଲା ସେ ନିଶ୍ଚଳରେ",
          "ଚାରି ଚକ୍ଷୁ ମେଳରେ ମଦନ ବିହ୍ୱଳରେ",
          "ଧଇର୍ଯ୍ୟ ସେ କାଳରେ କେଉଁ ମନ୍ତ୍ର ବଳରେ",
          "ମୋ ନ ରହିଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଣି ତା ବଂଶୀ ନାଦ ଚଳିଲା ନାହିଁ ପାଦ",
          "ଶ୍ରୀ ରାଧା ରାଧା ପଦ ମୋ ଚିତ୍ତକୁ ପ୍ରମୋଦ",
          "କରାଇ ଦେଲା ଗଦଗଦେ ନବ ବାରିଦ",
          "ମୂରତି ଭଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଥିଲି ମୁଁ ସଖୀ ମେଳେ କି ରୂପେ ସେ ଚିହ୍ନିଲେ",
          "ମୋ ନାମ ଧରି ହେଳେ ବେଣୁ ବଜାଇ ଦେଲେ",
          "ତାଙ୍କ କପଟ ପାଲେ ରହିବେ ନିକି ଭଲେ",
          "ବ୍ରଜ ଛଇଳା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାଜଧାନୀ ସମରପୁର ମଣ୍ଡଳେଶ୍ୱର",
          "ଧୀର ଶ୍ରୀ ବୀରବର କୁଳିଶଧର ନର",
          "ପୁରନ୍ଦର ଶ୍ରୀ କୃଷ୍ଣଚନ୍ଦ୍ର ମନୁ ସେ ମୂର୍ତ୍ତି",
          "ମୂର୍ଚ୍ଛି ନୋହିଲା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
