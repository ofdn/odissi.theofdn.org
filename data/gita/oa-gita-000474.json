  "id": "oa-gita-000474",
  "name": {
    "en": "Kunja banaku eka",
    "or": "କୁଞ୍ଜ ବନକୁ ଏକା"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunja-banaku-eka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯିବୁ ନାହିଁ ସଜନୀ କୁଞ୍ଜ ବନକୁ ଏକା",
          "ଦେଖିଲେ କି ଛାଡ଼ିବ ସେ ମୁରଲୀଫୁଙ୍କା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୂରୁ ଯେବେ ସେ ଦେଖଇ । ଭୂରୁ ଭଙ୍ଗୀରେ ଡାକଇ ।",
          "ମୂରୁଛି ପାରିବ ତାହା କେଉଁ ଗୋପିକା ।",
          "(ପଡ଼ି)",
          "କୁଳଛଡ଼ା ବୃତ୍ତିଟି ସେ ଠୂଳ କରିଛି ମାନସେ",
          "ମୂଳ ସିନା ତାର ନାରୀମରା ଜୀବିକା",
          "ବେଣୁଧର ବୋଲେ ଶୁଣ ମଣୁଛ କି ତାକୁ ସାନ",
          "ଅଣୁ ପରମାଣେ ରାଧା ନ ପଡ଼ୁ ଦକା"
        ]
      }
    ]
  },
  "sources": [
