  "id": "oa-gita-000905",
  "name": {
    "en": "Ja re mohana pheri ja ja",
    "or": "ଯାରେ ମୋହନ ଫେରି ଯା ଯା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000122"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ja-re-mohana-pheri-ja-ja-bagesri-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯାରେ ମୋହନ ଫେରି ଯା ଯା ଯା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯା ରସେ ରସି ତୁ ସଞ୍ଜେ ବାହୁଡ଼ି ଆସିଛୁ କୁଞ୍ଜେ",
          "ତା ନାମେ ଯମୁନା ତଟେ ବଇଁଶୀ ବଜା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୋଳି ବାସ ବନଫୁଲ କୋଳେ ଧରି କରି ଗେଲ",
          "ରସିକା ରମଣୀମଣି ଚିକୁର ସଜା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ପରି ଶଠ ପୁରୁଷ ନ ଆସୁ କିଶୋରୀ ପାଶ",
          "କଟାଳ କରୁ ସେ ନୁହେ ତୋର ପରଜା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଚନ୍ଦ୍ର କହେ ଏତେ ଯାଅ ଶ୍ୟାମ ନିଜ ପଥେ",
          "କଲା କରମର ଏବେ ଭୋଗୁଥା ମଜା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
