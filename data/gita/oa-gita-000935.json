{
  "id": "oa-gita-000935",
  "name": {
    "en": "Mana smara brusabhanu kisori",
    "or": "ମନ ସ୍ମର ବୃଷଭାନୁ କିଶୋରୀ"
  },
  "composer": "oa-person-000130",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-smara-brusabhanu-kisori-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନ ସ୍ମର ବୃଷଭାନୁ କିଶୋରୀ ପୟରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚାରୁ କୁନ୍ତଳେ ଜୂଡ଼ା ଶ୍ୟାମଘନ ଜ୍ଞାନବୁଡ଼ା",
          "ମୂଳେ କୁସୁମ ପାଖୁଡ଼ା",
          "ଗନ୍ଧେ ଅଳି କରେ କ୍ରୀଡ଼ା ଅର୍ଦ୍ଧଚନ୍ଦ୍ର",
          "ତା ପରେ ସିନ୍ଦୂର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅପୂର୍ବ ରଙ୍ଗ ପିନ୍ଧିଣ ଉରେ କାଞ୍ଚଲୀ ଶୋଭନ",
          "ନାନାଦି କୁସୁମମାନ",
          "ମାଳ ଲମ୍ବିତ ଯତନ ନୀଳବାସ",
          "ଓଢ଼ଣୀ ଯାହାର ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସରୁକଟିରେ କିଙ୍କିଣୀ କୃଷ୍ଣ ମନ ଉଦାସିନୀ",
          "ଝୁଣ୍ଟିଆ ଝୁଣ୍ଟିଆ ବାଣୀ",
          "ଡାକ ଦିଏ ବେଳ ଜାଣି ଶ୍ରୀପୟରେ",
          "ରୁଣିତ ନୂପୁର ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯେଉଁ ଚରଣରେ ଚିତ୍ର ଚକ୍ରଧର ଧ୍ୱଜ ଛତ୍ର",
          "ଯବ ବଳୟ ପବିତ୍ର",
          "ପୁଷ୍ପ ଊର୍ଦ୍ଧ୍ୱରେଖା ପତ୍ର ଅର୍ଦ୍ଧଚନ୍ଦ୍ର",
          "ଅଙ୍କୁଶେ ସୁନ୍ଦର ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବାମ ପଦରେ ଏ ବ୍ୟକ୍ତ ଦକ୍ଷିଣେ ଗଦା ପର୍ବତ",
          "କୁଣ୍ଡଳ ମତ୍ସ୍ୟ ବିଦିତ",
          "ସ୍ୟନ୍ଦନ ବେଦୀ ସହିତ ଶକ୍ତି ଆଦି",
          "ବନଜ ଅମ୍ବର ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଉନବିଂଶତି ଚିହ୍ନରେ ଚିହ୍ନିତ ଯେଉଁ ପାଦରେ",
          "ଚିତ୍ତ ନିବେଶି ତହିଁରେ",
          "ଭଜ ନିତି ବିଶ୍ୱାସରେ ଲଭିବୁ ତୁ ନିଶ୍ଚେ",
          "ବ୍ରଜପୁରରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଶ୍ରୀଗୁରୁ ଯା ଛନ୍ତି କହି ସାଧ ଦେହେ ତାହା ଧ୍ୟାଇ",
          "ଶ୍ରୀରୂପ ଗଣରେ ଯାଇଁ",
          "ସେବାରେ ନିଯୁକ୍ତ ହୋଇ ଡାକିବେ ସେ",
          "ଠାରିଣ ଶ୍ରୀକରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ପ୍ରେମମୟୀ ରାଧା ମତି ତା ବିନୁ ନାହିଁନା ଗତି",
          "ଯହିଁ ବୃନ୍ଦା ଦଇବତୀ",
          "ନିଜେ ବୃନ୍ଦାବନେ ସ୍ଥିତି ସୌଭାଗ୍ୟ କି",
          "ହେବ ମୋହନର ରେ"
        ]
      }
    ]
  },
  "sources": [
