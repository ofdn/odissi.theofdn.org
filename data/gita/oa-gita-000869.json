    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jagadiswara-te-mangalam-todi-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ରୀ ରାଧେଶ ନତ ଗୌରୀଶ",
          "ଜଗଦୀଶ୍ୱର ତେ ମଙ୍ଗଳଂ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୀଳ ଘନାଘନ ଚାରୁଶରୀର",
          "ଶ୍ରୀ ଲଳିତାନନ ଚନ୍ଦ୍ର ଚକୋର",
          "ଗୋପ ସତୀଜନ ମାନସ ଚୋର",
          "ଜଗଦୀଶ୍ୱର ତେ ମଙ୍ଗଳଂ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୋପଧରାବର ଲାଳିତ ପୁତ୍ର",
          "ନୂତନ ନୀରଜ ସୁନ୍ଦର ନେତ୍ର",
          "ବିକ୍ରମ ମାନସ ସାରସ ମିତ୍ର",
          "ଜଗଦୀଶ୍ୱର ତେ ମଙ୍ଗଳଂ"
        ]
      }
    ]
  },
