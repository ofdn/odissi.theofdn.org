{
  "id": "oa-gita-000316",
  "name": {
    "en": "Are manasa tu e jibane kalu kisa",
    "or": "ଆରେ ମାନସ ତୁ ଏ ଜୀବନେ କଲୁ କିସ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/are-manasa-tu-e-jibane-kalu-kisa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆରେ ମାନସ",
          "ତୁ ଏ ଜୀବନେ କଲୁ କିସ",
          "ମୋର ମୋର ବୋଲି ମରି ନିରନ୍ତର",
          "ଶେଷରେ ହେବୁ ନିରାଶ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅରଜିଲୁ ଧନ ଜନ ପରିବାର",
          "ମୋଟା କଲୁ ତୋ ମାନସ",
          "ଜରାବସ୍ଥାରେ ତୋ ଏମାନଙ୍କର ତୁ",
          "ଆଖିରେ ହୋଇବୁ ବିଷ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ ଦିଶିବ ଦୂର ନ ଶୁଭିବ ସ୍ୱର",
          "ପଡ଼ିବ ସକଳ ଦଶ",
          "ହାତ ଗୋଡ଼ ଥରି ନ ପାରିବୁ ଚାଲି",
          "ଡାକିବୁ କେ ଅଛ ଆସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେହି ନ ଶୁଣିବେ ବିରକ୍ତ ହୋଇବେ",
          "ଭୋଗିବୁ ନାନା ପରାଶ",
          "ଭାବଇ ତାରିଣୀ ପଥକୁ ସଙ୍ଖାଳି",
          "ଏକା ନାମ ହୃଷୀକେଶ"
        ]
      }
    ]
  },
  "sources": [
