{
  "id": "oa-gita-000115",
  "name": {
    "en": "Kahibu jai syama bandhunku",
    "or": "କହିବୁ ଯାଇ ଶ୍ୟାମବନ୍ଧୁଙ୍କୁ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000052"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahibu-jai-syama-bandhunku-syamabandhunku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହିବୁ ଯାଇ । ଶ୍ୟାମବନ୍ଧୁଙ୍କୁ ମନ ମଜ୍ଜାଇ ।",
          "ଗୁପତେ ପୀରତି କଲେ ମୋହନ ବଂଶୀ ବଜାଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାଳି ଜାଳିଣ ଜାଗର । ନିଶିଯାକ ଉଜାଗର ।",
          "ଦାରୁଣ ମଦନ ଶର । ଦେଲା ମୋ ଜ୍ଞାନ ହଜାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏଡ଼େ ନିଦାରୁଣ ବୋଲି । ସଖୀ ମୁଁ ଜାଣି ନଥିଲି ।",
          "ଶୋକଜଳେ ଭାସିଗଲି । କୁସୁମ ଶେଯ ସଜାଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୀରବର ବୋଲେ ଦୂତୀ । ପଥର କଲେଣି ଛାତି ।",
          "ସେ ଚତୁରୀ ରସବତୀ । ଖାଇଛି ପ୍ରେମ ଗଞ୍ଜାଇ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
