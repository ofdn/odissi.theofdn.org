{
  "id": "oa-gita-000710",
  "name": {
    "en": "Kebala tote sina jana re keli prabina",
    "or": "କେବଳ ତୋତେ ସିନା ଜଣା ରେ କେଳିପ୍ରବୀଣା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kebala-tote-sina-jana-re-keli-prabina-todi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେବଳ ତୋତେ ସିନା ଜଣା ରେ କେଳିପ୍ରବୀଣା",
          "ପ୍ରଣୟ ଧନେ ପ୍ରାଣକିଣା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନେତ୍ରାନ୍ତ ଖେଳଯୁତ କରାଇ ମିତସ୍ମିତ",
          "ବିବେକ କରି ଦେଉ ବଣା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦରଶନ ଆରମ୍ଭେ ସରସ ଗିର ଦମ୍ଭେ",
          "ପରଷିବାର ସରପଣା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦରକଣ୍ଠୀ ସୁନ୍ଦର ଦରହାସ ମଧୁର",
          "ସରସ ଗିର ପଦେ ଶୁଣା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରୁଣାମୟ ଚିତ୍ତେ ଅରୁଣାଧରା ମୋତେ",
          "ତୋ ଦାସୀ ଗଣନାରେ ଗଣା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମୁଁ ଏହି ଅଭିଳାଷେ ଶିବ ଶିବାଙ୍କ ପାଶେ",
          "କରୁଥାଏଟି ଜଣାମଣା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୁଣେ ଲାବଣ୍ୟବତୀ ପାଶେ ଭାରତୀ ରତି",
          "ଦୁହେଁ ତୋ ଠାରୁ କିଛି ଊଣା ରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ବୋଲେ ଶ୍ରୀ ଜଗଦ୍ଦେବ ତୋ ସ୍ନେହୁଁ ମନୋଭବ",
          "ମସ୍ତକେ ମାରି ପାରେ ଠଣା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
