{
  "id": "oa-gita-000061",
  "name": {
    "en": "Rathara upare kie",
    "or": "ରଥର ଉପରେ କିଏ"
  },
  "composer": "oa-person-000031",
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rathara-upare-kie/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୁଁ ତ ଚିହ୍ନି ନ ପାରଇ ଗୋ",
          "ରଥର ଉପରେ କିଏ",
          "ରଥର ଉପରେ ବିଜେ କରିଛନ୍ତି",
          "ନନ୍ଦ ଯଶୋଦାଙ୍କ ପୋଏ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆଖି ଦୁଇଗୋଟି ଚକା ଚକା",
          "ବାହୁ ଦୁଇଗୋଟି ବଙ୍କା",
          "ଦେଖିଲାବେଳକୁ ସେ ରୂପ ଗୋଟିକୁ",
          "ହୃଦେ ଲାଗୁଅଛି ଶଙ୍କା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହୃଦୟ ଛୋଟ ବାହୁଟି ମୋଟ",
          "ଅଭଡ଼ା ଖେଚଡ଼ି ଖାଇ",
          "ଭକ୍ତଜନଙ୍କୁ ସେ ତାରିବାପାଇଁ",
          "ବିଜେ ହୋଇଛନ୍ତି ସେହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଗେ ତାଳଧ୍ୱଜ ପଛେ ନନ୍ଦିଘୋଷ",
          "ମଧ୍ୟରେ ସୁଭଦ୍ରାଦେଈ",
          "ନନ୍ଦିଘୋଷ ପରେ ବିଜେ କରିଛନ୍ତି",
          "ଭକ୍ତକୁ ତାରିବା ପାଇଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେତେ ମୁଁ କହିବି ତାହାଙ୍କ ଚରିତ୍ର",
          "ବର୍ଣ୍ଣିବାକୁ କେହି ନାହିଁ",
          "ଠିକେ ଦୁଃଖୀଶ୍ୟାମ ଅଧମ କହଇ",
          "ଯୁଗଳପଦକୁ ଧ୍ୟାଇ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rathara-upare-kie/"
    }
  ],
