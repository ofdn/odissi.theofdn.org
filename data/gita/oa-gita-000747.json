{
  "id": "oa-gita-000747",
  "name": {
    "en": "Re kisori to buddhi bibeka hudi",
    "or": "ରେ କିଶୋରୀ ତୋ ବୁଦ୍ଧି ବିବେକ ହୁଡ଼ି"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000150"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/re-kisori-to-buddhi-bibeka-hudi-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରେ କିଶୋରୀ ତୋ ବୁଦ୍ଧି ବିବେକ ହୁଡ଼ି",
          "ନନ୍ଦ ନେତ୍ରଚାନ୍ଦ ଶୋଭାସିନ୍ଧୁ ନୀରେ",
          "ଆଜି ତୁ ଗଲୁ କି ବୁଡ଼ି । ଘୋଷା ।।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏ ଅତି ସୁଲଭ ଯେ ଦେବଦୁର୍ଲ୍ଲଭ",
          "ସେ ଯେବେ ନେଲେଣି ଜାତି",
          "ଏଣିକି ଅନଙ୍ଗରଙ୍ଗ ମହୋତ୍ସବେ",
          "ପୁହାଇବୁ ସୁଖେ ରାତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତାହାଙ୍କ ପ୍ରଣୟ ଭୁଜେ ବାନ୍ଧିହେଲେ",
          "ଆରେ ଜୀବନ ବାନ୍ଧବୀ",
          "ସେ କାଳେ ଆମ୍ଭଙ୍କୁ ଲୋଡ଼ିବୁ କି ଆଉ",
          "ମନେ ମୁଁ ହେଉଛି ଭାବି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୂର୍ବରେ ତୁ କେଉଁ ପୁଣ୍ୟ କରିଥିଲୁ",
          "କେଉଁ ଦେବତା ମନାଇଁ",
          "ଜାଣି ସେ ସୁକୃତ ହେଲେ ବଶୀଭୂତ",
          "ନାଗରବର କହ୍ନାଇଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନବ ଅନୁରାଗେ ପୁଲକିତ ଅଙ୍ଗେ",
          "ଠାରୁଛୁ କାହାକୁ ଆଖି",
          "ଲୁଚାଇଲେ ଧନ ମରମ କଥାଟି",
          "ଜଣାପଡ଼ି ନ ଯାଏ କି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସାତ୍ତ୍ୱିକ ବିକାରେ ପ୍ରେମ ଜରଜରେ",
          "ହେଲୁଣି ତ ବାଇଆଣୀ",
          "ତୋ ପ୍ରାଣ ସର୍ବସ୍ୱ ହେଲେଣି ଅବଶ୍ୟ",
          "ମୋହନ ମୁରଲୀପାଣି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୌର ଦ୍ୱିଜ ଗିର ଛାଡ଼ି ନାହିଁ ତୋର",
          "ବାଲ୍ୟ ଦଶା ଆଜ ସରି",
          "କୃଷ୍ଣଧନେ ଧନୀ ହୋଇ ସଜନୀଙ୍କି",
          "ଦେବୁ ନାହିଁଟି ପାଶୋରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/re-kisori-to-buddhi-bibeka-hudi-gouracharana/"
    }
  ],
