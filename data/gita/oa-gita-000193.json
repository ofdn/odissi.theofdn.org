{
  "id": "oa-gita-000193",
  "name": {
    "en": "Basi kanduthiba manini",
    "or": "ବସି କାନ୍ଦୁଥିବ ମାନିନୀ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/basi-kanduthiba-manini/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବସି କାନ୍ଦୁଥିବ ମାନିନୀ । ପ୍ରାଣସଜନୀ ।",
          "ଅଗୁରୁ ଚନ୍ଦନ ବିଷ ତୁଲ୍ୟ ସେ ମଣୁଥିବଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୁନ୍ଥିଣ ଗଈଶହାର ପୂଜୁଥିବ ସେ ଶଙ୍କର ।",
          "ମୋ ବିଚ୍ଛେଦେ ରାମାବର ଉଚ୍ଛନ୍ନ ହେଉଥିବଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚାହୁଁଥିବ ଚନ୍ଦ୍ରମୁଖୀ ଯେସନେ ଚାତକପକ୍ଷୀ",
          "କାମେ ହେଉଥିବ ଦୁଃଖୀ ରଜନୀରେ ସଜନୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆସି ବସନ୍ତ ହୋଇଲା କି କରୁଥିବ ମୋ ବାଳା",
          "ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ ମାଳା ବସି ସେ ଜପୁଥିବଣି"
        ]
      }
    ]
  },
  "sources": [
    {
