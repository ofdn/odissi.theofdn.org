{
  "id": "oa-gita-001379",
  "name": {
    "en": "Sajani mun hudili",
    "or": "ସଖୀ ମୁଁ ହୁଡ଼ିଲି"
  },
  "composer": "oa-person-000043",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-mun-hudili/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ମୁଁ ହୁଡ଼ିଲି ରେ",
          "ନନ୍ଦସୁତ ସଙ୍ଗେ ପ୍ରୀତି କରିବାକୁ",
          "ତୋ ବୋଲେ ଯାହା ପଡ଼ିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲାଭ ହେଲା ଏହି ନିରତେ ନୟନୁ",
          "ଲୋତକ ଧାରା ଢାଳିଲି",
          "ଯେତେ ଥିଲା କୁଳବତୀ ଲଜ୍ଜା ଧନ",
          "ପେଡ଼ି ଦାଣ୍ଡରେ ଫେଡ଼ିଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସାହି ପଡ଼ିଶା ଇଙ୍ଗିତ ଶୁଣି ଦାଣ୍ଡ",
          "ଦେହଳୀକି ନ ମାଡ଼ିଲି",
          "ତହିଁରେ ଶାଶୁ ନଣନ୍ଦ ଗିର ବିଷ",
          "ଘାତକୁ ଶିର ଆଡ଼ିଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ୟାମ ସଙ୍ଗ ବିନା ଦେହ ଲତିକାରୁ",
          "ପ୍ରାଣ ଫଳକୁ ଏଡ଼ିଲି",
          "ରଜନୀ ଦିବସ ଉତ୍ସୁକ ମନରେ",
          "ଏହି ରସରେ ଜଡ଼ିଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପର ପୀରତି କିଛି ନୋହେ ସଜନୀ",
          "ଏବେ ମୁଁ ସିନା ବିଡ଼ିଲି",
          "ସ୍ମର ପିଶାଚ ବଳୀ ପାଇଁ ତା ଶରା",
          "-ନଳେ ତନୁକୁ ପୋଡ଼ିଲି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କି କରିବି କାହିଁ ଯିବି ଏହି ଚିନ୍ତା",
          "ଫଳରେ ନିତ୍ୟେ ସଡ଼ିଲି",
          "ବୋଲେ ଦୀନବନ୍ଧୁ ଆପଣା ଇଚ୍ଛାଏଁ",
          "ଗରଳ ଖାଇ ଲୋଡ଼ିଲି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-mun-hudili/"
    }
  ],
