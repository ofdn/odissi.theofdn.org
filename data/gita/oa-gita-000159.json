{
  "id": "oa-gita-000159",
  "name": {
    "en": "Mahi mandana tu na mara mara re",
    "or": "ମହୀମଣ୍ଡନା ତୁ ନ ମାର ମାରରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000073"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mahi-mandana-tu-na-mara-mara-re-kabisurjya-margabihaga-margabehaga-ekatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମହୀ ମଣ୍ଡନା ତୁ ନ ମାର ମାରରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘେନ ତୋ ଅବଧାନେ ରସିଲି ମୁଁ କି ଆନେ",
          "ତୁ ଥାଉଁ ଥାଉଁ ଏ ସଂସାର ସାର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବରଜି ମଣିପୁଞ୍ଜ ଅରଜିବାକୁ ଗୁଞ୍ଜ",
          "ଶିରୀଷ ଅଙ୍ଗୀ ଅଙ୍ଗୀକାର କାର ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କିସ ମାନସେ ଭାଳି କରଜ କଳୀ ଚାଳି",
          "ଭରତି କଲୁଣି ଅଗାର ଗାର ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେଳି ଚଞ୍ଚଳତର ନେତ୍ର ଖଞ୍ଜନୁ ନୀର",
          "ବହେ କାହିଁକି ଆହା ଧାର ଧାର ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆରେ ରତି ପ୍ରତିମା ଆଚର ଏବେ କ୍ଷମା",
          "ବହିବି ତୋ ହୁକୁମ ବାରବାର ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ମୋ ଧନ ହୁଅ ରାଜି ମଦନ ବାଣ ବାଜି",
          "ହେଲାଣି ମୋ ହୃଦୟ ଆରପାର ରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ମୋ ସପତଟି ମଥା ଟେକି ଭାଷ ତୁ କଥା",
          "କହେ ଶ୍ରୀ ଜଗଦ୍ଦେବ ବାରବାର ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
