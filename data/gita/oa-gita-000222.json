{
  "id": "oa-gita-000222",
  "name": {
    "en": "Pherija pherija kanhu kunjaku na ja",
    "or": "ଫେରିଯା ଫେରିଯା କାହ୍ନୁ କୁଞ୍ଜକୁ ନ ଯା"
  },
  "composer": "oa-person-000081",
  "mula_raga": [
    "oa-raga-000070"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pherija-pherija-kanhu-kunjaku-na-ja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଫେରିଯା ଫେରିଯା କାହ୍ନୁ କୁଞ୍ଜକୁ ନ ଯା",
          "ଆମ୍ଭ କିଶୋରୀ ସ୍ୱପନ ନିଦ୍ରା ନ ଭଞ୍ଜା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୁମ୍ଭ କରମ ଧରମ ଧେନୁରଖା ବଡ଼ପଣ",
          "ତୁ କାହୁଁ ଜାଣିବୁ ଶ୍ୟାମ ପୀରିତ ମଜ୍ଜା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାତି ତୋ କଠାଉ ମଡ଼ା ଶିକା ବାଉଙ୍ଗୀ ସଜଡ଼ା",
          "ବନଫୁଲେ ବାନ୍ଧି ଜୂଡ଼ା ମୁରଲୀ ବଜା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୁରୁଷ ଭ୍ରମର ଜାତି ଖୋଜୁଥାନ୍ତି ପରପ୍ରୀତି",
          "ପାଇ ସନ୍ତୋଷ ହୁଅନ୍ତି ମହତହଜା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗଲେ ଅପମାନ ହେବ ମାନ ସଙ୍ଗରେ ବଢ଼ିବ",
          "ବୋଲେ ଦୀନ କାଶୀ ଭାବି ପାଇବ ମଜ୍ଜା ରେ"
        ]
      }
    ]
  },
