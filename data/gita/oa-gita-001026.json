{
  "id": "oa-gita-001026",
  "name": {
    "en": "Sahi go aau eniki",
    "or": "ସହି ଗୋ ଆଉ ଏଣିକି"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000082"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahi-go-aau-eniki-gouda-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହି ଗୋ ଆଉ ଏଣିକି",
          "କହିଲେ କେତେ ପରତେ ନାହିଁ ସେ ବେଣୁପାଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶୟନ ଲବେ ନ ବିହି ଥୟରେ ଦଣ୍ଡେ ନ ରହି",
          "ଅୟନକୁ ଚାହିଁ ଚାହିଁ ନୟନୁଁ ତେଜି ପାଣିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଞ୍ଜବେଳୁ ବେଶ ସାଜି କୁଞ୍ଜରେ ଥିଲି ମୁଁ ଆଜି",
          "କଞ୍ଜନେତ୍ର ତେଜି ରାଜି ଭଞ୍ଜନ କଲେ ଆଣିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭରମେ ପଡ଼ିଲି ଯାହା କରମେ ଥିଲା କି ଏହା",
          "ମରମେ ନାହିଁ ଉତ୍ସାହା ନରମେ ମନ କେଣିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଚନ୍ଦ୍ର ରଘୁନାଥ ଭାବି କହେ ତୋର ଚିତ୍ତ",
          "ଥବିର କର ଗୋ ସତ ଯିବି ମୁଁ ଆଣି ତେଣିକି"
        ]
      }
    ]
  },
