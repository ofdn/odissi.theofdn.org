{
  "id": "oa-gita-000814",
  "name": {
    "en": "Ki kalu nagari hira",
    "or": "କି କଲୁ ନାଗରୀ ହୀରା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-kalu-nagari-hira-kaphi-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି କଲୁ ନାଗରୀ ହୀରା",
          "ପରଶମଣିରେ ପଥର ମଣି ଯା",
          "ଫିଙ୍ଗି ଦେଲୁ ପର ପରା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗରୁ ଯଉବନ ଗୁରୁ ମଣି ଧନ",
          "ଗୁମାନେ ଫୁଲାଇ ମୁଖ",
          "ଧରୁଁ କର ତୋର ଦୂରେ ଠେଲିବାର",
          "ବରିନେଲା ସିନା ଦୁଃଖ",
          "ଅନୁଦିନ ଅନୁତାପ ତାପ ସହି",
          "ସାର ଆଖି ନୀରଝରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଫଟା ଦରପଣ ଫିଟା ତୁଟା ମନ",
          "ଗୋଟା କି ହେବ ସୁମନା",
          "ସାଉଁଟିଲା କାଣ୍ଡ ଯେତେ କଲେ ରୁଣ୍ଡ",
          "ଯୁଦ୍ଧକୁ ହୁଏ କି ଗଣା",
          "ତାଳିପକା ଶାଢ଼ୀ ପେଡ଼ି ସାଇତାରେ",
          "ନୂଆ ହୋଇବ କି ଧୀରା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କବିଚନ୍ଦ୍ର କହେ ଲିଭିଲା ଦୀପରେ",
          "ଯେତେ ପଛେ ଘିଅ ଢାଳ",
          "ଗଢ଼ା ଦେଉଳକୁ ଭାଙ୍ଗିବାକୁ ଲୋଡ଼ା",
          "ଆଖି ପିଛୁଳାକ କାଳ",
          "ଯାଚିଦେଲା ଧନ ନ କଲୁ ଯତନ",
          "ଝୁରି ଏବେ ହୁଅ ସାରା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-kalu-nagari-hira-kaphi-kabichandra/"
    }
  ],
