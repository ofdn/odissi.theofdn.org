{
  "id": "oa-gita-000658",
  "name": {
    "en": "Kanja nayana kisori janitha re",
    "or": "କଞ୍ଜନୟନା କିଶୋରୀ ଜାଣିଥା ରେ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000162"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kanja-nayana-kisori-janitha-re-kelisaranga/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କଞ୍ଜନୟନା କିଶୋରୀ ଜାଣିଥା ରେ",
          "କଥା ପଦକ ମନକୁ ଆଣିଥା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଲା ବେଳେ ଅଭିସାର ସେ ଯମୁନା ପଥେ",
          "କଦମ୍ବ ମୂଳକୁ ନ ଚାହିଁବୁ ଆଡ଼ ନେତ୍ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କନକଗୋରୀ ମାନଙ୍କୁ ରହିଛି ଯେ ଟାକି",
          "କଳାପିଚୂଳିଆ କହ୍ନା ରଖିବ କି ବାକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଳଙ୍କଲଗା ମୋହିନୀ ଶିଖିଛି ସେ କାହୁଁ",
          "କରିଦିଏ ବୁଦ୍ଧି ବଣା ପରା ଚାହୁଁ ଚାହୁଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଚନ୍ଦ୍ର ବେଣୁଧର କହଇ ଏ ଗୀତେ",
          "କୁଞ୍ଜବନ କାଳିଆକୁ ନ ଯିବୁ ପରତେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
