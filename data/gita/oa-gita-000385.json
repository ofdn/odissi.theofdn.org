{
  "id": "oa-gita-000385",
  "name": {
    "en": "Phutila baula bhramara akula",
    "or": "ଫୁଟିଲା ବଉଳ ଭ୍ରମର ଆକୁଳ"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000093"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/phutila-baula-bhramara-akula/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଫୁଟିଲା ବଉଳ ଭ୍ରମର ଆକୁଳ",
          "ଝଙ୍କାର ଚହଳ ବଚନେ",
          "ଅତି ବିନୀତରେ ପ୍ରେମ ପୂର୍ଣ୍ଣ କରେ",
          "ଗୁହାରି ଭ୍ରମଇ ମଦନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିତି ରାତି ଆସି ଯୁବତୀଗଣ",
          "ପ୍ରିୟାକୁ ମୋହର କରି ହରଣ",
          "ଖୋଷା ପରେ ଖୋସି ତାଙ୍କ ପରାଣ",
          "ନାଥଙ୍କୁ ତୋଷିଲେ ସୁମନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାର ସୁଖ କିଏ ଲୋଡ଼ଇ ନାହିଁ",
          "ମୋ ସୁଖ ବାଧାରେ ବାଇ କିମ୍ପାଇଁ",
          "ମୋ କଥାକୁ ସେ ତ ବୁଝିଲେ କାହିଁକି",
          "କରିବି କହ ରାଜନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୁଣ ମୋ ବିନତି ମଦନରାଜ",
          "ତାଙ୍କ ନାଥ ହୃଦେ ଶର ନ ସାଜ",
          "ଅବହେଳା ପାଇଁ ରାମା ସମାଜ",
          "ନ ରସି ହେ ଗଭାମଣ୍ଡନେ"
        ]
      }
    ]
  },
  "sources": [
