  "name": {
    "en": "Hata nagara he satha lampata",
    "or": "ହଟନାଗର ହେ ଶଠ ଲମ୍ପଟ"
  },
  "composer": "oa-person-000050",
  "mula_raga": [
    "oa-raga-000038"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hata-nagara-he-satha-lampata/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହଟନାଗର ହେ ଶଠ ଲମ୍ପଟ",
          "ଅଟ ଏଡ଼େ ଖଣ୍ଟ ଜାଣ କେତେ କପଟ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନାଟଲଗା ବାଟଜଗା ଧିଟ ନିପଟ",
          "ଘାଟ କଉଡ଼ି ମାଗନା ପୀତପଟ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପାଟକ କୁଳରେ ପରା ଅତି ଆକଟ",
          "ରାଟସୁତ କରାଅନା ନିନ୍ଦା ପ୍ରକଟ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିଛାଟରେ ନାହାନ୍ତି ମୋ ସଖୀ ଥାଟ",
          "ତାଟକା ନ କର ଏଥି ଏ କି ମୁରାଟ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପାଟକୁମର ଆଉ ନ କର ଅଝଟ",
          "ଘାଟ ଛାଡ଼ ଦୀନକୃଷ୍ଣ କହେ ହେ ବିଟ"
        ]
      }
    ]
  },
  "sources": [
