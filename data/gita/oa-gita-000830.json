{
  "id": "oa-gita-000830",
  "name": {
    "en": "Se nagara ka pase rahile",
    "or": "ସେ ନାଗର କା ପାଶେ ରହିଲେ"
  },
  "composer": "oa-person-000095",
  "mula_raga": [
    "oa-raga-000045"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-nagara-ka-pase-rahile-go-arabhi-gobinda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ ନାଗର କା ପାଶେ ରହିଲେ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆସିବି ବୋଲି ରଜନୀ ଭାଷିଲେ ଗୋ ସଜନୀ",
          "କି ଦୋଷ ମୋର ଘେନି ରସେ କେଉଁ କାମିନୀ",
          "ରସେ ରସି ମନକୁ ମୋହିଲେ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଜାଡ଼ି ମୁଁ ଥିଲି ପାନ ଯୋଗାଡ଼ି ଚୂଆ ଚନ୍ଦନ",
          "ବାସ କୁସୁମ ଭୂଷଣ ବାସି କରାଇବା ମନ",
          "ଥିଲା ଯେବେ କାହିଁକି କହିଲେ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେହକୁ ମୋ ଛୁଇଁ ହରି ନିୟମ ଥିଲେ ତ କରି",
          "ତା ଏବେ ଦେଇ ପାଶୋରି ଯାହା କଲେ ଏତେ ସରି",
          "ଆହା ବନ୍ଧୁ କି ଦଣ୍ଡ ବିହିଲେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଧରିବି କିପରି ପ୍ରାଣ ହେବ କେ ମୋ ପରିତ୍ରାଣ",
          "ସେ ଶ୍ୟାମ କପଟପଣ କରି ଯାହା ପଞ୍ଚବାଣ",
          "ଅନଳରେ ମୋ ତନୁ ଦହିଲେ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାଧା ଖେଦ ଦୂତୀ ଜାଣି କହନ୍ତି ସେ ବେନୁପାଣି",
          "ଆସିବେ ନିଶ୍ଚୟ ପୁଣି ଏ ରସେ ଗୋବିନ୍ଦ ଭଣି",
          "ବିନୟରେ ଦୁଃଖ ଶୁଣାଇଲେ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
