{
  "id": "oa-gita-000679",
  "name": {
    "en": "Jibana sartha karibi",
    "or": "ଜୀବନ ସାର୍ଥ କରିବି"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000166"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jibana-sartha-karibi-basanta-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୀବନ ସାର୍ଥ କରିବି",
          "ଆଉ ଅନ୍ତର ତିଳେ ନୋହିବି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କରି ପରିରମ୍ଭ ବସାନ୍ତେ କୋଳେ",
          "ଲାଜେ ଲାଜେ ଖସି ବସନ୍ତେ ତଳେ",
          "ମୁଁ ତୋ କିଣା ବୋଲି ବୀଣାଭାଷୀ ଆଗେ",
          "କର ଯୋଡ଼ି ଉଭା ହେବି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୃଥୁଳ ଚିକ୍କଣ ଚାରୁ ଜଘନ",
          "ସିଂହାସନେ ବସି ପାଇ ସମ୍ମାନ",
          "କୁଚ ତକିଆରେ ଆଉଜି ମଘବା",
          "ପଦକୁ ତୁଚ୍ଛ ମଣିବି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାନା କଉତୁକ ରସେ ବୁଡ଼ାଇ",
          "ହୃଦରେ ହୃଦକୁ ଦେବି ଜଡ଼ାଇ",
          "ନୀବି ବନ୍ଧେ କର ନିବେଶି କାତରେ",
          "ଏକିଏକି କୁହାଇବି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିହି ମୁଖ ପଦ୍ମେ ଚୁମ୍ବନ ବ୍ରଜ",
          "ସଧୀରେ ଊରଜେ ଚାଳି କରଜ",
          "ଈଷି ଈଷି ମଲି ବୋଲିବା ସମୟେ",
          "ଅଧରୁ ସୁଧା ପିଇବି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ଭାଷେ ଏ ଗିର",
          "ନିତି ନିତି ସେବି ରାମା ପାଶର",
          "ଦୁର୍ନିବାର ମାର ଦର କରି ଦୂର",
          "ସନ୍ତତେ ସୁଖୀ ହୋଇବି"
        ]
      }
    ]
  },
  "sources": [
    {
