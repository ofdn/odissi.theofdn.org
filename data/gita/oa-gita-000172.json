{
  "id": "oa-gita-000172",
  "name": {
    "en": "Se gajendra gati mote",
    "or": "ସେ ଗଜେନ୍ଦ୍ର ଗତି ମୋତେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000076"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-gajendra-gati-mote-kanada-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ ଗଜେନ୍ଦ୍ର ଗତି ମୋତେ ପ୍ରତି ଦିଶେ ଦିଶିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏ ଜଗତେ ଭାବ ଯେତେ ନ ରହିଲା ମୋର ଚିତ୍ତେ",
          "ଯେଣିକି ଚାହିଁଲେ ସେ ତ ତାହା ପରି ଦିଶିଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସହଜେ କାନ୍ତିରେ ତୋରା ଧଇଲେ ନ ଦିଏ ଧରା",
          "ମାର ମାରଗଣ ଗାଢ଼େ ମରମରେ କଷିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଁ ତାହାର ପ୍ରୀତି କିଣା ହେବାରୁ ଅଧିକେ ବଣା",
          "ମୃଗାକ୍ଷୀର ବିନା ଆନେ ମନ ମୋ ନ ରସିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅତି ଯତ୍ନ କରି ବଳେ ଶୟନ କରିବା କାଳେ",
          "କ୍ଷଣେ ହେଲେ ନିଦ୍ରା ମୋ ଈକ୍ଷଣକୁ ନ ଦିଶିଲା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୋଲେ ଅଷ୍ଟଦୁର୍ଗେଶ୍ୱର ତା ପାଶୁ ହେବାରୁ ଦୂର",
          "ଦିନକୁ ଦିନ ମଦନ ଜୀବନକୁ ଶୋଷିଲା"
        ]
      }
    ]
  },
  "note": {
    "en": "(Alternate tune in Ananda Kedara, Tripata)"
  },
