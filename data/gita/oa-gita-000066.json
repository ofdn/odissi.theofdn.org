{
  "id": "oa-gita-000066",
  "name": {
    "en": "Banchita bandhure",
    "or": "ବାଞ୍ଛିତ ବନ୍ଧୁରେ"
  },
  "composer": "oa-person-000014",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/banchita-bandhure/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାଞ୍ଛିତ ବନ୍ଧୁରେ",
          "ପର୍ବଶର୍ବରୀଶ ଖର୍ବ ମୁଁ ନାଗରୀଶ",
          "ଶର୍ବରୀ ଦିବା ଆଶ ପର୍ବତରୁ ବିଶେଷ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୋଳି ଚୂଆ ଚନ୍ଦନ । ବୋଳିବି ଅଙ୍ଗେ ଧନ ।",
          "ତୋଳି ସଜ ସୁମନ । ଦୋଳି କରି ମଣ୍ଡନ ।",
          "କଞ୍ଜ ଚରଣେ ତୋର । ଖଞ୍ଜ ମଣି ମଞ୍ଜୁର ।",
          "ଖଞ୍ଜନାକ୍ଷୀରେ କର । ମାଜଣା ପରିଚାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଞ୍ଜ ହେଜି ତଳ୍ପ ତଳେ ଅଳ୍ପହାରୀ",
          "କ୍ଳାନ୍ତି ଶାନ୍ତି କରାଇବି ମନ ଜାଣି ।",
          "ରସାଇ ରସେ ଗୋରୀ । ହସାଇଲୁ ଭଗାରି ।",
          "ରସାରୁ ଯିବି ସରି । ଯଶାକୁ ମୁଁ ସୁମରି ।",
          "ଦୂରୁ କାମକମାଣ । ଭୂରୁ ନୟନ ବାଣ ।",
          "ସରୁ ପାକରେ ଜାଣ । ହରିନେଲା ରେ ପ୍ରାଣ ।",
          "ଟାଣେ ହାଣିରେ ରସାଣେ ସ୍ୱର୍ଣ୍ଣ ଦେଇ ।",
          "ରାମ ବାଣ ପରିତ୍ରାଣ କର ତୁ ଜାଣ"
        ]
      }
    ]
  },
  "sources": [
