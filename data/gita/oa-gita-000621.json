{
  "id": "oa-gita-000621",
  "name": {
    "en": "Ojasila bhoja gaja",
    "or": "ଓଜଃଶୀଳ ଭୋଜ ଗଜ"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000084"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ojasila-bhoja-gaja-jibana-jadumani-panchama-baradi/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଓଜଃଶୀଳ ଭୋଜ ଗଜ ଜୀବନ ହରଣେ ତେଜ",
          "ଅର୍ପଣ କଲ କୃପଣ ନୋହି",
          "ଗଭୀର ଜଳେ କୁମ୍ଭୀର ଗଳ ଗ୍ରହଣେ କୁମ୍ଭୀର",
          "ଜୀବ ରକ୍ଷା କଲ କକ୍ଷା ବହି ହେ",
          "ନୀଳାଚଳ କଳାକର",
          "ସତ କି ଏ ମିଛ",
          "ନେଲ ଯାହା ଦେଲ ତାହା ଏଥକୁ କିମ୍ପାଇଁ ମହା",
          "ଦାତାପଣେ ପତାକା ବାନ୍ଧିଛ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଳି ବଳିଷ୍ଠ ବାଳିକି ଅକଳିତ ବିଭୂତିକି",
          "ଦଳିତ କରରେ କରିଥିଲ",
          "ନ ମାନି କରି ରମାକୁ ଅକିଞ୍ଚନ ସୁଦାମାକୁ",
          "ବିପୁଳ ସମ୍ପଦେ ମଣ୍ଡିଦେଲ ହେ",
          "ନୀଳାଚଳ କଳାକର",
          "ସତ କି ଏ ମିଛ",
          "ନେଲ ଯାହା ଦେଲ ତାହା ଏଥକୁ କିମ୍ପାଇଁ ମହା",
          "ଦାତାପଣେ ପତାକା ବାନ୍ଧିଛ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋକୁଳ କଳଧଉତ ଗଉରାଙ୍ଗୀଙ୍କ ମହତ",
          "ନେଇଥିବା ସକାଶରୁ କରି",
          "ଦ୍ରୁପଦ ନୃପନନ୍ଦନା ମହତ ହର ବେଦନା",
          "ବିନାଶନେ ହେଲ ଧନ୍ୱନ୍ତରୀ ହେ",
          "ନୀଳାଚଳ କଳାକର",
          "ସତ କି ଏ ମିଛ",
          "ନେଲ ଯାହା ଦେଲ ତାହା ଏଥକୁ କିମ୍ପାଇଁ ମହା",
          "ଦାତାପଣେ ପତାକା ବାନ୍ଧିଛ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପାତକୀ ମୁକୁଟ ଶ୍ରେଣୀ ଶିରୋମଣି ଯଦୁମଣି",
          "ମନ ତିଳେ ନେଇ ନ ପାରିବ",
          "ଏହା ଉଦ୍ଧାରଣେ ଯେବେ ଚିତ୍ତ ଦେଇ ପାର ଲବେ",
          "ତେବେ ସିନା ଦାତା ବୋଲାଇବ ହେ",
          "ନୀଳାଚଳ କଳାକର",
          "ସତ କି ଏ ମିଛ",
          "ନେଲ ଯାହା ଦେଲ ତାହା ଏଥକୁ କିମ୍ପାଇଁ ମହା",
          "ଦାତାପଣେ ପତାକା ବାନ୍ଧିଛ ହେ"
        ]
      }
    ]
  },
