{
  "id": "oa-gita-000765",
  "name": {
    "en": "Syama jane mohini buti",
    "or": "ଶ୍ୟାମ ଜାଣେ ମୋହିନୀ ବୁଟୀ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000057"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-jane-mohini-buti-kusuma-kedara-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ଜାଣେ ମୋହିନୀ ବୁଟୀ",
          "ସହି ତା ନଜରେ ନ ପଡ଼ିବୁଟି",
          "ରଙ୍ଗିଆ ଭଙ୍ଗିଆ ସୁବଳସଙ୍ଗିଆ",
          "ଚନ୍ଦ୍ରା ମନ ଧନ ନେଇଛି ଲୁଟି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏ ଗୋପରେ ଯେତେ ତରୁଣୀ",
          "ଦମ୍ଭେ କେ ବା ରହିବ ପୁଣି",
          "ଶ୍ରବଣେ ତାହାର ଶୁଣି ବଂଶୀ ସ୍ୱର",
          "କଦମ୍ବ ମୂଳକୁ ଯିବ ଧପଟି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତାର ଯେଉଁ ଚାହାଣୀ ଛଟା",
          "ମଦନର କାଣ୍ଡିଆ ଅଠା",
          "ତୋର ଆଖି ପକ୍ଷୀ ତହିଁ ଗଲେ ଲାଖି",
          "ଉବୁରିବୁ କେବେ ମନ୍ଦାର ଓଠୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଖିଲେ ତା ଠିଆ ଠାଣିକି",
          "ରଖି ନ ପାରିବୁ ଆଣିକି",
          "ଅଖିଳ ନାଗର ମଉଡ଼ମଣି ସେ",
          "ଯେତେବେଳେ ଯିବ ତୋ ଆଗେ ଜୁଟି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୁରସିଆ ଦରହସିଆ",
          "କୁଳବତୀ ଧୃତି ଧ୍ୱଂସିଆ",
          "ଜାଣି ବୁଝି ଧନୀ ପାହୁଣ୍ଡ ଚାଳିବୁ",
          "ସଖୀ ଗହଳେ ଲୁଚିଥିବୁଟି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବିଚିତ୍ର ତା ଛଇ ଚାତୁରୀ",
          "ସତୀ ଦମ୍ଭ ଦିଏ କତୁରୀ",
          "କହେ ବନମାଳୀ ତୁ ରାଜ ଦୁଲାଳୀ",
          "ଉଠି ନ ପାରିବୁ ପଡ଼ିଲେ ଝୁଣ୍ଟି"
        ]
      }
    ]
  },
  "sources": [
