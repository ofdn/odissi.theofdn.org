{
  "id": "oa-gita-000600",
  "name": {
    "en": "Dekha re mukha bare",
    "or": "ଦେଖା ରେ ମୁଖ ବାରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-re-mukha-bare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖା ରେ ମୁଖ ବାରେ ସୁଖସଦନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାନ କି ମାନ ହିଁ ବାନ୍ଧବୀ ତୋହର",
          "ପାଲଟ ପାଟରଖା ରେ",
          "ଏଣି ବିଲୋକିନୀ ଏଣିକି କେଣିକି",
          "ମୁଞ୍ଚ ତୁ ନୃତ୍ୟ ଶିଖା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେଶରୀ ତ ଓସରି ମଧ୍ୟ ତୁଳା କଟି",
          "ହେବ କି ଚିତ୍ରଲେଖା ରେ",
          "ତୋଷ ବହି ନିଜ ଦାସର ଦୋଷକୁ",
          "ମୁଞ୍ଚ ତୁ ନୃତ୍ୟ ଶିଖା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହର ମନୋହର ସାର ପୟୋଧର",
          "ଚିତ୍ର ବିଚିତ୍ର ଲେଖା ରେ",
          "ଯାବକ ରଞ୍ଜିତ ପାଦତଳ ଗତ",
          "ତୋ ଅନୁରାଗ ଶିଖା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାମଜଳେ କବି ଭାସ୍କର ଭାଷଇ",
          "ତୋ କୁଚ କୁମ୍ଭ ଦେଖା ରେ",
          "କୋଳ କରି ରସ ଭୋଳେ ହେବି ତୋଷ",
          "ଦୌଲତ ବନ୍ଧ ଶିଖା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
