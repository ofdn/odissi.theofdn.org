{
  "id": "oa-gita-001174",
  "name": {
    "en": "Ki heba sua posile",
    "or": "କି ହେବ ଶୁଆ ପୋଷିଲେ"
  },
  "composer": "oa-person-000026",
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-heba-sua-posile-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ହେବ ଶୁଆ ପୋଷିଲେ",
          "ହରି ନାମ ନ ଘୋଷିଲେ କୃଷ୍ଣ ନାମ ନ ଘୋଷିଲେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଉଳକୁ ଶୋଭା ଦିଶେ ଧ୍ୱଜା ବାନ୍ଧିଲେ",
          "ଧ୍ୱଜା ବାନ୍ଧିଲେ କି ହେବ ଦେଉଳେ ଦିଅଁ ନ ଥିଲେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବୃକ୍ଷକୁ ଯେ ଶୋଭା ଦିଶେ ଫଳ ଫଳିଲେ",
          "ଫଳ ଫଳିଲେ କି ହେବ ଜନ ମୁଖେ ନ ପଡ଼ିଲେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପିଣ୍ଡକୁ କାରଣ ଅଟେ ମାଳା ଜପିଲେ",
          "ମାଳା ଜପିଲେ କି ହେବ ପରମାତ୍ମା ନ ଚିହ୍ନିଲେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଘରକୁ ସୁନ୍ଦର ଦିଶେ ବାଳକ ଥିଲେ",
          "ବାଳକ ଥିଲେ କି ହେବ ବିଦ୍ୟା ଶିକ୍ଷା ନ କରିଲେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପୁଷ୍କରଣୀ ଶୋଭା ଦିଶେ ପଦ୍ମ ଫୁଟିଲେ",
          "ପଦ୍ମ ଫୁଟିଲେ କି ହେବ ଭ୍ରମର ତା ନ ଚୁମ୍ବିଲେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୀତେ କହେ ବନମାଳୀ ପଦ ବସିଲେ",
          "ପଦ ବସିଲେ କି ହେବ ଗୁରୁ ସେବା ନ କରିଲେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-heba-sua-posile-banamali/"
    }
  ],
