{
  "id": "oa-gita-000058",
  "name": {
    "en": "Kahinki ede birasa narisa",
    "or": "କାହିଁକି ଏଡ଼େ ବିରସ ନାରୀଶ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000031"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinki-ede-birasa-narisa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ଏଡ଼େ ବିରସ ନାରୀଶ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କହରେ ପ୍ରାଣଧନ କା ଲାଗି ଏ ଗୁମାନ",
          "ଅକାରଣେ ବହିଛୁ ହୋଇ ତୁହି ବାଳୀଶ",
          "(ପଡ଼ି)",
          "କୁଞ୍ଜନିଳୟଭୂଷା ଆରେ ମଞ୍ଜୁ ରୁଚିର ବେଶା",
          "ସଞ୍ଜ ହେଲାଣି ପରା ରଞ୍ଜ ଶରୀର ତ୍ୱରା",
          "ଅଞ୍ଜନ ନିଭ ଘନକେଶା ସୁରସେ ରସରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘନଶ୍ୟାମ ବରନ ମନ କର ପ୍ରସନ୍ନ",
          "ମନ ତୋ କର ଉଚ୍ଚାଟନ ମୋ ବାଣୀ ଘେନ",
          "(ପଡ଼ି)",
          "ମୋହନ ଆସିଯିବେନି ଚାହିଁ ଚାହିଁ ଥିବେ ତୋ ସରଣୀ",
          "ଖେଳା ଖଞ୍ଜରୀଟ ଡୋଳା ରେ ନବ ବାଳା",
          "ହେଳା ନ କରି ଅଭିସାରେ ଚଳିବା ଆସରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାଜ ମୁଖ ସରୋଜ ଆଜ ରସିକାରାଜ",
          "ବ୍ରଜଇନ୍ଦୁ ଶ୍ରୀ ଯୁବରାଜଙ୍କୁ କର ନିଜ",
          "(ପଡ଼ି)",
          "ସାଜ ସଘନେ ସଜ ଡୁବିରାଜରେ ଗଜ ରାଜ",
          "ରାଜ ଗମନୀ ତେଜ ବ୍ୟାଜ ମନରୁ ଆଜ",
          "ରାଜୁ ତାରିଣୀ ହୃଦ ହେଜି ଯୁଗ ସମାଜରେ"
        ]
      }
    ]
  },
  "sources": [
