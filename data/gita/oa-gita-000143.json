{
  "id": "oa-gita-000143",
  "name": {
    "en": "Jana thila ki mote e riti go",
    "or": "ଜଣାଥିଲା କି ମୋତେ ଏ ରୀତି ଗୋ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jana-thila-ki-mote-e-riti-go-mukhari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଣାଥିଲା କି ମୋତେ ଏ ରୀତି ଗୋ",
          "ଛଣାସୁଧା ସରପଣାରୁ ମଧୁର",
          "ଲାଗୁଥିଲା ଶ୍ୟାମପ୍ରୀତି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲୁଣି ମଣିଲିଣି ମଧୁଝରକୁ",
          "ଶୁଣି ତା ବିଷମ ବଂଶୀସ୍ୱରକୁ",
          "କି ବାଇ ହୋଇଲି ନିଭାଇବି ବୋଲି",
          "ସ୍ମର ଧନଞ୍ଜୟ ହେତି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମହୀତଳେ ଯେତେ ଧୂର୍ତ୍ତ ପୁରୁଷେ",
          "ସହି ସବୁରି ପରମଗୁରୁ ସେ",
          "ଦୂରୁ ସେ ସ୍ନେହକୁ ଜୁହାରି ମୁଁ ହାରି",
          "ରହିଅଛି ଲଭି ଭୀତି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତାରତମ୍ୟ ସେ ନ ଜାଣେ ନିପଟ",
          "ତାର ତନୁ ଗୋଟାଯାକ କପଟ",
          "କଳାବତୀ କୁଳ ମାରଣେ କେବଳ",
          "କରିଅଛି ପରିଚିତି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆସିବି ମୁଁ ବୋଲି ଦେଇ ଭାଷାକୁ",
          "ବାସି କଲା ଯେ ମୋ ଫୁଲ ଭୂଷାକୁ",
          "ତୁ ହେଲେ ପହିଲୁ ଥରେ ନ କହିଲୁ",
          "ସେ କିତବର ଅନୀତି ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନିଚୋଳରେ ହେଲାନି ମୋ ଅରୁଚି",
          "ପୀତପଟ ସେ କାହିଁକି ଧରୁଛି",
          "ତାହାରି ସଦୃଶ ପିନ୍ଧିଥାଉ ବାସ",
          "ଯା ତୁଲେ ମାତୁଛି ନୀତି ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶୁଣି ଏପରି ସରୋଷ ଗିରକୁ",
          "ନିଜ ନୟନେ ଥକାଇ ନୀରକୁ",
          "ଆଳି ପ୍ରବୋଧିଲେ କିଶୋରୀକି ବୋଲେ",
          "ଅଷ୍ଟଦୁର୍ଗ ଧରାପତି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
