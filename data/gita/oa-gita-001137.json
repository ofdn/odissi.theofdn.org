{
  "id": "oa-gita-001137",
  "name": {
    "en": "Heti ma keti kunja kutire",
    "or": "ହେଟି ମା କେଟି କୁଞ୍ଜ କୁଟୀରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/heti-ma-keti-kunja-kutire-gopalakrusna-malabagouda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହେଟି ମା କେଟି କୁଞ୍ଜ କୁଟୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳା ହୋଇ ଦିଶୁଛି ଡୋଳା ଏଣେ ଢାଳୁଛି",
          "ପଳାଇ ଆସୁଛି ବାଜୁଛି ତୁଳା କୋଟି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୃଗମଦ ଉତ୍ପଳ ଅଗରୁ ପରିମଳ",
          "ଲାଗରୁ ପ୍ରସରୁଛି କଟିରେ ପୀତ ଧଟୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚଳାପାଙ୍ଗିନୀ ଚାଲ ତୋଳା ନୋହୁ ସେ ଫୁଲ",
          "କଳାପୀ ପିଚ୍ଛ ଚୂଳ ଅନାଉଛି ଲେଉଟି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଞ୍ଜ ଘୁମାଇଲାନି ସଞ୍ଜ ହୋଇଗଲାନି",
          "ଅଞ୍ଜନ ନିଭ ନବଘନ ଆସିଲା ଘୋଟି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷେ ହେପା ନ କର କି ସେ",
          "କ୍ଷପାକର ଲପନ ଆସୁଛନ୍ତି ପାଛୋଟି"
        ]
      }
    ]
  },
  "sources": [
