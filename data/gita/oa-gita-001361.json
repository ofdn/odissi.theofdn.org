{
  "id": "oa-gita-001361",
  "name": {
    "en": "Sri gurudeba bandanam",
    "or": "ଶ୍ରୀ ଗୁରୁଦେବ ବନ୍ଦନଂ"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000176"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-gurudeba-bandanam-naata-gourahari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ରୀ ଗୁରୁଦେବ ବନ୍ଦନଂ",
          "ସଂସାର ଭାରନାଶନଂ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜୟ ରୂପ ସନାତନ ଜୟ ଗୌର ଭକ୍ତଗଣ",
          "ଜୟ ଦୁଷ୍କୃତ ପରିଶୋଧନଂ",
          "ଜୟ ଶ୍ରୀ ଗୌରଚନ୍ଦ୍ର ଜୟାଦ୍ୱୈତ ନିତ୍ୟାନନ୍ଦ",
          "ଚିନ୍ତି ଯୁଗଳପଦ ସନ୍ତତଂ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁରଲୀ ମନୋହର ତ୍ରିଭଙ୍ଗୀ ସୁନ୍ଦର",
          "ଜୟ ଗୋବର୍ଦ୍ଧନ ଧାରକଂ",
          "ଦୀନ ଦୟାପର ଶ୍ରୀ ରାଧାବର",
          "କଟି ତଟେ ପୀତପଟ ଶୋଭନଂ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରୁଣାସାଗର ଶୁଭଦାୟକ ବର",
          "ଜୟତୁ ପୂର୍ଣ୍ଣଚନ୍ଦ୍ରାନନଂ",
          "ହେ ଜଳଦବରନ ପତିତୋଦ୍ଧାରଣ",
          "କଳି କଳୁଷ ଭୟ ବିମୋଚନଂ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବ୍ରଜପତି ନନ୍ଦନ ଗୋକୁଳ ବନ୍ଦନ",
          "ଜୟ ରାସରସିକ ମୋହନଂ",
          "ଗୋଲୋକ ନାୟକ ହେ ଶୁଭଦାୟକ",
          "ତ୍ରିଜଗତ ମୋହ ବିନାଶନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବ୍ରହ୍ମା ଶଙ୍କର ପଦାବ୍ଜକୁ ଯାହାର",
          "ମାନସେ କରେ ଚିନ୍ତନଂ",
          "ଦ୍ୱିଜ ଗୌରହରି ହୃଦୟେ ସୁମରି",
          "ନିରନ୍ତରେ କରେ ଏ ଧ୍ୟାନ"
        ]
      }
    ]
  },
  "sources": [
    {
