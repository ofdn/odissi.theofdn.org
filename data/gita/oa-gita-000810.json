{
  "id": "oa-gita-000810",
  "name": {
    "en": "Sarili mun ki kali",
    "or": "ସରିଲି ମୁଁ କି କଲି"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000038"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sarili-mun-ki-kali-desakhya-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରିଲି ମୁଁ କି କଲି",
          "ତୋତେ ଯା ହୁଡ଼ିଲି ଚାହିଁଲି",
          "ସେ ଶ୍ୟାମ ଛବି ନୟନ ମେଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁଁ ଥିଲି ଯମୁନା ନୀରେ",
          "ତୀରେ ଆସି ସେ ଅଧୀରେ",
          "ମୁରଲୀ ବାଇଲା ଧୀରେ ସଖିରେ",
          "(ପଡ଼ି)",
          "କାମ ଗଞ୍ଜନ ଠାମ ଅଞ୍ଜନ",
          "ନିନ୍ଦି ସେ ରୂପ ରାଜିରେ",
          "ସାଜିରେ ଆଜିରେ ରାଜିରେ",
          "ସଜନୀ ମୁଁ ବରିଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବସନ ସଜାଡ଼ି ନାହିଁ",
          "ଚାହିଁ ଚମକିଲି ମୁହିଁ",
          "ତା କଳା ନୟନ ଗଲା ଲାଖିରେ",
          "(ପଡ଼ି)",
          "ଚାରୁ ଚଞ୍ଚଳ ନେତ୍ର ଅଞ୍ଚଳ",
          "ଚନ୍ଦ୍ରିକା ଚୂଳରେ ମିତ",
          "ମୋ ଚିତ୍ତ ମୋହିତ ନେଲା ତ",
          "କି ଲାଜରେ ସଢ଼ିଲି"
        ]
      }
    ]
  },
  "sources": [
