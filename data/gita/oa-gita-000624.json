  "id": "oa-gita-000624",
  "name": {
    "en": "Sulakhyana phula dehi re",
    "or": "ସୁଲକ୍ଷଣା ଫୁଲଦେହୀ ରେ"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000160"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sulakhyana-phula-dehi-re-basanta-baradi-jadumani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସୁଲକ୍ଷଣା ଫୁଲଦେହୀ ରେ",
          "ତୁଲରେ ତୋ ପରା ନାହିଁ କେହି ରେ",
          "ଭୁଲ କରିଦେଉ ଯତିତତି ମତି",
          "ଅତି ବିଚକ୍ଷଣା ରତି ସ୍ନେହୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୂତନାରେ ସୁରସବତୀ",
          "ତୁ ତ ମୋ ନୟନ ସମ୍ପତ୍ତି",
          "ଦୂତ ବସନ୍ତର ତୋ ମୃଦୁ ବାଣୀକି",
          "ଶୁଣି ଲାଜେ କେବେ ଥୟ ରହିରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହରିମଧ୍ୟା ଦରିଦ୍ରନିଧି",
          "କରୀବର ଗତି ସନ୍ନିଧି",
          "ପରିକର ପରି କରରେ କରକ",
          "ରଦନା ନିକର କର ଶୋହୀରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାସବର ଭୂତିଦାୟିନୀ",
          "ଆଶ ମୋର ନ ନାଶ ଧନୀ",
          "କାଶହାସ ପରକାଶ ପରତ୍ରାସ",
          "ନାଶ ଭଜୁ ଆସ ଅଙ୍କେ ସହିରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସରସରେ ତୁ ହରଷରେ",
          "ସର ସାରସଜିତ କରେ",
          "କର ଥରେ ପରିରମ୍ଭଣ ଆରମ୍ଭ",
          "ତରକରେ ଯଦୁମଣି କହିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
