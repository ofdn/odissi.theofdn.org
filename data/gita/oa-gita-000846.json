{
  "id": "oa-gita-000846",
  "name": {
    "en": "Ago sajani krusnara ki sneha",
    "or": "ଆଗୋ ସଜନୀ କୃଷ୍ଣର କି ସ୍ନେହ"
  },
  "composer": "oa-person-000125",
  "mula_raga": [
    "oa-raga-000177"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ago-sajani-krusnara-ki-sneha-sindhuda-phakira-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଗୋ ସଜନୀ କୃଷ୍ଣର କି ସ୍ନେହ ମୋରେ",
          "ଯେ ଯେତେ କହିଲେ ଦିନେ ଆନ ସଙ୍ଗେ",
          "ବାଞ୍ଛନ୍ତି ନାହିଁ ମନରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋହନ ମନ୍ତର କିଛି ନ ଜାଣଇ",
          "ବସିଥାନ୍ତି ଚାହିଁ ମୁଖ",
          "ଅଙ୍ଗଛାଇ ପରି ସଙ୍ଗ ନ ଛାଡ଼ନ୍ତି",
          "ପ୍ରିୟତମ ମୋର ପାଖ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କିଛିହିଁ ଗୁଣ ତ ମୋହ ତହିଁ ନାହିଁ",
          "ଘେନିଛନ୍ତି ଏଡ଼େ କରି",
          "ଖୋଜିଲେ ତିନି ଜଗତେ ଲକ୍ଷିବାକୁ",
          "କେହି ଥିବକି ଏପରି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋପ ନଗରେ କେତେ ନାରୀ ନାହାନ୍ତି",
          "ମୁଁ ତାଙ୍କୁ କେଡ଼େ ସୁନ୍ଦର",
          "ଏମନ୍ତ ହେଲେହେଁ ଅନ୍ତରଗତରୁ",
          "ନ କରନ୍ତି ସେ ଅନ୍ତର ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଙ୍ଗଦେଶ ଯେବେ ନ ଥାଇ ମଣ୍ଡନ",
          "କରନ୍ତି ଆପେ ମଣ୍ଡନ",
          "କର ଧରି ଚୁମ୍ବ ଦେଇ ବୋଲୁଥାନ୍ତି",
          "ତୁ ମୋର ଜୀବଜୀବନ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଫକୀର ଭଞ୍ଜ ଏ ଲକ୍ଷଣ ରଚନା",
          "କଲେ ବିଚାରିଣ ଚିତ୍ତେ",
          "ସ୍ୱାଧୀନଭର୍ତ୍ତୃକା ନାୟିକା କହଇ",
          "ଏ ରୂପେ ସଖି ପୁରତେ"
        ]
      }
    ]
  },
  "sources": [
    {
