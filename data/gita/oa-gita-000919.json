{
  "id": "oa-gita-000919",
  "name": {
    "en": "Bege asa re sajani",
    "or": "ବେଗେ ଆସ ରେ ସଜନୀ"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000054"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000005"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bege-asa-re-sajani-kedaragouda-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବେଗେ ଆସ ରେ ସଜନୀ",
          "ମଞ୍ଜୁଳ ବଞ୍ଜୁଳ ବନୁ ପ୍ରସରେ ମୁରଲୀ ଧ୍ୱନି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମହୀ ମହିଳାମଣି ଚାହିଁ ତୋର ସରଣୀ",
          "ଜଗିଛନ୍ତି ଏକାକୀ ବେଣୁପାଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛାଡ଼ି ମନ୍ଥର ଗତି ଆସ ଗୋ ଜାତି ମୋତି",
          "-ଦଶନା କରାଳାକୁ ଲାଗେ ଭୀତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବନମାଳ ସୌରଭେ ଭ୍ରମରେ ତା ପ୍ରଲୋଭେ",
          "ରମନ୍ତି ଏହି ଦିଗେ ଚିତ୍ତ କ୍ଷୋଭେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୃଷ୍ଣଙ୍କୁ ଦେଖି ତୋଷେ ଲାଜେ ରହୁ ସେ ଭାଷେ",
          "ମଜ୍ଜେ ରାଜେନ୍ଦ୍ର ହୃଦ କୃଷ୍ଣ ରସେ"
        ]
      }
    ]
  },
  "sources": [
