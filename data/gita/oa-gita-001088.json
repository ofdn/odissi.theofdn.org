{
  "id": "oa-gita-001088",
  "name": {
    "en": "Sakhi jiba utha go",
    "or": "ସଖୀ ଯିବା ଉଠ ଗୋ"
  },
  "composer": "oa-person-000023",
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-jiba-utha-go-rasapanchaka-bipralabdha-upendra-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "(ବିପ୍ରଲବ୍ଧା)",
          "ସଖୀ ଯିବା ଉଠ ଗୋ ସେ ତ କଲେ ମଠ ଗୋ",
          "ସଙ୍କେତ ସ୍ଥାନକୁ ଆସି ସରିଲା ବିଅର୍ଥେ ନିଶି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଦନେ ନେବା ସଙ୍ଗତେ ସୁଖ ଅରଜନ ଏତେ",
          "ସରୋଜ ନୟନେ ନୀର ସୁହୃଦେ କାମ କାତର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସୁମନଲିଟ ପ୍ରକାର ସ୍ୱଭାବ ବିଟର",
          "ସ୍ୱପନେ ଥିଲି ଜାଣିକି ସତ ଚେତିଲି ଏଣିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୂର୍ଯ୍ୟମଣି ସ୍ୱେହୀ ସନ୍ତାପୁ ଆଜ ଜନ୍ମାଇ",
          "ସେପରି ମୋ ଠାରେ କଲା ସୁରସିକ କେହି ହେଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସିଂହ ଚତୁର୍ଥୀ ଚନ୍ଦ୍ରରୁ ସେ ବଡ଼ ମୋ ଆଜଠାରୁ",
          "ସରାଗେ ଚାହିଁବି ସତ୍ୟ କରୁଅଛି ମୁହିଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସଞ୍ଚାର ହୋଇଲେ ଜନ ସରିବ ମହତ ଘେନ",
          "ସୁଉକ୍ତି ବିପ୍ରଲବ୍ଧାର ସର୍ଜେ ଭଞ୍ଜ ବୀରବର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
