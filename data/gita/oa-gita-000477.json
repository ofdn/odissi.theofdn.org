{
  "id": "oa-gita-000477",
  "name": {
    "en": "Dekha kunja kede sobha",
    "or": "ଦେଖ କୁଞ୍ଜ କେଡ଼େ ଶୋଭା"
  },
  "composer": "oa-person-000035",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-kunja-kede-sobha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନ ଶରଧାରେ ରାଧା ମାଧବ ଉଭା",
          "ଦେଖ କୁଞ୍ଜ କେଡ଼େ ଶୋଭା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳାଘନ କୋଳେ ଖେଳା କରେ ଲୋଳା ଚପଳା",
          "ପ୍ରସରୁଛି ଧୀରେ ଧୀରେ ରୁଚିର ପ୍ରଭା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିର୍ମଳ ନୀଳ ଆକାଶ ଆସନରେ ପ୍ରକାଶ",
          "ହାଟକ ଚିଟକ ରେଖା ପରଖେ କିବା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୁଷମା ସରସୀ ନୀରେ ଭାସି ଆସେ ବିଧିରେ",
          "ଲଭି କିବା ପୂର୍ଣ୍ଣ ଶଶୀ ବିସ୍ତାରେ ଆଭା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିମଳ କୋମଳ କାନ୍ତି ସେ ଯୁଗଳ ମୂରତି",
          "ପାଶେ ଥାଉ ବନ୍ଧୁ ମତି ରଜନୀ ଦିବା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
