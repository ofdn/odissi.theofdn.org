{
  "id": "oa-gita-000497",
  "name": {
    "en": "Sehi na naba nabina kalia suna",
    "or": "ସେହି ନା ନବନବୀନା କାଳିଆ ସୁନା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sehi-na-naba-nabina-kalia-suna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେହି ନା ନବନବୀନା କାଳିଆ ସୁନା",
          "ଯମୁନା ତଟେ ତୁ ଅନା ଉଭା ସେ କି ନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଉଳା ତମାଳ ସରି ଦିଶିଯାଏ ଶ୍ୟାମ ଶିରୀ",
          "ନାହିଁ ତା ବଦନ ଝଳି ତୋ ଲାଗି ସିନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅନୁସରି ତୋରେ ଗୋରୀ ନୟନୁ ନିଦ ପାଶୋରି",
          "ଉଜାଗରେ ପଡ଼େ ଢଳି ବରଜ କହ୍ନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏବେ ହେଲେ ନ ଚାହିଁଲୁ କରମଣି ଦୂର କଲୁ",
          "କି ଯଶ ତୁ ଅରଜିଲୁ କହ ନବୀନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମାନ ସାନ କୁହା ଧନୀ ମୋହନେ ନୁହ ମାନିନୀ",
          "ଝରାଇ ନୟନୁ ପାଣି ଝୁରି ବସନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sehi-na-naba-nabina-kalia-suna/"
    }
  ],
