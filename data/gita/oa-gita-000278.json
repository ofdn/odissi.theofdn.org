  "name": {
    "en": "Kahinki una hela karuna",
    "or": "କାହିଁକି ଊଣା ହେଲା କରୁଣା"
  },
  "composer": "oa-person-000029",
  "mula_raga": [
    "oa-raga-000085"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinki-una-hela-karuna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ଊଣା ହେଲା କରୁଣା",
          "ମୋ ଠାରୁ ରେ ସଜନୀ ନବୀନାର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାର କରି ମାନସେ । ତାର ପୀରତିରସେ ।",
          "ମଜ୍ଜି ଅତି ହରଷେ ବସିଲା ଯାଇ ପାଶେ ।",
          "(ପଡ଼ି)",
          "ଚାହିଁଲା ନାହିଁ ଧନ କରି ବିରସ ମନ",
          "ଶୁଖାଇ ହରଷ ତେଜି ସେ ଚନ୍ଦ୍ରବଦନ",
          "ମହୀକି ଦେଇ ନୟନ ବସିଲା କରି ଗୁମାନ",
          "କହନ୍ତେ ଚାଟୁବଚନ ନ କହିଲା ସୁବଚନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଥିଲି ତା ଛାଇ ପରି । ପାଶରେ ଅନୁସରି ।",
          "ନାହିଁ ମୁଁ ଦୋଷ କରି କିସ ଅବା ବିଚାରି ।",
          "(ପଡ଼ି)",
          "ଚାହିଁଲା ନାହିଁ ଧନ କରି ବିରସ ମନ",
          "ଶୁଖାଇ ହରଷ ତେଜି ସେ ଚନ୍ଦ୍ରବଦନ",
          "ମହୀକି ଦେଇ ନୟନ ବସିଲା କରି ଗୁମାନ",
          "କହନ୍ତେ ଚାଟୁବଚନ ନ କହିଲା ସୁବଚନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନ କର ତୁ ବାରଣ । ରଖ ମୋରେ ଶରଣ ।",
          "ମୁଁ ହୋଇବି କାରଣ ବୋଲି ଧରୁଁ ଚରଣ ।",
          "(ପଡ଼ି)",
          "ଚାହିଁଲା ନାହିଁ ଧନ କରି ବିରସ ମନ",
          "ଶୁଖାଇ ହରଷ ତେଜି ସେ ଚନ୍ଦ୍ରବଦନ",
          "ମହୀକି ଦେଇ ନୟନ ବସିଲା କରି ଗୁମାନ",
          "କହନ୍ତେ ଚାଟୁବଚନ ନ କହିଲା ସୁବଚନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାମଚନ୍ଦ୍ର ଦେଓ ଭାଷେ । ଶ୍ୟାମ ବାଣୀ ପ୍ରକାଶେ ।",
          "ମଦନ ଦରବେଶେ ନେଉଛନ୍ତି ବିରସେ ।",
          "(ପଡ଼ି)",
          "ଚାହିଁଲା ନାହିଁ ଧନ କରି ବିରସ ମନ",
          "ଶୁଖାଇ ହରଷ ତେଜି ସେ ଚନ୍ଦ୍ରବଦନ",
          "ମହୀକି ଦେଇ ନୟନ ବସିଲା କରି ଗୁମାନ",
          "କହନ୍ତେ ଚାଟୁବଚନ ନ କହିଲା ସୁବଚନ"
        ]
      }
    ]
  },
