{
  "id": "oa-gita-001185",
  "name": {
    "en": "Aha ki hela daruna bihi",
    "or": "ଆହା କି ହେଲା ଦାରୁଣ ବିହି"
  },
  "composer": "oa-person-000043",
  "mula_raga": [
    "oa-raga-000163"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-ki-hela-daruna-bihi-kanadagouda-dinabandhuraja-harichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା କି ହେଲା ଦାରୁଣ ବିହି ବିଚ୍ଛେଦ ବିହିଲାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଦେଶେ ଯାଉଛି ଧନ ବୋଲନ୍ତେ ମୋର ଜୀବନ",
          "ସେ କାଳେ କିମ୍ପା ବାହାର ନୋହିଲାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରୀତି କରି କିମ୍ପା କଲା ତହିଁ ବିଚ୍ଛେଦ ରଖିଲା",
          "ବିଚ୍ଛେଦରେ ପୁଣି ପ୍ରାଣ ଦହିଲାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାହିଁ ସଖୀ ପରିତ୍ରାଣ ଜନ୍ମ କାଳୁ ଏ ପ୍ରାଣ",
          "ୟେବେ ବେନି ଭାଗ ହୋଇ ରହିଲାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପ୍ରୀତି ନୋହିଥିବ ସୁଖ ହୋଇ ଭାଜିଯିବା ଦୁଃଖ",
          "ଏଣୁ ସେ ବିହି ମୂରୁଖ ବିହିଲାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେ ବାଣୀ ଶୁଣି ତ୍ୱରିତ ହେଲା ଦୁଃଖ ବଜ୍ରଘାତ",
          "ମୋ ମନ ଅଭାଗ୍ୟ ମୋତେ ମୋହିଲାରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦୀନବନ୍ଧୁରାଜ କହି ପ୍ରବୋଧନ୍ତେ ପ୍ରାଣସହୀ",
          "ମାନସ ତାହାର ସ୍ଥିର ନୋହିଲାରେ"
        ]
      }
    ]
  },
  "sources": [
