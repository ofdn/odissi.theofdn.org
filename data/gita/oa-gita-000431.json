  "name": {
    "en": "Sari gali laje sajani",
    "or": "ସରିଗଲି ଲାଜେ ସଜନୀ",
    "alternates": [
      "Sarigali Laje Sajani"
    ]
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sari-gali-laje-sajani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରିଗଲି ଲାଜେ ସଜନୀ",
          "ସଜାଡ଼ି କୁସୁମ ଶେଯ ଜଗି ସାରା ରଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଣ୍ଟ ଦେଇ ବେଣୁଧର",
          "ରହିଲେ ଗୋ କାହା ପୁର",
          "ଚାହିଁ ବସିଥିଲି ପଥ ସାଜି ତନୁ ନ ଜାଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶଶୀ ଆସି ଗଲା ଫେରି",
          "ମଳୟ ହେଲା ଭଗାରି",
          "ନୟନୁ ଯମୁନା ବାରି ବହିଲା ଗୋ ଉଜାଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ୟାମ ସୋହାଗିନୀ ବୋଲି",
          "ବରଜେ ଯା ଶୁଣିଥିଲି",
          "ମନର ଗରବ ମୋର ମନ ତଳେ ମଲାଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଚନ୍ଦ୍ର କହେ ରାଇ",
          "ଭାବର ନାଗର ସେହି",
          "ବିରହ ବିନା ମିଳନ ସୁଖ କି ରାଇମଣି"
        ]
      }
    ]
  },
  "note": {
    "en": "Sarigali Laje Sajani"
  },
