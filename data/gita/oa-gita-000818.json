  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nisithe-asi-swapane-debakiri-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନିଶୀଥେ ଆସି ସ୍ୱପନେ ଭୁଲା କଥାକେ",
          "କହିଲା ଗୋ କାନେ କାନେ",
          "ପରଶେ ମଉଳା ଫୁଲଝରା ଚେତି ଚାହିଁଲା କି",
          "ଥରିଲା ତନୁ ସାରା ଶରମେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଳପ ହସି ହସି କେ ପରଦେଶୀ",
          "ଅଳସ ନୟନ ମୋର ମେଲି ଦେଲା ରସି",
          "ନିଶି ଶେଷେ ନିଦହରା ମଳୟ ସେ",
          "ଘାରେ ମରମେ"
        ]
      }
    ]
  },
  "sources": [
