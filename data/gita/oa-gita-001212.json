{
  "id": "oa-gita-001212",
  "name": {
    "en": "Jaya radha krusna boli jaya",
    "or": "ଜୟ ରାଧା କୃଷ୍ଣ ବୋଲି ଜୟ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaya-radha-krusna-boli-jaya-bilahari-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୟ ରାଧା କୃଷ୍ଣ ବୋଲି ଜୟ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୀର୍ଥ ବ୍ରତ ଭକ୍ତିକ୍ଷୋଦ ନ କରି ହେଲୁ ଉନ୍ମାଦ",
          "ନ କହି ଆଉ ପ୍ରମାଦ ଏଣିକି ହୋଇ ନିର୍ବେଦ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିଭୃତ ନିକୁଞ୍ଜ ଶେଯେ ବିଜେ କରିଛନ୍ତି ସେ ଯେ",
          "ପାଶରେ ଆଳୀ ସମାଜେ ମିଳିବୁ ଶ୍ରୀମୁହେ ପଦାମ୍ବୁଜେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆହା ସେ କି ଚମତ୍କାର ପ୍ରହେଳୀ ପ୍ରସନ୍ନୋତ୍ତର",
          "କୁହାକୁହି ହୋଇବାର ହସି ହସି ଧୀର ଧୀର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାସାବସାନେ କିଶୋରୀ ପ୍ରିୟ ହୃଦେ ଅପସରି",
          "ଉଭା ହେବାର ମାଧୁରୀ ରୂପ ସୁମରି ସୁମରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବେନି ପାଖରେ ଚାମର ବ୍ୟଜନ ଧରି ସତ୍ୱର",
          "ଆଳୀ ପକାଉଥିବାର ଭାବି ଭାବି ନିରନ୍ତର"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ମଧୁପାନେ ମତ୍ତ ହୋଇ ବର୍ଣ୍ଣଲୁପ୍ତ ଗୀତ ଗାଇ",
          "ଗଣ୍ଡ ପାଶେ ଗଣ୍ଡ ଦେଇ ରହିବା ଶ୍ରୀମୂର୍ତ୍ତି ଥାଇ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଆସି ଆସି ମଥା ପୋଥି ଉଭା ହେବାର ଝଟତି",
          "ଲୁଚିବାର ଲଭି ଭୀତି ସେ ସୁଷମା ଚିନ୍ତି ଚିନ୍ତି"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷିତ ଯାଅ ତୁ ମନ ସନ୍ତତ",
          "ହୁଅ ଶ୍ରୀ ଲଳିତାଶ୍ରିତ ପୂର୍ଣ୍ଣଚନ୍ଦ୍ର ଅଭିମତ"
        ]
      }
    ]
  },
  "sources": [
