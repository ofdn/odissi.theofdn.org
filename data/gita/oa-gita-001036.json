  "id": "oa-gita-001036",
  "name": {
    "en": "Sahi ke ki mohilaki",
    "or": "ସହି କେ କି ମୋହିଲାକି"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000103"
  ],
  "mula_tala": [
    "oa-tala-000001"
