  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahi-ke-ki-mohilaki-regupta-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହି କେ କି ମୋହିଲାକି ପ୍ରାଣନାଥଙ୍କୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋହିଲାକି କହିଲାକି",
          "ରହିଲେକି କାହିଁକି କି ବିହି ସେକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାମନାରେ କା ମନାରେ",
          "ବାମ ହେଲେ ଶ୍ୟାମ ଭଲେ ପ୍ରେମ କଲେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆନ ଦେଲେ ଆନ କଲେ",
          "ଭିନ୍ନ ହେଲେ ସେ ନଇଲେ ଦିନ ନେଲେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାଧାକୃଷ୍ଣ ରାଧାକୃଷ୍ଣ",
          "ସୁଧ୍ୟାନରେ ସୁଧା ନରେ ବାଧା ହରେ"
        ]
      }
    ]
  },
  "sources": [
