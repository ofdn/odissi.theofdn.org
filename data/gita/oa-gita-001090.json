{
  "id": "oa-gita-001090",
  "name": {
    "en": "Galani ta gala katha",
    "or": "ଗଲାଣି ତ ଗଲା କଥା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ga Patala",
      "or": "ଗ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/galani-ta-gala-katha-champu-kabisurjya-paraja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗଲାଣି ତ ଗଲା କଥା ରେ ସଙ୍ଗାତ",
          "ଗଲାଣି ତ ଗଲା କଥା",
          "ଗୁପତେ ସିନା ମୁଁ ତୋତେ ପଚାରିଲି",
          "ବଳି ପଡ଼ିବାରୁ ବ୍ୟଥା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗଙ୍ଗାରୁ ବିଷଦ ଗଭୀର ତୋ ହୃଦ",
          "ଗଣ୍ଠି ଧନ ତୋର ସ୍ନେହ",
          "ଗୋଡ଼ ଖସି ଖେଦ ହେବାର ଦରଦ",
          "ଯିବାର ଉପାୟ କହ ॥୧॥"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗଞ୍ଜାଇକି ଜିଣି ଲାଗି ତାର ପୁଣି",
          "ରଞ୍ଜାଇଲା ମନେ ଝଳି",
          "ଗୋଳା ଗରଳରୁ କଟୁ ପୀୟୂଷରୁ",
          "ସ୍ୱାଦୁ ଗୁଣ ଗଲା ବଳି ॥୨॥"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋଳି ଦେଲା ମୋର ବାହାର ଭିତର",
          "ସ୍ୱର ସେ ଅବା ଶର ସେ",
          "ଗାତ୍ର ଗୋଟିଯାକ ପୁରିଲା ପୁଲକ",
          "ଶ୍ରବଣ ସୀମା ସ୍ପରଶେ ॥୩॥"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗିଳିଦେଲା ପୁରନ୍ଦର ନୀଳକର",
          "କଳିକାମୟ ତିମିର",
          "ଗହନ କି ଗୃହ ହୋଇଲା ସନ୍ଦେହ",
          "ନିଶ୍ଚୟ ହୋଇ ଭିଦୂର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗତାଳସ ନାଟପଟୁ ଖଞ୍ଜରୀଟ",
          "ପରି କି ଆସିଲା ଉଡ଼ି",
          "ଗଣ୍ଡି ଗର୍ଭେ ଗୁଳି ଗଲା ପରି ଗଳି",
          "ବିବେକ ଦେଲା ଘଉଡ଼ି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗଗନ କୁସୁମ ପରି ଏଥି ଶ୍ରମ",
          "ଫଳ ହୋଇବ କି କାଳେ",
          "ଗୋଳିଆ ନ ରଖି କହ ଚନ୍ଦ୍ରମୁଖୀ",
          "ଗହଳି ନ ଥିବା ବେଳେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଗରିଷ୍ଠ ଅରୁଚି କାହିଁକି କରୁଛି",
          "ଅଶନେ ବସନେ ଦେହେ",
          "ଗୁରୁଜନ ତତି ଜାଣିଲେ କି ଗତି",
          "ଅଷ୍ଟଦୁର୍ଗ ପତି କହେ"
        ]
      }
    ]
  },
  "sources": [
