{
  "id": "oa-gita-000044",
  "name": {
    "en": "Chahan re sangini keli nipa taru mulaku",
    "or": "ଚାହାଁରେ ସଙ୍ଗିନୀ କେଳି ନୀପ ତରୁ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000025"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-re-sangini-keli-nipa-taru-mulaku-punnaga-baradi-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁରେ ସଙ୍ଗିନୀ କେଳି ନୀପ ତରୁ ମୂଳକୁ",
          "ସେ ମନୋହର ମୂରତି ଶୋଭା ବାଙ୍କଚୂଳକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭାଲେ ଶୋହେ ଗୋରଚନା କସ୍ତୁରୀ ଚିତା ରଚନା",
          "ଦେଖି କେବଣ ଅଙ୍ଗନା ନ ତେଜିବ କୁଳକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କର୍ଣ୍ଣେ ରତନ କୁଣ୍ଡଳ ଖେଳା କରେ ଗଣ୍ଡସ୍ଥଳ",
          "ଚାହାଁ ଥରେ ଝଲମଲ ନାସା ମୋତିଫଳକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୃଷ୍ଠଦେଶେ ଶୋହେ ବେଣୀ ଗଳେ ରତ୍ନହାର ପୁଣି",
          "କଟୀ ଦେଶରେ କିଙ୍କିଣୀ ଶୁଭେ ତରୁତଳକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀପଦେ ନୂପୁର ଧ୍ୱନି ନାଦେ ମୋହୁଛି ମେଦିନୀ",
          "କରେ ମୋହନ ମୁରଲୀ ଦିଶେ କି ମଞ୍ଜୁଳକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରଙ୍ଗିମା ଅଧରେ ହାସ ବାଙ୍କ ଚାହାଣୀ ପ୍ରକାଶ",
          "ବୋଲେ ବେଣୁଧର ସେ ତ ଚନ୍ଦ୍ରମା ଗୋକୁଳକୁ"
        ]
      }
    ]
  },
  "sources": [
