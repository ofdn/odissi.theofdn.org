{
  "id": "oa-gita-000195",
  "name": {
    "en": "Nata nagara he e riti kahun sikhila",
    "or": "ନଟନାଗର ହେ ଏ ରୀତି କାହୁଁ ଶିଖିଲ"
  },
  "composer": "oa-person-000023",
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nata-nagara-he-e-riti-kahun-sikhila/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନଟନାଗର ହେ",
          "ଏ ରୀତି କାହୁଁ ଶିଖିଲ",
          "ଚନ୍ଦ୍ର କୁମୁଦ ପରାୟେ ପ୍ରୀତି କରି",
          "ବେଳକୁ ଭାସ୍କର ହେଲ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜଣାଗଲା ତୁମ୍ଭ ପ୍ରୀତି କରିବାର",
          "ଆହେ ରସିକ ନାଗର",
          "ଶ୍ରୀକରେ ଲଗାଇ ପୀରତି ଲତାକୁ",
          "ମୂଲରୁ ଯା କାଟିଦେଲ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜଣା ନଥିଲା ତ ଏପରି କରିବ",
          "ବୋଲି ହେ ନାଗରବର",
          "ଅମ୍ବୁଜ ଅଧରୁ ସୁଧା ଚଖାଇଣ",
          "କଲ କୁଳିଶ ପ୍ରହାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାଗରୀମାନଙ୍କୁ ପ୍ରୀତିରେ ଭୁଲାଇ",
          "ନୀର୍ତ୍ତିଚନ୍ଦ୍ର ବୋଲାଇଲ",
          "ଦ୍ୱିତୀୟା ନିଶି ପରାୟେ ଉଦେ ହୋଇ",
          "ପ୍ରତିପ ନିଶି ଯା ହେଲ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଉପଇନ୍ଦ୍ର ଭଣି ଶୁଣରେ ରମଣି",
          "ନ କର ମୋରେ ନିରାଶ",
          "ନାନା ପୁଷ୍ପେ ଚୁମ୍ବେ ଭ୍ରମର ଯେସନେ",
          "ମୁହିଁ ତ ଅଟେ ପୁରୁଷ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nata-nagara-he-e-riti-kahun-sikhila/"
    }
  ],
