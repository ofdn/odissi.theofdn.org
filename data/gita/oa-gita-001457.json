{
  "id": "oa-gita-001457",
  "name": {
    "en": "Manima he etiki maguni mora",
    "or": "ମଣିମା ହେ ଏତିକି ମାଗୁଣି ମୋର"
  },
  "composer": "oa-person-000026",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manima-he-etiki-maguni-mora/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଣିମା ହେ ଏତିକି ମାଗୁଣି ମୋର ।",
          "ମରଣ କାଳରେ ଦରଶନ ଦେବ",
          "କଳାମୁଖ କଳାକର ।ପଦ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଥାରେ ଥିବ ମୋ ତୁମ୍ଭ ଛଡ଼ାମାଳ",
          "ମୁଖରେ ଥିବ ତୁଳସୀ ।",
          "ମନେ ମନେ ଭାଳି ସୁଖୀ ହେଉଥିବି",
          "ନୀଳାଦ୍ରି ଶିଖରବାସୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମହାବାହୁଟେକା ଶ୍ୱେତପଦ୍ମ ଚକା",
          "ନୟନକୁ ନିତି ଚାହିଁ ।",
          "ମଜ୍ଜାରେ ପୁଲକ ପୂରୁଥାଉ ରଙ୍କ",
          "-ନିଧି ଦୁଃଖିଜନ ସାଇଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଙ୍ଗଳ ଆଳତୀ ଅବକାଶ କାଳେ",
          "ଗରୁଡ଼ ପଛରେ ଥାଇ ।",
          "ମୋହି ହେଉଥିବି ପ୍ରତି ନିଶାନ୍ତରେ",
          "ତୁମ୍ଭ ଗୁଣ ଗାଥା ଗାଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମଞ୍ଜୁଳ ବଡ଼ସିଂହାର ବେଶ ଦେଖି",
          "ମାରୁଥିବି କକ୍ଷତାଳି ।",
          "ମରୁଆ ଦୟଣା ମାଳିଆଙ୍କୁ ଏତେ",
          "ଅଳି କରେ ବନମାଳୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manima-he-etiki-maguni-mora/"
    }
  ],
