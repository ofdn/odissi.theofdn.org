{
  "id": "oa-gita-000302",
  "name": {
    "en": "Sakhi re syama bandhunku chahin",
    "or": "ସଖୀ ରେ ଶ୍ୟାମବନ୍ଧୁଙ୍କୁ ଚାହିଁ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000038"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-re-syama-bandhunku-chahin/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ରେ ଶ୍ୟାମବନ୍ଧୁଙ୍କୁ ଚାହିଁ",
          "ଯୁବା ନାରୀ ଦମ୍ଭ ରଖିବେ କାହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତା ଯେଉଁ ଚାହାଣୀ ନୟନ ଠାର",
          "ସେ କି ମାର ଶାଣଦିଆ କୁଠାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତାର ଯେଉଁ ମନ୍ଦହାସ ଚାତୁରୀ",
          "କୁଳବତୀ ଧୈର୍ଯ୍ୟକଟା କତୁରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆହା ତାହାର ଯେ ମୋହନ ବେଶ",
          "ମୋତେ ତ କରଇ ଭାବେ ଆବେଶ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୋଲେ ବନମାଳୀ ଆଗୋ ରାଧିକେ",
          "ତୁମ୍ଭେ ସିନା ଶ୍ୟାମ ପ୍ରେମାରାଧିକେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
