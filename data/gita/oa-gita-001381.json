{
  "id": "oa-gita-001381",
  "name": {
    "en": "Kansa kataka re hari",
    "or": "କଂସ କଟକରେ ହରି ରେ, ରମଣୀମଣିପ୍ରିୟାକୁ ଲେଖନ୍ତି ପ୍ରିୟବାଣୀ । ୧ । ମୁଁ ତୋହର କିଣା ଜନରେ, ରମଣୀମଣିନ ଘେନି ମୁଁ ମନେ ଧନ ଆନରେ । ୨ । ଖଳ ବିହି ବଶୁଁ ଆସିରେ, ରମଣୀମଣିତୋତେ ଛାଡ଼ି ହେଲି ପରବାସୀ । ୩ । ଶିବ ସେବିବି କେତେ ରେ, ରମଣୀମଣିଚଞ୍ଚଳାକ୍ଷୀ ଲଭିଥିଲି ତୋତେ । ୪ । ତୁ ମୋର ନେତ୍ର ପିତ୍ତୁଳାରେ, ରମଣୀମଣିବନ୍ଧୁ ମୋତେ ନ କରିବୁ ହେଳା । ୫ […]"
  },
  "composer": "oa-person-000043",
  "mula_raga": [
    "oa-raga-000158"
  ],
  "mula_tala": [
    "oa-tala-000018"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kansa-kataka-re-hari/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "କଂସ କଟକରେ ହରି ରେ, ରମଣୀମଣି",
          "ପ୍ରିୟାକୁ ଲେଖନ୍ତି ପ୍ରିୟବାଣୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁଁ ତୋହର କିଣା ଜନରେ, ରମଣୀମଣି",
          "ନ ଘେନି ମୁଁ ମନେ ଧନ ଆନରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖଳ ବିହି ବଶୁଁ ଆସିରେ, ରମଣୀମଣି",
          "ତୋତେ ଛାଡ଼ି ହେଲି ପରବାସୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶିବ ସେବିବି କେତେ ରେ, ରମଣୀମଣି",
          "ଚଞ୍ଚଳାକ୍ଷୀ ଲଭିଥିଲି ତୋତେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତୁ ମୋର ନେତ୍ର ପିତ୍ତୁଳାରେ, ରମଣୀମଣି",
          "ବନ୍ଧୁ ମୋତେ ନ କରିବୁ ହେଳା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶୁଣି ରାଧା ବେନୁପାଣି ରେ, ରମଣୀମଣି",
          "ଦୀନବନ୍ଧୁ ରାଜ ରସ ଭଣି"
        ]
      }
    ]
  },
