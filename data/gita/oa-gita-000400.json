  "name": {
    "en": "Tha thika mukhi mo prana sakhi",
    "or": "ଠା ଠିକ ମୁଖୀ ମୋ ପ୍ରାଣସଖୀ"
  },
  "composer": "oa-person-000043",
  "mula_raga": [
    "oa-raga-000110"
  ],
  "mula_tala": [
    "oa-tala-000009"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tha-thika-mukhi-mo-prana-sakhi/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଠା ଠିକ ମୁଖୀ ମୋ ପ୍ରାଣସଖୀ",
          "ଠକ କାମଶରେ ହେବ ଦୁଃଖୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଠେସା ବିହିଦେଲା ଦଗା ଏହି",
          "ଠୁକୁଥିବ ବସି କରେ ମହୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଠିଆ ହେବା ତା ଆସିବା ଯିବା",
          "ଠିକ କରିବ ତା କେହୁ ଅବା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଠଣହାସୀ ହେଲା ଏତେ ଦୂର",
          "ଠେକେ କରିଥିଲା ଗତି ମୋର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଠୂଳ ଚିନ୍ତାଭର ବେନୁପାଣି",
          "ଠିକେ ଦୀନବନ୍ଧୁ ରାଜ ଭଣି"
        ]
      }
    ]
  },
  "sources": [
