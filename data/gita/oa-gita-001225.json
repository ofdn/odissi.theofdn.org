{
  "id": "oa-gita-001225",
  "name": {
    "en": "Braja kisora ke seti heja",
    "or": "ବ୍ରଜ କିଶୋର କେ ସେଟି ହେଜ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/braja-kisora-ke-seti-heja-mukhari-gopalakrusna-prataparudra-deba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବ୍ରଜ କିଶୋର କେ ସେଟି ହେଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସର୍ବଲୋକର ସେବାରେ ସାର",
          "ଯା ମୂର୍ତ୍ତି ବେଦାନ୍ତ ଶିରେ ଅଗୋଚର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରହ୍ମ ନୈଷ୍ଠିକ ଯୋଗୀମାନଙ୍କ",
          "ହୃଦରେ ଦୁର୍ଲ୍ଲଭ ସ୍ଫୁର୍ତ୍ତି ଲବ ଯାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋପ ପ୍ରମଦା ପଦାବ୍ଜେ ସଦା",
          "ସୁଲଭ ସେ ଶିଖୀଶିଖଣ୍ଡ ଶେଖର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରନ୍ତୁ ତୁର୍ଣ୍ଣ ଅଭୀଷ୍ଟ ପୂର୍ଣ୍ଣ",
          "ସେ ଅଛିଦ୍ର ବ୍ରହ୍ମ ବିଗ୍ରହ ଆମ୍ଭର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପ୍ରତାପରୁଦ୍ର ଦେବ ନରେନ୍ଦ୍ର",
          "ସେବିଲେ ସେ ଗୋପୀ ଗୋବିନ୍ଦ"
        ]
      }
    ]
  },
  "sources": [
    {
