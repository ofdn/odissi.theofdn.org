{
  "id": "oa-gita-001201",
  "name": {
    "en": "Nabaghana syama he",
    "or": "ନବଘନ ଶ୍ୟାମ ହେ"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nabaghana-syama-he-brajanatha-badajena/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବଘନ ଶ୍ୟାମ ହେ ଶତ କାମଜିତ ଅଭିରାମ",
          "ଗୋପପୁର କୁଳ ପାଳିବା କୁଳ ମୋହ ମାଦକ ଧାମ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳିତ କଳରବ ମଧୁର ମଞ୍ଜୁଳ",
          "ଲଳିତ ବେଣୁ ବିଳାସ ଚଞ୍ଚଳ",
          "ଦଳିତ କାଳୀୟ ସର୍ପ ଦର୍ପକ",
          "ଦୁଷ୍ଟ ଦାନବ କାଳ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଞ୍ଜ କାନନ କେଳି କୌତୁକ",
          "କୌତୁକୀ ସୁର ନିକର ନାୟକ",
          "ଗର୍ବଗଞ୍ଜନ ସର୍ବରଞ୍ଜନ",
          "ଗୋପ ଭୂପତି ବାଳ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲପନ ଛବି ଜିତ ଚନ୍ଦ୍ରମଣ୍ଡଳ",
          "ତପନ ଦୀପନ କର୍ଣ୍ଣ କୁଣ୍ଡଳ",
          "ବିପିନ ଚାରଣ ଚରଣ ରୁଣଝୁଣ",
          "ହେମ ନୂପୁର ନାଦ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିବୁଧବରବର ଦୁଷ୍ଟଦାରଣ",
          "ଗୋପ ଗୋକୁଳ କଷ୍ଟ ହାରଣ",
          "ପ୍ରଳୟ ପାଳନ ସୃଷ୍ଟି କାରଣ",
          "ଦେବ ଚିନ୍ତିତ ପାଦ ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭକ୍ତବତ୍ସଳ ଦୀନବାନ୍ଧବ",
          "ମୁକ୍ତିଦାୟକ ରାଧିକାଧବ",
          "ଦେବ ବନ୍ଦିତ ହେ ଦୟାମୟ",
          "ଖେଦ ଖଣ୍ଡନ ନାଥ ହେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କେଶୀ ଅଘ ବକ ଶକଟ ସଙ୍କଟ",
          "ନାଶୀ ତବ ପଦପଦ୍ମ ମଧୁଲିଟ",
          "ଦୀନବର ବ୍ରଜନାଥ ବୋଲେ ଦର",
          "ଦୂର କର ଦର ହାଥ ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
