    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସନ୍ତତରେ ମନ ଭଜ ଶ୍ରୀ ପୀତବାସ",
          "ସଂସାରେ ଲଭିବୁ ଯଶ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସରସ୍ୱତୀ ବୀଣା ଧରି",
          "ସଙ୍ଗୀତ ଗୀତ ଉଚ୍ଚାରି",
          "ସଙ୍ଗେ ଭକ୍ତଜନ ଘେରି",
          "ସେ ଚଉପାଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସସ୍ରଯୋନି ସଦାଶିବ",
          "ସେବାରେ ଛନ୍ତି ସେ ଠାବ",
          "ଶରଧାରେ ଭଜ ମନ",
          "ସଂସାର ସାର ରସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶଙ୍ଖ ଚକ୍ର ଗଦାଧର",
          "ସରଳ ବିମ୍ବ ଅଧର",
          "ସତେ କି ସୁନ୍ଦର ଧୀର",
          "ଶ୍ୟାମଳ ବେଶ"
        ]
      }
    ]
  },
