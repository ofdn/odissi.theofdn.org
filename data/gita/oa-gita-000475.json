{
  "id": "oa-gita-000475",
  "name": {
    "en": "Jhulibe ta aja kunje",
    "or": "ଝୁଲିବେ ତ ଆଜ କୁଞ୍ଜେ"
  },
  "composer": "oa-person-000105",
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jhulibe-ta-aja-kunje/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଝୁଲିବେ ତ ଆଜ କୁଞ୍ଜେ ବରଜରାଜ",
          "ଭୁଲି ନ ଯିବ କେ ଚାହିଁ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶୁକ ଶାରୀ କପୋତ ମୟୂର ପାରାବତ",
          "ରଟିବେ ଚିତ୍ତ ରସାଇ ଗୋ",
          "କେ ଦେଇ ହୁଳହୁଳି ବ୍ରଜ ବାଳିକା ଦୋଳି",
          "ଦେଉଥିବେ ଦୋହଲାଇ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଣ ନର ଯୁବତୀ କୁଳବତୀଏ ଛାତି",
          "ପଥରେ ଥିଲେ ବନ୍ଧାଇ ଗୋ",
          "ସେ ନଟବର ବେଶ ସତୀ ଧଇର୍ଯ୍ୟ ଧ୍ୱଂସ",
          "ନୋହିବ କେ ଅବା ଅନାଇଁ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସକଳ ଜନ ମିଳି ହା କୃଷ୍ଣ ବନମାଳୀ",
          "ବୋଲି ଉତ୍ସୁକେ ଗୀତ ଗାଇ ଗୋ",
          "ନାଚୁଥିବେ ଆନନ୍ଦ ହୋଇ ଭକତବୃନ୍ଦ",
          "ତାଳ କଂସାଳ ବଜାଇ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶିଖଣ୍ଡଚୂଳ ସଖୀ ଚାଲ ଗୋ ଯିବା ଦେଖି",
          "ଶ୍ରୀମୁଖ ରଜନୀ ରସାଇ ଗୋ",
          "କହଇ ଦ୍ୱିଜ ପୀତବାସ ରହୁ ମୋ ଚିତ୍ତ",
          "ସେ ଯୁଗଳ ଚରଣ ଧ୍ୟାଇ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jhulibe-ta-aja-kunje/"
    }
  ],
