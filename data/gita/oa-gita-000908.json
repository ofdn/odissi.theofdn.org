  "name": {
    "en": "Kalindi tirare bansi",
    "or": "କାଳିନ୍ଦୀ ତୀରରେ ବଂଶୀ"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000016"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kalindi-tirare-bansi-anandabhairabi-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାଳିନ୍ଦୀ ତୀରରେ ବଂଶୀ",
          "ବାଜି ମୋହି ଦେଉଅଛି ଜଙ୍ଗମରାଶି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏହିଟି ସ୍ଥୈର୍ଯ୍ୟ ସର୍ପର ଅନ୍ତ",
          "କରିବାକୁ ଅଟେ ବିହଗେଶ୍ୱର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲଜ୍ଜାରୋଗ ବୃନ୍ଦ ନାଶ କରିବାକୁ",
          "ଏହି ଧନ୍ୱନ୍ତରୀ ସଦୃଶ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପତିବ୍ରତା ଗର୍ବତୋୟନିଧି ପାନ",
          "କରିବାକୁ କୁମ୍ଭତନୟ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
