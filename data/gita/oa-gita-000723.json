{
  "id": "oa-gita-000723",
  "name": {
    "en": "Radhe rasika raja",
    "or": "ରାଧେ ରସିକାରାଜ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhe-rasika-raja-sankarabharana-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧେ ରସିକାରାଜ",
          "ତୋ ପ୍ରବୀଣାପଣ ଜଣାଯିବ ଆଜ",
          "ନନ୍ଦର ତନୟ ପୁରନ୍ଦର ମଣି",
          "ମକରନ୍ଦଲିଟ ତୁ ଅରବିନ୍ଦଟି ସୁନ୍ଦର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେବା ଦିନୁ ସ୍ତନ ପୀନ କରକଶ",
          "ମଦଗତେ ବସୁନ୍ଧରା",
          "ମଣ୍ଡଳୀକି ମଣ୍ଡୁ ପରା",
          "ଏବେ ଧରାଧରଧରା କରେ କସ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭିନ୍ନ ସଖୀ ଦେହେ ସ୍ନେହେ ଜଡ଼ିବାର",
          "ଭିନ୍ନ ସେ ଶିଖଣ୍ଡଚୂଳ",
          "ମରକତ ଅରଗଳ",
          "ବଳିଷ୍ଠ ବାହୁ ଯୁଗଳ ଭିଡ଼ିବାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆମ୍ଭେ ସିନା ପ୍ରଭୁ ବୋଲି କରୁ ଭୀତି",
          "ତୁ ଯାହା କଲେ ତା ସହୁ",
          "କ୍ଷମା କରିବେ ସେ କାହୁଁ",
          "ବାମାଗର୍ବ ଚନ୍ଦ୍ର ରାହୁ କଳାହାତୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କି ହେବ ମନ୍ଦିରେ ଭୂରୁ ନଚାଇଲେ",
          "ଯଶ ହେବ ସେହି କାଳେ",
          "ନଟ ମୁକୁଟକୁ କୋଳେ",
          "ନଚାଇ ସେ ରସେ ବଳେ ରୁଚାଇଲେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମୃଦୁ ତନୁ ବୋଲି କେ ଛାଡ଼ିବ ଆଉ",
          "ଅଙ୍କୁ ଯିବା ଯାଏ ଶାନ୍ତ",
          "ହୋଇବ ନାହିଁ ଯେ ଦାନ୍ତ",
          "କରରୁହ ପ୍ରାନ୍ତକୁନ୍ତ ଖେଳା ଦାଉ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବୋଲେ ଅଷ୍ଟଦୁର୍ଗନାଥ ଜଗଦ୍ଦେବ",
          "ସଖି ପରିହାସ ଶୁଣି",
          "ଲାଜେ ହସି ଠାକୁରାଣୀ",
          "ମନେ କଲେ ହେଲେ ପୁଣି ବୁଝାଯିବ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
