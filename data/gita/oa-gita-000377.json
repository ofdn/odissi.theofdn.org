{
  "id": "oa-gita-000377",
  "name": {
    "en": "Kinchite kara sudaya re dayalubara",
    "or": "କିଞ୍ଚିତେ କର ସୁଦୟା ରେ ଦୟାଳୁବର"
  },
  "composer": "oa-person-000074",
  "mula_raga": [
    "oa-raga-000105"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kinchite-kara-sudaya-re-dayalubara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କିଞ୍ଚିତେ କର ସୁଦୟା ରେ ଦୟାଳୁବର",
          "ବରଷ ସୁରସ ଘନ",
          "ଘନ ଚାତକ ଜୀବନ",
          "ବନ ଦେଇ ତୋଷ ମନ",
          "ମନେ ନ କର ନିର୍ଦ୍ଦୟା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବନ୍ଧୁ ବଧୁକ ଅଧରା",
          "ଧରା ଶିର ଜାତି ଝରା",
          "ଝରା ଚାରୁଦନ୍ତୀ ହୀରା",
          "ହୀରାହାସୀ ଯାଏ ମରା",
          "ମରା ନ ଯାଏ ଧରୁଛି କର, କରନା ମାନ",
          "ମାନିନୀରେ ମନୁ ଦୁଃଖ ହର, ହରଷେ ହରି",
          "ହରିମଝା ଆଲିଙ୍ଗନ କର, କର ସମ୍ମାନ",
          "ମାନ ଗିର ତୁହି ନିଜ ଜନ",
          "ଜନ ଅରକ୍ଷ ରକ୍ଷ, ତୁହି ହୋଇ ସାହାପକ୍ଷ",
          "ପକ୍ଷପାତର ତରଜାଅ ଅନ୍ତର ନ କର",
          "କର ପଉରୁଷ ରସ ଶରଣ ନବରଙ୍ଗିଆ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୁ ଦାତା ଛଳି ବଳି",
          "ବଳି ଶରଣ ତ୍ରିବଳି",
          "ବଳି ଶୋଭି ରଚ କେଳି",
          "କେଳି ମତି ମତି ଝଳି",
          "ଝଳି ବେନି ଚିତ୍ତ ଏକ କରି କରୀନ୍ଦ୍ରଗତି",
          "ଗତି ନାହିଁ ଜଗତେ ମୋହର",
          "ହର ନାଶର ଶର ମର୍ମ୍ମେ ଆଞ୍ଚି ବିନ୍ଧେ ମାର",
          "ମାର ମାରଣ ରଣୁ ଜିଣି ନିଅ ରାମାବର, ବରତୁ ବର",
          "ବରଜ ଏ ରୀତିକି ମାତର, ତରକି ବଡ଼",
          "ବଡ଼ ମତି କୁଳିଶ ଯାକରୁ, କରୁଣା କର",
          "କର ନା ଅଭିନ୍ନ ଯଶ ଦୟା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗିରୀଶ ଶିରୀଷ ମୋହି",
          "ମୋହିନୀ ମୋ ମତି ମୋହି",
          "ମୋହି ଚୁମ୍ବପାନ ଦେଇ",
          "ଦେଇ ଭୋଳେ ମଜ୍ଜ ତୁହି",
          "ତୁହି ବିବେକୀ ଏହା ନ କର, କରନା ଆନ",
          "ଆନ ବାରେ ମାନ ସ୍ନେହ ଧନ, ଧନରେ କିଣା",
          "କିଣାଜନେ ଦିଅ ପରିକର, କରଜ ଚାଳି",
          "ଚାଳି ଚନ୍ଦ୍ର ଅଙ୍ଗ ନବବାଳୀ, ବାଳି ତୁ ରସା",
          "ରସା ଯୁବା ଇନ୍ଦ୍ରପଦ ଦେଇ, ଦେଇ ମାତର",
          "ତରଳ ଅପାଙ୍ଗେ ଚାହାଁ ଧୀର",
          "ଧୀର କି ମଣି ମଣି ରମଣୀ ସରସୋଦୟା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୟସୀ ସପତ ନବ",
          "ନବବେଶୀ ମୁଁ ତୋ ଧବ",
          "ଧବ ଅପୌରୁଷ ଭାବ",
          "ଭାବବତୀ କର ଭାବ",
          "ଭାବଭୋଳେ କଳକଣ୍ଠୀ ନାଶ ନାଶ ମୋ ତୃଷା",
          "ତୃଷାଗଣ୍ଡେ ଘରଷ ଗଣ୍ଡ, ଗଣ୍ଡରେ କର",
          "କର ଦେବା ତୋର ସୁନ୍ଦର, ଦରଜ ଘେନା",
          "ଘେନା ବାରେ ସରାଗେ ନବୀନା, ବିନାଶ ଦୁଃଖ",
          "ଦୁଃଖ ଧ୍ୱଂସି ଦିଅ ଏବେ ସୁଖ, ସୁଖରେ ବାଣୀ",
          "ବାଣୀ ନ ଭାଷୁ ମଞ୍ଜୁଳବାଣୀ",
          "ବାଣୀ ମୁଁ କେତେ",
          "କେତେ ଜଣାଇବି ଗୋରୀ ଜିଆ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତୁଙ୍ଗ ଦକ୍ଷିଣରା ଭାଷି",
          "ଭାସିଯାଏ ଘନକେଶୀ",
          "କେଶୀରିପୁସୁତ ନାଶି",
          "ନାଶି ଦେଖୁ ଜୀବ ଆସି",
          "ଆସି ଶୀଘ୍ର ପ୍ରେମେ ଦିଅ ଭେଳା, ଭେଳାରେ ନେଇ",
          "ନେଇ ନାଶ ଏକ ନବଦଶା, ଦଶା ଲୋ ଲସା",
          "ରସାଳସା ତିଳଫୁଲ ନାସା, ନାସା ବରହି",
          "ରହିପାରେ ଲଗା, ଲଗାଅ ପୁଣି",
          "ପୁଣି ନଥଚକ୍ର ମାରି କୋପ, କୋପନା ଶୁଣି",
          "ଶୁଣି ବାଣୀ ଉଠି କୋଳ କଲା",
          "କୋଳେ ସେ କରି, କରୀକୁମ୍ଭସ୍ତନା ବିନୋଦିୟା"
        ]
      }
    ]
  },
