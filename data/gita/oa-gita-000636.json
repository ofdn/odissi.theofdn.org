  "id": "oa-gita-000636",
  "name": {
    "en": "Thile aparadha mora",
    "or": "ଥିଲେ ଅପରାଧ ମୋର"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "kabya": {
    "id": "oa-kabya-000002"
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/thile-aparadha-mora-todi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଥିଲେ ଅପରାଧ ମୋର",
          "ଥରେ କ୍ଷମା ନ କରିବ କି ସେ ରାମାବର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଥଳ କମଳ ବିଜୟୀ ଚରଣେ ମୁଁ ତାର",
          "ଲାକ୍ଷା ଲେଖୁଥିବି ନିତି କଲେ ଅଙ୍ଗୀକାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଥିବି ଖଟି ପାଶେ ତାର ମରଜିକି ଜାଣି",
          "କଲେ ଅନୁକମ୍ପା ମୋରେ ସୁରସିକା ମଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଥାଉ ବା ନ ଥାଉ ମୋହ ଠାରେ ତା କରୁଣା",
          "ମୋ ମନରେ ଭାବିଛି ତ ମୁଁ ତାହାର କିଣା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଥିର ଗମନାକୁ ମୋର ହୃଦୟରେ ହାର",
          "କରିବାକୁ ସହଚରୀ ଉପାୟ ବିଚାର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଥାଏ ଯା ମୋ ଠାରେ ସଖି ଚିତ୍ତେ ଦୟା ତୋର",
          "କହିବାକୁ ଅଛି କିସ ଜଗଦ୍ଦେବଙ୍କର"
        ]
      }
    ]
  },
