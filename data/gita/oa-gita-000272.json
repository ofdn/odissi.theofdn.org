{
  "id": "oa-gita-000272",
  "name": {
    "en": "Rasa manasa radhikesa",
    "or": "ରସ ମାନସ ରାଧିକେଶ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasa-manasa-radhikesa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରସ ମାନସ ରାଧିକେଶ ଯାର ରସ କଥାରେ",
          "ସେବିତ ଶୁକ ସନକ ଶେଷ ଅନିଶ ନତ ମଥାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭ୍ରମନା ଭବ ଭୋଗ ଲୋଭରେ ଲଭି ଧନ ପ୍ରମଦାରେ",
          "ଭବ ସରସିଜଭବ ଦୁର୍ଲ୍ଲଭ ପ୍ରେମ ଭକ୍ତିଦାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଶ୍ୱ ସରଣୀ ଭ୍ରମଣ ତାପ ହାରିଣୀ ବସୁଧାରେ",
          "ସାର୍ବତ୍ରିକ ବହୁଛି ନୁହଇ ସୁରଧୁନୀ ପରିଧାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନୀରଜବନ୍ଧୁ ନନ୍ଦିନୀ ତୀର ନିକୁଞ୍ଜ ବନ ଅଗାରେ",
          "କେଶୀମଥନ କେଳିଚରିତ କେବଳ ତୁହି ଗାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋକ୍ଷପଦକୁ ଲକ୍ଷ୍ୟ ନ କରି ରହିଛୁ ଯା ଅଲଗାରେ",
          "ରାସେଶ୍ୱରୀଙ୍କ କିଙ୍କରୀ ହୋଇ ଘର କର ବ୍ରଜ ଗାଁରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ସତୃଷ୍ଣ ହୋଇ ସୁମନୀଷାରେ",
          "ଦୋଷରହିତ ଘୋଷ ଚରିତ ଘୋଷ ଦିନ ନିଶାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
