{
  "id": "oa-gita-000123",
  "name": {
    "en": "Aha mo khanjanakhi",
    "or": "ଆହା ମୋ ଖଞ୍ଜନାକ୍ଷୀ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-mo-khanjanakhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା ମୋ ଖଞ୍ଜନାକ୍ଷୀ",
          "ଅନଙ୍ଗେ ମୋ ବିନା ଦୁଃଖୀରେ ।",
          "ଅବନୀରେ ଢଳି ପଡ଼ିବାରୁ ତୋଳି",
          "ଧରୁଥିବେ ପ୍ରିୟସଖୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅହର୍ନିଶ ଝୁରି ଝୁରି",
          "ଅତି କୃଶ କୃଶୋଦରୀ",
          "ଇନ୍ଦୁକଳା ତନୁ ତାକୁ ନିନ୍ଦିବନି",
          "ତାର ତାର ତନୁଶିରୀରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଶ୍ରୁଭରେ ନେତ୍ର ବେନି",
          "ଅବିରତେ ପୂରିବନି",
          "ଅସାର ମାର ଅକୂପାରେ ପଡ଼ିଣ",
          "ମୃଦୁହାସୀ ଭାସିବନିରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଭରଣ ଦୂର କରି",
          "କେଉଁ କୁମ୍ଭପୟୋଧରୀ",
          "ଅମଳ ମୃଣାଳ ଖଣ୍ଡ ପାଣି ପିଣ୍ଡେ",
          "ମଣ୍ଡୁଥିବଟି କିପରିରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅବଧିରେ ତେଜି ଆଶା",
          "ଅଧିକରେ ଅଭରସା",
          "ଅତି ଶ୍ୱାସଖର ପଡ଼ୁଥିବ ପରା",
          "ହେବନି ଦଶମ ଦଶାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗେଶ୍ୱର ଭଣି",
          "ଅଭିନବ ରାମାମଣି",
          "ଉମାଧବ କୃପା ସତେ ହେବ ଅବା",
          "ଜୀବ ଯିବା ଯାଏ ପୁଣିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-mo-khanjanakhi/"
    }
  ],
