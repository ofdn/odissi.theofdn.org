{
  "id": "oa-gita-000141",
  "name": {
    "en": "Chahin ki nahi kehi mohana hasa",
    "or": "ଚାହିଁ କି ନାହିଁ କେହି ମୋହନ ହାସ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahin-ki-nahi-kehi-mohana-hasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହିଁ କି ନାହିଁ କେହି ମୋହନ ହାସ ଗୋ",
          "କେହି ତା ମନ୍ଦହାସ",
          "କାହିଁକି ଏକା ମୋତେ ଏ ପରିହାସ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେଉଁ ସତୀ ସେ ପୁଟ",
          "ଭେଦନେ ଅଛି ନଟ",
          "-ବର ସ୍ନେହୁଁ ନିପଟ ହୋଇ ନିରାଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଡାକ ତ ସେ ଯୋଷାକୁ",
          "କହୁ କାହା ନାସାକୁ",
          "ବାଜିନାହିଁ ସେ ବନମାଳିକା ବାସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲୋଡ଼ି ଶ୍ୟାମ ପ୍ରୀତିକି",
          "ଘଟକ ଯୁବତୀକି",
          "କେ କହୁ ନାହିଁ ଧରି ଦଶନେ ଘାସ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୋ ସ୍ନେହୁଁ ନିଶୀଥରେ",
          "ବନଦୁର୍ଗ ପଥରେ",
          "ଗତାଗତରୁ ଥିବ ପଦେ ପରାସ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଡାକୁ ଯାହା ମୁରଲୀ",
          "ସ୍ୱାମୀକି ପେଲି ଠେଲି",
          "ଧାବନବଶେ ଖସେ ନିତମ୍ବ ବାସ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶ୍ରୀ ଜଗଦ୍ଦେବ ଭଣେ",
          "ରାଧାବାଣୀ ଶ୍ରବଣେ",
          "ଆଳୀଏ ହସି ଦେଲେ ଅଙ୍କ ନିବାସ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahin-ki-nahi-kehi-mohana-hasa/"
    }
  ],
