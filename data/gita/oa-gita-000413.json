{
  "id": "oa-gita-000413",
  "name": {
    "en": "Sajani go budi gali mu lajare",
    "or": "ସଜନୀ ଗୋ ବୁଡ଼ିଗଲି ମୁଁ ଲାଜରେ",
    "alternates": [
      "Budigali Mu Lajare"
    ]
  },
  "composer": "oa-person-000075",
  "mula_raga": [
    "oa-raga-000101"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-go-budi-gali-mu-lajare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ଗୋ ବୁଡ଼ିଗଲି ମୁଁ ଲାଜରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଜାଡ଼ୁଥିଲି ବେଣୀ କାହୁଁ ସେ ଆସି ପୁଣି",
          "ମିଳିଲେ ବେଣୁପାଣି ଆଜରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚମକିଗଲା ତନୁ ଦେଖିଣ ନନ୍ଦସୂନୁ",
          "ବୋଇଲେ ଭଲ କରି ସାଜରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବସନ କରେ ଧରି ଉହାଡ଼ କଲି ଡରି",
          "ନୋହିଲି ମୁଁ ଆଉ ସଜରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯେତେ କହିଲେ ସେହି ନ ଶୁଣିଲି ମୁଁ ରହି",
          "ଶୁଣିଲେ ନ ରହନ୍ତା ହେଜରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସୋମନାଥ ନୃପତି ସିଂହ ରସେ ଭାଷନ୍ତି",
          "ପ୍ରୀତି ସିନା କୀରତି ମଜ୍ଜରେ"
        ]
      }
    ]
  },
  "note": {
    "en": "Budigali Mu Lajare"
  },
