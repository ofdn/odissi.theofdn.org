{
  "id": "oa-gita-000997",
  "name": {
    "en": "Sapatati mora re",
    "or": "ସପତଟି ମୋର ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000007"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Sa Patala",
      "or": "ସ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sapatati-mora-re-kabisurjya-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସପତଟି ମୋର ରେ ସହ ଏହି ଥର ରେ",
          "(ପଡ଼ି)",
          "ସାର ହାର ମସାର ମଣିବର",
          "ପରି ଧରି ବକ୍ଷଃସ୍ଥଳେ ନିରନ୍ତର",
          "ନ ଫିଙ୍ଗି ପୁଣି ହଟି ସୁନ୍ଦର ନୁହଇଁଟି",
          "ବିଚାରି ଭରସା ବଢ଼ାଅ ଅପରିମିତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶୁଣିଲେ ଆଉ କେ ବ୍ରଜେ ସରିଯିବି ସିନା ଲାଜେ",
          "ସାହା ତୁ ନୋହିଲେ କିଛି ସଂସରେ ନିକି ମୁଁ ଅଛି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସାଧୁଜନ କୁକ୍ଷି କୂପେ ଭଲ ମନ୍ଦ ସିନା ଛପେ",
          "ସଂହର କ୍ରୋଧ ଉଦୟ ସହଜେ ତୁ ସହୃଦୟ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସବୁ ଅନ୍ୟାୟ ଚରିତ ଶିକ୍ଷାକୁ ଗୁରୁ ତୁହି ତ",
          "ସମୟେ କାଟୁ ତୋଟିକି ସଖା ଲକ୍ଷଣ ଏ ଟିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସମାଂସମୀନା ଅୟୁତେ ସମର୍ପି ଦେବିଟି ତୋତେ",
          "ସମ୍ଭାଳ ମୋର ଆବୁର ସର୍ବସ୍ଵ ପରା ତୁ ମୋର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସାକ୍ଷାତ ଦେଖିଲା ପରି ସାକ୍ଷୀ ହେବାକୁ ବାହାରି",
          "ସାଧିବାର ଅବିଚାର ସପତ୍ନ ନୁହେଁ ମୁ ତୋର"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ସାନ୍ଦୀପନୀ ସୁତ ଯତି ସେ କି ଜାଣେ ବୋଲି ପ୍ରୀତି",
          "ସରସେ ପିଟିବେ ଢକ୍କା ସମ୍ପାଦିବୁ ଏତେ ଏକା"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଶୁଣି କିଶୋର ବଚନ ସଖା କଲେ ଆଲିଙ୍ଗନ",
          "ସୁତ୍ରାମା ଅଷ୍ଟଦୁର୍ଗର ସନ୍ତୋଷେ ଯୋଡ଼ିଲେ କର"
        ]
      }
    ]
  },
