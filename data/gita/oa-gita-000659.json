{
  "id": "oa-gita-000659",
  "name": {
    "en": "Mu rata heli jahinre",
    "or": "ମୁଁ ରତ ହେଲି ଯହିଁରେ"
  },
  "composer": "oa-person-000037",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mu-rata-heli-jahinre/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୁଁ ରତ ହେଲି ଯହିଁରେ ମୋର ତ ନୋହିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯା କୋଳ ସୁଖକୁ ମଣି ଗୁରୁଜନ ମୁଁ ନ ଗଣି",
          "ମୋ ଦୁଃଖ ଶୁଣି ଏବେ ସେ ନିଷ୍ଠୁର ହୋଇଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୁମ୍ଭେ ମୋ କେଡ଼େ ସୁହୃଦ ପ୍ରାଣରୁ ପ୍ରୀତି ଅଭେଦ",
          "ତୁମ୍ଭଙ୍କୁ ଯା ଦେଲି ଖେଦ ଏତିକି ରହିଲା ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଖୀମାନଙ୍କ ଅଭ୍ୟାସ ସହି ନ କଲି ଲାଳସ",
          "ଯେ ଥିଲା କୁଳ ମୁହାଁସ ଏଣିକି ସରିଲା ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯେ ଦେଲା ଦୁଃଖ ଦୁଃସହ ଶୁଣି ତହିଁ ଲାଗେ ସ୍ନେହ",
          "ଧିକ ଏ ପ୍ରାଣକୁ ଦେହ କାହିଁକି ଆଇଲା ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯା ପ୍ରେମ ଉନ୍ମାଦ ରସ ଆଶାରେ ହେଲି ଲାଳସ",
          "ଯା ଲାଗି ମୋର ଉଲ୍ଲାସ ସେ ମୋତେ ଦହିଲା ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ରାମକୃଷ୍ଣ କବିଶଶୀ ଭାଷେ ଶ୍ରୀ କିଶୋରୀ ଭାଷି",
          "ଅସର ସନ୍ତାପ ରାଗୁ ଏ ଦେହ ସହିଲା ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mu-rata-heli-jahinre/"
    }
  ],
