{
  "id": "oa-gita-000514",
  "name": {
    "en": "Anai delu ki radhe",
    "or": "ଅନାଇଁ ଦେଲୁ କି ରାଧେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/anai-delu-ki-radhe/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନାଇଁ ଦେଲୁ କି ରାଧେ",
          "କହ୍ନାଇ ମୂରତି ହୃଦେ ମନାଇଁ ନେଲୁ କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୟାମ ନଟବର ବେଶ ଅପୂର୍ବ କଥନ",
          "ଯେଉଁ ରୂପ କରୁଅଛୁ ଭୁବନ ମୋହନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୋଟିଏ ମଦନ ଯଦି ଗୋଟିଏ ହୋଇବ",
          "କଟି ସରୁଆ ଶୋଭାକୁ ସମ ତ ନୋହିବ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭ୍ରୂଲତା ଯୁଗଳ ତା କନ୍ଦର୍ପ ଶରାସନ",
          "ଚଞ୍ଚଳ ନୟନାଞ୍ଚଳ ଅଲକ୍ଷିତ ବାଣ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାର ପ୍ରତି ଅଙ୍ଗେ ପୂରିଅଛି ଶୋଭାରାଶି",
          "ରମା ଉମା ଶଚୀ ଯାର ପାଦତଳ ଦାସୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସତୀ ମତିଭୁଲା ପରିବରତ ଉଜୁଡ଼ା",
          "ବୋଲେ ବନମାଳୀ କୁଳଛଡ଼ା ଘରବୁଡ଼ା"
        ]
      }
    ]
  },
  "sources": [
