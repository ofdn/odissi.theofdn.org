{
  "id": "oa-gita-000301",
  "name": {
    "en": "Sakhi bije kadamba mule go",
    "or": "ସଖୀ ବିଜେ କଦମ୍ବ ମୂଳେ ଗୋ"
  },
  "composer": "oa-person-000026",
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-bije-kadamba-mule-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ବିଜେ କଦମ୍ବ ମୂଳେ ଗୋ",
          "ଏ ନବ ଲାବଣ୍ୟରୂପ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏକ ଦିନେ ସଖୀ ମୁଁ ରେ",
          "ଗଲି ଯମୁନାକୁ ନୀରେ",
          "ଗଭା କୁସୁମ ଫୁଲରେ",
          "ସଖୀ ଚନ୍ଦ୍ରିକା ଚୂଳ ତା ପରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚନ୍ଦନ ବିନ୍ଦୁ କପୋଳେ",
          "ନାସାରେ ମୁକୁତା ଲୁଳେ",
          "ହୃଦରେ ପଙ୍କଜ ମାଳେ",
          "ସଖୀ ଦେଖି ମୋ ପାଦ ନ ଟଳେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋପସୁତ ସଙ୍ଗ ମେଳେ",
          "ଗାବନ୍ତି ଗୀତ ସୁଢଳେ",
          "ମୋହନ ମୁରଲୀ ସ୍ୱରେ",
          "ବଂଶୀ ରାଧା ରାଧା କଲ୍ଲୋଳେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶୁଣି ଦୂତୀ ପ୍ରବୋଧିଲେ",
          "ସଧୀରେ ନିକୁଞ୍ଜେ ଗଲେ",
          "ବନମାଳୀ ଦାସ ବୋଲେ",
          "ରାଧା ଶ୍ରୀ କୃଷ୍ଣ ପାଦ ସେବିଲେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-bije-kadamba-mule-go/"
    }
  ],
