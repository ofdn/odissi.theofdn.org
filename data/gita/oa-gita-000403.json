{
  "id": "oa-gita-000403",
  "name": {
    "en": "Nabina mani mo bina sari jibani",
    "or": "ନବୀନାମଣି ମୋ ବିନା ସରି ଯିବଣି"
  },
  "composer": "oa-person-000087",
  "mula_raga": [
    "oa-raga-000111"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nabina-mani-mo-bina-sari-jibani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବୀନାମଣି ମୋ ବିନା ସରି ଯିବଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଣ୍ଟ ଯିବାରୁ ଗଡ଼ି । ଖଣ୍ଟ ମଦନ ପୀଡ଼ି ।",
          "ହାଟକାଙ୍ଗୀର ମୋର ଆଣ୍ଟ ଭାଙ୍ଗି ଦେବଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଣିମାଦି ଦାୟୀର । ପାଣି ରତ୍ନାଦି ହାର ।",
          "ଫଣୀ ବୋଲି ଜାଣି ସେ ଛିଣ୍ଡାଇବ ଟାଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବେଶ ଭୂଷା ବସନ କେଶବନ୍ଧା ଅଶନ",
          "ବିଷ ପରାୟ ମଣି ରମଣୀ ତେଜିବଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶରଦ ଇନ୍ଦୁ ଦ୍ୟୁତି । ନୀରଦକେଶୀ କ୍ଷିତି ।",
          "କର ନିବେଶି ଗଣ୍ଡେ କରଜେ ଚିରିବଣି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କଳକଣ୍ଠୀ ମୋ ଧନ । ବଳହୀନା ହୋଇଣ ।",
          "ତଳପ ଛାଡ଼ି ବଳେ ତଳରେ ଗଡ଼ିବଣି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦିବା ବିଭାବରୀରେ । ବିମ୍ବ ଅଧରୀ ମୋରେ ।",
          "ଯିବାକୁ ତା ପାଶେ ଶିବାଙ୍କୁ ଧ୍ୟାଇବଣି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ପଙ୍କଜ କହେ ଗିର । ଅଙ୍କମଣ୍ଡନା ମୋର ।",
          "ରଙ୍କ କିଙ୍କର ପାଇଁକି ଦୁଃଖ ଲଭିବଣି"
        ]
      }
    ]
  },
  "sources": [
    {
