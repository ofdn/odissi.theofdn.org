{
  "id": "oa-gita-000026",
  "name": {
    "en": "Ja re dhana tu mo",
    "or": "ଯା ରେ ଧନ ତୁ ମୋ"
  },
  "composer": "oa-person-000018",
  "mula_raga": [
    "oa-raga-000017"
  ],
  "mula_tala": [
    "oa-tala-000009"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ja-re-dhana-tu-mo/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯା ରେ ଧନ ତୁ ମୋ ବାରେ ନ ସଙ୍ଖଳୁ",
          "କାରେ କି ଶୁଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାଣ ଅଛି ପରମାଣ ବନ୍ଧୁ ତୁ ମୋ",
          "ଟାଣପଣ କି ସରି ।",
          "ବସନ କରି ଖୋଲସା । ମାନେ ବସିଛୁ ସୁରସା ।",
          "ଦଶନେ ଦନେ ତ୍ରିଦଶା । ଦଶା ମୋ ଦୁର୍ଦ୍ଦଶା ଶ୍ରେଣୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାର୍ଯ୍ୟ ଅଛି କିରେ ରାଜୀବନୟନା",
          "ବ୍ୟାଜ ଦୋଷକୁ ଧରି ।",
          "ହରପର ସ୍ମରେ ମଜ୍ଜି । ମରମରେ ଗଲା ବାଇ ।",
          "କରମେ ଥିଲି ଅରଜି । ଭରମେ ଅଂଗି ସୁଶ୍ରେଣୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାଶ ଗଲି ଧନ ଭାଷ ସୁବଚନ",
          "ହାସ ମିଶ୍ରିତ କରି ।",
          "ତୋ ବଚନ ତୀକ୍ଷ୍ଣମୁନ । ହୃଦ କରେ ବିଦାରଣ ।",
          "ସ୍ମର ହୋଇଛି ପଠାଣ । ଟାଣି ନେବ ଏହି କ୍ଷଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଳି ଆଳି ଗଣେ ପାଳି ପାଳି କରି",
          "ଗାଳି ଶୁଣି ତୋହରି ।",
          "ଅବିରତେ ସେବିଥିବି । ପାଶରୁ କେବେ ନ ଯିବି ।",
          "ନବୀନବୟସୀ କବି । ପୀତାମ୍ବର ଦେବ ଭଣି"
        ]
      }
    ]
  },
  "sources": [
