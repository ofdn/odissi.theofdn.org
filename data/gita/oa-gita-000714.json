{
  "id": "oa-gita-000714",
  "name": {
    "en": "Gajagate e jagate",
    "or": "ଗଜଗତେ ଏ ଜଗତେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gajagate-e-jagate-kalyana-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗଜଗତେ ଏ ଜଗତେ",
          "ତୁ କାହାର ଚମ୍ପାଝରା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୟନ ମୋର ଏ ଭୂଲୋକରେ",
          "ମନ ନାଗ ନାକ ଦ୍ୱିଲୋକରେ",
          "ବୁଲୁଛି ଯେ ଭୁଲୁଛି ସେ",
          "ନାହିଁ ନାହିଁ ତୋହ ପରା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ତପ କରିଛି କେତେ ଯୁଗ",
          "ଜିତ ପଙ୍କଜ ତୋ ପଦଯୁଗ",
          "ସୁହାସୀ ରେ ଯାହା ଶିରେ",
          "ଧରୁଅଛି ବସୁନ୍ଧରା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଖ ସିତପଞ୍ଚଦଶୀପତି",
          "ଲାବଣ୍ୟ ନିକୁରମ୍ବର ଶ୍ରୁତି",
          "ଶେଷ କହି ଶେଷ ନୋହି",
          "ହୋଇଅଛି ତ ଅଧୁରା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୁର ଶିଖରି ଗରବ ଚୋର",
          "ଉରସିଜ କୁମ୍ଭ ବାଳା ତୋର",
          "ନବତନୁ ନବତନୁ",
          "ଲତା ଭାଜି ଯିବ ପରା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବନ୍ଧୁଜୀବ ବନ୍ଧୁ ଦନ୍ତବାସ",
          "ବନ୍ଧୁ ହେବା ବେଳେ ମନ୍ଦ ହାସ",
          "ପୀୟୂଷର ସରସାର",
          "ସ୍ୱାଦୁ ପାଇ ଯାଏ ଧରାରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏ ଶୋଭା ଦେଖିଛି ଯେଉଁ ଆଖି",
          "ସେହି ସେହି ସିନା ତହିଁ ସାକ୍ଷୀ",
          "ଗିରେ କିସ କହି ଶେଷ",
          "ହେବ ମୋ ଦୁଃଖପାଶୋରା ରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗେନ୍ଦ୍ର ସେ କାଳେ ଭଜେ",
          "ଶ୍ୟାମ ଗିରେ ସପ୍ରଣୟ ଲାଜେ",
          "ବସି ମଥା ପୋତି କଥା",
          "ନ କହିଲେ ବିମ୍ବାଧରା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
