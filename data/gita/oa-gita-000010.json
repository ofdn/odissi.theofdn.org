{
  "id": "oa-gita-000010",
  "name": {
    "en": "Khyamanukampadhara he",
    "or": "କ୍ଷମାନୁକମ୍ପାଧର ହେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Khya Patala",
      "or": "କ୍ଷ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/khyamanukampadhara-he-khya-champu-kedara-kamodi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କ୍ଷମାନୁକମ୍ପାଧର ହେ",
          "କ୍ଷୀରସାଗର ସମ୍ଭବା କୁଚକୁମ୍ଭ ଯୁଗଳ",
          "ପରିରମ୍ଭ ଚତୁର ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କ୍ଷିତି ଚକ୍ରବାଳ ମହାଭୀତି ନିବାରଣ ହେ",
          "ଶ୍ରୁତିଶିର ଅବତଂସାକୃତି ଶ୍ରୀଚରଣ ହେ",
          "ମରାଳ ବିହରଣ କରାର୍ଚ୍ଚିତ ଚରଣ",
          "ଧରାଭାର ହରଣ ଚରାଚର ଶରଣ",
          "ତରାବର କିରଣ ବରାବର ଚରଣ",
          "ନଖାଂଶୁ ସୁରଗଣ ଶିଖାଭରଣ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷଣେ ହେଲେ ନାମକୁ ନ ଭଣେ ମୁଁ ତୁମ୍ଭର ହେ",
          "ଜଣେ ତ ହେବାରୁ ପାପିଗଣେ ବିଶ୍ଵମ୍ଭର ହେ",
          "ମନା ନ କର ହିତ ଅନାଦର ରହିତ",
          "ଅନାଉଣି ନିରତ ଚୂନା କରୁ ଦୂରିତ",
          "ଅନାରତ ମୋ ଚିତ୍ତ ମନାସୁଛି ଅହିତ",
          "ଜନାର୍ଦ୍ଦନ ପତିତ ଜନାବହିତ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କ୍ଷମ ତ ମୁଁ ନୁହେ ଅନୁପମ ଅନୁଭାବ ହେ",
          "ଯମ ଦଣ୍ଡରୁ ମୋ ରକ୍ଷା କେମନ୍ତଟି ହେବ ହେ",
          "ଜଳାକର ଭବନ ବଳାସୁଖ ଭୁବନ",
          "ବଳାହିତ ରତନ ବଳାବରଜ ଜନ",
          "କଳାପର ବୃଜିନଦଳା ସୁକୃତଧନ",
          "ବଳାଢ୍ୟ ମୁନିମନ କଳାପି ଘନ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କ୍ଷମାଧିପ ଜଗଦ୍ଦେବ ସମାପନ କରେ ହେ",
          "ଶ୍ରମାର୍ତ୍ତ ହେବାରୁ ଭବ ଭ୍ରମାତିଶୟରେ ହେ",
          "ବ୍ୟଥା ନିବହ ହର ପ୍ରଥା ଚଳୁ ମିହିର",
          "ପଥାନ୍ତରକୁ ହର ରଥାଦିରୁ ଅମର",
          "ମଥାମଣି ନିକର ରଥାଙ୍ଗଯୁତ କର",
          "କଥା ବିନୟ ମୋର ବୃଥା ନ କର ହେ"
        ]
      }
    ]
  },
