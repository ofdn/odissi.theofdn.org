{
  "id": "oa-gita-000627",
  "name": {
    "en": "Nua chhaila mahila kahara e",
    "or": "ନୂଆ ଛଇଳା ମହିଳା କାହାର ଏ"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000065"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nua-chhaila-mahila-kahara-e-suratha-jadumani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନୂଆ ଛଇଳା ମହିଳା କାହାର ଏ",
          "ସୁଆଳୀଗଣ ଗହଣେ ବାହାର ଏ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅବଳାମଣିର ବାଳା ନୂପୁର ଶବଦ",
          "କଳାରାତି ପଦକୁ ତ କରାଉଛି ରଦ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରାଜହଂସ ଗମନୀର ଛଟକ ଚାତୁରୀ",
          "ସାଜଇ କି ମନୋହର ବେଶଭୂଷା ଶିରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହୋଇପାରନ୍ତି ଭାଜନ ଯଦି ଛାମୁକୁ ତା",
          "ଗଜରା ନିଶରେ ପରା ଗୁଛନ୍ତି ମୁକୁତା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରସାରେ ମୁଁ ଥିବା ଯାକେ ଜୀବନ ଦଶାରେ",
          "ଯଶ ଧ୍ୱଜାକୁ ଉଡ଼ାନ୍ତି ରସିକ ସଂସାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସତେ ରତେ ରସାଇବ କରିବ ବିଧାତା",
          "ପ୍ରତେ ନାହିଁ କହେ ବିନାୟକ ମାନଧାତା"
        ]
      }
    ]
  },
  "sources": [
