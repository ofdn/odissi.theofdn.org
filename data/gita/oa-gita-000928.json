{
  "id": "oa-gita-000928",
  "name": {
    "en": "Chahin syama mohana",
    "or": "ଚାହିଁ ଶ୍ୟାମ ମୋହନ"
  },
  "composer": "oa-person-000130",
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahin-syama-mohana-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହିଁ ଶ୍ୟାମ ମୋହନ ମୂରତି ସେ ରସବତୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲାଜକୁ ପକାଇ ପଛକୁ ସକଳେ",
          "ଚଞ୍ଚଳେକ୍ଷଣୀଏ ସେକ୍ଷଣି ଚଞ୍ଚଳେ",
          "ନେତ୍ର ନୀଳୋତ୍ପଳ ମାଳା ଏକାବେଳେ",
          "ମଣ୍ଡିଲେ ତେଜି ଧରତୀ ସେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦୂରୁ ଭୂରୁ ନଚା ମୁରୁକିହସାରେ",
          "ମୂରୁଛିଲେ କୁଳଶୀଳ ସ୍ୱଇଚ୍ଛାରେ",
          "ଘନରସ ବାଞ୍ଛା ଚାତକୀ ପରିରେ",
          "ହୋଇଲେ ତୃଷା ଆରତି ସେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେ ବକ୍ର ଚାହାଣୀ ନକ୍ର କି ହୋଇଲା",
          "ନକ୍ରପରି ଦମ୍ଭଚକ୍ରକୁ ହାଣିଲା",
          "ଯେ ଥିଲେ ବିବେକ ସକଳ ଭାସିଲା",
          "ପୀରତି କଲେ କୀରତି ସେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବଶୀକରଣ ଗୁଣ ନେତ୍ର କୋଣରେ",
          "ବସିଛି ସ୍ତମ୍ଭନ ମାଧୁର୍ଯ୍ୟ ଗୁଣରେ",
          "ବସିଛି ଉଚ୍ଚାଟ ରସିକପଣରେ",
          "ମୋହନ ପତିବରତି ସେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମହା ମହୋତ୍ସବେ ଶ୍ରୀଚନ୍ଦନ ଭାଷେ",
          "ମହାରଜତାଙ୍ଗୀ ମୋହନ ପାରୁଶେ",
          "ସୁରଙ୍ଗ ଅଧରେ ମନ୍ଦ ମନ୍ଦ ହାସେ",
          "ଭାଷିଲେ ଶ୍ୟାମ ଭାରତୀ ସେ"
        ]
      }
    ]
  },
  "sources": [
    {
