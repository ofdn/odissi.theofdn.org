{
  "id": "oa-gita-000829",
  "name": {
    "en": "Nanda kisora pari",
    "or": "ନନ୍ଦ କିଶୋର ପରି ଗୋ କିଶୋରୀ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000044"
  ],
  "mula_tala": [
    "oa-tala-000010"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-kisora-pari-kalingagouda-kuduka-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନନ୍ଦ କିଶୋର ପରି ଗୋ କିଶୋରୀ",
          "ଖୋଜିଲେ ନ ଥିବ ଚଉଦପୁରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେତେ କାଳ ବସି ବିହି ଯତନେ",
          "ସଜାଡ଼ିଲା ତନୁ ନୀଳ ରତନେ",
          "ଅଳପ ଅନାଇଦେଲେ ଅପାଙ୍ଗେ",
          "ଅଙ୍ଗଯାକ ପୂରି ରହେ ଅନଙ୍ଗେ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୟନ ମୁନ ତା ମଦନ ଛୁରୀ",
          "ଦୁଃଖ ସୁଖ ତହିଁ ରହିଛି ପୂରି",
          "ଥରେ ଚାହିଁଦେଲେ ଅଳପ କରି",
          "ଜୀବ ଥିବାଯାକ ନୁହେଁ ପାଶୋରି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଫୁଲକାଣ୍ଡ ଚାରୁ କୋଦଣ୍ଡ ପରି",
          "ଭ୍ରୂଲତା ନେତ୍ର ତା ନଚାଏ ଧରି",
          "ଧଇର୍ଯ୍ୟ ନ ରହେ ଚାହିଁଲେ ଦୂରୁ",
          "ବରତି ଯିବ କେ ଶ୍ୟାମ ଆଗରୁ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋପାଳୀ କୁଳଙ୍କ କୁଳ ବଡ଼ାଇ",
          "ନାଗରରାଜା ଦେଲେଣି ଛଡ଼ାଇ",
          "ବିଷ ପରି ହେଲା ଲୋଭ ମୁହାଁସ",
          "ସନ୍ତତ ନୟନେ କଲାଣି ବାସ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବନମାଳୀ ବୋଲେ ମୋହନ ଦେହ",
          "ମୋହିନୀ ମାନଙ୍କୁ କରଇ ମୋହ",
          "କିଞ୍ଚିତ ବନିତା ହେବାର ବଶ",
          "ଅନାଇଁ ପଶୁଏ ସ୍ଥଳିତ ଦୃଶ୍ୟ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
