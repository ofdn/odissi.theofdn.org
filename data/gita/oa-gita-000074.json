{
  "id": "oa-gita-000074",
  "name": {
    "en": "Mahi mandana ana re",
    "or": "ମହୀମଣ୍ଡନା ଅନାରେ"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mahi-mandana-ana-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "(ସଖୀ ବଚନ)",
          "ମହୀମଣ୍ଡନା ଅନାରେ ଚାନ୍ଦଆନନା",
          "ଅସିତ ପିକବଚନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସରୁ ଭୂରୁଭଙ୍ଗିନୀ ଧୀରା ଚାରୁହାସିନୀ",
          "ନବନୀରଦକେଶା ସିହାଣୀ ସୁକୁମାରୀ",
          "(ପଡ଼ି)",
          "ଆସ ମୀନନୟନା ହସ ନୋହି ବିମନା",
          "ରସି ବଚନ ଭାଷ ରୋଷ ବହି ରୁଷନା",
          "ବନଜାକ୍ଷୀ ବିଦୁଷୀ ଆମେ ତୋ ଚିର କିଣା",
          "ଊଣା ହୋଇଲା କିସ ବହନ କହୁ କି ନାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବରଜ ରାଜ ଈଶ୍ୱରୀ ନବକିଶୋରୀ",
          "ନ ଦିଅ ପ୍ରୀତି ପାଶୋରି",
          "ଧନେ କିଣା ବିଭବ ମନ କିଣା ସମ୍ଭବ",
          "ହୋଇ ନ ପାରେ କେବେ ଫୁଟିଲେ ତୁଟିଯିବ",
          "(ପଡ଼ି)",
          "ପ୍ରେମ ନୁହେଁ ପଙ୍କିଳ ସଦା ପୂତ ମଞ୍ଜୁଳ",
          "କୋମଳ ପଲ୍ଲବେ କି ସଲିଳ ଢଳଢଳ",
          "ମଜ୍ଜାଇ ମଜ୍ଜିଯିବା ଭବେ ଅତି ବିରଳ",
          "ହଜି ପାରିଲେ ନିଜେ ସୁଫଳ ମିଳେ ସିନାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "(ରାଧା ବଚନ)",
          "ବଳାନା ମୋତେ ସହିରେ ତା ବିରହରେ",
          "ମରିବି ବିଷ ଖାଇରେ",
          "ଜଗତେ ତାର ଯଶ ଶୁଭେ ହେଉ ବିକାଶ",
          "ଆଶା ଦେଇ ସେ ଯେବେ ମୋତେ କରେ ନିରାଶ",
          "(ପଡ଼ି)",
          "କହିବି ମୁଁ କାହାକୁ ଦହିହୁଏ ମୋ ବୁକୁ",
          "ମଥା ମୋ ନଇଁଯାଏ ଜାଣିଣ କପଟୀକୁ",
          "ସହିବାର ଟାଣ ଆସେନା ମୋ ମନକୁ",
          "ପର କରି ସେ ମୋତେ ପାଶୋରିଲେ ସିନାରେ"
        ]
      }
    ]
  },
