{
  "id": "oa-gita-000349",
  "name": {
    "en": "Pranadhana prana rakha",
    "or": "ପ୍ରାଣଧନ ପ୍ରାଣ ରଖ"
  },
  "composer": "oa-person-000043",
  "mula_raga": [
    "oa-raga-000070"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pranadhana-prana-rakha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣଧନ ପ୍ରାଣ ରଖ ଧରୁଛି ତୋ ପାଣିକି ରେ",
          "ଶୁଣାଉ ନାହୁଁ କାହିଁକି ବୀଣାଜିଣା ବାଣୀକି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏଣୀନୟନା ଏଣିକି ନ ଚାହୁଁ କି ଜାଣିକି ରେ",
          "ରଣରଣ ବାଣଗଣ ବିନ୍ଧୁଅଛି ଟାଣିକି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତାରଣକୁ ଶରଣ ମୁଁ ତୋ ଚରଣ ଆଣିକି ରେ",
          "ଜଣାଉଛି ଜଣାଯିବା ପାଇଁ ରାମାମଣିକି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କବିଗଣପଣ ଯିବ ତୋ ଶୋଭା ନ ଭଣିକି ରେ",
          "ଗଣକ ଗଣେ ନୋହିବ ଗୁଣରାଶି ଗଣିକି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନୃପମଣି ଶ୍ରେଣୀ ମଧ୍ୟେ ଏ ମୁକୁଟ ମଣି କି ରେ",
          "ଦୀନବନ୍ଧୁ ବନ୍ଧୁ ମଣି କୋଳ କଲେ ଆଣିକି ରେ"
        ]
      }
    ]
  },
  "sources": [
