{
  "id": "oa-gita-000650",
  "name": {
    "en": "Chhana heli sakhi syama",
    "or": "ଛନ ହେଲି ସଖି ଶ୍ୟାମ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000092"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhana-heli-sakhi-syama-mangala-kamodi-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛନ ହେଲି ସଖି ଶ୍ୟାମ ଛବି ଦେଖି",
          "ଛାଡ଼ ତୁ ତା କଥା କହନା ଲୋ",
          "ଛେଦିଦେଲା ସେ ମୋ ଧଇର୍ଯ୍ୟ ତରୁକୁ",
          "ତୁ ପୁଣି ତାହାକୁ ଦହନା ଲୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଛୋପରା ପଣିଆ ନ ଜାଣୁ କି ତାର",
          "ଛଇଳ ନାଗର ଯାହା ନା ଲୋ",
          "ଛନ୍ଦ ମନ୍ଦ ବାଣୀ ନନ୍ଦ ନନ୍ଦନର",
          "ଫାନ୍ଦରେ ତାହାର ପକାନା ଲୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛେଲ ପରି ଲାଗେ ତା ଗେଲ ବଚନ",
          "ମୋତେ ତୁ ଏଥି ଅଟକାନା ଲୋ",
          "ଛପି ରହିଅଛି ଏହି ନିକୁଞ୍ଜରେ",
          "ଚାଲ ଚାଲ ଦଣ୍ଡେ ରହନା ଲୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଛାଟି ନେବ ନେତ୍ର ବଡ଼ଶୀ ମୁନରେ",
          "ହୃଦରୁ ନିଶ୍ଚୟ ଚେତନା ଲୋ",
          "ଛାର ମାର ମରମରେ ଯାହା କରେ",
          "ବଂଶୀରେ ଡାକିଲେ ମୋହନ ଲୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଛୁଇଁଦେବ ଯେବେ ରହିବ କି ଦମ୍ଭ",
          "ବଡ଼ାଇ ଗୁମାନ କେତେ କି ଲୋ",
          "ଛତ୍ରପତି ପୁତ୍ରୀ ଶ୍ରୀମତୀ ଦୂତୀକି",
          "କହେ ବେଣୁଧର ଭାବନା ଲୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
