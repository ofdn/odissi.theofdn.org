{
  "id": "oa-gita-000959",
  "name": {
    "en": "Padijiba syama phande",
    "or": "ପଡ଼ିଯିବ ଶ୍ୟାମ ଫାନ୍ଦେ"
  },
  "composer": "oa-person-000017",
  "mula_raga": [
    "oa-raga-000065"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/padijiba-syama-phande-suratha-syamasundara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପଡ଼ିଯିବ ଶ୍ୟାମ ଫାନ୍ଦେ ସେ ନବକିଶୋରୀ ଗୋ",
          "ଲୋଡ଼ୁଅଛି ତାର ପଦଚିହ୍ନ ଅନୁସରି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଫେଡ଼ି କହୁ ନାହିଁ ସିନା ଅନ୍ତରଗତ ଭାବନା",
          "ନନ୍ଦସୁତ ସଙ୍ଗ ସେହି ଲଭିବ କିପରି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଳିଲାଣି ତାର ମନ ଶଙ୍କାମାତ୍ର ଗୁରୁଜନ",
          "ଦୂରେ ବଂଶୀନାଦ ଶୁଣି ଶ୍ରୁତି ଦିଏ ଡେରି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଳି ସଙ୍ଗେ ଯମୁନାକୁ ଗଲେ ନୀର ଆଣିବାକୁ",
          "କଦମ୍ବ ମୂଳକୁ କେତେ ଚାହେଁ ଫେରି ଫେରି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷଇ ଶ୍ୟାମସୁନ୍ଦର ହେ ସଖି ଭ୍ରମ ଆମ୍ଭର",
          "ବିଧି ବିଧାନକୁ କିଏ ଦେବ ଆନ କରି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
