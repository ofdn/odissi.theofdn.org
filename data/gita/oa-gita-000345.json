  "id": "oa-gita-000345",
  "name": {
    "en": "Ete belaku he mukha disila",
    "or": "ଏତେବେଳକୁ ହେ ମୁଖ ଦିଶିଲା"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ete-belaku-he-mukha-disila-ki-aja-anandabhairabi-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏତେବେଳକୁ ହେ ମୁଖ ଦିଶିଲା କି ଆଜ",
          "ପଥବଣା ହୋଇଲ କି ବ୍ରଜ ଯୁବରାଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପରିହରି ଚିର ପ୍ରୀତି ଆନ ରମଣୀରେ ମାତି",
          "ମୋ ପାଶକୁ ଆସିବାକୁ ପାଇଲ କି ଲାଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯା ତୁଲେ ମାତିଲ ନିଶା ସେ ବା କେମନ୍ତ ସୁରସା",
          "ବୁଝିବାକୁ ଲୋଡ଼ୁଥିଲେ ମୋ ସଖୀ ସମାଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁମ୍ଭ ଆସିବା ସମୟ ଜାଣି ହୋଇ ତୋଷମୟ",
          "ଜଗି ବସିଥିଲି କୁଞ୍ଜେ ସାଜି ଫୁଲଶେଯ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମିଳିବାରୁ ଓଷ୍ଠ ସୁଧା ଯିବାରୁ ଅନଙ୍ଗ ବାଧା",
          "ତେବେକୁ ଏବେ ଶ୍ରୀଅଙ୍ଗ ଦିଶେ ଭିନ୍ନ ତେଜ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶୁଣି ରାଧା ଭଙ୍ଗୀ ଗିର ମଥା ପୋତିଲେ କିଶୋର",
          "ଭାବି କହେ ରଘୁନାଥ କବି ଦ୍ୱିଜରାଜ"
        ]
      }
    ]
  },
  "sources": [
    {
