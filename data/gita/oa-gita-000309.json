{
  "id": "oa-gita-000309",
  "name": {
    "en": "Sari bari bihara",
    "or": "ସାରି ବାରି ବିହାର"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sari-bari-bihara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାରି ବାରି ବିହାର",
          "ବିଜେ ବ୍ରଜ ରାମା ହୃଦହାର ଯେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବସି ମଣି ବିମାନର",
          "ବାମେ ସିନ୍ଧୁସୁତା ଦକ୍ଷିଣେ ଧରଣୀ",
          "-ଧର ପାଶରେ ଶଙ୍କର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଟୀ ତଟେ ପୀତାମ୍ବର",
          "ଶିରେ ଜାମୁଡାଳି ମୟୂରଚନ୍ଦ୍ରିକା",
          "ନାସେ ଗଜମୋତିବର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାନା ରତ୍ନେ ଅଳଙ୍କାର",
          "କଣ୍ଠେ କଉସ୍ତୁଭ ମଣି ବିରାଜଇ",
          "ଯାଇ ଜୂଇ ମଲ୍ଲୀ ହାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋହନ ତ୍ରୈଲୋକ୍ୟସାର",
          "ସୁର ନାଗ ନର ଗନ୍ଧର୍ବ କିନ୍ନର",
          "ଖଟନ୍ତି ଚରଣେ ଯାର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆଗେ ଦାସୀ ନୃତ୍ୟକାର",
          "ଭକ୍ତଜନମାନେ ଧରିଣ ଅଛନ୍ତି",
          "ଖଦି ଆଲଟ ଚାମର"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ସାରି ଚାରି ପଟୁଆର",
          "କଉତୁକେ ଢଳି ଢଳିଣ ଆସନ୍ତି",
          "ସଙ୍ଗେ ଘେନି ହଳଧର"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ପ୍ରତିହାରୀ ଯେ ସୁଆର",
          "ମଣିମା ମଣିମା ଗୁହାରି ଶୁଣିମା",
          "ଡାକ ପଡ଼ଇ ଅପାର"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ବିଜୟେ ସିଂହଦୁଆର",
          "ବନମାଳୀ କର ଯୋଡ଼ି ଜଣାଉଛି",
          "ଶରଣ ମୁଁ ନିରନ୍ତର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
