{
  "id": "oa-gita-000955",
  "name": {
    "en": "Kunja duare kaha nupura dhwain",
    "or": "କୁଞ୍ଜ ଦୁଆରେ କାହା ନୂପୁର ଧ୍ୱନି"
  },
  "composer": "oa-person-000132",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunja-duare-kaha-nupura-dhwain-mohana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁଞ୍ଜ ଦୁଆରେ କାହା ନୂପୁର ଧ୍ୱନି",
          "ପ୍ରିୟ ସଜନୀ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବହି ଆସୁଅଛି ମନ୍ଦ ମନ୍ଦ",
          "ଭାବ ବିନୋଦିଆ ଅଙ୍ଗ ଗନ୍ଧ",
          "ଝୁଲାଝୁଲି ନାଚି ଆସୁଅଛନ୍ତି କି",
          "ବୃଷଭାନୁସୁତା କଣ୍ଠମଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଧୁକର ପ୍ରେମେ ହୋଇ ମତ୍ତ",
          "ଧାଇଁ ଆସୁଛନ୍ତି ଶତ ଶତ",
          "ଅନୁରାଗ ଚିତ୍ତେ ଦେଖି ରାଧାନାଥେ",
          "ଭାବାବେଶେ ହସେ କୁମୁଦିନୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୁବାସ କୁସୁମ ବନେ ବନେ",
          "ଫୁଟି ଉଠୁଛି ଗୋ ସ୍ନେହ ମନେ",
          "ମଧୁସ୍ୱରେ ପିକ ଜଣାଇ ଦେଉଛି",
          "ଅଇଲେଣି ରାଧା ମୁକୁଟମଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନ ମୋ ହେଉଛି ଛନ୍ନଛନ୍ନ",
          "ଚୋରି କଲା ପରି ପରଧନ",
          "ନ ଦେଖିଲେ ତାଙ୍କୁ ଝୁରି ମରୁଥାଇ",
          "ଦେଖିଲେ କାହିଁକି ହୁଏ ମାନିନୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଲଳିତା ସଙ୍ଗିନୀ ଦେଲା ଠାରି",
          "ନୀପମୂଳେ ଲୁଚିଛନ୍ତି ହରି",
          "ନାରୀ ମନ ଚୋରା ତା ପ୍ରେମ ପସରା",
          "ଧରା ପଡ଼ିବ ସେ ଏହିକ୍ଷଣି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ହସି ହସି ରସିକ ନଟବର",
          "ବିଜୟ କିଶୋରୀ କେଳିପୁର",
          "ଭାଷନ୍ତି ଶ୍ରୀମତୀ ଏତେ ଦିନେ କି ହେ",
          "ମନେ ପଡ଼ିଲା ଜନ୍ମ ଦୁଃଖିନୀ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ମିଳି କୁଞ୍ଜେ ରାଧା ବନମାଳୀ",
          "ସଙ୍ଗିନୀଏ ଦେଲେ ହୁଳହୁଳି",
          "ଦୀନ ହୀନ ମୋହନ ସେ ପାଦକୁ ଭାଳି",
          "ଭାଳି ବହିବ କି ନେତ୍ରୁ ପାଣି"
        ]
      }
    ]
  },
  "sources": [
