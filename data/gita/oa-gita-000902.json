{
  "id": "oa-gita-000902",
  "name": {
    "en": "Nagara raja kahin rahile",
    "or": "ନାଗରରାଜ କାହିଁ ରହିଲେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000050"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nagara-raja-kahin-rahile-saranga-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାଗରରାଜ",
          "କାହିଁ ରହିଲେ ଆଜ ସଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୂରନ୍ତ ଏ ବସନ୍ତ ବଞ୍ଚିବି ରେ କେମନ୍ତ",
          "ଅସରା ହେଲା ସିନା ଶଶୀ ହସା ରଜନୀ ସଜନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେତେ ଯେ ଆଶା ଧରି ଆସିଲି ତେଜି ପୁରୀ",
          "ବିହି ସାଧିବ ବାଦ ନ ଥିଲି ସତେ ଜାଣି ସଜନୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସାଜିଲି ଫୁଲ ଶେଯ ଛାଇ କୁସୁମ ରଜ",
          "ବିଫଳ ସବୁ ସଜ ସାର ତ ଆଖି ପାଣି ସଜନୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଶଶୀ କହଇ ବିରହ ବିନେ ସହି",
          "ମିଳନ ମଧୁର କି କାହିଁ ସତ ହେଲାଣି ସଜନୀ"
        ]
      }
    ]
  },
  "sources": [
    {
