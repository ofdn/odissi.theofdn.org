{
  "id": "oa-gita-001092",
  "name": {
    "en": "Janichi mun ete matra go lalite",
    "or": "ଜାଣିଛି ମୁଁ ଏତେ ମାତ୍ର ଗୋ ଲଳିତେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ja Patala",
      "or": "ଜ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/janichi-mun-ete-matra-go-lalite-kedara-kamodi-kabisurjya-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜାଣିଛି ମୁଁ ଏତେ ମାତ୍ର ଗୋ ଲଳିତେ",
          "ଯାହା ଇଚ୍ଛା ତୋର ତାହା କର",
          "ଜ୍ୱଳନରୁ ବଳି ସେହି ଦିନୁ କେଳି",
          "କରେ ବିଭାବରୀ ନାହାକର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜଣକେତେ ବ୍ରଜଶିଶୁ ଥିଲେ ନିଜ",
          "ପୂରୁଁ ଆସୁଥିଲି ଖେଳାଇ ସମଜ",
          "ଜମ୍ଭାରାତି ମଣି ଗିରୀନ୍ଦ୍ରକୁ ଜିଣି",
          "-ବାର ପୁରେ ହେଲା ମୋ ନଜର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାତି କୁରୁବିନ୍ଦ ବାତାୟନ ବୃନ୍ଦ",
          "ଅନାଇଁ ମୁ ଚାଲୁଥିଲି ମନ୍ଦ ମନ୍ଦ",
          "ଜଙ୍ଗମ ହେବାର ଜମ୍ବୁନଦ ସାର",
          "ଶିରୀ ସ୍ଫୁରିଲା ସେ କି ପ୍ରକାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜୀବନଦ ନୀଳ ଜଳଜ ଯୁଗଳ",
          "ବିଧୁ ବିମ୍ବେ ହୋଇ ବିଳାସ ବିଲୋଳ",
          "ଜାତ କଲା ଗର ଜରଜର ଶର",
          "ନିକର ବରଷା ଖରତର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜହରକୁ ଗୋଳି ଦେଲା ପରି ଗିଳି",
          "ମୋହର ଦେହର ପୀଡ଼ା ଗଲା ବଳି",
          "ଜୀବନାଶା ଟଳି ଯାଉଅଛି କଳି",
          "ପାରୁ ନାହିଁ ମୁଁ ମୋ ହୃଦନ୍ତର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଜନ ମନୋହାରୀ ସେ ବିଚିତ୍ର ଶିରୀ",
          "କାହା ନେତ୍ରପାତ୍ରେ ଯାଇ ନାହିଁ ପୂରି",
          "ଜଗଦ୍ଦେବ ହରିଚନ୍ଦନ ମୋହରି",
          "ନାମ କହୁଅଛି ନିରନ୍ତର"
        ]
      }
    ]
  },
  "sources": [
    {
