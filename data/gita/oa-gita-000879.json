{
  "id": "oa-gita-000879",
  "name": {
    "en": "Radha tuhi tirtha",
    "or": "ରାଧା ତୁହି ତୀର୍ଥ"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000007"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radha-tuhi-tirtha-sri-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧା ତୁହି ତୀର୍ଥ ରୂପିଣୀ ଜଗତେ",
          "କୃପାକଟାକ୍ଷୀ କଟାକ୍ଷେ ଚାହାଁ ମୋତେ",
          "ପାଶୁଁ କଲେ ଅନ୍ତର ମୁଁ ହେବିଟି କାହାର",
          "ଶମ୍ପାଗୋରୀ ବିଚାର କର ସୁଚିତ୍ତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଖୀ ମଣିକର୍ଣ୍ଣିକା ବେନି ଶ୍ରବଣ",
          "ମୃଗନେତ୍ରୀ ନର୍ମଦା ତୋର ଈକ୍ଷଣ",
          "ସୁକଶଳୟ ପାଣି ପୁଷ୍କର ତୋର ପାଣି",
          "ପଦ୍ମାନନ ମୁଖ ଚନ୍ଦ୍ରଭାଗା ସତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁନ୍ଦରଦନା ପ୍ରଭାସ ତୋ ରଦନ",
          "ପିକବଚନା ସରସ୍ୱତୀ ବଚନ",
          "ତୋ ବେଣୀ କୃଷ୍ଣବେଣୀ ତୁ ସୁରତରଙ୍ଗିଣୀ",
          "ଗୋଦାପଦ ସମସ୍ତ ଦେବତାନୁତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋର ଲୀଳାସମୁଦ୍ର ବିଳାସବତୀ",
          "ବର୍ଣ୍ଣିବାକୁ ନ ଅଣ୍ଟିବ ଦିନରାତି",
          "ଆଚରି ତପ ଘୋର ସକଳ ତୀର୍ଥେ ତୋର",
          "ଦେହେ ବାସ କରିଅଛନ୍ତି ସାକ୍ଷାତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମାନ ତେଜ ମୁଁ ତୋର କିଣା କିଙ୍କର",
          "କୋମଳାଙ୍ଗୀ ଅଙ୍ଗୀକାର ମୋତେ କର",
          "ତୋ ଦେହ ସ୍ପର୍ଶମାତ୍ରେ ନ ରହିବ ମୋ ଗାତ୍ରେ",
          "ପାପଚୟ ବିକ୍ରମଦେବ ବନ୍ଦିତେ"
        ]
      }
    ]
  },
