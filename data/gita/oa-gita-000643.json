{
  "id": "oa-gita-000643",
  "name": {
    "en": "Rati murati syama pritire",
    "or": "ରତି ମୂରତି ଶ୍ୟାମ ପ୍ରୀତିରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000103"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rati-murati-syama-pritire-regupta-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରତି ମୂରତି ଶ୍ୟାମ ପ୍ରୀତିରେ",
          "ନ ଜାଣୁ ପରା ପରମାଣୁ ମଧ୍ୟା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗଣ୍ଡେ ଦୂରକୁ ଦିଶେ ମଞ୍ଜୁଳ",
          "ଗଣ୍ଡେ କାହାର ତାମ୍ବୁଳ ବୋଳ",
          "ମଣ୍ଡେ କି ଚିହ୍ନ ଦନ୍ତ ଦୂକୁଳ",
          "ଦଣ୍ଡେ ବସି ଦେଲୁ କି ରସ ପରିଚିତି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୀବି ନିବିଡ଼ତା ନାହିଁ କିଛି",
          "ଲିଭି ଅଛି ମୃଗମଦ ମାଛି",
          "ଜୀବିତେଶ ତୋହର ଶ୍ରୀବତ୍ସି",
          "କି ବିହିଲେ ବଦ ମଦଦ୍ୱିରଦ ଗତି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଁ ଟିକିଏ ହେଲେ ଶୁଣିଥାଏଁ",
          "ଲୁଟିଗଲା କି ଲାଜ ଥୋକାଏ",
          "ଲୁଟିବାରେ ମାର ପୁର ଯାଏ",
          "ଫୁଟି ଝଡ଼ିଗଲା କି ସେଫାଳିକା ତତି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୁଖ ଲୋଭରୁ ବନ୍ଧୁକାଧରା",
          "ରଖ ବୋଲି ନାହୁଁ ଥରେ ପରା",
          "ନଖ କ୍ଷତେ ହେଜା ତନୁ ପୂରା",
          "ଅଖଣ୍ଡିତ କଲ କି କାମିତ ସନ୍ତତି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କି ସାହସ କଲୁ ସତେ ଆଳି",
          "ନିଶାଯାକ ଜାଗରେ ପ୍ରବଳି",
          "କଷା ଦିଶୁଛି ନେତ୍ର ଯୁଗଳି",
          "ହସା ଲାଗୁଛି ଆଜ ଅନାଇଁ ତୋ ଦ୍ୟୁତି ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ତୂଳି ତଳପ ବରଜି ଫୁଲ",
          "ଧୂଳି ସମାଜ କି ଶେଯ କଲ",
          "ଗୁଳି ବାଜିଲା ପରି ତ ଗଲ",
          "ଲୁଳିଯାଇଛି ଅଳକ ମୋତି ସୀମନ୍ଥିରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଆସେଚନକ ଆଜ ଏ ଶୀରି",
          "ବାସେ ଉତ୍ପଳ ମିଶା କସ୍ତୁରୀ",
          "ନାଶେ ମାନସ ବ୍ୟଥା ବଲ୍ଲରୀ",
          "ଭାଷେ ବସୁଦୁର୍ଗ ଧରାବଳୟ ପତି ରେ"
        ]
      }
    ]
  },
  "sources": [
