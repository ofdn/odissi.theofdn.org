{
  "id": "oa-gita-000420",
  "name": {
    "en": "Prana sajani pabitra hela netra mohara re",
    "or": "ପ୍ରାଣ ସଜନୀ ପବିତ୍ର ହେଲା ନେତ୍ର ମୋହର ରେ"
  },
  "composer": "oa-person-000057",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prana-sajani-pabitra-hela-netra-mohara-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣ ସଜନୀ ପବିତ୍ର ହେଲା ନେତ୍ର ମୋହର ରେ ।",
          "ଦେଖି ଶ୍ୟାମ ତନୁ ପୀଡ଼ିଲା ଅତନୁ",
          "ତା ବିନୁ କେ ମୋ ପ୍ରତିକାର ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବଳିଭୁଜ ପାଳିତ ନୀଳମଣି ଜୀମୂତ",
          "କୁନ୍ତଳ ବିଧୂନ୍ତୁଦ ତମାଳଧାତ୍ରୀ ମିତ",
          "ରତିଜିତ ପ୍ରସନ୍ନେ ଝାଙ୍କିଛି ମଧୁବ୍ରତ",
          "ବିକଚ ଇନ୍ଦୀବର ଜିଣି ଆକାର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ୱୟମ୍ଭୂ ବାମଦେବ ରତିଜିତ ବାସବ",
          "ହବ୍ୟବାହନ ପିତୃପତିଜିତ ଗନ୍ଧର୍ବ",
          "ପୁଣି ଜନ କିଶୋର ବାହୁଳେୟ ହେରମ୍ବ",
          "ଅନଙ୍ଗ ଯାର ପରିଚାର ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ରବଣରେ କୁଣ୍ଡଳ ବାଳାର୍କରୁ ମଞ୍ଜୁଳ",
          "ଝଳି ଦିଶଇ ତହିଁ କଣ୍ଠ ରତନ ହାର",
          "ନାସେ ନାସା ମୁକୁତା ଅତିଶୟ ଚପଳ",
          "ଶିଖୀପୁଚ୍ଛ କେଡ଼େ ମଞ୍ଜୁଳ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋ ଚିତ୍ତ ତାମରସ ଭେଟ ହେଲେ ଦିନେଶ",
          "ନୋହିଲେ ଦାସୀ ନାଶ ହେଲା ସଜନୀ ଦୋଷ",
          "କନିକା ମେଘନାଦ ବଂଶରେ ଅବତଂସ",
          "ଶ୍ରୀ ଦିବ୍ୟସିଂହ ଦେବ ଭାଷ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
