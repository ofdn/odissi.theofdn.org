{
  "id": "oa-gita-000131",
  "name": {
    "en": "Kahinre mana sahi",
    "or": "କାହିଁରେ ମନ ସହି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinre-mana-sahi-kahin-re-mana-sahi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁରେ ମନ ସହି ପ୍ରସନ୍ନ ହେଉନାହିଁ",
          "ଏଥିକି କହ କେଉଁ ଗତିକି ରେ",
          "କି କରି ଅରଜିବି କି କରି ବରଜିବି",
          "ସେ ନବଘନ ଶ୍ୟାମ ପ୍ରୀତିକି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯୁଗଠାରୁ ଅଧିକ ହୋଇଲାନି ପଲକ",
          "କେମନ୍ତେ ସମ୍ଭାଳିବି ଧୃତିକି ରେ",
          "ତ୍ରିଭୁବନ ମୋହନ ବିଷମ ବଂଶୀସ୍ୱନ",
          "କାହୁଁ ଚୁମ୍ବିଲା ମୋର ଶ୍ରୁତିକି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଇନ୍ଦ୍ରନୀଳ କପାଟ ପୁଟରୁଚି ସେ ନଟବର",
          "ମୁକୁଟମଣି ହାତୀକି ରେ",
          "ମାନସେ ଭାବି ଭାବି କ୍ରମେ କି ଛାଡ଼ିଦେବି",
          "କୁଳବରତ ଜାତି ନୀତିକି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗରଳ ଗିଳି ଅବା ରବିନନ୍ଦନ ସେବା",
          "ବିଧିରେ ବଳାଇବି ମତିକି ରେ",
          "ଅବା ଶ୍ୟାମ ସଙ୍ଗତି ଲଭି ସୁଭାଗ୍ୟବତୀ",
          "ମଣ୍ଡଳେ ଟେକାଇବି ଛତିକି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନିକୁଞ୍ଜେ ସେତେବେଳେ ଘେନି ବସିବି କୋଳେ",
          "ସେ ନବକିଶୋର ମୂରତିକି ରେ",
          "ପରତେ ନାହିଁ ମୋର କରତେ ମଦନର",
          "ବସିପାରିବି କି ବରତିକି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ଶ୍ରୀ ଛୋଟରାୟ ନୃପତି କୁବଳୟ",
          "ନେତ୍ରେ ଲପନ ନିଶାପତିକି ରେ",
          "ଦେଖାଇ ଦେଇ ଥରେ ଏବେ ଭାଗ୍ୟପଥରେ",
          "ପକାଇ ନେବେ ଅକୀରତିକି ରେ"
        ]
      }
    ]
  },
  "sources": [
