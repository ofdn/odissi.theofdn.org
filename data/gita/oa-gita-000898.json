  "id": "oa-gita-000898",
  "name": {
    "en": "Kama chhabi chhaila",
    "or": "କମ ଛବି ଛଇଳା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000049"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kama-chhabi-chhailara-bibhasa-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କମ ଛବି ଛଇଳାର",
          "ମୋର ନୟନେ ନାଚିଲା ସୁମନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସତେ ଭାଗ୍ଯ ହେବ ମୋର",
          "ଏ ଗୁନ୍ଥା ସୁମନ ହାର",
          "ଲାଗି ହେବ ନବୀନାର",
          "କଳକଣ୍ଠ ପରଶିବ ଶରଧାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶିଶୁ କୁରଙ୍ଗ ନୟନା",
          "ଲଳିତ ଅଙ୍ଗୀ ଶୋଭନା",
          "ଚାହିଁବ ଚନ୍ଦ୍ରବଦନା",
          "ସୁଧା ବରଷିବ ରସି ବସୁଧାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କବିଚନ୍ଦ୍ର ଭାଳେ ମନେ",
          "ଅଙ୍ଗେ ଲିଭାଇବା ବିନେ",
          "ନ ବାରିବ କେହି ଦିନେ",
          "ସେ ଯେ ତରୀ ବାହେ ଆଖି ନୀରଧାରେ"
        ]
      }
    ]
  },
  "sources": [
