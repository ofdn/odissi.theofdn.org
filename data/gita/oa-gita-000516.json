{
  "id": "oa-gita-000516",
  "name": {
    "en": "Aja brajaraja kumara raja pathare",
    "or": "ଆଜ ବ୍ରଜରାଜ କୁମର ରାଜପଥରେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000080"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-brajaraja-kumara-raja-pathare-desabaradi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ ବ୍ରଜରାଜ କୁମର",
          "ରାଜପଥରେ ଯାଉଥିଲେ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗେଲେ ଗେଲେ ଖେମଟା ନାଚେ",
          "ଆସୁଥାନ୍ତି ଗୋକୁଳ ପଛେ",
          "ବାନ୍ଧି ଚୂଳ ମୟୂର ପୁଚ୍ଛେ",
          "ସେହି ସେ ପୂତନା ପ୍ରାଣ ଘେନା ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୟନ କଜ୍ଜ୍ୱଳ ଲାଞ୍ଜି",
          "କିବା ମଦନ ଶର ସାଜି",
          "ନବ ଯୁବା ନାରୀ ମରମ ଖୋଜି",
          "ବିବେକ ବୁଦ୍ଧିକି କରେ ବଣା ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତାଙ୍କ ଯେଉଁ ଶ୍ରୀମୁଖ ଶୋଭା",
          "ଦେଖି କେ ବା ନୋହିବେ ଲୋଭା",
          "ଉପେକ୍ଷିବେ ନାରୀ କେ ନବ ଯୁବା",
          "କହିଥିଲେ ଯାହା କହି ନୋହେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାଙ୍କ ଯେଉଁ ଭୂରୁ ଛଟକ",
          "ଚାହିଁଲେ କି ଆଉ ପଡ଼େ ପଲକ",
          "ଏହି ରୀତି ଥିଲେ କାଳକ ଯାକ",
          "ଆଉ କି ବଞ୍ଚିବେ ଗୋପାଙ୍ଗନା ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କରୀବର ଗତିକି କରି",
          "ହରି କରେ ମୁରଲୀ ଧରି",
          "କରୀବର କର ଶିରୀକି ଧରି",
          "ସଧୀରେ ବଂଶୀ ବଜାଉଥିଲେ ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବନମାଳୀ କହଇ ଗୀତେ",
          "ତାର ଛବି କହିବି କେତେ",
          "ଦେଖିଲା ବେଳକୁ ଚିତ୍ତ ଛନ୍ନ ଛନ୍ନ",
          "ମନକୁ ମୋହର ମୋହି ନେଲେ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
