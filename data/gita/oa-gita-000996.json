  "name": {
    "en": "Chhaila more chhauli chhada",
    "or": "ଛଇଳା ମୋରେ ଛାଉଲି ଛାଡ଼"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000004"
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhaila-more-chhauli-chhada-mukhari-kabisurjya-ratnakara-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛଇଳା ମୋରେ ଛାଉଲି ଛାଡ଼",
          "ଛଦ୍ମ ନୀରେ ନିରନ୍ତରେ ନ ବୁଡ଼"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଛାମୁରେ ଥିବା ସହଚରୀଗଣେ",
          "ଛାଇ ତୁ ପରା ମୋ ଅନୁସରଣେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛଣା ପୀୟୂଷ ପରି କହି ଆଣି",
          "ଛପାଇ ଦେଉଛୁ କାହିଁକି ପୁଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଛାପ ଦେଇ ଲଘୁ ନ କର ହେଳେ",
          "ଛତି ଟେକାଇ ଦେ ତରୁଣୀ କୁଳେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଛିଦ୍ରଭେଦ ଘେନିବାକୁ ମୋହର",
          "ଛକେ ଛକେ ଜଗିଅଛନ୍ତି ଚର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଛୁଇଁ ଦେଇ ନୀଳ ଛବି ବାସନା",
          "ଛଟପଟ ହୋଇ ମରିବ ସିନା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଛାତି ଭିତରୁ ଧୃତି ଗଲା ସରି",
          "ଛଳ ଛାଡ଼ି କୋଳ କଲେ କିଶୋରୀ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଛୁଟିଲା ଶଙ୍କା ସଖୀ ହୃଦୟରୁ",
          "ଛ ଏକ ପଦେ କହେ ରାୟଗୁରୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
