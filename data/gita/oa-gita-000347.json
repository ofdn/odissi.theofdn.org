{
  "id": "oa-gita-000347",
  "name": {
    "en": "He mohana pritire nahi karana",
    "or": "ମୋହନ ହେ ମୋହନ ପ୍ରୀତିରେ ନାହିଁ କାରଣ"
  },
  "composer": "oa-person-000062",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohana-he-mohana-pritire-nahi-karana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନ ହେ ମୋହନ",
          "ପ୍ରୀତିରେ ନାହିଁ କାରଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅପବାଦ ନାଗରା ବାଜୁଛି ଗୋପପୁର",
          "ଶାଶୁ ନଣନ୍ଦ କଷଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଷ ପୀୟୂଷ ବୋଲି ନ ଜାଣି ମୁଁ ଭକ୍ଷିଲି",
          "ଏବେ ହୋଇଲା ମରଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦୂରେ ଥିଲେ ଆରତି କଲେ ଯେଉଁ ଆରତି",
          "ଏବେ ମୁଁ ଜାଣିଲି ପୁଣ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୋଲନ୍ତି ଧନୁର୍ଜୟ ମାଧବ ଫେରିଯାଅ",
          "ପାଇଲ ବଡ଼ କଷଣ"
        ]
      }
    ]
  },
  "sources": [
