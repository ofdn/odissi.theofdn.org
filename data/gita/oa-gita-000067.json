{
  "id": "oa-gita-000067",
  "name": {
    "en": "Anama patana hate",
    "or": "ଅନାମ ପାଟଣା ହାଟେ"
  },
  "composer": "oa-person-000034",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/784/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନାମ ପାଟଣା ହାଟେ",
          "କର ମନ କାରବାର",
          "ଅନେକ କାଳର କଷ୍ଟ",
          "ଅଳପକେ ହେବ ଦୂର | ଘୋଷା |"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବସିଛି ବଣିଆ ବୁଢ଼ା",
          "ମେଲିଣ ଦୋକାନ ପୁଡ଼ା",
          "ଯାହା ତୋର ହେବ ଲୋଡ଼ା",
          "ମାଗିଲେ ଦେବ ସତ୍ୱର | ୧ |"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଲେଖା ହିସାବ ତାର",
          "ଅକ୍ଷର ମଧ୍ୟୁଁ ବାହାର",
          "ନାହିଁ କାଗଜ ପତର",
          "ରେଫେ ନ ଯାଏ ପାଶୋର | ୨ |"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅମୁଲ୍ୟ ଭକତି ବିନା",
          "ନନେବ ସେ ଟଙ୍କା ସୁନା",
          "କୋଟିକେ ଗୋଟିଏ ଗଣା",
          "ହେବୁ କଲେ ସେ ବେପାର | ୩ |"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିବେକ ବିଚାରେ ତୁଳି",
          "ଖୋଲି ବିଶ୍ୱାସର ଝୁଲି",
          "ଧର୍ମ ଅର୍ଥ କାମ ଭୁଲି",
          "ମୋକ୍ଷକୁ ସଉଦା କର | ୪ |"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେ ହାଟେ କରି ସଉଦା",
          "ତୁଟାଅ ଦାରିଦ୍ର୍ୟ ବାଧା",
          "ଦ୍ୱିଜ ବୈକୁଣ୍ଠର ଶ୍ରଦ୍ଧା",
          "ରହୁ ଜନ୍ମ ଜନ୍ମାନ୍ତର | ୫ |"
        ]
      }
    ]
  },
  "sources": [
