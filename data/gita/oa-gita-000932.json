{
  "id": "oa-gita-000932",
  "name": {
    "en": "E rajani braja bandhunku",
    "or": "ଏ ରଜନୀ ବ୍ରଜବନ୍ଧୁଙ୍କୁ"
  },
  "composer": "oa-person-000130",
  "mula_raga": [
    "oa-raga-000061"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-rajani-brajabandhunku-srichandana-lalitaa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ ରଜନୀ ବ୍ରଜବନ୍ଧୁଙ୍କୁ",
          "ଗୋପୀନାଥଙ୍କୁ ରଖିଲା କେଉଁ ସଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁଁ ଦୁଃଖୀ ହୋଇଲି ଅଭାଗିନୀ",
          "କୃଷ୍ଣ ନଇଲେ ମୋ ପୁରେ ପୁଣି",
          "ନାନା ଜାତି ପୁଷ୍ପେ ଶେଯ ଶେଯାଇଲି",
          "କା ପୁରେ ରହିଲେ ବେଣୁପାଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅମଳାନ ବସ୍ତ୍ର କୁଞ୍ଚି କରି",
          "ନାନା ପୁଷ୍ପମାଳ ଗୁନ୍ଥି କରି",
          "ଏ ସର୍ବ ପଦାର୍ଥ ହୋଇଲା ବିଅର୍ଥ",
          "ବାସି ହେଲା ନ ଆସିଲେ ହରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତାମ୍ବୂଳ ପୁଣି ଅଳାଇଚରେ",
          "ସଜାଡ଼ି ରଖିଲି ଏ ପାଞ୍ଚରେ",
          "ଚୂଆ ଚନ୍ଦନ କର୍ପୂର ଗୋଳି କରି",
          "ବୋଳିବାକୁ ଶ୍ୟାମ ଶ୍ରୀଅଙ୍ଗରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମାର ଶତ୍ରୁ ମୋର ବେଢ଼ିଅଛି",
          "ମୋ ଜୀବ ଭରସା ନାହିଁ କିଛି",
          "ପଞ୍ଚବାଣେ ପଞ୍ଚପ୍ରାଣ ଘେନିଯିବ",
          "ଏମନ୍ତ ମୋ ଚିତ୍ତେ ଆସୁଅଛି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କେଉଁ ଛଇଳୀ ଏ ଗୋପପୁରୀ",
          "ଲୁଚାଇ ରଖିଛି ନରହରି",
          "ବୋଲେ ଶ୍ରୀଚନ୍ଦନ ଏ ରୂପେ ଦର୍ଶନ",
          "କିଶୋରୀ ଅଛନ୍ତି ମାନ କରି"
        ]
      }
    ]
  },
  "sources": [
    {
