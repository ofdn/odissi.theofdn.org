{
  "id": "oa-gita-000599",
  "name": {
    "en": "Epari re sahi re mahire",
    "or": "ଏପରି ରେ ସହିରେ ମହୀରେ"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000156"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/epari-re-sahi-re-mahire/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏପରି ରେ ସହିରେ ମହୀରେ",
          "କାହାରେ ଜାଣି ନ ଥିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହା ସଙ୍ଗେ ମାତି",
          "ରହିଲେ ସୁରତି",
          "ଭାବରେ ଅତି",
          "ସେ ମାତି ଗୋ ଦୂତୀ କି ଗତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାରମ୍ବାର ସହି",
          "ଥିଲେ ମୋତେ କହି",
          "ଆନକୁ ଦେଇ",
          "କିମ୍ପାଇଁ ମନାଇଲେ ଯାଇଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ଅବା ପ୍ରିୟଙ୍କୁ",
          "ମନାଇଁ ଚିତ୍ତକୁ",
          "କରି ମୋଦକୁ",
          "କାହାକୁ ପ୍ରିୟକୁ ବଧକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପାହିଲା ରଜନୀ",
          "ନଇଲେ କି ଘେନି",
          "କା ଗିର ଶୁଣି",
          "ରମଣୀ କି ମଣିଲେ ପୁଣି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ଗୌରହରି",
          "ଶୁଣରେ କିଶୋରୀ",
          "ତୋ ବିନୁ ଗୋରୀ",
          "କିପରି ବିସ୍ମରି ଶ୍ରୀ ହରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/epari-re-sahi-re-mahire/"
    }
  ],
