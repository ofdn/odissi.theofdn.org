{
  "id": "oa-gita-000082",
  "name": {
    "en": "Kaha chitta taha",
    "or": "କାହା ଚିତ୍ତ ତାହା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-chitta-taha-gopalakrusna-kirabani-ekatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହା ଚିତ୍ତ ତାହା ଚାହିଁ ନ ବଳିବ",
          "ଯାହା ଦେଖିଲି ଗୋ ମା",
          "ଆହା ନବ ତାରୁଣ୍ୟ ଆହା ସେ କି ଲାବଣ୍ୟ",
          "ଆହା ବ୍ରଜେନ୍ଦ୍ର ପୁଣ୍ୟପୁଞ୍ଜ ଗୋଷ୍ଠଚନ୍ଦ୍ରମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "(ପଡ଼ି)",
          "ବଳାହକ ନିବହ କଳାରୁ ବଳି ଦେହ",
          "ଡୋଳାରେ ନାଚୁଛି ଗୋ ମା",
          "ଢଳାଚୂଳ ଧ୍ୱଜକୁ ଆହା କେକୀ ଚୂଳକୁ",
          "ବଳାଉ ଦୃଷ୍ଟି ସରିଗଲା ସବୁ ଗାରିମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିଟିଳାଳକ ଅଧ କୁଟିଳ ଭୂରୁ ମଧ୍ୟ",
          "ପଟୀର ତିଳକ ଗୋ ମା",
          "ନଟୀ ରତ୍ନ କୁଣ୍ଡଳ ଘୋଟିଛି ଗଣ୍ଡସ୍ଥଳ",
          "କଟି ପୀତ ଦୁକୂଳ ହା ତ୍ରିଭଙ୍ଗ ଭଙ୍ଗିମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖଞ୍ଜନଯୁଗ ମଦଗଞ୍ଜନ ନେତ୍ରଦ୍ୱନ୍ଦ",
          "କି ଅନୁରଞ୍ଜନ ଗୋ ମା",
          "କଞ୍ଜ ସଂଯୋଗ ଅଳି ପ୍ରଭଞ୍ଜନେ ଆନ୍ଦୋଳି",
          "ହେଲା ପରାଏ ଚଳି ମଣ୍ଡୁଛି ଶ୍ରୁତି ସୀମା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯୁବା ନିକର ବର ନବାବତାର ମାର",
          "କିବା ସେ ହୋଇଛି ଗୋ ମା",
          "ନିବାସ ମୁରଲୀର ଜୀବାତୁ ଯୁବତୀର",
          "ଜବା ଗର୍ବାପହର ଅଧର ଅରୁଣିମା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷେ ଅପାର ଦିନରୁ ସେ",
          "ଉପାୟ କଲେନି ଗୋ ମା",
          "ନପାଇ ଅବସର କୃପାମୟୀ ତୁମ୍ଭର",
          "ସ୍ୱରୂପ ହୋଇଲାନି ଶ୍ୟାମ ନେତ୍ର ପ୍ରତିମା"
        ]
      }
    ]
  },
