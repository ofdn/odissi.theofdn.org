{
  "id": "oa-gita-001334",
  "name": {
    "en": "Keli prabina kahinki karuna una",
    "or": "କେଳି ପ୍ରବୀଣା କାହିଁକି କରୁଣା ଉଣା"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000190"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/keli-prabina-kahinki-karuna-una-chhayatodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଳି ପ୍ରବୀଣା କାହିଁକି କରୁଣା ଉଣା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କରି ତ ନାହିଁ ମୁଁ ଦୋଷ କି ଘେନି ମୋ ଠାରେ ରୋଷ",
          "ବହିଛୁ ଏ ବୁଝାମଣା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପାଦେ କି ନ ଦେଲି ଲାକ୍ଷା କହ ଆରେ କୁଟିଳାକ୍ଷା",
          "ଛାମୁରେ କରୁଛି ଜଣା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ଝରା କୁସୁମ ଗଭା ସଜାଡ଼ି ନ ଦେଲି ଅବା",
          "ସେ କାରଣୁ ଏ ରୁଷଣା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୁଝୀନ ବସନ କୁଞ୍ଚି ନ ଦେଲି ବୋଲିକି ଘୁଞ୍ଚି",
          "ବସିଅଛୁ ରୁଷି ସିନା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
