{
  "id": "oa-gita-000039",
  "name": {
    "en": "Ago sakhi pasori nuhe giridhariki",
    "or": "ଆଗୋ ସଖୀ ପାଶୋରି ନୁହେଁ ଗିରିଧାରୀକି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ago-sakhi-pasori-nuhe-giridhariki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଗୋ ସଖୀ",
          "ପାଶୋରି ନୁହେଁ ଗିରିଧାରୀକି ।",
          "ପାଶୋରି ନୁହେଁ ଗିରିଧାରୀକି ଲୋ",
          "ମୂରୁଛି ନୁହେଁ ଗିରିଧାରୀକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆନ କିଛି ନ ରୁଚେ । ଆଖି ଭିତରେ ନାଚେ ।",
          "କଳଙ୍କ ହେଲା କୁଳନାରୀଙ୍କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସେ କି ଗୋକୁଳବାସୀ । ମହା ମୋହନ ଫାଶି ।",
          "ଆସି ରହିଛି ନନ୍ଦପୁରୀକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚାହିଁବା ମାତ୍ରେ ମନ । ହରେ ମତିମୋହନ ।",
          "ଏତେକ ନ ପାରିଲି ତରକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କି କୋମଳ ବଚନ । ପବିତ୍ର ଅପଘନ ।",
          "ଲୋଚନ ବେନି କାମଛୁରୀ କି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଲେଖିଦେବି ମୁଁ ଖତ । ଲୋକ ପଣେ ଦେଖତ ।",
          "କେ ଆଣି ଦେବ କାଲି ପରି କି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବନମାଳୀ କହଇ । ରାଗରେ ଯେ ଚାହଁଇ ।",
          "ସେ ସିନା ଯାଏ ଏତେ ସରି କି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
