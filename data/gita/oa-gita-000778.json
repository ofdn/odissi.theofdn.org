{
  "id": "oa-gita-000778",
  "name": {
    "en": "Nua lalana nua nagare",
    "or": "ନୂଆ ଲଳନା ନୂଆ ନାଗରେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000135"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nua-lalana-nua-nagare-nalinigouda-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନୂଆ ଲଳନା",
          "ନୂଆ ନାଗରେ ହେଲୁ ସୁଆଗମନା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୁଆକୁ ତୁଆ ଯାଉ ଯାଉ ଯମୁନା",
          "ଭୁଆଶୁଣୀ କୁଳରୁ ହେବୁ ତ ମନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦୁଆରବନ୍ଧ ଡେଇଁ ହେଉ ତନ୍ମନା",
          "କୁଆଁରୀ କାଳୁ କଲୁ ଶ୍ୟାମ କାମନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରୁଆଇ ହୃଦକ୍ଷେତ୍ରେ କାଳିଆ ସୁନା",
          "ଥୁଆଇଲୁ ଅକୀର୍ତ୍ତି ପସରା ସିନା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପୁଆଣୀ ବଧୂ ତୁ ତ ରାଜନନ୍ଦନା",
          "ଧୁଆଇବୁ ନୟନ ଲୋତକେ କିନା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଉଆସ ଛଡ଼ାଇବ ସେ ନନ୍ଦ କହ୍ନା",
          "ଗୁଆଁର ବନମାଳୀ ଚିତ୍ତେ ଭାବନା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
