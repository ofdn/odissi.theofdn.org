{
  "id": "oa-gita-000798",
  "name": {
    "en": "Mohanare rasi bada dwande",
    "or": "ମୋହନରେ ରସି ବଡ଼ ଦ୍ୱନ୍ଦ୍ୱେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohanare-rasi-bada-dwande-kamodi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନରେ ରସି ବଡ଼ ଦ୍ୱନ୍ଦ୍ୱେ ପଡ଼ିଲୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଥା ଘେନିଲୁ ନାହିଁ ଯଥା ବାଳକ ସହି",
          "ବ୍ୟଥାରେ ହେଲୁ ଦହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାଣି ଶଠ ପୀରତି ଆଣି ରୋଇଲୁ ଛାତି",
          "ହାଣିଲା ସେ ବିପତ୍ତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନୀତି ବଚନ ଯେତେ ନିତି କହୁଛି ତୋତେ",
          "ଚିନ୍ତିଲୁ ତା ଅହିତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପରାପର ବିଚାର ଧରାରେ ଯେହୁ ଯାର",
          "ସରାୟେ ସେ ବେଭାର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭୂରୁ ଯୁଗ ନଚାଉ ଦୂରୁ ଆମ୍ଭଙ୍କୁ ଚାହୁଁ",
          "ଭୀରୁ କି ହେବ ଆଉ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବନମାଳୀ କହଇ ଜନମେ ପ୍ରୀତି ଯହିଁ",
          "ଧନ ତାହାର ଏହି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
