{
  "id": "oa-gita-000870",
  "name": {
    "en": "Nanda balam bhaje",
    "or": "ନନ୍ଦବାଳଂ ଭଜେ"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-balam-bhaje-mukhabari-sanskrit-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନନ୍ଦବାଳଂ ଭଜେ ନନ୍ଦବାଳଂ",
          "ସର୍ବଦା ସୁରମୋହନଂ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାଳଂ ସ୍ୱଭକ୍ତବୃନ୍ଦପାଳଂ କ୍ରୂରଦାନବକାଳଂ",
          "ଗୋପରମଣୀଲୋଳଂ ଭଜେ ନନ୍ଦବାଳଂ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରାମଂ ନୀଳନୀରଦଶ୍ୟାମଂ କୋଟିକାମାଭିରାମଂ",
          "ଯଦୁକୁଳାବ୍ଧିସୋମଂ ଭଜେ ନନ୍ଦବାଳଂ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବୀରଂ ମେରୁଭୂଧରଧୀରଂ ନୀରରାଶଗମ୍ଭୀରଂ",
          "ବୃନ୍ଦାରଣ୍ୟବିହାରଂ ଭଜେ ନନ୍ଦବାଳଂ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନାଥଂ ଶ୍ରୀମତିପ୍ରାଣନାଥଂ ବିନତଦେବଯୂଥଂ",
          "ଗୋକୁଳନିଶାନାଥଂ ଭଜେ ନନ୍ଦବାଳଂ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀଶଂ ସକଳଭୁବନେଶଂ ଦଳିତକଳିକ୍ଳେଶଂ",
          "ବିକ୍ରମଦାସପୋଷଂ ଭଜେ ନନ୍ଦବାଳଂ"
        ]
      }
    ]
  },
  "sources": [
    {
