{
  "id": "oa-gita-000662",
  "name": {
    "en": "Sakhi chala sarbe jiba mathura",
    "or": "ସଖୀ ଚାଲ ସର୍ବେ ଯିବା ମଥୁରା"
  },
  "composer": "oa-person-000029",
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-chala-sarbe-jiba-mathura/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ଚାଲ ସର୍ବେ ଯିବା ମଥୁରା ପୁର",
          "ଦେଖିବା ପରା ସକଳେ ହଟ ନାଗର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ମୋହିନୀ ବେଶଧାରୀ ମୋହିଲେ ଅମର ପୁରୀ",
          "ଯାହାଙ୍କର ବେଶେ ଭାଗୀ ହେଲେ ଶଙ୍କର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେ କରେ ମନ୍ଦର ଧରି ରଖିଥିଲେ ଗୋପପୁରୀ",
          "ଫେରି ପରା ଗଲେ ଇନ୍ଦ୍ର ନିଜ ମନ୍ଦିର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯାହାଙ୍କ ମୁରଲୀ ଧ୍ୱନି ମୋହିର କରେ ଅବନୀ",
          "ଗୋପାଙ୍ଗନା ସର୍ବେ ପରା ଛାଡ଼ନ୍ତି ଘର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସେ ମୋହନ ରୂପ ଦେଖି ସଫଳ କରିବା ଆଖି",
          "ପାପ ତାପ ଶୂନ୍ୟ ହେବ ଆମ୍ଭ ଶରୀର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏମନ୍ତ ସକଳ ନାରୀ ଚିତ୍ତେ ଧ୍ୟାନ କରି ହରି",
          "ରାମଚନ୍ଦ୍ର ଦେଓ ବୋଲେ ହେଲେ ବାହାର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-chala-sarbe-jiba-mathura/"
    }
  ],
