{
  "id": "oa-gita-000834",
  "name": {
    "en": "Podu e kadamba jalu brundabana",
    "or": "ପୋଡ଼ୁ ଏ କଦମ୍ବ ଜଳୁ ବୃନ୍ଦାବନ"
  },
  "composer": "oa-person-000050",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/podu-e-kadamba-jalu-brundabana-kedara-kamodi-dinakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପୋଡ଼ୁ ଏ କଦମ୍ବ ଜଳୁ ବୃନ୍ଦାବନ",
          "ମରୁ ଏ ବସନ୍ତ କୋଇଲି ଗୋ",
          "କୃଷ୍ଣ ସଙ୍ଗେ ଯାହା ନ ଯାଇ ରହିଛି",
          "ଆମ୍ଭ ପ୍ରାଣ ନେବ ବୋଲି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆମ୍ଭେ ସର୍ବ ସଖୀ ଜଳ ବାହି ଯିବା",
          "ଶୁଖୁ ଏ ଯମୁନା ନଈ ଗୋ",
          "କଦମ୍ବ କାଟି ଟିକି ଟିକି କରିବା",
          "ତହିଁ ଲଗାଇବା ଯୁଇ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆମ୍ଭେ ସର୍ବ ସଖୀ ଏକଇ ବୟସୀ",
          "ସବୁଙ୍କର ନୂଆ କୁମ୍ଭ ଗୋ",
          "ଛାତିକ ପାଣିରେ କୁମ୍ଭ ନ ବୁଡ଼ଇ",
          "ଏ ତ ବଡ଼ ଅସମ୍ଭବ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆସିଲା ବସନ୍ତ ପଲ୍ଲବିଲେ ଚୂତ",
          "ଫୁଟିଲେ ମାଧବୀ ଲତା ଗୋ",
          "କୁହୁ କୁହୁ କରି କୋଇଲି ରାବିଲା",
          "ଉଚ୍ଚରେ ଭ୍ରମର ଯଥା ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆସୁ କଂସ ଦୁଷ୍ଟ ନାଶୁ ଗୋପ ରାଷ୍ଟ୍ର",
          "ଭାଙ୍ଗୁ ତୋଟା ମଧୁବନ ଗୋ",
          "ରାମକୃଷ୍ଣ ମୋର କୁଶଳେ ଆସନ୍ତୁ",
          "କହେ ଦୀନକୃଷ୍ଣ ହୀନ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
