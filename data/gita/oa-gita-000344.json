{
  "id": "oa-gita-000344",
  "name": {
    "en": "Braja jubaraja aja",
    "or": "ବ୍ରଜ ଯୁବରାଜ ଆଜ"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000101"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/braja-jubaraja-aja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବ୍ରଜ ଯୁବରାଜ ଆଜ",
          "ମନକୁ ତ ମୋର ମୋହିନେଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘନଶ୍ୟାମ ଛବିକି ଦେଖି",
          "ଚିତ୍ତ ମୋର ରହିଲା ଲାଖି",
          "କାହୁଁ କାହ୍ନୁ କେତେ ଭଙ୍ଗୀକି ଶିଖିଛି",
          "ଚାହୁଁ ଚାହୁଁ ଚିତ୍ତ ବୁଡ଼ିଗଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେଉଁ ତାର ନୟନ ଠାର",
          "ସେ କି ଧୃତି କୁଠ କୁଠାର",
          "ଦେଖୁ ଦେଖୁ ତାର ନବ ନବ ରୀତି",
          "ତନୁଯାକ ମୋର ଥରିଗଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିମ୍ବ ଦମ୍ଭହରା ଅଧର",
          "ଦରହାସ କେଡ଼େ ମଧୁର",
          "ଦୂରୁ ଚାହିଁବାରୁ ଭୂରୁକୁ ନଚାଇ",
          "ତରଳ ନୟନେ ଠାରିଗଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାଙ୍କ ବିନା ନାହିଁ ଶରଣ",
          "ନ ବଳିଲା ପାଦେ ଚରଣ",
          "କୁଳବତୀ ସତୀକୁଳର ବରତ",
          "ଦେଖୁ ଦେଖୁ ମୋର ସରିଗଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାମକୃଷ୍ଣ ଭାଷେ ସଜନୀ",
          "ହେବି ତାର ପ୍ରୀତିଭାଜନୀ",
          "ଜାଣି ତ ନ ହେଲା ଏଡ଼େ ପରମାଦ",
          "ଅଯୋଗେ ତ ଭେଟ ପଡ଼ିଗଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
