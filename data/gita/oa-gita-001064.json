{
  "id": "oa-gita-001064",
  "name": {
    "en": "Sangini rasa rangini bhuru bhangini",
    "or": "ସଙ୍ଗିନୀ ରସରଙ୍ଗିନୀ ଭୂରୁଭଙ୍ଗିନୀ"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangini-rasa-rangini-bhuru-bhangini-kalyana-gopinatha-ballbha/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ସଙ୍ଗିନୀ ରସରଙ୍ଗିନୀ ଭୂରୁଭଙ୍ଗିନୀ ରୁଷ ନା ରେ",
          "ହେମାଙ୍ଗୀରେ ବରଭଙ୍ଗରେ ସୁଅପାଙ୍ଗିରେ ତୁ ଅନାରେ ।",
          "ସଙ୍ଗେ ମୋହର ରଙ୍ଗେ ବିହର",
          "ଭାଙ୍ଗିଦିଅ ଅନଙ୍ଗର ଦର",
          "ରଙ୍ଗୀକି କର ଅଙ୍ଗୀକାର",
          "ତୁଙ୍ଗସ୍ତନୀ ସୁମଙ୍ଗଳ କର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପଙ୍କଜମୁହୀଁ କିଙ୍କର ମୁହିଁ ରଙ୍ଗୁ ନୟନି ଆରେ",
          "ନିଃଶଙ୍କରେ ମୋ ଅଙ୍କରେ ପଲ୍ୟଙ୍କରେ ବସ ଧୀରେ ।",
          "ଶଙ୍କନା ମୋ ରଙ୍କର ଧନ",
          "କୁଙ୍କୁମ ବରନୀଙ୍କ ରତନ",
          "ହୁଂକୃତ ଝିଙ୍କି ମାରେ",
          "କଙ୍କପତ୍ର ଶଙ୍କରପର"
        ]
      }
    ]
  },
  "sources": [
