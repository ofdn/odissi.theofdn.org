{
  "id": "oa-gita-001145",
  "name": {
    "en": "Utha babu paila sarbari",
    "or": "ଉଠ ବାବୁ ପାଇଲା ଶର୍ବରୀ"
  },
  "composer": "oa-person-000136",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/utha-babu-paila-sarbari-tankadhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଉଠ ବାବୁ ପାଇଲା (ପାହିଲା) ଶର୍ବରୀ",
          "ହେ ବଂଶୀଧାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦାମ ସୁଦାମ ସୁବଳ ସୁବାହୁ ମଧୁମଙ୍ଗଳ",
          "ଆବର ଯେ କାମପାଳ ଆସି ସଙ୍ଗ ବ୍ରଜବାଳ",
          "ଡାକୁଛନ୍ତି ତୁମ୍ଭ ନାମ ଧରି ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷୁଧାରେ ହୋଇ ଆକୁଳ ବାଧାରେ ଧେନୁ ସକଳ",
          "ନ ପାଇଣ ଜଳ ସ୍ଥଳ ହୁଅନ୍ତି ଅତି ବିକଳ",
          "ଯିବୁ ପରା ଚରାଇ ବାଛୁରୀ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦିଗ ତ ଦିଶେ ନିର୍ମଳ ରଙ୍ଗିମା ନଭମଣ୍ଡଳ",
          "ଘେନି ପୁଷ୍ପ ପରିମଳ ବହଇ ମନ୍ଦ ଅନିଳ",
          "ଭ୍ରମିଲେଣି ଭୃଙ୍ଗ ଧ୍ୱନି କରି ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପୂର୍ବ ଦିଗେ ଦିନମଣି ଉଦୟ ହେବେ ଏକ୍ଷଣି",
          "କାକ କୁକ୍କୁଟଙ୍କ ବାଣୀ ଶୁଣି ଶୀଘ୍ରେ ଦ୍ୱିଜଶ୍ରେଣୀ",
          "ବାହୁଡ଼ିଲେ ଶୌଚ କର୍ମ ସାରି ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗଙ୍ଗବଂଶ କ୍ଷୀରାର୍ଣ୍ଣବ ଚନ୍ଦ୍ର କୃଷ୍ଣଚନ୍ଦ୍ର ଦେବ",
          "ସେବି ଚରଣ ରାଜୀବ ଅପହୁଡ଼ କରି ଜବ",
          "ପ୍ରକାଶିଲେ ଏ ରସ ବିସ୍ତାର ହେ ସାଧୁ ଜନେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/utha-babu-paila-sarbari-tankadhara/"
    }
  ],
