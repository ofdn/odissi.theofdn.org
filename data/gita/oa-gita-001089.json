    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Gha Patala",
      "or": "ଘ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ghenai-ambhe-jete-kahilu-re-champu-kabisurjya-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘେନାଇ ଆମ୍ଭେ ଯେତେ କହିଲୁ ରେ",
          "ଘେନିଲୁ ନାହିଁ ବାଳା ପହିଲୁ ରେ",
          "ଘୃତ ଘଟକୁ ଶିଖୀ ଶିଖା ପାଖରେ ରଖି",
          "ଶିରୀଷଦେହା ଏହା ସହିଲୁରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘସ୍ରନାଥ ନନ୍ଦନା ଅନାଉଣିକି ମନା",
          "କରୁଁ ଯେ ଥାଉଁ ହଟି ଚାହିଁଲୁ ରେ",
          "ଘଟୀସରିକି କରେ ନାହିଁ କି ବିବେକରେ",
          "ମହାର୍ଣ୍ଣବରେ ଅବଗାହିଲୁରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘୋଟି କିତବମୂଳ ଘୋରି ଘୋର ଜାଙ୍ଗଳ",
          "ଗରଳ ତୁଲେ ତାହା ପିଇଲୁ ରେ",
          "ଘୁମାଇବାର ସମ୍ଭବିଲା ନାହିଁ କି ଆମ୍ଭ",
          "ସୁଯୋଗୁଁ ସିନା ବଞ୍ଚି ଅଇଲୁରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଘେନି ଘେନାଇ ଯାଇ କହିବ ସମଜାଇ",
          "ଘଟିଲେ ଆମ୍ଭେ ଏକ ଜୀଇଲୁ ରେ",
          "ଘଟନା ବିରହରେ ଅବଶ୍ୟ ତ ଜହରେ",
          "ତୋ ଘେନି ଆତ୍ମଘାତି ହୋଇଲୁରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଘୋଳାରେ ପଛେ ମରୁ ଆଜୁ ତୋ ହୁକୁମରୁ",
          "ନିକୁଞ୍ଜ ଦଉଡ଼କୁ ରହିଲୁ ରେ",
          "ଘାଣ୍ଟି ହେଉଛୁ ମାତ୍ର ଆନୀଳ ଶତପତ୍ର",
          "ନେତ୍ରା ଯା ଆମ୍ଭ ବଶ ନୋହିଲୁରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଘନେ ଚପଳା ଲୀଳା ଚାହିଁ ଘନକୁନ୍ତଳା",
          "ତୁ କି ଏ ଅଭିଲାଷ ବହିଲୁ ରେ",
          "ଘାରି ଦେଲୁକି ରସେ ଅଷ୍ଟଦୁର୍ଗେଶ ଭାଷେ",
          "ଅବଶ୍ୟ ମୋହନକୁ ମୋହିଲୁରେ"
        ]
      }
    ]
  },
