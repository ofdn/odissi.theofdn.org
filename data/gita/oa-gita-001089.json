  "name": {
    "en": "Ghenai ambhe jete kahilu re",
    "or": "ଘେନାଇ ଆମ୍ଭେ ଯେତେ କହିଲୁ ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
