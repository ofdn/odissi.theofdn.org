{
  "id": "oa-gita-000238",
  "name": {
    "en": "Ki sunili aja nua kari",
    "or": "କି ଶୁଣିଲି ଆଜ ନୂଆ କରି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-sunili-aja-nua-kari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଶୁଣିଲି ଆଜ ନୂଆ କରି",
          "ସତଟିକି କହ ସହଚରୀ",
          "ତୁ ପୁଣି କିଶୋରମଣିକି ବିଲୋକି",
          "ମଥା ପୋତି ଗଲୁ ଅପସରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସ୍ମରଣା କରୁଛି ଅଦୃଷ୍ଟକୁ",
          "ଯାହା ମୂରତିକି ଦେଖିବାକୁ",
          "ଯୋଡ଼ିଏ ନୟନ ଦେଲୁ ବୋଲି ଯେତେ",
          "ନିନ୍ଦା କରୁଥାଉ ବିଧାତାକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷଣେ ନ ମୂରୁଛି ଚିତ୍ରପଟ",
          "ବନକୁ ଯିବା ଆସିବା ବାଟ",
          "ଜଗି ବସିଥାଉ ଶିଖଣ୍ଡମୁକୁଟ",
          "ଭେଟକୁ କେ କଲା ଏଡ଼େ କୂଟ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିରେଖି ନଭରେ ନୀରଦକୁ",
          "ପୁଲକାଇ ଦେଇ ଶ୍ରୀଅଙ୍ଗକୁ",
          "ଯା ତନୁକାନ୍ତିକି ଲକ୍ଷ ବୋଲ ପକ୍ଷ",
          "ଲୋଡ଼ୁଥାଇ ପରିରମ୍ଭଣକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋବର୍ଦ୍ଧନ ଶିଖରୀରେ ରହି",
          "ଗୋଷ୍ଠେନ୍ଦ୍ରସୁତ ପଥକୁ ଚାହିଁ",
          "ଦିନ ଦ୍ୱିଯାମରେ ଦ୍ୟୁମଣି ଶିଳାରେ",
          "ଉଭା ହେବା ଲୋଭ ଗଲା କାହିଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭାଷନ୍ତି ଶ୍ରୀମତୀ ହସି ଧୀରେ",
          "ଗୁରୁଜନେ ଥିଲେ ପୁରତରେ",
          "ଗୋପାଳକୃଷ୍ଣ କହିଲା ଠାରି କୃଷ୍ଣ",
          "ଜଗିଛନ୍ତି ପୁଷ୍ପ ବାଟିକାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
