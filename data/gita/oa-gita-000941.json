{
  "id": "oa-gita-000941",
  "name": {
    "en": "He mohana tumbha tana",
    "or": "ହେ ମୋହନ ତୁମ୍ଭ ଟାଣ"
  },
  "composer": "oa-person-000130",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/he-mohana-tumbha-tana-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହେ ମୋହନ ତୁମ୍ଭ ଟାଣ ଗଲାଣି କେଣିକି ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେତେ କରୁଥିଲ ଆଣ୍ଟ କେଣେ ଗଲା ସେ ମୁରାଟ",
          "ଆପଣା ମନରେ ବାଣ୍ଟ କାହାର ହାରିକି ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆହେ ରସିକଶେଖର ବାଂଶରୀ ଦିଅ ମୋ କର",
          "ଜିଣିମା ଦ୍ରବ୍ୟ ସେ ମୋର ରଖିଛି କାହିଁକି ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏତେ କହି ନାରୀବର ଧରି ଶୀଘ୍ରେ ଶ୍ୟାମ କର",
          "ଛଡ଼ାଇ ବଂଶୀ ନିକର ନେଲେ ସେ ଟାଣିକି ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୀନ ଶ୍ରୀଚନ୍ଦନ କହି ଆହେ ପ୍ରଭୁ ଭାବଗ୍ରାହୀ",
          "କେତେ କରୁଥିଲ ଟାହି ଅବଳା ଦେଖିକି ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/he-mohana-tumbha-tana-srichandana/"
    }
  ],
