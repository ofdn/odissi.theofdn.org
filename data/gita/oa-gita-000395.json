    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧନ୍ୟ ସଜନୀ ତୋ ଡୋଳାଢଳା ରେ",
          "ବୃନ୍ଦାରଣ୍ୟ ମତ୍ତ କରୀନ୍ଦ୍ର ଶୃଙ୍ଖଳା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାଏକ ଅଙ୍ଗରେ ସ୍ଥିତି । ଅଖିଳ ଇନ୍ଦ୍ରିୟ ବୃତ୍ତି ।",
          "ଆହା ସେ ବିବେକ କାହୁଁ ହଜିଗଲା ରେ"
        ]
      }
    ]
  },
