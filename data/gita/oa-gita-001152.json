{
  "id": "oa-gita-001152",
  "name": {
    "en": "E katha ati bidambana",
    "or": "ଏ କଥା ଅତି ବିଡ଼ମ୍ବଣ"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000179"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-katha-ati-bidambana-go-suna-kousika-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ କଥା ଅତି ବିଡ଼ମ୍ବଣ ଗୋ ଶୁଣ",
          "ଲାଗିଛି ଘଟଣ ଗୋ ଶୁଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାଜା ପେଷିଛି ଚାର ପଦ୍ମ ସହସ୍ରେ ଭାର",
          "ଦେବେ ଏ ଗୋପଲୋକ ପୁଣ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାହା ପ୍ରାଣକୁ କାର ଆଶା ନାହିଁ ବିଚାର",
          "ଜାଣି କେ ଲୋଡ଼ିବ ମରଣ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏଡ଼େ ନିର୍ଦ୍ଦୟ କଂସ ମାରିବ ଆମ୍ଭ ବଂଶ",
          "ତେଣୁ କରିଛି ଏ ଭିଆଣ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସବୁ ଦିନେ ତାହାର ଗୋପକୁ ଅହଙ୍କାର",
          "କାହିଁକି ଏଡ଼େ ନିଦାରୁଣ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କେ ବୋଲେ କି କରିବା କାହାକୁ ପଚାରିବା",
          "କେ ଅବା ରଖିବ ଶରଣ ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କେ ବୋଲେ କିମ୍ପା ଡର କୃଷ୍ଣ ଛନ୍ତି ଆମ୍ଭର",
          "ଅବଶ୍ୟ କରିବେ ରକ୍ଷଣ ଗୋ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କେତେ କେତେ ଦଇତ ନ କଲେ କି ଉତ୍ପାତ",
          "ସମସ୍ତେ ଲଭିଲେ ମରଣ ଗୋ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଅଘା ଶକଟା ବକା ତୃଣାବର୍ତ୍ତ ଧେନୁକା",
          "କ୍ଷୀର ସଙ୍ଗେ ପୂତନା ପ୍ରାଣ ଗୋ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଏମାନ ଶୁଣି କଂସ କୃଷ୍ଣଙ୍କୁ କରି ରୋଷ",
          "କରିଛି ଏ କୂଟ କଷଣ ଗୋ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଗଉର ଦ୍ୱିଜ କହେ ନ କର କିଛି ଭୟେ",
          "ଯା ନାମ ମାନ ଉଦ୍ଧାରଣ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
