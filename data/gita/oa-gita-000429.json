{
  "id": "oa-gita-000429",
  "name": {
    "en": "Pheri pheri ana ana eninayana",
    "or": "ଫେରି ଫେରି ଅନା ଅନା ଏଣୀନୟନା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000121"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pheri-pheri-ana-ana-eninayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଫେରି ଫେରି ଅନା ଅନା ଏଣୀନୟନା",
          "ଝୁରି ଝୁରି ତୋ ବିନାରେ ସରେ ମୋହନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏକେ ତ ସେ କଳା ଡୋଳା",
          "କାଳିଆ କଜ୍ଜ୍ୱଳ ବୋଳା",
          "ବିରହେ କି ରହେ ସହୀ କାଳିଆସୁନା ।",
          "(ପଡ଼ି)",
          "କୁଞ୍ଜବନେ ଯେବେ ମଧୁମଳୟ ଭରେ",
          "ସଞ୍ଜ ହେରି ତାର ନୀର ନିରତେ ଝରେ",
          "ମାନ ମନୁ ବାରିଦେ ରେ ସୁବଦନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାମ କମାଣ ତୋ ଭୂରୁ",
          "ଶ୍ୟାମ ତ ଜୁହାରେ ଦୂରୁ",
          "ଚଳାଇ ମରମ ତାର ନ କର ଚୂନା ।",
          "(ପଡ଼ି)",
          "ଆନ ମାନ ମୋର ଆନ ମନେ ନ ଧର",
          "ନ ଧର ଅଧରୁ ତୁ ବରଷ ମଧୁ ଧାର",
          "ଭାଷ ଭାଷ ରସଭାଷ ବୀଣାଜିଣା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କର କଙ୍କଣ ମଣି",
          "କାଚକଣି ତୁ ମଣି",
          "ଦୂରେ ବରଜି ଗୋରୀ ଝୁରି ସରନା ।",
          "(ପଡ଼ି)",
          "ଆରେ ଗଜଗତି ମନମୋହନା ଗତି",
          "କବିଶଶୀ ବଦତି ହସିବେଟି ଅରାତି",
          "ଆସେ ନିଶି ସରି ଆଉ ତୁ ରୁଷନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pheri-pheri-ana-ana-eninayana/"
    }
  ],
