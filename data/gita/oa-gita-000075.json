{
  "id": "oa-gita-000075",
  "name": {
    "en": "Manjuhasi kunjamandana re",
    "or": "ମଞ୍ଜୁହାସୀ କୁଞ୍ଜମଣ୍ଡନାରେ"
  },
  "composer": "oa-person-000035",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manjuhasi-kunjamandana-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଞ୍ଜୁହାସୀ କୁଞ୍ଜମଣ୍ଡନାରେ ।",
          "ମଞ୍ଜୁଳକଞ୍ଜନୟନା ।",
          "ବର୍ଜିଲୁରେ ବରବର୍ଣ୍ଣନୀ ଅର୍ଣ୍ଣବ",
          "ସମ୍ପଦ ବିପଦ କଳ୍ପିକ ଘେନିଘେନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସ୍ୱରୂପଶୋଭିନୀ ଭୂରୁବିଳାସିନୀ",
          "ଗୁରୁନିତମ୍ବିନୀ ଚାରୁସୁହାସିନୀ ।",
          "ସଙ୍ଗିନୀରେ ରସରଙ୍ଗିନୀ ଅଙ୍ଗନା",
          "ଛାରଖାର ସାର ପ୍ରାଣ କଲୁ ତୁ ସିନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସରସବଚନା ସାରସଲୋଚନା",
          "କର ବିବେଚନା ନ କର ଶୋଚନା ।",
          "ସଞ୍ଚନାରେ ଖେଦ କାଞ୍ଚନ ଅଙ୍ଗିନୀ",
          "ମୁଞ୍ଚ ମୁଞ୍ଚ ପାଞ୍ଚ ମାନ ବାରେ ତୁ ମନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପରିହାସ ବାଣୀ ନାରୀ ଶିରୋମଣି",
          "ବରିଲୁ ସରଣୀ ଘାରି ହେଲୁ ପୁଣି ।",
          "ବନ୍ଧୁ ମୋର ଚିର ସନ୍ତାପ ନାଶିନୀ",
          "କାଶହାସ ପରକାଶ କରି ତୁ ଅନା"
        ]
      }
    ]
  },
  "sources": [
    {
