{
  "id": "oa-gita-000737",
  "name": {
    "en": "Priti kundana re",
    "or": "ପ୍ରୀତି କୁନ୍ଦନାରେ"
  },
  "composer": "oa-person-000123",
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priti-kundana-re-birakesari-birakisora-deba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରୀତି କୁନ୍ଦନାରେ ସ୍ନେହ ରଖିଥିବୁ ମୋରେ",
          "କର ଧରି ଏତେ ମାତ୍ର କହୁଅଛି ତୋରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦଳିତ କଜ୍ଜ୍ୱଳ ଜଳଦ ମଞ୍ଜୁଳ",
          "କେଶ ବାସ ଶୋଭନେ",
          "କନକ କେତକୀ କାନ୍ତି ନିନ୍ଦିତ",
          "ଗାତ୍ର ମାନସ ମୋହନେ ।",
          "ପୂର୍ଣ୍ଣ ସୁନ୍ଦର ବିମ୍ବ ଅଧର",
          "ପୁଣ୍ଡରୀକ ସେ ଆନନେ",
          "ତୋର ବିନୁଁ ମୋର ମନ",
          "ନ ବଳଇ ଆନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଞ୍ଜ ଖଞ୍ଜନ ଚିତ୍ତରଞ୍ଜନେ",
          "ସଞ୍ଜନେ ଚିତ୍ତ ଲୋଚନେ",
          "ତାର ହାରିଣୀ ଦୁଃଖ ନାଶିନୀ",
          "କାମ ତାପ ବିମୋଚନେ",
          "କାଶ ଶୀତକର ହାସ ଛବି ଦର",
          "ହାସକାମୃତ ସେବନେ",
          "କିଣିଅଛୁ ତ ଧନ ମୋତେ ତୋ",
          "ପ୍ରେମ ବଚନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚନ୍ଦ୍ରବଦନ ଚିତ୍ତରଞ୍ଜନ",
          "ସଞ୍ଜ ନ ଚିତ୍ତ ଲୋଚନେ",
          "କୁନ୍ଦ କୋରକବୃନ୍ଦ ହୀରକ",
          "ଦନ୍ତୀ ନୃପତିନନ୍ଦନେ",
          "ବିମ୍ବ ବିଦ୍ରୁମ ମଞ୍ଜୂଲାଧରୀ",
          "କମ୍ବୁକଣ୍ଠୀ ବରାନନେ",
          "କେଳିସିନ୍ଧୁ କୋପ ଆଉ",
          "ନ ଧରିବୁ ମନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନଳିନୀବାସିନୀ ଶୋକନାଶିନୀ",
          "ଭୂମିମଣ୍ଡଳୀ ମଣ୍ଡନେ",
          "ମାରମାର୍ଗଣ ଦର୍ପଦାରଣ",
          "ସଙ୍ଗମେ ଧୃତି ଖଣ୍ଡନେ",
          "ମତ୍ତବାରଣୀ ମଦଗାମିନୀ",
          "ଶୋକ ଦାୟିନୀ ସୁସ୍ୱନେ",
          "ଭଣିଲେ ବୀରକେଶରୀ ଦେବ",
          "ତୋଷ ମନେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priti-kundana-re-birakesari-birakisora-deba/"
    }
  ],
