{
  "id": "oa-gita-001149",
  "name": {
    "en": "Hati jhulai re disai kede sundara",
    "or": "ହାତୀ ଝୁଲଇ ରେ ଦିଶଇ କେଡ଼େ ସୁନ୍ଦର"
  },
  "composer": "oa-person-000110",
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hati-jhulai-go-disai-kede-sundara-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହାତୀ ଝୁଲଇ ରେ ଦିଶଇ କେଡ଼େ ସୁନ୍ଦର",
          "ଅପୂରୁବ ହାତୀ କାହୁଁ ଆସିଅଛି",
          "କିବା ଏ ନୀଳକନ୍ଦର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖ ଦେଖ ସଖୀ ବକ୍ର ଭଙ୍ଗୀ ଆଖି",
          "ଚାହାଣୀ ବିଷମ ଛଟା",
          "ମତ୍ତ କରୀବର ହେଲା କାଳେ ଆଉ",
          "ନ କରିବ କେଉଁ ହଟା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେମନ୍ତ ସୁନ୍ଦର ବେନି ରଜ ତାର",
          "ଅଙ୍କୁରି ଆସୁଛି ସହୀ",
          "ନାରୀ ଗଣ୍ଡସ୍ଥଳେ ଭେଦିବ ଏ କାଳେ",
          "ଏଥିରେ ସଂଶୟ ନାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗଜ କପାଳକୁ ସୁନ୍ଦର ଦିଶଇ",
          "ଚନ୍ଦ୍ରବିନ୍ଦୁ ଆଡ଼କରା",
          "ସୁନ୍ଦରୀଙ୍କ ଭାଲ ସିନ୍ଦୂର ଲାଗିଲେ",
          "କାଳେ ନୋହିବ କି ତୋରା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ନୀଳବାରଣ ରଣକୁ ବରଣ",
          "ହେଲା କାଳେ ଆଗ ବଢ଼ି",
          "ଶମ୍ବର ଅଇରି ସମରରେ ହାରି",
          "ଯିବ ଧନୁ ଶର ଛାଡ଼ି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କେ ବୋଲେ ଏ ହାତୀ କେଉଁଠାରେ ଥିଲା",
          "ଗୋପକୁ ଆଣିଲା କେହୁ",
          "ନାନା ଖଦା ନାନା ବୋଲଣା କରିବ",
          "କେ ସହିବ ଏହା ଦାଉ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କେ ବୋଲେ ଏ ହାତୀ ମଥୁରାରେ ଥିଲା",
          "କଂସ ରାଜା ବନ୍ଧା ଘରେ",
          "ଶଙ୍କୋଳି ଛିଣ୍ଡାଇ ପଳାଇ ଆସିଣ",
          "ରହିଛି ଗୋପ ନଗରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କେ ବୋଲେ ରାଜାର ଅନେକ ଡଗର",
          "ଆସିଥାନ୍ତି ଜଣେ ଜଣେ",
          "ଦୁରୁଦଣ୍ଡ ହାତୀ ଧରା ନ ପଡ଼ିଣ",
          "ସଭିଙ୍କି ମାଇଲେ ପ୍ରାଣେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କେ ବୋଲେ କାଳିଆ ହାତୀଟି ମେଳିଆ",
          "ନ ମାନଇ ଖାଲଖମା",
          "ଗୋପପୁର ଦହି ଦୁଧ ସର ଖାଇ",
          "ହୋଇଛି ଧୂସର ଧୂମା"
        ]
      },
      {
        "n": 9,
        "lines": [
          "କେ ବୋଲେ ଗୋକୁଳ ପଦ୍ମିନୀ ବନକୁ",
          "ଉଜାଡ଼ିବ ଏହୁ କାଳେ",
          "ଏ ହାତୀକି ନେଇ ବନ୍ଦି ରଖିଥିବ",
          "କେଳି କଦମ୍ବର ମୂଳେ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "କେ ବୋଲେ ଏ ହାତୀ କନ୍ଧେ କେ ବସିବ",
          "କାହାର ଏଡ଼ିକି ଭାଗ୍ୟ",
          "ଗୌର ଦ୍ୱିଜ ବୋଲେ ରାସ ମଣ୍ଡଳରେ",
          "ବୃନ୍ଦାବତୀ ହେବେ ଯୋଗ୍ୟ"
        ]
      }
    ]
  },
