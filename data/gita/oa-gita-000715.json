{
  "id": "oa-gita-000715",
  "name": {
    "en": "Are kurangi drusa",
    "or": "ଆରେ କୁରଙ୍ଗୀଦୃଶା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/are-kurangi-drusa-todi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆରେ କୁରଙ୍ଗୀଦୃଶା",
          "ଆଜ ନିଶି କି ହେବ ତୋ ଦଶା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲୁଳି ପଡ଼ୁ ତୁ ପହୁଡ଼ିଲେ ମୃଦୁଳ",
          "ତୂଳୀ ତଳପରେ କ୍ଷଣେ",
          "ପୁରୁଷ ତୁଲେ କି ଖେଳିବୁ ସଂସାର",
          "ଗୁରୁ ସମର ପ୍ରାଙ୍ଗଣେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୂତନ ବୟସୀ ଜିଣିବ ଯତନ",
          "ତୁ ତ ନ ଜାଣୁ ପହିଲେ",
          "ଫତୁଆ ହେବୁ କି ସେ କାମ ଅମଳ",
          "ମତୁଆଳ ଯୁବା ତୁଲେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶରୀରଲତା ତୋ ନ ଜାଣେ ଜନମୁ",
          "ପରିରମ୍ଭ ଜାତ ପୀଡ଼ା",
          "ବରଗିଲେ ଲମ୍ବି ସହିବୁ କେହି ସେ",
          "ଅରଗଳ ଭୁଜ ଭିଡ଼ା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୋଟିଏ ସବତ ଅଳଙ୍କାର ହେଲେ",
          "ଗୋଟିଏ ନ ଘେନୁ ଚୁମ୍ବ",
          "ପୀବରସ୍ତନାରେ ବ୍ରଣେ ଏବେ ପୂରି",
          "ଯିବ ରଦବାସ ବିମ୍ବ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବିଧୁବଦନା ତୋ ଲାଜ ବଳିଯିବ",
          "ନିଧୁବନ ପରିଶ୍ରମୁଁ",
          "ରାଜୀବ ଚରଣ ଝୁଲିଲେ ନୂପୁର",
          "ବାଜିବ ଯେ ଝୁମୁ ଝୁମୁ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଭରତି କରି ସମସ୍ତ ମନୋରଥ",
          "ବରତି ଆସିବୁ କେହି",
          "ବୀର ରାମଚନ୍ଦ୍ର ଦେବ ବୋଲେ ମୋର",
          "ନିରନ୍ତର ଚିନ୍ତା ଏହି"
        ]
      }
    ]
  },
  "sources": [
    {
