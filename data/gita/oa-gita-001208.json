  "id": "oa-gita-001208",
  "name": {
    "en": "Kari juhara maguchi mu bansi tote",
    "or": "କରି ଜୁହାର ମାଗୁଛି ମୁଁ ବଂଶୀ ତୋତେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000139"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kari-juhara-maguchi-mu-bansi-tote-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କରି ଜୁହାର ମାଗୁଛି ମୁଁ ବଂଶୀ ତୋତେ",
          "ହରି କର୍ଣ୍ଣେ କହ ମୋ ଦଶା ତୁରିତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୃଷ୍ଣ ମୁଖାରବିନ୍ଦ ସମୀର ମକରନ୍ଦ",
          "ରସିକା ତୁ ଅନୁଗ୍ରହ କର ମୋତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଧରାରୁଣ ମଣି ସଜନର ଗୃହିଣୀ",
          "ପଦାବ୍ଜର ଦୂର ଦୁଃଖ ଜଣା ଯେତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତ୍ରୈଲୋକ୍ୟ ନିରୁପମ ବ୍ରଜ ବନିତା ପ୍ରେମ",
          "ଚିନ୍ତିଲେ ଶ୍ରୀ ପ୍ରତାପରୁଦ୍ର ସନ୍ତତେ"
        ]
      }
    ]
  },
  "sources": [
