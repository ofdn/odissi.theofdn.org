{
  "id": "oa-gita-001084",
  "name": {
    "en": "Syama nagara pari",
    "or": "ଶ୍ୟାମ ନାଗର ପରି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000051"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-nagara-pari-chauda-pure-gujjari-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ନାଗର ପରି",
          "ଚଉଦ ପୁରେ ନ ଥିବେ ସମସରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୋହେଁ ନନ୍ଦସୂନୁ କୁସୁମ ଧନୁ",
          "ବ୍ରଜେ ରହିଛି ତନୁ",
          "କି ଅପରୂପ ତନୁ ଚାହିଁ ନ ଯାଏ ମନୁ",
          "ଆଖିରେ ରହେ ଲାଖି ରେ",
          "ମୁଖ ଦେଖି ରେ, ଜାଣ ସଖୀ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ରମ୍ୟ ମୃଦୁହାସ କାମିନୀ ଫାଶ",
          "ଧଇର୍ଯ୍ୟ କରେ ନାଶ",
          "ବିଷ ହେଲା ଆବାସ ଅଳ୍ପ ଢାଳିଲେ ଦୃଶ",
          "ନାହିଁ ତ ସଖୀ କାହିଁ ତ",
          "ଦେଲି ଚାହିଁ ତ, ହେଲି ମୋହିତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନୁ ପାଶୋରି ନୁହେଁ ମଦନ ଦହେ",
          "ସଖୀ ଦେଖିଲେ ରହେ",
          "କେ ସେ ଶ୍ୟାମ ବିରହେ ପ୍ରାଣ ରଖିବ ଦେହେ",
          "ସହୀରେ ଆଉ ମହୀରେ",
          "ସୁଖ ନାହିଁ ରେ, ତାକୁ ଚାହିଁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ବଖାଣି ମୁରଲୀପାଣି",
          "ତନୁକୁ ଧାତା ଆଣି",
          "କେତେ ପୀୟୂଷ ଛାଣି ଗଢ଼ିଛି ନୁହେ ଜାଣି",
          "ଗୋକୁଳେ ରହିବେ ନାହିଁ",
          "କୁଳେ କୁଳବତୀ, ନ ଯାଇ ତା କତି"
        ]
      }
    ]
  },
  "sources": [
