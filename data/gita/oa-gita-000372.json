{
  "id": "oa-gita-000372",
  "name": {
    "en": "Heti nabina asichanti ana re",
    "or": "ହେଟି ନବୀନା ଆସିଛନ୍ତି ଅନାରେ"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/heti-nabina-asichanti-ana-re-kalyana-haribandhu-bebarta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହେଟି ନବୀନା ଆସିଛନ୍ତି ଅନାରେ",
          "ରସି ଗୁନ୍ଥି ସୁମନ ସୁମନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୋଷି ହେବୁ ବୋଲି ସହି ଖୋଷିବେ ଖୋଷାରେ ସେହି",
          "ଦାସୀ ପରି ରହିଛନ୍ତି ସିନାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାସବରତନ କେଶୀ ବେଶ କରିବେ ସୁରସି",
          "ରସରାଜ ମୋହନ ମୋହନାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନବୀନ ଘନ ସୁନ୍ଦର ସବିନୟେ କହେ ଗିର",
          "ଅବିନୟ ନୁହ ପ୍ରେମାଧୀନାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଳି ବଚନେ ଶ୍ରୀମତୀ ମିଳିଲେ ରମଣ କତି",
          "ଭାଳେ ହରିବନ୍ଧୁ ସେ ଭାବନାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
