{
  "id": "oa-gita-000555",
  "name": {
    "en": "Kesara kunja sejare",
    "or": "କେଶର କୁଞ୍ଜ ଶେଯରେ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kesara-kunja-sejare/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "କେଶର କୁଞ୍ଜ ଶେଯରେ",
          "ବ୍ରଜେନ୍ଦୁ ବୃନ୍ଦାଙ୍କୁ ପୁଚ୍ଛନ୍ତି ଧୀରେ",
          "ସହଚରୀ ରେ ରାଧା ବୋଲି କେ ବ୍ରଜରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଣିଲା ବେଳୁ ସେ ନାମ",
          "ସୁଧା ପାନ ପରି ଲାଗୁଛି ଶର୍ମ୍ମ",
          "ସହଚରୀ ରେ ଫିଟାଇ କହ ମରମ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚଉଦିଗକୁ ଅନାଇଁ",
          "ବୃନ୍ଦା ମନ୍ଦ ମନ୍ଦ ହସିଲା ହୋଇ",
          "କହି ଆସୁଁ ଯେ ଅଙ୍ଗେ ପୁଲକ ପୂରଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସେ ଶ୍ରୀ ବୃଷଭାନୁ ଜେମା",
          "କିଶୋରୀ ଗୋତ୍ର ନକ୍ଷତ୍ର ଚନ୍ଦ୍ରମା",
          "ରସରାଜ ହେ ରମ୍ୟ ବନ୍ଦ୍ୟ ଯା ସୁଷମା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଜୀବ ଥିବା ଯାକ ବିହି",
          "ବିଷୟ ବରଜି ବସିଲେ କହି",
          "ରସରାଜ ହେ ଶୋଭା ଶେଷ ହେବ ନାହିଁ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଥାଉ ମାଧୁରୀର ଧୂରି",
          "ତୁମ୍ଭେ ତା ପାଶେ ଥିଲେ ବଂଶୀଧାରୀ",
          "ରସରାଜ ହେ ଦିଶିବ ସୁନାଟା ପରି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଅମ୍ବା ବଳମ୍ବା ରାତିରେ",
          "ତୋଷି ହେଉଥିଲେ ବସି ଗୃହରେ",
          "ସହଚରୀ ରେ ଅଶନ କଲା କାଳରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଶ୍ୟାମସୁନ୍ଦରକୁ ମୋର",
          "ଏକା ରାଧିକା ଥିଲା ପଟାନ୍ତର",
          "ବୋଲୁଁ ଜନନୀ ନାମ ଶୁଣିଲି ତାହାର"
        ]
      },
      {
        "n": 9,
        "lines": [
          "କୃଷ୍ଣ କହନ୍ତି ବୟସ",
          "ଭାଷ କେତେ ହୋଇଥିବ ବରଷ",
          "ସହଚରୀ ରେ ବୋଲୁ ବୃନ୍ଦା ହସ ହସ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ହେ ନୂତନ ରଣ ରଣ",
          "ଯୌବନ ଲକ୍ଷ୍ମୀ ତା ପାଦେ ଶରଣ",
          "ରସରାଜ ହେ ହୋଇ ସାରିଲାଣି ଜାଣ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ବୟସ ଏଗାର ବାର",
          "ଭିତରେ ପରି ହେଉଛି ଗୋଚର",
          "ରସରାଜ ହେ ସେ ସାଧ୍ୱୀ ଶିରୋମଣିରେ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ବ୍ରଜବାସୀଙ୍କ ନୟନ",
          "ସମ୍ପତ୍ତି ସେ ଶ୍ରୀ କିଶୋରୀ ରଚନ",
          "ରସରାଜ ହେ ଆହା ଦିଶୁଛି ବଦନ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ଛଡ଼ାଇ ହୃଦୟ ମସୀ",
          "ଗୋଟିଏ ହୋଇଲେ କୋଟିଏ ଶଶୀ",
          "ରସରାଜ ହେ ରୁକ୍ଷ ପରି ଯିବ ଦିଶି"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ପରାନନ୍ଦ ସ୍ୱରୂପିଣୀ",
          "ଘୋଟିଛି ଯା କୀର୍ତ୍ତି ଜଗତ ଶ୍ରେଣୀ",
          "ରସରାଜ ହେ ସେ ସଦ୍ଗୁଣ ଗୁଣ ଖଣି"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ଦେହଳୀରେ ଗଲେ ଚାଲି",
          "ପଦାବ୍ଜ ଚିହ୍ନକୁ ଚୁମ୍ବୁଛି ଅଳି",
          "ରସରାଜ ହେ ଅଙ୍ଗମୋଦ ନୋହେ କଳି"
        ]
      },
      {
        "n": 16,
        "lines": [
          "ଶ୍ରୀ ନିଟିଳାଳକାବଳୀ",
          "କଳାମେଘ ତଳେ ରହିଲା ଭଳି",
          "ରସରାଜ ହେ ଦିଶେ ଅଚଳ ବିଜୁଳି"
        ]
      }
    ]
  },
