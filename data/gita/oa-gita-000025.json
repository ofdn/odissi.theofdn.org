{
  "id": "oa-gita-000025",
  "name": {
    "en": "Dekha dekha sakhi nipamule ubha",
    "or": "ଦେଖ ଦେଖ ସଖୀ ନୀପମୂଳେ ଉଭା"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-dekha-sakhi-nipamule-ubha/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଦେଖ ଦେଖ ସଖୀ ନୀପମୂଳେ ଉଭା",
          "ସେ ଶ୍ୟାମ ମନମୋହନ ।",
          "କୋଟି ସୃଷ୍ଟି ସାର । ପ୍ରେମ ପାରାବାର ।",
          "ବୃଷଭାନୁସୁତା । ହୃଦୟରତନ ।",
          "(ପଡ଼ି)",
          "ତ୍ରିଭଙ୍ଗ ବାଙ୍କଠାଣି ମନ ନେଉଛି କିଣି",
          "ଶିରେ ବାନ୍ଧିଛି ଜୂଡ଼ା କେତକୀଦଳେ ପୁଣି",
          "ଚିତ୍ତ ଚମକେ ଦେଖି ତା ଚଞ୍ଚଳ ଚାହାଣୀ",
          "ଅପୂର୍ବ ଅପଘନ ନୀଳେନ୍ଦ୍ରମଣି ଜିଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭାଲେ ଗୋରୋଚନା ଚନ୍ଦନ ଚର୍ଚ୍ଚିତ",
          "ଚାହାଁ ଗୋ ଚନ୍ଦ୍ରବଦନା ।",
          "ମଦନ ମୋହନ । ବଦନ ଶୋଭାକୁ ।",
          "ଶତ ରତିପତି । ନୋହିବ ତୁଳନା ।",
          "(ପଡ଼ି)",
          "କର୍ଣ୍ଣେ ହେମକୁଣ୍ଡଳ ଜିଣି ରବିମଣ୍ଡଳ",
          "ନାସାରେ ଗଜମୋତି ଦିଶେ କେଡ଼େ ମଞ୍ଜୁଳ",
          "ରକ୍ତରାଗ ରଞ୍ଜିତ ଗଣ୍ଡସ୍ଥଳ ଯୁଗଳ",
          "ମଧୁ ଅଧରେ ମୃଦୁ ସୁହାସ ମଧୁର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ରୀକରେ ମୋହନ ମୁରଲୀ ଶୋଭନ",
          "ବଜାଇ କରେ ଉଚ୍ଛନ୍ନ ।",
          "ହୃଦେ କଉସ୍ତୁଭ । ମଣିମୟ ହାର ।",
          "ଦେଖି ନ ଚଳେ । (ମୋହର) ନୟନ ।",
          "(ପଡ଼ି)",
          "ପିନ୍ଧିଛି ପୀତପଟ ନବନାଗର ଧିଟ",
          "ପଦେ ନୂପୁର ଧ୍ୱନି ଚିତ୍ତ କରେ ଉଚ୍ଚାଟ",
          "ସେ ଚରଣକମଳେ ମୋ ମନ ମଧୁଲିଟ",
          "ପରାଏ ଥାଉ ରହି ତେଜି କୂଟ କପଟ"
        ]
      }
    ]
  },
  "sources": [
