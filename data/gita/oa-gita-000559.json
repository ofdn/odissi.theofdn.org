{
  "id": "oa-gita-000559",
  "name": {
    "en": "Sri radha gobinda kebe dekhaiba",
    "or": "ଶ୍ରୀ ରାଧାଗୋବିନ୍ଦକେବେ ଦେଖାଇବ ଶ୍ରୀମୁଖ ଦ୍ୱନ୍ଦ୍ୱ ଯେ । ଘୋଷା । ରାସ ଅବସାନେ ପୁଷ୍ପ ଶେଯରେବିଜେ କରି ଗୋକୁଳେନ୍ଦୁ ଅଙ୍କରେପ୍ରାଣନାଥ ହୃଦେ ପହୁଡ଼ିବାର । ୧ । ନାଗରେନ୍ଦ୍ର ଚାହିଁ ସେ ଶ୍ରୀମୁଖକୁହସିବାର ଭିଡ଼ି ରଦ ବାସକୁଦେଖି ଲଳିତାଦି ସୁଖସିନ୍ଧୁରେରହିଥିବେ ଯେ ମଜ୍ଜି ଆନନ୍ଦରେ । ୨ । କରୁ ଖସି ପଡ଼ିଲା ସରୋରୁହହସି ବିଶାଖା କଲାର ସଂଗ୍ରହଦେଖାଇବ ବିହି କେଉଁ କାଳରେବିଞ୍ଚୁଥିବି ମୁଁ ପୁଷ୍ପ ବ୍ୟଜନରେ । ୩ । ଅଙ୍ଗ ପରିମଳରେ ଆସୁଁ […]"
  },
  "composer": "oa-person-000001",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-radha-gobinda-kebe-dekhaiba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ରୀ ରାଧାଗୋବିନ୍ଦ",
          "କେବେ ଦେଖାଇବ ଶ୍ରୀମୁଖ ଦ୍ୱନ୍ଦ୍ୱ ଯେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାସ ଅବସାନେ ପୁଷ୍ପ ଶେଯରେ",
          "ବିଜେ କରି ଗୋକୁଳେନ୍ଦୁ ଅଙ୍କରେ",
          "ପ୍ରାଣନାଥ ହୃଦେ ପହୁଡ଼ିବାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାଗରେନ୍ଦ୍ର ଚାହିଁ ସେ ଶ୍ରୀମୁଖକୁ",
          "ହସିବାର ଭିଡ଼ି ରଦ ବାସକୁ",
          "ଦେଖି ଲଳିତାଦି ସୁଖସିନ୍ଧୁରେ",
          "ରହିଥିବେ ଯେ ମଜ୍ଜି ଆନନ୍ଦରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରୁ ଖସି ପଡ଼ିଲା ସରୋରୁହ",
          "ହସି ବିଶାଖା କଲାର ସଂଗ୍ରହ",
          "ଦେଖାଇବ ବିହି କେଉଁ କାଳରେ",
          "ବିଞ୍ଚୁଥିବି ମୁଁ ପୁଷ୍ପ ବ୍ୟଜନରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଙ୍ଗ ପରିମଳରେ ଆସୁଁ ଅଳି",
          "ନିବାରିବାର ପ୍ରିୟ କର ଚାଳି",
          "ଶ୍ୱାସବଶେ ନାସାପୁଟ ମୁକୁତା",
          "ମନ୍ଦ ମନ୍ଦ ଚଳନ ରୁଚିକରତା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୁଞ୍ଜବିହାରୀ ନେତ୍ର ପୁଣ୍ୟ ପୁଞ୍ଜ",
          "ସେହିକ୍ଷଣି ହେଲା ପରି ବିଭ୍ରାଜ୍ୟ",
          "ଆହା ନବୀନ କଳା କାଦମ୍ବିନୀ",
          "ମଧ୍ୟେ ସ୍ଥିର ହେଲାପରି ଦାମିନୀ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ହସି ଲଳିତା ନିକଟକୁ ଆସି",
          "ଚାରୁ ଚିବୁକେ ସ୍ୱକର ନିବେଶି",
          "ଉଠାଉଁ ସେ ଶ୍ଳିଷ୍ଠ ବାଣୀ ବାଉଳି",
          "କହିବାର ସେ ପ୍ରାଣନାଥ ବୋଲି"
        ]
      }
    ]
  },
