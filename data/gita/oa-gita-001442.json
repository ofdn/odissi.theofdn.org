{
  "id": "oa-gita-001442",
  "name": {
    "en": "Rama basanta dekhi",
    "or": "ରାମା ବସନ୍ତ ଦେଖି"
  },
  "mula_raga": [
    "oa-raga-000183"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rama-basanta-dekhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି କରୁଥିବ ମୋ ରାମା",
          "ରସାମଣ୍ଡନା ବିମ୍ବାଧରୀରେ",
          "ବସନ୍ତ ଦେଖି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନନ୍ଦତନୟର ତାନ କାନରେ ବାଜି",
          "କୁନ୍ଦରଦନାର ଦମ୍ଭ ଯିବରେ ହଜି",
          "ମୋହ ଯାଇ ଲୋଟୁଥିବ ମହୀରେ",
          "ପ୍ରିୟସହିରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୁଣୁଗୁଣ ଭୃଙ୍ଗତାନେ ଅଧୀରା ହୋଇ",
          "ଦିବାନିଶି ଝୁରୁଥିବ ମୋ ପଥ ଚାହିଁ",
          "ଥିଲେ ଯଦି ବସିଥାନ୍ତା ପାଶରେ",
          "ପ୍ରିୟସହିରେ, ବାଇ ପରିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
