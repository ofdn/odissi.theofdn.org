  "id": "oa-gita-000791",
  "name": {
    "en": "Ghana kalia re se mo jiba jibana",
    "or": "ଘନ କାଳିଆରେ ସେ ମୋ ଜୀବଜୀବନ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000144"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ghana-kalia-re-se-mo-jiba-jibana-lalita-kedara-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘନ କାଳିଆରେ ସେ ମୋ ଜୀବଜୀବନ",
          "ମିତଣୀ ମୋ ବିତ୍ତ ସବୁ ପୀତ ଦୁକୂଳିଆ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗଲେ ଏ ପରାଣ ଯାଉ ନ ତେଜିବି ତାଙ୍କୁ ଆଉ",
          "ନାଚିଲେ ନେତ୍ରେ ସର୍ବଦା କାଳିନ୍ଦୀକୂଳିଆ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲାଗୁ କୁଳରେ କଳଙ୍କ ଜୀବିକା ମୋ ପଦ୍ମମୁଖ",
          "ଦୁଃଖପାଶୋରା ମନ୍ତର ଶିଖଣ୍ଡଚୂଳିଆ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିନାଶି ବାସ ଆଦର ମନାସୁଛି ସଙ୍ଗ ତାର",
          "ନୟନ ପିତ୍ତୁଳା ରଙ୍ଗ କାଇଞ୍ଚମାଳିଆ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହେଜି କହିଲେ ଏଣିକି ସଜନୀ ଛଳ ବାଣୀକି",
          "ତେଜିବି କି ସତେ ମନୁ ନନ୍ଦ ଦୁଲାଳିଆ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀମତୀ ଏସନ ବାଣୀ ପ୍ରିୟସଖୀ ଆଗେ ଭଣି",
          "କହେ ବନମାଳୀ ଚିନ୍ତି ବରଜଧୂଳିଆ"
        ]
      }
    ]
  },
