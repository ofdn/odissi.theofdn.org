    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦିବସ ଶେଷେ ରଜନୀ ପ୍ରବେଶେ",
          "ଭକତି ରସେ ଗାଆରେ",
          "ସକଳ ଶୁଦ୍ଧ ସୁର ସଙ୍ଗତେ",
          "ଉଭୟ ମଧ୍ୟମ ଲଗାଅରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗାନ୍ଧାର ସ୍ୱର ବାଦୀ କର",
          "ସଂବାଦୀ ରୂପ ନିଷାଦ ଧର",
          "କଲ୍ୟାଣ ମେଳ ଗାଅ ଚତୁର",
          "ଜାତି ସମ୍ପୂର୍ଣ୍ଣ ଧ୍ୟାୟରେ"
        ]
      }
    ]
  },
