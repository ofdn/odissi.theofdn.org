{
  "id": "oa-gita-001453",
  "name": {
    "en": "Pralaya payodhi jale / jaya jagadisa hare",
    "or": "ପ୍ରଳୟ ପୟୋଧି ଜଳେ / ଜୟ ଜଗଦୀଶ ହରେ"
  },
  "composer": "oa-person-000161",
  "mula_raga": [
    "oa-raga-000047"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pralaya-payodhi-jale-jaya-jagadisa-hare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରଳୟ-ପୟୋଧି-ଜଳେ ଧୃତବାନସି ବେଦମ୍",
          "ବିହିତ-ବହିତ୍ର-ଚରିତ୍ରମଖେଦମ୍",
          "କେଶବ ଧୃତ-ମୀନ-ଶରୀର ଜୟ ଜଗଦୀଶ ହରେ ।୧"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷିତିରତି-ବିପୁଳତରେ ତବ ତିଷ୍ଠତି ପୃଷ୍ଠେ",
          "ଧରଣି-ଧରଣ-କିଣ-ଚକ୍ର-ଗରିଷ୍ଠେ",
          "କେଶବ ଧୃତକଚ୍ଛପରୂପ ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବସତି ଦଶନ-ଶିଖରେ ଧରଣୀ ତବ ଲଗ୍ନା",
          "ଶଶିନି କଳଙ୍କ-କଳେବ ନିମଗ୍ନା",
          "କେଶବ ଧୃତ-ଶୂକର-ରୂପ ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତବ କର-କମଳ-ବରେ ନଖମଦ୍ଭୁତ-ଶୃଙ୍ଗମ୍",
          "ଦଳିତ-ହିରଣ୍ୟକଶିପୁ-ତନୁ-ଭୃଙ୍ଗମ୍",
          "କେଶବ ଧୃତ-ନରହରି-ରୂପ ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଛଳୟସି ବିକ୍ରମଣେ ବଳିମଦ୍ଭୁତବାମନ",
          "ପଦ-ନଖ-ନୀର-ଜନିତ-ଜନ-ପାବନ",
          "କେଶବ ଧୃତ-ବାମନ-ରୂପ ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କ୍ଷତ୍ରିୟ-ରୁଧିର-ମୟେ ଜଗଦପଗତ-ପାପମ୍",
          "ସ୍ନପୟସି ପୟସି ଶମିତ-ଭବ-ତାପମ୍",
          "କେଶବ ଧୃତ-ଭୃଗୁପୁତି-ରୂପ ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ବିତରସି ଦିକ୍ଷୁ ରଣେ ଦିକ୍‌ପତି-କମନୀୟମ୍",
          "ଦଶମୁଖମୌଳିବଳିଂ ରମଣୀୟମ୍",
          "କେଶବ ଧୃତ-ରାମ-ଶରୀର ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ବହସି ବପୁଷି ବିଶଦେ ବସନଂ ଜଳଦାଭମ୍",
          "ହଳ-ହତି-ଭୀତି-ମିଳିତ-ଯମୁନାଭମ୍",
          "କେଶବ ଧୃତ-ହଳଧର-ରୂପ ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ନିନ୍ଦସି ଯଜ୍ଞବିଧେରହହ ଶ୍ରୁତି-ଜାତମ୍",
          "ସଦୟ-ହୃଦୟ-ଦର୍ଶିତ-ପଶୁ-ଘାତମ୍",
          "କେଶବ ଧୃତ-ବୁଦ୍ଧ-ଶରୀର ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ମ୍ଳେଚ୍ଛ-ନିବହ-ନିଧନେ କଳୟସି କରବାଳମ୍",
          "ଧୂମକେତୁମିବ କିମପି କରାଳମ୍",
          "କେଶବ ଧୃତ-କଳ୍କି-ଶରୀର ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ଶ୍ରୀ-ଜୟଦେବ-କବେରିଦମୁଦିତ-ମୁଦାରମ୍",
          "ଶୃଣୁ ଶୁଭଦଂ ସୁଖଦଂ ଭବସାରମ୍",
          "କେଶବ ଧୃତ-ଦଶବିଧ-ରୂପ ଜୟ ଜଗଦୀଶ ହରେ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ବେଦାନୁଦ୍ଧରତେ ଜଗନ୍ନିବହତେ ଭୂଗୋଳମୁଦ୍‌ବିଭ୍ରତେ",
          "ଦୈତ୍ୟଂ ଦାରୟତେ ବଳିଂ ଛଳୟତେ କ୍ଷତ୍ରକ୍ଷୟଂ କୁର୍ବତେ ।",
          "ପୌଳସ୍ତ୍ୟଂ ଜୟତେ ହଳଂ କଳୟତେ କାରୁଣ୍ୟମାତନ୍ୱତେ",
          "ମ୍ଳେଚ୍ଛାନ୍ ମୂର୍ଚ୍ଛୟତେ ଦଶାକୃତିକୃତେ କୃଷ୍ଣାୟ ତୁଭ୍ୟଂ ନମଃ ।"
        ]
      }
    ]
  },
