{
  "id": "oa-gita-000490",
  "name": {
    "en": "Etharaka syama dosa kara khyama",
    "or": "ଏଥରକ ଶ୍ୟାମ ଦୋଷ କର କ୍ଷମା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/etharaka-syama-dosa-kara-khyama-kirabani-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏଥରକ ଶ୍ୟାମ ଦୋଷ କର କ୍ଷମା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପଦ ତଳେ ପଡ଼ି ଯାଉଛନ୍ତି ସଢ଼ି",
          "ତୋଳ ହେଲେ ଶ୍ରୀମୁଖ ଚନ୍ଦ୍ରମା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ ଘୋଡ଼ା ଶ୍ରବଣ କହୁଛନ୍ତି ଶୁଣ",
          "କୃପାନିଧି ବୃଷଭାନୁ ଜେମା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେତେ ଥର ସହି ଯାଇନାହୁଁ ସହି",
          "ଅପରାଧ ଯାକ ଘେନି ପ୍ରମା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଶୁପ ନଗରୀ ଶିରୀ ଯିବ ସରି",
          "ନ ଚାହିଁଲେ କେଶରୀ ମଧ୍ୟମା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ସେ ସମୟରେ ଭାଷେ",
          "ଅର୍ଦ୍ଧ ହୋଇଗଲାନି ତ୍ରିଯାମା ରେ"
        ]
      }
    ]
  },
  "sources": [
