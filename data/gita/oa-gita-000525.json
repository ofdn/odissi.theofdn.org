{
  "id": "oa-gita-000525",
  "name": {
    "en": "Dinabandhu ehi ali sri chhamure",
    "or": "ଦୀନବନ୍ଧୁ ଏହି ଅଳି ଶ୍ରୀଛାମୁରେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dinabandhu-ehi-ali-sri-chhamure-saberi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦୀନବନ୍ଧୁ ଏହି ଅଳି ଶ୍ରୀଛାମୁରେ",
          "ଶ୍ରୀରଙ୍ଗା ଚରଣ ସେବାରେ ମୋ ମନ",
          "ରହିଥାଉ ନିରନ୍ତରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦାନା କନା ପଛେ ମନା ହେଉ ମୋତେ",
          "ନୀଳଚକ୍ର ବାନା ଚାହିଁ",
          "ସୁଖୀ ହେଉଥିବି ଅଖିଳପତି ହେ",
          "ନିର୍ଦ୍ଦୟ ହୋଇବ ନାହିଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାର ମାସେ ତେର ଯାତ୍ରା ଦେଖୁଥିବି",
          "ଶ୍ରୀକ୍ଷେତ୍ରେ ହୋଇ ଭିକାରୀ",
          "ସାଧୁ ସନ୍ଥଙ୍କର ବୋଲାଇ କିଙ୍କର",
          "ମାଗୁଥିବି ମଧୁକରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆନନ୍ଦ ବଜାରେ ବୁଲିଣ ମଜ୍ଜାରେ",
          "ଗାଉଥିବେ ତୋର ନାମ",
          "ତୋ ପ୍ରେମ ସାଗରେ ବୁଡ଼ି ଯାଉଥିବି",
          "ବୋଲି ହରେ କୃଷ୍ଣ ରାମ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏଥି ପାଇଁ କୁଳ ମୂଳ ହରାଇଛି",
          "ସାଥୀ କରି ତୋତେ ଏକା",
          "ଦାସ ବନମାଳୀ ଦୋଷ ନ ଧରିବୁ",
          "ଗୋବର୍ଦ୍ଧନ ଗିରିଟେକା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dinabandhu-ehi-ali-sri-chhamure-saberi-banamali/"
    }
  ],
