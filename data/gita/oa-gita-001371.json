  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-go-duti-chinta-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁ ଗୋ ଦୂତୀ ଚାହାଁ ଗୋ ଦୂତୀ",
          "କଦମ୍ବ ମୂଳରେ ଶୋଭା ନବଘନ ମୂରତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିରେ ଶିଖଣ୍ଡୀ ଚୂଡ଼ା ମଲ୍ଲୀ ମାଳରେ ବେଢ଼ା",
          "ଯୁବତୀ ଜ୍ଞାନବୁଡ଼ା କୁଳ ମହତଛଡ଼ା",
          "ତ୍ରିଭଙ୍ଗୀ ଛନ୍ଦେ ଛିଡ଼ା ନୁହେଁ ନେତ୍ର ପିଛଡ଼ା",
          "ଦେଖି ତା ରୀତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କର୍ଣ୍ଣେ ହେମ କୁଣ୍ଡଳ ଲୁଳଇ ଗଣ୍ଡସ୍ଥଳ",
          "ହୃଦରେ ବନମାଳ ନାସାରେ ମୋତିଫଳ",
          "ଆହା ସେ ନନ୍ଦବାଳ ଦିଶନ୍ତି କି ମଞ୍ଜୁଳ",
          "ନେତ୍ର ସମ୍ପତ୍ତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୀତାମ୍ବର କାଛେଣି ଦିଶେ କି ଶୋଭା ପୁଣି",
          "କିଙ୍କିଣୀ କିଣିକିଣି ନାଦେ ନିଅଇ କିଣି",
          "ତା ନୂପୁର ବାଜେଣୀ କେଡ଼େ ମଧୁର ଧ୍ୱନି",
          "ହରଇ ଧୃତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋରୋଚନା କସ୍ତୁରୀ ଚିତା ସିନ୍ଦୂର ଶିରୀ",
          "ଚନ୍ଦନପାଟି ହରି ନିଅଇ ଚିତ୍ତ ଶୀରି",
          "ବେଣୁଧର ସେ ହରି ପଦ୍ମପାଦେ ଜୁହାରି",
          "କରେ ବିନତି"
        ]
      }
    ]
  },
  "sources": [
