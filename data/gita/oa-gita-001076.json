{
  "id": "oa-gita-001076",
  "name": {
    "en": "E ki saja debaraja",
    "or": "ଏ କି ସଜ ଦେବରାଜ"
  },
  "composer": "oa-person-000075",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-ki-saja-debaraja-somanatha-singha-akrura-gamana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ କି ସଜ ଦେବରାଜ ଦୂତ ଘେନିଣ ସଙ୍ଗର ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେଉଅଛ ତରତର ଛବି ତ ଭିନ୍ନ ପ୍ରକାର",
          "ତେଜିବ କି ଏବେ ଗୋପ ବନିତା",
          "ବୋଲି ଆମ୍ଭଙ୍କୁ ଲାଗୁଅଛି ଚିନ୍ତା",
          "ଏ କି ଉଚିତ ହେ ଜଗଜ୍ଜିତା",
          "କେ ଦେଲା ଯନ୍ତର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷଣେ ହେଉଥିଲେ ଭିନ୍ନ ଉଡ଼ି ଯାଉଥାଏ ଜ୍ଞାନ",
          "ଦିଶୁଅଛି ଘେନିବ କି ପ୍ରାଣ",
          "ବିଚିତ୍ର ମାନୁଛି ହେ ଶ୍ୟାମଘନ",
          "ଶୁଣା ତ ନ ଥିଲା କାଳେ ଏମାନ",
          "କହିବୁ କାହାରେ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାଗରୀ ନାଶ ନ କର ଛାଡ଼ ମନୁ ଏ ବିଚାର",
          "ନିଷ୍ଠୁର ହୃଦୟକୁ ଧରିବାର",
          "ଛାଡ଼ ଛାଡ଼ ଏଣୁ ଯାଉ ଯେ ଦୂର",
          "ବୋଲାଉଅଛ ନାଗରଙ୍କ ବର",
          "ଘେନ ଘେନ ବାରେ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସବୁ ରୂପେ କରି ଆଶ ହେଉଥାଉ ରାତ୍ରି ଶେଷ",
          "ନିରାଶ ନ ଜାଣି କରି ବିଶ୍ୱାସ",
          "ଯେସନେ ଚାତକ ଘନକୁ ଆଶ",
          "ଏବେ ଜଣାଗଲା ତୁମ ନିରାଶ",
          "ବଞ୍ଚିବୁ କାହାରେ ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନ ଯାଅ ଆମ୍ଭ ଶପଥ କହୁଅଛୁ ପଦ୍ମନେତ୍ର",
          "ଗଲେ ଦେଇଯାଅ ଢୋକାଇ ବିଷ",
          "ଯଦି ଏଥିରେ ଅଛି ପୌରୁଷ",
          "ଭଣେ ସୋମନାଥ ସିଂହ ନରେଶ",
          "ଶୁଣୁ ନାହଁ କର୍ଣ୍ଣରେ ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
