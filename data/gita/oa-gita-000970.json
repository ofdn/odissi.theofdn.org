{
  "id": "oa-gita-000970",
  "name": {
    "en": "Kahin gale sakhi jamuna kulia",
    "or": "କାହିଁ ଗଲେ ସଖୀ ଯମୁନା କୂଳିଆ"
  },
  "composer": "oa-person-000133",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahin-gale-sakhi-jamuna-kulia-kartika/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁ ଗଲେ ସଖୀ ଯମୁନା କୂଳିଆ",
          "କଦମ୍ବମୂଳିଆ କାଳିଆ",
          "ବେଶ ନଟବର ମୁରଲୀ ଅଧର",
          "ମୋହନ ଶିଖଣ୍ଡଚୂଳିଆ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିନେ ଯାହା କଲେ କଦମ୍ବ ମୂଳେ",
          "କଳା ଭୂତ ହେଲେ ରାଧା ମନ୍ଦିରେ",
          "ମାୟାଧର କେତେ ମାୟା କରି ପୁଣି",
          "ହୋଇଲେ ସେ ଗୋପ ଗୁଣିଆ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତା ଲାଗି ଆମ୍ଭଙ୍କୁ ଯମୁନା ମନା",
          "ଗୋପେ ବାଜୁଅଛି ନିନ୍ଦା ବାଜଣା",
          "ପାଟକ କୁଳରେ ଅଟକ ଲଗାନ୍ତି",
          "କଳାଚାନ୍ଦ ଗୁଞ୍ଜମାଳିଆ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଇନ୍ଦ୍ର ବିବାଦରେ ମନ୍ଦର ଧରି",
          "ଗୋପେ ରକ୍ଷା କଲ ଗୋପ ଗୁଆଳି",
          "କାଳିନ୍ଦୀରେ ପଶି କାଳୀକି ଦଳିଲେ",
          "ଯା କଲେ ଗୋରଜ ଧୂଳିଆ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେଉଁ କୁଞ୍ଜେ ଛନ୍ତି ଖୋଜିବା ଯାଇଁ",
          "ସେ ପଦେ ଏ ଦ୍ୱିଜ କାର୍ତ୍ତିକ କହି",
          "ଚାଲ ଯିବା ବନେ ଉଲ୍ଲସିତ ମନେ",
          "ଗଳେ ରୁଞ୍ଜଗୁଞ୍ଜମାଳିଆ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahin-gale-sakhi-jamuna-kulia-kartika/"
    }
  ],
