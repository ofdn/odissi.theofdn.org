{
  "id": "oa-gita-001308",
  "name": {
    "en": "Jagabandhu pari jane samanta",
    "or": "ଜଗବନ୍ଧୁ ପରି ଜଣେ ସାମନ୍ତ ନାହିଁ ନାହିଁ ତ"
  },
  "composer": "oa-person-000050",
  "mula_raga": [
    "oa-raga-000034"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jagabandhu-pari-jane-samanta-krusna-kedara-dinakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଗବନ୍ଧୁ ପରି ଜଣେ ସାମନ୍ତ ନାହିଁ ନାହିଁ ତ",
          "ଚଉଦ ଭୁବନ ବାରତା ଜାଣନ୍ତି",
          "ଚକ୍ରରେ ଛେଦନ୍ତି ଆରତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେତେବେଳେ କୃଷ୍ଣ ଗୋପପୁରେ ଥିଲେ",
          "ଅକ୍ରୂର ଆଣିଣ ଗଲା ତ",
          "ଗାଇ ଦୁହୁଁ ଦୁହୁଁ କେଶ ଫିଟିଗଲା",
          "ଚତୁର୍ଭୁଜ ହେଲେ ଅନନ୍ତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସୁଗ୍ରୀବର ସଙ୍ଗେ ମଇତ୍ର ହୋଇଣ",
          "ବାଳୀକି ବିନାଶ କଲେ ତ",
          "ରାବଣ ଭ୍ରାତା ଯେ ଶରଣ ପଶିଲା",
          "ଲଙ୍କାଗଡ଼ ତାକୁ ଦେଲେ ତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୁରୁସଭା ତଳେ ଦ୍ରୌପଦୀ ଚିନ୍ତିଲା",
          "କୋଟି ବସ୍ତ୍ର ଦିଆଇଲେ ତ",
          "ଭାରତ ଯୁଦ୍ଧରେ ଭରତିଆ ପକ୍ଷୀ",
          "ଘଣ୍ଟ ଘୋଡ଼ାଇ ରଖିଲେ ତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏମନ୍ତ ସାମନ୍ତ ତ୍ରିଭୁବନେ ନାହିଁ",
          "ନାଶନେ ଆରତୀ ଆରତ",
          "କହେ ଦୀନକୃଷ୍ଣ ଦାସ ଯେ ଶ୍ରୀକୃଷ୍ଣ",
          "ପଦ୍ମ ପାଦ ଚିତ୍ତେ ଧ୍ୟାୟି ତ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
