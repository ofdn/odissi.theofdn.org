{
  "id": "oa-gita-000939",
  "name": {
    "en": "Rasabati sange range",
    "or": "ରସବତୀ ସଙ୍ଗେ ରଙ୍ଗେ"
  },
  "composer": "oa-person-000130",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasabati-sange-range-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରସବତୀ ସଙ୍ଗେ ରଙ୍ଗେ ରସିକ",
          "ରଙ୍ଗେ ରସିକଶେଖର ବିହରିଲେ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଝଳି ପୂର୍ଣ୍ଣଚନ୍ଦ୍ର ରଜନୀ",
          "ଝଳି ପୂର୍ଣ୍ଣ ଚନ୍ଦ୍ରବଦନୀ",
          "ବ୍ରଜ ଯୁବରାଜ ଭେଳା କରି ଆଜ",
          "କିବା ରସସିନ୍ଧୁ ପହଁରିଲେ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାମରାଜ ସଙ୍ଗେ ସମର",
          "ଇଚ୍ଛା କରି ନାଗରୀବର",
          "ନାଗରରାଜଙ୍କୁ କିପରି କରିକି",
          "ପୁଲିନ କାନନୁ ବୁହାଇଲେ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଞ୍ଚବାଣ ପ୍ରପଞ୍ଚ ଦାଉ",
          "ପାଞ୍ଚିବାକୁ କି ଅଛି ଆଉ",
          "ଲାଜ ଧନ ଲାଞ୍ଚ ଦେଇ କାଞ୍ଚଲାକୁ",
          "ଚଞ୍ଚଳ ଭଙ୍ଗୀକି ସଂହରିଲେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭୂରୁ ଚାପେ ଅଞ୍ଜନ ଗୁଣ",
          "ରଖି ଯୋଖି ନୟନବାଣ",
          "କିବା ଉଦ୍ଦେଶ୍ୟରେ ବୁଝିବା କାଳରେ",
          "ଦମ୍ଭେ ଦମ୍ଭୋଳୀକି ଜୁହାରିଲେ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରୁଣଝୁଣ ନୂପୁର ନାଦ",
          "ରଣଜୟ ଟମକ ନାଦ",
          "ଭାଷେ ଶ୍ରୀଚନ୍ଦନ ହେରି ଏ ବିଧାନ",
          "ଜାଣି କାମରାଜ ଓହରିଲେ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasabati-sange-range-srichandana/"
    }
  ],
