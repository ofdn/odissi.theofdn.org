{
  "id": "oa-gita-001378",
  "name": {
    "en": "Prana sangini go nahi ambha banamali",
    "or": "ପ୍ରାଣ ସଙ୍ଗିନୀ ଗୋ ନାହିଁ ଆମ୍ଭ ବନମାଳୀ । ଘୋଷା । ଦେଖ ଏ କାଳିକା କାଳୀକୁଣ୍ଡଳୀ ଆସୁଛି ଖେଳି । ୧ । ଆସେ ବିଜୁଳି ରସନା ଚାଳିସେ ସିନା କାଳୀକି ଦଳି । ୨ । କାଳିନ୍ଦୀରେ କଲେ କେଳିସଙ୍ଗେ ଘେନି ବ୍ରଜବାଳୀ । ୩ । ଏହି ରସେ ଭାଳି ଭାଳିଗୀତେ କହେ ବନମାଳୀ । ୪ ।"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000197"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
