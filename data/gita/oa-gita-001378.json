    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣ ସଙ୍ଗିନୀ ଗୋ ନାହିଁ ଆମ୍ଭ ବନମାଳୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖ ଏ କାଳିକା କାଳୀ",
          "କୁଣ୍ଡଳୀ ଆସୁଛି ଖେଳି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆସେ ବିଜୁଳି ରସନା ଚାଳି",
          "ସେ ସିନା କାଳୀକି ଦଳି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାଳିନ୍ଦୀରେ କଲେ କେଳି",
          "ସଙ୍ଗେ ଘେନି ବ୍ରଜବାଳୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏହି ରସେ ଭାଳି ଭାଳି",
          "ଗୀତେ କହେ ବନମାଳୀ"
        ]
      }
    ]
  },
