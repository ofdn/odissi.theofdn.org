{
  "id": "oa-gita-000530",
  "name": {
    "en": "Kahin se mora kisori",
    "or": "କାହିଁ ସେ ମୋର କିଶୋରୀ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000047"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahin-se-mora-kisori-malaba-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁ ସେ ମୋର କିଶୋରୀ",
          "ଯାଏ ମୋ ପରାଣ ଛାଡ଼ି",
          "ମାରଇ ମୋତେ ଶମ୍ବରାରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୟନ ମୋ ପିପାସିର",
          "ଖୋଜେ ତାକୁ ଅବିରତ",
          "ଦେଖୁ ଦେଖୁ ଗୋଟିଯାକ",
          "ପିଇଦେବିକି ରୂପ ମାଧୁରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହୃଦରୁ ଉଠେ ଉଚ୍ଛ୍ୱାସ",
          "ଘନ ଘନ ବହେ ଶ୍ୱାସ",
          "ଲୋଡ଼େ ଏକା ତା ସଙ୍ଗତି",
          "ଆହା ସେ ରାଜକୁମାରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାଇଲେ ତାର ଶ୍ରୀଅଙ୍ଗ",
          "ଯୋଡ଼ିଦେବି ମୋର ଅଙ୍ଗ",
          "କିବା କରିବ ଅନଙ୍ଗ",
          "ଧରାଇ ବିରହ ବାଂଶରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଦାସ ଭଣି",
          "ଶୁଣ ହେ ମୁରଲୀପାଣି",
          "ତୁମ୍ଭ ଲାଗି ଠାକୁରାଣୀ",
          "ବସିଛନ୍ତି ଧ୍ୟାନ କରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
