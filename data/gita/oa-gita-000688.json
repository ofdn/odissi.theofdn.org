{
  "id": "oa-gita-000688",
  "name": {
    "en": "Mukhe thoi nahi nahi",
    "or": "ମୁଖେ ଥୋଇ ନାହିଁ ନାହିଁ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000168"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mukhe-thoi-nahi-nahi-kasmira-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୁଖେ ଥୋଇ ନାହିଁ ନାହିଁ ଚିତ୍ତେ ଅଙ୍ଗୀକାର ରହି",
          "ସାର ଗାର ରତି ରଙ୍ଗିଣୀ ଗଣପତି",
          "ଗଜଗତି କି ମତିରେ",
          "କିଛି ପଛକୁ ଘୁଞ୍ଚୁ ଲଜ୍ଜିତେ ମୁଖେ ବାସ ଆଚ୍ଛାଦି",
          "ରହ ରହ ବୋଲି ସଙ୍ଗିନୀକି କହିବା ବେଳି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେଳି ମନ୍ଦିରକୁ ଯିବା ବେଳେ",
          "ରମଣୀ ମଘବା ପଛୁଁ ପ୍ରିୟ ଆଳି ଛଳେ",
          "ଘେନାଇ କହିବା ବେଳେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏ ସମୟେ ନବ ବାଳୀ",
          "ଦେହଳୀ ନ ଯାଉଁ ବଳି",
          "ଧୀରେ ସଜନୀ ନିଶ୍ରେଣୀ ପେଲି",
          "ଦିଅନ୍ତେ ରମଣୀ ମେଳେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପରସ୍ପରରେ ବଖାଣି",
          "ଏଥର ଯିବା ମିତଣୀ",
          "ସମର୍ପିଣ କାନ୍ତ କୋଳେ",
          "ବୋଲି କରକୁ ଧରିଲେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୋହଲାଇ ନାସାମଣି",
          "କି ରଙ୍ଗେ ବକ୍ର ଚାହାଣୀ",
          "ନୁଆଇଁ ଚନ୍ଦ୍ରଲପନ",
          "ଶୁଣି ଟାପରା ବଚନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆଦରି ହେବୁ ତୁ କାନ୍ତେ",
          "ଯାଅ ସଙ୍ଗାତ ତୁରିତେ",
          "ଭୟ ନ କର ହୃଦାନ୍ତେ",
          "ବୀରବିକ୍ରମ ବୋଲନ୍ତେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
