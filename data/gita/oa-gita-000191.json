{
  "id": "oa-gita-000191",
  "name": {
    "en": "Binajina bharati tu suna re",
    "or": "ବୀଣାଜିଣା ଭାରତୀ ତୁ ଶୁଣାରେ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000054"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/binajina-bharati-tu-suna-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବୀଣାଜିଣା ଭାରତୀ ତୁ ଶୁଣାରେ",
          "ଆଜନମ ଦାସ ଆଶା ନ ନାଶି ତୁ",
          "କର ମାନସ ପୂରଣାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧରାଲୋକ ପରା ତୁହି ବସନା",
          "ଧୀରା କରଜରେ ମହୀ ଲେଖନା",
          "ଧରାସ୍ତନା ପରକୁହା ଶୁଣି ଯାହା",
          "ଅନୁରାଗ କଲୁ ଊଣାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାରି ବାରିଦିଅ ରମ୍ୟ ନୟନୁ",
          "ନାରୀରତନ କହ କେ ତୋ ବିନୁ",
          "ଗତି ନ ଥିବାର ବାରଣଗମନା",
          "ନୁହଇ କି ତୋତେ ଜଣାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସାଜି ଦେବି ଘନଜିତ ଚିକୁର",
          "ମାଜି ଦେଖାଇବି ଆଣି ମୁକୁର",
          "ରାଜୀବାକ୍ଷି ରାଜି କରୁ କିନା ଥରେ",
          "ବିହି ଅପାର କରୁଣାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦର୍ପ ଦର୍ପକର ଦର ଏ ବାର",
          "ପର୍ବ ଶର୍ବରୀଶ ମୁଖୀ ନିବାର",
          "କାଞ୍ଚନବରନା ଶ୍ୱାସ ତୁ ମୁଞ୍ଚନା",
          "ଫୁଲାଇ ସୁସଞ୍ଚ ଘେନାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଉପଇନ୍ଦ୍ରର ଘେନ ଏ ଅରଜ",
          "ଶୁଣ ସୁମନୁ ମାନକୁ ବରଜ",
          "ସୁବରଜ ତନୁ ପାଇ ଚମ୍ପାଗୋରୀ",
          "ହେଲି ମୁଁ ତୋର କିଣାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
