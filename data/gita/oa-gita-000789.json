{
  "id": "oa-gita-000789",
  "name": {
    "en": "Aha sasi badana",
    "or": "ଆହା ଶଶୀବଦନା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000098"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-sasi-badana-bhupala-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା ଶଶୀବଦନା ଏ ମୋ ନାଶିବ",
          "ଅଶିବ ଅଶ୍ରୁ ନ ବରଷିବ",
          "ଦିଶିବ ସବୁ ଶିରୀ ବସି ତୋ ଗୁଣ ସ୍ମରି",
          "ଶିଶିରେ ପଦ୍ମ ପରି ନାଶିବ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହସି ବଚନ କେବେ ଭାଷିବ",
          "ଅସିତକେଶୀ ଦୁଃଖ ନାଶିବ",
          "ରୁଷି ବସନା ସହି ଭାସିଲେ ଥରେ ମୁହିଁ",
          "ଆସି ବିବେକ ତାପ ଧ୍ୱଂସିବ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୋଷିଲା ଜନ ଯେବେ ନାଶିବ",
          "ଋଷିମୋହିନୀ ନିନ୍ଦା ଦିଶିବ",
          "ମିଶି ମୋ ଅଙ୍କେ ଆସି ହସି ଅଳ୍ପେ ନ ଭାଷି",
          "ବସିଲେ ମାର ଅହି ଦଂଶିବ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରସି ସୁରତେ ଯେବେ ରସିବ",
          "କଷିଲା ସ୍ମରକାଣ୍ଡ ଖସିବ",
          "ପେଷି ହୋଇଲି ଏଣୀଦୃଶୀ ମୋ କଣ୍ଠ ଶ୍ରେଣୀ",
          "ପଶି କି କାମଭୂତ ଗ୍ରାସିବ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୋଷୀ ହୋଇଲ ଏହା ଭାଷିବ",
          "ଭୂଷି କରଜେ ଅଙ୍ଗ ଚଷିବ",
          "ତୃଷିତ ମୁହିଁ ଚିର ନିଶି ଦିବସେ ଦର",
          "ହାସୀ ବନମାଳୀକି ତୋଷିବ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-sasi-badana-bhupala-banamali/"
    }
  ],
