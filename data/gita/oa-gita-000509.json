{
  "id": "oa-gita-000509",
  "name": {
    "en": "Darahasi kara khyama",
    "or": "ଦରହାସୀ କର କ୍ଷମା"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/darahasi-kara-khyama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦରହାସୀ",
          "କର କ୍ଷମା ମୁଁ ବଡ଼ ସାହସୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧରାଶିର ଚମ୍ପାଝରା ରମ୍ୟ ମନ୍ଦାର ଅଧରା",
          "ତୁ ଏକା ମୋ ଗତି ପରା ସକଳ ସୁଖ ପସରା",
          "ନ ରଖିଲେ ଏବେ ଯିବି ଭାସି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାଣି ଅବା ମୁଁ ନ ଜାଣି ଅତିକ୍ରମି ତୋର ବାଣୀ",
          "ଦୋଷ କଲିଣି ପ୍ରମାଣି ଚିତ୍ତେ ପ୍ରମାଦକୁ ଆଣି",
          "ତେଜ ତାହା ଦୟା ପରକାଶି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅପରାଧକୁ ଦାସରେ ପ୍ରଭୁ ଯେବେ ମାନସରେ",
          "ଧରିବ ଅନବସରେ ବଞ୍ଚିବ କି ସେ ଶେଷରେ",
          "ଏତେ ଭାଳି ମାନ ଦିଅ ନାଶି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଧରୁଅଛି ତୋ ପାଣିକି ଘେନ ବିନୟ ବାଣୀକି",
          "ରାମାରତନ ଏଣିକି ନ ଚାହିଁବି ରେ କେଣିକି",
          "ସ୍ମିତ ମୁଖେ ଅନା ଫେରି ଆସି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସ୍ୱର୍ଣ୍ଣପୁର ଯୁବରାଜ ଭାଷେ ଏ ରୀତିକି ଆଜ",
          "ଜାଣିଲେ ଫୁଲନାରାଜ ରଚିବ ଦଣ୍ଡସମାଜ",
          "କେଉଁ ଯଶ ହେବ ଦାସ ନାଶି ରେ"
        ]
      }
    ]
  },
  "sources": [
