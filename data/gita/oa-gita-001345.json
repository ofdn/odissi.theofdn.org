{
  "id": "oa-gita-001345",
  "name": {
    "en": "Rusichu ki maa sankari",
    "or": "ରୁଷିଛୁ କି ମା ଶଙ୍କରୀ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rusichu-ki-maa-sankari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରୁଷିଛୁ କି ମା ଶଙ୍କରୀ",
          "ରୁଷାଇଲା କେ କି କରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଫିଟିଛି ପ୍ରଳମ୍ବ କେଶ",
          "ଅଯତନ ବେଶ ବାସ",
          "ଜବା ତେଜି ଆଜ ଏ କି",
          "ଗଳେ ତୋର ମୁଣ୍ଡମାଳି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଦନେ କାଳିମା ଛାଇ",
          "କାହିଁ ସେ ସରସ ନାହିଁ",
          "ଚିହ୍ନି ତ ନ ହୁଏ ଆଉ",
          "ତୁହି ମା ଗଉରୀ ବୋଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଡର ଲାଗେ ହେରି ତୋତେ",
          "ବରାଭୟ ତେଜି ସତେ",
          "ଏ କି ମା ପ୍ରଳୟ ଖେଳେ",
          "ମାତିଛୁ ଗୋ ଦିଗମ୍ବରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭୋଳା ହର ଗଙ୍ଗା ତୁଲେ",
          "ମାତ ଏ କି ଦୁଃଖ ଦେଲେ",
          "ଅନା ମା ଚରଣ ତଳେ",
          "ଆଣିଛି ମୁଁ ଶିବେ ଧରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
