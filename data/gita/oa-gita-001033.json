{
  "id": "oa-gita-001033",
  "name": {
    "en": "Manda pala pika manda",
    "or": "ମନ୍ଦ ପାଳ ପିକ ମନ୍ଦ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manda-pala-pika-manda-punnaga-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୋକିଳ ନିନ୍ଦା",
          "ମନ୍ଦ ପାଳ ପିକ ମନ୍ଦ କାଳ ଆରେ ଆରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳକଣ୍ଠ ନାମ ତୋର କଳପିଛି ବେଦବର",
          "କାଳକଣ୍ଠ ହେବା ବଶୁଁ କାଳ ତୁ ବିରହିଣୀର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପରଭୃତ ନାମ ବହୁ ପରକୁ ସନ୍ତାପ ବିହୁ",
          "ପରମ ବିବେକୀ ଜନେ ପରଶଂସା ହେବୁ କାହୁଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚିର ପ୍ରୀତିକି ହଜାଇ ପରରେ ମାଡ଼ୁଛି ଯେ ତୁହି",
          "ତାର ମନ ମୋହିବାକୁ ତୁ ରବ କର ସେଠାଇଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବି ସୁଧାନିଧି ଭଣି କିଶୋରୀ ବଚନ ଗୁଣି",
          "ସବିକଳ ମନ ହୋଇ ଶ୍ରୀମତୀ କହନ୍ତି ପୁଣି"
        ]
      }
    ]
  },
  "sources": [
