  "name": {
    "en": "Biraje mohana re",
    "or": "ବିରାଜେ ମୋହନ ରେ"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000050"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/biraje-mohana-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିରାଜେ ମୋହନ ରେ",
          "ଆସ ରାସ କୁଞ୍ଜେ କଞ୍ଜନୟନୀ ବହନରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଂସାରର ସାର ରସ ସରସୀ ସମାନ",
          "ରତିପତି କୃତି ଘେନେ ଅପଘନରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦେଖିଲେ କମଳଦଳ କୋମଳ ବଦନ",
          "ଭାବ କାନ୍ତ କାନ୍ତି ପନ୍ତି ନିନ୍ଦନ୍ତି ସୁମନ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୁଣ୍ୟପୁଞ୍ଜ କି ବା କୁଞ୍ଜ କରିଛି ମଣ୍ଡନ",
          "ପବିତ୍ର ହୋଇବ ନେତ୍ର କଲେ ଦରଶନ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଧୀରାଧରା ମଣ୍ଡନା ତୁ ଲଭିଲେ ଆସନ",
          "ବନ୍ଧୁ ପାଶେ ସୁଖସିନ୍ଧୁ ଉଚ୍ଛୁଳିବ ଜାଣ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
