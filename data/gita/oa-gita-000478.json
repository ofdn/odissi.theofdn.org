{
  "id": "oa-gita-000478",
  "name": {
    "en": "Mita mitani re jaha mu dekhili aja",
    "or": "ମିତ ମିତଣୀରେ ଯାହା ମୁଁ ଦେଖିଲି ଆଜ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mita-mitani-re-jaha-mu-dekhili-aja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମିତ ମିତଣୀରେ",
          "ଯାହା ମୁଁ ଦେଖିଲି ଆଜ",
          "ଶୁଣିବା ଲୋକର ମନକୁ ନ ଆସେ",
          "କହିବା ଲୋକକୁ ଲାଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପୁରୁଷର ଇନ୍ଦ୍ରି ଠୂଳେ ନାହିଁ କିଛି",
          "ସ୍ତିରୀ ନୁହେଁ ସେ ପଦ୍ମିନୀ",
          "ଅତି ହରଷରେ ରତି କରୁଥାନ୍ତି",
          "ନାହିଁ ଦିବସ ରଜନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କିଛି ଦିନ ଅନ୍ତେ ପୁତ୍ର ଜନମିଲା",
          "କୁଆଁ କୁଆଁ ରାବ ଦେଇ",
          "ସ୍ତନ ନାହିଁ ପୁତ୍ର କ୍ଷୀର ଖାଉଅଛି",
          "ମୁଖଗୋଟି ତାର ନାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାଦ ନାହିଁ ପୁତ୍ର ଗମନ କରଇ",
          "କର୍ଣ୍ଣ ନାହିଁ ବାକ୍ୟ ଶୁଣେ",
          "ଚକ୍ଷୁ ନାହିଁ ପୁତ୍ର ତିନିପୁର ଦେଖେ",
          "ଜିହ୍ୱା ନାହିଁ ସ୍ୱାଦୁ ମଣେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭଣେ ଉପଇଦ୍ର ଭଞ୍ଜ ବୀରବର",
          "ଏ ରସରୁ ରସ ନାହିଁ",
          "କବିକି ଛମାସ ଜ୍ଞାନୀକି ବରଷେ",
          "ମୂର୍ଖ ତା ବୁଝିବ କାହିଁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
