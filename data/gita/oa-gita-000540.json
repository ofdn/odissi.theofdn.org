{
  "id": "oa-gita-000540",
  "name": {
    "en": "Koli ke neba re bahana hoina asa",
    "or": "କୋଳି କେ ନେବରେ ବହନ ହୋଇଣ ଆସ"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000091"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/koli-ke-neba-re-bahana-hoina-asa-kolibika/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୋଳି କେ ନେବରେ ବହନ ହୋଇଣ ଆସ",
          "ବୃନ୍ଦାବନ କୋଳି ଅମୃତରୁ ସ୍ୱାଦ",
          "କର୍ପୂରକୁ ଜିଣି ବାସ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାର ମନ ଧନ ଅଛି ସେ ବହନ",
          "ୟେ ଫଳ ମୂଲାଇ ନିଅ",
          "ଆଗ ପାନ କର କେମନ୍ତେ ମଧୁର",
          "ପଛନ୍ତେ କଉଡ଼ି ଦିଅ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦ୍ରାକ୍ଷା ବୋଲିକରି ଏକ ଫଳ ଅଛି",
          "ତା ଠାରୁ ମଧୁର ନାହିଁ",
          "ଦମ୍ଭ ମତି ତେଜି ଦାସୀ ଭାବ ହେଲେ",
          "ସେ ଫଳର ସ୍ୱାଦୁ ପାଇ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆବର ନାରଙ୍ଗ ଆଣିଛି ସୁରଙ୍ଗ",
          "ସେ ବଡ଼ ଶୀତଳ ରସ",
          "ନାମ ହେଜି ମଜ୍ଜି ପାନ କରିଥିଲେ",
          "କ୍ଷୁଧା ତୃଷା ଯିବ ନାଶ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରମଙ୍ଗା ବୋଲି ଏକ ଫଳ ଅଛି",
          "ସେ ଫଳର ତିନି ଅଂଶା",
          "ତାକୁ ଖାଇଥିଲେ ତ୍ରିତାପ ତୁଟଇ",
          "ଆବର ନ ଥାଇ ହିଂସା ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଛି ନରକୋଳି ସୁସଞ୍ଚ ଖଜୁରୀ",
          "ବେତକୋଳି ବଡ଼ ମିଠା",
          "ଲେଖନ କୋଳିର ଏତିକି ଲକ୍ଷଣ",
          "ଅଳପ ଲାଗଇ ଖଟା ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କଦଳୀ ସ୍ତରୁଣା କପିତ୍ଥ କାନ୍ଧିଆ",
          "କମଳା ଏ ପଞ୍ଚଫଳ",
          "ସବୁ ରୂପ ରସ ସ୍ପର୍ଶ ଗନ୍ଧ ମିଶି",
          "ପଞ୍ଚରସ ଯାକ ଠୂଳ ଗୋ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କୁଟିଳ କପଟ ବିଷୟ ଲମ୍ପଟ",
          "ଛାଡ଼ି ଏ ଫଳକୁ ଭକ୍ଷ",
          "ଶ୍ରୀକୃଷ୍ଣ କୃପାରୁ ଅବଶ୍ୟ ଲଭିବ",
          "ଧର୍ମ ଅର୍ଥ କାମ ମୋକ୍ଷ ଗୋ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଯେବେ ବ୍ୟାଧିମନ୍ତ କରିବ ବାଞ୍ଛିତ",
          "ଆରୋଗ୍ୟ ହୋଇବ ତନୁ",
          "ଦରିଦ୍ରକୁ ଧନୀ ମୂର୍ଖକୁ ପଣ୍ଡିତ",
          "କରିବେ କାଳିଆ କାହ୍ନୁ ଗୋ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ନାରୀମାନେ ଯେବେ ଏ ଫଳ ଚାଖିବେ",
          "କୃଷ୍ଣେ ହେବେ ଅନୁରାଗୀ",
          "ଧନବତୀ ପୁତ୍ରବତୀ ସୁଲକ୍ଷଣୀ",
          "ସଦା ସ୍ୱାମୀ ସଉଭାଗୀ ଗୋ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଆଗୋ ଗୋପ ଗୋପୀ ତୁମ୍ଭେ ବଡ଼ ତପୀ",
          "ଏ ଫଳକୁ ଚାଖିଥାଅ",
          "ମନୋରଥ ପୂର୍ଣ୍ଣ ହୋଇବ ବହନ",
          "କଦମ୍ବ ମୂଳକୁ ଯାଅ ଗୋ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ଗଉରଚରଣ ଏ ଅନୁସରଣ",
          "କରିଛି ବ୍ରଜକୁ ଯିବ",
          "ଦ୍ୱାରେ ଦ୍ୱାରେ ଫେରି ମାଗି ମଧୁକରୀ",
          "କୁଣ୍ଡ ତୀରେ ପଡ଼ିଥିବ"
        ]
      }
    ]
  },
  "sources": [
