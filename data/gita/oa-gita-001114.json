{
  "id": "oa-gita-001114",
  "name": {
    "en": "Bhala rachila bala chitraku",
    "or": "ଭଲା ରଚିଲା ବାଳା ଚିତ୍ରକୁ"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000130"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-rachila-bala-chitraku-kumbha-kamodi-gourachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଲା ରଚିଲା ବାଳା ଚିତ୍ରକୁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚାରୁ ଚିବୁକ ଧରି ବିନୟ ହୋଇକରି",
          "ରସାଅ ବୋଲିଦେବା ମାତ୍ରକୁ ରେ",
          "ନାସାପୁଟ ଫୁଲାଇ ଗେଲାଇ ନାହିଁ ନାହିଁ",
          "କହି ଢଳିଲା ମୋର ଗାତ୍ରକୁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନଚାଇ ପୃଷ୍ଠେ ବେଣୀ ହଲାଇ ନାସାମଣି",
          "ଭୁଲାଇ ନେଲା ମନ ନେତ୍ରକୁ ରେ",
          "କଟୀର ଚମକରେ ରସନା ଝମକରେ",
          "ଛାଡ଼ିଲା ଭୀତି କାମଶସ୍ତ୍ରକୁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିଳସାଇ କିଞ୍ଚିତେ ମନ୍ଦାବଲକ୍ଷ ସ୍ମିତେ",
          "ଖୋଷିଲା ନେତ୍ର ଶତପତ୍ରକୁ ରେ",
          "ହେଲା ବୋଲିଣ ଭାଷି ମଦନ ମଦାଳସୀ",
          "ଉଚ୍ଚାରି ଇଷି ଇଷି ମନ୍ତ୍ରକୁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଉରଦେଶରେ ନେଇ ଢାଳିଲା ପ୍ରାଣସହୀ",
          "ଉରଜ ପ୍ରେମ ସୁଧା ପାତ୍ରକୁ ରେ",
          "ଅଳି ନୀଳକୁନ୍ତଳା ଭାଳି ଲିଭାଇ ଦେଲା",
          "ଜଳିବା ସ୍ମର ବୀତିହୋତ୍ରକୁ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭାଷେ ଶ୍ରୀ ଗଜପତି ଗୌରଚନ୍ଦ୍ର ଭୂପତି",
          "ଟେକାଇ ଦେଇ ଜୟ ଛତ୍ରକୁ ରେ",
          "ସୁଶୀଳା ଗୁଣବତୀ ଦେଇ ସ୍ୱର୍ଗ ସମ୍ପତ୍ତି",
          "ପୁହାଇଦେଲା ରଙ୍ଗେ ରାତ୍ରକୁ ରେ"
        ]
      }
    ]
  },
