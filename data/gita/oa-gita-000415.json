{
  "id": "oa-gita-000415",
  "name": {
    "en": "Ahe bansidhara ki aparadha karichi",
    "or": "ଆହେ ବଂଶୀଧର କି ଅପରାଧ କରିଛି"
  },
  "composer": "oa-person-000075",
  "mula_raga": [
    "oa-raga-000084"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-bansidhara-ki-aparadha-karichi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହେ ବଂଶୀଧର",
          "କି ଅପରାଧ କରିଛି ସହୀ ମୋର",
          "ଶୟନ ପୂର୍ଣ୍ଣ ସେ ଜର ତାପେ ହୁଏ ଥରଥର",
          "ତହିଁକି ପ୍ରହାରେ ହରପର ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନାଗର ରତନ ଥାଉ ତା ଦୁଃଖ ନ ଗଲା ଆଉ",
          "ଝରଝର ନେତ୍ରୁ ବହେ ନୀର",
          "ଯେତେ କହିଲେ ନ ବୁଝେ ତୁମ୍ଭରି ନାମକୁ ଭଜେ",
          "ଉର ହାର ମଣେ ହର ହାର ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୀର୍ଣ୍ଣ ହୋଇଅଛି ରାମ ସେ ବିବେକୀ ଗୁଣ ଧାମ",
          "ଚନ୍ଦ୍ର ମୁଖ ବିରସ ତାହାର",
          "ନୋହିବାରୁ ତୁମ୍ଭ ସ୍ନେହ କ୍ଷଣକୁ କ୍ଷଣ ମୋହ",
          "ଏ କି ଦଶା ଗଜଗମନାର ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପିକଭାଷୀ ମନ୍ଦହାସୀ ଚାରୁ ଚତୁରୀ ସୁକେଶୀ",
          "ହେଲା ଆସି ଯେତେ ନାରଖାର",
          "କି ଗୁଣେ ତୁମ୍ଭଙ୍କୁ ରସି ଆନ ତାହାକୁ ନ ଦିଶି",
          "ଭାସିଲାଟି ତୁମ୍ଭ ଗଳାହାର ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ନୁହେଁ ପୀରତି ରୀତି କେବଳ ଛାତିକି ପତି",
          "ଜୀଇଁବାରୁ ଭଲ ମରିବାର",
          "ଶୁଣି ରମଣୀ ଆତୁର ହସିଲେ ଶ୍ୟାମସୁନ୍ଦର",
          "ଭାଷେ ସୋମନାଥ ବୀରବର ହେ"
        ]
      }
    ]
  },
  "sources": [
