{
  "id": "oa-gita-001463",
  "name": {
    "en": "Mohana muralidhari he",
    "or": "ମୋହନ ମୁରଲୀଧାରୀ ହେ"
  },
  "composer": "oa-person-000205",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000002"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନ ମୁରଲୀଧାରୀ ହେ",
          "କଳାତନୁ ତେଜି କେମନ୍ତେ ହୋଇଲ ସୁନାବରନ ମାଧୁରୀ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିଖୀପୁଚ୍ଛଚୂଳ ଗୁଞ୍ଜ ବନମାଳ ଗୋପବେଶ ପରିହରି ହେ",
          "ରାଧା ଅଙ୍ଗ ଝଳି ପ୍ରେମେ ଅଙ୍ଗେ ବୋଳି ନଦୀୟାରେ ଅବତରି ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶିଙ୍ଘା ପୀତଚେଳ ବୃଥାରେ ରଖିଲ ଦଣ୍ଡ କମଣ୍ଡଳୁ ଧାରୀ ହେ",
          "କଷାୟ ବସନ କଟିରେ ଭୂଷଣ କରେ ଜପମାଳା ଧରି ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନରପତି କୃଷ୍ଣଚନ୍ଦ୍ର ଭାଷେ କୃଷ୍ଣ ଚଇତନ୍ୟ ଶୋଭା ହେରି ହେ",
          "କେଶବ ଭାରତୀ ମନ୍ତ୍ର ଘେନି ଶ୍ରୁତି ହେଲ କି ପାଗଳ ପରି ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000002"
    }
  ],
  "record_status": "active",
