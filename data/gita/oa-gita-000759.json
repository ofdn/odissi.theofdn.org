{
  "id": "oa-gita-000759",
  "name": {
    "en": "Ana re manananda chhabiki",
    "or": "ଅନା ରେ ମନାନନ୍ଦ ଛବିକି"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000150"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ana-re-manananda-chhabiki-todiparaja-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନା ରେ ମନାନନ୍ଦ ଛବିକି",
          "ଚୂନା କରେ ସତୀ ମତି ପବିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ବଙ୍କା ମୂରତି ଶ୍ୟାମସୁନ୍ଦର",
          "ନିତି ନିତି କରେ ନୂଆ ହୁନ୍ଦର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଖିଳ ବରଜପୁରେ ଗୋ ଏହି",
          "ରଖିଦେବ ନାହିଁ ଯୁବତୀ ଗୋଈ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଙ୍ଗଭଙ୍ଗୀ ଛଟା ହସ ଚାହାଣୀ",
          "ମୁଗୁନି ପଥର କରଇ ପାଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କି ଛାର ସେ ମାର ଶୋଭା ଗୋ ମିତ",
          "ଏ ରୂପ ଦେଖିଲେ ହେବ ମୋହିତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନବୀନ ନଟନ ମୋହନ ବେଶ",
          "ଚାହିଁ କେ ନୋହିବ ଭାବେ ଆବେଶ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ତାଳୁରୁ ତଳିପା ସରିକି ରାମା",
          "ତୁଚ୍ଛ ହେବେ ପରା ସର୍ବ ଉପମା"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଗୌର ଦ୍ୱିଜ ବୋଲେ ସମ ହେତୁରେ",
          "ଖୋଜିଲେ ନ ଥିବ ଚଉଦ ପୁରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ana-re-manananda-chhabiki-todiparaja-gouracharana/"
    }
  ],
