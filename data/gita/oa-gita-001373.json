{
  "id": "oa-gita-001373",
  "name": {
    "en": "Se syama chhabi chataka",
    "or": "ସେ ଶ୍ୟାମ ଛବି ଛଟକ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000195"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-syama-chhabi-chataka-madhura-gujjari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ ଶ୍ୟାମ ଛବି ଛଟକ",
          "ଦେଖି କେବା ନ ହାରିବ ବୁଦ୍ଧି ବିବେକ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତା ମଧୁର ବଂଶୀସ୍ୱନ ମତି କରେ ଉଚ୍ଛନ୍ନ",
          "କୁଳବତୀ ଗୁମାନ ଛାର କେତେ ଏ ମାନ",
          "ସେ ଅଭିନବ ଘନ ଜିତ ଅଙ୍ଗଲାବଣ୍ୟ",
          "ପ୍ରେମ ମାଦକ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତା ନେତ୍ର ଭଙ୍ଗୀ କଟାରି ଭ୍ରୂଲତା ବାଙ୍କଛୁରୀ",
          "ଦେଲା ବେଳରେ ମାରି ମରମେ ଦିଏ ଘାରି",
          "ସେ ଦାଉ ସହି କରି ଅଛି କେଉଁ ନାଗରୀ",
          "ନ ଲଭି ଦକ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତା ମନ୍ଦ ମନ୍ଦ ହାସ ମଦନ ଚନ୍ଦ୍ରହାସ",
          "ମୁରଲୀର ଆଭାସ କରଇ ଧୃତି ନାଶ",
          "ଚାହାଁ ଚାହାଁ ଗୋ ରାସରଙ୍ଗିନୀ ସେହି ବାସ",
          "ଚୋରା ଛଟକ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲଳିତା କର ଧରି ଭାଷନ୍ତି ଶ୍ରୀକିଶୋରୀ",
          "ସେହି ରୂପ ମାଧୁରୀ ମୋ ନେତ୍ରେ ଅଛି ପୂରି",
          "ବେଣୁଧର ବିଚାରି ହେବକି ସେବାକାରୀ",
          "ତାଙ୍କ ନଜିକ"
        ]
      }
    ]
  },
  "sources": [
