{
  "id": "oa-gita-000983",
  "name": {
    "en": "Mahaprabhu kimpa na suna daka",
    "or": "ମହାପ୍ରଭୁ କିମ୍ପା ନ ଶୁଣ ଡାକ"
  },
  "composer": "oa-person-000137",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mahaprabhu-kimpa-na-suna-daka-banikantha-nimai-harichandan/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମହାପ୍ରଭୁ କିମ୍ପା ନ ଶୁଣ ଡାକ",
          "ଶୁଣୁଥିଲେ ଡାକ ନ ଥାନ୍ତା ଦୁଃଖ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗଜ ଡାକ ଦେଲା ଘୋର ଜଳରେ",
          "ପାଞ୍ଚାଳୀ ଡାକିଲା କୁରୁ ସଭାରେ",
          "ହରିଣୀ ଡାକିଲା ଘୋର ବନରେ",
          "ପ୍ରଭୁ ଶୁଣି ସେ ଡାକ",
          "ନିମିଷକେ ହରି ନେଲ ତା ଦୁଃଖ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଜାମିଳ ଡାକ ଦେଲା ପୁଅରେ",
          "ନାରାୟଣ ବୋଲି ଆସି ପାଖରେ",
          "ମରଣ ହୋଇଲା ଡାକି ତାହାରେ",
          "ପ୍ରଭୁ ଶୁଣି ସେ ଡାକ",
          "ନିମିଷକେ ହରି ନେଲ ତା ଦୁଃଖ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦ୍ୱାରକାରେ ରହି କମଳା ପୁରେ",
          "ସୁଦାମାର ଖୁଦ ଖାଇଲ ଥରେ",
          "କି ନାମ ଧରି ସେ ଡାକିଲା ତୋରେ",
          "ପ୍ରଭୁ ଶୁଣି ସେ ଡାକ",
          "ନିମିଷକେ ହରି ନେଲ ତା ଦୁଃଖ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସାଲବେଗ ଡାକେ ବୃନ୍ଦାବନରେ",
          "ଶ୍ରୀରଙ୍ଗାଚରଣ ଦେଖିବ ଥରେ",
          "ନନ୍ଦିଘୋଷେ ରହିଥିବ ବାଗରେ",
          "ପ୍ରଭୁ ଶୁଣି ସେ ଡାକ",
          "ନିମିଷକେ ହରି ନେଲ ତା ଦୁଃଖ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବଳରାମ ଦାସ ଅଭିମାନରେ",
          "ରଥ କଲା ଯାଇ ଦରିଆ ପାରେ",
          "ନ ଚଳିଲା ରଥ ବଡ଼ଦାଣ୍ଡରେ",
          "ପ୍ରଭୁ ଶୁଣି ସେ ଡାକ",
          "ନିମିଷକେ ହରି ନେଲ ତା ଦୁଃଖ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦୂରୁ ଡାକ ଦେଲେ ଯେ ଯେତେ ଜନେ",
          "ସେ ଡାକ ଶୁଭିଲା କିପରି କର୍ଣ୍ଣେ",
          "ଦିନ ରାତି ମୁହିଁ ଡାକିଲା ପାଖରେ",
          "ଥରେ ଶୁଣିଲେ ଡାକ",
          "ରହନ୍ତା ନାହିଁ ହେ ମୋହର ଦୁଃଖ"
        ]
      }
    ]
  },
  "sources": [
    {
