{
  "id": "oa-gita-001065",
  "name": {
    "en": "Nabaghana barana syama",
    "or": "ନବଘନ ବରନ ଶ୍ୟାମ"
  },
  "composer": "oa-person-000038",
  "mula_raga": [
    "oa-raga-000099"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nabaghana-barana-syama-jamuna-kalyana-dwija-padmanabha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବଘନ ବରନ ଶ୍ୟାମ",
          "ବାମନୟନୀ କୁଞ୍ଜେ ଯୁଗଳ ରୂପ ସ୍ମର",
          "କେଳତି ଦ୍ୟୁତିକି ଛବିରେ ଗଞ୍ଜେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାମ କରି ନ ପାରି",
          "ମଦନ ଯିବାରୁ ଫେରି",
          "ଦେଖି ଆଚମ୍ବିତେ ବିଜୁଳି ସ୍ଥକିତେ",
          "ରହେ କି ଜଳଦ ପୁଞ୍ଜେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚୁମ୍ବକୁ ପ୍ରତିଚୁମ୍ବେ",
          "ଶୁଝିବାରୁ ଅବିଳମ୍ବେ",
          "ନୀଳ କମଳ ଉଲଟେ ରହିଲା",
          "ବିମଳ ହେମ କଞ୍ଜେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କିଶୋରୀ କି ଶରେ ଚାତୁରୀ",
          "ପୁଣି ଅତିଶୟ ମାଧୁରୀ",
          "ପରସ୍ପରେ ଜାତ ହୋଇବା ଭାବ",
          "ଉଭୟ ମନକୁ ରଞ୍ଜେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚିନ୍ତି ଏହି କେଳିକି",
          "ହରିବାକୁ ଦିନ ରାତିକି",
          "ପଦ୍ମନାଭ ଚିତ୍ତ ନିରତ",
          "ଯାମଳାର୍ଜ୍ଜୁନ ଭଞ୍ଜେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
