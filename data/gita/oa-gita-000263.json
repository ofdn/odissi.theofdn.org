{
  "id": "oa-gita-000263",
  "name": {
    "en": "Karuthili mun nahi nahi re",
    "or": "କରୁଥିଲି ମୁଁ ନାହିଁ ନାହିଁ ରେ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/karuthili-mun-nahi-nahi-re-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କରୁଥିଲି ମୁଁ ନାହିଁ ନାହିଁ ରେ",
          "ଆଣି ପକାଇଦେଲୁ ମୋତେ କାହିଁରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯିବା ବୋଲି ଗାଧୋଇ ଫାନ୍ଦେ ମୋତେ ପକାଇ",
          "ବ୍ରଜବିଧୁକୁ କଲୁ ମୁହାଁମୁହିଁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜିଣିଛି ରଣରଣ ଯାର ସୁନ୍ଦରପଣ",
          "ପତିବ୍ରତାକୁ ପକାଉଛି ମୋହି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଡ଼ିଲା କି ବିପତ୍ତି ଖସିଗଲା ମୋ ଧୃତି",
          "ଅନା ଚାହିଁବାର ସେ ରହି ରହି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେ ଦେଖିଦେଲେ ମୋର ସରିଯିବ ସଂସାର",
          "ହେଲେ ନିକଟ କର ପରିତ୍ରାହି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏଣେ ତେଣେ ଅନାଇ ଶ୍ୟାମ ହୃଦେ ଲଗାଇ",
          "ଘେନିନେଲେ ଗୋପାଳକୃଷ୍ଣ କହି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
