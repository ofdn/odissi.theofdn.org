{
  "id": "oa-gita-001224",
  "name": {
    "en": "Chinta re swanta nirantara",
    "or": "ଚିନ୍ତରେ ସ୍ୱାନ୍ତ ନିରନ୍ତର"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chinta-re-swanta-nirantara-dhanasri-gopalakrusna-prataparudra-deba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚିନ୍ତରେ ସ୍ୱାନ୍ତ ନିରନ୍ତର",
          "ଜଗଦାନନ୍ଦ ମୁକୁନ୍ଦ ସୁନ୍ଦର ଶରୀର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏହିଟି ସମସ୍ତ ଛନ୍ଦ ବ୍ରତତୀର ମୂଳକନ୍ଦ",
          "ମହେନ୍ଦ୍ରମଣି ନିର୍ଦ୍ଧୂତ ରୂପୋଦ୍ଧତି ଯାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାସର ମୁଖ ନଳିନ ପ୍ରସନ୍ନ ଜିଣି ନୟନ",
          "ସ୍ପନ୍ଦନ ନବ ଶିଖଣ୍ଡମଣ୍ଡନକ ବର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବଲ୍ଲବୀ ନିକୁରୁମ୍ବର ଭାଗ୍ୟ ସୁକୃତ ପୁଞ୍ଜର",
          "ଶ୍ରୀ ପ୍ରତାପରୁଦ୍ରଙ୍କର ପ୍ରାଣର ଈଶ୍ୱର"
        ]
      }
    ]
  },
  "sources": [
