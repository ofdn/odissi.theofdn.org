{
  "id": "oa-gita-000536",
  "name": {
    "en": "Manu jau nahi ma",
    "or": "ମନୁ ଯାଉ ନାହିଁ ମା"
  },
  "composer": "oa-person-000108",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manu-jau-nahi-ma-apanna-panigrahi-gajapati-krushna-chandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନୁ ଯାଉ ନାହିଁ ମା",
          "ନବନୀରଦୋପମା",
          "ନନ୍ଦକୁଳଚନ୍ଦ୍ର ନୀଳ ଖିଳ ସୁଷମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହିଁ ଯାଇ ରହିଲେ ସେ ଶିଖୀ",
          "ଚନ୍ଦ୍ରିକା ବିଭୂଷିତ ସଖୀ",
          "ମୋ ହୃଦୟ ମଣିମୟହାରା ସୁରଞ୍ଜା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆହା କି ସୁମଧୁର ରେ ସଜନୀ",
          "ମୋହନ ମନ୍ଦ୍ର ମୁରଲୀର ଧ୍ୱନି",
          "ମନଘେନା ସେ ଯମୁନା କାନନ ସୀମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ରୀ ଗଜପତି କୃଷ୍ଣଚନ୍ଦ୍ର",
          "ଧ୍ୟାୟେ ଶ୍ରୀରାଧାଗୋବିନ୍ଦ",
          "ମିଳନ ମନ ନୟନ ଆନନ୍ଦ ସୀମା"
        ]
      }
    ]
  },
  "sources": [
