{
  "id": "oa-gita-001162",
  "name": {
    "en": "Gai bhala bhulai lo",
    "or": "ଗାଈ ଭଲା ଭୁଲାଇ ଲୋ"
  },
  "composer": "oa-person-000111",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gai-bhala-bhulai-lo-mahapurusa-jasobanta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗାଈ ଭଲା ଭୁଲାଇ ଲୋ",
          "ନିରତେ ବେଉସା ଖାଇ",
          "ଗାଈ ପଛେ ଯେବେ ଗଉଡ଼ ଥାଆନ୍ତା",
          "ବେଉସା ଖାଆନ୍ତା ନାହିଂ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗାଈର ମହିମା କି ଦେବି ଉପମା",
          "ଗାଈର ଶୂନ୍ୟେ ଗୁହାଳ",
          "ଗାଈ ପଛେ ପଛେ ପାଞ୍ଚଟି ବାଛୁରୀ",
          "ସଦା ଗାଈଟି ଦୁହାଂଳ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗାଈ ଗୋଳଚେରୁ କ୍ଷୀର ଦେଉ ଅଛି",
          "କଳନା ନାହିଂ ତାହାର",
          "ସେହି କ୍ଷୀରକୁ ତୁ ମନ୍ଥିଲେ ନିଶ୍ଚୟ",
          "ଲବଣୀ ହେବ ବାହାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେହି ଲବଣୀକୁ ଅଗ୍ନିରେ ରଖିଲେ",
          "ତହୁଂ ବାହାରଇ ଘୃତ",
          "ସେହି ଘୃତକୁ ତୁ ପାନୀୟ କରିଲେ",
          "ଅଙ୍ଗ ହୁଏ ପୁଲକିତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏପରି ଗାଈକି ଘରେ ବାନ୍ଧିଅଛୁ",
          "ତୋହର କାହାକୁ ଭୟ",
          "କହେ ଯଶୋବନ୍ତ ସେ ପାଦେ ଶରଣ",
          "ଗାଈକି ନାହିଂ ଉପାୟ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gai-bhala-bhulai-lo-mahapurusa-jasobanta/"
    }
  ],
