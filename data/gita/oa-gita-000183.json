{
  "id": "oa-gita-000183",
  "name": {
    "en": "Re rama raha raha jaa kahi",
    "or": "ରେ ରାମା ରହ ରହ ଯାଅ କହି"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/re-rama-raha-raha-jaa-kahi-mohana-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରେ ରାମା ରହ ରହ ଯାଅ କହି",
          "ରସ ଉଦୟା ସୁହୃଦୟା ମୋ ଠାରେ",
          "ସୁଦୟା ଅଛି କି ନାହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରୁରୁ ଘଣ୍ଟ ନାଦ ବଶ ହେଲା ପ୍ରାୟେ",
          "ଝୁଣ୍ଟିଆ ଧନିକି ମୁହିଁ",
          "ରଙ୍କ ରତନ ପାଇଲା ପରି ପ୍ରତେ",
          "ଗଲେ ତୁ ହସିଲା ହୋଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରହେ ବସି ଝୁରେ କୁରରୀ ପରାୟେ",
          "ଯେଉଁ ଦିନା ଦେଖା ନୋହି",
          "ରଖିଛି ହିଂସାଦଶାକୁ ଚାହିଁ କାମ",
          "ଦହିଲା ଉପରେ ଦହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରୁଦ୍ର ଯୋଗ ଭଙ୍ଗ ମୋ ଧୈର୍ଯ୍ୟ କେତେ କେ",
          "ରହିବ ତୋ ଶୋଭା ଚାହିଁ",
          "ରାହୁ ପ୍ରାୟ ପଛେ ହେଲେ ହେବି ଲୋଭ",
          "ଛାଡ଼ି ତ ପାରିବି ନାହିଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରୁଭୁକ୍ଷା ସମ୍ପତ୍ତି ଯାଚିଦେଇ ପାରୁ",
          "ରବି ନେତ୍ର ଭଙ୍ଗୀ ତୁହି",
          "ରସେ ଭାଷେ ଉପଇନ୍ଦ୍ର କେଉଁ ଯୁବା",
          "ବାଳାରେ ଏ ଚାଟୁ କହି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
