{
  "id": "oa-gita-001110",
  "name": {
    "en": "Chaturi chaturi prema sari",
    "or": "ଚତୁରୀ ଚାତୁରୀ ପ୍ରେମ ସରି"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000056"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chaturi-chaturi-prema-sari-maruaa-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାଳୀ ଅନୁରାଗ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚତୁରୀ ଚାତୁରୀ ପ୍ରେମ ସରି",
          "ଚତୁର୍ଦ୍ଦଶ ପୁରେ ଏ ଅନୁରାଗରେ",
          "ନ ଥିବେ କେହି ରସିକା ନାରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚତୁରାକ୍ଷ ବେଳେ ଡୋଳା ମାତ୍ର ଖେଳେ",
          "ଅପାଙ୍ଗସୀମାନ ବଳି ରହେ",
          "ଚତୁର୍ଥୀର ଶଶୀ ଅର୍ଦ୍ଧ ହାସ ଦିଶି",
          "ନ ଦିଶି ରଙ୍ଗ ଅଧର ଶୋହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚାରୁ ମୃଦୁ ଗିର କହନ୍ତେ ମାତର",
          "କର୍ଣ୍ଣପୁଟ ପୁଟ କରି ରହେ",
          "ଚିତ୍ତ ଅମରଷେ ଭ୍ରମେ ସଂବେଶେ",
          "କଳୁଷ କଂସ କଦାପି ନ ରହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚାତୁର୍ଯ୍ୟେ କେ କାହା ଗୁଣ ଉଦ୍ଘାଟନ",
          "ନ କରି ରହି ମାନସ ରସି",
          "ଚିତ୍ତଜ ରସ ପୂରିତ ଅଙ୍ଗଦେଶେ",
          "କିଛି କେ ନୁହନ୍ତି ପରଶଂସି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚନ୍ଦନ କର୍ପୂର ଚମ୍ପାଦାମ ଉର",
          "ଦେଶେ କେଶରେ ସୁବେଶ ନୋହି",
          "ଚଞ୍ଚଲାପିତା ସମାନ ଅବର୍ଦ୍ଧନ",
          "ତୁଟ ରହିତ ସର୍ବଦା ବହି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଚିତୁଅରସିକେ କେମନ୍ତେ ଏ ନୀଳା",
          "ରାଗ ଲକ୍ଷଣ ସହଜେ ସାର",
          "ଚିତ୍ରକୂଟ ସ୍ଥାୟୀ ସୀତା ରାମ ଯଥା",
          "ତାଙ୍କୁ ଭଜେ ଭଞ୍ଜ ବୀରବର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
