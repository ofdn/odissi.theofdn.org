{
  "id": "oa-gita-001160",
  "name": {
    "en": "Bada prabhu boli jete mun dakili",
    "or": "ବଡ଼ ପ୍ରଭୁ ବୋଲି ଯେତେ ମୁଁ ଡାକିଲି"
  },
  "composer": "oa-person-000141",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bada-prabhu-boli-jete-mun-dakili-baishnaba-pani/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ବଡ଼ ପ୍ରଭୁ ବୋଲି ଯେତେ ମୁଁ ଡାକିଲି",
          "ଜଡ଼ ପରି ହେଲୁ ତେତେ",
          "ଆଡ଼ ହେଲେ ଏ କାଳରେ କମ୍ବୁପାଣି",
          "କେ ବଡ଼ କହିବ ତୋତେ",
          "ଝାଡ଼ବିହାରୀ ହେ, ଯେବେ ରଖିବ ସେବକପଣ",
          "ଲୋଡ଼ା ତା ଉତ୍ତାରୁ ଆହେ ରମାବର",
          "ନ ହୁଅ କେବେ କୃପଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଡ଼ ତୋ ଦେଉଳ ବଡ଼ ଧଣ୍ଡା",
          "ମାଳ ସେବକ ତୋ ପଡ଼ପଣ୍ଡା",
          "ବଡ଼ଚୂଳ ନୀଳଚକ୍ର ପରେ ଚେଳ",
          "ପତାକା ହୋଇଛି ମଣ୍ଡା",
          "ମୂଢ଼ ତାରଣ ହେ, ପୁଣି ବଡ଼ ଖଣ୍ଡା ତୋ ଭଣ୍ଡାରେ",
          "ବଡ଼ଛତା ବଡ଼ଦାଣ୍ଡ ବୋଲି ହୁରି",
          "ପଡ଼ିଅଛି ବ୍ରହ୍ମାଣ୍ଡରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବଡ଼ଧୂପ ବଡ଼ିସିଂହାର ଚାଲିଛି",
          "ଯେତେ କଥା ବଡ଼ ସବୁ",
          "ବଡ଼ବୁଦ୍ଧି ଛୋଟ ନନ୍ଦରାଜା ଚାଟ",
          "କାହାକୁ କି କଷ୍ଟ ଦେବୁ",
          "ଜଗମୋହନ ହେ, ତିଳେ ତୋ ଠିକଣା ନାହିଁ",
          "ଦୁଃଖ ପରେ ଦୁଃଖ ହେଇଥାଉ ଢାଳି",
          "ଯେ ସେବା ତୋର କରଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୁମେ ଯେବେ ନିଜ ଭୃତ୍ୟକୁ ଦଣ୍ଡିବ",
          "କେ ଆଉ କରିବ କ୍ଷମା",
          "ଭୃତ୍ୟ ବି କାହାକୁ ହରିବ କିଏ ସେ",
          "ରୋଗ ଶୋକ ଦୁଃଖ ସୀମା",
          "ରମାରମଣ ହେ, ସବୁ ତୋର ବିପରୀତ",
          "ବଇଷ୍ଣବ କହି ପରକୁ ବଞ୍ଚାଇ",
          "ମରାଇଲୁ ନିଜ ସୁତ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
