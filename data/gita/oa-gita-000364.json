{
  "id": "oa-gita-000364",
  "name": {
    "en": "Saraga to mukhe nahi",
    "or": "ସରାଗ ତୋ ମୁଖେ ନାହିଁ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000103"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/saraga-to-mukhe-nahi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରାଗ ତୋ ମୁଖେ ନାହିଁ ଗୋ ଶ୍ରୀମତୀ",
          "ପରାଗ ମୁଞ୍ଚିଲା ପଙ୍କଜ ପରାୟେ",
          "ହୋଇଅଛୁ କାହିଁ ପାଇଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିନ୍ଦୁ ଘନଶ୍ୟାମ ଶୋଭାକୁ ତୁ କିମ୍ପା",
          "ପିନ୍ଧୁଅଛୁ ନୀଳଚେଳ",
          "ଚାରୁ ମୃଗମଦ ତିଳକ ଲାବଣ୍ୟ",
          "ନିଟିଳେ ହୋଇଛି ମେଳ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରାଜଜେମା କ୍ଷମା ଉଚିତ ତୋହର",
          "ଏହା ମନେ ବୁଝୁଥିବୁ",
          "ଲଳନା ତୋ କଥା ବୁଝି ବସିଲେ ତ",
          "ଦାଣ୍ଡରେ କଳନା ଯିବୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାଞ୍ଛାବଟ ମୂଳେ ତପ କରଇ ଯେ",
          "ଦେବାକୁ ତୋ ପାଦେ ଲାକ୍ଷା",
          "ଅଦୋଷରେ ରୋଷ କରି ପଶ୍ଚାତ୍ତାପ",
          "ପାଇଅଛୁ କୁଟିଳାକ୍ଷା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ବୋଲେ ନ ଦେଖିଲେ ଯାକୁ",
          "ନେତ୍ରୁ ଗଳେ ଅଶ୍ରୁଧାର",
          "ଶ୍ୟାମକୁ ମାନ ନ କର ମୁଁ କହୁଛି",
          "ଯେବେ କାମକୁ ତୋ ଡର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
