{
  "id": "oa-gita-000489",
  "name": {
    "en": "Jhuluchanti nikunja kanane go",
    "or": "ଝୁଲୁଛନ୍ତି ନିକୁଞ୍ଜ କାନନେ ଗୋ"
  },
  "composer": "oa-person-000104",
  "mula_raga": [
    "oa-raga-000054"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jhuluchanti-nikunja-kanane-go-jhulana-sangita/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଝୁଲୁଛନ୍ତି ନିକୁଞ୍ଜ କାନନେ ଗୋ",
          "ସଜନୀ ରାଧା ମୋହନେ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚାହିଁଲେ ମୋହୁଛି ମନ ନୋହୁଛି ନେତ୍ର ପତନ",
          "କି ଯତନେ ଖଞ୍ଜିଛି ବିମାନ ଗୋ ।",
          "(ପଡ଼ି)",
          "ତହିଁ କୁଞ୍ଜ ଶୋଭନ ଲତାରେ ଆଚ୍ଛାଦନ",
          "ଚିତ୍ର ବିଚିତ୍ର ପୁନ ବିକଶିତ ସୁମନ",
          "ଷଡ଼ଋତୁ ସଦନ ନୋହେଟି ଏହୁ ଆନ",
          "ଚୈତ୍ରରଥ ନନ୍ଦନ ବିନତି କରେ ଘେନ",
          "ତେଜି ଧନେଶ୍ୱର ମରୁତ୍ୱାନେ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରତ୍ନଦୀପ ଶ୍ରେଣୀ ଶ୍ରେଣୀ ମଣିଗଣ ଜ୍ୟୋତି ଜିଣି",
          "ନିଶି ଦିଶେ ବାସର ସମାନ ଗୋ ।",
          "(ପଡ଼ି)",
          "ଘେନିଣ ଚଉକତି ଯତ୍ନେ ଝୁଲାଉଛନ୍ତି",
          "ତ୍ରାସ ଚିରାଳ ଛତ୍ର ଗଣନା ହିଁ ନୁହନ୍ତି",
          "ଖଦି ଚାମର ପଙ୍ଖା ଆଲଟ କେ ଧରନ୍ତି",
          "ପ୍ରତିହାରୀ ସମୂହେ ଘେନିଣ ବିହରନ୍ତି",
          "ଖଟିଛନ୍ତି ତରୁ ଲତାମାନେ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଘୋଟି ଘନାଘନ ପ୍ରଭା ଚଞ୍ଚଳା ଦାମିନୀ ଆଭା",
          "ଝର ଝର ବରଷେ ଜୀବନ ଗୋ ।",
          "(ପଡ଼ି)",
          "ନୀଳ ଗଗନ ଚାହିଁ କେକୀ ନୃତ୍ୟ କରଇ",
          "ଶାରୀ ଶୁକ ପିକ ହିଁ ମଙ୍ଗଳ ଗୀତ ଗାଇ",
          "ଘନ ଗର୍ଜ୍ଜନ ନୁହେଁ ଦୁନ୍ଦୁଭି ବାଦ୍ୟ ଏହି",
          "ଜାଲିକ ଘଣ୍ଟ ପ୍ରାୟେ କାଳକଣ୍ଟକ ଦେହୀ",
          "ପୂରିତ ଏ ଉନ୍ମାଦ ଗର୍ଜ୍ଜନେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାତ୍ରା ଉତ୍ସବରେ ଧ୍ୟାନ କରନ୍ତୁ ବେଗେ ଗମନ",
          "ଯହିଁ ବିଜେ ତ୍ରୈଲୋକ୍ୟ ମୋହନ ଗୋ ।",
          "(ପଡ଼ି)",
          "ଭଣନ୍ତି ଜନାର୍ଦ୍ଦନ ଷଣ୍ଢ ନୃପତିବର",
          "କୁଞ୍ଜେ ଦର୍ଶନ କରି ହେବା ଏ ଭବୁଁ ପାର",
          "ଶୂନ୍ୟମୟ ସଂସାର ନୋହେ ଏ ଜୀବ ଚିର",
          "ମାୟା ମୋହକୁ ତେଜି ସେ ପାଦେ ଆଶ୍ରେ କର",
          "ଦେଖ ପୁଣ୍ୟବତୀ ଗୋପୀମାନେ ଗୋ"
        ]
      }
    ]
  },
