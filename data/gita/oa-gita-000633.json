{
  "id": "oa-gita-000633",
  "name": {
    "en": "Priti kari kaha pase",
    "or": "ପ୍ରୀତି କରି କାହା ପାଶେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000049"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priti-kari-kaha-pase-bibhasa-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରୀତି କରି କାହା ପାଶେ",
          "ପୁହାଇଲ ନିଶା ତୋଷେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପରିଣତ ବିମ୍ବ ଅଧରେ କାହାର",
          "ରଦନ କ୍ଷତ ବିକାଶେ",
          "ପଲ୍ଲବ ବିଜୟୀ କର କାହା କୁଚ",
          "କୁଙ୍କୁମେ ଅଙ୍କିତ ଦିଶେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପଡ଼ି କା ଚରଣେ ଶିଖଣ୍ଡ ମୁକୁଟ",
          "ରଙ୍ଗ କଲ ଲାକ୍ଷା ରସେ",
          "ପରିରମ୍ଭ କଲ କାହାର ବଳୟ",
          "ଚିହ୍ନ ଦିଏ ବେନି ପାଶେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାଲଟ କରି କେଉଁ ସହଚରୀର",
          "ଚିତ୍ତକୁ ସମ୍ଭ୍ରମେ ବାସେ",
          "ପିନ୍ଧିଅଛି ନିଜ କଟିତଟେ ଆଜ",
          "ଚାହିଁକି ସୁନ୍ଦର ଦିଶେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପାନବୋଳା ଗଣ୍ଡେ ଲଲାଟେ ସିନ୍ଦୁର",
          "ଲାଗି ତ ଅଛି ବିଶେଷେ",
          "ପରୁଆ ନ କର ଚିତ୍ତରେ ତୁମ୍ଭର",
          "ଜନାପବାଦକୁ ଲେଶେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପ୍ରତି ଅଙ୍ଗ ଯାକ କି ଶୋଭା ଦିଶଇ",
          "କରଜ କ୍ଷତ ବିଳାସେ",
          "ପ୍ରେମଭରେ ହରିଚନ୍ଦନ ଭାବଇ",
          "ସେ ରୂପ ନିଜ ମାନସେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
