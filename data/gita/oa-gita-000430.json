{
  "id": "oa-gita-000430",
  "name": {
    "en": "Sajani ki laje sarili",
    "or": "ସଜନୀ କି ଲାଜେ ସରଲିଡରି ମରୁଥାଏଁ ଯାରେ ତା ନଜରେ ପଡ଼ିଲି । ଘୋଷା । କାଲି ଗୋ ଯମୁନା ନୀରେଅବଗାହୁଥିଲି ମୁଁ ରେଘାଟେ ସେ ମୁରଲୀ ସୁରେରାଧା ରାଧା ଡାକେ ଧୀରେନ ଜାଣି ଯା ଫେରି ଚାହିଁଲି । ୧ । (ପଡ଼ି)କୁଟିଳା ନଣନ୍ଦ ଥାଇକଲା ଗୋ ଯେତେକ ଟାହିବିବେକ ବିଚାର ନାହିଁଜୀଇଁ ଥାଇ ସତେ ମରିଲି । ୨ । ଆସୁଥିଲି ବ୍ରଜ ପଥେସେ ଥିଲା ଅଜଣା ମୋତେଓଗାଳିଲା ପଥ ସେତେବିନୟୀ କହିଲି ଯେତେଲାଜ […]"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000122"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-ki-laje-sarili/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ କି ଲାଜେ ସରଲି",
          "ଡରି ମରୁଥାଏଁ ଯାରେ ତା ନଜରେ ପଡ଼ିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାଲି ଗୋ ଯମୁନା ନୀରେ",
          "ଅବଗାହୁଥିଲି ମୁଁ ରେ",
          "ଘାଟେ ସେ ମୁରଲୀ ସୁରେ",
          "ରାଧା ରାଧା ଡାକେ ଧୀରେ",
          "ନ ଜାଣି ଯା ଫେରି ଚାହିଁଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "(ପଡ଼ି)",
          "କୁଟିଳା ନଣନ୍ଦ ଥାଇ",
          "କଲା ଗୋ ଯେତେକ ଟାହି",
          "ବିବେକ ବିଚାର ନାହିଁ",
          "ଜୀଇଁ ଥାଇ ସତେ ମରିଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆସୁଥିଲି ବ୍ରଜ ପଥେ",
          "ସେ ଥିଲା ଅଜଣା ମୋତେ",
          "ଓଗାଳିଲା ପଥ ସେତେ",
          "ବିନୟୀ କହିଲି ଯେତେ",
          "ଲାଜ ମାନ ସବୁ ହାରିଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "(ପଡ଼ି)",
          "କବିଶଶୀ କହେ ରାଈ",
          "ତୋ ଲାଗି କଳା କହ୍ନାଇ",
          "ଶିଖେ ମୁରଲୀ ବଜାଇ",
          "ରାଧା ରାଧା ଗାଇ ଗାଇ",
          "ନ ଜାଣୁ କି ସେ ତୋର ବୋଲି"
        ]
      }
    ]
  },
