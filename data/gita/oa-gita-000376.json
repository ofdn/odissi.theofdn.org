{
  "id": "oa-gita-000376",
  "name": {
    "en": "Sangata mana kali para tote",
    "or": "ସଙ୍ଗାତ ମନା କଲି ପରା ତୋତେ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000182"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangata-mana-kali-para-tote/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗାତ ମନା କଲି ପରା ତୋତେ ।",
          "ନ ଅନାଅ ସୁନାବରନା ବୋଲନ୍ତେ",
          "ଘୃଣା କଲୁ ପରା ମୋତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପର କି ମୁଁ ତୋର ତରକିଲୁ ଗିର",
          "ପରଖ ଏବେ ତୁ ଚିତ୍ତେ",
          "ତୁଚ୍ଛାକୁ ତୁ ଉଚ୍ଛା ହେବାରୁ ତୋ ଇଚ୍ଛା",
          "ସୁଖେ ଲୁହ ପୋଛା ଏବେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପରମାଦ ମଞ୍ଜି ପୋତିଦେଇ ଗଞ୍ଜି",
          "ଖଞ୍ଜିଲୁ ତୁ ଆଶା ଫଳେ",
          "ରଙ୍କୁଈକ୍ଷଣୀ ନ ଅଙ୍କୁରିଲା କ୍ଷଣି",
          "କିମ୍ପା ତାଙ୍କ ମୁଖ ତଳେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଘନସ୍ତନୀ ପାଞ୍ଚ କରିଥିଲୁ ଆଶା",
          "ନ ଲାଗିବ ବୋଲି ଦୃଢ଼େ",
          "ଚତୁରୀ ଆତୁରୀ ନ ରହେ ଚାତୁରୀ",
          "ବଚନ କତୁରୀ ଦାଢ଼େ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ଗୋପକଟକ ଟିକାକ ପାଟକ",
          "ଜାଣି କି ଅଟକ ଥାଇ",
          "ହଜାଇଲୁ ମତି ମଜ୍ଜାଇଲୁ ପ୍ରୀତି",
          "ହେଜ ଉପଇନ୍ଦ୍ର କହି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangata-mana-kali-para-tote/"
    }
  ],
