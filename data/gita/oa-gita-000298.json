{
  "id": "oa-gita-000298",
  "name": {
    "en": "Mohane deli chahin go",
    "or": "ମୋହନେ ଦେଲି ଚାହିଁ ଗୋ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohane-deli-chahin-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନେ ଦେଲି ଚାହିଁ ଗୋ",
          "ଆଗୋ ପ୍ରିୟସହୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଦମ୍ବ ମୂଳରେ ରହି । କି ରଙ୍ଗେ ମୁରଲୀ ବାଇ ।",
          "ମାନସେ ମୋର ନାଚଇ ଆନ ସାହା ନାହିଁ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଧନ୍ୟ ତା କଟାକ୍ଷ ଆଖି । ମୋ ମାନସେ ଗଲା ଲାଖି ।",
          "ନ ପାରିଲି ସଖୀ ଦେଖି ସେ ଶ୍ୟାମକୁ ମୁହିଁ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବଦନେ କି ଅଛି ତାର । ସଦନେ ହୋଇ କାତର ।",
          "ମଦନେ ହୋଇ ଆତୁର ସବୁ ପାଶୋରାଇ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହଇ ସେ ବନମାଳୀ । ଏ ରସରେ ଭାଳି ଭାଳି ।",
          "ନ ଦେଖିଲି ଶ୍ୟାମ ଝଳି ତା ପାଶରେ ରହି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
