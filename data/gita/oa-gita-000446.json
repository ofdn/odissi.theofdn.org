  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/saja-rutu-pati-aja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଜ ଋତୁପତି ଆଜ ହିମଋତୁ ଲାଜ ଲଭିଲାଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘନ କୁହୁଡ଼ି ତଳେ ତନୁ ଘେରାଇ",
          "ଗିରି ଗରଭେ ଶୀତ ଲୁଚିଲା ଯାଇ",
          "ଶାଣି ବକୁଳର କୁନ୍ତମୁନ ସତେ",
          "ସନ୍ଧି ବିନ୍ଧିଲା ପଞ୍ଚ ଶାୟକ ।",
          "(ପଡ଼ି)",
          "କୁଞ୍ଜେ କୁଞ୍ଜେ ମଧୁଲିଟ ଗୁଞ୍ଜନ",
          "ପୁଞ୍ଜେ ପୁଞ୍ଜେ ନବଦଳ ରଞ୍ଜନ",
          "ଛନ୍ଦେ ଛନ୍ଦେ ଶୁଭେ ପିକ କୂଜନ",
          "ମନ୍ଦେ ମନ୍ଦେ ବହଇ ପ୍ରଭଞ୍ଜନ",
          "ନବୀନା ସୁମନା ସରସେ ମୁରୁକିଲାଣି"
        ]
      }
    ]
  },
