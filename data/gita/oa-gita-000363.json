{
  "id": "oa-gita-000363",
  "name": {
    "en": "E ta bada paramada re",
    "or": "ଏ ତ ବଡ଼ ପରମାଦରେ"
  },
  "composer": "oa-person-000071",
  "mula_raga": [
    "oa-raga-000153"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-ta-bada-paramada-re-nata-kedara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ ତ ବଡ଼ ପରମାଦରେ (ସହି)",
          "କିଣାଜନ ପରି ଏକା ନାମ ଧରି",
          "ଡାକଇ ମୁରଲୀ ନାଦରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାଉଥିଲି ବାଟେ ଦେଖିଲି ନିକଟେ",
          "ନ ଚାହିଁଲି ତାଙ୍କୁ ଆଡ଼ରେ",
          "କେ କି ହୋଇ ସଖି ଡୋଳେ ତାଙ୍କୁ ଦେଖି",
          "ପଡ଼ିଲି କାମ ଅଗାଧରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୁରୁଜନ ଅନ୍ତେ ବସି ମୁଁ ଏକାନ୍ତେ",
          "ବିଚାରୁଥାଇ ବିଷାଦରେ",
          "ସୁଧା ଖାଉଁ ଖାଉଁ ଶିରଚ୍ଛେଦ ରାହୁ",
          "ହେଲା ପରି ମୁଁ ତ ସ୍ୱାଦରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏହି କଥା ଜାଣି ଯମୁନାକୁ ପାଣି",
          "ଆଣି ମୁଁ ନ ଯାଇ ତା ଡରେ",
          "ନାହିଁ ଗୋପପୁରୀ ମଧ୍ୟେ କେତେ ନାରୀ",
          "ଲାଗିଛି ମୋ ସଙ୍ଗେ ବାଦରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୃନ୍ଦାବନ ଭଣି ରାଧା ବାଣୀ ଶୁଣି",
          "ଦୂତୀ କହେ ଆହାଲାଦରେ",
          "ତେଜ ମନୁ ଖେଦ ନୁହଁ ଗୋ ବିଷାଦ",
          "ଭେଟାଇବି କୃଷ୍ଣ ପାଦରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
