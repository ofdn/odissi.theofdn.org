  "name": {
    "en": "Jibana bandhu karuna sindhu",
    "or": "ଜୀବନ ବନ୍ଧୁ କରୁଣା ସିନ୍ଧୁ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000008"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jibana-bandhu-karuna-sindhu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୀବନ ବନ୍ଧୁ କରୁଣା ସିନ୍ଧୁ ହେ",
          "ସୁଖ ଶାନ୍ତି ନିକେତନ ହେ",
          "ହେ ଚିର ସୁନ୍ଦର ଜଗଦାଧାର",
          "ପରମାନନ୍ଦ ବିବର୍ଦ୍ଧନ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଶ୍ୱବିହାରୀ ପାତକହାରୀ",
          "ଭବ ଭୟ ଭୀତି ନିବାରଣ ହେ",
          "ପୂରଣ ବ୍ରହ୍ମ ପରାୟଣ ଚିଦ୍‌ଘନ",
          "ରସମୟ ସତ୍ୟ ସନାତନ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଙ୍କଟ ଭଞ୍ଜନ ଶଙ୍କର ବନ୍ଦନ",
          "ଜଗଦୀଶ୍ୱର ଅଘ ମୋଚନ ହେ",
          "ତାରିଣୀ ହୃଦ ମନ୍ଦିର ସମ୍ବର୍ଦ୍ଧନ",
          "ମୋହନ ନିତ୍ୟ ନିରଞ୍ଜନ ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
