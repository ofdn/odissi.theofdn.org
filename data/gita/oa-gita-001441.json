    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଞ୍ଚିବ ନବୀନାକି ଶ୍ୟାମ ବିନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜଳ ବିହୁନେ ମୀନ",
          "କେମନ୍ତେ ନେବ ଦିନ",
          "ରାଧା ପରାଣ ଶ୍ୟାମ ଇନ୍ଦ୍ର ସିନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜୀବନ ଯଉବନ",
          "ଚିତ୍ତ ବିବେକ ଧନ",
          "ଦେଇ ସେ ହେଲା ତାର ତ୍ରିମାଧିନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଲା ତା ପ୍ରେମେ ଭଳି",
          "ଚିତ୍ତକୁ ଜଳାଞ୍ଜଳି",
          "ଏବେ ବିରହ ଦୁଃଖ ଘାରେ ଦିନା"
        ]
      }
    ]
  },
