  "name": {
    "en": "Banchiba nabina ki syama bina",
    "or": "ବଞ୍ଚିବ ନବୀନାକି ଶ୍ୟାମ ବିନା"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
