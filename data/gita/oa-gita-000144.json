{
  "id": "oa-gita-000144",
  "name": {
    "en": "Tuhi para mo hrudaya",
    "or": "ତୁହି ପରା ମୋ ହୃଦୟ ମଣିମୟହାରା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tuhi-para-mo-hrudaya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତୁହି ପରା",
          "ମୋ ହୃଦୟ ମଣିମୟହାରା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସହି ତୁ ମୋହର ସକଳ ସମ୍ପଦ",
          "ମଦନ ଫଣୀ ରଦନ ବିଷ ଗଦ",
          "ଅଖିଳ ବିଭବ ଆଖଣ୍ଡଳ ପଦ",
          "ଆରୋହଣ ପରମ୍ପରା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରସିକରାଜି ମସ୍ତକ ଅଳଙ୍କାର",
          "ବିଦ୍ରୁମ ନବପଲ୍ଲବ ଗର୍ବହର",
          "ତୋ ପୟର ଲାକ୍ଷାରଞ୍ଜକ ଦାସ ମୁଁ",
          "ବିରହ ଦୁଃଖପାସୋରା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କହିଥିବେ ସହି ଜାଣି ବା ନ ଜାଣି",
          "ମଣିଲୁ କି ସତ ଶୁଣି ତାଙ୍କ ବାଣୀ",
          "ଧରିଛୁ ବିରସ ବିବେକିନୀ ଶ୍ରେଣୀ",
          "ମସ୍ତକ ମଣ୍ଡନ ଝରା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନ ମଣ୍ଡିବୁ ସିନା ମୋର ବକ୍ଷସ୍ଥଳ",
          "ହୃଦୟରୁ ଯିବୁ କରି କେଉଁ କଳ",
          "ମୋ ମନ ଗଗନ ତଟ ସମୁଜ୍ଜ୍ୱଳ",
          "ଉଦୟ ନିର୍ମ୍ମଳ ତାରା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସଜନୀ ଗୋ ନବ ସୁରତି ବିଭବ",
          "ପାସୋର ଯିବ କି ମନୁ ଥିଲେ ଜୀବ",
          "ଦୀନ କବିରବି ଚାତକର ନବ",
          "-ଘନରସ ଜଳଧାରା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tuhi-para-mo-hrudaya/"
    }
  ],
