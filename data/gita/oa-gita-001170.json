{
  "id": "oa-gita-001170",
  "name": {
    "en": "Dhanya swami sri jasobanta",
    "or": "ଧନ୍ୟ ସ୍ୱାମୀ ଶ୍ରୀ ଯଶୋବନ୍ତ"
  },
  "composer": "oa-person-000142",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhanya-swami-sri-jasobanta-mahapurusa-jasobanta-dasa-lohi-dasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧନ୍ୟ ସ୍ୱାମୀ ଶ୍ରୀ ଯଶୋବନ୍ତ",
          "ମହିମାରେ କେହି ନ ପାନ୍ତି ଅନ୍ତ",
          "ସ୍ଥଳ ଅଢ଼ଙ୍ଗ ନାଇଲୋ ନନ୍ଦିଗ୍ରାମ",
          "ଚଉରାଶୀ ଆଜ୍ଞା ଯହିଂ ବାଦିତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କ୍ଷତ୍ରିୟ କୁଳରେ ଉଦିତ ହୋଇଣ",
          "ମହିମା ତୁମ୍ଭର ହେଲା ବିଖ୍ୟାତ",
          "ଅନନ୍ତ ଅଚ୍ୟୁତ ବଳରାମ",
          "ଜଗନ୍ନାଥ ଯଶୋବନ୍ତ ଏ ପାଞ୍ଚ ଭକ୍ତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଟ ବକୁଳ ଓଶସ୍ତ ଚୂତ",
          "କଦମ୍ବ ଏ ପାଞ୍ଚ ଗୋସ୍ୱାମୀଙ୍କର ସଙ୍କେତ",
          "ସ୍ଥଳରେ ମହିମା କି ଦେବା ଉପମା",
          "ଆଡ଼ ଦୀର୍ଘେ ପାଞ୍ଚ ହଜାର ହାତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଠରଶ ନାଗା ଗୁପତ ହୋଇଣ",
          "ନଳିନୀ ପୋଖରୀ ତଟରେ ସ୍ଥିତ",
          "ମାର୍ଗଶୀର ମାସ ଓଢ଼ଣ ଷଷ୍ଠୀରେ",
          "ଦିଦାର୍ଦ୍ଧ ଯେ ମହୋତ୍ସବ ରଞ୍ଚିତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସନ୍ତଧାରୀ ମଠ ମହନ୍ତ ସହିତେ",
          "ଠାବେ ଠାବେ ଧୁନି କରନ୍ତି ନୃତ୍ୟ",
          "ବାମ ପାରୁଶରେ ବିଜେ କରିଛନ୍ତି",
          "ଲକ୍ଷ୍ମୀ ଶାଳଗ୍ରାମ ଶ୍ରୀ ଗୋପୀନାଥ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପାଉଥାଏ ଶୋଭା ଜନମନ ଲୋଭା",
          "ସର୍ବାଙ୍ଗେ ଚନ୍ଦନ ବସ୍ର ଭୂଷିତ",
          "କହେ ଲୋହିଦାସ ପଶୁଛି ଶରଣ",
          "ପଦ୍ମପାଦ ତଳେ ରହୁ ମୋ ଚିତ୍ତ"
        ]
      }
    ]
  },
  "note": {
    "en": "Composed in honour of Mahapurusa Jasobanta Dasaମହାପୁରୁଷ ଯଶୋବନ୍ତ ଦାସ ଗୋସାଇଁଙ୍କ ଉଦ୍ଦେଶ୍ୟରେ ରଚିତ"
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhanya-swami-sri-jasobanta-mahapurusa-jasobanta-dasa-lohi-dasa/"
    }
  ],
