{
  "id": "oa-gita-000216",
  "name": {
    "en": "Madalasi mande hasi",
    "or": "ମଦାଳସୀ ମନ୍ଦେ ହସି"
  },
  "composer": "oa-person-000073",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madalasi-mande-hasi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଦାଳସୀ ମନ୍ଦେ ହସି ନେତ୍ର ଢାଳି",
          "ବାରେ ଚାହିଁଗଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧନ୍ୟ ତା ଶ୍ରୀମୁଖ ଶଶୀ",
          "ଗଗନୁଁ କି ପଡ଼ିଛି ଖସି",
          "ମୋ ଧୈର୍ଯ୍ୟ ଗୁଣକୁ ପ୍ରସାରି ଚିତ୍ତକୁ",
          "ବଳେ ଆକର୍ଷଣ କରୁଥିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭୂରୁଚାପ ଅଞ୍ଜନ ଗୁଣ",
          "ସନ୍ଧି ତହିଁ କଟାକ୍ଷ ବାଣ",
          "ରୋଷରେ କ୍ଷିପ୍ରରେ ରମଣୀ ମୋ ପରେ",
          "ପଟେ ପଟେ କରି ବିନ୍ଧୁଥିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାଲେ ଶୋହେ ଅଳକାପନ୍ତି",
          "ଦିଏ ଯୁବା ଧଇର୍ଯ୍ୟ ମନ୍ଥି",
          "ତଥି ପାଶେ କମ୍ପାଉଛି ଚନ୍ଦ୍ରଝୁମ୍ପି",
          "ମାନସକୁ ଝାମ୍ପି ନେଉଥିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମଲ୍ଲିକଢ଼ି ତଳେ ଝଲକା",
          "ଝଲକାଇ କରଇ ଶଙ୍କା",
          "ତାଟଙ୍କର ଜ୍ୟୋତି ଶୁକ୍ର ବୃହସ୍ପତି",
          "ଜ୍ୟୋତି ମାନ କରି ମୋହୁଥିଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସିଂହ ବଂଶାର୍ଣ୍ଣବୁଁ ଉତ୍ପତ୍ତି",
          "ଭଗୀରଥ ଭୂଦେବ ପତି",
          "ବାହାଦୁର ଚନ୍ଦ୍ର ଭାଷେ ଚନ୍ଦ୍ରାନନୀ",
          "ଜମ୍ଭଭେଦୀ ଶିରୀ ଦେଉଥିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
