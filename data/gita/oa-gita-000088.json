{
  "id": "oa-gita-000088",
  "name": {
    "en": "Kali kahinki naila syamanagara",
    "or": "କାଲି କାହିଁକି ନଇଲ ଶ୍ୟାମନାଗର"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kali-kahinki-naila-syamanagara-kali-kahinki-noila/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାଲି କାହିଁକି ନଇଲ ଶ୍ୟାମନାଗର",
          "ଯାହା ହେଉଅଛି ଦେହ ମଦନେ ମୋର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆଉ କେ ଯିବ ବିଶ୍ୱାସ । ଲମ୍ପଟିଆ ପୀତବାସ ।",
          "ତଣ୍ଟିକଟା ଆଚରଣ ଏକା ତୁମ୍ଭର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଞ୍ଜକୁ ସଙ୍କେତ ଦେଇ । ଭଣ୍ଡିଲ ମୋତେ କିମ୍ପାଇଁ ।",
          "ଦଗାଦାର ନଟବର ମୁରଲୀଧର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏହିପରି ତୁମ୍ଭ ରୀତି । ଜାଣି ନ ଥିଲି ଶ୍ରୀପତି ।",
          "ଗଛରେ ଚଢ଼ାଇ ମୂଳ କାଟିଦେବାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଦାସ ଭଣେ । ତୁମ୍ଭ ପରି ନାହିଁ ଜଣେ ।",
          "ହଟିଆ ନଟକୂଟିଆ ହେ ଚିତ୍ତଚୋର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
