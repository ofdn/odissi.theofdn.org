{
  "id": "oa-gita-000745",
  "name": {
    "en": "Jana jiba tora tana re madana",
    "or": "ଜଣାଯିବ ତୋର ଟାଣ ରେ ମଦନ"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000150"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jana-jiba-tora-tana-re-madana-ramakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଣାଯିବ ତୋର ଟାଣ ରେ ମଦନ",
          "ତରଳନୟନା ମରାଳଗମନା",
          "ଦିନେ ରସିଥିଲେ ମନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରସିକେ ଗେଲାଇ ନାସିକା ଫୁଲାଇ",
          "ହଲାଇ ନାସା ବସଣୀ",
          "ଯେତେବେଳେ କୋଳେ ବସାଇବା କାଳେ",
          "ଉରଜରେ ଦେବି ପାଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦେଲେ କର୍ଣ୍ଣ ଫୁଙ୍କି ହୃଦରେ ମୋ ଲାଖି",
          "ରହିବ ରାମାରତନ",
          "ରଦନ ବଦନ ଦରକମ୍ପା କରି",
          "ଯେବେ ହେବ ପ୍ରାଣଧନ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରସିକା ରସରେ ରସି ଆନନ୍ଦରେ",
          "ପ୍ରମୋଦ ମଦରେ ମାତି",
          "ଫୁଲାଇ ତୁ ଛାତି ବାନ୍ଧିଥିବୁ କାତି",
          "ପାହିଯିବା ଯାଏ ରାତି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାମକୃଷ୍ଣ ଭଣି ଅଦୋଷରେ ପୁଣି",
          "ଦଣ୍ଡୁ ତୁ ବିରହୀ ଜନ",
          "ବଡ଼ କୁଳେ ଜନ୍ମ ହୋଇଲେ କି ହେବ",
          "ବୁଦ୍ଧି ତୋର ବଡ଼ ହୀନ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
