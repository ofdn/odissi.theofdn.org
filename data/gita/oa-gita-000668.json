{
  "id": "oa-gita-000668",
  "name": {
    "en": "Kahile ki heba aau",
    "or": "କହିଲେ କି ହେବ ଆଉ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahile-ki-heba-aau/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହି ଲୋ କହିଲେ କି ହେବ ଆଉ",
          "ରହି ନ ପାରଇ ସେ ରୂପ ନ ଦେଖି",
          "ତେଜିବାର ତେଣେ ଥାଉ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅନୁକ୍ଷଣେ ତାଙ୍କ ଭାବ ମନେ ପଡ଼ି",
          "ଉଲ୍ଲସି ଉଠଇ ତନୁ",
          "କୋଟି କୋଟି ଶର ମରମକୁ ମୋର",
          "ପ୍ରହାରଇ ଫୁଲଧନୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ମୋହନ ଛବି କି ସୁନ୍ଦର ମୁଖ",
          "ନିନ୍ଦା କରେ ସୁଧା ଭାନୁ",
          "ଯେଣିକି ଚାହିଁଲେ ତେଣେ ଦିଶୁଥାଇ",
          "ବରଜି ନୁହଇ ମନୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଖର ଭାରତୀ ଶୁଣରେ ପୀରତି",
          "କୁଶଳା ଚତୁରୀମଣି",
          "ତନୁ ତୁଲେ ତାଙ୍କୁ ପଞ୍ଚମନ ପ୍ରାଣ",
          "ସମର୍ପି ଯେବେ ଦେଲିଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସରିଲାଣି ସୁଖ ବଳିଲାଣି ଦୁଃଖ",
          "ବିରହ ସନ୍ତାପେ ପଡ଼ି",
          "ବୀରବିକ୍ରମର ମନା କଲା ଗିର",
          "ଯେବେ ମୁଁ ଦେଇଛି ଏଡ଼ି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahile-ki-heba-aau/"
    }
  ],
