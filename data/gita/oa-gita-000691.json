{
  "id": "oa-gita-000691",
  "name": {
    "en": "Chahan re sundari",
    "or": "ଚାହାଁରେ ସୁନ୍ଦରୀ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000170"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-re-sundari-ghumura/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁରେ ସୁନ୍ଦରୀ ଏ ଚନ୍ଦ୍ର ଶର୍ବରୀ",
          "ଶରଦ ଯୋଗୁଁ କି ତୋରାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘନ ଖଣ୍ଡ ମାନ ନ ଥିବାରୁ ଶୂନ୍ୟ",
          "ଦିଶେ ନୀଳଶାଢ଼ୀ ପରାରେ",
          "ଯାମିନୀ କାମିନୀ ବେଶ ସଜାଡ଼ିଛି",
          "ଗୁନ୍ଥିଛି ବିଶାଖା ହାରାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁକ୍ର ବୃହସ୍ପତି ଝଟକ ଦିଶନ୍ତି",
          "ଖଞ୍ଜିଛି କି ଫିରିଫିରାରେ",
          "ଚନ୍ଦ୍ରମା ସିନ୍ଦୂର ବିନ୍ଦୁ କି ସୁନ୍ଦର",
          "ଦିଶୁଛି ଉଛୁଳି ଧରାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ରାବଣା ସୀମନ୍ତୀ ପରେ ଖୋଷିଅଛି",
          "କୃତ୍ତିକା କୁସୁମ ଝରାରେ",
          "ଅନୁରାଧା ବେଣୀ ଯତନେ ବାନ୍ଧିଛି",
          "ନୟନ ହୁଅଇ ଧରାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶତଭିଷା ଫୁଲ ଅଫୁନ୍ଥା ମଣ୍ଡିଣ",
          "ଦିଶଇ କି ମନୋହରାରେ",
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ବୋଲଇ ବିଯୋଗୀ",
          "ଦେଖି ହେବେ ଦରମରାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
