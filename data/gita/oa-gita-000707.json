{
  "id": "oa-gita-000707",
  "name": {
    "en": "Bimbadhara re biswambhara",
    "or": "ବିମ୍ବାଧରା ରେ ବିଶ୍ୱମ୍ଭରା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bimbadhara-re-biswambhara-mukhari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିମ୍ବାଧରା ରେ ବିଶ୍ୱମ୍ଭରା ଦେବୀ ଚମ୍ପାଝରା ରେ",
          "ବନ୍ଧୁ ତୁ ମୋ ଛାତି ବିଭୂଷଣ ମୋତି",
          "ସୋରି କି ଦୁଃଖପାଶୋରା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବଳାରାତି ବଇଜୟନ୍ତ ପ୍ରାସାଦ",
          "ବିଳାସିନୀମାନେ ତାରା ରେ",
          "ବେଶ ସୁରସିକା ତୁ ଶରଦ ରାକା",
          "ରଜନୀ ଚନ୍ଦ୍ରମା ପରା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଲୋକି ଯା ମୋତେ ଉଠି ଲାଜ ସ୍ମିତେ",
          "ହେଉ ରମ୍ୟ ରଦାମ୍ବରା ରେ",
          "ବିଶେଷରେ ପୂତ କରୁ କି ରେ ମିତ",
          "ମୋ ମାର୍ଗକୁ ସୁଧାଛରା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିଧିରେ ଗିରିଜାରମଣଙ୍କ ପୂଜା",
          "କରି ଚମ୍ପା ପରମ୍ପରା ରେ",
          "ବୋଲାଏ ମୁଁ ବରବରନା ପ୍ରବର",
          "ତୋ କରପଇଠ ଧରା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୀଣା ବାଦନ ପ୍ରବୀଣା ପଣରେ ତୋ",
          "ଗଣନା ପ୍ରଥମ ଗିରା ରେ",
          "ବିଶ୍ୱ ବିମୋହନ ଗୁଣେ ତୁ ମୋ ଧନ",
          "ଧୀରାଙ୍କ ଲଲାମ ହୀରା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୋଲେ ଜଗଦ୍ଦେବ ସଙ୍କୋଚନ୍ତେ ବାଳା",
          "କିଶୋରଙ୍କର ପଚରା ରେ",
          "ବିଜେ ହେଉ ବଲ୍ଳୀ ମନ୍ଦିରକୁ ବୋଲି",
          "ଆଳୀ କହେ ଆଖିଠରା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
