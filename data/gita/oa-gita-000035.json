{
  "id": "oa-gita-000035",
  "name": {
    "en": "Ana go sakhi ana kadamba mulaku",
    "or": "ଅନା ଗୋ ସଖି ଅନା କଦମ୍ବମୂଳକୁ"
  },
  "composer": "oa-person-000024",
  "mula_raga": [
    "oa-raga-000023"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ana-go-sakhi-ana-kadambamulaku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନା ଗୋ ସଖି ଅନା କଦମ୍ବମୂଳକୁ",
          "କି ଶୋଭା ପାଉଛି ଶ୍ୟାମ ଯମୁନାକୂଳକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତ୍ରିଭଙ୍ଗିମା ଠାଣି କୁଟିଳ ଚାହାଣୀ",
          "ରଖିବ କି ସେ ଆଉ ପତିବରତି କୁଳକୁ ।",
          "କର୍ଣ୍ଣରେ କୁଣ୍ଡଳ ଲୁଳେ ଗଣ୍ଡମଣ୍ଡଳ",
          "ରତନବଳୟ ସାଜେ ବାହୁଯୁଗଳକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାଇ ଜୂଇ ମାଳ ତହିଁ କେତକୀ ଦଳ",
          "କି ରଙ୍ଗେ ମାନୁଛି ସହି ତା ବାଙ୍କ ଚୂଳକୁ",
          "ଭାଲେ ଗୋରଚନା ଅଧର ରଙ୍ଗିମା",
          "ମୋହନ ବଂଶୀକି ଶୋଭା କରକମଳକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଟିରେ କିଙ୍କିଣୀ ପାଦେ ନୂପୁର ବାଜେଣି",
          "ମଧୁର ଧ୍ୱନିରେ ମୋହେ ହୃଦୟ ସ୍ଥଳକୁ",
          "ଶ୍ରୀ ଶ୍ରୀ କୃଷ୍ଣଚନ୍ଦ୍ର ନୃପକୁଳଇନ୍ଦ୍ର",
          "ଲୋଟାଇଛନ୍ତି ଶିର ସେ ଚରଣତଳକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
