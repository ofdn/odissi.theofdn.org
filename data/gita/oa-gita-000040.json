{
  "id": "oa-gita-000040",
  "name": {
    "en": "Ahe prabhu kalasrimukha",
    "or": "ଆହେ ପ୍ରଭୁ କଳାଶ୍ରୀମୁଖ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000112"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-prabhu-kalasrimukha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହେ ପ୍ରଭୁ କଳାଶ୍ରୀମୁଖ",
          "କାଳଯାକ ଭଜି ନ ଗଲା ଦୁଃଖ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ଅବା ଛାମୁରେ ଜଣାଇବି ମୁହିଁ",
          "ସାକ୍ଷାତରେ ମୋ ଦୀନ ଅବସ୍ଥା ଦେଖ",
          "ତେଣୁ ଶ୍ରୀଛାମୁକୁ ଯାଇ ନ ପାରଇ",
          "ଖଣ୍ଡିଏ ତ ମୋର ନ ଥାଇ ଭେକ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସାହୁଙ୍କ ଜଞ୍ଜାଳ କୁଟୁମ୍ବଙ୍କ ଗୋଳ",
          "ଅନ୍ତର ବେଦନା ସବୁ ଅଧିକ",
          "କା ଆଗେ କହିବି କେ କଷ୍ଟ ଫେଡ଼ିବ",
          "ସଂସାରେ ମୋ ପରି ନାହିଁ ନିରେଖ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନ ମଧ୍ୟେ ମୋର ହରଷ ନ ଥାଇ",
          "ହୃଦୟ ମଧ୍ୟରେ ସଦା ବିମୁଖ",
          "ଚଉବର୍ଗଦାନୀ ଆଶ୍ରେ କରି ମୁଁ ଯେ",
          "କାହିଁରେ ଆଉ ନ ପାଇଲି ସୁଖ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବାତଚକ୍ର ପ୍ରାୟେ ମନ ଭ୍ରମୁଥାଇ",
          "ଦଣ୍ଡେ ନ ରହଇ ତୁମ୍ଭରି ପାଖ",
          "କହେ ବନମାଳୀ ଶଙ୍ଖରେ ପୂରାଇ",
          "ଚକ୍ର ଉହାଡ଼ି ଘୋଡ଼ାଇଣ ରଖ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-prabhu-kalasrimukha/"
    }
  ],
