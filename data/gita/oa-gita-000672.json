{
  "id": "oa-gita-000672",
  "name": {
    "en": "Pirati riti jana padila re",
    "or": "ପୀରତି ରୀତି ଜଣା ପଡ଼ିଲାରେ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000049"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pirati-riti-jana-padila-re-bibhasa-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପୀରତି ରୀତି ଜଣା ପଡ଼ିଲାରେ",
          "ଆଶା ତରୁ ମୂଳରୁ ଛିଡ଼ିଲାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶପଥ କରିବାର କହି ମଧୁର ଗିର",
          "ଜୀବନ ବିକା ସ୍ନେହ ତୁଟିଲାରେ",
          "ସ୍ମର ଧରି କୋଦଣ୍ଡ ସନ୍ଧି କୁସୁମ କାଣ୍ଡ",
          "ପରାଣ ନେବ ବୋଲି ଅଡ଼ିଲାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏତେ କାଳେ ସହସା ଆସି ପଡ଼ିଲା ଶଦଶା",
          "ଅନୁରାଗ ଶୃଙ୍ଖଳା ଫିଟିଲାରେ",
          "ପୂରୁବ ପାପୁଁ ମୋର ସେ ସୁଖ ହୋଇ ଦୂର",
          "ଚିନ୍ତାରେ ତନୁ ଏବେ ସଢ଼ିଲାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅନବରତେ ମୋର ଝୁରିବା ହେଲା ସାର",
          "କୁରରୀ ଦଶା ଆସି ଘଟିଲାରେ",
          "ବିରହେ କଳେବର କମ୍ପିଲା ବାରମ୍ବାର",
          "ନିରତେ ନୀର ନେତ୍ରୁ ଝଡ଼ିଲାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସରିଲା ସୁଖ ଶିରୀ ବଞ୍ଚିବି ମୁଁ କିପରି",
          "ମୋ ଠାରୁ ବନ୍ଧୁ ଚିତ୍ତ ହଟିଲାରେ",
          "ବୀରବିକ୍ରମ ବୋଲେ କି ହେବ ଏତେବେଳେ",
          "ବୁଦ୍ଧି ବିବେକ ସବୁ ବୁଡ଼ିଲାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
