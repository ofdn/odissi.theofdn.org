  "id": "oa-gita-001142",
  "name": {
    "en": "Mote lagana re braja bidhu lata",
    "or": "ମୋତେ ଲଗାନା ରେ ବ୍ରଜବିଧୁ ଲଟ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mote-lagana-re-braja-bidhu-lata-gopalakrusna-anandabhairabi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋତେ ଲଗାନା ରେ ବ୍ରଜବିଧୁ ଲଟ",
          "ତୃଣରୁ ତୁଚ୍ଛ ଜଟିଳା କରିବ ନିପଟ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଥରେ ହେଲେ ସ୍ୱଚ୍ଛ କରି ବିଲୋକି ନାହିଁ ମୁଁ ଡରି",
          "କଳା କି ଗୋରା ସେ ନବ ଶିଖଣ୍ଡ ମୁକୁଟ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅତି ମନ୍ଦ ମୋ ନଣନ୍ଦ ଜିଣିଲା କ୍ଷଣି ଅଳିନ୍ଦ",
          "ସକ୍ରୋଧ ହୋଇ ବଦନ କରୁଛି ବିକଟ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାଲି ଗୋଷ୍ଠ ପ୍ରାଙ୍ଗଣରେ ବୃଦ୍ଧ ଆଭୀର ସଭାର",
          "ଚନ୍ଦ୍ରାବଳୀର ଚରିତ ବସିଥିଲା ହାଟ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚାଲୁ ପାଦ କଣ୍ଟି କଣ୍ଟି ପଡ଼ୁଛି ନାନା ଅରଷ୍ଟି",
          "ତୁଚ୍ଛାକୁ ଲୋକ ତରକି ବାନ୍ଧୁଛନ୍ତି ବାଟ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୃଷ୍ଣ ଲାଗି ମାଳା ଦେଇ ଗୋପାଳକୃଷ୍ଣ କହଇ",
          "ଆନ ଦେଇଛନ୍ତି କିଳି ନ ଥାଅ କବାଟ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
