{
  "id": "oa-gita-000190",
  "name": {
    "en": "Aha mo jibana dhani",
    "or": "ଆହା ମୋ ଜୀବନ ଧନୀ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000055"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-mo-jibana-dhani-jibane-ki-thiba-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା ମୋ ଜୀବନ ଧନୀ ଜୀବନେ କି ଥିବରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିଶାକର ବିଧୁମୁଖୀ କିସ କରୁଥିବରେ",
          "ଆଶା ପଲଙ୍କରେ ବସି ଭାଷା ଲେଖୁଥିବରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗଳେ ଥିବା ମୋତିମାଳ ତୁଟି ଲୋଟୁଥିବରେ",
          "ଫିଟି ଲୋଟୁଥିବ କେଶ ଝାଳେ କଣ୍ଟୁଥିବରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଉତ୍ପଳନୟନୀ ତୋ କପାଳେ ଏହା ଥିଲାରେ",
          "ସୁଫଳିତ ଅଙ୍ଗ ତୋର ବିଫଳିତ ହେଲାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭଣେ ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ କରି ପ୍ରୀତି ଆଶାରେ",
          "ଆଉ କି ଶୁଣିବି ପ୍ରାଣପ୍ରିୟା ପିକଭାଷାରେ"
        ]
      }
    ]
  },
  "sources": [
