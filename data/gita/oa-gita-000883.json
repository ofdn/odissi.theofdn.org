  "id": "oa-gita-000883",
  "name": {
    "en": "Chahan sri nanda tanujaku",
    "or": "ସଜନୀ ଚାହାଁ ଶ୍ରୀ ନନ୍ଦ ତନୁଜକୁ"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000016"
  ],
  "kabya": {
    "id": "oa-kabya-000007"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-sri-nanda-tanujaku-asabari-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ଚାହାଁ ଶ୍ରୀ ନନ୍ଦ ତନୁଜକୁ",
          "ଶ୍ରୀମୁଖାଖଣ୍ଡ ଶାରଦକାଳ ଦ୍ୱିଜରାଜକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚାରୁ ଚାମିକର ଗୋରୀ ଶ୍ରାବଣ ବରଷା ସରି",
          "ଲୋତକ ବହୁଥିବା ଲୋଚନ ରକ୍ତକଞ୍ଜକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତାରକାଗଣ ପରିରେ ବସୁନ୍ଧରା ଗଗନରେ",
          "ଛିଡ଼ି ପଡ଼ି ଦିଶିବାର ମନୋହର ସଜକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁ ଡାକିବୁ ପରା ବୋଲି ଚାହିଁ ଚାହିଁ ବୁଲି ବୁଲି",
          "ଯାଉଥିବା ଗମନ ମନ୍ଥର ଗଜରାଜକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗଲେ ଶ୍ରୀ ବିକ୍ରମପାଳ ଫାଟିବଟି ତୋ କପାଳ",
          "ପଛେ କହିଲେ କି ହେବ ଏ ସଖୀ ସମାଜକୁ"
        ]
      }
    ]
  },
  "sources": [
