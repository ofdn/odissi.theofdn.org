{
  "id": "oa-gita-001122",
  "name": {
    "en": "Prana mitani re phitai kaha tu majja",
    "or": "ପ୍ରାଣ ମିତଣୀ ରେ ଫିଟାଇ କହ ତୁ ମଜ୍ଜା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000025"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prana-mitani-re-phitai-kaha-tu-majja-punnaga-baradi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣ ମିତଣୀ ରେ ଫିଟାଇ କହ ତୁ ମଜ୍ଜା",
          "ତୋତେ ମୋହନଙ୍କୁ ବନ୍ଦୀ କରିଥିଲା",
          "କୁଞ୍ଜେ କେଣେ ସ୍ମର ରଜା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚଳାପାଙ୍ଗୀ ପ୍ରଚଳାକ ମୁକୁଟ ତୁ",
          "ଭେଟ ହେଲୁ କେଉଁଠାରେ",
          "କି ଲଟରୁ ତାଙ୍କ ଉତ୍ତରୀୟ ପୀତ",
          "ପଟ ବହିଛୁ ଅଙ୍ଗରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଫୁଲ ତୋଳୁଥିଲୁ ପଲ୍ଲବ ଅଧରୀ",
          "ଏବେ ଆଳୀ ସନ୍ଦୋହରେ",
          "କେ ବିହିଲା ମଣ୍ଡମଣ୍ଡଳେ ତାମ୍ବୂଳ",
          "ବୋଳ ମକରୀ ଉପରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲବ ଶିଥିଳ ନୋହିଥିଲା ସଜାଡ଼ି",
          "ଥିବାର ସଜ ଯାବତ",
          "ମଦ କୁଞ୍ଜର କର କଞ୍ଜ ପରାଏ",
          "ହୋଇଛୁ ତ ଅସ୍ତବ୍ୟସ୍ତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କିଶୋରୀ ମୁକୁଟମଣି ମୋ ମୁହଁକୁ",
          "ଚାହୁଁ କିନା ସରି କରି",
          "ଲାଗକୁ ଆସ ବିନ୍ଦୁ ବିନ୍ଦୁ ମୁଖରେ",
          "ଝରିଛି ତ ଶ୍ରମ ବାରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୁନ୍ଦଲତାକୁ ହସିଣ ଶ୍ରୀ ଲଳିତା",
          "ଭାଷନ୍ତି କେ କହିଲାନି",
          "ଗୋପାଳକୃଷ୍ଣ ଭଜେ ରାଧା ପଦାବ୍ଜେ",
          "କୁସୁମ ବ୍ୟଜନ ଘେନି"
        ]
      }
    ]
  },
  "sources": [
    {
