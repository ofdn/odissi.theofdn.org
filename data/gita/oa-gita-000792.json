{
  "id": "oa-gita-000792",
  "name": {
    "en": "Dekhile kanhu manu na jiba go",
    "or": "ଦେଖିଲେ କାହ୍ନୁ ମନୁ ନ ଯିବ ଗୋ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000130"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekhile-kanhu-manu-na-jiba-go-kumbha-kamodi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖିଲେ କାହ୍ନୁ ମନୁ ନ ଯିବ ଗୋ",
          "ସତୀବରତ ଧୃତି ଭାଜିବ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନବ ନୀରଜ ନେତ୍ର ତମାଳ ପତ୍ର ଗାତ୍ର",
          "କାମଭରରେ ତନୁ ରାଜିବ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦିନେ ଦେଖିଲି ଡୋଳେ କେଳି କଦମ୍ବ ମୂଳେ",
          "ଆନନକୁ ଲକ୍ଷ୍ୟ କି ରାଜୀବ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଖିଲେ ତାଙ୍କ ନୃତ୍ୟ ନ ଛାଡ଼ିବ ତ ଚିତ୍ତ",
          "ଭୁଲି ତା ଠାରେ କେ ନ ମଜ୍ଜିବ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦିନେ ସେ କୁଞ୍ଜବନ ଦେଖି ହେଲି ଅଜ୍ଞାନ",
          "ସେଦିନୁ ହୋଇଅଛି ତାଜିବ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୋଲଇ ବନମାଳୀ ଶ୍ୟାମବନ୍ଧୁଙ୍କୁ ଭାଳି",
          "ସତେ ପିଣ୍ଡ ତେଜିବ ଏ ଜୀବ ଗୋ"
        ]
      }
    ]
  },
