{
  "id": "oa-gita-000284",
  "name": {
    "en": "Jagannatha ho kichi magu nahi tote",
    "or": "ଜଗନ୍ନାଥ ହୋ କିଛି ମାଗୁ ନାହିଁ ତୋତେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000088"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jagannatha-ho-kichi-magu-nahi-tote/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଗନ୍ନାଥ ହୋ । କିଛି ମାଗୁ ନାହିଁ ତୋତେ ।",
          "ଧନ ମାଗୁ ନାହିଁ ଜନ ମାଗୁ ନାହିଁ",
          "ମାଗୁଛି ଶରଧାବାଲିରୁ ହାତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆନ ଦରଶନ ନ ଲୋଡ଼େ ନୟନ",
          "ଏକା ତୋହ ଦେଖା ବିନା",
          "ଶୁଣିବାକୁ କାନ ନ ଇଚ୍ଛଇ ଆନ",
          "ତୋହ ଚରିତେ କାମନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜିହ୍ୱା ନ ବାଞ୍ଛଇ ଗ୍ରାମ୍ୟଗୀତ ଗାଇ",
          "-ବାକୁ ରଜନୀ ଦିବସ",
          "ତୋହ ନାମାବଳୀ କେବଳ ସଙ୍ଖାଳି",
          "ହୋଇଥାଉ ପୀତବାସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାସା ମୋର ତୃପ୍ତି ନ ଲଭଇ ଆନ",
          "ସୁବାସ ଦ୍ରବ୍ୟ ଆଘ୍ରାଣେ",
          "ତୋହ ଛଡ଼ାମାଳ ତୁଳସୀ କୁସୁମ",
          "ଚନ୍ଦନ କର୍ପୂର ଧ୍ୟାନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋ ହସ୍ତ ଅଙ୍ଗୁଳି ରାମ ବନମାଳୀ",
          "ହରେକୃଷ୍ଣ ଜପୁଥାଉ",
          "ବୋଲେ ବନମାଳୀ ମୋ ବେନି ଚରଣ",
          "ତୋ ତୀର୍ଥ ଭ୍ରମଣେ ଯାଉ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jagannatha-ho-kichi-magu-nahi-tote/"
    }
  ],
