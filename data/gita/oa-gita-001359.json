{
  "id": "oa-gita-001359",
  "name": {
    "en": "Kede mandapana mu kali",
    "or": "କେଡ଼େ ମନ୍ଦପଣ ମୁଁ କଲି"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000133"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kede-mandapana-mu-kali-sindhu-bhairabi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଡ଼େ ମନ୍ଦପଣ ମୁଁ କଲି ଆରେ ସହି",
          "କହୁ କହୁ ତିଳେ ଯା ନ ଘେନିଲି",
          "କରଗତ ହେବା କୁନ୍ଦନ ରତନ",
          "କାଢ଼ି ଯାହା ଫିଙ୍ଗିଦେଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୋଷ ହେଲା ବୋଲି ବାସକୁ ପ୍ରସାରି",
          "ଭାଷୁଥିଲେ କେତେ ପରି",
          "ନ ଶୁଣିଲି ଥରେ ମୋ ଶ୍ରୁତିପଥରେ",
          "ରୋଷକୁ ଯାହା ବହିଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେଜାଣେ ଏମନ୍ତ ତେଜିଯିବେ କାନ୍ତ",
          "କୁଞ୍ଜରୁ ବିମୁଖ ହୋଇ",
          "ରଜନୀ ଜାଗର ମଜ୍ଜାରେ ଥିବାରୁ",
          "ମଜ୍ଜାଇ କହିଲି ନାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ହେବ ଉପାୟ କହରେ ମୋ ଜୀବ",
          "ରହିବାର ତେଣେ ଥାଉ",
          "ଯାହା କଲେ ମାନ ତହିଁରୁ ଦ୍ୱିଗୁଣ",
          "ହୋଇ ବଳିଗଲା ଦାଉ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହେଲେହେଁ ଦଇନୀ ତିଳେ ତା ନ ଘେନି",
          "କଳହ କରିବା ଫଳ",
          "ଫଳିଲା ତା ଏତେ କାଳକୁ ସନ୍ତତେ",
          "ଭାଳିବାର ହେଲା ମୂଳ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୌରହରି ବୋଲେ ଗୌରବ ନ ଥିଲେ",
          "ସରସ ହୁଏ କି ପ୍ରୀତି",
          "ସରସୁ ଆଳିକି ଧରି ଛାଡ଼ିଲେକି",
          "କରଇ ଉଦାର ଶାନ୍ତି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
