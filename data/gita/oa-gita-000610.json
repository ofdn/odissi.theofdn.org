{
  "id": "oa-gita-000610",
  "name": {
    "en": "Eka eni drusaku mu chhadi ja",
    "or": "ଏଣୀଦୃଶାକୁ ମୁଁ ଛାଡ଼ି ଯା"
  },
  "composer": "oa-person-000024",
  "mula_raga": [
    "oa-raga-000157"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/eka-eni-drusaku-mu-chhadi-ja-meghaparni/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏକା ଏଣୀଦୃଶାକୁ ମୁଁ ଛାଡ଼ି ଯା ଅଇଲି ସତେ",
          "ଏଣିକି ଯେ କି ବଞ୍ଚିବି ବୁଦ୍ଧି ତ ନ ଦିଶେ ମୋତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଧୀରେ ଚାଟୁ ବଖାଣି ବିଧିରେ ଦେଉ ମେଲାଣି",
          "ଛଟକହାସୀ ବୋଇଲା ମୂରୁଛି ନ ଦେବ ଚିତ୍ତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହୋଇ ତ ଥିଲା ଅଦ୍ଭୁତ ଅଦ୍ଭୁତ କଲା ସମ୍ଭୂତ",
          "ତହିଁରୁ ଜାତ ଅମୃତ ଦେଖିଲି ହେଲା ସାକ୍ଷାତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରମେ ଥିଲା ଏ ମୋର ମରମେ ଲାଗିବ ମାର",
          "କୃଷ୍ଣଚନ୍ଦ୍ର ନରବର ବଦତି ଏ ରସ ଗୀତେ"
        ]
      }
    ]
  },
  "sources": [
