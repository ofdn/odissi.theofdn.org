{
  "id": "oa-gita-000623",
  "name": {
    "en": "Snehadhina tu mo kantha tata",
    "or": "ସ୍ନେହାଧୀନା ତୁ ମୋ କଣ୍ଠତଟ"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000078"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/snehadhina-tu-mo-kantha-tata-jadumani-madhusri/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସ୍ନେହାଧୀନା",
          "ତୁ ମୋ କଣ୍ଠତଟ ଜମ୍ବୁନଦ ସୁନା ମୀନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେତେବେଳେ ପାଶେ ଆସୁ ମନ୍ଥର ଗମନେ",
          "ମୁଁ ବିଚାରେ କି ସୁକୃତେ ଦେବ ଦରଶନେ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେତେବେଳେ ଗୀତ ଗାଉ ସଙ୍ଗୀତ ପ୍ରବୀଣା",
          "ମୁଁ ବିଚାରେ ବାଜୁଛିକି ସରସ୍ୱତୀ ବୀଣା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯେତେବେଳେ ହସି ଦେଉ ମୁରୁକି ମୁରୁକି",
          "ମୁଁ ବିଚାରେ ଚନ୍ଦ୍ରମାରୁ ସୁଧା ଝରୁଛି କି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯେତେବେଳେ ଚାହିଁଦେଉ କରୁଣା କଟାକ୍ଷେ",
          "ମୁଁ ବିଚାରେ ଏହି ମୋ ପୁନିଅଁ କୋଟି ଲକ୍ଷେ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯେତେବେଳେ ଧନ ମୋର ଅଙ୍କେ ବସିଥାଉ",
          "ମୁଁ ବିଚାରେ ଇନ୍ଦ୍ରପଦେ କିବା କାର୍ଯ୍ୟ ଆଉ ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବଦତି କୁଞ୍ଜବିହାରୀ ସିଂହ ମର୍ଦ୍ଦରାଜ",
          "ତୋ ଗୁଣ କି ପ୍ରଶଂସିବି କି କରିଟି ଆଜ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
