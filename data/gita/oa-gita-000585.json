{
  "id": "oa-gita-000585",
  "name": {
    "en": "Bata chhada suhata nagara",
    "or": "ବାଟ ଛାଡ଼ ସୁହଟ ନାଗର"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bata-chhada-suhata-nagara-kalyana-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାଟ ଛାଡ଼ ସୁହଟ ନାଗର",
          "ଯମୁନା ଯିବି ନୀର ଆଣିକି",
          "ଘାଟ ପାଇଁ ଯେବେ ଲଟ ଲଗାଇବ",
          "ପ୍ରୀତିବନ୍ଧା ଦେବି ମଥାମଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘରେ ମୋ ନଣନ୍ଦ ଅଟେ ବଡ଼ ମନ୍ଦ",
          "ଶାଶୁ ମୋ ଅଟଇ ସପତଣୀକି",
          "ଆହେ ଗିରିଟେକା ନ କର ତୁ ଡକା",
          "ତୁମ୍ଭ ଲାଗି ନ ଆସିବି ଏଣିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁହିଁ ବୃଷଭାନୁ ନୃପତିଙ୍କ ଜେମା",
          "ଆନ ପ୍ରାୟେ ମୋତେ ଅଛ ମଣିକି",
          "ଧରି ମୋ ଅଞ୍ଚଳ କରୁଛ ଜଞ୍ଜାଳ",
          "ଡର ନାହିଁ ପର ଭୂଆସୁଣୀକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଁ ଯେବେ ଏଥର ଆସିବି ପାଣିକି",
          "ସଙ୍ଗେ ଆଣିଥିବି ସଖୀ ଶ୍ରେଣୀଙ୍କି",
          "ବୋଲେ ବନମାଳୀ ଶୁଣ ଠାକୁରାଣୀ",
          "ନିରାଶ ନକର ବେଣୁପାଣିକି"
        ]
      }
    ]
  },
  "sources": [
