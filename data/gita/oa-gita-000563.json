{
  "id": "oa-gita-000563",
  "name": {
    "en": "Kahinki mana na ghenu",
    "or": "କାହିଁକି ମନ ନ ଘେନୁ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinki-mana-na-ghenu-gopalakrusna-dhanasri/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ମନ ନ ଘେନୁ ତୁ କେତେ କହିଲେ",
          "ଶ୍ରୀରାଧାକୃଷ୍ଣଙ୍କୁ ପଦାବ୍ଜେ ରହିଥା ବୋଇଲେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପରମ୍ପରାଦି ଲୋକରେ ନାହିଁ କେ ସଦୃଶରେ",
          "ଗଣନା ହୋଇବୁ ତାଙ୍କ କିଙ୍କରୀଙ୍କ ତୁଲେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଧୀଶାଧିଶ ମାଧୁରୀ ସ୍ୱଚ୍ଛନ୍ଦରେ ଅବଧରି",
          "ଯେମନ୍ତ ସୁଖ ଲଭିବୁ ହେଜିବୁ ସେ କାଳେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ସ୍ୱାମିନୀ ସ୍ୱାମୀଙ୍କର ଶ୍ରୀ ବୃନ୍ଦାରଣ୍ୟ ବିହାର",
          "ଦେଖି ଭାସିବୁ ପୀୟୂଷ ବାରିଧି କଲ୍ଲୋଳେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାସେଶ୍ୱରୀ ରାସେଶ୍ୱରୀ ହୃଦରେ ଆଉଜିବାର",
          "ରାସାବସାନେ ସେବିବୁ ବୟସୀ ସଙ୍କୁଳେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦିବ୍ୟ ନେତ୍ରେ ପ୍ରେମ ରଞ୍ଜି କର ଆଲୋକନ",
          "ରହି ରତ୍ନ ଚିନ୍ତାମଣି ସିଂହାସନ ତଳେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କୁତ୍ସିତ ବିଷୟ ଭୋଗ ଆଶାରେ ହୁଅନା ଯୋଗ୍ୟ",
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ମଜ୍ଜ ଅବିକଳେ"
        ]
      }
    ]
  },
