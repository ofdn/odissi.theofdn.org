{
  "id": "oa-gita-001324",
  "name": {
    "en": "Bansi teji hela",
    "or": "ବଂଶୀ ତେଜି ହେଲ"
  },
  "composer": "oa-person-000157",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bansi-teji-hela-harapriya-debadasi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଂଶୀ ତେଜି ହେଲ",
          "ଶଙ୍ଖ ଚକ୍ର ହସ୍ତ ହେ ରାଧାନାଥ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବ୍ରଜ ତେଜି ହେଲ ନୀଳଗିରି ବାସୀ",
          "ଖୋଜି ଖୋଜି ଭେଟ ପାଇଲୁ ହେ ଆସି",
          "କହିବାକୁ କଥା ଭୟ ଲାଗୁଅଛି",
          "ଗଲା ଗୋପପୁର ଭାସି ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୋବର୍ଦ୍ଧନ ଗିରି ନିକୁଞ୍ଜ କାନନ",
          "ନାରଖାର ସବୁ ହେଲାଣି ଏମାନ",
          "ଗୋରୁ ତରୁଲତା ମୃଗ କାନ୍ଦୁଛନ୍ତି",
          "କରି ତୁମ୍ଭ ମୂର୍ତ୍ତି ଧ୍ୟାନ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚନ୍ଦ୍ରଶାଳା ପୁର ଭାଜିପଡ଼ିଲାଣି",
          "ପଡ଼ି ଯଶୋଦାର ଦେହ ଛାଡ଼ିଲାଣି",
          "କାନ୍ଦି କାନ୍ଦି ନନ୍ଦ ଚକ୍ଷୁକୁ ନ ଦିଶେ",
          "ସବୁ ସୁଖ ସରିଲାଣି ହେ"
        ]
      }
    ]
  },
  "sources": [
