{
  "id": "oa-gita-001200",
  "name": {
    "en": "Ahe jagannatha dukhira sangata",
    "or": "ଆହେ ଜଗନ୍ନାଥ ଦୁଃଖୀର ସଙ୍ଗାତ"
  },
  "composer": "oa-person-000148",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-jagannatha-dukhira-sangata-brajanatha-badajena/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଆହେ ଜଗନ୍ନାଥ ଦୁଃଖୀର ସଙ୍ଗାତ",
          "ନ ରଖିଲେ ଭାସିଯାଉଛି",
          "ମତ୍ତ ଗରବରେ ପ୍ରଭୁଙ୍କୁ ନ ଚିହ୍ନି",
          "ତହିଁ ପ୍ରତିଫଳ ପାଉଛି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୀନ ବାହୁଯୁଗ ଟେକି ରଖିଅଛ",
          "ଦୀନକୁ ରଖିବା ପାଇଁ",
          "ଜଗନ୍ନାଥ ତୁମ୍ଭ ଜଗତ ଭିତରେ",
          "ମୋତେ କି ଗଣିଲ ନାହିଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାଳକ ଯାକ ତ ବାଳକ ବୁଦ୍ଧି ମୋ",
          "ନ ଗଲା କେହି ତରିଛି",
          "କାଳ ନାଶିବ ନାମକୁ ଆଶ୍ରେ କରି",
          "ଅକାରଣରେ ମରୁଛି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନାହିଁ ତାତ ମାତ ସ୍ୱାମୀ ଇଷ୍ଟ ମିତ୍ର",
          "ଭାଇ ବନ୍ଧୁ ଥାଇ ନାହିଁ",
          "ଏପରି ଦରିଦ୍ର ହେଲେହେଁ ସୁରେନ୍ଦ୍ର",
          "ଆହା ବୋଲନ୍ତାହିଁ ନାହିଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପତିତପାବନ ବାନା ଉଡ଼ାଉଛ",
          "ମୋ ଠାରେ ନ ଦିଅ ଦୃଷ୍ଟି",
          "ପର ଅପର ବିଚାର ତୁମ୍ଭେ କଲେ",
          "କିପରି ରହିବ ସୃଷ୍ଟି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦୀନ ଜନଙ୍କର ବନ୍ଧୁ ହୋଇ ଦୀନ",
          "-ବନ୍ଧୁ ନାମକୁ ବହିଲ",
          "ମୋହଠାରୁ ଦୀନଶ୍ରେଷ୍ଠ କେହୁ ଅଛି",
          "କାହାକୁ ଆଉ ରଖିଲ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ନାହିଁ ଯା ବିନା ଆନ ଗତି ସେ ତାକୁ",
          "ସବୁ ତ ଗୋଚର କଲେ",
          "ନଗ ଯେହ୍ନେ ଫଳି ଫୁଟି ଶୀର୍ଣ୍ଣ ହୋଏ",
          "କେବଳ ଧରା ଉପରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କି ରୂପ ତୁମ୍ଭର ଭଗତ ହୋଇଛୁ",
          "କି ରୂପେ କରୁଛ ଦୟା",
          "ଏହା ନ ଜାଣିଲି ମୁଖେ ତ ହୋଇଲି",
          "କେବଳ ଧରିଣ କାୟା"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଘରେ ବସିଥାଇ ମୁଖେ ଦେଲେ ଖାଇ",
          "ଚତୁର୍ମାସ୍ୟା ବକ ପରି",
          "ଆଜଗର ଚିନ୍ତୁ ଅଜାଣେ ଧାତା ବା",
          "ଗଢ଼ିଲା ମନୁଷ୍ୟ କରି"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ପୂରି ରହିଅଛି କରୁଣା ସମୁଦ୍ର",
          "ସରିଯିବ ତହୁଁ କେତେ",
          "କୁଶାଗ୍ର ବିନ୍ଦୁରେ ସୁଖୀ ହୋଇବି ମୁଁ",
          "କୋଟି ଜନ୍ମ ପରିଯନ୍ତେ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ଶିଷ୍ଟକରଣ କୁଳରେ ଜାତ ହୋଇ",
          "ଇଷ୍ଟ ଭଜି ନ ପାରିଲି",
          "ଅରକ୍ଷ ରକ୍ଷଣ ଜଗତ କାରଣ",
          "ଚରଣେ ଶରଣ ଗଲି"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ରଖ ବା ନ ରଖ ମୋର ନାହିଁ ସଖ୍ୟ",
          "ବିଧି ମତେ ସେବିବାର",
          "ବାରବାର କରି ଜଣାଉଛି ଦୀନ",
          "ବରଜନାଥ କିଙ୍କର"
        ]
      }
    ]
  },
  "sources": [
