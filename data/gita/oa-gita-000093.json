{
  "id": "oa-gita-000093",
  "name": {
    "en": "Garima ki paribu rakhi",
    "or": "ଗାରିମା କି ପାରିବୁ ରଖି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000038"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/garima-ki-paribu-rakhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗାରିମା କି ପାରିବୁ ରଖି",
          "ବାରିଜାକ୍ଷି ହରି ଠାରିଲେ ଆଖି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନାରୀ କୁଳେ ଜନମ ହୋଇ",
          "ତା ରୀତି କେ ନ ଜାଣେ ସହି",
          "ଘାରି ନୋହିଛି କେ ମଦନ ବାଣରେ",
          "ପାରୀନ୍ଦ୍ରମଧ୍ୟମା ଆଜନ୍ମସୁଖୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚାରିଦଶ ଭୁବନ ଯାକେ",
          "ବାରିବାକୁ ଆଉ ଅଛି କେ",
          "ବାରିଦବରନ ସୁନ୍ଦର ମୋହନ",
          "ଚାରି ହଜା ଖଣ୍ଡି ଅଛି ସେ ଶିଖି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହାରି ଯାକୁ ସେ ଶମ୍ବରାରି",
          "ସାରିଅଛି ଧୈର୍ଯ୍ୟ ଚାତୁରୀ",
          "ଶାରୀଟି ମୁଖରୁ ଶୁଣିଛୁ ତ ଗୋରୀ",
          "ଦାରିଦ୍ର୍ୟଭଞ୍ଜନ ଶୋଭା ଛଇକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପ୍ୟାରୀ ଘେନ ଚିତ୍ତେ ବିଚାରି",
          "ତ୍ୟାରି ବନମାଳୀ ସଞ୍ଚାରି",
          "ମାରିଦେଲେ ଶ୍ୟାମ ନୟନ କଟାରୀ",
          "ପାରିବ କେ ରହି କହ ସୁମୁଖୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
