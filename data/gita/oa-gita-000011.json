{
  "id": "oa-gita-000011",
  "name": {
    "en": "Bichakhyana re bina to priti",
    "or": "ବିଚକ୍ଷଣା ରେ ବିନା ତୋ ପ୍ରୀତି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ba Patala",
      "or": "ବ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bichakhyana-re-bina-to-priti-saberi-champu-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିଚକ୍ଷଣା ରେ",
          "ବିନା ତୋ ପ୍ରୀତି କେ ଗତି ଅଛି ଜଗତୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବୋଲି ଦେଲି ସିନା ଗେଲେ ହସି",
          "ବିଶ୍ୱେ ତୋ ସମ କାହିଁ ବିଶ୍ୱାସୀ",
          "ବାନ୍ଧିବାକୁ ମୋ ମନ ତୁ ପାଶି",
          "ବିଶେଷରେ ମୋ ହୃଦନ୍ତର ତୋତେ ଜଣା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଶ୍ୱମ୍ଭରା ରଜ ଖେଳା କାଳୁଁ",
          "ବହିଃପ୍ରାଣ ପରି ପରିପାଳୁ",
          "ବିଧିବଶୁ ନିସର୍ଗ କୃପାଳୁ",
          "ବ୍ରଜେ ହେଉଛି ଏହି ଡିଣ୍ଡିମ ବାଜଣାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିକେ କିଣେ ଯେ ଯାହାକୁ ସ୍ନେହେ",
          "ବଡ଼ ତାଠାରୁ ଜୀବନ ନୋହେ",
          "ବଳ ତାହାଠାରେ ସିନା ସହେ",
          "ବହିରଙ୍ଗେ ବୁଲୁଛନ୍ତି ଦେଖ ଅଗଣାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୋଲେ ଅଷ୍ଟଦୁର୍ଗର ମଘବା",
          "ବଲ୍ଲୀ ନିକଟକୁ ଚାଲ ଯିବା",
          "ବଂଶୀ ଗୀତ ପୀୟୂଷ ପୀଇବା",
          "ବିଭାବରୀ ନ ପାହୁଁ ଆସିବା ଅଜଣାରେ"
        ]
      }
    ]
  },
  "sources": [
