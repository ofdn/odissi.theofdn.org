{
  "id": "oa-gita-000390",
  "name": {
    "en": "Bara sarasa nayana barasa rasa",
    "or": "ବର ସାରସନୟନା"
  },
  "composer": "oa-person-000083",
  "mula_raga": [
    "oa-raga-000060"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bara-sarasa-nayana-barasa-rasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବର ସାରସନୟନା",
          "ବରଷା ରସ ପ୍ରକଟିଲା ଅନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୀଳ ନୀରଦ ଘୋଟିଲେ ଗଗନ",
          "ଝରଝର ଜଳଧର ସେ ଘନ ।",
          "(ପଡ଼ି)",
          "ଘଡ଼ିକି ଘଡ଼ି ରଡ଼ି କରଇ ଘଡ଼ଘଡ଼ି",
          "ଗିରିଶୃଙ୍ଗରୁ ଗଣ୍ଡ ଶୈଳ ପଡ଼େ କି ଝଡ଼ି",
          "ଝଟଝଟ ବିଜୁଳୀ ଝଟକେ ନେତ୍ରେ ଗଳି",
          "ପଡ଼ି ବିରହୀଚୟ ବିରହାନଳେ ସଡ଼ି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୁମନ ମଲ୍ଲୀ ମାଳତୀ ଫୁଟିଲେ",
          "ଦିଶେ ବିଦେଶେ ବାସ ଚହଟିଲେ ।",
          "(ପଡ଼ି)",
          "ଭ୍ରମରେ ଭୁଁକୃତେ ଭ୍ରମିଲେ କାନନେ",
          "ଝିଲ୍ଲି ସମୁଦୟ ଝଂକୃତ ସ୍ୱନ",
          "ଡାହୁଖ କଳଦଳ ମର୍ମଦଳ ତାଡ଼ନ",
          "ଟେକି ପୁଚ୍ଛ କରେ କେକୀ ନର୍ତ୍ତନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଳଜମାନେ ଜଳରେ ବୁଡ଼ିଲେ",
          "ବଳାକାପନ୍ତି ଆକାଶେ ଉଡ଼ିଲେ ।",
          "(ପଡ଼ି)",
          "ଦେଖି କି ହରଷ ଭେକ ଭକଭକ",
          "ଶାମୁକ ନାଦ ହିଁ ଶୁଭଇ ଚମକ",
          "ମାନିନୀ ଯୁବତୀର ହୃଦୟ ଦମକ",
          "ହେବନି ନୟନରୁ ଲୋତକ ଥକଥକ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନାରାୟଣ ପଟ୍ଟନାୟକ ଭାଷେ",
          "କିଶୋର ବଦନ୍ତି କିଶୋରୀ ପାଶେ ।",
          "(ପଡ଼ି)",
          "ଶକ୍ରଧନୁ ଛଳେ ଅତନୁ ଧନୁ ରୁଚି",
          "ବିନ୍ଧେ ଦମ୍ଭୋଳି ଶର ମର୍ମରେ ଯୋଚି",
          "ଜଡ଼ି ଯା ତନୁରେ ମୋ ତରଜ ମନୁଁ ମୁଞ୍ଚି",
          "ଯାଉ ହରପର ଶର ଗରବ ଘୁଞ୍ଚି"
        ]
      }
    ]
  },
  "sources": [
