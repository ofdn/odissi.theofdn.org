{
  "id": "oa-gita-000903",
  "name": {
    "en": "Sahire sahili mahire",
    "or": "ସହୀରେ ସହିଲି ମହୀରେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000081"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahire-sahili-mahire-bihagada-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହୀରେ ସହିଲି ମହୀରେ ସତେ କି ଦଶା",
          "ନାହିଁରେ କାହିଁ କେ ମୋ ସରି ଖୋଜିଲେ ରସା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅନ୍ଧାର ନିଶି ବୋଲି ନୀଳଶାଢ଼ୀ ଘେନିଲି",
          "ଅଭିସାରେ ବଳାଇ ଆଶା",
          "କପାଳ ଗଲା ଫାଟି ପଥେ ଚାନ୍ଦ ଚହଟି",
          "ସାରିଲା ମୋର ଭରସା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପଡ଼ିଲି ତା ହାବୁଡ଼େ ଡରି ମରେ ଯାହାରେ",
          "କୁଟିଳା କଟୁ ଯା ଭାଷା",
          "ରାଧା କୁଳଟା ବୋଲି ଜନେ ରଟିବେ କାଲି",
          "କୁଳିଶ ହେବ ବରଷା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୁଣିଲା କବିଶଶୀ ଲଳିତା କହେ ହସି",
          "ଏ ପରା ମାଧବ ନିଶା",
          "କୁଳଟା କହୁ କେହି ପସରା କିବା ସହି",
          "ଛାର ତ ଏ ଲୋକହସା"
        ]
      }
    ]
  },
  "sources": [
