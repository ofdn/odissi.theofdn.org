    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କରୁଣାମୟ ନାଥ ହେ",
          "ଦୁଃଖନାଶନ କର ତ୍ରାହି",
          "ଦୀନବାନ୍ଧବ ଭକ୍ତବତ୍ସଳ",
          "ଶାନ୍ତି କାନ୍ତି ସଦା ହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେ ନିରଞ୍ଜନ ବିଘ୍ନନାଶନ",
          "ଆନନ୍ଦ ଅକୂପାର ହେ",
          "ନାମ ସୁମଧୁର ପୀୟୂଷ ନିର୍ଝର",
          "ପାନେ ତୋଷ ଅପାର ହେ"
        ]
      }
    ]
  },
