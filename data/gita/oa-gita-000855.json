    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ହେ ସତ କହ",
          "କିଏ ଶିଖାଇଲା ଏ ମୁରଲୀ ଧରା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହା ଲାଗି ତୁମେ ଯାଅ ଯମୁନା",
          "କାହା ଲାଗି ତୁମେ ଛଇଳ କାହ୍ନା",
          "କାହା ଲାଗି ତୁମେ ବାଙ୍କଚୂଳ ପରେ",
          "ରଙ୍ଗେ ଖଞ୍ଜିଅଛ ଶିଖଣ୍ଡଝରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାହା ଲାଗି ତୁମେ ଯାଅ ଯମୁନା",
          "କାହା ଲାଗି ତୁମେ ଛଇଳ କାହ୍ନା",
          "କାହା ଲାଗି ତୁମେ ବାଙ୍କଚୂଳ ପରେ",
          "ରଞ୍ଜି ଖଞ୍ଜିଅଛ ଶିଖଣ୍ଡଝରା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରାଧା ବିନେ ଆଉ କାହାରି ନାମ",
          "ମୁରଲୀରେ ଧରି ନ ଜାଣ ଶ୍ୟାମ",
          "କଦମ୍ବର ମୂଳେ କାହା ପଥ ଚାହିଁ",
          "ଝରାଅ କମଳନୟନୁ ଧାରା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପ୍ରେମର ଗୁରୁ ସେ ବରଜ ଗୋଇ",
          "ଦଗା ଦେଲା ତାରେ କଲା କହ୍ନାଇ",
          "କହେ କବିଶଶୀ କହ କଳାଶଶୀ",
          "କୀରତି ପତାକା ଉଡ଼ାଇ ପରା"
        ]
      }
    ]
  },
