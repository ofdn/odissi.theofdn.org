{
  "id": "oa-gita-000423",
  "name": {
    "en": "Asa go braja nagari modaku bhari",
    "or": "ଆସ ଗୋ ବ୍ରଜନାଗରୀ ମୋଦକୁ ଭରି"
  },
  "composer": "oa-person-000094",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asa-go-braja-nagari-modaku-bhari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସ ଗୋ ବ୍ରଜନାଗରୀ । ମୋଦକୁ ଭରି ।",
          "ବନୁ ଆସନ୍ତି ଶ୍ରୀ ହରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧବଳୀ ସୁରଭୀଗଣ ଚରଣରେ ରେଣୁକଣ",
          "ପ୍ରାଚୀ ଅଙ୍ଗରେ ପ୍ରାଙ୍ଗଣ ପ୍ରଦୋଷେ ଗଲାଣି ପୂରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ୱେଦ ପୂରିଛି ଶ୍ରୀଅଙ୍ଗେ । ସଖାଙ୍କ ସଙ୍ଗେ ।",
          "ବିହରି ତାଣ୍ଡବ ରଙ୍ଗେ ।",
          "ନବୀନ ଘନବରନ ସୁମଧୁର ଅପଘନ",
          "ଯୁଗମଣ୍ଡଳୀ ମଣ୍ଡନ ହେଲାଣି ଏ ପୁର ଲାଗି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆସ ଗୋ କାଞ୍ଚନମାଳା । କାହିଁକି ହେଳା ।",
          "କରୁଛ କେଳିକୁଶଳା ।",
          "କି କରୁଅଛ ସଦନେ ମୁରଲୀ କାକଳୀ କାନେ",
          "ପଡ଼େ ନାହିଁ କି ମୋହନେ ଆସ କର ତୁ ସଙ୍ଖୋଳା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆସ ଗୋ ହେମମଞ୍ଜରୀ । ରଖ କବେରୀ ।",
          "ବନ୍ଧନ ମୃଗ ଚଉଁରୀ ।",
          "ସଫଳ କର ନୟନ ଚାହିଁ ଏ ରୂପ ଲାବଣ୍ୟ",
          "ଲୋଡ଼ିଲେ ଆଉ ସୁଦିନ ନ ପାଇବୁ ତୁ ଏପରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଲଳିତା ଶୁଣି ଏ ବାଣୀ । ଯାଇଁ ସେକ୍ଷଣି ।",
          "ଶ୍ରୀମତୀ ପାଶରେ ଭଣି ।",
          "ଭାଷିଲେ ଭୂପତି ଶିରମୁକୁଟ ରାଜକିଶୋର",
          "ଚନ୍ଦ୍ରରାଜ ସୁରରାଣ ସେ ଗୋପୀଙ୍କ ଭାବ ଗୁଣି"
        ]
      }
    ]
  },
