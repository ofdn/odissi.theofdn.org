{
  "id": "oa-gita-000743",
  "name": {
    "en": "Mun biki deichi parana",
    "or": "ମୁଁ ବିକିଦେଇଛି ପରାଣ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mun-biki-deichi-parana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୁଁ ବିକି ଦେଇଛି ପରାଣ ଘନଶ୍ୟାମଙ୍କୁ",
          "ଆସିଲେ ନ ଆସୁ ପଛେ କାହା ମନକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କିଶୋରୀ କାଳରୁ ସଖୀ",
          "ତାଙ୍କ ନାମ ମୁଖେ ରଖି",
          "ନ ଚିହ୍ନିଲେ ଶ୍ୟାମବନ୍ଧୁ ମୋର ମନକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରଜସାରା ବୁଲି ବୁଲି",
          "ମୋ ନାମେ କରନ୍ତି ହୁରି",
          "ସଂସାରେ କେହି ନ ଥିବେ କହିଦେବାକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋପୀଙ୍କ ବସନ ନେଇ",
          "କଦମ୍ବ ଡାଳରେ ଥୋଇ",
          "ସମସ୍ତ ଦେହ ଉଲଗ୍ନ ଥରିବୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୂତୀ କର ଧରି ସଖୀ",
          "କହଇ ହୋଇ ବିମୁଖୀ",
          "ଆଉ କାହା ପୁରେ ଶ୍ୟାମ ଦେଲେ ମନକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବନମାଳୀ ଦାସ ଭଣି",
          "ଧନ୍ୟ ସେ ବଙ୍କିମା ଠାଣି",
          "କର ଯୋଡ଼ି ଜଣାଉଛି ତାର ପ୍ରେମକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mun-biki-deichi-parana/"
    }
  ],
