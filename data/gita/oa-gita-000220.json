{
  "id": "oa-gita-000220",
  "name": {
    "en": "Dhiradhara mandana hudilu re",
    "or": "ଧୀରାଧରା ମଣ୍ଡନା ହୁଡ଼ିଲୁ ରେ"
  },
  "composer": "oa-person-000035",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhiradhara-mandana-hudilu-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧୀରାଧରା ମଣ୍ଡନା ହୁଡ଼ିଲୁ ରେ",
          "ହୀରା ପଥର ଜ୍ଞାନେ ଛାଡ଼ିଲୁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିର୍ମଳ ମନ୍ଦାକିନୀ ସଲିଳ ମନ୍ଦ ମଣି",
          "ନର୍ଦ୍ଦମା ଜଳ ପୁଣି ଲୋଡ଼ିଲୁ ରେ ।",
          "(ପଡ଼ି)",
          "ଦଣ୍ଡେ ନ ଚାହିଁଲୁ ଚନ୍ଦ୍ର ମଣ୍ଡଳ",
          "ଚଣ୍ଡ ମିହିର କଳପେ କରି ଠୂଳ",
          "ଭାଗ୍ୟେ ନାହିଁ ଭୋଗ ଦିବ୍ୟ ନିର୍ମଳ",
          "ଚାରୁ ଚନ୍ଦ୍ରିକା କିରଣ ସୁଶୀତଳ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଦ୍ଧଶାଳୀ କେଦାର ଛାଡ଼ି ଲୋଡ଼ି ଉଷର",
          "କରଷଣେ ଆଦର ବାଢ଼ିଲୁ ରେ ।",
          "(ପଡ଼ି)",
          "ଚାରୁ ମଧୁ ଋତୁ କାନ୍ତ କୋକିଳ",
          "ମନ୍ଦ କାକଳୀ ଶବଦ ପ୍ରତିକୂଳ",
          "ଶଲ୍ୟ ମଣି କଲୁ ଦିବ୍ୟ ନିର୍ମଳ",
          "କାକ ଡାକକୁ ଆଦରି ହେଲୁ ଭୋଳ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମହାମେରୁ ଶିଖର ବିହାର କରିଦୂର",
          "ତଳାତଳେ ନିକର ପଡ଼ିଲୁ ରେ ।",
          "(ପଡ଼ି)",
          "ମୃଦୁ ମଳୟର ପରଶ କୋମଳ",
          "ବାସ ଚନ୍ଦନ ଗନ୍ଧ ପରିମଳ",
          "ମନ୍ଦ ପାଞ୍ଚିଲୁ ବରଜି ସକଳ",
          "ବନ୍ଧୁ କରିନେଲୁ ଆଦରେ ଦାବାନଳ"
        ]
      }
    ]
  },
