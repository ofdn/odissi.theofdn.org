  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bansi-re-tora-ediki-dau/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଂଶୀରେ ତୋର ଏଡ଼ିକି ଦାଉ",
          "ଦମ୍ଭ ଧରି କେବା ସହିବ ଆଉ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୟାମ କରେ ଅନୁବରତେ ଥାଉ",
          "ଆମ୍ଭ ରାଧା ନାମୁଁ କି ସୁଖ ପାଉ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପଞ୍ଚମ ତାନରେ କି ଗୀତ ଗାଉ",
          "ଗୋପିନୀକୁଳେ କଳଙ୍କ ଲଗାଉ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୋହନ ଅଧର ଅମୃତ ଖାଉ",
          "ବ୍ରଜେ ଅକୀର୍ତ୍ତି ଘୋଷଣା ଦିଆଉ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ବୋଲେ ନ ବାଜ ଆଉ",
          "ସବୁ ଯାଉ ପଛେ ମହତ ଥାଉ"
        ]
      }
    ]
  },
