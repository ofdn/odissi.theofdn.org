{
  "id": "oa-gita-000619",
  "name": {
    "en": "Sagara suta bara nagara",
    "or": "ସାଗରସୁତା ବର ନାଗର"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000159"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sagara-suta-bara-nagara-malagujjari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଗରସୁତା ବର ନାଗର ଅରି ଧର",
          "ଆଗରେ ମାଗ ବର ମାନସରେ",
          "ନାଗର ଜାଳ ହର ତ୍ୟାଗର ନରବର",
          "ରାଗରେ ଆଗସରି ଯା ରସରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶରଣ ଜନ ଦୁଃଖହରଣ କର୍ତ୍ତା ସୁଖ",
          "ଭରଣଦ ଶ୍ରୀମୁଖ ସାରସରେ",
          "କ୍ଷରଣ କୃପା ସୁଧା ବାରଣବର ବାଧା",
          "କାରଣ ଜଣା ତାର ପାରଶ୍ୱରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବୃନ୍ଦାରକ ବନ୍ଦନ ବୃନ୍ଦାରଣ୍ୟ ମଦନ",
          "ଚନ୍ଦ୍ର ନନ୍ଦନନ୍ଦନ କୁଞ୍ଜେଶରେ",
          "ବନ୍ଦ ଅନିଶେ ପଦ୍ମ ପଦ ଦ୍ୱନ୍ଦ ଆନନ୍ଦ",
          "ଲଭିବୁ ପଦ୍ମ ସଦ୍ମ ଅବଶ୍ୟରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଧରିତ୍ରୀ ଧର ଧର ହରିଣୀ କଷ୍ଟ ହର",
          "ଚରିତ ଗାନ କର ସରସରେ",
          "କ୍ଷରି ସୁରସରିତ ପରିତ୍ରାଣ ଦାନିତ୍ୟ",
          "ଯେ ପଦୁ ତଥି ହୁଅ ଅଳୀଶରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶମନ ତମ କମ ହେବ ତୁଟିବ ଭ୍ରମ",
          "ତମ ଗ୍ରାମ ବର୍ଜି ତୁ ହରଷରେ",
          "ରମଣୀୟ ଶ୍ରୀନାମ ଭଜନେ ହୁଅ କ୍ଷମ",
          "ଶ୍ରମ ଜଞ୍ଜାଳେ ଲବେ ନ ରସରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଣିମାଦି ଶ୍ରୀ ସୁଖ ପଶିବା ମଣିମାଙ୍କ",
          "ଭୃତ୍ୟରେ ଗଣି ହୁଅ ଅନିଶରେ",
          "ଭଣି ତା ଯଦୁମଣି ବାଣୀ ଆନ ନ ମଣି",
          "ବଣିଜ କର ପଦ ସାରସରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
