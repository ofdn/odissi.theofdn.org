{
  "id": "oa-gita-000891",
  "name": {
    "en": "Sajani to rana sate",
    "or": "ସଜନୀ ତୋ ରାଣ ସତେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000016"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-to-rana-sate-pilu-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରିଗଲି ଲାଜେ ସଜନୀ ତୋ ରାଣ ସତେ",
          "ନଟବର ନବରଙ୍ଗ କହିବି କେତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୀରିଷମ ନିଶି ଶଶୀ ଗିରିସମ ଯାଏ ଦିଶି",
          "କୁଞ୍ଜେ କୁଞ୍ଜେ ମଧୁ ସଞ୍ଜେ ଥିଲି ବସି",
          "ଚାହିଁ ଏକା ସେ ମୋ ପାଶେ ମିଳିଲେ ଆସି",
          "ଚାରୁ ଚନ୍ଦ୍ର ଦରଶାଇ ଚୁମ୍ବିଲେ ମୋତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛଇଳ ସେ ବାସଚୋର ଛପି ପଛେ ପଛେ ମୋର",
          "ଅଙ୍ଗବାସ ଭିଡ଼ା ଫେଇ ଅଜାଣତେ",
          "ବନ୍ଧୁ ସଙ୍ଗେ ସାଥୀ ହେଲ ସେ କି ସତେ",
          "ଲାଜେ ସରିଗଲି କେତେ ଖୋଜିଲି ତୋତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କବିଚନ୍ଦ୍ର ଥିଲା ଚାହିଁ କହିଲା ସେ ଚାନ୍ଦମୁହିଁ",
          "ଆଉ କାହିଁ କହ ମାନ ଗୁମାନ ତୋର",
          "ପାଶେ ପାଶେ ମିଳିଲେ ତ ତୋ ମନ ଚୋର",
          "ଅଙ୍କେ ବସି ପ୍ରିୟ ସଙ୍ଗେ ରସ ସୁରତେ"
        ]
      }
    ]
  },
  "sources": [
