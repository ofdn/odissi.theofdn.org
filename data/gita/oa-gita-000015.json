  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nacha-gopalasundara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରିମି ଝିମିକି ଝିମି । ଚାରୁ ନୂପୁର ବାଜେ ।",
          "ନାଚ ଗୋପାଳସୁନ୍ଦର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାମଗର ଗଞ୍ଜନ । ଛବି ଦଳା ଅଞ୍ଜନ ।",
          "ରାଈ ମାନ ଭଞ୍ଜନ । ଜଗଜ୍ଜନ ରଞ୍ଜନ ।",
          "(ପଡ଼ି)",
          "ପା ପା ପା ମା ପା ଗା ମା ପା ନି ପା ସା ସା ସା",
          "ଛନ୍ଦେ ମୋହନ ମୁରଲୀ ବାଜେ",
          "ବାଜେ ମର୍ଦ୍ଦଳ ଥେଇ ତା ଥେଇ ଥେଇ",
          "ତି କିଟିତାକ ତାକଝିଣା କେଟେତାକ",
          "ଥୈ ଧେଇ ଧେଇ ଧେଇ ଧେଇ"
        ]
      }
    ]
  },
  "sources": [
