{
  "id": "oa-gita-001318",
  "name": {
    "en": "Sri radha batuli prema",
    "or": "ଶ୍ରୀରାଧା ବାତୁଳୀ ପ୍ରେମ ରସାତୁଳୀ"
  },
  "composer": "oa-person-000155",
  "mula_raga": [
    "oa-raga-000034"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-radha-batuli-prema-rasatuli-bidagdha-chintamani-krusna-kedara/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀରାଧା ବାତୁଳୀ ପ୍ରେମ ରସାତୁଳୀ",
          "ଘେନ ଚିହ୍ନରା ଗ୍ରାହକମାନେ",
          "କୃଷ୍ଣ ଅତି ଦୀନେ ଦୂତିକାକୁ ଦିନେ",
          "ପଚାରନ୍ତି କର ଧରି ଛନ୍ନେ",
          "ପ୍ରାଣବନ୍ଧୁ ରୀତି",
          "କହି ମୋ ଶ୍ରୁତିକି କର ଗତି",
          "ହସି ଦୂତୀ ଭାଷେ ପ୍ରେମ ଜଳେ ଭାସେ",
          "ବିହ୍ଵଳିତ ମତି ଦିବା ରାତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାଳିଆ କମଳ ଦେଖିଲେ କମଳ",
          "ନୟନରେ ହୁଏ ଜରଜର",
          "ଦେଖି ନବଘନ ତାର ଅପଘନ",
          "ପୁଲକି ହୁଅଇ ଥରଥର",
          "ଘନ ସୁନ୍ଦର ହେ",
          "ଯମୁନା ଯିବାକୁ ତରତର",
          "ଏ ଅତି ବିଚିତ୍ର କଜ୍ଜ୍ଵଳରେ ଚିତ୍ର",
          "ଲେଖି ଚୁମ୍ବ ଦିଏ ବାରବାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଖି ତମାଳକୁ ବିଚାରି କୋଳକୁ",
          "ସଜ ହେଉଥାଇ ବାହୁ ଯୁଗ",
          "ଶ୍ୟାମ ସୁବାସରେ ଆଶ ମାନସରେ",
          "କଳାବତୀ ସଙ୍ଗେ ଅନୁରାଗ",
          "ରସ ଶେଖର ହେ",
          "ଭୂଷଣ ନୀଳେନ୍ଦ୍ର ମଣିହାର",
          "ବସି ରାମାବର ଫିଟାଇ କବର",
          "ଦେଖୁଥାଇ ଥୋଇ ହୃଦେ ତାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହେମ ମରକତ ଯୋଖି ଅଶକତ",
          "ପରି ନେତ୍ର ମୁଦି ରହେ କ୍ଷଣେ",
          "ଦଇବ ଘଟନ ମୟୂର ନଟନ",
          "ଦେଖି ସୁଖୀ ହୁଏ କେଉଁ ଗୁଣେ",
          "ଭାବ ବିନୋଦ ହେ",
          "କୃଷ୍ଣ ବର୍ଣ୍ଣ ଶେଯେ ମାଡ଼େ ନିଦ",
          "ଶ୍ରୀ ଅଙ୍ଗ ତିଳକୁ ଚାହିଁବା ବେଳକୁ",
          "ଚିତ୍ତରେ ଜାତ ହୁଏ ମୁଦ"
        ]
      }
    ]
  },
  "sources": [
