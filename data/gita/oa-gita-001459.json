{
  "id": "oa-gita-001459",
  "name": {
    "en": "Nirmala chandra mandala",
    "or": "ନିର୍ମଳ ଚନ୍ଦ୍ରମଣ୍ଡଳ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000009"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nirmala-chandra-mandala/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ନିର୍ମଳ ଚନ୍ଦ୍ରମଣ୍ଡଳ ଶରଦେ ବିରାଜି",
          "ଦିଶେ ଯଥା ଦର୍ପକ ଦର୍ପଣେ ଥିଲେ ମାଜି",
          "ଚାହିଁ କୁମର କାତର",
          "ଲେଖି ଆରମ୍ଭିଲା ବସି ବିନୟ ପତର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାନକୀବଲ୍ଲଭ ପଦ୍ମପାଦେ ଚିତ୍ତ ଥାଉ",
          "ରାଜସୁତା ପ୍ରୀତି କଉଶଳାକୁ ଚିଟାଉ",
          "ଏବେ ମରୁଅଛି ଝୁରି",
          "ଦରିଦ୍ର ରତନ ପାଇ ହରାଇଲା ପରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁ ମୋ ପ୍ରତିଚକ୍ଷୁ ଯେଣୁ ହୋଇଛୁ ଅନ୍ତର",
          "ଦିଶୁ ନାହିଁ କିଛି କାହିଁ ଆନ ପ୍ରତିକାର",
          "ନୂଆ ଅନ୍ଧ ପ୍ରାୟ",
          "ହୋଇ ଅନୁକ୍ଷଣେ ଆକୁଳ ବଢ଼ୁଛି ପ୍ରାଣସହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୂରେ ଥିଲେ ପାଶେ ଅଛି ଏହା ଥିବୁ ଘେନି",
          "କେତେ ଦୂରେ ଚନ୍ଦ୍ର କେତେ ଦୂରେ କୁମୁଦିନୀ",
          "ପ୍ରୀତି ଅଭେଦ ତାଙ୍କର",
          "ଯେତେ ଦୂରେ ଥିଲେ ଯେ ଯାହାର ସେ ତାହାର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯେତେ ଦୂରେ ପତ୍ର ପଡ଼ିଥିଲେ ରେ ନବୀନା",
          "ଚିହ୍ନା କି ନୁହଇ ଆନେ ବୃକ୍ଷ ନାମ ବିନା",
          "ବନ୍ଧୁ ତେମନ୍ତ ମୁଁ ତୋର",
          "ସବୁଠାରେ କୁହାଉଛି ସୁନ୍ଦରୀକୋୟର"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଯେଣେ ଅନାଇଁଲେ ଇନ୍ଦ୍ରଜାଲ ପ୍ରାୟେ ଦିଶୁ",
          "ମୁକୁରବିମ୍ବ ପରାୟେ ପାଶକୁ ନ ଆସୁ",
          "ଏଡ଼େ ହଟ କାହିଁ ପାଇଁ",
          "ମୋହ ଜାଣିବାରେ ତ ମୁଁ ଦୋଷ କରି ନାହିଁ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ତୋ ପ୍ରୀତିରେ ଦ୍ରବେ କାମ ବିଶିଖକୁ ସହି",
          "ବିଧୁଶିଳ ପ୍ରାୟେ କି ହୋଇଲା ମୋର ଦେହୀ",
          "ମନ ଲୋହ ହୋଇଥିଲା",
          "ତୋ ଚୁମ୍ବ ଚୁମ୍ବକ ବଳେ ହୃଦୁ କାଢ଼ି ନେଲା"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ବିରହକୁ ଉପଚାର ମାତ୍ର ମନୋହାରୀ",
          "ପଲ୍ଲବଶଯ୍ୟାଦି ଯେତେ ବିଅର୍ଥରେ କରି",
          "ଏବେ ଅନୁଭବ ହେଲା",
          "ଗ୍ରହରେ ମଙ୍ଗଳପଦ ଯେମନ୍ତ ରହିଲା"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ବୃଦ୍ଧିନଦୀ ତଟ ତରୁ ପରାୟେ ଜୀବନ",
          "ସନ୍ଦେହ ପଡ଼ିଛି ଏଥୁଁ ତରିବି କେସନ",
          "ରାହୁଦଶା ପ୍ରାୟେ ମୋର",
          "ସୁଧାପାନ ଉତ୍ତାରୁ ଛେଦନ ହେଲା ଶିର"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ଚନ୍ଦ୍ରକୁ ଚକୋର ଜଳଧରକୁ ଚାତକ",
          "ପ୍ରାୟେ ତୋତେ କରିଥାଇ ମୁଁ ଆଶା ଅନେକ",
          "ଧାତା ନଟକାର ପରି",
          "ଦେଖାଇ ତ ହରି ନେଲା କନକଗଉରୀ"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ବାହାର ଅତି କଠୋର ଭିତର ସରସ",
          "ନାଗରୀ ହୃଦୟ ନାରିକେଳର ସଦୃଶ",
          "ଆଲିଙ୍ଗନେ କୃପାବଶେ",
          "ଜାଣିଥିଲି ଆନ ହେଲା ବିଚ୍ଛେଦୁଁ ଏବେ ସେ"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ଏତେ କାଳେ କଲୁ ନାହିଁ ପତ୍ରିକା ପ୍ରଦାନ",
          "ଦୂତ ପେଷି ଥରେ ହେଲେ ନ ସଙ୍ଖୋଳୁ ଧନ",
          "ସହି ସେହି ହୃଦ ତୋର",
          "ରସାଳ ପରାୟେ କି ହୋଇଲା ରାମାବର"
        ]
      }
    ]
  },
