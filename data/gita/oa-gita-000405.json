{
  "id": "oa-gita-000405",
  "name": {
    "en": "Surate tosibi naha",
    "or": "ସୁରତେ ତୋଷିବି ନାହା"
  },
  "composer": "oa-person-000089",
  "mula_raga": [
    "oa-raga-000114"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/surate-tosibi-naha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସୁରତେ ତୋଷିବି ନାହା",
          "ଏ ଦିନେ ମଦନେ ଦୁଃଖୀ ସଜନୀ ନାହିଁ ମୋ ସାହା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବରଷେ ରଜନୀ ଦିନ ସରସେ ଡାକଇ ଘନ",
          "ତର ସେ ମଦନ ହୀନ ବିରସେ ମୁଁ ହେଲି ଲୀନ",
          "ନିରତେ ଡାକଇ କେକୀ ପୁରତେ ତା ପୁଚ୍ଛ ଟେକି",
          "ତେଜିଲେ କେଉଁ ଦୋଷକୁ କାନ୍ତ ମଜ୍ଜିଲେ କେଉଁ ରମଣୀରେ ଆହା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କହରେ କି ପ୍ରତିକାର ଅହରେ ହେଲା ଅନ୍ଧାର",
          "ବହରେ ମୋ ଦୁଃଖଭାର ପ୍ରହାରେ କୁସୁମ ସର",
          "ଫୁଟିଲା କେତକୀ ନୀପ ତୁଟିଲା ମାନିନୀ ତାପ",
          "ଘୋଟିଲା ଆସିକି ପାପ ହଟିଲା ମଦନ ଯାହା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବହିଲା ଝାଞ୍ଜି ମରୁତ ଦହିଲା ବିଯୋଗୀ ଚିତ୍ତ",
          "ସହିଲା ଦେହ ଏମନ୍ତ ରହିଲା କାହିଁ ମୋ କାନ୍ତ",
          "ବରଷେ ହେଲା ବିଦେଶ କି ରସେ ହେଲି ମୁଁ ବଶ",
          "ପୁରୁଷୋତ୍ତମ ନରେଶ ସୁରସେ ଭଣିଲେ ଏହା"
        ]
      }
    ]
  },
  "sources": [
