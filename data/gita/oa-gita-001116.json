{
  "id": "oa-gita-001116",
  "name": {
    "en": "Majja majjaili na jai hajaili",
    "or": "ଜ୍ଜା ମଜ୍ଜାଇଲି ନ ଯାଇ ହଜାଇଲି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000043"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/majja-majjaili-na-jai-hajaili-gopalakrusna-basanta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଜ୍ଜା ମଜ୍ଜାଇଲି ନ ଯାଇ ହଜାଇଲି",
          "ଲଜ୍ଜାଳୁ ଜାଣୁମଣିକି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏ ମଧୁର ନିଶାରେ ବିରହ ଦଶାରେ",
          "ପ୍ରାଣ ଧରିବ କେହି ବାଣ ସ୍ମରର ସହୀ",
          "ତ୍ରାଣ ନ ଦିଶେ ତେଣିକି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତେଜି ନେତ୍ରୁ ବାରି ହେବନି ଧିକ୍କାରି",
          "କ୍ଷାମ ତ ଦିଶୁଥିବ ଯାମକ ଯୁଗ ହେବ",
          "ତାମରସ ଈକ୍ଷଣୀକି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅରଜିଲି ନିନ୍ଦା ବରଜିଲି ଫନ୍ଦା",
          "ଆଶୀବିଷ ପୋଷିଲି ନାଶି ସୁମନ ବଲ୍ଲୀ",
          "ଆସି ରହିଲି ଏଣିକି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନେ ମନେ ମୋତେ ଲୋଡ଼ୁଥିବ କେତେ",
          "ଆଉ ଦେଖିବି ମୁହିଁ ଦାଉ ମାରଇ ସହୀ",
          "ଆଉ ପ୍ରାତଃ ସ୍ମରଣୀକି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣର ବାଞ୍ଛା କରିବାର",
          "ସୁକୃତର ଫଳ କି ସତେ ଲଭ୍ୟ ହେବକି",
          "ଦେଖି ସୁଚାରୁ ବେଣୀକି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
