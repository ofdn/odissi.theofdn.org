{
  "id": "oa-gita-000850",
  "name": {
    "en": "Jana padila ma e kapata",
    "or": "ଣା ପଡ଼ିଲା ମା ଏ କପଟ ଗିର"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000079"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jana-padila-ma-e-kapata-jayanta-mukundadeba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଣା ପଡ଼ିଲା ମା ଏ କପଟ ଗିର",
          "ଅଣାଇ କପଟେ ହଟହଟା କରିବାର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆଖି ଆଖି ମେଳ କାଳେ ଗୋଟିଯାକ ମୋର",
          "ପିଠି କରି ଗଲେ ପୁଣି ଆଉ କେ କାହାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶଠ ପୁରୁଷଙ୍କର ମାନସ ଅଗୋଚର",
          "ନିକର ହେଲାଣି ଶ୍ୟାମ ଆନେ ରସିବାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଳି ନ ଥିଲି ମାନସ ବୋଲି ମୁଁ ତାଙ୍କର",
          "କଳିଲା ବେଳକୁ ସଖୀ ହେଲି ଏତେ ଦୂର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ମୁକୁନ୍ଦଦେବ କ୍ଷିତିପତି ଭାଷିବାର",
          "ସତୀ ମତି ଭୁଲା ଶ୍ୟାମ ପ୍ରୀତିକି ଜୁହାର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
