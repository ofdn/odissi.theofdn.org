{
  "id": "oa-gita-001124",
  "name": {
    "en": "Kete kala hela dekhi nahu sakhi",
    "or": "କେତେ କାଳ ହେଲା ଦେଖି ନାହୁଁ ସହୀ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000006"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kete-kala-hela-dekhi-nahu-sakhi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେତେ କାଳ ହେଲା ଦେଖି ନାହୁଁ ସହୀ",
          "ଶେଯ ଯାକ ତିନ୍ତିଗଲା ଲୁହ ବହି ବହି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତରଣୀ ପୂଜି ଗଲୁ ଏକ୍ଷଣି ତ ଅଇଲୁ",
          "ଅଣ୍ଟିଲା ନାହିଁକି କଣ୍ଠୀରବ ମଧ୍ୟା",
          "ହାର ପରି ହୃଦେ ଥିଲୁ ରହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆହା କି ଅସମ୍ଭବ କେ ଶୁଣିଲେ ହସିବ",
          "ବନୁ ଘେନୁ ପଛେ ବଂଶୀ ବଜାଇ ସେ",
          "ଗଲେ ବାଟ ଜଗିଥିଲୁ ତୁହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିଶି ଦିନ କଣ୍ଠରେ ବାଲି ବୁଲିବୁ କିରେ",
          "ଏ କି ଆଲୋକିତ ଆହା ପ୍ରାଣମିତ",
          "ତୋ ଲାଗି ତ ବୁଦ୍ଧି ଦିଶୁ ନାହିଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲଳିତା ପଣନ୍ତରେ ମୁଖ ପୋଛି ସତ୍ୱରେ",
          "ଗୋଳି କସ୍ତୁରୀ ଚିବୁକ କରେ ଧରି",
          "ଦେଲେ ବିଚିତ୍ର ମକରୀ ଲିହି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେ ପ୍ରତିମା ନେତ୍ରର ଏ ଜୀବନ ଜୀବର",
          "ପଲକ ଅନ୍ତର ଜଗତ ଅନ୍ଧାର",
          "ଦିଶୁଛି ଗୋପାଳକୃଷ୍ଣ କହି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
