{
  "id": "oa-gita-000253",
  "name": {
    "en": "Eni ikhyani radhe eniki",
    "or": "ଏଣୀଈକ୍ଷଣୀ ରାଧେ ଏଣିକି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/eni-ikhyani-radhe-eniki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏଣୀଈକ୍ଷଣୀ ରାଧେ ଏଣିକି ଆରେ",
          "ପଡ଼ିବ ଅବିର ରଜ ଶ୍ରୀମୁଖ ଲୁଆଁରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମନମଥ ସଜ ହୋଇଛନ୍ତି ଆଜ",
          "ଅନା ନୂଆ ନୀଳ ଜଳଧର ଝଳିଆରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଫୁଲଧନୁକର ପଛେ ସୁମଶର",
          "ଖୋସି ଚରମେ ଲୁଚାଇ ନବରଙ୍ଗିଆରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁରଲୀ ରଖି ସେ ତୁନ୍ଦ ବନ୍ଧ ବାସେ",
          "ଅନାଉଛନ୍ତି କଟାକ୍ଷ କରି କୁଣିଆ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଫଗୁ ମୁଠା କରୁ ଫିଟିଲା ରମ୍ଭୋରୁ",
          "ଉପର ଉପୁରାଣରେ ମଥା ଘୋଡ଼ିଆରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ସେ ସମୟରେ ଭାଷେ",
          "ଆସ ରାଧେ ଆସିଲେ ସେ କୁଞ୍ଜକୁଟିଆରେ"
        ]
      }
    ]
  },
  "sources": [
    {
