{
  "id": "oa-gita-001357",
  "name": {
    "en": "Bisnupadaku je labhe",
    "or": "ବିଷ୍ଣୁପଦକୁ ଯେ ଲଭେ"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000015"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bisnupadaku-je-labhe-purabi-gourahari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିଷ୍ଣୁପଦକୁ ଯେ ଲଭେ କି ଭାଗ୍ୟ ଲଭଇ",
          "ଅଜୀବ କାଗଜ ଚକି ଦେଖ ଦେଖ",
          "ସଜୀବ ହୋଇ ଗର୍ଜଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଶେଷ ସେ ପାଦପଦ୍ମର ମହିମା",
          "ଶେଷ ନ ପାରିବେ କହି",
          "ଅପଠ ସପଠ ସିଦ୍ଧି ଆଦରିଛି",
          "ଗୁଣବନ୍ତେ ଗର୍ବ ବହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେଉଁ ପଦ ସାହା ଲଭି ଯାଇ କାହା",
          "ଠାରେ ନ ରହଇ ଦୃଷ୍ଟି",
          "ଦେଖ ସାକ୍ଷାତରେ କେଡ଼େ ବଡ଼ ପ୍ରଭୁ",
          "ସୂର୍ଯ୍ୟଙ୍କୁ କରିଛି ପିଠି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଭୟ ଚରଣ ଶରଣଫଳକୁ",
          "ଶ୍ରବଣ କରି ସୁମନ",
          "ଆପଣା ପଦବୀ ଦତ୍ତ କରିଛନ୍ତି",
          "ଧ୍ୱଜ ଅର୍ଦ୍ଧଚନ୍ଦ୍ର ଚିହ୍ନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆନନ୍ଦେ ଯାଇ ଆଣିଲେ ଆସେ କଷ୍ଟେ",
          "ଅତି ଆକୁଳକୁ ବହି",
          "ଲଭିଲେ ସେ ପାଦ ଲୋଭ ନ ଛାଡ଼ଇ",
          "ଗଉରହରି କହଇ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bisnupadaku-je-labhe-purabi-gourahari/"
    }
  ],
