{
  "id": "oa-gita-000352",
  "name": {
    "en": "Eha ki mo bhale lihithila",
    "or": "ଏହା କି ମୋ ଭାଲେ ଲିହିଥିଲା"
  },
  "composer": "oa-person-000066",
  "mula_raga": [
    "oa-raga-000008"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/eha-ki-mo-bhale-lihithila-todi-kalyana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏହା କି ମୋ ଭାଲେ ଲିହିଥିଲା ଦାରୁଣ ବିହି",
          "ହେବାକୁ କାମେ ଦହି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିମିଷେ ହେଁ ଅନ୍ତର ନୋହି ପାଶେ ଚାକର",
          "ପରି ସେବିଥିବାର ରେ",
          "କୁଳିଶୁଁ ବଳି ଚିତ୍ତ ମୋ ଠାରେ ପ୍ରାଣନାଥ",
          "କରିବାର ଉଚିତ ହେଲା କିରେ ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିତି ନିଶିବ ଅସରେ ଶୟନେ ଆବାସରେ",
          "ଥିବା ପରି ପାଶରେ ଗୋ",
          "ଉରେ ଜମାଇବାକୁ କୋଳକୁ ଆଣିବାକୁ",
          "ଚାଟ କଲା ବେଳକୁ ଆଉ ନ ଦେଖେଁ ତାକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏ ବିରହ ବେଦନା ସହିବାକୁ ନବୀନା",
          "ଅଛି କେ ମୋହ ବିନା ରେ",
          "ସନ୍ତାପ ଅକୂପାର ନୀରେ ନିମଜ୍ଜିବାର",
          "ଜନ ହେବାକୁ ପାର ଥିଲେ କହ ବିଚାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋହନ ଅନାଥରେ କୃପା ହୃଦପଥରେ",
          "ନୋହିଲା କିମ୍ପା ଥରେ ଗୋ",
          "ଏ ରସେ ଦ୍ୱିଜ ପୀତାମ୍ବର ଭାଷେ ଲଳିତା",
          "ଏକାଳେ ଏତେ ଚିନ୍ତା ବିହିଲା ଗୋ ବିଧାତା"
        ]
      }
    ]
  },
  "sources": [
