{
  "id": "oa-gita-000527",
  "name": {
    "en": "Kaha sajani lo aau mu eniki",
    "or": "କହ ସଜନୀ ଲୋ ଆଉ ମୁଁ ଏଣିକି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000119"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-sajani-lo-aau-mu-eniki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ ସଜନୀ ଲୋ ଆଉ ମୁଁ ଏଣିକି",
          "ପାଶୋରିବି କିପରି ସେ ମୁରଲୀ ପାଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧୀର ଲଳିତ ତ୍ରିଭଙ୍ଗ ତା ଠିଆ ଠାଣିକି",
          "ଦେଖି କେ ନ ଭୁଲିବ ତା ବାଙ୍କ ଚାହାଣୀକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୃଦୁ ମୃଦୁ ହସା ଛଣା ପୀୟୂଷ ବାଣୀକି",
          "ଶୁଣିଲେ କେଉଁ ରମଣୀ ରଖିବ ଆଣିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଝୁମୁ ଝୁମୁ ତା ପାଦ ନୂପୁର ନିଶାଣିକି",
          "ପଥର ହେଲେ ତରଳ ନୋହିବ ପାଣିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ୟାମ ବିଚ୍ଛେଦରେ ହୃଦ ନ ହେବ ହାଣିକି",
          "ବୋଲେ ବନମାଳୀ ଏହା ନାହିଁ ମୁଁ ଜାଣିକି"
        ]
      }
    ]
  },
  "sources": [
