{
  "id": "oa-gita-000121",
  "name": {
    "en": "Aja e ki gumana re",
    "or": "ଆଜ ଏ କି ଗୁମାନ ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000056"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-e-ki-gumana-re-aaja-e-ki-gumaana-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ ଏ କି ଗୁମାନ ରେ ଚନ୍ଦ୍ରାନନା",
          "ଦେଖି ନାହିଁ ସ୍ୱପନରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁନ୍ଦର ରଦବାସ ମନ୍ଦାର ଦଳେ ହାସ",
          "-କୁନ୍ଦକୁ ପରକାଶ କୁନ୍ଦନାଙ୍ଗୀ ମୋ ଧନି",
          "(ପଡ଼ି)",
          "ତୁ ସିନା ମୋର ପ୍ରାଣ ରମଣୀଗଣ ରାଣ",
          "ରାଣ ଅଛିଟି ମାଣବକ ମୃଗାକ୍ଷୀ ଜାଣ",
          "ଦାରୁଣ ସ୍ମରରାଣ ଶାଣଦିଆ ତୀକ୍ଷଣ",
          "ବାଣ ଗଣରେ ନିଶ୍ଚେଁ ନେବଟି ଏ ପରାଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚାରୁ ଚମ୍ପକଦେହାରେ ଚନ୍ଦ୍ରାନନା",
          "କାହୁଁ ଶିଖିଲୁ ଏହାରେ",
          "ଅଶ୍ରୁ ପ୍ରସରିବାର ମହୀକି ଚିରିବାର",
          "ଆଜନ୍ମ ପରିଚାର ସଂସାର ସାରିବାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମର୍ମ୍ମ ଗଲାଟି ଫାଟିରେ ଚନ୍ଦ୍ରାନନା",
          "ମାର ମାର୍ଗଣ ଧାଟିରେ",
          "ବନ୍ଧୁଆ ସରିଲିଟି ତୋ କୀର୍ତ୍ତି ପରିପାଟୀ",
          "ରୋପିବାର ଲତାଟି ମୂଳୁଁ ନ ପକା କାଟି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୋଷ ଦେଖି ତୁ ଦଣ୍ଡରେ ଚନ୍ଦ୍ରାନନା",
          "ମଣ୍ଡନା କର ଗଣ୍ଡରେ",
          "ବାହୁପାଶେ ନିତାନ୍ତେ ବାନ୍ଧିବା ବସନାନ୍ତେ",
          "ଓଷ୍ଠ ବିଦାରି ଦନ୍ତେ ଭୁଷ କରଜ କୁନ୍ତେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆରମ୍ଭିଲେ ତୁ ରୁଷାରେ ଚନ୍ଦ୍ରାନନା",
          "ଭରସା କେ ମୋ ରସାରେ",
          "ତେଜିଲେ ତୁ ମୋ କୋଳ କେତେ ମୋ ଧୃତି ବଳ",
          "ସହେ କି କରବାଳ କେଳି କମଳଦଳ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶ୍ୟାମ ବିନୟ ଭାଷାରେ ଚନ୍ଦ୍ରାନନା",
          "ମନ୍ଦ ମଧୁର ହସା ରେ",
          "ଭାଷିଲେ ପ୍ରିୟବାଣୀ ରସେ ସେ ସୁଲକ୍ଷଣୀ",
          "ରସିଲେ ମନ ଜାଣି ଶ୍ରୀ ଛୋଟରାୟ ଭଣି"
        ]
      }
    ]
  },
  "sources": [
    {
