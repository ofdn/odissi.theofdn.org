{
  "id": "oa-gita-000221",
  "name": {
    "en": "Banchai sajani mote",
    "or": "ବଞ୍ଚାଇ ସଜନୀ ମୋତେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/banchai-sajani-mote/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜନେ ଜାଣିଲେନି ବୋଲି ତୁ ଏକା ନ ଜାଣୁ",
          "ବଞ୍ଚାଇ ସଜନୀ ମୋତେ ବଚନକୁ ଜିଣୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନବ ନୀରଦକୁ ଦେଖି ଆଖିର ପଲକ ରଖି",
          "ଏପରି ଛବି କେ ଅଛି ବୋଲି ଯାହା ଭଣୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଥରକୁ ଥର କାନନ ବାଟକୁ ଅନାଉ ଦିନ",
          "ଅଣ୍ଟୁନାହିଁ ଅପରାହ୍ନ କାଳ ନ ହେଉଣୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲୁଚିକରି ସକୂଟରେ ବଞ୍ଚି ରାତି ତା ପାଶରେ",
          "ଲେଉଟି ଯିବାର କାକ ପିକ ନ ଡାକୁଣୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରିକି ଏତେ ସାହାସ ନୂଆ କିଶୋର ବୟସ",
          "ଆଜକୁ ବାହାରି ନାହିଁ ଭୟରେ ପ୍ରାଙ୍ଗଣୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏ ବ୍ରଜେ ଦୋଷ ଦେବାକୁ ଅଛି କେ ଆଉ କାହାକୁ",
          "ଗୋପାଳକୃଷ୍ଣ ଭଣେ ତୁନି ହୋ କେହି ନ ଶୁଣୁ"
        ]
      }
    ]
  },
  "sources": [
