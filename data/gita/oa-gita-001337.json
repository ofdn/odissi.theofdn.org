    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧେ ରାଧେ ରାଧେ ବୋଲି ବାଜରେ ବଂଶୀ",
          "ବାଜରେ ବଂଶୀ ମୋହନ ବଂଶୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯମୁନା ପାଣି ଉଠୁ ଉଜାଣି",
          "ବହୁରେ ମୃଦୁ ମଳୟ ରାଶି",
          "ଶୁଖିଲା ତରୁ ପଲ୍ଲବ ଧରୁ",
          "ନାନା କୁସୁମେ ଯାଉ ବିକଶି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୋକିଳ ଗାନ ପଞ୍ଚମ ତାନ",
          "ସହିତେ ଗାଉ ଗାଉ ଉଲ୍ଲାସି",
          "ମତ୍ତ ଭ୍ରମର କରୁ ଝଙ୍କାର",
          "ଆସୁ ଶ୍ରୀ ରାଧା ହସି ହସି"
        ]
      }
    ]
  },
  "sources": [
