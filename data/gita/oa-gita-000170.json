  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sarasa-jetiki-re-mukhari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରସ ଯେତିକି ରେ",
          "ବନ୍ଧୁ ବିରସ ତେତିକି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନାଗରୀ ମୁକୁଟ ହୀରା ଉନ୍ମାଦ ପ୍ରେମ ପସରା",
          "ସୁରତ ରଙ୍ଗିଣୀ ଠାଣି ଉହୁଁ ଉହୁଁ ଇଷିବାଣୀ",
          "(ପଡ଼ି)",
          "ନାହିଁ ନାହିଁ ମହୀମଣ୍ଡଳେ ସହି ପରି",
          "ପରିଣତ ବିମ୍ବାଧରୀ ଧରାଶୀରି",
          "କରୀନ୍ଦ୍ରବରଗତି ସଙ୍ଗତି ଜଗତୀରେ",
          "ଗତି ମୋ ରତିପଣ୍ଡିତା ରମଣୀମଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆସେ ହୋଇ ରହରହ ହାସେ ମଣ୍ଡୁଥାଏ ଦେହ",
          "ମୁଖେ ବାସଶେଷ ଦେବା ପଛକୁ ଘୁଞ୍ଚିଆସିବା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
