  "id": "oa-gita-000170",
  "name": {
    "en": "Sarasa jetiki re",
    "or": "ସରସ ଯେତିକି ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
