  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/abani-bhusa-atanu-bane-kabisurjya-chokhi-amrapanchama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅବନୀଭୂଷା",
          "ଅତନୁ ବାଣେ ନ ଭୂଷା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖ ଏ ଶରଦ କାଳ",
          "ଘନା ଏ ସୋହାଗ ଜାଳ",
          "ଧ’ନା ଏ ଧୂତ ଧୁନି ରୁଷାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "(ପଡ଼ି)",
          "ଲୋକେ ଟେକି ରାଟପଣ",
          "ଲୋକେ ଦୁର୍ଲ୍ଲଭ ଯୌବନ",
          "ଢୋକେ ଦେଇ ନାଶ ତୃଷାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅମ୍ବର ଚନ୍ଦ୍ର ମଣ୍ଡଳ",
          "ଦମ୍ଭ କରେ ଦୃଷ୍ଟି ବଳ",
          "ଅଷ୍ଟଦୁର୍ଗର ଏ ଭାଷା ରେ"
        ]
      }
    ]
  },
  "sources": [
