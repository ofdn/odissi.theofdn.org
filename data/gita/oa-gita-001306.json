{
  "id": "oa-gita-001306",
  "name": {
    "en": "Malli mala syamaku debi",
    "or": "ମଲ୍ଲୀ ମାଳ ଶ୍ୟାମକୁ ଦେବି"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000055"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/malli-mala-syamaku-debi-bhanja-natanarayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଲ୍ଲୀ ମାଳ ଶ୍ୟାମକୁ ଦେବି ମନ ତୋଷିବି",
          "ଗ୍ରୀଷମ ହୋଇଲେ ବାସ ଚନ୍ଦନ ମୁଁ ଲେପିବି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତା ଅଙ୍ଗରୁ ସ୍ୱେଦ ବାରି  ଯେବେ ପଡ଼ୁଥିବ ଝରି",
          "ମୋ ଦୃଷ୍ଟି ପଡ଼ନ୍ତେ କାନି ପଣନ୍ତରେ ପୋଛିବି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତାଙ୍କୁ କରି ଗଳାହାର  ସେବିବି ତାଙ୍କ ପୟର",
          "ସେ ଯେବେ ହୋଇବେ ବର ହରପୂଜା କରିବି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେ ଯେବେ କରିବେ ମାନ  ଭାଙ୍ଗି ଭୁଞ୍ଜାଇବି ପାନ",
          "ଗଣ୍ଡେ ଦେଇଣ ଚୁମ୍ବନ ହରଷ କରାଇବି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ କହି  ରମଣୀରତନ ସେହି",
          "ତାହାଙ୍କ ଚରଣ ଧ୍ୟାୟି ଶରଣାଗତ ହେବି"
        ]
      }
    ]
  },
  "sources": [
