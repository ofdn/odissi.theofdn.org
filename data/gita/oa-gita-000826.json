{
  "id": "oa-gita-000826",
  "name": {
    "en": "Pheri thare ja chahinla",
    "or": "ଫେରି ଥରେ ଯା ଚାହିଁଲା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000041"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pheri-thare-ja-chahinla-lalita-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଫେରି ଥରେ ଯା ଚାହିଁଲା ନାହିଁ ସେ ତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗଭାଫୁଲ ସରି କରିଥିଲି ଯାରେ ତୋଳି ଧରି",
          "ସେ ପୁଣି ଢାଳିଲା ଆନେ ଚିତ୍ତ",
          "(ପଡ଼ି)",
          "ଘେନି ମୁଁ ଥିଲି ପରା ପରାଣ ଧନ କଳି",
          "ମାନି ନ ଥିଲି କାର ବାରଣ ହିତ ପାଳି",
          "କାନି ତ ଥିଲି ପାତି ଜାତି ମୁକୁତା ଭାଳି",
          "ଦରହସି ପାଶେ ବସି ଛୁରୀ ଘଷି",
          "ଦେଲା ସେ ମାରି ଛାତିକି",
          "ଘାରି ସାରିଲା ମତିକି",
          "ମରଣୁ ବଳିଲା ଏ ତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କବିଚନ୍ଦ୍ର ଅବିବେକୀ ନ ଜାଣି ଦେଲା ତେ ଟେକି",
          "ଅନ୍ଧ କରେ ସାଇତିଲା ବିତ୍ତ",
          "(ପଡ଼ି)",
          "ପିକ ବିଚାରିଥିଲି ଯାହାରେ ସେ ତ କାକ",
          "କାହୁଁ ପୂରିବ ଆଶ ଶୁଣି ତା କୁହୁ ଡାକ",
          "ଭରମେ ଭରମିଲି କାକରେ ମଣି ପିକ",
          "କରମେ ଲେଖା ମୂକ ହେବ କି ବାବଦୁକ",
          "ଶରମେ ସରିଗଲି ମାଗି ରଙ୍କୀରେ ଭିକ",
          "ମୁଖେ ଭରି ସୁଧା ସରି ମଧୁ ବାରି",
          "ଚାଳିଲା କମ କତୁରୀ",
          "ଭଲା ସେ ତାର ଚତୁରୀ",
          "ଛଳେ ତା ଗଲି ତ ହାରି",
          "କୁହୁକ ଜାଣଇ ସତ"
        ]
      }
    ]
  },
