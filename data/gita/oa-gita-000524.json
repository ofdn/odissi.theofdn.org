{
  "id": "oa-gita-000524",
  "name": {
    "en": "E juba kalare kanta chhadi na ja",
    "or": "ଏ ଯୁବା କାଳରେ କାନ୍ତ ଛାଡ଼ି ନ ଯା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000136"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-juba-kalare-kanta-chhadi-na-ja-matiari-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ ଯୁବା କାଳରେ କାନ୍ତ ଛାଡ଼ି ନ ଯା ଦୂର ଦେଶ",
          "ସହି କି ପାରିବି କ୍ଷଣେ ଦୁଃସହ ବିଚ୍ଛେଦ କ୍ଳେଶ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖ ବସନ୍ତ ଆଗତ ବହେ ଦକ୍ଷିଣା ମରୁତ",
          "ବନପ୍ରିୟ ପକ୍ଷୀ ରୁତ କଲେଣି ବୃକ୍ଷେ ବିଶେଷ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚନ୍ଦନ ରଜନୀକର ମୋ ପକ୍ଷରେ ହେବ ଗର",
          "ଜାଣି ଜାଣି ହାଣି ମୋତେ ସ୍ମରାନଳେ ନ ନିବେଶ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାଳି ଭାଳି ଅହରହ ବଳି ପଡ଼ିବ ବିରହ",
          "ଜହର ସମାନ ହେବ ଅଶନ ବସନ ବେଶ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ପିଣ୍ଡେ ପରାଣ ଧରି ରହିବି ମୁହିଁ କିପରି",
          "ତୁମ୍ଭ ଗୁଣ ଗୁଣି ଗୁଣି ଜୀବନ ହେବ ନିଃଶେଷ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୋଧି ବନମାଳୀ ଭଣେ ଦୁଃଖ କରୁ କି କାରଣେ",
          "ତୋ ପାଶେ ଭେଟିବ ଧନ ବରଷା ନୋହୁଁ ପ୍ରବେଶ"
        ]
      }
    ]
  },
  "sources": [
