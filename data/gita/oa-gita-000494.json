    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧନକୁ କେ ମାନେ ବଳାଇଲା ରେ",
          "କେ ଦେଲା ଏ ଦଣ୍ଡ ରୋଷ ଲୌହଦଣ୍ଡ",
          "ତା ମନ କୁନ୍ଦରେ ରସାଇଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋ ସୁଖ ମୃଦୁଳ ମାଳତୀର ମାଳ",
          "କା ପାଦ ପାଷାଣେ ଦଳାଇଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବୋଲେ କବିସୂର୍ଯ୍ୟ ଆହା ମୋ ଧଇର୍ଯ୍ୟ",
          "ତୁଳା ପଟଳକୁ ଜଳାଇଲା ରେ"
        ]
      }
    ]
  },
