{
  "id": "oa-gita-000260",
  "name": {
    "en": "Sangini re rasa rangini re",
    "or": "ସଙ୍ଗିନୀ ରେ ରାସରଙ୍ଗିନୀ ରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangini-re-rasa-rangini-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗିନୀ ରେ ରାସରଙ୍ଗିନୀ ରେ",
          "ଦୋଷ କ୍ଷମା କର ଜୀବବନ୍ଧୁ ରୁଷନା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯା କର ତୋ ପଦ ପଙ୍କଜ କିଙ୍କର",
          "ରଙ୍କରତନ ମୃଗାଙ୍କଲପନା ରେ",
          "ଶଙ୍କରଶତ୍ରୁ ନିଃଶଙ୍କରେ ଦହୁଛି",
          "ଅଙ୍କ ପର୍ଯ୍ୟଙ୍କ ମୋ ମଣ୍ଡୁ କିନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯୋଡ଼ି ପାଣି ଜଣାଉଛି ରାମାମଣି",
          "ଧରଣୀରେ ନଖଗାର ଲେଖନା ରେ",
          "କିଣିଲା ଜନ ମୁଁ ତୋର ଆଜନମୁଁ",
          "ତଳୁ ତୋଳ ଚାରୁ ବେଣୀ ଲୋଟାନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାନସରୁ ମାନ ସରୁ ସ୍ମର ଶରୁ",
          "ରଖ ନୂଆ ସରୁ ନୀଳବସନା ରେ",
          "ଜୀବଦା ପସରୁ ପୀୟୂଷ ହାସରୁ",
          "ଲବ ପ୍ରସରୁ ଖଞ୍ଜନ ନୟନା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋକୁଳ କୁଳଜା ପରିଷଦ ରାଜା",
          "ନ କଲେ କରୁଣା ମୁଁ ଜଣା ତୋ ନାଁରେ",
          "ରାଧେ ରାଧେ ବୋଲି ସୋରସୀ ସଲିଳରେ",
          "ଝାସିବାର ଶୁଣୁ ସିନା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅବନତ ହୋଇ ଧରୁ ପଦ ଦୁଇ",
          "ରାଧା ପ୍ରସନ୍ନତା କରି କଳନା ରେ",
          "ଗଲେ ନିଜ ନିଜ କୁଞ୍ଜେ ଆଳୀ ବ୍ରଜ",
          "ଗୋପାଳକୃଷ୍ଣ କରେ ଭାବନା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
