  "id": "oa-gita-000139",
  "name": {
    "en": "Chahan re nidhu bana keli kusalaku",
    "or": "ଚାହାଁରେ ନିଧୂବନ କେଳିକୁଶଳାକୁ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-re-nidhu-bana-keli-kusalaku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁରେ ନିଧୂବନ କେଳିକୁଶଳାକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୋମଳପାଦ ସରୋରୁହ ଯାବକ ଚିତ୍ରଶଳାକାଧରାକୁ",
          "ତୋ ମଧୁରାଧର ଲାଲ ଜବା ମକରନ୍ଦଝୁରା ଭ୍ରମରାକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିର୍ଜିତ ଶୋଣସରୋଜକରେ କରୁ ଯା ସଜଡ଼ା ବିଡ଼ିଆକୁ",
          "ହୀରକ କୈରବ କାଶ ସୁଧାକର ହାସ ବିଳାସିନୀ ତାକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚାରୁ ସୁନୀଳ ଚଳାଚଳ ଲୋଚନ ଦ୍ରୋଣ ନିଦେଶକରାକୁ",
          "ଚାମର ବାତଭରେ ରତି କୌତୁକ ସମ୍ଭବ ଖେଦହରାକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶୈଳ ସହୋଦର ପୀନ ପୟୋଧର ଚନ୍ଦନ ଭୋଗଦିଆକୁ",
          "ମଞ୍ଜୁଳିମାଚଳ କକ୍ଷତଳେ ନଖକେଳିକଳା ହଟିଆକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବାନ୍ଧବି ଯଦ୍ୟପି ମାନସରେ ଅଛି ଲେଶ କୃପା କରିବାକୁ",
          "ରାଜକଦମ୍ବ କିରୀଟ ଜଳନ୍ତରନାଥ ମହୀମଘବାକୁ"
        ]
      }
    ]
  },
  "sources": [
