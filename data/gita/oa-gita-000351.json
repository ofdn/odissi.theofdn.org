{
  "id": "oa-gita-000351",
  "name": {
    "en": "Aja chala tu kunjadhama go radhike",
    "or": "ଆଜ ଚଳ ତୁ କୁଞ୍ଜଧାମ ଗୋ ରାଧିକେ"
  },
  "composer": "oa-person-000038",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-chala-tu-kunjadhama-go-radhike/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ ଚଳ ତୁ କୁଞ୍ଜଧାମ ଗୋ ରାଧିକେ",
          "ସାଜ ତନୁକୁ ମାନ ବରଜି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବରଜପୁର ସୁନ୍ଦରୀ ବରଜ",
          "ବରସୁନ୍ଦର ବଦନ ନୀରଜ",
          "କୁନ୍ଦରୁଚିର ଦନ୍ତିନୀ ତବ",
          "କାନ୍ତରେ ଅତି ଶାନ୍ତ ସରଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜୀବଧନକୁ ଅନା ଥରେ ରେ ମୋହିନୀ",
          "ମାଧବ ଦୁଃଖ ମୁଁ କି କହିବି ତୁ ନ ଜାଣୁ ରେ ।",
          "ନବୀନ ଘନ ତମାଳ ଶ୍ୟାମ",
          "ଗାୟନ କରେ ବସି ତୋ ନାମ",
          "ବାମ ନୁହଁରେ ବାମନୟନୀ",
          "କାମ ପୂର୍ଣ୍ଣଦାୟିନୀ ସଖୀ ଆଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜାଣୁ ରତନ ସୁତନୁ ଜାଣୁ ରେ ମୋହିନୀ",
          "ମୋହନ ଦୁଃଖ ମୁଁ କି କହିବି ତୁ ନ ଜାଣୁ ରେ ।",
          "ପାର୍ବତୀବର ପର ପ୍ରତାପ",
          "ତର୍ଜଇ ଧରି କୁସୁମ ଚାପ",
          "ଖର୍ବ ଖର୍ବ ମାରଇ ଶର",
          "ତାର ହରି କି ମାରେ ଅତନୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆନ ନ ଘେନି ମାନ ମୋ ଗିର ରେ ସୁନ୍ଦରୀ",
          "ଇଙ୍ଗିତ ନୁହେଁ କହୁଛି ନିକର ଗୋ ।",
          "ମନ୍ଦ ମଧୁର ମୁରଲୀ ତାନ",
          "ଅଶନ ବସନ ବିଷ ସମାନ",
          "ଭାବି ନିରତେ ତୋହରି ନାମ",
          "ରଙ୍ଗରେ ତୋଷ ନାଗରବର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶୁଣି ସଖୀର ଏସନ ଗିର ସେ ଶ୍ରୀମତୀ",
          "ତେଜି ବିରସ ହୋଇ ସୁବେଶ ସେ ।",
          "ଚପଳଗାମିନୀ ଅତି ତରଙ୍ଗ",
          "ସତ୍ୱରେ ମିଳେ ମୋହନ ସଙ୍ଗ",
          "କୁଞ୍ଜେ କି ଆଜି ଏ ମତ୍ତଭୃଙ୍ଗ",
          "ପଦ୍ମନାଭ ଏ ରସେ ବଦତି"
        ]
      }
    ]
  },
  "sources": [
