{
  "id": "oa-gita-000609",
  "name": {
    "en": "Bihi mo bhale eha lekhithila ki",
    "or": "ବିହି ମୋ ଭାଲେ ଏହା ଲେଖିଥିଲା କି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000157"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bihi-mo-bhale-eha-lekhithila-ki-meghaparni-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିହି ମୋ ଭାଲେ ଏହା ଲେଖିଥିଲା କି",
          "ବନ୍ଧୁ ବିଚ୍ଛେଦେ ଘନ ଦିନ ଯିବ କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଜୁଳି ଘନ ଦେଖି ବିକଳେ ବାରିଜାକ୍ଷି",
          "ବସି ନୟନୁ ନୀର ଢାଳୁଥିବ କି ।",
          "ବାର ଯେ ବାର ଖର ନିଃଶ୍ୱାସ ତରତର",
          "ବହି ଶ୍ରୀଅଙ୍ଗ ଶିରୀ କ୍ଷୀଣ ହେବଣି କି ।",
          "(ପଡ଼ି)",
          "ବିଧାତା କଲା ଏହା ବ୍ୟଥା ମୁଁ ଆଉ କାହା",
          "ବଳେ ଅରଜି ଯାଇ କରିବି କି",
          "ବିଚାରିବାର ବାର ବୋଲେ କବିମିହିର",
          "ବିରହାନଳେ ଜଳି ଜୀବ ଯିବ କି"
        ]
      }
    ]
  },
