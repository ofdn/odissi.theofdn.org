{
  "id": "oa-gita-000133",
  "name": {
    "en": "Kunja nilaya bhusa re",
    "or": "କୁଞ୍ଜନିଳୟଭୂଷା ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunja-nilaya-bhusa-re-kunjanilaya-bhusa-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁଞ୍ଜନିଳୟଭୂଷା ରେ",
          "ଅଞ୍ଜନପୁଞ୍ଜ ମସାରଘନକେଶା",
          "କଞ୍ଜଚନ୍ଦ୍ରମଦଗଞ୍ଜନାସ୍ୟରୁଚି",
          "କୁଞ୍ଜରଗତି ମନୋରଞ୍ଜନବେଶା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆସ ମୋ କୋଳରେ ବିରାଜ",
          "ଦାସର ସରିକି କରି କି ଲାଜ",
          "ବାସକୁ ପରିକର ଆଜ",
          "ନାଶ ଦୁଃଖସମାଜ",
          "ଧନ ମୋତେ ବାସବାଦି ପରିହାସ ଚତୁର କର",
          "ବରବରନା ବରନାଗରୀରାଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁନ୍ଦସୁନ୍ଦର ଦଶନାଳି",
          "ସୁନ୍ଦରୀମଣି ତୁ ମୋର ସଙ୍ଖାଳି",
          "ଚନ୍ଦନ ସଉରଭପାଳୀ",
          "କୁନ୍ଦନମୟମାଳି",
          "ବୃଷରବିନନ୍ଦିନୀନ୍ଦ୍ରମଣି ମଞ୍ଜୁଭୁଜଗଭୂରୁ",
          "ଚଳନୟନାଞ୍ଚଳ ଦେ ଥରେ ଢାଳି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାର ରଖିଛି ଶର ଶାଣି",
          "ତାର ତ ଚରିତ ଅଛୁ ପରା ଜାଣି",
          "ସାରକୁ ଘେନିଯିବ ଛାଣି",
          "କା’ର ସେ ରଖେ ଠାଣି",
          "ମୋର ହୃଦୟ ତାର ହାର ହୁଅ ଆରେ ସୁଗୁଣବତୀ",
          "ରତିଚତୁରା ନବପଲ୍ଲବପାଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାଞ୍ଚନଗଉରୀ ବିଚାର",
          "ବଞ୍ଚନ ବିଧିକି ବିରଚିବାର",
          "ମୁଞ୍ଚ ଧନ ମୁଁ ପରିଚାର",
          "ମଞ୍ଚରେ ତ ତୁ ସାର",
          "ଅବିରତ ପଞ୍ଚବାଣ ରଣକୌଶଳ ପରିଚୟ",
          "କର ସୁରସାବର ସାର୍ଥରେ ମୋର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏପରି ନବଘନ ଶ୍ୟାମ",
          "ଚାଟୁ ବିରଚି ଲଭୁଁ ବିରାମ",
          "ସସ୍ମିତ ତରୁଣୀଲଲାମ",
          "ପୂରିଲେ ହରିକାମ",
          "ନୃପ ଜଗଦ୍ଦେବ ସେ ସମୟ ବେଶ ଲଳିତ",
          "-ପଦଯୁଗ ଯୁଗଳ ଜଳଜାବଳୀ ଦାମ"
        ]
      }
    ]
  },
  "sources": [
    {
