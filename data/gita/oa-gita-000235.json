{
  "id": "oa-gita-000235",
  "name": {
    "en": "Syama mo galara mali go",
    "or": "ଶ୍ୟାମ ମୋ ଗଳାର ମାଳି ଗୋ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-mo-galara-mali-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ମୋ ଗଳାର ମାଳି ଗୋ",
          "ଶ୍ୟାମ ଲାଗି ମୁଁ ପାଗଳି",
          "ଶ୍ୟାମ ସୁମନରେ ଅତି ଯତନରେ",
          "ଭରିବି ପୂଜାର ଥାଳି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୟାମଳ ବସନ କରି ପରିଧାନ",
          "ତୋଳି ଶ୍ୟାମ ଫୁଲକଳି",
          "ଶ୍ୟାମ ଚୂଳେ ଦେବି ଶ୍ୟାମକୁ ପୂଜିବି",
          "ଶ୍ୟାମ କୁଞ୍ଜେ ଖେଳି ଦୋଳି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ୟାମଳ କଙ୍କଣ କରେ ଆଭରଣ",
          "କରି ହୋଇବି ଛଇଳି",
          "ଶ୍ୟାମ ବଂଶୀସ୍ୱନ ଶ୍ରବଣେ ଶୁଣିଣ",
          "ନାଚୁଥିବି ଢଳି ଢଳି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ୟାମ ନାମ ଶ୍ରୁତିତଟେ ଶୁଣି ମତି",
          "ଉଠିଥିବ ଫୁଲି ଫୁଲି",
          "ଶ୍ୟାମ ଗୁଣ ଗାଇ ତନୁ ଚମକାଇ",
          "ଚାଲୁଥିବି ଝୁଲି ଝୁଲି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ୟାମବନ୍ଧୁ ମୋର ଚିର ଆପଣାର",
          "ମୁଁ ତାଙ୍କର ରସକଲି",
          "ଗୋପାଳକୃଷ୍ଣର ଜୀବ ସେ ଶ୍ୟାମର",
          "ଶ୍ରୀଚରଣେ ବନ୍ଧା ଦେଲି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-mo-galara-mali-go/"
    }
  ],
