  "name": {
    "en": "Atasi kusuma sama syama he",
    "or": "ଅତସୀ କୁସୁମ ସମ ଶ୍ୟାମ ହେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000046"
