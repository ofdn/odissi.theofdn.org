{
  "id": "oa-gita-000432",
  "name": {
    "en": "Mora ki dosa hela re chhaila",
    "or": "ମୋର କି ଦୋଷ ହେଲା ରେ ଛଇଳା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000045"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mora-ki-dosa-hela-re-chhaila-arabhi-jati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋର କି ଦୋଷ ହେଲା ରେ ଛଇଳା",
          "ସରସ ହୃଦୟରେ ଦୟା ଯା ନ ବସିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଦୋଷେ ମାନ ଉଚିତ ନୋହିଲା",
          "ଶରମେ ଲଭିବା ପ୍ରୀତି ନାଶ ହେଲା ।",
          "(ପଡ଼ି)",
          "ତାର ଧନ ପରିଚାର ଜନକୁ",
          "ସାର କରି ତୁ ବିଚାର ମନକୁ",
          "ଗାର କରି ସଖୀ ପର ବଚନକୁ",
          "ପରବ ଚନ୍ଦ୍ରମୁଖୀ ଆଜ ଏ କି ହେଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୁହି ଥାଉ ମାର ଦଣ୍ଡ ବିହିଲା",
          "ସ୍ନେହକୁ ଏ ଦଶା କେମନ୍ତ ରୁଚିଲା ।",
          "(ପଡ଼ି)",
          "ତେଜ ଏ ଅଭିମାନରେ",
          "ମାନ ରେ ମୋ ଆନରେ",
          "କର କଞ୍ଜମୁଖୀ ଅବଧାନ ରେ",
          "ଦିନେ ନ ଥିବା ରୁଷା ଆଜ କେ ଶିଖାଇଲା"
        ]
      }
    ]
  },
