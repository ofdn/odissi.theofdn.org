{
  "id": "oa-gita-001127",
  "name": {
    "en": "Dhira samire basi dakuchi to naa re",
    "or": "ଧୀର ସମୀରେ ବସି ଡାକୁଛି ତୋ ନାଁ ରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhira-samire-basi-dakuchi-to-naa-re-bhairabi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧୀର ସମୀରେ ବସି ଡାକୁଛି ତୋ ନାଁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରାଣେଶ୍ୱରୀ ରାଧିକେ ଶ୍ରୀମତୀ ଗାନ୍ଧର୍ବିକେ",
          "ବୋଲୁ ହଜିଯାଉଛି ତୋ ଚେତନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବନେ ପ୍ରତି ବଲ୍ଲୀକି ଧେନୁ ପଶୁ ପକ୍ଷୀକି",
          "ତୋ ଅଭିଧାନରେ କରି କଳ୍ପନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋଳି କୁସୁମ ବାଳା ତୋ ବେଶ ପାଇଁ ମାଳା",
          "ଗୁନ୍ଥି ସେ ରଖୁଛି ଚନ୍ଦ୍ରବଦନା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଧ୍ୟାନ କରୁ ତୋ ରୂପ ବହେ ଲୁହ ଅମାପ",
          "ଦ୍ୱିଗୁଣେ ବୃଦ୍ଧି ହେଲାନି ଯମୁନା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତୋ ଦୋଷ ବୁଝାମଣା କରି ଛାମୁକୁ ଅଣା",
          "ଦଣ୍ଡ ଦିଅ ପଛକେ ତୁ ରୁଷନା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ବୋଲେ ସେହି ସଜେ ଚଳିଲେ",
          "ପଥେ ସହୀ କହେ ଶୁଣ ସୁମନା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
