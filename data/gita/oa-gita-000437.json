{
  "id": "oa-gita-000437",
  "name": {
    "en": "Naba nabina re nisi sare ana",
    "or": "ନବ ନବୀନା ରେ ନିଶି ସରେ ଅନା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/naba-nabina-re-nisi-sare-ana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବ ନବୀନା ରେ ନିଶି ସରେ ଅନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେଶର କୁଞ୍ଜେ ମଧୁପ ଗୁଞ୍ଜେ",
          "ଉଷା ନାଗରୀ ଶ୍ରୀମୁଖ ରଞ୍ଜେ ।",
          "(ପଡ଼ି)",
          "ହୋଇ ବିବେକବତୀ ଚାହିଁ ରହିଲୁ କ୍ଷିତି",
          "କାହିଁ ଥିଲା ଏ ରୀତି ବାଇ ହେଲାକି ମତି",
          "ଲପନ ଟେକରେ ଧନ ମୋହନ ସରେ ତୋ ବିନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାହିଁକି ଗୋରୀ ଏ ତୋର ରୁଷା",
          "ବରଜ ସାରା ଭଗାରିହସା ।",
          "(ପଡ଼ି)",
          "ହେରି ନବ ଅରୁଣ ଶିରୀ ହାରି ନଳିନ",
          "ଭରି ନୟନେ ବନ ଘାରି ନେଲା ସମାନ",
          "ବରଜ କିଶୋରୀ ପରେ ଝୁରିହେବା ସାର ସିନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ୟାମରେ ବିମନା ନ ହୁଅ ସୁମନା",
          "ନୀଳମଣି ହାର କରରେ ଶୋଭନା ।",
          "(ପଡ଼ି)",
          "ସୁନା ବରନା ମାନ ଘେନା କର ମୋ ଆନ",
          "ଚୂନା ନ କର ମନ କହ୍ନା ନୁହଇ ଆନ",
          "ଅଣାଅ କୁଞ୍ଜ ତଳପେ କବିଶଶୀ କରେ ଜଣା"
        ]
      }
    ]
  },
  "sources": [
