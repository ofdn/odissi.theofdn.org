{
  "id": "oa-gita-000120",
  "name": {
    "en": "Kahi mahata sina sariba go",
    "or": "କହି ମହତ ସିନା ସାରିବ ଗୋ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000055"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahi-mahata-sina-sariba-natanarayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଉ କି ସହୀ ସହି କରିବ ଗୋ",
          "କହି ମହତ ସିନା ସରିବ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୟାମ ଗୁଣ ପରଖି ଚିତ୍ତ ଭିତରେ ସଖି",
          "ରଖିଲାଣି କିପରି ଭାରିବ ଗୋ",
          "ଭରିଗଲାଣି କ୍ଷୀରଭାଣ୍ଡରେ ଯେବେ ଖାର",
          "ଛାଣି କେ ସ୍ୱାଦୁ ବାରିପାରିବ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବୁଝିଲାଣି ମରଜି ଆଉ କି ହୋଇ ରାଜି",
          "ନିକୁଞ୍ଜେ ତୋ ସଙ୍ଗେ ବିହରିବ ଗୋ",
          "ସୁଧାରେ ବିଷ ଦେଇ ଯତ୍ନେ ଛାଣିଲେ ନେଇ",
          "ତହୁଁ କି ମଧୁ ଆଉ ଝରିବ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଲାଣି ସ୍ନେହ ଭାଙ୍ଗି ତୋ ଠାରୁ ସେ ଶୁଭାଙ୍ଗୀ",
          "ଆଉ କି ତୋ ବୋଲ ସେ କରିବ ଗୋ",
          "ଛେଦି ପାଦପ ମୂଳ ସିଞ୍ଚିଲେ ନେଇ ଜଳ",
          "ସେ କି ନବପଲ୍ଲବ ଧରିବ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗ ଅବନୀପତି ଭାଷେ ସଜନୀ",
          "ଆଉ କି ତୋ ଦୁଃଖ ସେ ହରିବ ଗୋ",
          "ପରଖ ଦେବା ଲାଞ୍ଚ କଲାଣି ଯେବେ ପାଞ୍ଚ",
          "ପଞ୍ଚବାଣକୁ ସେ କି ଡରିବ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
