{
  "id": "oa-gita-001025",
  "name": {
    "en": "Aja baraja jubaraja ki kale",
    "or": "ଆଜ ବରଜ ଯୁବରାଜ କି କଲେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000182"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-baraja-jubaraja-ki-kale-marua-maaruaa-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଆଜ ବରଜ ଯୁବରାଜ କି କଲେ ମତେ",
          "ମୋ ଜୀବସଖୀ ଚାହାଁରେ",
          "ହାଜର ହେବ ବୋଲି ଓଜରେ ଜଗିଥିଲି",
          "ତେଜ ହାନି ହୋଇ ଲାଜରେ ମୁଁ ସଢ଼ିଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସାଜିଥିଲି ଶେଯ ରାଜୀବମୁଖ ମନ",
          "ରାଜିକି ସୁସ୍ନେହରେ ଗୋ",
          "ତେଜିବାରୁ ସେ ମତେ ହେଜି କାମ ନିରତେ",
          "ରାଜି ରାଜି ବିଶିଖ ଚଜି ମାରେ ଦେହରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରାସରସିକ ମୃଦୁଭାଷକୁ ଶୁଣି ପ୍ରତି",
          "ଆଶ ମୋ ବଳିଥିଲା ଗୋ",
          "ତୋଷରେ ମୁଁ ନିକୁଞ୍ଜ ବାସରେ ବସିଥିଲି",
          "ବାସ ସୁମନ ଭୂଷା ବେଶ ବିଫଳ ହେଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜାଳି ଆଜ ପ୍ରଦୀପ ବନମାଳୀ କଳାପ",
          "ଭାଳିଥିଲି ମତିରେ ଗୋ",
          "ଆଳି ଗୁନ୍ଥାକୁସୁମ ଥାଳି ମୁଁ ରଖିଥିଲି",
          "ଜାଳିଦେଇ ସଖୀ କାମକୁ କାଳି ଦେଲେ ପ୍ରୀତିରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାସରଙ୍ଗିନୀ ନିରାଶ ଭାଷ ଏପରି",
          "ଭାଷନ୍ତେ ସହୀକି ଚାହିଁ",
          "ଭାଷଇ ରଘୁନାଥ ରୋଷ ନ କର ଚିତ୍ତ",
          "କେଶବଙ୍କୁ ଆଣିବି ପାଶକୁ ଦୁଃଖ କହି"
        ]
      }
    ]
  },
