{
  "id": "oa-gita-000500",
  "name": {
    "en": "Jana galani chali chahani",
    "or": "ଜଣା ଗଲାଣି ଚାଲି ଚାହାଣୀ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000009"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jana-galani-chali-chahani-kedara-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଣା ଗଲାଣି ଚାଲି ଚାହାଣୀ",
          "କିଶୋରୀ ମଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲଳନାବର ଥରକୁ ଥର",
          "ଯମୁନାରୁ ନୀର ଅଣା ଲାଗିଲାନି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରଜେନ୍ଦ୍ର ସୁତ ନୟନ କୁନ୍ତ",
          "ଘାତ ବିବେକ ବୁଦ୍ଧି ବଣା କଲାନି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ଭାବନାରେ ଶ୍ୟାମ ପଦରେ",
          "ମଦନ ରଜା ନିଉଁଛଣା ହେଲାନି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପ୍ରାଣ ମିତଣୀ ବିନୟ ବାଣୀ",
          "ଆଡ଼ ଉହାଡ଼ରେ ରହି ଶୁଣାଗଲାନି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆସୁ ଜରତୀ ଚାହୁଁ ଝଟତି",
          "ଗୋପାଳକୃଷ୍ଣ ବୋଲଇ ହୁଏ ତୁନି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
