{
  "id": "oa-gita-000056",
  "name": {
    "en": "Barana gamana bare syame ana",
    "or": "ବାରଣଗମନା ବାରେ ଶ୍ୟାମେ ଅନା"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000030"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/baranagamana-bare-syame-ana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାରଣ ଗମନା ବାରେ ଶ୍ୟାମେ ଅନା",
          "ଭାରି ଅଧୀର ତୋ ବିନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭୋଗିଲେ ନାନା ଭୀଷଣ ବେଦନା",
          "ତୋ ଲାଗି କେବଳ ସିନାରେ",
          "ବୀଣା ନାଦ ଜିଣା ଭାରତୀକି ଶୁଣା",
          "ସେ ପରା ତୋହରି କିଣାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଣା ହରିଣାକ୍ଷି ହୁଅନାରେ ବଣା",
          "କରନା କରୁଣା ଊଣାରେ",
          "ମୋହନ ସୁନ୍ଦର ବିରହେ ତୋହର",
          "ହରାଇଲେଣି ଚେତନାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ବିହୀନେ ସହି ସାହା କେହି ନାହିଁ",
          "ଦିଅନା ଆଉ ଯାତନାରେ",
          "ଭାଷଇ ତାରିଣୀ ତୋଷ ନୀଳମଣି",
          "ହୋଇ ଏଣିକି ସୁମନାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
