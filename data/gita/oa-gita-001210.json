{
  "id": "oa-gita-001210",
  "name": {
    "en": "Ede bhagya mora heba ki",
    "or": "ଏଡ଼େ ଭାଗ୍ୟ ମୋର ହେବକି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ede-bhagya-mora-heba-ki-kalyana-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏଡ଼େ ଭାଗ୍ୟ ମୋର ହେବକି",
          "ହେବି ବୃନ୍ଦାବନେଶ୍ୱରୀ ସେବକୀ",
          "ଶ୍ରୀ ଗୁରୁଦତ୍ତ ବୀଜମନ୍ତ୍ର କଳପ",
          "ବଲ୍ଲୀରେ ପ୍ରେମ ଫଳ ଫଳିବ କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀ ସ୍ୱାମିନୀଙ୍କର ଯାବତ",
          "ଅଷ୍ଟକାଳ ସେବା ସନ୍ତତ",
          "ଶ୍ରୀ ରୂପମଞ୍ଜରୀ ଆଜ୍ଞା ଶିରେ ଧରି",
          "କରିବି ମନୋରଥ ପୂରିବ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରଜରାଜ କୁଳ ଚନ୍ଦ୍ରମା",
          "ଦୋଷ କରିବା ପାଇଁ କ୍ଷମା",
          "ଲଳିତାଙ୍କ ପଦାବ୍ଜେ ପଡ଼ି ଜଣାଇବା",
          "ଶୁଭ ଦଶା ସମ୍ଭବିବ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋଷ୍ଠେଶ୍ୱରୀ କୋଳରେ ମରି",
          "ବଧୂ ସୁଖେ ଲାଳନା କରି",
          "ସ୍ନେହେ ଅଶ୍ରୁ ପୋଛୁ ସ୍ୱେଶ୍ୱରୀଙ୍କ ଲଜ୍ଜା",
          "ନମ୍ରମୁଖ ବିହି ଦେଖାଇବ କି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାସ ରସାମୃତାବ୍ଧି ବିଧୁ",
          "ଅଙ୍କରେ ଜଟିଳାଙ୍କ ବଧୂ",
          "ବିଜେ କରିବାର ଦେଖି ମୋ ଆଖିର",
          "ସୁଖ ଅକୂପାର ଉଚ୍ଛୁଳିବ କି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ହୃଦେ ଧରି ସେ ଦୁଇ ରୂପ",
          "ଶ୍ରୀ ମଞ୍ଜରୀ ସଖୀ କଳାପ",
          "ବୋଲେ ଗୋପାଳକୃଷ୍ଣ ମୁଖେ ଶ୍ରୀ ରାଧାକୃଷ୍ଣ",
          "ବୋଲି ଜୀବ ବରଜିବ କି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
