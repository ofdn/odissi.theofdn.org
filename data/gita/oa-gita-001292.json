  "kabya": {
    "id": "oa-kabya-000002",
    "section": {
      "en": "Kha Patala",
      "or": "ଖ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/khanjana-ganjanakhi-aha-kabisurjya-premodaya-champu-basanta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଖଞ୍ଜନ ଗଞ୍ଜନାକ୍ଷି ଆହା ରେ ପ୍ରାଣସଖୀ",
          "ନ ଘେନିଲୁ ତ ମୋ ବାଣୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖମଣିସୁତା ତଟ ବିଟ ସେ ନନ୍ଦଚାଟ",
          "ବୋଲି ନ ଥୁଲୁ ଏହା ଜାଣି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଖୁରିକେ ସେ କିଶୋରବର ତରଳତର",
          "ଭ୍ରୂଭଙ୍ଗୀ ଦିଏ ଦନ୍ତ ହାଣି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖଣ୍ଡିବ ସତୀ ବ୍ରତ ବୋଲି ତାର ନେତ୍ରାନ୍ତ",
          "ଶରକୁ ରଖିଛି ସେ ଶାଣି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଖଟି ହରିଚନ୍ଦନ କହେ ନ ଜାଣୁ ଧନ",
          "ବୋଲି ମୋହନ ବଂଶୀପାଣି ରେ"
        ]
      }
    ]
  },
