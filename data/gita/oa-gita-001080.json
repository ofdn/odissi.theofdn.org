{
  "id": "oa-gita-001080",
  "name": {
    "en": "Dekha dekha padma mukha",
    "or": "ଦେଖ ଦେଖ ପଦ୍ମମୁଖ ମହାମେରୁ"
  },
  "composer": "oa-person-000075",
  "mula_raga": [
    "oa-raga-000183"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-dekha-padma-mukha-mahameru-raga-malasri-somanatha-singha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖ ଦେଖ ପଦ୍ମମୁଖ ମହାମେରୁ",
          "କ୍ଷୟ ହୁଏ କୋଟି ଜନ୍ମର ଦୁଃଖ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିର ଶୋଭାବନ ସେବତୀ ପୁଷ୍ପ",
          "ଶ୍ରୀରଙ୍ଗା ଅଧରେ ଲାବଣ୍ୟ ହସ",
          "କରୁଛନ୍ତି ପ୍ରଭୁ ଜଗତେ ବାସ",
          "ଚକାନୟନେ ମୋହନ୍ତି ଦଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଠେକ ନାସାକୁ ଶୋଭଇ ବସଣୀ",
          "କର୍ଣ୍ଣେ କୁଣ୍ଡଳ କଣ୍ଠେ ନାନା ମଣି",
          "ହୃଦେ କଉସ୍ତୁଭ ବିରାଜେ ପୁଣି",
          "ତେଜ ବିକାଶ ଦିନମଣି ଘେନି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କପାଳେ ଜମ୍ବୁନଦ ଠିଆ ଚିତା",
          "ତଥି ପରେ ଅଛି ଗଜ ମୁକୁତା",
          "ଭୁଜ ଟେକିଛନ୍ତି ଜଗତଜିତା",
          "ଭକତବାନ୍ଧବ ତ୍ରୈଲୋକ୍ୟପିତା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସିଂହ କଟୀରେ ଶୋଭେ ପୀତାମ୍ବର",
          "ତହିଁ ଭିଡ଼ିଛନ୍ତି କିଙ୍କିଣୀ ସାର",
          "ରତ୍ନ ସିଂହାସନ ଚକା ଉପର",
          "ବିଜେ କରିଛନ୍ତି ନୀଳ କନ୍ଦର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯାହାନ୍ତି ନ ପାନ୍ତି ଚଉଦ ପୁରେ",
          "କି ଉପମା ଦେବା ସେ ପ୍ରଭୁଠାରେ",
          "କରୁଣା କିଞ୍ଚିତ ହେଉ ମୋ ଠାରେ",
          "ସୋମନାଥ ସିଂହ ରାଜା ବିଚାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
