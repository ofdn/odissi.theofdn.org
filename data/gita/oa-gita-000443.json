    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଫେରିଯା ରେ ଯା ଶ୍ୟାମ",
          "ଫେରିଯା ରେ ଯା ଯା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କିଶୋରୀ ହେମଗୋରୀ",
          "ମରୁ ପଛେ ସେ ଝୁରି",
          "ତୋ ପଥ ଅନୁସରି",
          "ତୁ ଶଠ ରାଜା ଯା ଯା ଯା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାହିଁ ତୋ ପୀତପଟ",
          "ସତ କହ କପଟ",
          "କଲା କି କେ ଆକଟ",
          "ତୋ ରୂପ ସଜା ଯା ଯା ଯା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଣିଦେବି ମୁକୁର",
          "ଦେଖ ଦେଖ ମୁକର",
          "ଶିରେ ସିନ୍ଦୂର ଗାର",
          "ନାହିଁ କି ଲଜ୍ଜା ଯା ଯା ଯା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିଶଶୀ ବଦତି",
          "କାହ୍ନୁ ଏ କି ତୋ ରୀତି",
          "ବିରହରେ ଶ୍ରୀମତୀ",
          "ଭୋଗୁଛି ସଜା ଯା ଯା ଯା"
        ]
      }
    ]
  },
