{
  "id": "oa-gita-001455",
  "name": {
    "en": "Birachita chatu bachana rachanam",
    "or": "ବିରଚିତ ଚାଟୁବଚନ ରଚନମ୍"
  },
  "composer": "oa-person-000161",
  "mula_raga": [
    "oa-raga-000043"
  ],
  "kabya": {
    "id": "oa-kabya-000010"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/birachita-chatu-bachana-rachanam-virachita-chatu-vachana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିରଚିତ-ଚାଟୁ-ବଚନ-ରଚନଂ",
          "ଚରଣେ ରଚିତ-ପ୍ରଣିପାତମ୍",
          "ସମ୍ପ୍ରତି ମଞ୍ଜୁଳ-ବଞ୍ଜୁଳ-ସୀମନି",
          "କେଳି-ଶୟନମନୁଯାତମ୍ ।",
          "ମୁଗ୍ଧେ ମଧୁମଥନମ୍",
          "ଅନୁଗତମ୍ ଅନୁସର ରାଧିକେ ।୧"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘନ-ଜଘନ-ସ୍ତନ-ଭାର-ଭରେ ଦର-",
          "ମନ୍ଥର-ଚରଣ-ବିହାରମ୍",
          "ମୁଖରିତ-ମଣି-ମଞ୍ଜୀରମୁପେହି",
          "ବିଧେହି ମରାଳ-ନିକାରମ୍"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୃଣୁ ରମଣୀୟତରଂ ତରୁଣୀ-ଜନ",
          "-ମୋହନ-ମଧୁରିପୁ-ରାବମ୍",
          "କୁସୁମ-ଶରାସନ-ଶାସନ-ବନ୍ଦିନି",
          "ପିକ-ନିକରେ ଭଜ ଭାବମ୍"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅନିଳ-ତରଳ-କିଶଳୟ-ନିକରେଣ",
          "କରେଣ ଲତାନିକୁରମ୍ବମ୍",
          "ପ୍ରେରଣମିବ କରଭୋରୁ କରୋତେ",
          "ଗତିଂ ପ୍ରତିମୁଞ୍ଚ ବିଳମ୍ବମ୍"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସ୍ଫୁରିତମ୍ ଅନଙ୍ଗ-ତରଙ୍ଗ-ବଶାଦିବ",
          "ସୂଚିତ-ହରି-ପରିରମ୍ଭମ୍",
          "ପୃଚ୍ଛ ମନୋହର-ହାର-ବିମଳ-ଜଳ",
          "-ଧାରମମୁଂ କୁଚ-କୁମ୍ଭମ୍"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଅଧିଗତ-ଅଦଖିଳ-ସଖୀଭିରିଦଂ ତବ",
          "ବପୁରପି ରତି-ରଣ-ସଜ୍ଜମ୍",
          "ଚଣ୍ଡି-ରସିତ-ରସନା-ରବ-ଡିଣ୍ଡିମମ୍",
          "ଅଭିସର ସରସମ୍ ଅଲଜ୍ଜମ୍"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ସ୍ମର-ଶର-ସୁଭଗ-ନଖେନ ସଖୀମ୍",
          "ଅବଲମ୍ବ୍ୟ କରେଣ ସଲୀଳମ୍",
          "ଚଳ ବଳୟ-କ୍ୱଣିତୈରପି ବୋଧୟ",
          "ହରିମପି ନିଜ-ଗତିଶୀଳମ୍"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଶ୍ରୀ-ଜୟଦେବ-ଭଣିତମ୍ ଅଧରୀକୃତ-",
          "ହାରମୁଦାସିତରାମମ୍",
          "ହରି-ବିନିହିତ-ମନସାମ୍ ଅଧିତିଷ୍ଠତୁ",
          "କଣ୍ଠତଟୀମ୍ ଅବିରାମମ୍"
        ]
      }
    ]
  },
  "sources": [
