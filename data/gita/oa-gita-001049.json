{
  "id": "oa-gita-001049",
  "name": {
    "en": "Kahana sajani re aau",
    "or": "କହନା ସଜନୀ ରେ ଆଉ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahana-sajani-re-aau-jhinjhoti-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହନା ସଜନୀ ରେ ଆଉ",
          "ସହି ନ ପାରେ ଶ୍ୟାମ ପ୍ରେମ ଦାଉ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଙ୍କେତରୁ ଆଶା ବଳି ଥିଲି ଅଙ୍ଗ ସଙ୍ଗ ଭାଳି",
          "ନ ଦେଖି ଦୁଃଖ ପ୍ରବଳି ଭେଦି ଗଲାନି ମରମକୁ ବଳି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆସିବି ବୋଲି ସେ କହି କୁଞ୍ଜରେ ମତେ ବସାଇ",
          "କାହା ପ୍ରୀତିରେ ସେ ଯାଇ ରହିଲେ ନିଶି ମାନସ ମଜ୍ଜାଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ବାଣୀ ପରତେ କରି କୁଳଶୀଳ ପରିହରି",
          "ମୋହନେ ପ୍ରୀତି ଆଦରି ଏବେ ଆସି ମୁଁ ନୋହିଲି କାହାରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦ୍ୱିଜ ରଘୁନାଥ କହି ଶ୍ରୀମତୀ ବିରସ ଚାହିଁ",
          "ନ ଭାଳ ଆଉ ତୁ ସହୀ ଆଣିବି ତାଙ୍କୁ ମାନସ ରସାଇ"
        ]
      }
    ]
  },
