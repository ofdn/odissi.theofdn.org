{
  "id": "oa-gita-001072",
  "name": {
    "en": "Se braja nagaraku go",
    "or": "ସେ ବ୍ରଜ ନାଗରକୁ ଗୋ"
  },
  "composer": "oa-person-000075",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-braja-nagaraku-go-somanatha-singha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ ବ୍ରଜ ନାଗରକୁ ଗୋ",
          "କେହୁ ଆଣିଦେବ ମୋରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖିଥିଲି ଦିନେ ଏ ଗୋପ ଦାଣ୍ଡରେ",
          "ଆସୁଥିଲେ ହରି ବତ୍ସା ସଙ୍ଗତରେ",
          "ଗୋପାଳ ମଧ୍ୟରେ ଚନ୍ଦ୍ରିକା ପରାଏ",
          "ବଂଶୀ ଧରିଥିଲେ କରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶିରରେ ମୟୂର ଚନ୍ଦ୍ରିକାର ଚୂଳ",
          "ନାସେ ଶୋଭାବନ ଦିଶେ ସିନ୍ଧୁଫଳ",
          "କର୍ଣ୍ଣରେ ଜଡ଼ିତ ମର୍କତ କୁଣ୍ଡଳ",
          "ଭାଲେ ଗୋରଚନା ଗାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହୃଦରେ ପଦକ ହସ୍ତରେ କଙ୍କଣ",
          "କଟୀରେ କିଙ୍କିଣୀ ବାଜେ ରୁଣଝୁଣ",
          "ପୟରେ ନୂପୁର ଦିଶେ ଶୋଭାବନ",
          "ଢଳି ଚାଲେ ଧୀରେ ଧୀରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପିନ୍ଧି ପୀତାମ୍ବର ଯଶୋଦା କୁମର",
          "ମନ୍ଦେ ମନ୍ଦେ ହସ ସେ ବିମ୍ବ ଅଧର",
          "ରତିପତି ଜିଣି ଦିଶଇ ସୁନ୍ଦର",
          "ନେତ୍ରେ ରଖି ତୀକ୍ଷ୍ଣ ଶରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନ ରହଇ ମତି ମନେ ପଡ଼ିଲେତି",
          "ହୋଉ ପଛେ ମୁହିଁ ପାଇବି ଅକୀର୍ତ୍ତି",
          "ଭାଷେ ସୋମନାଥ ଅନଗୁଳ ପତି",
          "ଭେଟାଇବି ଶ୍ୟାମ ବାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-braja-nagaraku-go-somanatha-singha/"
    }
  ],
