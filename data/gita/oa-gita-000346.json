{
  "id": "oa-gita-000346",
  "name": {
    "en": "Nachanti krusna ki madhure",
    "or": "ନାଚନ୍ତି କୃଷ୍ଣ କି ମଧୁରେ ରାସ ମଧ୍ୟରେ"
  },
  "composer": "oa-person-000018",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nachanti-krusna-ki-madhure/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାଚନ୍ତି କୃଷ୍ଣ କି ମଧୁରେ । ରାସ ମଧ୍ୟରେ ।",
          "ଶ୍ରୀମତୀ ସନ୍ନିଧିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତପନସୁତା କୂଳେ କେଳିକଦମ୍ବ ମୂଳେ",
          "କିଶୋରୀ ଗୋପୀ ମେଳେ କାମ କୁତୂହଳେ ।",
          "ମାତି ଅତି ଲୋଳେ ମନ୍ଦ ମରୁତ ବହେ",
          "ସୁନ୍ଦର ଶଶଧର ଉଦେ ନଭୋମଣ୍ଡଳେ",
          "କୁସୁମ ବରଷନ୍ତି ଦେବେ ହରଷ ଭୋଳେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବୀନ ଘନ ଜିଣି ଦିଶେ ଶ୍ରୀଅଙ୍ଗ ଠାଣି ।",
          "କେକିପୁଚ୍ଛ ଶ୍ରେଣୀ ଚୂଳେ ନିରିମାଣି ।",
          "ନାସାରେ ଶୋହେ କରୀବର ମୋତି ବସଣୀ",
          "ଚରମେ ଚାରୁବେଣୀ",
          "ପାଦେ ନୂପୁର ବାଜେ କିଙ୍କିଣୀ କିଣିକିଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନବରତ୍ନ କୁଣ୍ଡଳ ଲୁଳେ ଗଣ୍ଡମଣ୍ଡଳ",
          "ହୃଦରେ ବନମାଳ ଅମଳ କମଳ ।",
          "ନୟନ ଚଞ୍ଚଳ ନଟବର ଶେଖର",
          "କଟୀ ତଟରେ ସୁଘଟିତ ପୀତ ଦୁକୂଳ",
          "ମଣ୍ଡଳାକାର ହୋଇ ସ୍ଥିତ ଗୋପୀ ଗୋପାଳ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେ ସହଚରୀ ପରିବାଦିନୀ କରେ ଧରି",
          "ରାଗ ଆଳାପ କରି କରେ କର ମାରି ।",
          "କେହୁ ମନୋହାରୀ ମର୍ଦ୍ଦଳ କେ ବଜାଇ",
          "ନର୍ତ୍ତନେ କେ ବିହରି କେହୁ ସ୍ୱର ଉଚ୍ଚାରି",
          "କୁଞ୍ଜବନ ବିହାରୀ ଅତି ଆନନ୍ଦେ ହେରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗଙ୍ଗବଂଶ ପୟୋଧି ସମ୍ପୂର୍ଣ୍ଣ ସୁଧାନିଧି",
          "ଅଶେଷ ଗୁଣ ସିଦ୍ଧି ମହାରାଜ ସୁଧୀ ।",
          "ପ୍ରୀତି ଅବିରୋଧୀ ବୀରାଧି ବୀରବର",
          "ଶ୍ରୀ ପୀତାମ୍ବର ଦେବ କହିଲେ ରାସ ବିଧି",
          "ଶୁଣ ସୁଜନେ ଜନେ ଏ ରସେ ଦେଇ ବୁଦ୍ଧି"
        ]
      }
    ]
  },
