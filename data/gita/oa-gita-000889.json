  "name": {
    "en": "Budi pritire hudili",
    "or": "ବୁଡ଼ି ପ୍ରୀତିରେ ହୁଡ଼ିଲି"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000124"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/budi-pritire-hudili-mallara-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବୁଡ଼ି ପ୍ରୀତିରେ",
          "ହୁଡ଼ିଲି ପଥ ପଡ଼ି ଶ୍ୟାମ ସାଥିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାଡ଼ି ଆସଇ ଘନ ଘେରି ସାରା ଗଗନେ",
          "ଛାଡ଼ି ଆସିଲି ଘର ଘୋର ଅନ୍ଧାର ରାତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘଡ଼ିକି ଘଡ଼ି ଦେଖ ରଡ଼ି ଦିଏ ଡାହୁକ",
          "ତଡ଼ିତ ଲତା ମୋରେ ଚାହିଁ ଫୁଲାଏ ଛାତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏଡ଼ି ଦେଇ ତ କଣ୍ଟ କାହିଁ ରହିଲେ ଖଣ୍ଟ",
          "ଏଡ଼ିକି ସେ ଲମ୍ପଟ କବିଚନ୍ଦ୍ର ବଦତି"
        ]
      }
    ]
  },
  "sources": [
