{
  "id": "oa-gita-000414",
  "name": {
    "en": "Na jani mun hudi galiti",
    "or": "ନ ଜାଣି ମୁଁ ହୁଡ଼ିଗଲିଟି"
  },
  "composer": "oa-person-000075",
  "mula_raga": [
    "oa-raga-000116"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-jani-mun-hudi-galiti-raga-goudi-somanatha-singha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ ଜାଣି ମୁଁ ହୁଡ଼ି ଗଲିଟି",
          "ନନ୍ଦକିଶୋରରେ କରି ପୀରତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅତି ନିଷ୍ଠୁର ପରି ତାର ମତି",
          "ମୋତେ ହେଲା ଏବେ ଅପକୀରତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘର ବର ଦୂର କରି ମୁହିଁଟି",
          "ବୁଲୁଥାଇ କୁଞ୍ଜବନରେ ନିତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜରତୀ ବଚନ ଶୁଣି କରତି",
          "ହେଉଥାଇ ଏବେ ମୋହର ଛାତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତା ବିନା ନ ସରେ ଦିବସ ରାତି",
          "ଝୁରି ଝୁରି ତନୁ କ୍ଷୀନ ହେଲାଟି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସୋମନାଥ ବୀରବର ନୃପତି",
          "ଭାଷେ ବୋଲିବାର ହୋଏ ଯୋଗତି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
