    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯାଅ ଯାଅ ହେ ମୋହନ",
          "ନ କହ ଚାଟୁବଚନ",
          "ତୁମ୍ଭ ରୀତିକି ପ୍ରଣାମ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଥିଲ କାହା ପୁରତେ",
          "ଆସୁଅଛ ପ୍ରଭାତେ",
          "ନାହିଁ କି ମୁଖେ ଶରମ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆହେ ଶ୍ୟାମସୁନ୍ଦର",
          "କୋଟି କୋଟି ଜୁହାର",
          "ତୁମ୍ଭର ସ୍ନେହ ସୁଷମ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବୋଲେ ଦୀନ ତାରିଣୀ",
          "ଦେଖି ଯିବି କି ଧନୀ",
          "ବସିଛନ୍ତି କରି ମାନ"
        ]
      }
    ]
  },
