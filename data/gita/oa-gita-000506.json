  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/apane-rachi-rachi-bhaba-charjyapada-charyapada-saraha-sarahapa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରହପାଦାନାମ୍",
          "ଆପଣେ ରଚି ରଚି ଭବ ନିର୍ବାଣ",
          "ମିଛେଁ ଲୋଅ ବନ୍ଧା ବଏ ଆପଣ ।",
          "ଅମ୍ଭେ ଣ ଜାଣହୁଁ ଅଚିନ୍ତ ଜୋଇ",
          "ଜାମ ମରଣ ଭବ କଇସଣ ହୋଇ ।",
          "ଜଇସୋ ଜାମ ମରଣ ବି ତଇସୋ",
          "ଜୀବନ୍ତେ ମଲେ ନାହିଁ ବିଶେସୋ ।",
          "ଜା ଏଥୁ ଜାମେ ମରଣେ ବିସଙ୍କା",
          "ସୋ କରଭ ରସ ରସାନେରେ କଙ୍ଖା ।",
          "ଜେ ସଚରାଚର ତ୍ରିଅସ ଭ୍ରମନ୍ତି",
          "ତେ ଅଜରାମର କିମପି ନ ହୋନ୍ତି ।",
          "ଜାମେ କାମ କି କାମେ ଜାମ",
          "ସରହ ଭଣତି ଅଚିନ୍ତ ସୋ ଧାମ ।"
        ]
      }
    ]
  },
