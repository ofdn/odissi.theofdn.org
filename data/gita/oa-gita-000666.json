{
  "id": "oa-gita-000666",
  "name": {
    "en": "Sarasa nayana anare thare",
    "or": "ସାରସ ନୟନା ଅନାରେ ଥରେ"
  },
  "composer": "oa-person-000120",
  "mula_raga": [
    "oa-raga-000009"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sarasa-nayana-anare-thare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାରସ ନୟନା ଅନାରେ ଥରେ",
          "ମନ୍ଦେ ହସି ଚନ୍ଦ୍ରାନନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନ ନାଶ ଦାସକୁ ହେବ ଅପଯଶ",
          "ଯଶ ରକ୍ଷଣୀ ବିଚାର ତୋ ମାନସରେ",
          "ନ ସହି ମୋ ନାଁରେ କେ କି କହିଅଛି",
          "ଅଛିଦ୍ର ଚାରୁ କେଶୀ ନବୀନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିନାଶ କରେ ତୋ ବିନା ପଞ୍ଚଶର",
          "ସରସ ବଚନା ନିରାଶ ନ କର ରେ",
          "କରକ କୁନ୍ଦ ବୃନ୍ଦ ସୁନ୍ଦର",
          "ଦନ୍ତୀ ଦନ୍ତୀପତି ଜିତ ସୁଗମନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନାଇଁ କହିଲେ ନ ଘେନୁ ସୁନ୍ଦରୀ",
          "ଦରିଦ୍ର ମୁଁ ମୋ ଧନ ବିମ୍ବ ଅଧରୀରେ",
          "ଧରିତ୍ରୀ ମଣ୍ଡନା ମୋ ଜୀବ ଉଦ୍ଧରି",
          "ଧରି ନିଜ ଯଶ ରଖୁ କି ନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କି ନା ମଦନର ତୋ ପ୍ରସନ୍ନେ ନବ",
          "ନବନୀତ ଅଙ୍ଗୀ ବିଚାର ରେ",
          "ଜୀବ ଜୀବନ ତୁ ମୋର ସବର୍ଦ୍ଧନୀ",
          "ଧନୀ ଏବେ କାମ ଭରସୁ ନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସୁନାଗୋରୀ ତୋଷ ଶୁଣି କୃଷ୍ଣ ଭାଷ",
          "ଭାଷଇ ହରିକୃଷ୍ଣ ରାଜ ଏ ରସରେ",
          "ରସରେ ତୋଷିଲେ ସେ ନୀରଦ ଅଙ୍ଗ",
          "ଅଙ୍ଗନା ରତ୍ନ ଘନ ଜଘନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
