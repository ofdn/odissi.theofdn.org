{
  "id": "oa-gita-001380",
  "name": {
    "en": "Bhala sindura bindu re",
    "or": "ଭଲା ସିନ୍ଦୂର ବିନ୍ଦୁରେ"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000198"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-sindura-bindu-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଲା ସିନ୍ଦୂର ବିନ୍ଦୁରେ ବନ୍ଧୁ",
          "ମୋ ମନେ ମଣିଲି ରାହୁ ଭୟେ ସୂର୍ଯ୍ୟ",
          "ଆଶ୍ରେ କରିଛି କି ଇନ୍ଦୁରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚନ୍ଦ୍ର ପାଶେ ରହି ଯୁଦ୍ଧ ଆରମ୍ଭିଛି",
          "କର୍ଣ୍ଣଫୁଲ କରି ଢାଲ",
          "ନାସାନଥ ଚକ୍ର ଧରିଛି କି କରେ",
          "ପେଷିବ ଇନ୍ଦ୍ର ପ୍ରଭାଲ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭ୍ରୂଲତା କମାଣ ଅଞ୍ଜନର ଗୁଣ",
          "ଟଙ୍କାର କରେ ପିଛଡ଼ା",
          "ନୟନ ଶର ପେଷିଲେହେଁ ଅସୁର",
          "ଶରେ ହେବ ତନୁ ପୀଡ଼ା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଳକା ଗଡ଼ ଭିତରେ ପଶିକରି",
          "ନିର୍ଭୟେ ହୋଇ ରହିଛି",
          "ଦନ୍ତହୀରା ଶଲ୍ୟ ହୃଦରେ ଲଗାଇ",
          "ଯୁଦ୍ଧେ ଗୁମାନ ବହିଛି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କସ୍ତୁରୀପନ୍ତି ପାଶେ ଯାହା ଅଛନ୍ତି",
          "ଟୋପି ଟୋପି ଅଟେ ଗୁଳି",
          "ନାସା ଗୁଳିରେ ପୂରାଇଣ ମାଇଲେ",
          "ହୃଦ ପକାଇ ବଦଳି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚନ୍ଦ୍ର ସୂର୍ଯ୍ୟ ବେନି ଅଟେ ମହାରଥୀ",
          "ହୋଇଛନ୍ତି ଏକଚିତ୍ତ",
          "ଏକ ଜଣଙ୍କୁ ଦୁଇଜଣ ହୋଇଲେ",
          "ଜିଣିବେନି ସିଂହ ସୁତ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏଣେ ଚନ୍ଦ୍ର ସୂର୍ଯ୍ୟ ଚଢ଼ି ମନୋରଥ",
          "ନାନା ଶସ୍ତ୍ର ଛନ୍ତି ପୂରି",
          "ବୋଲେ ରାଜସିଂହ ଏ ମୁଖ ଚୁମ୍ବିଲେ",
          "କୋଟି ଯୁଗ ନୁହେଁ ସରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhala-sindura-bindu-re/"
    }
  ],
