  "name": {
    "en": "Ja ja tu chhuan na",
    "or": "ମୋହନ ଯା ଯା ତୁ ଛୁଅଁନା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ja-ja-tu-chhuan-na-sri/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନ ଯା ଯା ତୁ ଛୁଅଁନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାରଣପରି ନ ଘେନ ବାରଣ ବାଳକ ପରି ହୋନା",
          "ବାର ଆଜ ଶ୍ରୀ ମିତ୍ର ମୁଁ ପୂଜିବି ଅପକୀରତି ବହନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାଟ ନିକଟ ନଟବର ନିପଟ ପାଟକ ଗୋପଜାତି",
          "ହାଟ ଘାଟରେ ପଶୁପି ଲମ୍ପଟ ପାପ ହେବ ଏବେ ଖ୍ୟାତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅନ୍ତର ହୁଅ ଧ୍ୱାନ୍ତ ସହଚର କାନ୍ତ ଆସିବେଟି ମୋର",
          "ସ୍ୱାନ୍ତରେ ରଖି ହନ୍ତକ କଂସକୁ କହି ସାରିବେ ସଂସାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଳି ଅଇଲେ ଗାଳି ଦେଇ କରତାଳି ମାରିବେଟି ଚାଳି",
          "ଶାଳୀ ଟାପରା ସେ ଚନ୍ଦ୍ରାବଳୀକି କରିବୁ ଯା ବନମାଳୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପାଣି କୋରକୀକୃତ କରି ସେ ହରିସେବକୀ ବୋଲୁ ମୁହିଁ",
          "ଜାଣି ସେବ ବୋଲି ସେ ବନାନ୍ତରେ ଗୋପାଳକୃଷ୍ଣ କହଇ"
        ]
      }
    ]
  },
