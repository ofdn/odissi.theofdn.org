{
  "id": "oa-gita-000685",
  "name": {
    "en": "Mohana murali nada nuhe sahi",
    "or": "ମୋହନ ମୁରଲୀ ନାଦ ନୁହେଁ ସହି"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000105"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohana-murali-nada-nuhe-sahi-pattamanjari-jati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନ ମୁରଲୀ ନାଦ ନୁହେଁ ସହି ମା",
          "ଶୁଣିଲା ମାତ୍ରକେ ହୃଦ ହୁଏ ଦହି ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶାଶୁ ନଣନ୍ଦ ଗର୍ଜ୍ଜନ ଥିଲେ ହେଲେ ଗୁରୁଜନ",
          "ନ ଗଲେ ଯମୁନା ତଟ ନୁହେ ରହି ମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛଡ଼ାଇ ମୋ ପତିବ୍ରତ କରାଇ ଅଣ ଆୟତ୍ତ",
          "ପଞ୍ଚଶର ସ୍ମର ବିନ୍ଧେ ତାହି ତାହି ମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବ୍ରଜହାଟ ବାଟ ଗୋଟା ଶୁଭିଲା ମୋହରି ହଟା",
          "ତଥାପି କୁଞ୍ଜକୁ ଧାଏଁ ବାଇ ହୋଇ ମା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶୁଣିଲେ ଯେଉଁ ଯୁବତୀ ରଖି ପାରୁଥିବ ଧୃତି",
          "ତାକୁ ପଚାରି ଉପାୟ ଦିଅ କହି ମା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭାଷେ ଶ୍ରୀ ବୀରବିକ୍ରମ ଦେବ ଯୁବରାଜ ଶ୍ୟାମ",
          "ପ୍ରେମଟି ଅତି ବିଷମ ହେଲା ସହି ମା"
        ]
      }
    ]
  },
  "sources": [
    {
