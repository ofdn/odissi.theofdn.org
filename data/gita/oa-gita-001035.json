{
  "id": "oa-gita-001035",
  "name": {
    "en": "E nisi ki kale kanta",
    "or": "ଏ ନିଶି କି କଲେ କାନ୍ତ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000103"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-nisi-ki-kale-kanta-regupta-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ ନିଶି କି କଲେ କାନ୍ତ ବିଷମ ଦଶାରେ",
          "ଲୋକ ହସାରେ ବସିଲା ବସାରେ",
          "ସଡ଼ିଗଲି ମୁଁ ଆସି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କହିଲେ ସେ ଯେତେ ଘେନି ତାହା ଚିତ୍ତେ",
          "କରିଥିଲି ସତ ପ୍ରତେ ଗୋ",
          "ଏବେ ତାଙ୍କ ଚିତ୍ତ ନ ରହିଲେ ସତେ",
          "କିମ୍ପା କଲେ ଏତେ ସରି ଗୋ ପ୍ରାଣମିତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆସିବେ ଅବଶ୍ୟ ବୋଲି ପ୍ରାଣଈଶ",
          "ଚାହୁଁଥିଲି ଦଶ ଦିଶ ଗୋ",
          "ସେ ମୋହର ଦୋଷ ନ ଦେଖି ନିରାଶ",
          "କଲେ ତ ସେ ରାସରସିକ ଏହା କିସ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେ ଯେଉଁ ଅନାଥା କରିଦେଲେ ନାଥ",
          "ଚାହୁ ପୁରୁଷାର୍ଥ ବ୍ୟର୍ଥ ଗୋ",
          "ଆଜ ମନୋରଥା ନୋହିବ କି ସାର୍ଥ",
          "କହେ ରଘୁନାଥ ଆସିବେ ଏବେ ନାଥ"
        ]
      }
    ]
  },
