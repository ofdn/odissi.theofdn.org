{
  "id": "oa-gita-000182",
  "name": {
    "en": "Apurba dekhili aja re",
    "or": "ଅପୂର୍ବ ଦେଖିଲି ଆଜରେ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/apurba-dekhili-aja-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅପୂର୍ବ ଦେଖିଲି ଆଜରେ ସଜନୀ",
          "ତ୍ରଇଲୋକ୍ୟ ଜିଣି ତେରେଛ ଚାହାଣୀ",
          "ତ୍ରିଭଙ୍ଗିମା ଠାଣି ଫୁଟି ଦିଶେ ତେଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଗସ୍ତିଙ୍କ ତାତ ସଙ୍ଗତରେ ନେଲି",
          "ସାତସୁତା ତଟେ ପ୍ରବେଶ ହୋଇଲି",
          "ଏଗାରରେ ବନ ଆସନ୍ତେ ସଦନ",
          "ପଥରେ ଦେଖିଲି ସେ ରସିକରାଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦେଖିଲା ବେଳକୁ ତ୍ରିଭଙ୍ଗୀରେ ଛିଡ଼ା",
          "ଦୁଇସୁତ କଲା ଦ୍ୱିଗୁଣରେ ପୀଡ଼ା",
          "ଚନ୍ଦ୍ରସୁତ ଥିଲା କାହିଁ ହଜିଗଲା",
          "ଲାଜ ପାଇଗଲା ବିରାଟ ତନୁଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୈଳସୁତାପତି ସୁତର ବାହନ",
          "ପୁଚ୍ଛ ମସ୍ତକରେ ଦିଶେ ଶୋଭାବନ",
          "ସତାଇଶପତି ସଙ୍ଗରେ ଥିବାରୁ",
          "ଦୂରୁ ଦେଖି ସଖି ପାଇଲି ମୁଁ ଲାଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଠ ପାଞ୍ଚ ଧରି କହୁଅଛି ତୋତେ",
          "ଚାରିସୁତା ଭ୍ରାତ ଆଣିଦେବୁ ମୋତେ",
          "ଉପଇନ୍ଦ୍ର ଭଣି ରାଧା ବାଣୀ ଶୁଣି",
          "ମନ ସୂତ୍ରେ ଗୁଣି ଦୂତୀ ହେଲେ ସଜ"
        ]
      }
    ]
  },
  "sources": [
    {
