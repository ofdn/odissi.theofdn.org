{
  "id": "oa-gita-000450",
  "name": {
    "en": "Bhangi chahan",
    "or": "ଭଙ୍ଗୀ ଚାହାଁ",
    "alternates": [
      "Chahan E Mohanara Bhangi"
    ]
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000054"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Bha Patala",
      "or": "ଭ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhangi-chahan-bha-champu-kedaragouda-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଙ୍ଗୀ ଚାହାଁ",
          "ଭୂରୁନୀଳ ଭୁଜଙ୍ଗୀ ଭ୍ରମର ଜୀବସଙ୍ଗୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭାଗ୍ୟ ଏ ଜନ ଆଖି ଜନନରଟି ସଖି ଜାଣରେ",
          "ଭରମି ନ ଯା ତୁ ମନ୍ମଥ ବାଣରେ",
          "ଭୁଜପାଶିକୁ ଛନ୍ଦି ମୋ ଗଳେ",
          "ଭିଡ଼େ ପଦକଞ୍ଜ ଖଞ୍ଜ ଧରଣୀ ତଳେ",
          "ଭୂମଣ୍ଡନା ରେ",
          "(ପଡ଼ି)",
          "ଭଲା ମାନୁଛି ଦେଖ ମୁଖ ସୁଧାମୟୂଖ",
          "ଅଳକତଳ ଅଖଣ୍ଡିତ ରୋଚନାରେଖ",
          "ତିଳକେ ଦୃଷ୍ଟି ରଖ ସଖି ରେ",
          "କି ଦିଶେ ଚଳାଚଳ ଚାରୁଚନ୍ଦ୍ରକ ଚୂଳ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭର୍ତ୍ସିତ ନବରବି କୁଣ୍ଡଳଯୁଗ ଛବି ଗଣ୍ଡରେ",
          "ଭିଦୂର ଏହିଟି ବିବେକ ମୁଣ୍ଡରେ",
          "ଭବ୍ୟଦାୟକ ମାଣିକ୍ୟବର",
          "ଭ୍ରମ ଜାତ କରୁଅଛି ମଧୁରାଧର",
          "ଭୂମଣ୍ଡନା ରେ",
          "(ପଡ଼ି)",
          "ଭୁଷୁଡ଼ିବଟି ସତୀ ବ୍ରତ ନିୟମ ଧୃତି",
          "ଶ୍ରୀଅଙ୍ଗସଙ୍ଗ ମତି ବିନା ଅନାଅ ଦ୍ୟୁତି",
          "ମଦଦ୍ଵିରଦ ଗତି ସଖି ରେ",
          "ଶୋଭାନିଧି ତୋ ଗାତ୍ର ନ ଚୁମ୍ବୁ ଶ୍ୟାମ ନେତ୍ର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭଙ୍ଗୀତ୍ରୟରେ ଉଭା ହେବାର କେଡ଼େ ଶୋଭା ପ୍ରକାଶେ",
          "ଭରାଜି କି ହାର ସେ ବକ୍ଷ ଆକାଶେ",
          "ଭର୍ଗ ସମାଧି ଭଙ୍ଗ କରିବ",
          "ଭଲେ ଏହା କରକମଳ ବଂଶୀରବ",
          "ଭୂମଣ୍ଡନା ରେ",
          "(ପଡ଼ି)",
          "ଭୂତିଭୂଷବିପକ୍ଷ ପ୍ରକ୍ଷ୍ୱେଡ଼ନରୁ ତିକ୍ଷ",
          "ଏ କିଶୋର କଟାକ୍ଷ କନକାଚଳ ବକ୍ଷ",
          "କେବଳ ଏହା ଲକ୍ଷ୍ୟ ସଖି ରେ",
          "କହ ବିଚାରି ସତେ ଯୁବତୀ ଧୃତି କେତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷିଲେ ଅଷ୍ଟଦୁର୍ଗ କ୍ଷିତି କପଟସ୍ଵର୍ଗ ମଘବା",
          "ଏ ଶୃଙ୍ଗାର ସୁଧାବରଷୀ ମେଘ ବା",
          "ଭୃତ୍ୟପଣରେ ହେଲେ ଏହାର",
          "ଭୁଜ ଭୁଜଗେନ୍ଦ୍ର କରନ୍ତା କଣ୍ଠେ ହାର",
          "ଭୂମଣ୍ଡନା ରେ",
          "(ପଡ଼ି)",
          "ଭଜିଥାନ୍ତା ରଜନୀ ଦିବସେ ପିକଦାନୀ",
          "ଖଟି ଏ କୃପା ଘେନି ସାର୍ଥ ହୁଅନ୍ତା ଜନି",
          "ସତେ ଜଳଜଯୋନି ସଖି ରେ",
          "କରିବେ ଅନୁଗ୍ରହ ଏ ମୋହନ ବିଗ୍ରହ"
        ]
      }
    ]
  },
