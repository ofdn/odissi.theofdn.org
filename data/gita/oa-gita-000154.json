{
  "id": "oa-gita-000154",
  "name": {
    "en": "Balana sneha kala nagare",
    "or": "ବଳାନା ସ୍ନେହ କଳାନାଗରେସରିଯିବୁଟି ରଜନୀ ଜାଗରେ । ଘୋଷା । ଦେଖୁଛୁ ତ ଗର୍ବ କୁଟିଳ ଚାଲିଭୁଜଙ୍ଗ ପୁଙ୍ଗବ ମୁଁ ସିନା ବୋଲି । ୧ । ତାହାର ଅତି ପ୍ରୀତି କଳାପୀରେତହୁଁ ବହଇ ତା କଳାପ ଶିରେ । ୨ । ମୁରଲୀଧ୍ୱନି ଦମ୍ଭ ଗରଜନକେ ସହିବ ନୋହି ମୋହିତ ମନ । ୩ । କଲେ ତା ଭୋଗେ ଅଭିଳାଷ ଲବଅଣ୍ଟିବ ନାହିଁଟି ବନପଲ୍ଲବ । ୪ । ଘାରି ହୋଇ ସରିଯିବୁ ସଦନେବଂଶୀଦେବ […]"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000071"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/balana-sneha-kala-nagare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଳାନା ସ୍ନେହ କଳାନାଗରେ",
          "ସରିଯିବୁଟି ରଜନୀ ଜାଗରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖୁଛୁ ତ ଗର୍ବ କୁଟିଳ ଚାଲି",
          "ଭୁଜଙ୍ଗ ପୁଙ୍ଗବ ମୁଁ ସିନା ବୋଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତାହାର ଅତି ପ୍ରୀତି କଳାପୀରେ",
          "ତହୁଁ ବହଇ ତା କଳାପ ଶିରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁରଲୀଧ୍ୱନି ଦମ୍ଭ ଗରଜନ",
          "କେ ସହିବ ନୋହି ମୋହିତ ମନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଲେ ତା ଭୋଗେ ଅଭିଳାଷ ଲବ",
          "ଅଣ୍ଟିବ ନାହିଁଟି ବନପଲ୍ଲବ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଘାରି ହୋଇ ସରିଯିବୁ ସଦନେ",
          "ବଂଶୀଦେବ ଯେବେ ବଂଶୀବଦନେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କବିମାର୍ତ୍ତଣ୍ଡ ରାୟଗୁରୁ କହେ",
          "ଗଜ ଚରମେ କାହା ସ୍ନେହ ନୋହେ"
        ]
      }
    ]
  },
