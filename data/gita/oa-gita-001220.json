{
  "id": "oa-gita-001220",
  "name": {
    "en": "Nahin karide re kahin pain aparodha",
    "or": "ନାହିଁ କରିଦେ ରେ କାହିଁପାଇଁ ଅପରୋଧ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nahin-karide-re-kahin-pain-aparodha-gopalakrusna-malabagouda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାହିଁ କରିଦେ ରେ କାହିଁପାଇଁ ଅପରୋଧ",
          "ବାହିନୀ ପରି ଲୁଚି ବହିଯାଉଛି",
          "ଆଉରି ପୀରତି ସଧ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାଳଯାକ କେ ସେ ଗଞ୍ଜି ହେଉଥିବ",
          "ଏ ଅସଲଟ କଥାରେ",
          "ମୂଳଠାରୁ ଚୂଳ ଯାଏ ଲବ ସତ",
          "ନ ଥିବ ଯାହା ଦେହରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେତେବେଳେ ଅବା କେଉଁଠାରେ କେ ସେ",
          "ଭ୍ରମିବାର ଥରେ ସିନା",
          "କୋଡ଼ିଏ ଥର ଦିନକୁ କହୁଥିଲେ",
          "ଘଡ଼ିଏ ହେଲେ ରଖନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲୁଚାଇ ଅପରାଧଯାକ ସଖୀଙ୍କି",
          "ନ କହି ସହିଲୁ ଯାର",
          "ଡକା କରାଇଲା ବନକୁ ଡକାଇ",
          "କଲା ପରା ଉପକାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଳି ଗିରି ମଲ୍ଲୀଠାରୁ ନ ଯିବ କି",
          "ନଳିନୀ କୋଳରେ ଥିଲେ",
          "ଧୂଳି ବୋଳି ନ ହୋଇବ କି ବାରଣ",
          "ଶତ ବାର ଗାଧୋଇଲେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏଣୀଈକ୍ଷଣୀ ହୃଦରେ ବିରହାଗ୍ନି",
          "ଘର କରି ସଦା ରହୁ",
          "ଏଣିକି ସେ ମାର ମହୋତ୍ସବ ସୁଖ",
          "ନୋହିଲେ ପଛକେ ନୋହୁ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏତେ ଦିନ ପରି ପୀରତିବତ୍ସଳା",
          "ମୁହଁ ଶୁଖାନା ତୁ ଆଉ",
          "ମଥାରେ ପଣନ୍ତ ପକାଇ ସେ ଶ୍ୟାମ",
          "ତାହା ପାନ୍ଥରେ ସେ ଯାଉ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କହଇ ଗୋପାଳକୃଷ୍ଣ ସୋପାନରେ",
          "ମୋହନ ଆସିଅଛନ୍ତି",
          "ବହନ ସଖୀ ବଦନେ ଦେଇ ବାସ",
          "ଶ୍ରୀରାଧା ତୁନି କରାନ୍ତି"
        ]
      }
    ]
  },
  "sources": [
