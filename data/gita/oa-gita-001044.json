  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaa-taku-majja-saberi-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯା ତାକୁ ମଜ୍ଜା ଜାଣିଲି ଜାଣିଲି ମଜ୍ଜା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯା ତୁଲେ ଯାମିନୀ ନେଲ",
          "ଜାଣୁମଣି ସେ ଜାଗରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସୁନ୍ଦର ଅଞ୍ଜନ ଚିହ୍ନ",
          "ସୁନ୍ଦରତରେ ବନ୍ଧୁ ହର ହେ ତା ମନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିଶା ଜଗାଇ କୁଞ୍ଜରେ",
          "ରସାଇବାକୁ ଦିଶାଅ ମୁଖ ପ୍ରାତରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହଇ କବି ସୁଧାଂଶୁ",
          "କହିଲେ ରାଧା ମୋହନ କୁହନା ବଶୁ"
        ]
      }
    ]
  },
  "sources": [
    {
