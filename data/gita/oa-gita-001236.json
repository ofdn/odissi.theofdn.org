{
  "id": "oa-gita-001236",
  "name": {
    "en": "Chhale sri hari dwaraka puri",
    "or": "ଛଳେ ଶ୍ରୀହରି ଦ୍ୱାରକା ପୁରୀ"
  },
  "composer": "oa-person-000150",
  "mula_raga": [
    "oa-raga-000043"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhale-sri-hari-dwaraka-puri-usabhilasa-prabandha-kabiratna-narayana-misra-basanta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଉଷାଭିଳାଷ ପ୍ରବନ୍ଧ, ବସନ୍ତରାଗେଣ",
          "ଛଳେ ଶ୍ରୀହରି ଦ୍ୱାରକା ପୁରୀ ରଚିଲେ ବରଶୋଭା",
          "ଛଛନ୍ଦେ ଯଦୁକୁଳେ ଆନନ୍ଦେ ବିହରେ ଅତି ଲୋଭା । ଉଦ୍ଗ୍ରାହଃ ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଛଇଳବର କା ମା କୁମର ସେ ପୁର ମଧ୍ୟେ ମୋହେ",
          "ଛବି ମଦନ କୋଟି ଦମନ କାମିନୀ ମନ ମୋହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜଗତେ ଏହି ସେହୁ ରସିକମଣି ଖେଳଇ ରଙ୍ଗେ",
          "ଜାତି ପଦ୍ମିନୀ ବରକାମିନୀ ଜନ ସହସ୍ର ସଙ୍ଗେ । ଦ୍ୱିଗୁଣମାତ୍ରୋ ଧ୍ରୁବଃ ।"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜିତ ଅଖିଳ ଅହିତବଳ ଭୁଜବିପୁଳ ରାଜେ",
          "ଜୟତି ଅନିରୁଦ୍ଧ ବୀର ଯୁଦ୍ଧେ ଅରି ଗଞ୍ଜେ । ଆଭୋଗଃ ।"
        ]
      }
    ]
  },
