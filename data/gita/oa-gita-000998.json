{
  "id": "oa-gita-000998",
  "name": {
    "en": "Khina madhyama re",
    "or": "କ୍ଷୀଣ ମଧ୍ୟମା ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000053"
  ],
  "kabya": {
    "id": "oa-kabya-000004"
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/khina-madhyama-re-soma-ratnakara-champu-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କ୍ଷୀଣ ମଧ୍ୟମା ରେ କ୍ଷଣେ ନୋହିବାଟି ଭିନ୍ନ",
          "କ୍ଷେମତନ୍ତୁ ପରି ହରିବା ଏ ଯଉବନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କ୍ଷୋମରୂପିଣୀ ଚନ୍ଦ୍ରଚାରିମଚୌର୍ଯ୍ୟ ଧୂର୍ଯ୍ୟତରାନନେ",
          "କ୍ଷୁର୍ଣ୍ଣ ବାସବ ନୀଳ ଚାମର ଚୂର୍ଣ୍ଣକୁନ୍ତଳ ଶୋଭନେ",
          "କ୍ଷୌଣୀଭୃଦ୍‌ବର ପୀବର ସ୍ତନମଣ୍ଡନେ ଯମୁନାବନେ",
          "କ୍ଷପାକର କରେ ଖେଳୁଥିବା ଆଲିଙ୍ଗନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷୌଦ୍ରସାର ସମାନଭାଷୀ ସୁକୁନ୍ଦ ସୁନ୍ଦରହାସୀରେ",
          "କ୍ଷ୍ୱେଡ଼ଭୂଷିତକଣ୍ଠ ପାଦସରୋଜ ସେବନୁ କାଶୀରେ",
          "କ୍ଷୀବକୁଞ୍ଜରଗାମିନୀ ମୁଁ ଲଲାମ ଖୋସିଲି ତୋ ଶିରେ",
          "କ୍ଷାଳିତ ହୋଇ ତା ପ୍ରେମ ପୀୟୂଷ ରାଶିରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କ୍ଷୀରନୀର ସୁଧାଂଶୁ କୈରବ ବାରି ମୀନ ବରାବରେ",
          "କ୍ଷେପିବା ପ୍ରତି ରାତି ବାସର କାମକେଳି ଦରୋଦରେ",
          "କ୍ଷୁଦ୍ରଘଣ୍ଟ ସମୂହ ନୂପୁର ହଂସକାଦି ନିନାଦରେ",
          "କ୍ଷମେ ପୁଆଇବା ମାର ତାପକୁ ମୋଦରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କ୍ଷୁବ୍ଧ ଦୁଗ୍ଧ ସମୁଦ୍ରବୀଚି ବିକୀର୍ଣ୍ଣବିନ୍ଦୁ ଶୁଚିସ୍ମିତେ",
          "କ୍ଷମ କୋମଳ ହେମଚମ୍ପକ ଗୌରବିଗ୍ରହମଣ୍ଡିତେ",
          "କ୍ଷୋଦ ହିଙ୍ଗୁଳଲାଲ ଦନ୍ତ ଦୁକୂଳଶୋଭିନି ପଣ୍ଡିତେ",
          "କ୍ଷିତିସୁର କବିକଞ୍ଜବାନ୍ଧବ ବନ୍ଦିତେ"
        ]
      }
    ]
  },
