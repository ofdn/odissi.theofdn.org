{
  "id": "oa-gita-001186",
  "name": {
    "en": "Sakhi e pirati dahuachi chhati",
    "or": "ସଖୀ ଏ ପୀରତି ଦହୁଅଛି ଛାତି"
  },
  "composer": "oa-person-000043",
  "mula_raga": [
    "oa-raga-000009"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-e-pirati-dahuachi-chhati-dinabandhuraja-kedara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ଏ ପୀରତି ଦହୁଅଛି ଛାତି",
          "ଏଥକୁ ଉପାୟ କହ କିନା",
          "ଛାଡ଼ି ସବୁ ଲାଜ କହୁଅଛି ନିଜ",
          "ପରାଣୁ ଅଧିକ ତୁ ସିନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରୀତି ନ କରିଥିବାର ବଡ଼ ସୁଖ",
          "ଏବେ ତ ବିଧାତା କଲାକ ବିମୁଖ ଗୋ",
          "ପ୍ରୀତି ଅନଳ ମୋ ହୃଦେ ବଡ଼ ଦୁଃଖ",
          "ଦେଇ କରୁଅଛି ଅଚେତନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରୀତି ନୁହଁଇ ଏ ମଦନ ମାଦକ",
          "ହରଇ ଧୈର୍ଯ୍ୟ ବିବେକ ଗୋ",
          "ଚିହ୍ନାଇ ନ ଦିଏ ପରପରା ଲୋକ",
          "ଅଧିକେ କରଇ ପରାଧୀନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜଗତେ ସଲିଳ ଲିଭାଏ ଅନଳ",
          "କି ବିପରୀତ ହେଲା ମୋ କପାଳରେ",
          "ସିଞ୍ଚିଲେ ନିରନ୍ତରେ ନେତ୍ରୁ ନୀରେ",
          "ଜଳି ଅଧିକେ କରଇ କିନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜାଣିଲି ଅତି ବିଷମ ପ୍ରୀତି ରସ",
          "କାହିଁ ମୁଁ କାହିଁ ସେ ଜୁଳକା ଅବତଂସ ସେ",
          "ଏ ଦେହ ତୋ ତହିଁ ଅଟେ ପରବଶ",
          "ପୋଡ଼ୁ ହେବାର ଏ କୁଳାଙ୍ଗନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ଦୀନବନ୍ଧୁରାଜ ଶୁଣ ଗିର",
          "ସଖୀ ତୁ କ୍ରୋଧ ନ କର ଗୋ",
          "ତୁମ୍ଭର ପରାଏ ସେ ନବନାଗର",
          "ଦୁଃଖୀ ତୁମ୍ଭର ଦର୍ଶନ ବିନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
