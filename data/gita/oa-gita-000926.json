{
  "id": "oa-gita-000926",
  "name": {
    "en": "Chandana lagi samaye",
    "or": "ଚନ୍ଦନଲାଗି ସମୟେ"
  },
  "composer": "oa-person-000130",
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chandana-lagi-samaye-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚନ୍ଦନଲାଗି ସମୟେ ଚିନ୍ତ ଚିନ୍ତାମଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁବେଶର ଲାଗି ଶେଷ ଲାଗି ହୋଇ ଝୀନବାସ",
          "କଟୀରେ ସୁବର୍ଣ୍ଣ ଝୁମ୍ପା ଆହା କେଡ଼େ ଠାଣିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତିନି ବାଡ଼େ ତିନି ଲୋକ ସେବକ ପଶୁପାଳକ",
          "ରତ୍ନ ସିଂହାସନେ ଉଭା ଯୋଡ଼ି ବେନି ପାଣିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚନ୍ଦନ ସଂସ୍କାର ସାରି ପ୍ରଭୁ ଅଙ୍ଗେ ଲାଗି କରି",
          "ହରି ଭଦ୍ରା ସୁଦର୍ଶନ କମଳା ଘରଣୀଙ୍କି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ହଡ଼ପ ନାୟକ ରହି ବିଡ଼ିଆ ପତ୍ରକୁ ବହି",
          "କରାଇ ମଣୋହି ତହିଁ କମ୍ବୁ ଚକ୍ର ପାଣିଙ୍କି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଡାକଇ ଖୁଣ୍ଟିଆ ଦ୍ୱିଜ ମଣିମା ଭୋ ଦେବରାଜ",
          "ଅଖିଳ ବ୍ରହ୍ମାଣ୍ଡନାଥ ପ୍ରଭୁ ମନ ଜାଣିକି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ନିଜ ନିଜ ଗୁଣାବଳୀ ବୀଣା ନାଦେ କୁତୂହଳୀ",
          "ପଳାଇ ଦୁରିତ ପାପ ପ୍ରଭୁ ମନ ଜାଣି କି"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ସେ କାଳେ କଳା ଶ୍ରୀମୁଖ ଶୁଣନ୍ତି ସକଳ ଦୁଃଖ",
          "ଦର୍ଶନେ ପ୍ରସନ୍ନ ହୋଇ ରଖ ଦୁଃଖୀ ଶ୍ରେଣୀକି"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଆର୍ତ୍ତେ ଶ୍ରୀଚନ୍ଦନ ଭାଷେ ଚିନ୍ତାବଳୀ ମଧ୍ୟେ ଭାସେ",
          "କରୁଣା ନାବେ ବସାଇ କୂଳେ ରଖ ଆଣିକି"
        ]
      }
    ]
  },
  "sources": [
