{
  "id": "oa-gita-001235",
  "name": {
    "en": "Ati durmada kapi dwibinda",
    "or": "ଅତିଦୁର୍ମଦ କବି ଦ୍ୱିବିନ୍ଦ"
  },
  "composer": "oa-person-000150",
  "mula_raga": [
    "oa-raga-000141"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ati-durmada-kapi-dwibida-balabhadra-bijaya-prabandha-kabiratna-narayana-misra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଳଭଦ୍ରବିଜୟପ୍ରବନ୍ଧ, ଭୈରବରାଗେଣ",
          "ଅତିଦୁର୍ମଦ କବି ଦ୍ୱିବିନ୍ଦ ଦେଖିଣ ହଳପାଣି",
          "ଝଟିତି ଟାଣ ମୁଷ୍ଟି କରିଣ ମାରିଲେ ତାକୁ ଜିଣି । ପ୍ରଥମଃ ଖଣ୍ଡଃ ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାମ ବେଗେ ଶ୍ରମେ ଆକୁଳ କରୋତେ ମଧୁପାନମ୍",
          "ବଦତେ ଦେହି ଦେହି ନିରମ କହତ ଅନୁଆନମ୍ । ଉଚ୍ଚଖଣ୍ଡୋ ଧ୍ରୁବଃ ।"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସା ସା ସା ରି ଗ ମ ନି ଧ ନି ଗ ଧ ମ ପ ଧ ନି ସା ନି ସା ରି",
          "ତି ଥୋ ଗିଟନା କୁ ରଞ୍ଚ କିଟ ତେନ ତେନା ନା ତେ ନା ତେ ନ୍ନାମ୍ । ଆଭୋଗଃ ।"
        ]
      }
    ]
  },
