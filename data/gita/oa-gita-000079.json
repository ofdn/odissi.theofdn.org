{
  "id": "oa-gita-000079",
  "name": {
    "en": "Chahan kunjare syama",
    "or": "ଚାହାଁ କୁଞ୍ଜରେ ଶ୍ୟାମ"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-kunjare-syama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁ କୁଞ୍ଜରେ",
          "ଶ୍ୟାମ କଞ୍ଜଚରଣ ନୂପୁର ।",
          "ପୁଞ୍ଜଧ୍ୱନି ଗୁଞ୍ଜଇ । ସେ ସ୍ୱର ଜନମନ ରଞ୍ଜଇ ।",
          "ନାଚେଣ ଧ୍ରୀମି ଧ୍ରୀମି ଧ୍ରୀମି ତା ଧ୍ରୀମି ଝେଣା",
          "ଝେଣା ତା କିଣା ଝେଣା ଧେକୃ ଧିନ୍ଦା ତା ଝେଣା ଝେଣା",
          "ମତ୍ତମାତଙ୍ଗ ଗତି ସତୀଧୃତି ଟାଳଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲାବଣ୍ୟଭୂତି ସଞ୍ଚିତଜ୍ୟୋତି",
          "ନିନ୍ଦିତ କୋଟି କାମକୁ ।",
          "ମଣ୍ଡିତ ଘନସାର ଚନ୍ଦନ ମୋହିତ କୁଞ୍ଜଧାମକୁ ।",
          "ତା ଝେଣାମ ତା ଝେଣାମ ତା ଖୁ ଖୁନ୍ଦାରି ଝେଣାକିଣା",
          "(ପଡ଼ି)",
          "ପହପଟ ତ୍ରିପଟା ଝୁଲା ଝମ୍ପାଦି ମଠା",
          "ତାଳେ ତାଳେ ନାଚଇ ଭାଙ୍ଗି ମୟୂରଜଟା",
          "ସେ ନନ୍ଦଚାଟ ନଟରାଜ ଶଠମୁକୁଟ",
          "କଟିତଟେ ପୀତପଟ କରା ଆପଟ",
          "ଛଟକେ ହାଟକଦେହା ପାଟକ ତେଜଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଙ୍ଗେ ରାଜିତ ବ୍ୟଙ୍ଗେ",
          "ସଙ୍ଗେ ଗୋପାଳବାଳକ ।",
          "ଘଞ୍ଚ ସୁସଞ୍ଚ ପରପଞ୍ଚ ପଞ୍ଚଶାୟକ ।",
          "ପାଞ୍ଚି ନେତ୍ରାଞ୍ଚି ଆମଞ୍ଚେ ମଞ୍ଚନାୟକ ।",
          "(ପଡ଼ି)",
          "କୁଞ୍ଜକାନନୁ ଧନୀ ଖଞ୍ଜେ ଗଜଗାମିନୀ",
          "ବଞ୍ଚିବାର ସରଣୀ ପାଞ୍ଚ ଆଉ ଯାମିନୀ",
          "କାଳୀୟ ନାଗଦଳା ଦଳାଯାମିନୀ ଟଳା",
          "ବାଳକ କାଳେ ଛଳେ ସାରି ଅସୁରବାଳା",
          "ପଳା ପଳା ଖଞ୍ଜନଡୋଳା ଆଉ ନ ଖେଳା"
        ]
      }
    ]
  },
