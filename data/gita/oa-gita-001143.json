{
  "id": "oa-gita-001143",
  "name": {
    "en": "Sri goura chandra pada",
    "or": "ଶ୍ରୀ ଗୌରଚନ୍ଦ୍ର ପଦ ବନ୍ଦରେ ମାନସ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-gourachandra-pada-banda-re-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ରୀ ଗୌରଚନ୍ଦ୍ର ପଦ ବନ୍ଦରେ ମାନସ",
          "ଏ ଏକା ଶ୍ରୀ ରାଧା ଗୋବିନ୍ଦ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବ୍ରଜବିଧୁ ଶ୍ରୀମତୀ ହୋଇ ଗୋଟିଏ ମୂର୍ତ୍ତି",
          "ଜନ୍ମିଛନ୍ତି ଶ୍ରୀ ଶଚୀ ଉଦରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ୱ ସ୍ୱ କଳ୍ପନା ବିଧି ଦୟା ସଦ୍‌ଗୁଣ ନିଧି",
          "ସଦା ବେଷ୍ଟିତ ଭକ୍ତବୃନ୍ଦ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମହା ଭାବ ଉଜ୍ଜ୍ୱଳ ରସ ପୀତି ଶ୍ୟାମଳ",
          "ପର ତତ୍ତ୍ୱ ହେଲାର ଦ୍ୱନ୍ଦ୍ୱ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଗ ନେତ୍ର ସମ୍ପତ୍ତି ବଦାନ୍ୟ ଚକ୍ରବର୍ତ୍ତୀ",
          "ଯା ନାମାମୃତ ସର୍ବସ୍ୟନ୍ଦ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏ କୃପା ପାରାବାର ପ୍ରତ୍ୟକ୍ଷ ହୋଇବାର",
          "ଦେଖିଛନ୍ତି ଶ୍ରୀ ରାମାନନ୍ଦ ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭଣେ ଶ୍ରୀନାମ ଅନୁକ୍ଷଣେ",
          "କୀର୍ତ୍ତନ କରୁଥା ଆନନ୍ଦରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-gourachandra-pada-banda-re-gopalakrusna/"
    }
  ],
