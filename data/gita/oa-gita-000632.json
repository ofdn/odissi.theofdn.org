  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000002",
    "section": {
      "en": "Sa Patala",
      "or": "ସ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-na-basa-go-tu-gumane-mangala-gujjari-kabisurjya-premodaya-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖି ନ ବସ ଗୋ ତୁ ଗୁମାନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶୁଣି ଶ୍ୟାମ ତୋର ବାଣୀ ପ୍ରାଣ କଣ୍ଠତଟେ ଆଣି",
          "ରଖିଲା ପରିରେ ଦିଶେ ଅନୁମାନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶରଦ ଚନ୍ଦ୍ରମା ମୁଖୀ କର ତୁ ଶ୍ୟାମକୁ ସୁଖୀ",
          "ଅଧର ମଧୁର ସୁଧା ରସପାନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶପତ କଲାଣି ବେଣୁ ଛୁଇଁ ତ ନୀରଦ ତନୁ",
          "ମନେ ହେଲେ ନ ରସିବି ବୋଲି ଆନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସହି ରେ ତୁ ଦୟାବତୀ ବୋଲାଇ ନିଷ୍ଠୁର ଅତି",
          "ହେବାର ଆଜ ଗୋ ଘେନ ତୋତେ ଯେ ନ ମାନେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସହରଷେ ରାଜଇନ୍ଦୁ ଭଣଇ ସେ ପ୍ରାଣବନ୍ଧୁ",
          "କର କରୁଣାକୁ ଦିବ୍ୟ ଅବଧାନେ"
        ]
      }
    ]
  },
