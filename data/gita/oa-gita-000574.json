{
  "id": "oa-gita-000574",
  "name": {
    "en": "Go jemadei ki suniba suna mana dei",
    "or": "ଗୋ ଜେମାଦେଈକି ଶୁଣିବ ଶୁଣ ମନ ଦେଈ ଗୋ । ଘୋଷା । ଯାହା କରେ ନନ୍ଦ ଚାଟ ଗୋପୋଥିଟାକର ପାଠଭଲା ଯଶୋବନ୍ତୀ ଜଞ୍ଜାଳ ସହନ୍ତିନ ପାରି କରି ଆକଟ ଗୋ । ୧ । ହାଟ ବାଟ ଘାଟ ଜଗା ଗୋହଟିଆ ଲବଣୀ ମଗାଯମୁନା ନଈରେ ନାବକେଳି କରିଦିନେ ଦେଇଥିଲା ଦଗା ଗୋ । ୨ । ଛଇଳ ନାଗର ହରି ଗୋକରେ କେତେ ହୁରିଜୁରିଗୋଦୋହନ ବେଳେ ଲୁଚି ରହି ହେଳେଫିଟାଇ ଦିଏ ବାଛୁରୀ ଗୋ […]"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000151"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/go-jemadei-ki-suniba-suna-mana-dei/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୋ ଜେମାଦେଈ",
          "କି ଶୁଣିବ ଶୁଣ ମନ ଦେଈ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାହା କରେ ନନ୍ଦ ଚାଟ ଗୋ",
          "ପୋଥିଟାକର ପାଠ",
          "ଭଲା ଯଶୋବନ୍ତୀ ଜଞ୍ଜାଳ ସହନ୍ତି",
          "ନ ପାରି କରି ଆକଟ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହାଟ ବାଟ ଘାଟ ଜଗା ଗୋ",
          "ହଟିଆ ଲବଣୀ ମଗା",
          "ଯମୁନା ନଈରେ ନାବକେଳି କରି",
          "ଦିନେ ଦେଇଥିଲା ଦଗା ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଛଇଳ ନାଗର ହରି ଗୋ",
          "କରେ କେତେ ହୁରିଜୁରି",
          "ଗୋଦୋହନ ବେଳେ ଲୁଚି ରହି ହେଳେ",
          "ଫିଟାଇ ଦିଏ ବାଛୁରୀ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଅଁଳା ପୁଅଟି ଦିନୁ ଗୋ",
          "କେତେ ରସ ଜାଣେ କାହ୍ନୁ",
          "ଗୃହ କର୍ମ ଛଳେ ପାଶୋରି ବସିଲେ",
          "ତା କଥା ନ ଯାଏ ମନୁ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବନମାଳୀ ରସେ କହି ଗୋ",
          "କାଳିଆ କଳଙ୍କ ସେହି",
          "ତାହା ସଙ୍ଗେ ଯେହୁ ପୀରତି କରିବ",
          "ମରିବ ଜହର ଖାଇ ଗୋ"
        ]
      }
    ]
  },
