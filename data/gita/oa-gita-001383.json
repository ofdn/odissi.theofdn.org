{
  "id": "oa-gita-001383",
  "name": {
    "en": "Nanda sutanku ki achi",
    "or": "ନନ୍ଦସୁତଙ୍କୁ କି ଅଛି"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000078"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-sutanku-ki-achi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନନ୍ଦସୁତଙ୍କୁ କି ଅଛି ଉପମା ଦେବାକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଂସାର ସାର ଶିରୀ ଯା ଅଙ୍ଗେ ଅଛି ପୂରି",
          "ନିନ୍ଦୁଛି କୋଟି ମଦନକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭଲା ତା ଠିଆ ଠାଣି ପାଷାଣ କରେ ପାଣି",
          "ଦେଖି କେ ରହିବ ଦମ୍ଭକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଲ୍ଲୀ ସେବତୀ ବେଢ଼ା ଶିଖୀଚନ୍ଦ୍ରିକା ଚୂଡ଼ା",
          "ନାଶୁଛି ସତୀ ବରତକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୁରଲୀ ଧରି କରେ ଦେଇ ବିମ୍ବ ଅଧରେ",
          "ମୋହୁଛି ତିନି ଭୁବନକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚାରୁ ଚନ୍ଦନ ପାଟି ଆହା କି ପରିପାଟୀ",
          "ଚାହାଁ ତା ଭ୍ରୂଲତା ନାଟକୁ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ସ୍ମିତ ମଧୁର ହାସ ତହିଁ ନେତ୍ର ବିଳାସ",
          "ଶିଖାଏ ପୀରତି ପାଠକୁ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କହଇ ବେଣୁଧର ଚିତ୍ତ ସମ୍ପତ୍ତି ଚୋର",
          "ରଖିବ କାହା ଗୁମାନକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-sutanku-ki-achi/"
    }
  ],
