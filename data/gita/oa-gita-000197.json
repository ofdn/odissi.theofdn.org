{
  "id": "oa-gita-000197",
  "name": {
    "en": "Kaha ki karibi",
    "or": "କହ କି କରିବି"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-ki-karibi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ କି କରିବି",
          "ବୁଦ୍ଧି ଦିଶୁନାହିଁ ଗୋ ପ୍ରିୟସହି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନାହିଁ ତ ମୋଠାରୁ ଦୁଃଖୀ । କେଉଁ ଦୋଷ ମୋର ଦେଖି ।",
          "ରହିଲେ ବନ୍ଧୁ ଉପେକ୍ଷି । ମନ କେ ମୋହିଲା ସଖୀ ।",
          "ତା ପୀରତି । ଫାନ୍ଦରେ ପକାଇ ଗୋ ପ୍ରିୟସହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶେଯାଇ କୁସୁମ ଶେଯ । ସିଞ୍ଚି ତହିଁ ବିଧୁରଜ ।",
          "କୁଞ୍ଚି ଝୀନବାସ ଆଜ । ସଞ୍ଚିଲି ବରଜି ଲାଜ ।",
          "ମୁଞ୍ଚି ମୋତେ । ଘୁଞ୍ଚିଲେ କିପାଇଁ ଗୋ ପ୍ରିୟସହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆସିବେ ବୋଲି ନାଗର । ମଣ୍ଡିଥିଲି କେଳିପୁର ।",
          "ଜାଳିବସିଲି ଜାଗର । ନିଶି ହୋଇ ଉଜାଗର ।",
          "ଶୋକଜଳେ । ଦେଲେ ସେ ଭସାଇ ଗୋ ପ୍ରିୟସହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଲି ତା ପ୍ରୀତିରେ ଆଶା । ଲଭିଲି ମୁଁ ଏତେ ଦଶା ।",
          "ନୟନ ତ ହେଲା କଷା । ହେଲା ଯା ଭଗାରିହସା ।",
          "ରସା ପରେ । ଅକୀର୍ତ୍ତି ବସାଇ ଗୋ ପ୍ରିୟସହି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀମତୀ ବିନୟ ଶୁଣି । ଦୂତୀ ଭାଷେ ପ୍ରୀତି ବାଣୀ ।",
          "ତେଜ ବିମନ ରମଣୀ । ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ ଭଣି ।",
          "ଭେଟାଇବି । ସନ୍ତାପ ତୁଟାଇ ଗୋ ପ୍ରିୟସହି"
        ]
      }
    ]
  },
