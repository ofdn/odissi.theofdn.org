{
  "id": "oa-gita-000296",
  "name": {
    "en": "Mana kari mohanaku rahibu ki",
    "or": "ମାନ କରି ମୋହନଙ୍କୁ ରହିବୁ କି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000091"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-kari-mohanaku-rahibu-ki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନ କରି ମୋହନକୁ ରହିବୁ କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବେନୁ ବାଇ ବୃନ୍ଦାବନୁ । ଧେନୁ ଘେନି କଳାକାହ୍ନୁ ।",
          "ଆସନ୍ତେ ପାସୋରି ମନୁ ରହିବୁ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଖାମଣ୍ଡଳୀ ମଧ୍ୟରେ । ନାଚିବାର ଧୀରେ ଧୀରେ ।",
          "ଦେଖି ଝୁଲ ନୋହି ତୁହି ରହିବୁ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯମୁନା ପାଣିକି ଥରେ । ନ ଯିବୁ କି ସେ ପଥରେ ।",
          "ଚାହିଁ ନୀପମୂଳେ ସହି ରହିବୁ କି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ନିବେଦନ । ଘନଶ୍ୟାମେ ନୁହଁ ବାମ ।",
          "ମନରୁ ନ ତେଜି ମାନ ରହିବୁ କି"
        ]
      }
    ]
  },
  "sources": [
    {
