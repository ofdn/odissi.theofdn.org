{
  "id": "oa-gita-000884",
  "name": {
    "en": "Suna barana banchi pare ki",
    "or": "ସୁନା ବରନା ବଞ୍ଚି ପାରେ କି"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000084"
  ],
  "mula_tala": [
    "oa-tala-000016"
  ],
  "kabya": {
    "id": "oa-kabya-000007"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/suna-barana-banchi-pare-ki-panchama-baradi-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସୁନା ବରନା ବଞ୍ଚି ପାରେ କି",
          "ଏକା ହୋଇ ମୋ ବିନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋ ସଙ୍ଗ ଅନ୍ତର ଲବେ କଳ୍ପ ଯାର",
          "ବିଚାର ହୁଅଇ ଏବେ ମୋତେ",
          "ତେଜି ଏ ଘୋର ଦୁର୍ଦ୍ଦିନେ ମୋହର ସଖୀ ଜୀବନେ",
          "କେସନେ ରହିବ ଏ ମୋ ଭାବନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଧୁବାତ ଶୁକ ଶାରୀ ଭୃଙ୍ଗ ପିକ",
          "ସେନା ସାହା ଘେନି ମାରବୀର",
          "ପାଶେ ନ ଥିବାରୁ ମୁହିଁ ଏକଲା ବାଳାକୁ ଚାହିଁ",
          "ଚଣ୍ଡକାଣ୍ଡେ ଦେଉଥିବ ଯାତନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଧୁମାଳତୀ କୁସୁମ ସଙ୍ଗତି",
          "ଦେଖି କାମୋନ୍ମାଦେ ମୋତେ ଧ୍ୟାଇ",
          "ଉଠି ଶୂନ୍ୟେ କୋଳ କରି ଦେହୁଁ ଜ୍ଞାନ ଥିବ ହାରି",
          "ରସାରେ ପଡ଼ି ହୀରକ ରଦନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସହଚରୀ ବୃନ୍ଦ ଧନୀର ଏ ମନ୍ଦ",
          "ଦଶା ଦେଖି ରଖିବେ କି ପ୍ରାଣ",
          "ଚିନ୍ତାମଣିକି ମୁଁ ବାଇ ଅଖଡ଼େ ଦେଲି ହରାଇ",
          "ଛାଡ଼ି ଅଇଲି ଯା ଚନ୍ଦ୍ରବଦନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବିହି ହେଲା ପର ହେଲି ନାରଖାର",
          "ଆଉ ମହୀରେ ଥିବି କାହିଁକି",
          "କି କାର୍ଯ୍ୟ ଏ ବୃନ୍ଦାବନ ତେଜିବି ଛାର ଜୀବନ",
          "ଯଦି ତେଜିଲି ବିକ୍ରମ ବନ୍ଦନା"
        ]
      }
    ]
  },
