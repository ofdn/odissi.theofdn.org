{
  "id": "oa-gita-001320",
  "name": {
    "en": "Kede chhanda jane lo sahi",
    "or": "କେଡ଼େ ଛନ୍ଦ ଜାଣେ ଲୋ ସହି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000112"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kede-chhanda-jane-lo-sahi-banamali-misra-mukhari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଡ଼େ ଛନ୍ଦ ଜାଣେ ଲୋ ସହି",
          "ନନ୍ଦ ରାଜାର ଟିକି ପିଲାଟି",
          "ଟିକି ପିଲା ବୋଲି ଯାହାକୁ ବୋଲନ୍ତି",
          "ଚିରି ପକାଇଲା ବକାର ପାଟି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜନମ କାଳେ ଏନ୍ତୁଡ଼ିଶାଳେ",
          "କୁଆଁ କୁଆଁ ହୋଇ ରାବିଲା ଛଳେ",
          "ରହିଣ କୋଳରେ କ୍ଷୀର ସହିତରେ",
          "ପୂତନା ଅସୁରୀ ପ୍ରାଣ ନେଲାଟି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ କରି ଦକା ନାଶିଲା ଶଙ୍କା",
          "ଚନ୍ଦନ ପାଟିଆ ଚିତ୍ତ ଚମକା",
          "ଶକଟା ଧେନୁକା ବକା ଦର୍ପ ଦଳି",
          "ବନର ଅନଳ ଗିଳି ଦେଲାଟି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଇନ୍ଦ୍ର ବିବାଦେ ନିର୍ଘାତ ନାଦେ",
          "ଶିଳା ବରଷିଲା ଅତି ପ୍ରମାଦେ",
          "ଦେଖିଛ ତ ହାଦେ ବିନା ଅବସାଦେ",
          "ମନ୍ଦର ଗିରିକି ଟେକି ଥିଲାଟି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସ୍ନାହାନ କାଳେ ଯମୁନା ଜଳେ",
          "ନନ୍ଦ ବୁଡ଼ିଗଲେ ବୋଲି ଅଥଳେ",
          "କଉତୁକ କରି ତାହାଙ୍କୁ ଉଦ୍ଧରି",
          "ଗୋପରେ ପତାକା ଉଡ଼ାଇଲାଟି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେଦିନ କଂସ ହୋଇଣ ରୋଷ",
          "ଲକ୍ଷେ ପଦ୍ମ ପାଇଁ ଦେଲା ଆଦେଶ",
          "ପଦ୍ମତୋଳା ରସ କରିଣ ପ୍ରକାଶ",
          "ବଳେ ଛଳି କାଳୀ ଦଳି ଦେଲାଟି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବିସ୍ତାରି ପାଟି ଖାଇଲା ମାଟି",
          "ମାଆ ଯଶୋବନ୍ତୀ ଛାଟରେ ପିଟି",
          "ଆକଟନ୍ତେ ଥରେ ତା ପେଟ ଭିତରେ",
          "ଅଶେଷ ବ୍ରହ୍ମାଣ୍ଡ ଦେଖାଇଲାଟି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କେ ଜାଣେ ଲୋ ମା ତାହାର ମହିମା",
          "ବତ୍ସା ହରିନେଲା ସେ ବେଦ ବ୍ରହ୍ମା",
          "କହେ ବନମାଳୀ ତାକୁ ପୁଣି ଛଳି",
          "ଲକ୍ଷେ ଧେନୁ ବତ୍ସା ଜାତ କଲାଟି"
        ]
      }
    ]
  },
  "sources": [
