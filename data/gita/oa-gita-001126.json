{
  "id": "oa-gita-001126",
  "name": {
    "en": "Nanda nayana indibara indu",
    "or": "ନନ୍ଦ ନୟନ ଇନ୍ଦୀବର ଇନ୍ଦୁ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-nayana-indibara-indu-gopalakrusna-chokhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନନ୍ଦ ନୟନ ଇନ୍ଦୀବର ଇନ୍ଦୁ ତୋ ଲାଗି",
          "ଯୋଗୀ ହୋଇଗଲା ପରି ଦିଶୁଛି ଭଙ୍ଗୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀଅଙ୍ଗରେ ବିନ୍ୟାସି ଛନ୍ଦ ଦେବତା ଋଷି",
          "ବୁଜି ଈକ୍ଷଣ ହେଉଥିଲେ ଓଳଗି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚିତ୍ତେ ଚିନ୍ତି ତୋ ରୂପ ତୋ ନାମ କରି ଜପ",
          "ନିଭୃତ ନିକୁଞ୍ଜରେ ଅଛନ୍ତି ଜଗି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ବୋଲି କହିବି ମୁଁ ବିବେକରେ ଜାଣିମୁ",
          "ସାଜ ସଜ ଏ ବେଶ ହୁଅ ଉଲାଗି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମସୃଣ ସୁଘୃଣ୍ଟି ତନୁରେ ବିଭୂତିଟି",
          "ବାରଣ ହେଉ ନାହିଁ ଶିରୀଷ ଅଙ୍ଗୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦେଇଛନ୍ତି ଶ୍ରୀକର ଲେଖ ଦେଖ ସତ୍ୱର",
          "ଉଠ ମଠ ନ କର ପରାଣ ସଙ୍ଗୀ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ବୋଲେ କୃଷ୍ଣ ପାଶେ ମିଳିଲେ",
          "ପ୍ରିୟ କଲାର ଦୋଷ ପଛକୁ ଫିଙ୍ଗି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nanda-nayana-indibara-indu-gopalakrusna-chokhi/"
    }
  ],
