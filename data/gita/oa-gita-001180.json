{
  "id": "oa-gita-001180",
  "name": {
    "en": "Radhika adhika premare kahi",
    "or": "ରାଧିକା ଅଧିକା ପ୍ରେମରେ କହି"
  },
  "composer": "oa-person-000146",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhika-adhika-premare-kahi-bahadur-prataparudra-singha/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "(ରସକୁଲ୍ୟା ବାଣୀ)",
          "ରାଧିକା ଅଧିକା ପ୍ରେମରେ କହି",
          "ସଂସାରର ସାର ରୂପ ଏହି",
          "ସର୍ବ ଉପମା ଛାଣି ଛାଣି ଆଣି ବିହି",
          "ଏ ଲାବଣ୍ୟପୁର ନିର୍ମ୍ମାଣି ଯେ",
          "କରିଛି ନୟନ କାରା ଯେ",
          "ଚିତ୍ରବ୍ୟାଜ ଚିତ୍ର ପ୍ରକାଶିତ ନେତ୍ର",
          "ସୁଖ ପାଇ ପଡ଼ି ଧରା ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରୂପାସ୍ତ୍ରପଣ ମାର ଠାରେ ଥିଲା",
          "ବିହି ତହିଁରୁ ସିଦ୍ଧି ନ ପାଇଲା",
          "ଏବେ ଏହାକୁ ତା ଦେଇଛି ଦେଖ",
          "ଭ୍ରୂଲତା ଧନୁ ନେତ୍ର ଶିଳୀମୁଖ ସେ",
          "ନାସିକା ତୂଣୀର ସତ ଯେ",
          "ଚନ୍ଦ୍ରହାସ ଧରି ଦିଶୁଛି ମାଧୁରୀ",
          "ନିଶ୍ଚୟ ନେତ୍ରାନ୍ତ କୁନ୍ତ ଯେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାଦେ ଜିଣି ଏ ଅଶ୍ୱିନୀ କୁମାର",
          "ବଳେ ଆଣିଛି ସର୍ବାଙ୍ଗ ସୁନ୍ଦର",
          "ଭୃଙ୍ଗ ଘନସାର ନିଶ୍ଚୟ ଏହି",
          "ଚପଳାକ୍ଷ କୃଷ୍ଣ ପୁଷ୍କର ସହି ଗୋ",
          "ବିଶ୍ୱଧାତ୍ରୀ ଶ୍ରୀୟେ ଦେଖ ଗୋ",
          "ଦେହ ଦାହ ରୋଗ ନାଶ କରି ବେଗ",
          "ସ୍ନେହୀ ଜନେ ଦେବ ସୁଖ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପୂର୍ଣ୍ଣମା ଚନ୍ଦ୍ର ଶିରୀ ବଳେ ହରି",
          "ସକଳ ଲକ୍ଷଣେ ଦିଶେ ମାଧୁରୀ",
          "ଶ୍ୟାମା ସୁଖ ମଣ୍ଡେ ଉଦୟ ଯାର",
          "ହରିତ ଅମ୍ବରେ ଦିଶେ ରୁଚିର ଗୋ",
          "ଚକ୍ଷୁ ଚକୋରକୁ ତୋଷି ଗୋ",
          "କର ସ୍ପରଶରେ ଏ ଅନାୟାସରେ",
          "ତାପକୁ ଦେବ ବିନାଶି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhika-adhika-premare-kahi-bahadur-prataparudra-singha/"
    }
  ],
