    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖ ବସନ୍ତ କାଳ",
          "ସଜନୀ ଆହା କି ମଞ୍ଜୁଳ ।",
          "ମଳୟ ପବନେ ମଧୁପ ଗୁଞ୍ଜନେ କୁଞ୍ଜକାନନେ",
          "ମଧୁମୟ ବେଶେ ସାଜି ସୁମାନସେ",
          "ଆସ ଗୋ ଚଞ୍ଚଳ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋହନ ବଂଶୀ ପଞ୍ଚମ ତାନେ",
          "ବାଜେ ସଘନେ",
          "ପରଶି ମରମେ ମନ ବଳୁଥିବ ଗୋ",
          "ମୋହନ ଧିଆନେ",
          "ଆଉ କଲେ ହେଳା ବୁଡ଼ିବଟି ଭେଳା",
          "ଧର ବରଣମାଳା",
          "ଭଣଇ ତାରିଣୀ ନୋହି ତୁ ମାନିନୀ",
          "ନିଧୁବନେ ଚାଲ"
        ]
      }
    ]
  },
