{
  "id": "oa-gita-000557",
  "name": {
    "en": "Braja jana netra sampatti",
    "or": "ବ୍ରଜ ଜନ ନେତ୍ର ସମ୍ପତ୍ତି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/braja-jana-netra-sampatti-gopalakrusna-kalyana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବ୍ରଜ ଜନ ନେତ୍ର ସମ୍ପତ୍ତି",
          "ହା ନିଭୃତ କୁଞ୍ଜ ଗୃହ ଦମ୍ପତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିବ୍ୟ ରତ୍ନପୀଡ଼ ପକାଇ",
          "ଗୋଷ୍ଠେନ୍ଦୁଙ୍କୁ ବିଜେ କରାଇ",
          "ନେଇ ବାଢ଼ିବାର ସୁବର୍ଣ୍ଣ ପାତ୍ରରେ",
          "ସୁଧାସ୍ୱାଦୁ ଭୋଜ୍ୟ ହା ରସବତୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରୁ ଜୀବବନ୍ଧୁ ଅଶନ",
          "ହା ହା ସେ କାଳର ପ୍ରସନ୍ନ",
          "ରସବତୀ ଦ୍ୱାର ପାଶୁଁ ଚଳିବାର",
          "ତେଜ କରିବାକୁ ଛାମୁର ବତୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହେଉ ଏକା ଚାରି ନୟନ",
          "ଲାଜ ହାସ ଭୂରୁ କୁଞ୍ଚନ",
          "ବେନି ବଦନ ହା ହା କି ସେ ଶୋଭନ",
          "ହେଉ କୁହାକୁହି ଧୀର ଭାରତୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପରିବେଷଣ ଚମତ୍କାର",
          "ଚାହିଁ ରମା ଉମା ବଧୂର",
          "ଭାଙ୍ଗିଯିବ ସେହିକ୍ଷଣି ପୁରାତନ",
          "କୁଟୁମ୍ବିନୀ ନିପୁଣତା ଉନ୍ନତି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଶନାନ୍ତରେ ଆଚମନ",
          "ଦେଇ ପୋଛିବାକୁ ବଦନ",
          "ନିଜ ଚେଳାଞ୍ଚଳ ବଢ଼ାଇ ଦେବାର",
          "ତ୍ରିଭୁବନ ଶୂନ୍ୟ ପ୍ରଣୟ ରୀତି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପଲଙ୍କରେ ପ୍ରିୟ ଅଙ୍କରେ",
          "ବସି ତାମ୍ବୁଳ ଘେନି କରେ",
          "ଭାଙ୍ଗି ପ୍ରାଣନାଥ ମୁଖେ ଦେବା ଶୋଭା",
          "ଆହା ସେ ସଙ୍କଳ୍ପ ସିଦ୍ଧ ମୂରତି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଆସି ଆପଣାର ଆଳିଙ୍କି",
          "ଡାକି ବସାଇ ମଣୋହିକି",
          "କାନ୍ତ ଅବଶିଷ୍ଟ ଅଶନରୁ ଜାତ",
          "ହରଷ ଧରିବ କି ବସୁମତୀ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କେତେ ଦିନର ମନୋରଥ",
          "ଆଜ ହୋଇଲା ଯେ ସେ ସାର୍ଥ",
          "ବୋଲୁ ଲଳିତା ହୃଦେ ରାଧା ଆଉଜି",
          "ଲାଜେ ବସିବାର ବଦନ ପୋତି"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଅଦ୍ୱିତୀୟ ପରମ ତତ୍ତ୍ୱ",
          "ପରମାନନ୍ଦ ସାର ତତ୍ତ୍ୱ",
          "ନିତ୍ୟ ସନାତନ ସର୍ବଦା ନୂତନ",
          "ବୃନ୍ଦାଟବୀ ପ୍ରାଣ ପ୍ରେମ ବସତି"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଆଳୀ ସହ ସାରି ଭୋଜନ",
          "ଆଚମନ ତାମ୍ବୁଳାଶନ",
          "ଶ୍ୟାମ ଛାମୁକୁ ଶ୍ରୀମତୀ ସ୍ୱ ସ୍ୱ କୁଞ୍ଜକୁ",
          "ଯିବାର ସଖୀ ସଂହତି"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ତା ଯାକ ଗୋପାଳକୃଷ୍ଣର",
          "କେବେ ହେବି ଦୃଷ୍ଟିଗୋଚର",
          "ଶ୍ରୀ ରୂପମଞ୍ଜରୀ ଦେବେ କୃପା କରି",
          "ସେ ଅବଶେଷ ଲଭିହେବ ତୃପ୍ତି"
        ]
      }
    ]
  },
  "sources": [
