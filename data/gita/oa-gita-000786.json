{
  "id": "oa-gita-000786",
  "name": {
    "en": "Muruchi dei kanhu",
    "or": "ମୂରୁଛି ଦେଇ କାହ୍ନୁ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000079"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/muruchi-dei-kanhu-jayanta-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୂରୁଛି ଦେଇ କାହ୍ନୁ ଆମ୍ଭମାନଙ୍କୁ ମନୁ",
          "ସତେ ଯିବକି ମଧୁପୁରକୁ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେ ଆଉ ଗୋବର୍ଦ୍ଧନ ତୋଳି ରଖିବ ପ୍ରାଣ",
          "ବାଦେ ହଟାଇ ସୁନାଶିରକୁ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନେଉଅଛି ଧରାଇ ତିଳେ ବିଶ୍ୱାସ ନାହିଁ",
          "ସେ ନିଦାରୁଣ କଂସାସୁରକୁ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେତେ କେତେ ବିପଦୁଁ ଉଦ୍ଧରିଲ କା ବାଦୁଁ",
          "ଏ ଗୋପପୁରେ ଥରଥରକୁ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହଇ ବନମାଳୀ ଗୋପୀ ନେତ୍ରସଙ୍ଖାଳି",
          "କଥା ଯାଉଛି କେତେ ଦୂରକୁ ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
