{
  "id": "oa-gita-000824",
  "name": {
    "en": "Asibe para kunje sikhanda",
    "or": "ଆସିବେ ପରା କୁଞ୍ଜେ ଶିଖଣ୍ଡ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asibe-para-kunje-sikhanda-mukhari-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସିବେ ପରା କୁଞ୍ଜେ ଶିଖଣ୍ଡଝରା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଫୁଟିଲା ମାଳତୀ କଦମ୍ବ ସେବତୀ",
          "ନାଚିଲେ ବରହୀ ଷଡ଼ଜ ଭାଷେ",
          "ଚପଳା ଚମକେ ଘନ ଗୁରୁ ଡାକେ",
          "ଧାରା ଶିରାବଣ ବାରି ବରଷେ",
          "ଡାକେ ଡାହୁକ ମକ ମକ ମକ",
          "ନାଗରା ବାଇଲା ଧଇବତେ ଭେକ",
          "କୁଞ୍ଜଭରେ ଫୁଲ ସୁମନ ମହକ",
          "ଆଣ ଯା ସଖୀ ରାଇ ମନ ଚୋରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଜାଅ ସଜନୀ ଦୋଳା ଅନୁପମ",
          "ଗାଅ ଗୋ ମଙ୍ଗଳ ଗୀତ ସୁମନେ",
          "ନବ ନୀଳ ଘନେ ଚପଳା ସମାନେ",
          "ଶ୍ୟାମ କୋଳେ ରାଇ ଖେଳୁ ଯତନେ",
          "ହେରି ଶିରି ଝୁରି ଝୁରି ରତି ମରୁ",
          "ସାରି ଦେଉ ମନସିଜ ମନ ଗରୁ",
          "କୋଟି ଶଶୀଜିତ ଦ୍ୱନ୍ଦ୍ୱ ପଦୁ ଝରୁ",
          "କବିଚନ୍ଦ୍ର ଶିରେ ମକରନ୍ଦ ଝରା"
        ]
      }
    ]
  },
