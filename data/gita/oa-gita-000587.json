{
  "id": "oa-gita-000587",
  "name": {
    "en": "Ehi katha ti asara",
    "or": "ଏହି କଥାଟି ଅସାର"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ehi-katha-ti-asara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏହି କଥାଟି ଅସାର",
          "ହରଷ ବେଳେ ତୋହର",
          "ତୁଷାର ମୟୂଖ ମୁଖୀ ପ୍ରାଣେଶଙ୍କ",
          "ଅଙ୍କେ ବସି ରୁଷିବାର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚତୁର ସୁନ୍ଦର ମୋହନ",
          "ହେଲା ଉତ୍ତାରୁ ତୋ ସ୍ୱାଧୀନ",
          "ପର ପରାୟରେ ରହି ଯାଇ ନୀର",
          "ନୟନୁ ବୁହାଇବାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ ଦେଖିଣ ଲଭିଣ ଦୁଃଖ",
          "ଲୋଡ଼ୁଥାଉ ତୋ ସଙ୍ଗ ସୁଖ",
          "ପାଶକୁ ଆସିଲେ ମୁଖକୁ ନ ଚାହିଁ",
          "ନଖେ କ୍ଷିତି ଖୋଳିବାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆରେ ପ୍ରୀତି କଳପ ଲତା",
          "ତନ୍ୱାଙ୍ଗି ଚାତୁରୀ ପଣ୍ଡିତା",
          "ଦୋଷ ଥିଲେ ରୋଷ ବହିବାର ବିଧି",
          "ନିର୍ଦ୍ଦୋଷରେ ଦଣ୍ଡିବାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୋର ଅଭିପ୍ରାୟେ କଳ୍ପନା",
          "କରି ସୁବେଶକୁ ରଚନା",
          "ମିଳାଇବା ବେଳେ ଢୁଳା ଅଙ୍ଗି ଅଙ୍ଗ",
          "ଲୁଚାଇ ଲୁଚିଯିବାର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀ ବୀର ପ୍ରତାପ ନରେଶ",
          "ଭାଷେ ଆଳୀ ଭାବରେ ବଶ୍ୟ",
          "ହୋଇ ଶ୍ରୀ କିଶୋରୀ ଲାଜ ହରଷରେ",
          "ବଦନେ ବାସ ଦେବାର"
        ]
      }
    ]
  },
  "sources": [
