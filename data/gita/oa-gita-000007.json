  "name": {
    "en": "Braja chandrama tini loka sukha sima",
    "or": "ବ୍ରଜ ଚନ୍ଦ୍ରମା ତିନି ଲୋକ ସୁଖସୀମା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000004"
  ],
