    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବ୍ରଜ ଚନ୍ଦ୍ରମା ତିନି ଲୋକ ସୁଖସୀମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିରରେ ମୟୂର ପକ୍ଷୀ",
          "ଦେଖି ମନ ରହେ ଲାଖି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଧରେ ମୋହନ ବେଣୁ",
          "ଧେନୁ ଘେନି ଆସେ ବନୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲଲାଟେ ଚନ୍ଦନ ବିନ୍ଦୁ",
          "ନିନ୍ଦଇ ଯେ ପୂର୍ଣ୍ଣ ଇନ୍ଦୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଶ୍ୟାମ ତନୁ",
          "ଚିନ୍ତିଲେ ନ ଗଲା ମନୁ"
        ]
      }
    ]
  },
