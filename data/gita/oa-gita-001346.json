    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-na-chahan-na-dhana-kabichandra-mohanaa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁନା ଚାହାଁନା ଧନ ସେ କାଳିଆ ଠାଣିକି ରେ",
          "ଯୁବତୀ ଜୀବନ ଘେନା ବଙ୍କା ବଂଶୀପାଣିକି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାଣି ସେ ମୋହନୀ ଲଗା ଲମ୍ପଟିଆ ଘାଟଜଗା",
          "ବେଳ ଦେଖି ଦେବ ଦଗା ନ ରଖିବ ଆଣିକି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କବିଚନ୍ଦ୍ର ବୋଲ ଶୁଣ ଶିଖଣ୍ଡଚୂଳିଆ ଗୁଣ",
          "ଏକା ଦେଖି କୁଞ୍ଜବନେ ନିଏ ପରା ଟାଣିକି ରେ"
        ]
      }
    ]
  },
