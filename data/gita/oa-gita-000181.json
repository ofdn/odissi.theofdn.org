{
  "id": "oa-gita-000181",
  "name": {
    "en": "Ja’a ja’a ahe braja lampata nataraja",
    "or": "ଯାଅ ଯାଅ ଆହେ ବ୍ରଜଲମ୍ପଟ ନଟରାଜ",
    "alternates": [
      "Jaa Jaa Ahe Braja Lampata Nataraja",
      "Ja Ja Ahe Braja Lampata Nataraja"
    ]
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaa-jaa-ahe-braja-lampata-nataraja-malabagouda-jhampa-gourahari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯାଅ ଯାଅ ଆହେ ବ୍ରଜଲମ୍ପଟ ନଟରାଜ",
          "ଭୁଲି ଆସିଲକି ପଥ ଏ ନୁହେଁ କେଶର କୁଞ୍ଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେଡ଼େ ଭାଗ୍ୟ ଆଜ ଦିନ ଏଡ଼େ ସକାଳୁ ବଦନ ।",
          "ଦେଖିବା କ୍ଷଣି ନୟନ ସାର୍ଥ ହୋଇଗଲା ଜାଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିଶିଯାକ ଉଜାଗର ହୋଇ ଥିଲାକି ତୁମ୍ଭର ।",
          "ଘୁମାଉଛ ତ ନାଗର ପଡ଼ିବାକୁ ନାହିଁ ଡର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଲ୍ୟଙ୍କ ପରେ ସତ୍ୱର କ୍ଷଣେ ସୁଖେ ନିଦ୍ରା କର ।",
          "ଶ୍ରୀଅଙ୍ଗ ଶ୍ରମ ଶୀକର ହୋଇଯିବ ସବୁ ଦୂର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋ ପାଶେ ଆସିଲ ବୋଲି ଶୁଣିଲେ ସେ ଚନ୍ଦ୍ରାବଳୀ ।",
          "ଦୁଇ କୁଳରୁ ଉଚ୍ଛୁଳି ଯିବ ହେ ବ୍ରଜମଉଳି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନରେଶ ଗଉରଚନ୍ଦ୍ର ଗଜପତି କହେ ତାର ।",
          "ଦୁଃଖ ହେଲେହେ ଅପାର ବୁଡ଼ିବ ଭେଳା ତୁମ୍ଭର"
        ]
      }
    ]
  },
  "sources": [
    {
