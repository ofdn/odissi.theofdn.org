{
  "id": "oa-gita-000230",
  "name": {
    "en": "Ki hela re",
    "or": "କି ହେଲା ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ka Patala",
      "or": "କ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-hela-re-ka-champu-kabisurjya-saberi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ହେଲା ରେ କହିତ ନୁହଇ ଭାରତୀରେ",
          "କାଲି ଯା ଦୂରରୁ ଦେଖି କଳନା କଲା ମୋ ଆଖି",
          "କଳା ଇନ୍ଦୀବର ଆରତିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେଳି କଦମ୍ବ ଲତାର କୋଳେ କି ଶ୍ୟାମଳତାର",
          "ତେଜ ସେ ରବିସୁତାର ତୀରେ",
          "କମ୍ପି ମୋର କଳେବର ହୋଇଗଲା ଆରପାର",
          "ଯାହାକୁ ଡରଇ ତାର ତୀରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁସୁମ କୋଦଣ୍ଡ କାଣ୍ଡ କେତେ କରିଥିଲା ରୁଣ୍ଡ",
          "କର୍କଶ ନୋହିବା ଭାରତୀରେ",
          "କହୁଛି ବରଜି ଲଜ୍ଜା କେବଳ ହେଲା ମୋ ମଜ୍ଜା",
          "ମଜ୍ଜିଯିବି କି ଉଭା ରତିରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ମୋହନ ଲୀଲା ଧରି କୋଟି କଳାକର ଶିରୀ",
          "ପୂରିଛି ସେ ଶ୍ୟାମ ମୂରତିରେ",
          "କୁତ୍ସା କରେ ମୁଁ ଧାତାକୁ କାହିଁକି ସରଜି ତାକୁ",
          "ଚିରାୟୁ ରଖିଲା ଜରତୀରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କି ନୀତି କି ଜାତିଶୀଳ କି କୁଳବରତ ଫଳ",
          "ଠଉର ପାରିଲା ମୋ ମତିରେ",
          "କୋମଳତର ମୋହନ କୁଞ୍ଜକୁକ୍ଷିରୁ ନିଃସ୍ୱନ",
          "ଆସି ଚୁମ୍ବିଦେଲା ମୋ ଶ୍ରୁତିରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କଲବଲ ଛଟପଟ ହୋଇ ଯାଉଛି ନିପଟ",
          "ସଂବେଶ ଅଶନ ବିରତିରେ",
          "କହଇ ଶ୍ରୀ ବାଲୁକେଶ ଶରଣ ଧରଣୀଈଶ",
          "ଏ କି ଦଣ୍ଡ ବିନା ପୀରତିରେ"
        ]
      }
    ]
  },
