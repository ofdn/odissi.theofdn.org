  "id": "oa-gita-000519",
  "name": {
    "en": "Ahe nilachala pratapa apanankara",
    "or": "ଆହେ ନୀଳାଚଳ ପ୍ରତାପ ଆପଣଙ୍କର"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-nilachala-pratapa-apanankara-kamodi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହେ ନୀଳାଚଳ ପ୍ରତାପ ଆପଣଙ୍କର ଗଲା କାହିଁ",
          "ମୋହ ବିପତ୍ତି କୁମ୍ଭୀର ଶିରକୁ ତ ଅସିଧାର ନ କାଟଇ । ଘୋଷା ,"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁମ୍ଭୀର ଡାକ ଶୁଣିଲ ଶତ ଯୋଜନରେ ଥିଲ କିଞ୍ଚିତରେ",
          "ନିକଟେ ଡାକକୁ ମୋର ମୃଦୁ ଶ୍ରବଣ କୁହର କି ଚିତ୍ତରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବନୀତ ପ୍ରାୟ ଦ୍ରବି ଯାଅ ଅପର ତାପ ଦେଖି ହୁଅ ଦୁଃଖୀ",
          "ଦୀନବାନ୍ଧବ ପଦବୀ ଛାଡ଼ିଦେଲ କିମ୍ପା ଦ୍ରବି ମୋତେ ଦେଖି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଧନ୍ୟ ମୋହର ପାତକ ତୁମ୍ଭେ ହେଉଛ ଆତଙ୍କ ମୋତେ ଚାହିଁ",
          "ଅଜାମିଳ ପୁଣ୍ୟ ଟେକ ସଙ୍କେତରେ ଦେଲା ଡାକ କଲ ତ୍ରାହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପତିତ ତାରଣ ହୋଇ ଆଉ କେ ଅଛନ୍ତି ଦିଅ କହି",
          "ବନମାଳୀ ଦୁଃଖ ସହି ସଂସାର ବିନାଶ ପାଇଁ ଭଜୁଥାଇ"
        ]
      }
    ]
  },
  "sources": [
