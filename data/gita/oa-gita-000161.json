{
  "id": "oa-gita-000161",
  "name": {
    "en": "Manasaru mana saru",
    "or": "ମାନସରୁ ମାନ ସରୁ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000074"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manasaru-mana-saru/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନସରୁ ମାନ ସରୁ ମାନ ସରୁମଧ୍ୟମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହର ବରଦୁଃଖ ମୋର । ହରବର ତୁ ନ କର ।",
          "ହରବରରେ ମୁଁ ତୋର ବର ବରବରନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପରବତସ୍ତନା ମୋତେ । ପର ବତ କରୁ କେତେ ।",
          "ପରବରତ ସୁରତେ ପରସନେ ସୁମନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁ ମୋ ଉରପଦକ ରେ । ଘେନ କଥା ପଦକ ରେ ।",
          "ଧରୁଛି ତୋ ପଦ କରେ ମୋଦ କରେ ନବୀନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବିସୂର୍ଯ୍ୟ ଦୀନବନ୍ଧୁ । ବୋଲି ହେଲି ଦୀନ ବନ୍ଧୁ ।",
          "ରଖ ବାରେ ଦିନବନ୍ଧୁ-ବନ୍ଧୁଜିତ ନୟନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manasaru-mana-saru/"
    }
  ],
