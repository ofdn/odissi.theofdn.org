{
  "id": "oa-gita-000037",
  "name": {
    "en": "Ahe nila saila",
    "or": "ଆହେ ନୀଳ ଶଇଳ"
  },
  "composer": "oa-person-000025",
  "mula_raga": [
    "oa-raga-000023"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-nila-saila-salabega-chinta-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହେ ନୀଳ ଶଇଳ ପ୍ରବଳ ମତ୍ତ ବାରଣ ।",
          "ମୋ ଆରତ ନଳିନୀ ବନକୁ କର ଦଳନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗଜରାଜ ଚିନ୍ତା କଲା ଥାଇ ଘୋର ଜଳେଣ",
          "ଚକ୍ର ପେଷି ନକ୍ର ନାଶି ଉଦ୍ଧାରିଲ ଆପଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁରୁ ସଭାତଳେ ଶୁଣି ଦ୍ରୌପଦୀର ଜଣାଣ",
          "କୋଟି ବସ୍ତ୍ର ଦେଇ ତାଙ୍କୁ ଲଜ୍ଜା କଲ ବାରଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଘୋର ବନେ ମୃଗୁଣୀକି ପଡ଼ିଥିଲା କଷଣ",
          "ଏଡ଼େ ବଡ଼ ବିପତ୍ତିରୁ ରକ୍ଷା କଲ ଆପଣ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାବଣର ଭାଇ ବିଭୀଷଣ ଗଲା ଶରଣ",
          "ଶରଣ ସମ୍ଭାଳି ତାଙ୍କୁ ଲଙ୍କେ କଲ ରାଜନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଜାମିଳ ଡାକ ଦେଲା ଜୀବ ଯିବା ବେଳେଣ",
          "ତେଡ଼େ ବଡ଼ ପାପୀ ଗଲା ବଇକୁଣ୍ଠ ଭୁବନ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପ୍ରହଲ୍ଲାଦ ପିତା ସେ ଯେ ବଡ଼ ଦୁଷ୍ଟ ଦାରୁଣ",
          "ସ୍ତମ୍ଭରୁ ବାହାରି ତାକୁ ବିଦାରିଲ ତକ୍ଷଣ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ନୀଳାଚଳେ ବିଜେ କରି ବୌଦ୍ଧ ଅବତାରେଣ",
          "ବେନି ଭୁଜ ଟେକି ପ୍ରଭୁ ଯାଚୁଅଛ ଶରଣ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କହେ ସାଲବେଗ ହୀନ ଜାତିରେ ମୁଁ ଯବନ",
          "ଶ୍ରୀରଙ୍ଗା ଚରଣ ତଳେ କରୁଅଛି ଜଣାଣ"
        ]
      }
    ]
  },
  "sources": [
