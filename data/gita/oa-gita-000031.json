    "stanzas": [
      {
        "n": 0,
        "lines": [
          "(ଧ୍ରୁବପଦାଙ୍ଗ)"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାଗ ତାଳ ସ୍ୱରଭେଦ",
          "ଗୁଣିଜନ ପରସାଦ",
          "ଜାଣ ମୁଜାଣ କୋବିଦ",
          "ପରାପତ ନିତ୍ୟ ସାଧ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଭ୍ୟାସ ଶ୍ରବଣ ଧ୍ୟାନ",
          "ନିୟମିତ ସାଧନମନ",
          "ନାଦବିଦ୍ୟା ସୁକଠିନ",
          "ଆୟତ୍ତ କିଞ୍ଚିତ ଜାଣ । ଅନ୍ତରା ।"
        ]
      }
    ]
  },
