  "id": "oa-gita-000857",
  "name": {
    "en": "Manini radhike mana kara na",
    "or": "ମାନିନୀ ରାଧିକେ ମାନ କରନା"
  },
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manini-radhike-mana-kara-na-mukhari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନିନୀ ରାଧିକେ ମାନ କରନା",
          "ସୁନୟନା ମୋ ସୁନାବରନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କିଣାଜନରେ ଊଣା କର ନାହିଁ କରୁଣା",
          "ଶୁଣା ତୋ ବୀଣାଜିଣା ବାଣୀ ବରବରନା",
          "(ପଡ଼ି)",
          "ରୁଷ ନାହିଁ ମୋ ଠାରେ ଋଷି ମନମୋହିନୀ",
          "ରୂପ ଲାବଣ୍ୟ ରସ ଝରଣା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚଳାପାଙ୍ଗୀ ଅଳପ ଅନାଅ ଖୋଲି ଆଖି",
          "ମଳୟ ବଜାଅନା ରେ ସଖି",
          "(ପଡ଼ି)",
          "ମିନତି କରେ ଗୋରୀ ମାରି ନୟନ ଛୁରୀ",
          "ରୋଷ ଅନଳେ ପ୍ରାଣ ଦହନା"
        ]
      }
    ]
  },
  "sources": [
