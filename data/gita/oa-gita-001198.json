{
  "id": "oa-gita-001198",
  "name": {
    "en": "Keli kusala balamani",
    "or": "କେଳି କୁଶଳା ବାଳାମଣି"
  },
  "composer": "oa-person-000148",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/keli-kusala-balamani-brajanatha-badajena/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଳି କୁଶଳା ବାଳାମଣି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପୀରତି ଘେନା ସୁରତି ଆବେଶେ",
          "ଏ ଗତ ରାତି ମିଳିଲା ମୋ ପାଶେ",
          "ଅଙ୍ଗରାଜି ସାଜି ସୁନ୍ଦର ବେଶେ",
          "ବିମ୍ବ ଅଧର ମଣ୍ଡି ଚାରୁ ହାସେ",
          "ମାନସ, ବଶ କଲା ଆହା ସେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚାହିଁ ମୋହିନୀକି ହୋଇ ଅଦମ୍ଭ",
          "ହୃଦରେ ମୋଦେ ଯୋଡ଼ି କୁଚକୁମ୍ଭ",
          "ବେଗେ ଆରମ୍ଭ କଲି ପରିରମ୍ଭ",
          "ଜାତ ହେଲା ଅଙ୍ଗୁ ସାତ୍ତ୍ୱିକ ଦମ୍ଭ",
          "ପ୍ରକାଶେ, କମ୍ପ ପୁଲକ ସ୍ତମ୍ଭ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନୀରଦ ନୟନା ହୋଇ ଉଚ୍ଛନ୍ନ",
          "ତନୁକୁ ଚମକାଇ ଘନଘନ",
          "ମନ ଉଲ୍ଲାସରେ ଦେଇ ଚୁମନ",
          "ଠେସଇ ହୃଦରେ କଠିନ ସ୍ତନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚାଖିଲି ତାର ଅଧର ପୀୟୂଷ",
          "ସୁଖୀ ହୋଇଲା କେଡ଼େ ମୋ ମାନସ",
          "ଆଖିର ଦୂର ହୋଇଲା ନିମେଷ",
          "ଦେଖି ତାର ଚିତ ମୋହନ ବେଶ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯାହା କଲା ପୁଣି ବିପରୀତରେ",
          "ଆହା ଅତ ଜାଣେ ଚିତ୍ତଜ ଚିତ୍ତରେ",
          "କିଙ୍କିଣୀ କିଣି ଊହୁଁ ନା ଗୀତରେ",
          "ଚାଟୁ ବାଣୀକି କହିଲା ମଧୁରେ",
          "କିଣିଲା, ମୋତେ ରତି ରତ୍ନରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଭଣେ ବ୍ରଜନାଥ ମୋ ପୂର୍ବ ପୁଣ୍ୟ",
          "ଥିବାରୁ ହୋଇ ସେ କୁଳ (କୋଳ‌) ମଣ୍ଡନ",
          "ରସିକାମଣି ଅନୁଗ୍ରହ ସ୍ଥାନ",
          "ନ ଦେଖିବି କି ତା ମୁଖ ମଳିନ",
          "ରଖିବ, ମୋରେ ଏ ଅବଧାନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/keli-kusala-balamani-brajanatha-badajena/"
    }
  ],
