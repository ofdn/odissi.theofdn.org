{
  "id": "oa-gita-001221",
  "name": {
    "en": "Anti galani koti gune to sneha",
    "or": "ଅଣ୍ଟି ଗଲାନି କୋଟି ଗୁଣେ ତୋ ସ୍ନେହ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/anti-galani-koti-gune-to-sneha-kaphi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅଣ୍ଟି ଗଲାନି କୋଟି ଗୁଣେ ତୋ ସ୍ନେହ",
          "ସୁଖ ସରି ଆଉ ନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୂଟ କପଟୀ ନଟ ଆଭୀର ପଲ୍ଲୀ ବିଟ",
          "ବଟିଆଇ ମୋ ଆଗେ ଚାଟୁ କହନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାଲି ନିଶି ଜାଗରେ ନିକୁଞ୍ଜ ଅଗଣାରେ",
          "ଜଗାଇ ଦେଲୁ ତାକୁ କେତେ ଯାତନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୀର୍ତ୍ତିଦା ପତିକୁଳେ କୀର୍ତ୍ତିବଲ୍ଲୀ ଆକୁଳେ",
          "ଶ୍ରୁତିରେ ତୋ ଧରମ ହେବ ଶୁଣନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସୁଆଗକୁ ତୋହର ଜୁହାର ଲକ୍ଷେ ବାର",
          "ମୋହ ଲଗାଇ ହରି ଲୁହ ପୋଛାନା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ତୋ ଲାଗି ଯେତେ ବାଧା ସହିଥିଲା ସେ ରାଧା",
          "ଥରେ ହେଲେ ମନେ ନ କରୁ ଭାବନା"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହି ଅଞ୍ଜଳି କରି ସହି",
          "ବୋଲେ ପୁଣି ଭ୍ରମାଇ ଲୋକ ହସାନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
