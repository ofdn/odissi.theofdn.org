{
  "id": "oa-gita-000362",
  "name": {
    "en": "Dekha nanda nandana go",
    "or": "ଦେଖ ନନ୍ଦନନ୍ଦନ ଗୋ"
  },
  "composer": "oa-person-000071",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-nanda-nandana-go-kedara-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖ ନନ୍ଦନନ୍ଦନ ଗୋ",
          "ମନ୍ଦ ମନ୍ଦ ଗୋବିନ୍ଦ କରେ ରହି",
          "ଲୋକବୃନ୍ଦ ଆନନ୍ଦଘନ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଞ୍ଜନୟନଙ୍କୁ ମଧୁପୁରେ ଅନାଇଁ",
          "ପଞ୍ଜରେ ସଖୀକି ରାମା ଦିଅନ୍ତି ଦେଖାଇ",
          "(ପଡ଼ି)",
          "କୁଞ୍ଜବନର ସହି କୁଞ୍ଜର ପରା ଏହି",
          "ଅଞ୍ଜନ ନବଘନ ପୁଞ୍ଜ ରୁଚିର ଦେହୀ",
          "ଅଞ୍ଜନ ଦଳି ରୂପ ମଞ୍ଜୁଳ ଗୋପୀଦୃଶ",
          "ଖଞ୍ଜନ ଯୁଗଳର ପଞ୍ଜରୀ ଏହି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୂର୍ବେ ଏ ବାଳକ କାଳେ ମାଇଲେ ପୂତନା",
          "ପାର୍ବତୀଙ୍କି ସେବିଣ ପାଇଲେ ବ୍ରଜାଙ୍ଗନା",
          "(ପଡ଼ି)",
          "ପର୍ବତ କରେ ଧରି ଇନ୍ଦ୍ର ଗର୍ବକୁ ଚୂରି",
          "ସର୍ବ ଗୋପୀକୁଳକୁ ଦୁର୍ବଳୁ କଲେ ପାରି",
          "ପର୍ବ କଳଙ୍କହୀନ ଶର୍ବରୀପତି ଗର୍ବ",
          "ଖର୍ବ କରଇ ମୁଖ କର୍ବୂରଅରି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଥଣ୍ଟି ଚିରି ବକାସୁର ପ୍ରାଣ ନେଲେ ହେଳେ",
          "ଷଣ୍ଢା ଦଇତକୁ ଦଣ୍ଡ ଦେଲେ କୁତୂହଳେ",
          "(ପଡ଼ି)",
          "ଚଣ୍ଡ କିରଣଜିତ ଖଣ୍ଡଶଶୀ ବିଦିତ",
          "ଗଣ୍ଡ ମନକୁ ହରେ କୁଣ୍ଡଳୀବର ଶିରେ",
          "ତାଣ୍ଡବ ଚତୁର ଏ ମୁଣ୍ଡରେ କେକୀପୁଚ୍ଛ",
          "ମୁଣ୍ଡରେ କେକୀପୁଚ୍ଛ ମଣ୍ଡନ ଧରେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାଞ୍ଚନ ଚଟୁଳ ପଟ କଟିରେ ମଞ୍ଜୁଳ",
          "ଘଞ୍ଚ ଅଳକାକୁ ଶୋଭା ଶ୍ରୀମୁଖ ମଣ୍ଡଳ",
          "(ପଡ଼ି)",
          "ପଞ୍ଚବିଶିଖଜିତ ସଞ୍ଚତନୁକୁ ମିତ",
          "ସଞ୍ଚ ସୁକୃତ ଫୁଳ ପାଞ୍ଚଇ ମୋର ଚିତ୍ତ",
          "ଚଞ୍ଚରୀକ ରୁଚିର ନୟନ ଅଞ୍ଚଳରେ",
          "ଅନବରତ ସିଞ୍ଚେ ଅମୃତ ନୀର ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୃନ୍ଦାବନରେ ଏହାଙ୍କୁ ଘେନି ବ୍ରଜବାଳୀ",
          "ନିନ୍ଦାକୁ ନ ମାନି ନାନାରଙ୍ଗେ କଲେ କେଳି",
          "(ପଡ଼ି)",
          "ବୃନ୍ଦାବନ କହଇ ବୃନ୍ଦାରକ ଈଶ୍ୱର",
          "ବୃନ୍ଦା ଅର୍କ ହୁଅଇ ମନ୍ଦାର ସୁଅଧର",
          "କୁନ୍ଦରୁ ସୁଉଦିତ ବୃନ୍ଦାବନ କୁଶଳ",
          "ବନ୍ଧା ସଂସାର ଫିଟା ଫାନ୍ଦଟି ଏହି ଗୋ"
        ]
      }
    ]
  },
