{
  "id": "oa-gita-000012",
  "name": {
    "en": "Lagi lagi sangini mote",
    "or": "ଲାଗି ଲାଗି ସଙ୍ଗିନୀ ମୋତେସରି କି ପକାଇଦେଲୁ ମୋହନ ହାତେ । ଘୋଷା । ନାହିଁ ନାହିଁ କରୁଥିଲିଫୁଲ ତୋଳି ଯିବି ବୋଲିଘେନିଗଲୁ ଯେ ଭୁଲାଇକୁଞ୍ଜବନକୁ ସଙ୍ଗତେ । ୧ । କେବେ ହେଲେ ସେ ବିଚାରସହି ତାଙ୍କର ତୋହରଅଲଙ୍ଘ୍ୟ ପତିବରତବ୍ରତ ନାଶିଲୁ ଇଷିତେ । ୨ । ବୃନ୍ଦା ଜାଣିଗଲେଣି ତସଙ୍ଗିନୀଯାକ ଯାବନ୍ତହସି ମାଳା ଦେଲେ ଆଜିପଶି ମୋହର ପୁରତେ । ୩ । ବରଜଯାକ ଶୁଣିବେଶ୍ରୀ ପୌର୍ଣ୍ଣମାସୀ ଜାଣିବେଚନ୍ଦ୍ରାବଳୀ ପରି ରାଧାହେଲା ବୋଲିବେ ଜଗତେ […]"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/lagi-lagi-sangini-mote/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଲାଗି ଲାଗି ସଙ୍ଗିନୀ ମୋତେ",
          "ସରି କି ପକାଇଦେଲୁ ମୋହନ ହାତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନାହିଁ ନାହିଁ କରୁଥିଲି",
          "ଫୁଲ ତୋଳି ଯିବି ବୋଲି",
          "ଘେନିଗଲୁ ଯେ ଭୁଲାଇ",
          "କୁଞ୍ଜବନକୁ ସଙ୍ଗତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେବେ ହେଲେ ସେ ବିଚାର",
          "ସହି ତାଙ୍କର ତୋହର",
          "ଅଲଙ୍ଘ୍ୟ ପତିବରତ",
          "ବ୍ରତ ନାଶିଲୁ ଇଷିତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବୃନ୍ଦା ଜାଣିଗଲେଣି ତ",
          "ସଙ୍ଗିନୀଯାକ ଯାବନ୍ତ",
          "ହସି ମାଳା ଦେଲେ ଆଜି",
          "ପଶି ମୋହର ପୁରତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବରଜଯାକ ଶୁଣିବେ",
          "ଶ୍ରୀ ପୌର୍ଣ୍ଣମାସୀ ଜାଣିବେ",
          "ଚନ୍ଦ୍ରାବଳୀ ପରି ରାଧା",
          "ହେଲା ବୋଲିବେ ଜଗତେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ",
          "ସେପରିରେ ମୁଁ ନୁହଁଇ",
          "ସରିଛି ବିହାର ସବୁ",
          "ଧୂଳିରେ ନାହିଁ କିଞ୍ଚିତେ"
        ]
      }
    ]
  },
