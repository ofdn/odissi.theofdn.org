{
  "id": "oa-gita-001276",
  "name": {
    "en": "Se sina basiba rusi re sajani",
    "or": "ସେ ସିନା ବସିବ ରୁଷି ରେ ସଜନୀ"
  },
  "composer": "oa-person-000153",
  "mula_raga": [
    "oa-raga-000019"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-sina-basiba-rusi-re-sajani-nata-radhamadhaba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ ସିନା ବସିବ ରୁଷି ରେ ସଜନୀ",
          "ଶିଖଣ୍ଡଚୂଳିଆ ନୟନ କୁନ୍ତରେ",
          "ଥରେ ନୋହିଥିଲେ ଭୁଷି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତରଙ୍ଗିଣୀ ତଟ ସରଣୀରେ ଭେଟ",
          "ରମଣୀ ଯେ ହୋଇ ନାହିଁ",
          "ନୀଳ ବାରିବାହ ଦଳନ ବିଗ୍ରହ",
          "ଅଳପ ନଥିଲେ ଚାହିଁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରସିକା ବୃନ୍ଦରେ ବସି ଆନନ୍ଦରେ",
          "ରସି ଶ୍ୟାମ ପ୍ରେମ ଗୁଣ",
          "ବସୁଧାରେ ଥିବ କେବଳ ହୋଇବ",
          "ପଶୁରୁ ହେଲେ ଅଜାଣ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବସାଇବା ପାଶେ ରସାଇଣ ରସେ",
          "ବସାଇ ଉତ୍ସୁକ ମନେ",
          "ପୀଡ଼ଇ ଓଷ୍ଠକୁ ଜଡ଼ାଇ ଅଙ୍ଗକୁ",
          "ଭିଡ଼ାଇ ନ ଥିଲି ଦିନେ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବସନଲୁଟିଆ ରାସ ବିନୋଦିଆ",
          "ଭାଷରେ ନ ରସିଥିଲେ",
          "ଦୂରରୁ ଦୁର୍ଲ୍ଲଭ ମୁରଲୀର ରବ",
          "ଶ୍ରବଣ ଯେ କରିଥିଲେ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନରକୁଳ ଇନ୍ଦ୍ର ପୂର୍ଣ୍ଣ ରାକାଚନ୍ଦ୍ର",
          "ଶ୍ରୀ ରାଧାମାଧବ ଭଣି",
          "ସ୍ମର ତରୁଆର ଧାରାରେ ଶରୀର",
          "ଥରେ ନୋହିଥିବ ହାଣି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
