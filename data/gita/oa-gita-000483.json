{
  "id": "oa-gita-000483",
  "name": {
    "en": "Kahalo sajani se kadamba mule",
    "or": "କହ ଲୋ ସଜନୀ ସେ କଦମ୍ବ ମୂଳେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahalo-sajani-se-kadamba-mule/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ ଲୋ ସଜନୀ ସେ କଦମ୍ବ ମୂଳେ କେ ସେ",
          "ନବୀନ ନୀରଦ ତନୁ କେଡ଼େ ଶୋଭା ଦିଶେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କିଶୋର ବୟସ ତାର । ଛବି ଦିଶେ ମନୋହର ।",
          "ନାଗରୀଙ୍କ ଚିତ୍ତଚୋର ନଟବର ବେଶେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମନେ କର ବିବେଚନା । ଜାଣେ କି ମନ୍ତ୍ର ରଚନା ।",
          "ଘେନିଥାଇ ଗୋରଚନା ବିନ୍ଦୁ ଭାଲ ଦିଶେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନରେ କି ରୋଷ ବହି । ଅବଳା ବଧିବା ପାଇଁ ।",
          "ଜାଣିଲି ନିଶ୍ଚୟ ବିହି ଆଣିଛି ଏ ଦେଶେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଦାସ ଭଣି । ସେ ପରା ମୁରଲୀପାଣି ।",
          "ପରଚେ ହେଲେ ତା ଠାରେ ଜାଣିବୁ ତୁ ଯେ ସେ"
        ]
      }
    ]
  },
  "sources": [
