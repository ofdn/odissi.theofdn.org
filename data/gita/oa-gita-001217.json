{
  "id": "oa-gita-001217",
  "name": {
    "en": "Ali kesara kunjaru ailu ki",
    "or": "ଅଳି କେଶର କୁଞ୍ଜକୁ ଅଇଲୁ କି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ali-kesara-kunjaru-ailu-ki-anandabhairabi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅଳି କେଶର କୁଞ୍ଜକୁ ଅଇଲୁ କି",
          "ଜୀବନ ବନ୍ଧୁଙ୍କୁ ମୋ ଦେଖିଲୁ କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହୋଇ କେତେ ବିନୟକୁ ଆସୁଛୁ ମୁଖ ପାଶକୁ",
          "ଶ୍ରୀ କିଶୋର ଚନ୍ଦ୍ରଙ୍କର କୁଶଳ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କର୍ଣ୍ଣୋତ୍ତଂସ ପୁଷ୍ପେ ବସ କହିଛନ୍ତି କି ସନ୍ଦେଶ",
          "ଭାଷ ଧୀରେ ତୋତେ ପଠିଆଇଲେ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁ ଯାଉନା ପଦ୍ମଠାକୁ କଞ୍ଜ ତଳେ ତୋ ପାଶକୁ",
          "ଅନୁଭବି ତୁ ପଚାରିଲୁ ନାହିଁକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମଧୁବ୍ରତକୁ ପଚାରି ଆଣି ନୟନରୁ ବାରି",
          "ବୋଲନ୍ତି ମୁଁ ସତେ ମନେ ପଡ଼ୁଛି କି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆଳୀ ଭାଷନ୍ତି ବାଳୀଶ ହୋଇଲୁକି ଆସ ଆସ",
          "ପଚାରୁ ଯେ କୀଟ କଥା କହିବ କି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ମଧୁକର ଉଡ଼ିଗଲା ଗୋପାଳକୃଷ୍ଣ ଭଣିଲା",
          "ପ୍ରିୟ ଅଇଲେ ଚଳ ପୁଷ୍ପବାଟୀକି"
        ]
      }
    ]
  },
  "sources": [
