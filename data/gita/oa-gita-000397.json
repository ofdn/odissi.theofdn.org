{
  "id": "oa-gita-000397",
  "name": {
    "en": "Sarange aja sakhi mana teja",
    "or": "ସାରଙ୍ଗେ ଆଜ ସଖୀ ମାନ ତେଜ"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000105"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sarange-aja-sakhi-mana-teja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ମାନ ତେଜ ଆଜ ରେ",
          "ସାରଙ୍ଗେ ଆଜ",
          "ସାରଙ୍ଗ ମୋହିନୀ ସାରଙ୍ଗ ବଚନୀ",
          "ସାରଙ୍ଗ ଘେନ ତୁ ଏହି ଅରଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାରଙ୍ଗେ ଶରୀର ହେଉଛି ଘାରି",
          "ସାରଙ୍ଗ ଯୌବନ ଦେଖି ତୋହରି",
          "ସାରଙ୍ଗ ଲପନୀ ସାରଙ୍ଗ ନୟନା",
          "ସାରଙ୍ଗ ନାଶିନୀ ନାଗରୀରାଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସାରଙ୍ଗ ବଦନୀ ହର ବେଦନା",
          "ସାରଙ୍ଗେ କହୁଛି ତୋର ନବୀନା",
          "ସାରଙ୍ଗେ ବସାଇ ସାରଙ୍ଗେ ରସାଇ",
          "ସାରଙ୍ଗେ ହର ତୁ ଭିଡ଼ି ଉରଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସାରଙ୍ଗ ବିଷେ ଯେ ହେଉଛୁଁ ଘାରି",
          "ସାରଙ୍ଗ ଧରୁଛୁଁ ଶୁଣ ସୁନ୍ଦରୀ",
          "ସାରଙ୍ଗ କିଶୋରୀ ସାରଙ୍ଗ ଯେ ସ୍ମରି",
          "ସାରଙ୍ଗେ ଉଠ ମୋ ନାଗରୀରାଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସାରଙ୍ଗେ ବଚନ ଶୁଣିଣ ଗୋରୀ",
          "ସାରଙ୍ଗରେ ଯାଇ କରିଲେ କେଳି",
          "ସାରଙ୍ଗେ ମୋ ରାଣ ସାରଙ୍ଗ ତେଜିଣ",
          "ସାରଙ୍ଗେ ଆବୋରି ବସିଲେ ଶେଯ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସାରଙ୍ଗ ବିଧି ସେ ସାରିଣ ଗଲେ",
          "ସାରଙ୍ଗ ଦର୍ଶନ ଯାଇଁଣ କଲେ",
          "ପୂଜି ହରଗୌରୀ ଆସିଲେ ଯେ ପରି",
          "କହେ ଗୌରହରି ହେ ରସରାଜ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
