    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନା ରେ ଏଣୀନୟନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏକେ ଛଳଛଳ ଆଖି ତା ପରେ କଜଳ ମାଖି",
          "ବିଶିଖ ବିଷାଇ ଭଗାରି ହସାଇ",
          "ରୁଷି ବସନା ସହୀ ସୁନାବରନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଟିଳ ଭୁଜଙ୍ଗ ଭୂରୁ ଡରି ମରେଁ ହେରି ଦୂରୁ",
          "କାମବାଣ ଖଞ୍ଜି କମାଣ ସରଜି",
          "ମାରନା ଗୋରୀ କଞ୍ଜ ସରସ ବଦନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦଣ୍ଡରେ ସୁମନା ଖରେ ଭିଡ଼େ ତୋ ବାହୁ ପାଶରେ",
          "ଆନ କରେ ମାରି ହସାନା ଭଗାରି",
          "କର ତୁ କବିଚନ୍ଦ୍ର ମିନତି ଘେନା"
        ]
      }
    ]
  },
  "sources": [
