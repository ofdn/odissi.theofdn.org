{
  "id": "oa-gita-000669",
  "name": {
    "en": "Kede abichara kali",
    "or": "କେଡ଼େ ଅବିଚାର କଲି"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kede-abichara-kali-bhairabi-bira-bikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଡ଼େ ଅବିଚାର କଲି",
          "ପଙ୍କଜ ସଙ୍ଗରେ ଯାହା କୁଟଜ ତୁଳିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସରସିଜ ତେଜି ଅଳି ହୋଇଣ ଉନ୍ମତ୍ତ",
          "ବାସଙ୍ଗ ସଙ୍ଗରେ ରଙ୍ଗେ କେଳି କଲା ବତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁନ୍ଦନ ପାଣି ରତନ ପାଷାଣ ମଣିଲି",
          "ଝଳିବନ୍ତ ହୀରାକୁ ଯା କାଚରେ ଗଣିଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସାଧାରଣ ଶିଳା ସ୍ନେହେ ବରଜି ମାଣିକ",
          "ହେମକୁ ତୁଳିଲି ଗୁଞ୍ଜେ ହୋଇଣ ବଣିକ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଫିଙ୍ଗି ଦେଇ ଜଳେ ଏବେ ଗଳେ ଥିଲା ମାଳି",
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ବୋଲେ ବସି ଅଛି ଭାଳି"
        ]
      }
    ]
  },
  "sources": [
