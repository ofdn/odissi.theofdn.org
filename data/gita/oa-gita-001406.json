{
  "id": "oa-gita-001406",
  "name": {
    "en": "Dinabandhu daitari",
    "or": "ଦୀନବନ୍ଧୁ ଦଇତାରି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dinabandhu-daitari-dukha-na-gala-mohari-banamali-janana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦୀନବନ୍ଧୁ ଦଇତାରି ଦୁଃଖ ନ ଗଲା ମୋହରି",
          "ହେଲ କି ନିଷ୍ଠୁର ଚିତ୍ତ ନୀଳାଚଳେ ବିଜେ କରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲକ୍ଷେ ଯୋଜନରେ ଗଜ ଡାକିଲା ହେ ଦେବରାଜ",
          "ତା ଡାକ‌କୁ ଚତୁର୍ଭୁଜ ଶୁଣିଛ ଶ୍ରବଣ ଡେରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁରୁପତି ସଭା ତଳେ ଦ୍ରୌପଦୀ ଆତଙ୍କ‌ କାଳେ",
          "କୋଟି ବସ୍ତ୍ର ଦେଇ ହେଳେ ଲଜ୍ଜାରୁ କରିଛ ପାରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବଳବନ୍ତ ପ୍ରଭୁ ବୋଲି ବଳେ ମୁଁ ଯେ ଆଶ୍ରା କଲି",
          "ଦେଖୁ ଦେଖୁ ଭାସିଗଲି କେ ଏଥୁ କରିବ ପାରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରଖ ବା ନ ରଖ ମୋତେ ଶରଣ ତୋ ପାଦଗତେ",
          "ବୋଲେ ବନମାଳୀ ଗୀତେ ବସିଅଛି ଧ୍ୟାନ କରି"
        ]
      }
    ]
  },
