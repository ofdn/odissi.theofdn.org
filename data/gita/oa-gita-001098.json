  "name": {
    "en": "Dhira re ki dhana tu na delu",
    "or": "ଧୀରା ରେ କି ଧନ ତୁ ନ ଦେଲୁ ଆଜ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Dha Patala",
      "or": "ଧ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhira-re-ki-dhana-tu-na-delu-dha-champu-kaphi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧୀରା ରେ କି ଧନ ତୁ ନ ଦେଲୁ ଆଜ",
          "ଧଇଲେ କି ସତେ କର ଯୁବରାଜ ।ପଦ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧରମ ବଳୁ କି ମୋର ଧୂପି ଦେଇ ନିଜ କର",
          "କୋଳକୁ ଆଣିଲୁ କଳା ଦ୍ୱିଜରାଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଧୁରନ୍ଧର ସେ ଇଙ୍ଗିତେ ଧରଷିଲୁ କେହି ସତେ",
          "ଧମକାଇଲା ନାହିଁ କି କିଛି ଲାଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଧରାରେ ଯେତେ ପୁରୁଷେ ଧୂର୍ତ୍ତ ତାହାଙ୍କ ଗୁରୁ ସେ",
          "ଧନରୁ ଯେ ବଳେ ତାହାଙ୍କର ବ୍ୟାଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଧୃତି ହୋଇ ବଳହୀନ ଧୂସର ହୋଇବ ମନ",
          "ଧୋଇ ଚିନ୍ତା କଳଙ୍କ ସମାଜ ମାଜ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଧରଣୀନ୍ଦ୍ର ଜଗଦ୍ଦେବ ଧ୍ୟାନେ ବଲ୍ଲବୀ ବଲ୍ଲବ",
          "ଧରାଧୂଳି କରେ ମସ୍ତକରେ ତାଜ"
        ]
      }
    ]
  },
