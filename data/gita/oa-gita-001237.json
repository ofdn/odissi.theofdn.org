{
  "id": "oa-gita-001237",
  "name": {
    "en": "Dekhi jadupati charu murati",
    "or": "ଦେଖି ଯଦୁପତି ଚାରୁ ମୂରତି"
  },
  "composer": "oa-person-000150",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekhi-jadupati-charu-murati-sankara-bihara-prabandha-kamodi-kabiratna-narayana-misra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶଙ୍କରବିହାରପ୍ରବନ୍ଧ, କାମୋଦୀରାଗେଣ",
          "ଦେଖି ଯଦୁପତି ଚାରୁ ମୂରତି",
          "ଭୂମିରେ ଭବ ପ୍ରଣମିଲେ",
          "ଭକ୍ତିରସ ଘେନି ମାନସ",
          "ଜୟ ଜୟ ବଚ ଭଣିନେଲେ । ଉଦ୍ଗ୍ରାହଃ ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୟନୁ ନୀର ବହେ ଅଧୀର",
          "କମ୍ପେ ତନୁ ଥରହରେ",
          "ନୀଳକଣ୍ଠ ହୋଇ ସୋତ୍କଣ୍ଠ",
          "ପୁଣ ପୁଣ ପଡ଼େ କ୍ଷିତି ପରେ",
          "ଲଭିଣ ପ୍ରୀତି ଗିରିଜା ପତି",
          "ଭକ୍ତି ଭାବେ ଭୋଳରେ",
          "ନାଚେ ବିକଟ ଥୈ ଥୈକଟ",
          "ବୋଲି ତାକଟ ତାଳରେ । ଦ୍ୱିଗୁଣମାତ୍ରୋ ଧ୍ରୁବଃ ।"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିହ୍ୱଳମତି ଆକୁଳଗତି",
          "ଗଚ୍ଛତି ଅତି ମନ୍ଦରେ",
          "ପୁଣ ନିପତତି ପୁଣ ଗାୟତି",
          "ପୁଣ ଧ୍ୟାୟତି ଆନନ୍ଦରେ । ଆଭୋଗଃ ।"
        ]
      }
    ]
  },
