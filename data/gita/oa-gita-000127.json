{
  "id": "oa-gita-000127",
  "name": {
    "en": "Kaha re jiba sangini",
    "or": "କହ ରେ ଜୀବସଙ୍ଗିନୀ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-re-jiba-sangini-to-mana-kedara-kamodi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ ରେ ଜୀବସଙ୍ଗିନୀ",
          "ତୋ ମନ ଘନଶ୍ଯାମ ରସେ ବଳିଲା କି",
          "ପଦେ ପଦେ ସୁଖ ଦେବା ପ୍ରେମ ଲେଖ",
          "ମିଳିଲା କି ବାଞ୍ଛା ଫଳିଲା କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତରଣିଜାକୂଳ ନୀପମୂଳସ୍ଥଳ",
          "କୁତୂହଳ ରୋଳ ଏ ତୋ ନେତ୍ରାଞ୍ଚଳ",
          "ମୋହନ ବିଗ୍ରହେ ଅକପଟ ସ୍ନେହେ",
          "ଢଳିଲା କି ଚିତ୍ତ ଚଳିଲା କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୁର ଦଳନାରି ଅମଳେ ତୁ ଘାରି",
          "ହେଉଥିଲୁ ନାରୀମଣି ମନୋହାରୀ",
          "ଧଇର୍ଯ୍ୟ ସରୋଜ ବନନୀଳ ଗଜ",
          "ଦଳିଲା କି ତହୁଁ ଲୁଳିଲା କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅବସର ଦଣ୍ଡକରେ ସେ ଶିଖଣ୍ଡ",
          "-ମଣ୍ଡନ ଅଖଣ୍ଡ ନୟନାନ୍ତ ଦଣ୍ଡ",
          "ତୋ ମରଜି ବକ୍ର ବସୁନ୍ଧରା ଚକ୍ର",
          "ନଳିଲା କି ସବୁ କଳିଲା କି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ କି ଚମତ୍କାର ସେ ତ ସୁକୁମାର",
          "ଶୃଙ୍ଗାର ମଙ୍ଗଳ ମୂରତି କିଶୋର",
          "ତାହା ମନମୁନ ତୋ କଠିନ ସ୍ତନ",
          "ଗଳିଲା କି ଏଥୁଁ ବଳିଲା କି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରଜତେ ରଜତ ଶାତକୁମ୍ଭେ ଶାତ",
          "-କୁମ୍ଭ ସିନା ଝଳେ ଜଗତେ ବିଦିତ",
          "ଜମ୍ବୁନଦସାର ତଳରେ ମସାର",
          "ଝଳିଲା କି ତାପ ଟଳିଲା କି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଜଗଦ୍ଦେବ ବାଲୁକେଶ ବସୁନ୍ଧରା",
          "ବଳୟ ଅମରପତି ବୋଲେ ତ୍ୱରା",
          "ଖେଦତିମିରକୁ ମଦ କଉମୁଦୀ",
          "ଗିଳିଲା କି କାଳ ମିଳିଲା କି"
        ]
      }
    ]
  },
  "sources": [
