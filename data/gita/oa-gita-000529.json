{
  "id": "oa-gita-000529",
  "name": {
    "en": "Kali jaha kale sakhi nagara raja",
    "or": "କାଲି ଯାହା କଲେ ସଖୀ ନାଗର ରାଜ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000056"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kali-jaha-kale-sakhi-nagara-raja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାଲି ଯାହା କଲେ ସଖୀ ନାଗର ରାଜ",
          "କହିବାକୁ ବଡ଼ ଲାଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯମୁନା ସ୍ନାହାନେ ଗଲି ଘଷି ମାଜି ହେଉଥିଲି",
          "ଏ କାଳରେ ମିଳିଗଲେ ମୁରଲୀଭୁଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଦମ୍ବ ମୂଳରେ ଲୁଚି ଦେଖୁଥିଲେ ଆଡ଼େ ଘୁଞ୍ଚି",
          "ଅତରକେ ମୁଁ ନ ଜାଣେ ସେ ଭଙ୍ଗୀବ୍ରଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସାରି ମୁଁ ସ୍ନାନ ମାଜଣା ଘାଟ ପାଶେ ଜଗଜିଣା",
          "ବାଟ ଓଗାଳି ମାଗିଲେ ଅପୂର୍ବ ଚିଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବହୁତ ବିନୟ ହେଲି ତାଙ୍କ ଫାନ୍ଦୁ ଉବୁରିଲି",
          "ବୋଲେ ବନମାଳୀ ଏହା ନୁହଇ ବ୍ୟାଜ"
        ]
      }
    ]
  },
  "sources": [
