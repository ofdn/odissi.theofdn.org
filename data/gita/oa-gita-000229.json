{
  "id": "oa-gita-000229",
  "name": {
    "en": "Mina nayana khinna hebani mo bina",
    "or": "ମୀନନୟନା ଖିନ୍ନ ହେବନି ମୋ ବିନା"
  },
  "composer": "oa-person-000052",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mina-nayana-khinna-hebani-mo-bina-meena-nayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୀନନୟନା ଖିନ୍ନ ହେବନି ମୋ ବିନା ସେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୀରଦ ନୀଳ କୁଣ୍ଡଳୀ ଚଞ୍ଚଳା ରସନା ଚାଳି",
          "ବକାଳି ଦଶନାବଳୀ ସଜନୀ ରେ ।",
          "ବିଷାଇ ଦେଲା ଧରାଳି ମଣ୍ଡୁକ ଅଗୁଁ ତା ଗିଳି",
          "ତାହା ଭେକେ ଜାଣି ଆର୍ତ୍ତେ ରଟିବା ଶୁଣି ।",
          "(ପଡ଼ି)",
          "ଘନଘନ ସ୍ୱନ ଶୁଣି ଛନ୍ନଛନ୍ନ ହେବ ମନ",
          "ମୀନକେତନ ଶରେ ଅପଘନ କମ୍ପନ",
          "ମୁଞ୍ଚିବ ନୟନରୁ ଥନଥନ କରି ବନ",
          "ଭବନ କାନନ ସମାନ ମଣୁଥିବ ମୋ ଧନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦମ୍ଭୋଳି ବାଦ୍ୟ ବାଜିଲା ସପ୍ତସ୍ୱରେ ବରଷିଲା",
          "କେକୀ ନର୍ତ୍ତକୀ ନାଚିଲା ସଜନୀ ରେ ।",
          "ଡାହୁକ ସ୍ୱନ ମିଶିଲା କାମରାଣ ବିଜେ କଲା",
          "ବିଯୋଗିନୀ କୁଳ ହେଜି ହେଲେ ଆକୁଳ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜାତି କଦମ୍ବ ମାଳତୀପନ୍ତି କନ୍ଦଳୀ ଫୁଟନ୍ତି",
          "ମକରନ୍ଦ ପାନେ ମାତି ସଜନୀ ରେ ।",
          "ଶିଳୀମୁଖ ଝଙ୍କାରନ୍ତି ଶକ୍ରାୟୁଧ ଦେଖି ଭୀତି",
          "ମନେ ମାନସ ଘେନି ସେ ତ ନୂତନା କାମିନୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦଣ୍ଡେ ହେବ ଏତେ ସରି ପିଣ୍ଡୁ ଜୀବ ଯା ବାହାରି",
          "ଦଣ୍ଡ ଦଣ୍ଡକେ ଏପରି ସଜନୀ ରେ ।",
          "ଚାଣ୍ଡେ ମରୁଥିବ ଗୋରୀ ଖଣ୍ଡପରଶୁ ପୁଝାରୀ",
          "ଭାଗୀରଥୀ ବୋଲେ ଆହା ଧାତା କି କଲେ"
        ]
      }
    ]
  },
