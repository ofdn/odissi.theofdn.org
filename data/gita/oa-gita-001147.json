{
  "id": "oa-gita-001147",
  "name": {
    "en": "Bada ananda re aji",
    "or": "ବଡ଼ ଆନନ୍ଦ ରେ ଆଜି"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000083"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bada-ananda-re-aji-mangala-gujjari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଡ଼ ଆନନ୍ଦ ରେ ଆଜି ଲାଗିଛି ଗୋପର ଦାଣ୍ଡେ",
          "ନାନା କୁତୂହଳେ ନାଚନ୍ତି ଗୋପାଳେ",
          "ହରି ହରି ବୋଲି ତୁଣ୍ଡେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରୂପକ ମନ୍ଦିରା ତାଳ ବାଜେ ଘନଘନ",
          "ସେ ତାଳ ବାଜେ ଘନଘନ",
          "କଟୀରେ କିଙ୍କିଣୀ ବାଜେ କିଣିକିଣି",
          "ସୁବଳୟ ଝଣଝଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେ ହସ୍ତକ କରଇ କେ କରଇ ଉକୁଟ",
          "ଝାଁ ଝାଁ ଝନକୃତ ଥୈ",
          "ଗତେ ତାଥେଇ ତାକିଟା",
          "ଥେଇ ଧ୍ରୀମି ଖିଟା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେ ଆଳାପ କରେ ସା ସା ସାରିଗମ ପଦ",
          "ମଙ୍ଗଳଗୁଜ୍ଜରୀ ରାଗରେ ମହୁରୀ",
          "ସୁସ୍ୱରେ କରଇ ନାଦ",
          "କେ ଊର୍ଦ୍ଧ୍ୱକୁ ହସ୍ତ ଟେକି ଗାନ କରେ ଉଚ୍ଚେ",
          "କେବଣ ଗଉଡ଼ ବୁଢ଼ା ମହାଖୁଡ଼",
          "ଲଇଁ ଲଇଁ କରି ନାଚେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେ ଗାଏ ଗଉଡ଼ ଗୀତ କରିଣ ଢମାଳି",
          "ଗୋବିନ୍ଦନଙ୍କୁ କନ୍ଧେ ବସାଇ ଆନନ୍ଦେ",
          "ନନ୍ଦ ନାଚେ ଢଳି ଢଳି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କାମସେଣା ସୁଷେଣ ଆବର ଚନ୍ଦ୍ରସେଣ",
          "ବାହୁ ଦୋହଲାଇ ନାଚନ୍ତି ଗେହ୍ଲାଇ କରି",
          "ଲୋକ ହରଷଣ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗଗନେ ଦେଖନ୍ତି ଦେବେ କରି ଏକ ଦୃଷ୍ଟି",
          "ବୋଲେ ଗୌର ଦ୍ୱିଜ ବ୍ରଜପୁରେ ଆଜି",
          "ହରି ନାମାମୃତ ବୃଷ୍ଟି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
