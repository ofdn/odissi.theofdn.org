    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Tha Patala",
      "or": "ଥ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/thapire-kaha-tathapi-re-priya-sakhi-tha-champu-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଥାପିରେ କହ ତଥାପି ରେ ପ୍ରିୟସଖି",
          "ଥିବି କି ଛାଡ଼ିବି ପ୍ରାଣ ।ପଦ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଥିଲା ପରି ସ୍ନେହ ଲାଗିଲା କି କହ",
          "ଅଛିଟି ତୋତେ ମୋ ରାଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଥକାଇ ତୁ କହୁ କହୁ ଧୃତି ରହୁ",
          "ନାହିଁଟି ମୋହର ଜାଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଥୋକାଏ ତୋ ପ୍ରୀତି ବିଧିକି ସମ୍ମତି",
          "କଲେ କି ମୋ ପରିତ୍ରାଣ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଥରେ ହେଲେ ବିକିହେବି ମୋତେ ନିକି",
          "ବଞ୍ଚାଇବ ପଞ୍ଚବାଣ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଥୋଇ ହୃଦେ ଛଳ ନ କର ବିକଳ",
          "କହେ ଅଷ୍ଟଦୁର୍ଗ ରାଣ"
        ]
      }
    ]
  },
