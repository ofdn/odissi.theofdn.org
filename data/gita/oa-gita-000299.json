{
  "id": "oa-gita-000299",
  "name": {
    "en": "Syama sri ange netra padila re",
    "or": "ଶ୍ୟାମ ଶ୍ରୀଅଙ୍ଗେ ନେତ୍ର ପଡ଼ିଲା ରେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-sri-ange-netra-padila-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ଶ୍ରୀଅଙ୍ଗେ ନେତ୍ର ପଡ଼ିଲା ରେ",
          "ପଡ଼ି ବିବେକ ଜ୍ଞାନ ବୁଡ଼ିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ଶୋଭା ସେ ମୋହନ ମୂରତି ନବଘନ",
          "ମନ ତା ସଙ୍ଗ ପ୍ରୀତି ଲୋଡ଼ିଲା ରେ",
          "ଚନ୍ଦ୍ରିକା ମୁକୁଟିଆ ହଟ ନଟକୂଟିଆ",
          "ଛବିକି କେ ବିନ୍ଧାଣୀ ଗଢ଼ିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜୀବନ ଯଉବନ ଜାତି ଧୃତି ଗୁମାନ",
          "ସବୁ ତା ପାଦ ତଳେ ପଡ଼ିଲା ରେ",
          "କି ଘର ବର ଛାର କିବା ବନ୍ଧୁ ସୋଦର",
          "ପତିବରତ ମୂଳ ତାଡ଼ିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୁରୁ ଗୁରୁଜନଙ୍କ ଗୁରୁ ଧରମଯାକ",
          "ଚାରୁ ମୁରଲୀ ସ୍ୱନେ ଏଡ଼ିଲା ରେ",
          "ସରୁ କଟି ସୁଠାଣି ବାଙ୍କ ବାଙ୍କ ଚାହାଣୀ",
          "ଶାୟକ ମୁନ ହୃଦେ ବୁଡ଼ିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୃନ୍ଦାବନ ମଦନ ସୁଖାନନ୍ଦ ସଦନ",
          "ରୂପ କାନ୍ତିରେ ମତି ଜଡ଼ିଲା ରେ",
          "କହଇ ବନମାଳୀ ଏ ରସେ ଭାଳି ଭାଳି",
          "ଗୋପୀଙ୍କ ପ୍ରେମନଦୀ ବଢ଼ିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
