{
  "id": "oa-gita-000128",
  "name": {
    "en": "Kahibaku laja sakhi jaha hela",
    "or": "କହିବାକୁ ଲାଜ ସଖୀ ଯାହା ହେଲା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahibaku-laja-sakhi-jaha-hela-aja-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହିବାକୁ ଲାଜ",
          "ସଖୀ ଯାହା ହେଲା ଆଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପହୁଡ଼ିଥିଲେ ଜଣା ନ ଥିଲା ମୋତେ ବୀଣା",
          "ଆଳାପେ ଲଗାଇଲି ଗେଲେ ଲୟ",
          "କାନ୍ତ ମୋ ଗଣ୍ଡେ ଆସି ଚୁମ୍ବିଲେ ପରଶଂସି",
          "ମରଣୁ ବଳିଗଲା ସେ ସମୟ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଖସିପଡ଼ିଲା କରୁ ବିପଞ୍ଚୀ ଧରୁ ଧରୁ",
          "ମେରୁ ଗରୁଆ ହେଲା ଗଭାଫୁଲ",
          "ଟେକି ନୋହିଲା ମୁଖ ତହିଁ ପଞ୍ଚବିଶିଖ",
          "ଚଣ୍ଡାଳ କଲା କେତେ କଲବଲ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚୁମ୍ବିଲେ ଅଙ୍ଗସୀମା ଜାତ ପୁଲକରମା",
          "ଶୀତ୍କାର ଉପୁଜିଲା ବାରମ୍ବାର",
          "ନିବିଡ଼ ଭୁଜବନ୍ଧୁ ଛାଡ଼ି ନ ଦେଲେ ବନ୍ଧୁ",
          "ପଳାଇବାକୁ କାହିଁ ରାହା ମୋର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେତେ କଥାକୁ ଏତେ ଦଶା ଲଭିଲି ଚିତ୍ତେ",
          "କି ନ କଲା ଏ ଲାଜ ଘେନ ମନେ",
          "କିପରି ଗୋ ସଙ୍ଗାତ ବିପରୀତ ସୁରତ",
          "ରସକୁ ରସୁଥାନ୍ତି ବାମାମାନେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହଇ କବିସୂର୍ଯ୍ୟ ଶୁଣ ପଣ୍ଡିତ ଆର୍ଯ୍ୟ",
          "ହେଲେ ହୋଇବ ଏକ ଗୁଣ ଲୋପ",
          "ଆଉ ପାପ ସଙ୍ଗୀତ ବିଦ୍ୟା ସଧରେ ଚିତ୍ତ",
          "ନ ଦେବି ବୋଲି କଲି ସଂକଳପ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
