{
  "id": "oa-gita-000708",
  "name": {
    "en": "Bandhu achi ki loda",
    "or": "ବନ୍ଧୁ ଅଛି କି ଲୋଡ଼ା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000009"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bandhu-achi-ki-loda-kedara-adatali-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବନ୍ଧୁ ଅଛି କି ଲୋଡ଼ା",
          "ନୂଆ ନିଆଳୀ ନିର୍ମିତ ଚୂଡ଼ାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପରମାଧିକାରେ ଫରମାସୁ ଥିବୁ",
          "ମୋଠାରେ ବରଜି ବ୍ରୀଡ଼ା ରେ",
          "ମନ ଥାଇ ଲାଜଭର ବଶୁଁ ବ୍ୟାଜ",
          "ଛନ୍ନ କଲେ ବଡ଼ ପୀଡ଼ା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ ପାଇବା ସୁଖ ମୋ ଆଗେ ଶ୍ରୀମୁଖ",
          "ନୋହିଲେ ସଙ୍କୋଚ ଛଡ଼ା ରେ",
          "ଚିତ୍ତେ ଥାଉ ମୁଁ ତୋ ସଙ୍ଗୀତ ଜଗତି",
          "ବାହୁଡ଼ା ବିଜେ ପାହାଡ଼ା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଇଚ୍ଛା ମାଫିକେ ତୋ ବିଛଣା ବନାଇ",
          "ଦିଆଇବି ହୋଇ ଛିଡ଼ା ରେ",
          "ଅଣା ଅଛିକି ବହୁତ ବାସନ୍ତିକ",
          "ବାସ କୁସୁମ ପାଖୁଡ଼ା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଇରିନ୍ଧ୍ରକାକୁ ସହି କହୁଥା ତୁ",
          "ଆଜ ହୋଇବ ନିବିଡ଼ା ରେ",
          "ଅଂସ ଅବତଂସ ଲହସା ଖୋସା କି",
          "କି ବେଣୀ ଲୋଟଣୀ ଜୂଡ଼ା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଳପକେ ଯେ ହେଉଥାଏ ତରୁଣ",
          "ତରୁଣୀଙ୍କ ଘରବୁଡ଼ା ରେ",
          "ଧନ ଚିନ୍ତିଲେ ଆମ୍ଭର ବଶମ୍ବଦ",
          "ହେବ ସେ ସ୍ମର ବାପୁଡ଼ା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ନ ମାନିବ ଯେବେ ଦଣ୍ଡକେ ମହତ୍ତ୍ୱ",
          "ବନାଇ ଦେବା ଦିକଡ଼ା ରେ",
          "ଜଗଦ୍ଦେବ ଗୀତେ ବୋଲେ କର ମୋତେ",
          "ଅଳପ ତଳପଗଡ଼ା ରେ"
        ]
      }
    ]
  },
  "sources": [
