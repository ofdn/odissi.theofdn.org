  "id": "oa-gita-000748",
  "name": {
    "en": "Kaliya mardana sarira",
    "or": "କାଳୀୟ ମର୍ଦ୍ଦନ ଶରୀର"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000135"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaliya-mardana-sarira-nalinigouda-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାଳୀୟ ମର୍ଦ୍ଦନ ଶରୀର",
          "କାନ୍ତି ଚାହିଁ ନୁହେଁ ଭ୍ରାନ୍ତି କାହାର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁରଭୀ ନିକର କୁମାରୀ ସୂର୍ଯ୍ୟର",
          "ବୋଲି ଧାଉଁଛନ୍ତି ହୋଇ ତୃଷାତୁର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବରହୀ ନିବହ ମଣି ବାରିବହ",
          "ଉତ୍ସୁକିତ ହେଉଛନ୍ତି ନିରନ୍ତର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବଲ୍ଲବୀ ତମାଳ ଭାଳି ତହୁଁ ଦଳ",
          "ଉତ୍ତଂସାର୍ଥରେ ତୋଳିବାକୁ ବିଚାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆମ୍ଭଙ୍କୁ ରକ୍ଷା କରନ୍ତୁ ପୂତରୁକ",
          "ଶ୍ରୀ ପ୍ରତାପରୁଦ୍ର ଭଣିଲେ ଏ ଗିର"
        ]
      }
    ]
  },
  "sources": [
    {
