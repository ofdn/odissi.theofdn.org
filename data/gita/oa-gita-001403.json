{
  "id": "oa-gita-001403",
  "name": {
    "en": "Rakha rakha rasika re ghana kuntala",
    "or": "ରଖ ରଖ ରସିକା ରେ ଘନକୁନ୍ତଳା"
  },
  "composer": "oa-person-000131",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rakha-rakha-rasika-re-ghana-kuntala-radha-prema-lila-biswambhara-rajendradeba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "( ରାଧାପ୍ରେମ ଲୀଳା )",
          "ରଖ ରଖ ରସିକା ରେ ଘନକୁନ୍ତଳା",
          "ତୋ କରକୁ କଳାକାଚ ମାନିବ ପରା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏ ଅଙ୍ଗକୁ ସଙ୍ଗିନୀ କୁଶପାଣି ବିନ୍ଧାଣୀ",
          "ଅଜାଡ଼ି ସୁରସ କେତେ ସଜାଡ଼ିଥିଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହେଉ କର ମୋ ଧନ ସଉତୁଣୀମର୍ଦ୍ଦନ",
          "କଉତୁକେ ପିନ୍ଧାଇବି ହେଲେ କି ହେଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମିତ ମନେ ନ ପାଞ୍ଚ ଲୀଳାବତୀ ଏ କାଚ",
          "ଚିତ୍ତକୁ ପାଇଲା ପରି ମୂଲା ଗୋ ମୂଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରେ ଲଳନାକୁସୁମ ଦେଖ ଏହା ସୁଷମ",
          "ଚନ୍ଦ୍ରାବଳୀ କେତେ ରୂପେ ମତେ ମାଗିଲା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପଚାରୁଛି ସହୀକି ଏହୁ ଚନ୍ଦ୍ରମୁହୀଁକି",
          "ଏ ସରିକି ସତେ କେତେ ବୟସ ହେଲା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏ ବଚନେ ଶ୍ରୀମତୀ କହିଲେ ଏ ଭାରତୀ",
          "ଶ୍ରୀ କିଶୋରଚନ୍ଦ୍ର ସେ ବିଭୁଙ୍କୁ ବନ୍ଦିଲା"
        ]
      }
    ]
  },
  "sources": [
