{
  "id": "oa-gita-000106",
  "name": {
    "en": "Ahe siba gouri tumbhe",
    "or": "ଆହେ ଶିବ ଗୌରୀ ତୁମ୍ଭେ"
  },
  "composer": "oa-person-000045",
  "mula_raga": [
    "oa-raga-000086"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-siba-gouri-gauri-tumbhe-na-dela-dekha-he/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହେ ଶିବ ଗୌରୀ ତୁମ୍ଭେ ନ ଦେଲ ଦେଖା ହେ",
          "ଶିବ ଶିବ ବୋଲି ହର ପଡ଼ୁଛି ଡକା ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମହା ମହିମା ତୁମ୍ଭର ତିନିପୁରେ ଅଗୋଚର",
          "ବସିବା ସ୍ଥାନ ତୁମ୍ଭର କୈଳାଶ ଶିଖା ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରହ୍ମାରେ ହେଲ ବିବାଦୀ ଚାପୋଡ଼ାକେ ଶିର ଛେଦି",
          "ରହିଲ ପାତାଳ ଭେଦି ଚନ୍ଦ୍ରମା ରେଖା ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସମୁଦ୍ର ମନ୍ଥନ କାଳେ ବିଷ ଉପୁଜିଲା ଜଳେ",
          "ଏକା ଦେବତାଙ୍କ ଛଳେ ସେ ବିଷଚଖା ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହେ ରଘୁନାଥ ସୁତ ତୁମ୍ଭ ଚରଣେ ଆଶ୍ରିତ",
          "ଆତଙ୍କ କାଳକୁ ନାଥ ହୋଇବ ସଖା ହେ"
        ]
      }
    ]
  },
  "sources": [
