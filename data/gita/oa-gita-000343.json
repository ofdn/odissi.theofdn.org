{
  "id": "oa-gita-000343",
  "name": {
    "en": "Ehi katha niki katha",
    "or": "ଏହି କଥା ନିକି କଥା  ରେ"
  },
  "composer": "oa-person-000060",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ehi-katha-niki-katha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏହି କଥା ନିକି କଥା ରେ ସଜନୀ",
          "ଯାକୁ ନ ଦେଖିଲେ ଆକୁଳରେ ଝୁରୁ",
          "ତାକୁ ଦେଖି ପୋତୁ ମଥା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ଶ୍ୟାମସୁନ୍ଦର ଯୁବା ପୁରନ୍ଦର",
          "ତୋ ଲାଗି ପାଉଛି ବ୍ୟଥା",
          "କ୍ଷୀର ନୀର ଠାରୁ ଅଭେଦ ପୀରତି",
          "କି ଘେନି ତା କରୁ ବୃଥା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିରନ୍ତରେ ନୀର ନେତ୍ରୁ ଧାର ଧାର",
          "ବହି ଜରଜର ଛାତି",
          "ନ ବସଇ ସେ ଯେ ନବଦଳ ଶେଯେ",
          "ଶୟନ ଦିବସ ରାତି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗିରିଧର ବେଶ ବସନେ ପ୍ରସନ୍ନ",
          "ଲେଶ ନାହିଁ ବଂଶୀଭାର",
          "ଭ୍ରମର ଝଙ୍କାର ଶୁଣି ଚମକଇ",
          "କାମଶରେ ଭ୍ରମ ତାର ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୃଣାଳର ମାଳ ଧରି ନନ୍ଦବାଳ",
          "ଜପୁଅଛି ରାଧେ ରାଧେ",
          "ତୋ ମୂରତି ଚିନ୍ତି ଛାତିକି ଭିଡ଼ଇ",
          "ଚୁମ୍ବଦାନେ ମନ ବୋଧେ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସାତ୍ୱିକ ଅଧିକ ବଢ଼ିବାରୁ ଧିକ",
          "କରଇ ବିବେକ ହେଜି",
          "ମୋହନରାଜ ମୋହରେ ପଡ଼ୁଅଛି",
          "ବହନ ଚେତନ ତେଜି ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦୂତୀ ବାଣୀ ଶୁଣି କେଳିମତି ଭଣି",
          "ମରଇଁ କି ନା କି ଭାଷି",
          "ବୋଲେ ହରି ପ୍ରାଣବନ୍ଧୁଙ୍କୁ ଦେଖିଣ",
          "ରତିରସେ ଯାଏ ଭାସି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
