{
  "id": "oa-gita-001241",
  "name": {
    "en": "Janathila ki re bina bachana",
    "or": "ଜଣାଥିଲା କି ରେ ବୀଣାବଚନା"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000061"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/janathila-ki-re-bina-bachana-lalitaa-biramitrodaya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଣାଥିଲା କି ରେ ବୀଣାବଚନା ସତେ",
          "ବଣା କରାଇବୁ ଛନ୍ଦ ବହି ଅନ୍ତର୍ଗତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପରବ ଚନ୍ଦ୍ରକୁ ଧରି ପିଇବାରେ ଆଶା କରି",
          "ଜନ୍ମିବ ଗରଳ ବୋଲି ଥିଲା କି ପରତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୋଳି କର୍ପୂରର ଧୂଳି ଦେଲେ କଳେବର ବୋଳି",
          "ଅନଳକୁ ବଳି ଜ୍ୱାଳା କରିବ ନିରତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଣାଇ ସୁରଧୁନୀର ପିଅନ୍ତେ ସୁସ୍ୱାଦୁ ନୀର",
          "ଦ୍ୱିଗୁଣ ତୃଷା ଜନ୍ମିବ ବୋଲି ଏ ମରତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜନମରୁ ଥିବ କରି ଯେ ଯାହାକୁ ପ୍ରାଣ ପରି",
          "କରତି ଦେବ ସେ ଛାତି କଠିନ କରତେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ବୀରମିତ୍ରୋଦୟ ସିଂହ ଏପରି ନିର୍ଦ୍ଦୟ",
          "ପଣ ତ ଦେଖାଇ ନାହିଁ କେବେ ମୋ ପୁରତେ"
        ]
      }
    ]
  },
  "sources": [
    {
