    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gati-mora-nandanandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗତି ମୋର ନନ୍ଦନନ୍ଦନ",
          "ଗଲେ ଯାଉ ପଛେ ସଖୀ",
          "ତାର ଲାଗି ଏ ଜୀବନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେଲେ ହେଉ ଅପବାଦ । ତହିଁକି ନାହିଁ ମୋ ଖେଦ ।",
          "ସେହି ସିନା ମୋ ସନମାନ ।",
          "(ପଡ଼ି‌)",
          "ଯାଉ ଗୋ ମାନ ମହତ । ନ ତେଜିବି ନନ୍ଦସୁତ ।",
          "କଳାକାହ୍ନୁ ମୋର ଗଣ୍ଠିଧନ ତ ।",
          "ସେ ତ ମୋର ଗଳାହାର । ନଟବର ସୁନ୍ଦର ।",
          "ମୂରୁଛି ନ ପାରିବି ଗୋ ହୃଦଚନ୍ଦନ"
        ]
      }
    ]
  },
