{
  "id": "oa-gita-000552",
  "name": {
    "en": "Ki nama boilu tuhi go lalite",
    "or": "କି ନାମ ବୋଇଲୁ ତୁହି ? ଗୋ ଲଳିତେ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-nama-boilu-tuhi-go-lalite/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ରାଧା ପଚାରନ୍ତି ସଙ୍ଗାତରେ",
          "କେ ସେ ବ୍ରଜରାଜ ସୁତ ?",
          "ଲଳିତା କହନ୍ତି ମିତଣିରେ",
          "ମୋହ ହୋଇଗଲୁ ସେ ଦିନ ଶୁଣି ତୁ",
          "ଯାହାର ମୂରଲୀ ଗୀତରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରାଧା – କି ନାମ ବୋଇଲୁ ତୁହି ଗୋ ଲଳିତେ",
          "ଲଳିତା – ପୁଣି ଶୁଣିବାକୁ ଚିତ୍ତ ବଳିଲା କି",
          "କୃଷ୍ଣ ବୋଲି ଥିଲି କହିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରାଧା – କେ ଚିତ୍ରପଟର ଯୁବା ?",
          "ଲଳିତା – କୃଷ୍ଣ ବୈଣବିକ ଚିତ୍ର ତିନିଯାକ",
          "ଏଇ ତରୁଣ ମଘବାରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାଧା – ବୟସ କେତେ ତାଙ୍କର ?",
          "ଲଳିତା – ନବ ତରୁଣିମା ଅବସ୍ଥା ବୟସ",
          "ହୋଇଥିବ ବାର ତେରରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାଧା – କେଡ଼େ ଭଳି ଉଚ୍ଚ ହେବେ ?",
          "ଲଳିତା – ତୁ ତାଙ୍କ ଶ୍ରୁତିତଟକୁ ସରି ହେବୁ",
          "ଅନୁମାନୁଛି ମୁଁ ଏବେ ରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ରାଧା – ବିବାହ ହୋଇଲେନି କି ?",
          "ଲଳିତା – ବଧୂ ସଧେ ହାତ ଭାଙ୍ଗି ହେଉଛନ୍ତି",
          "ଯଶୋଦା ତୋତେ ବିଲୋକିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ରାଧା – ମୋ ଆଡ଼କୁ କେଣେ ଢାଳୁ",
          "ଲଳିତା – ଯଥାଯୋଗ୍ୟ ବୋଲି ମନ ଲୋଭାଇଲା",
          "କଥାକୁ କାହିଁକି ଛଳୁରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ରାଧା – ଏହି ଗୋପରେ କି ବାସ ?",
          "ଲଳିତା – ଆମ୍ଭ ଅଟ୍ଟାଳି ଆରୋହିଲେ ଦିଶୁଛି",
          "ତାଙ୍କ ସଉଧ କଳଶରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ରାଧା – ଶ୍ରୀଅଙ୍ଗ କାନ୍ତି କିପରି ?",
          "ଲଳିତା – ମଜା ଇନ୍ଦ୍ର ନୀଳମଣି ଦରପଣ",
          "ପରି ଦିଶୁଛି ମାଧୁରୀରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ରାଧା – କୃଶ ନା ପୁଥୁଳ ତନୁ ?",
          "ଲଳିତା – ଦେଖାଇ ଦେବି ରହିଥାଅ ଆସିବେ",
          "ଏବେ ତ ଲେଉଟି ବନୁରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ରାଧା – ମୁଖ ସୁଷମା କେମନ୍ତ ?",
          "ଲଳିତା – ଲାବଣ୍ୟାମ୍ବୁଧିସମ୍ଭବ ବିଧୁ ପରି",
          "ଅଳକାବଳି ଆବୃତରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ରାଧା – ଚିକୁର ଓଘ ମଞ୍ଜୁଳ ?",
          "ଲଳିତା – କାଳିନ୍ଦୀ ଜଳ କଲ୍ଲୋଳ ପରି ଦିଶେ",
          "କଳାକୁ ଉଣା କଜ୍ଜ୍ୱଳରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ରାଧା – ଲଲାଟପଟର ଝଳି ?",
          "ଲଳିତା – ତିଳକ ଘେନି ହେବା ଚାହିଁ ରମାର",
          "ଧୃତିମେରୁ ଯିବ ଟଳିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ରାଧା – ଘେନିବାର କି ତିଳକ ?",
          "ଲଳିତା – ଚନ୍ଦନ ବିନ୍ଦୁ କେବେ ଗୋରଚନାର",
          "ଚିତା ଯେମନ୍ତ ସାୟକରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ରାଧା – ଭୂରୁ ବିଳାସ କୀଦୃଶ ?",
          "ଲଳିତା – କଳା ଭୁଜଙ୍ଗ ଶାବକ ଖେଳା ପରି",
          "ସ୍ୱଚ୍ଛେ ହୋଇଛି ପ୍ରକାଶରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 16,
        "lines": [
          "ରାଧା – ହୋଇଛି ସେ କି ଆକୃତି ?",
          "ଲଳିତା – ପରଶୁ ଭଗ୍ନ କୋଦଣ୍ଡ ବେନି ଖଞ୍ଜା",
          "ହୋଇଛି ତ ସ୍ଫୂର୍ତ୍ତିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 17,
        "lines": [
          "ରାଧା – ଭାଷ ଈକ୍ଷଣର ରୀତି ?",
          "ଲଳିତା – ଦର କଷାୟିତ ହୋଇ ଆଘୂର୍ଣ୍ଣିତ",
          "ଶ୍ରୁତିତଟ ଯାଏ ଗତିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 18,
        "lines": [
          "ରାଧା – କିପରି ଚାହାଣୀ ଆଣି ?",
          "ଲଳିତା – ପ୍ରମତ୍ତ ନଟ ଖଞ୍ଜରୀଟ ଶୋଭାକୁ",
          "ଈଷିତିରେ ଦେବ ଜିଣିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 19,
        "lines": [
          "ରାଧା – କଟାକ୍ଷ ପ୍ରାନ୍ତ କେମନ୍ତ ?",
          "ଲଳିତା – ଜଗଜ୍ଜୟ ମନମଥର ନିଶିତ",
          "ବରିଛ ମୁନ ଯେମନ୍ତରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 20,
        "lines": [
          "ରାଧା – ନାସାର ସଉଷ୍ଠବତା ?",
          "ଲଳିତା – ତୁଚ୍ଛ ତିଳଫୁଲ କି ତୁଳନା ହେବ",
          "ଗଢ଼ିବ ନାହିଁ ବିଧାତାରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 21,
        "lines": [
          "ରାଧା – କି ଭୂଷା ନାସାପୁଟରେ ?",
          "ଲଳିତା – ମୁକୁତା ବସଣୀ ରୋହିଣୀ ପରାଏ",
          "ଶୋଭୁଅଛି ମୁଖଚନ୍ଦ୍ରରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 22,
        "lines": [
          "ରାଧା – ଗଣ୍ଡମଣ୍ଡଳର ଦ୍ୟୁତି ?",
          "ଲଳିତା – ସ୍ମର ତମହର ଯୁବତୀ ସୃଷ୍ଟିର",
          "ଖଣ୍ଡ ଚନ୍ଦ୍ରପରି କାନ୍ତିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 23,
        "lines": [
          "ରାଧା – ଶ୍ରବଣ କାହା ସଦୃଶ ?",
          "ଲଳିତା – ଜନ-ମନ-ମୃଗ ବନ୍ଦୀ କରିବାକୁ",
          "ମଦନ ଫାନ୍ଦିଛି ପାଶରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 24,
        "lines": [
          "ରାଧା – ଅଛି କି କି ଆଭରଣ ?",
          "ଲଳିତା – ମକରାକୃତି ନବରତ୍ନ କୁଣ୍ଡଳ",
          "ମିହିର ଦର୍ପ ଦାରଣରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 25,
        "lines": [
          "ରାଧା – କି ଭୂଷା ଏଥି ଉପରେ ?",
          "ଲଳିତା – ହୀରା ଗୁଣା ବର ମୁକୁତା ଝାଲର",
          "ଝଲକା ବାମ କର୍ଣ୍ଣରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 26,
        "lines": [
          "ରାଧା – ଓଷ୍ଠ ଦେଶର ଶୋଭନ ?",
          "ଲଳିତା – କାହାପରି ବୋଲି ଜଣାଇବି ଜବା",
          "ବଧୂଲି ଅତି ନିଊନରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 27,
        "lines": [
          "ରାଧା – ଦଶନ ପନ୍ତି ସୁଷମା ?",
          "ଲଳିତା – କର୍ପୂର ମଜା ମାଣିକ୍ୟ ଆବଳୀର",
          "ଛଡ଼ାଇଦେବ ଗାରିମାରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 28,
        "lines": [
          "ରାଧା – ଚିବୁକର ସୁମାଧାରୀ ?",
          "ଲଳିତା – ଶୁଦ୍ଧ ଚତୁର୍ଥୀ ସୁଧାଂଶୁ ପରି ଦିଶେ",
          "ଚାହିଁଦେଲେ ଝଟକରିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 29,
        "lines": [
          "ରାଧା – କଣ୍ଠଦେଶ ରମଣୀୟ ?",
          "ଲଳିତା – ହରିକର ଦରାକୃତି ରେଖାତ୍ରୟ",
          "ଯୁବତୀ ସୃଷ୍ଟିର ଧ୍ୟେୟରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 30,
        "lines": [
          "ରାଧା – କି କି ଅଳଙ୍କାର ଅଛି ?",
          "ଲଳିତା – ରତ୍ନ ଚାପସରି ହେମର ନିଆଳୀ",
          "ସୁତା ପଦକ ଲାଗିଛିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 31,
        "lines": [
          "ରାଧା – କୀଦୃଶ ବାହୁ ଯୁଗଳ ?",
          "ଲଳିତା – କରୀକରାକୃତି ପ୍ରେମରତ୍ନ କୋଷ",
          "ହୃଦ କବାଟ ଅର୍ଗଳରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 32,
        "lines": [
          "ରାଧା – ଅଛିଟି କି ଅଳଙ୍କାର ?",
          "ଲଳିତା – ଦିବ୍ୟରତ୍ନ ବାଜୁବନ୍ଧ ଅଙ୍ଗଦରେ",
          "ଭୂଷଣ ହୋଇଛି କରରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 33,
        "lines": [
          "ରାଧା – କମନୀୟ ଅଙ୍ଗୁଳିର ?",
          "ଲଳିତା – ଚମ୍ପକ କଳିତା ଆକୃତି ରତନ",
          "ମୁଦ୍ରିକାରେ ମନୋହରରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 34,
        "lines": [
          "ରାଧା – କାନ୍ତି ସେ କରରୁହର ?",
          "ଲଳିତା – ହୀରା ପରାଏ ଜ୍ୟୋତି ଧୀରା ଧୀରାର",
          "ବିବେକ ବନ କୁଠାରରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 35,
        "lines": [
          "ରାଧା – କିପରି ହୃଦୟସ୍ଥଳୀ ?",
          "ଲଳିତା – ମନମଥ କୁନ୍ଦ-ବସା-ସୁରୁଚିର",
          "ବାସବ ରତନ ଥାଳୀରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 36,
        "lines": [
          "ରାଧା – ହୀରାମାନ କି ଅଛି ନା ?",
          "ଲଳିତା – ଥାଉ ହାର, ସୁନାଗାର ପଦଚିହ୍ନ",
          "ଦିଶୁଚି କେଡ଼େ ଭାବନାରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 37,
        "lines": [
          "ରାଧା – କିପରି ଦିଶେ ଉଦର ?",
          "ଲଳିତା – ଅତୁଳ ମନ୍ଦ ତୁନ୍ଦ ନନ୍ଦ-ଶ୍ରୀକର",
          "ଲଳିତ ଅତି ସୁନ୍ଦରରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
        "n": 38,
        "lines": [
          "ରାଧା – ଅଙ୍କୁରଲାଣି ରୋମାଳି ?",
          "ଲଳିତା – ନୀଳ ପିପୀଳିକା-ଆବଳୀ ପରାଏ",
          "ଦିଶୁଛି ଅଳପ ଝଳିରେ । ପ୍ରାଣମିତ"
        ]
      },
      {
