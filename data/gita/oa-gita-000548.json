{
  "id": "oa-gita-000548",
  "name": {
    "en": "Ki laja paili aja re bandhabi",
    "or": "କି ଲାଜ ପାଇଲି ଆଜ ରେ ବାନ୍ଧବୀ"
  },
  "composer": "oa-person-000026",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-laja-paili-aja-re-bandhabi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଲାଜ ପାଇଲି ଆଜ ରେ ବାନ୍ଧବୀ",
          "କି ଲାଜ ପାଇଲି ଆଜ",
          "ଉରେ ଚିର ଦେଇ ତର ନ ସହଇ",
          "ଆଗରେ ନାଗର ରାଜ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚଉଦିଗେ ଚାହିଁ କେଣେ କେହି ନାହିଁ",
          "ନିଛାଟ ଘାଟକୁ ଗଲି",
          "ଅଙ୍ଗରେ କୁଙ୍କୁମ ବୋଳି ହେଉଥିଲି",
          "ଉତ୍ତାର ଅମ୍ବର ଚେଳି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପାଣି ପଲ୍ଲବରେ ଘୋଡ଼ଣା ନ ଯାଇ",
          "ବର୍ତ୍ତୁଳତର ଉରଜ",
          "ଯେତେ ଯତ୍ନ କଲେ ମହା ମହୀଧର",
          "ଢାଙ୍କଇ ନିକି ସରୋଜ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାଖେ ଘୋଡ଼ାଇଲେ ଆର ପାଖ ଦିଶେ",
          "ଉପାୟ କିଛି ନ ଦିଶେ",
          "ମୁଖ ଅବନତ କଲେ ସେ ଉନ୍ନତ",
          "ପୟୋଧର ବେନି ଠେସେ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୁନ୍ତଳ ଉହାଡ଼ି ରଖନ୍ତି ମୁଁ ଅବା",
          "ବାନ୍ଧିଥିଲି ବେଣୀ ଟେକି",
          "ବୋଲେ ବନମାଳୀ ଶୁଣ ଠାକୁରାଣୀ",
          "ଜଳେ ଲୁଚିଥାନ୍ତ ଟିକି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-laja-paili-aja-re-bandhabi/"
    }
  ],
