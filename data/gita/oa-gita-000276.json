{
  "id": "oa-gita-000276",
  "name": {
    "en": "Ahe deba gananayaka",
    "or": "ଆହେ ଦେବ ଗଣନାୟକ"
  },
  "composer": "oa-person-000054",
  "mula_raga": [
    "oa-raga-000055"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-deba-gananayaka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗଣନାୟକ ଗଉରୀନନ୍ଦନ",
          "ଆହେ ଦେବ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଈଶ୍ୱରକୁମର ଆହେ ବିଦ୍ୟାବର",
          "ମୋ କଣ୍ଠରେ ବିଜେ କର ହେ",
          "ଧୂମକେତୁ ଗଣାଧିପ ଗଣେଶ୍ୱର",
          "ଗଣପତି ଭାଲଚନ୍ଦ୍ର ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରକ୍ତବର୍ଣ୍ଣ ପଞ୍ଚଶିର ପନ୍ଦରନେତ୍ର",
          "ଦଶ କରେ ଆୟୁଧମାନ ହେ",
          "ଶିବାଳୟବାସୀ ପରମସନ୍ନ୍ୟାସୀ",
          "ଇନ୍ଦୂର ତୁମ୍ଭର ଯାନ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏକଦନ୍ତ ମହାକାୟ ଗଜାନନ",
          "ଭକ୍ତପ୍ରିୟ ଯମଐରି ହେ",
          "ବିକଟ ଲମ୍ବଉଦର ଶଂକୁବର୍ଣ୍ଣ",
          "ରକ୍ତାମ୍ବର ଭବଭକ୍ତ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଯୋନିସମ୍ଭୂତ ସୁରାସୁରବନ୍ଦିତ",
          "ସନକ ଆଦି ସମସ୍ତ ହେ",
          "ଭଣେ ହରିହର ରାୟଗୁରୁ ତୁମ୍ଭ",
          "ଚରଣେ କୋଟି ପ୍ରଣାମ ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-deba-gananayaka/"
    }
  ],
