  "name": {
    "en": "Dhale ta dhalilu nahi",
    "or": "ଢାଳେ ତ ଢାଳିଲୁ ନାହିଁ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000082"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ḍha Patala",
      "or": "ଢ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhale-ta-dhalilu-nahi-gouda-dha-champu-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଢାଳେ ତ ଢାଳିଲୁ ନାହିଁ କୃପାସୁଧା ଝରିକି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଢକ୍କା ବାଜୁଥାଇ ବ୍ରଜେ ଲଳିତାର ହୃଦମ୍ବୁଜେ",
          "କରୁଣା ଅଛି ବୋଲି ଯା ନେଲା କେ ତା ହରି କି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଢୁଳାଇଲା ପରି ଢଳି ତଳେ ପଡ଼ିଯିବା ଭଳି",
          "ହେଲିନି ଯେ କୁନ୍ଦକଳିଦଶନା ଏ ସରିକି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଢୁକାଇ ଦେଲେ ତୃଷିତ ଚକୋର ଚଞ୍ଚୁରେ ଶୀତ",
          "-ଭାନୁ ଚନ୍ଦ୍ରିକାକୁ ବିତ୍ତ ଯାଏ କିଛି ସରିକି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଢୋକୁଟିକୁ ସିନା ହଟି ମୋ ସାର ଯାଉଛି ତୁଟି",
          "ପିଇ ଦିଅନ୍ତି କି ଗୋଟିଯାକ ସେ କିଶୋରୀକି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଢବା ତନାବିରୁ ଗୋପ ନଗରୀର ବନ୍ଦେ ଭୂପ",
          "ବାଲୁକେଶ ଦେବ ନୀପକୁଞ୍ଜପୁଞ୍ଜ ସରିକି ରେ"
        ]
      }
    ]
  },
