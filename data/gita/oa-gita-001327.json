  "id": "oa-gita-001327",
  "name": {
    "en": "Pritiru nahi madaka",
    "or": "ପ୍ରୀତିରୁ ନାହିଁ ମାଦକ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000189"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pritiru-nahi-madaka-abhiri-jati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରୀତିରୁ ନାହିଁ ମାଦକ, ରେ ସଙ୍ଗାତ",
          "ଛାଡ଼ିବି ବୋଇଲେ ଛାଡ଼ି ତ ନୁହଇଁ",
          "ହରଇ ଧୈର୍ଯ୍ୟ ବିବେକ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁଳବତୀ ଅତି ହେଲେହେଁ ଯୁବତୀ",
          "ହଜାଇ ହେମନ୍ତ ଯାକ",
          "ଗୁରୁଜନ ଭୟ ଛାଡ଼ି କରେ ଲୟ",
          "କେବଳ ହୃଦପଦକ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭସାଏ ପ୍ରଳାପରେ ହସାଏ ଭଗାରି",
          "ଲସାଏ ପକାଏ ଟେକ",
          "ହଜାଇଲେ ମନ ଦେଖାଏ ସପନ",
          "କେବଳ ହୃଦପଦକ"
        ]
      }
    ]
  },
  "sources": [
