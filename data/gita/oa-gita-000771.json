{
  "id": "oa-gita-000771",
  "name": {
    "en": "Sakhi ki kala go madana sundara",
    "or": "ସଖୀ କି କଲା ଗୋ ମଦନ ସୁନ୍ଦର କାହ୍ନୁ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000150"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-ki-kala-go-madana-sundara-todiparaja-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ କି କଲା ଗୋ ମଦନ ସୁନ୍ଦର କାହ୍ନୁ",
          "ପଙ୍କଜ କଳିରୁ ଅଳି ମନ ଭଳି",
          "ପାଶୋର ନ ଯାଏ ମନୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁଞ୍ଜେ ନେଲା ଦିନେ ଢଳାଇ ଶ୍ରୁତିରେ",
          "ଭାରତୀ ଅମୃତ ଧାରା",
          "ଉରରୁ ଦୁକୂଳ କାଢ଼ି ଲମ୍ବାଇଲା",
          "ବିଦ୍ୟୁମ ମୁକତା ହାରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମର୍କତ ପାଷାଣ ଭଦ୍ର ଭଦ୍ରାସନେ",
          "ବିଜେ କରାଇବା ବଳେ",
          "ଇନ୍ଦ୍ରନୀଳମଣି ବୈଡ଼ୁର୍ଯ୍ୟ ଖଚିତ",
          "ମୁକୁଟ ବାନ୍ଧିଲା ଚୂଳେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅମର ବନ୍ଧନ ନୀଳାଦ୍ରି ଚନ୍ଦନ",
          "ଟୋପା ଦେଲା କରି ଧୀରା",
          "ପଦ୍ମରାଗ ପାତ୍ର ଗୋଟିକରେ ଭରି",
          "ବିଞ୍ଚିଦେଲା କୋଟି ହୀରା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୁହି କୁଞ୍ଜରାଣୀ ମୁହିଁ କୁଞ୍ଜରାଜା",
          "ବୋଲି ବଚନ ଭାଷିଲା",
          "କନ୍ଦର୍ପ ଶାସ୍ତ୍ରର ଚଉଷଠି ବନ୍ଧ",
          "ବିକାଶ କରି ବସିଲା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେ ବନ୍ଧନେ ମନ ହୋଇଣ ବନ୍ଧନ",
          "ତା ଆନନ କରେ ଲୋଡ଼ା",
          "ଭାଷେ ବନମାଳୀ ଶୁଣ ଗୋ ସଜନୀ",
          "ଏ ଗୁପତ ରସ ଘୋଡ଼ା"
        ]
      }
    ]
  },
  "sources": [
    {
