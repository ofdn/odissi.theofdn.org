{
  "id": "oa-gita-000243",
  "name": {
    "en": "Chahan re nikunja sejaku",
    "or": "ଚାହାଁରେ ନିକୁଞ୍ଜ ଶେଯକୁ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-re-nikunja-sejaku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁରେ ନିକୁଞ୍ଜ ଶେଯକୁ",
          "ଜୀବନର ବନ୍ଧୁ ରାଧାଗୋବିନ୍ଦ ସଜକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେତେ କାଳରୁ ବିରଞ୍ଚି ବାଛି ରଖିଥିଲା ସଞ୍ଚି",
          "ସଂସାର ସାର ସୁଷମା ସମ୍ପତ୍ତି ବ୍ରଜକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସୁମନ ତଳ୍ପ ସରରେ କରୀ ପରମ ତୋଷରେ",
          "ଧରିଲା ପରି ଦିଶୁଛି ସୁନା ପଙ୍କଜକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହେଉ ଚାରି ଆଖି ଏକା ହସୁ ପ୍ରିୟ ଶ୍ରୀ ରାଧିକା",
          "କାନ୍ତ କରେ ଲୁଚାଉଛି ଲୋଚନ ଲାଜକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଚଳ ଚପଳା ହୃଦେ ବହି ଘନ ହେଲ ଉଦେ",
          "ଉଚ୍ଛନ୍ନ ଦଶା ପଡ଼ିବ ମକରଧ୍ୱଜକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏ ବ୍ରଜରେ ଆଖି ବହିଥିବା ଜନଙ୍କର ସହି",
          "ଜନ୍ମାନ୍ତର ପୁଣ୍ୟପୁଞ୍ଜ ଘଟିଛି ଆଜକୁ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ବାତାଧ୍ୱ କବାଟ କଲା ନିରୁଦ୍ଧ",
          "ଆଳୀଏ ଯିବା ଉତ୍ତାରୁ ବଢ଼ାଇ ଭୁଜକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
