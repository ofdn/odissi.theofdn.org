{
  "id": "oa-gita-000795",
  "name": {
    "en": "Majja majja hajai kulaja",
    "or": "ମଜ୍ଜା ମଜ୍ଜା ହଜାଇ କୁଳଜା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/majja-majja-hajai-kulaja-kamodi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଜ୍ଜା ମଜ୍ଜା ହଜାଇ କୁଳଜା ରହିଲେ",
          "ବ୍ରଜାବନୀ ରଜା ସଜା ମୁଖ ଚାହିଁଲେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଞ୍ଜାକ୍ଷ କି ସୁନ୍ଦର ନ ଯାଇ ମନୁ ମୋର",
          "କେ ଜାଣେ ଚାହିଁଦେଲେ ଦହିଲେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁଁ ଜାଣିଥିଲେ ମିତ ମଜ୍ଜାନ୍ତି କିମ୍ପା ଚିତ୍ତ",
          "ହଜାର କହ ମୂର୍ଚ୍ଛି ନୋହିଲେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଜାଡ଼ିଲେ ମହତ ଉଜାଡ଼େ ନନ୍ଦସୁତ",
          "ଉଜାଗରେ ଲୋଚନେ ରହିଲେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଞ୍ଜାଳ ନେତ୍ର ପ୍ରୀତି ହଜାଇ କୁଳ ଜାତି",
          "ବେଜାରେ ବନମାଳୀ କହିଲେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
