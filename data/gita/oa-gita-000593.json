{
  "id": "oa-gita-000593",
  "name": {
    "en": "Asa babu gosthachala chandrama",
    "or": "ଆସ ବାବୁ ଗୋଷ୍ଠାଚଳ ଚନ୍ଦ୍ରମା"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000117"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asa-babu-gosthachala-chandrama-haribandhu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସ ବାବୁ ଗୋଷ୍ଠାଚଳ ଚନ୍ଦ୍ରମା ମୋହର ରେ",
          "କୋଳେ ଧରି ଚୁମ୍ବ ଦେବି ଶ୍ରୀ ମୁଖେ ତୋହର ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହିଁକି କରୁ ରୋଦନ କି ନାହିଁ ମୋର ସଦନ",
          "ଚିନ୍ତା ହଜା ଚିନ୍ତାମଣି ରତନର ହାର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କ୍ଷଣେ ତୁନି ହୁଅ ଧନ କରାଇବି ସ୍ତନ୍ୟ ପାନ",
          "ମ୍ଳାନ ନ କର ବଦନ ଦେବି କ୍ଷୀର ସର ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାଇ ବଳରାମ ସଙ୍ଗେ ନର୍ତ୍ତନ କରରେ ରଙ୍ଗେ",
          "ତୋ ନର୍ତ୍ତନ ଦେଖି ନେତ୍ର କରିବି ସୁଫଳ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ନାରାୟଣ ସେବାର ଫଳଟି ତୁହି ମୋହର",
          "ଠୂଳ ହୋଇ ଲଭ୍ୟ ହେଲୁ ମୋ ଶ୍ୟାମ ସୁନ୍ଦର ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତିଳାର୍ଦ୍ଧେ ହେଲେ ଅନ୍ତର ସ୍ମରୁ ନାହିଁ କୃତ୍ୟ ମୋର",
          "ଦଶ ଦିଶ ଯାକ ମୋତେ ଦିଶଇ ଅନ୍ଧାର ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ହେଳାରେ ମୁ ଥିଲେ ରହି ଖେଳାରେ ଗୋପୀଏ ନେଇଁ",
          "ଭୋଳାରେ ଲୁଚାଇଥାନ୍ତି ନ କହିଣ ଗିର ରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କୃଷ୍ଣଙ୍କୁ ପ୍ରବୋଧି ଧୀରେ ଯଶୋଦା ଦଧି ମନ୍ଥିଲେ",
          "ଭାବେ ହରିବନ୍ଧୁ ମଗ୍ନ ହୋଇ କହିବାର ରେ"
        ]
      }
    ]
  },
