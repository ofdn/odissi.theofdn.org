{
  "id": "oa-gita-000660",
  "name": {
    "en": "Ane para na kara priti",
    "or": "ଆନେ ପରା ନ କର ପ୍ରୀତି"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000187"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ane-para-na-kara-priti/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆନେ ପରା ନ କର ପ୍ରୀତି",
          "କହ ଯେ ନିତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏହି ଦେହେ ଦେଇ କର",
          "କେତେ ଯେ ନିୟମ କର",
          "ଦେଖଟି ଥରେ ମୁକୁର",
          "ଲାଗିଛି କାହା ସିନ୍ଦୂର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୁମ୍ଭେ ଯେ ବଞ୍ଚକ ନୁହଁ",
          "ଜାଣ କେତେ ପରି ସ୍ନେହ",
          "ଗଣ୍ଡେ ଯେ ଯାବକ ବହ",
          "ଦେଖି ସହେ କାହା ଦେହ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହେଉ ମୋ ଆଶା ଭଞ୍ଜନ",
          "ହେଲା ତା ମନ ରଞ୍ଜନ",
          "ସୁରଙ୍ଗ ଓଷ୍ଠେ ରଦନ",
          "କାହୁଁ ହେଲା ଅରଜନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଙ୍ଗୁ କୁଙ୍କୁମ ଚନ୍ଦନ",
          "ମୋହୁଛି ମନ ନୟନ",
          "ପିନ୍ଧିଛ କାହା ବସନ",
          "ଭଲ କରି ଥରେ ଚିହ୍ନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେ ସୁନ୍ଦର ଅଳଙ୍କାର",
          "ପ୍ରୀତି ପ୍ରୀତିକି ତୁମ୍ଭର",
          "ମଣ୍ଡି କରରୁହ ଗାର",
          "କରିଛ କେତେ ସୁନ୍ଦର"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଭାଷେ ରାମକୃଷ୍ଣ ତାର",
          "ପ୍ରେମକୁ ମୋର ଜୁହାର",
          "ଯୋଡ଼ି ମୁଁ ମାଗୁଛି କର",
          "ମୋ ପରି ତାକୁ ନ କର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ane-para-na-kara-priti/"
    }
  ],
