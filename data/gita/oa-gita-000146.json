{
  "id": "oa-gita-000146",
  "name": {
    "en": "Debi mu paranaku baraji go",
    "or": "ଦେବି ମୁଁ ପରାଣକୁ ବରଜି ଗୋ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000068"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/debi-mu-paranaku-baraji-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେବି ମୁଁ ପରାଣକୁ ବରଜି ଗୋ",
          "ବୁଝ ତୁ ଥରେ ଶ୍ୟାମ ମରଜି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପିଇ ଜୀଇବି ବୋଲି କେତେ କଷ୍ଟରେ ଥିଲି",
          "ପୀୟୂଷ ରସପାନ ସରଜି ଗୋ",
          "ସହି ମୋତେ ନ ସହିପାରିଟି ତହିଁ ନେଇ",
          "କେ ଦେଲା କାଳକୂଟ ପରଜି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଧନ ଜୀବନଚୟ ପ୍ରିୟବାନ୍ଧବ ଭୟ",
          "ଜାତି ମହତ ଆଶା ବରଜି ଗୋ",
          "ସଜନୀ କୋଟିକାମ ବିଗ୍ରହଜିଣା ଶ୍ୟାମ",
          "ସଙ୍ଗରେ ଥିଲି ପ୍ରେମ ଅରଜି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୋ ତହୁଁ ରୂପବତୀ କେଉଁ ବ୍ରଜଯୁବତୀ",
          "ଧନ୍ୟ ତା ପ୍ରୀତିରେ ସେ ଭରଜି ଗୋ",
          "ଫିଟାଇ ନେଲା ମନ ମୋହଠାରୁ ମୋହନ",
          "ସିଇଁବାଠାରେ ସ୍ମରଦରଜି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚଞ୍ଚଳ ବିଦ୍ୟୁଲେଖା ସହିତେ ଦେଇ ଦେଖା",
          "ବିରହୀ ସମୁଦାୟ ତରଜି ଗୋ",
          "ଶ୍ରୀ ଜଗଦ୍ଦେବ ଦୁଃଖ କହେ ସଜନୀ ଦେଖ",
          "ଘୋଟିଆସୁଛି ଘନ ଗରଜି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
