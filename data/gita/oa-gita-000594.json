{
  "id": "oa-gita-000594",
  "name": {
    "en": "Sarba sakhi eha kariba",
    "or": "ସର୍ବ ସଖି ଏହା କରିବଯେବେ ମୋ ପ୍ରାଣ ଯିବ । ଘୋଷା । କଫବାତ କଣ୍ଠାଗ୍ରତେ ଯେବେ ରୁନ୍ଧିବଶ୍ୟାମ ତୁଳସୀ ମଞ୍ଜରୀବଦନେ ଦେବ ମୋହରିଶ୍ୟାମ ନାମ ଯତ୍ନ କରିଶ୍ରବଣେ ଶୁଣାଉଥିବ । ୧ । ତମାଳ ଡାଳରେ ମୋତେ ବାନ୍ଧି ରଖିବପିଣ୍ଡକୁ ମୋହର କେହିଦହନ କରିବ ନାହିଁଅଇଲେ ପ୍ରାଣମାଧୋଇତାଙ୍କୁ ବା ଦେଖାଇଦେବ । ୨ । ଶ୍ୟାମ ବଂଶୀସ୍ୱନ ସଖି ଯେଣେ ଶୁଭିବସମୟ କାଳରେ ନେଇସେ ଦିଗକୁ କର୍ଣ୍ଣ ଦେଇଶ୍ୟାମ ରଜ ପଡ଼େ ଯହିଁସେହି ପଥେ ଶୁଆଇଦେବ […]"
  },
  "composer": "oa-person-000029",
  "mula_raga": [
    "oa-raga-000155"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sarba-sakhi-eha-kariba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସର୍ବ ସଖି ଏହା କରିବ",
          "ଯେବେ ମୋ ପ୍ରାଣ ଯିବ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଫବାତ କଣ୍ଠାଗ୍ରତେ ଯେବେ ରୁନ୍ଧିବ",
          "ଶ୍ୟାମ ତୁଳସୀ ମଞ୍ଜରୀ",
          "ବଦନେ ଦେବ ମୋହରି",
          "ଶ୍ୟାମ ନାମ ଯତ୍ନ କରି",
          "ଶ୍ରବଣେ ଶୁଣାଉଥିବ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତମାଳ ଡାଳରେ ମୋତେ ବାନ୍ଧି ରଖିବ",
          "ପିଣ୍ଡକୁ ମୋହର କେହି",
          "ଦହନ କରିବ ନାହିଁ",
          "ଅଇଲେ ପ୍ରାଣମାଧୋଇ",
          "ତାଙ୍କୁ ବା ଦେଖାଇଦେବ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶ୍ୟାମ ବଂଶୀସ୍ୱନ ସଖି ଯେଣେ ଶୁଭିବ",
          "ସମୟ କାଳରେ ନେଇ",
          "ସେ ଦିଗକୁ କର୍ଣ୍ଣ ଦେଇ",
          "ଶ୍ୟାମ ରଜ ପଡ଼େ ଯହିଁ",
          "ସେହି ପଥେ ଶୁଆଇଦେବ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାମଚନ୍ଦ୍ର ସେ ଗୋବିନ୍ଦ ସତେ ଦେଖିବ",
          "ସଖି ଶୁଣ ମୋ ବଚନ",
          "ନୋହିଲେ ଏ ଅପଘନ",
          "ଯମୁନା ଜଳେ ମୋହନ",
          "ସ୍ନାନ ଘଟେ ଭସାଇ ଦେବ"
        ]
      }
    ]
  },
  "sources": [
