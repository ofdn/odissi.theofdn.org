{
  "id": "oa-gita-001368",
  "name": {
    "en": "Kunda brunda nibha",
    "or": "କୁନ୍ଦ ବୃନ୍ଦ ନିଭ"
  },
  "composer": "oa-person-000038",
  "mula_raga": [
    "oa-raga-000040"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunda-brunda-nibha-ramakeri/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "କୁନ୍ଦ ବୃନ୍ଦ ନିଭ ଅତି ରୁଚି ଭୈରବ",
          "ସୁନ୍ଦର ଶୁଚି ତନୁ ବିରାଜତେ",
          "ବୀଣା ପୁସ୍ତକ ରଞ୍ଜିତ କରଯୁଗ",
          "ଭାରତୀ ଗୁଣମୟୀ ନମୋସ୍ତୁତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶାରଦ ଶଶଧର ପୂର୍ଣ୍ଣ ଦୀପ୍ତକର",
          "ମଦହରସହ ମୁଖ ବିଭ୍ରାଜତେ",
          "ସକଳ ଶାସ୍ତ୍ର ବିଶାରଦ ଭଗବତୀ",
          "ଆଶ୍ରିତ ଜନ ହୃଦ ସମୁଦିତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାରଦାଦି ମୁନି ବୃନ୍ଦାରକ ଚୟ",
          "ବନ୍ଦିତ କୃତ ତବ ପଦାମ୍ବୁଜେ",
          "ଶୁକ୍ଳାମ୍ବରଧାରିଣୀ ଯୋଗତାରିଣୀ",
          "ନାରାୟଣୀ ତ୍ୱାଂ ସଦା ଭଜେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବାସୁଦେବ କର୍ଣ୍ଣଚ୍ଛଦ ଶିଞ୍ଜିତ",
          "ତାନ ଗାନ ରସ ପ୍ରମୋଦିନୀ",
          "ବର୍ଣ୍ଣିତ କରେ ଦ୍ୱିଜ ପଦ୍ମନାଭ",
          "ସପନ ମନ ବିହାରିଣୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
