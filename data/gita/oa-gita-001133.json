{
  "id": "oa-gita-001133",
  "name": {
    "en": "Gosthakhandala kula kumuda bandhuku",
    "or": "ଗୋଷ୍ଠାଖଣ୍ଡଳ କୁଳ କୁମୁଦ ବନ୍ଧୁକୁ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gosthakhandala-kula-kumuda-bandhuku-todi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୋଷ୍ଠାଖଣ୍ଡଳ କୁଳ କୁମୁଦ ବନ୍ଧୁକୁ",
          "କେ ଭୁଲାଇ ରଖିଲା ସହି ରେ",
          "କୁଞ୍ଜରୁ ଦେହଳୀକି ହେଉ ଏଣି ତେଣିକି",
          "ରଜନୀ ଅର୍ଦ୍ଧ ତ ଗଲାନି ବହି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୁମାନ କରିଥିଲି ବୋଲିକି ମୁହିଁ କାଲି",
          "ମାନସରେ ସେ ଦୁଃଖ ଭାବି ରେ",
          "ଅଭ୍ରଲିହ ଅନଙ୍ଗ ଅନଳ କୁଣ୍ଡରେ",
          "ପକାଇ ଦେଲେ ବନ ମଧ୍ୟରେ କି କରିବି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମିହିର କନ୍ୟା ତୀର ବନ୍ୟା କୁସୁମ ଶର",
          "ବିନ୍ୟାସ ମୋ ହୃଦରେ ପାଣି ରେ",
          "କହିଲେ ଆସିବାକୁ ଏ କେଶର କୁଞ୍ଜକୁ",
          "ରୁହାଇଲା କେ ତାଙ୍କୁ ବଣା କରି ସରଣୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହାସ କର୍ପୂର ଗିର ନାରିକେଳ ସଲିଳ",
          "ଗରଳ କରାଇଲେ ପାନ ରେ",
          "ଘାରି ହେଉଛି ତନୁ ଅଧର ସୁଧା ବିନୁ",
          "ନାହିଁ ଉପାୟ ଆନ ରହିବାକୁ ଜୀବନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶକ୍ରଦିଶ ଶିଖରୀ ଶୃଙ୍ଗେ କର ପ୍ରସାରି",
          "ଦେଲାନି ଅନା ପାପ ଶଶୀ ରେ",
          "ଆସିବେ ସେ ଆଉ କି ବୋଲୁ ମୋହନ ଲୁକି",
          "ଶୁଣୁଥିଲେ ବିଲୋକି ଗୋପାଳକୃଷ୍ଣ ହସି"
        ]
      }
    ]
  },
  "sources": [
