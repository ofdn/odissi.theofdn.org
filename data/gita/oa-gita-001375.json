{
  "id": "oa-gita-001375",
  "name": {
    "en": "Sarigali laje aja",
    "or": "ସରିଗଲି ଲାଜେ ଆଜ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000088"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sarigali-laje-aja-chakrakeli-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗାତ ରେ, ସରିଗଲି ଲାଜେ ଆଜ",
          "କରି ବିଲୋକନ କାଲି କେହି ଘନ",
          "ଶ୍ୟାମ ମୁଖ ଦ୍ୱିଜରାଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ଶୋଭା ଉଦିତ ସମ୍ଭୋଗରେ ଚିତ୍ତ",
          "ପୁରା ନ ଥିବାରୁ ମୋର",
          "ରଜନୀ ରଥାଙ୍ଗୀ ଭଙ୍ଗୀ ସିନା ଅଙ୍ଗୀ",
          "-କାର କରେ ନିରନ୍ତର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୀଳ ସୁଧାସିନ୍ଧୁ ପରି ତ ମୋ ବନ୍ଧୁ",
          "ଦିଶୁଥାନ୍ତି ଗୋଟିଯାକ",
          "କେବଳ ଅଧର ଚୁମ୍ବିବାରୁ ମୋର",
          "ନ ରହଇ ତ ବିବେକ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଁ ରତିଭବନ ଭିତରେ ମୋହନ",
          "ମୂରତିକି ଯତ୍ନେ ଲେଖି",
          "ଚୁମ୍ବୁଥିଲି ରଙ୍କ ପରି ହରିଣାଙ୍କ",
          "ତୁଲ୍ୟ ମୁଖେ ବୁଜି ଆଖି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋହିତ ହେବାକୁ ସେ ସୁଖ ଅମଳେ",
          "ନୋହିଥିଲି ସାବଧାନ",
          "କେହି ଆସି ଶ୍ୟାମ ଚୁମ୍ବିଲେ ଚରମ",
          "ଦେଶେ ରହି ମୋ ବଦନ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଲେଖାରେ ହେଲେ ତ ଲେଖାମାନଙ୍କରେ",
          "ଲେଖାରେ ନୋହି ସେ ଠାଣି",
          "ଝଟ କରି ଅବା ଲିଭାଇ ଦିଅନ୍ତି",
          "ଅଟକି ରହିଲା ପାଣି ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଯାହା ହେଲା ମୋର ବାହାର ଭିତର",
          "ମନ୍ଦାକ୍ଷ ଭୟରେ ପୂରି",
          "ଅଷ୍ଟଦୁର୍ଗ ହରିହୟ ବୋଲେ ଚୋରି",
          "ଧରା ପଡ଼ିଗଲା ପରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
