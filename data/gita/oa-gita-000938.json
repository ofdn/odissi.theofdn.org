{
  "id": "oa-gita-000938",
  "name": {
    "en": "Rase bilase go",
    "or": "ରାସେ ବିଳସେ ଗୋ"
  },
  "composer": "oa-person-000130",
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rase-bilase-go-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାସେ ବିଳସେ ଗୋ ସକଳ ରସିକା",
          "ମତ୍ତଭରେ ନୃତ୍ୟ କରେ ଗାନ୍ଧର୍ବୀ ରାଧିକା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧ୍ରୀମି ଧ୍ରୀମି ଧ୍ରୀମି ବାଜେ ପ୍ରବଳ ମର୍ଦ୍ଦଳ",
          "ଝନ ଝନ ଝମକଇ ମନ୍ଦିରା ମୃଦୁଳ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଶାଖା କର ଚରଣ ଘୁଙ୍ଗୁର ମିଳାଏ",
          "ତୁଙ୍ଗବିଦ୍ୟା ବଲ୍ଲକୀରେ ଝଲକନ୍ତି ପାୟେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରେମ ପକ୍ଷ ପଞ୍ଜରିକା ସକଳ ମଞ୍ଜରୀ",
          "କେ ବାୟେ ଡମ୍ପ ଝଞ୍ଜରୀ କେ ବାୟେ ବାଂଶରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କମ୍ପିଣ ଚମ୍ପକଲତା ବଜାଏ ମୃଦଙ୍ଗ",
          "ଇନ୍ଦୁରେଖା ମିଳାଇଣ ତଥି ମୁହୁରଙ୍ଗ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରଙ୍ଗଦେବୀ ସୁଦେବିକା ଗାନ ତାନ ଛଳେ",
          "ରାଗର ଆଳାପ ଉଠେ ଧ୍ରୁବର ମଣ୍ଡଳେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ସାରିଗମପଧନିସା ସାସାରି ସାସାରି",
          "ରିମପମ ଧନିଧପା ନିଧପମ ଭରି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ତାତା ଥେଇ ତାତା ଥେଇ ଥୋ ତାକ ଥୋ ତାକ",
          "ଥୋ ଦ୍ରିମି ଥୋ ଦ୍ରିମି ଦ୍ରିମି ଥୋ ଦ୍ରିମି ଥୋତାକ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ପହିଲେ ଉଠିଣ ଧୃତ ମାଳବ ମାଳବ",
          "ମଙ୍ଗଳ ତୋଡ଼ି ବରାଡ଼ି ଧନାଶ୍ରୀ ଭୈରବ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଧନାଶ୍ରୀ ମାଳଶ୍ରୀ ପଟ କୌଶିକ ମଞ୍ଜରୀ",
          "କାମୋଦୀ ଆମୋଦି ବସନ୍ତକ ମୁଖାବରୀ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ମୋହନ ମୋହନା ଆଉ ବେଲାଳ ଗୁଜ୍ଜରୀ",
          "ସୁରଞ୍ଜନ ସୁରଞ୍ଜନ ପ୍ରଚଣ୍ଡ ଗୁଣ୍ଡରି"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ମହ୍ଲାର କେଦାର ସାବେରୀ ଯେ ଆସାବରୀ",
          "ମରୁତର ମାରୁଆ ଭଇରବ ଗଉରୀ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ପ୍ରଗୁପ୍ତ ରେଗୁପ୍ତ ଯେ ଲକାର ଯେ ଉଦ୍ଭବ",
          "ପଟତାଳ ଏକତାଳି ତ୍ରିପଟା ପ୍ରଭବ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ଏଇ ମତି ଯତିତାଳ ରୂପକ ଝମ୍ପକ",
          "ସର୍ବ ତାଳ ରାଗୀ ରାଗ ଆପଣ କାରୀକ"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ବାମେ ରାଇ ରସବତୀ ଦକ୍ଷିଣେ ଲଳିତା",
          "ମଧ୍ୟେ ଇନ୍ଦ୍ରନୀଳମଣି ଚନ୍ଦ୍ରମା ଉଦିତା"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ଆନନ୍ଦ ଚିନ୍ମୟ ରୂପେ ବୃନ୍ଦାଦେବୀ ଉଭା",
          "ପୁଷ୍ପ ବୃଷ୍ଟି କରେ ହେରି ଦୁହିଙ୍କର ଶୋଭା"
        ]
      },
      {
        "n": 16,
        "lines": [
          "ବାଜଇ ଦୁନ୍ଦୁଭି ବାଜା ଉଦ୍ଧତ ନାଦରେ",
          "ଆକାଶେ ଗନ୍ଧର୍ବପତି ଥାକି ନୃତ୍ୟ କରେ"
        ]
      },
      {
        "n": 17,
        "lines": [
          "ନାଚେ କୃତ୍ତିବାସ ହୃଷ୍ଟେ ପାର୍ବତୀର ସାଥେ",
          "ଆନନ୍ଦେ ନାରଦ ନାଚେ ବୀଣା ନେଇ ହାଥେ"
        ]
      },
      {
        "n": 18,
        "lines": [
          "ଶ୍ରୀରୂପ ମଞ୍ଜରୀ ହୋଏ ନିଷ୍ଠା ଜରଜତି",
          "ବୋଲେ ଶ୍ରୀଚନ୍ଦନ ତାର ଏଇ ସେ ସମ୍ପତ୍ତି"
        ]
      }
    ]
  },
