    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ କି ହେଲା ସହି କି ହେଲା",
          "କପଟ ରୁଷାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନ ଚାହିଁ ପୁଣି ତାଙ୍କ",
          "ଶ୍ରୀମୁଖ ହରିଣାଙ୍କ",
          "ସଖୀ ଆଖି ରଖିଲୁ ରସାଳସା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ୟାମ ନାଗର ମଣି",
          "-ମୟ ମଣ୍ଡନା ଶ୍ରେଣୀ",
          "ବୁଣି ଦେଲୁ ତୁ ପୁଣି ମୃଗଦୃଶା ରେ"
        ]
      }
    ]
  },
