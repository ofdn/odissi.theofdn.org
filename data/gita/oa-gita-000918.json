{
  "id": "oa-gita-000918",
  "name": {
    "en": "Subhuchi murali kakali",
    "or": "ଶୁଭୁଛି ମୁରଲୀ କାକଳୀ"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000005"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/subhuchi-murali-kakali-bhairabi-basanta-rahasa-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରିୟ ଆଳି ଶୁଭୁଛି ମୁରଲୀ କାକଳୀ",
          "ଶୁଣି ଏ ନିନାଦ କମ୍ପୁଛି ମୋ ହୃଦ",
          "ଆଉ ନ ପାରେ ସମ୍ଭାଳି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେଲା କେତେ ଦିନ ମଦନମୋହନ",
          "ପ୍ରସନ୍ନ ମୁଖ ନଳିନ",
          "ଦେଖି ନାହିଁ ସଖୀ ଚାଲ ଗୋ ଏକାକୀ",
          "ହୋଇଥିବେ ଚନ୍ଦ୍ରାନନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋର ନାମ ଧରି ବଂଶୀରେ ଶ୍ରୀହରି",
          "ଡାକନ୍ତି ଶୁଣ କିପରି",
          "ନ କର ଗୋ ହେଳା ଜାଣିଲେ କରାଳା",
          "ଦେଲେ ଦେଉ ପଛେ ମାରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଛି ମାନସରେ ଏ ମଧୁମାସରେ",
          "କୃଷ୍ଣ ସଙ୍ଗେ ରାସକେଳି",
          "କରିବି ତୋଷରେ ମୋହନ ପାଶରେ",
          "ଏ ପ୍ରସଙ୍ଗ ଦେବୁ ଝାଳି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କା ଆଖିରେ ଅବା କେ ସାମାନ୍ୟ ଯୁବା",
          "ମୋ ହୃଦର ଗଣ୍ଠିଧନ",
          "ତାହା ବାହାଭିଡ଼ା ରସାନନ୍ଦ ଛଡ଼ା",
          "ସ୍ୱର୍ଗ ସୁଖେ ନାହିଁ ମନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବନେ ତା ପଛରେ ବୁଲି ବୁଲି ଶିରେ",
          "ବହିବି ପଦ କଠାଉ",
          "ରାଜଇନ୍ଦ୍ର ଭାଷେ ଏଥୁ ବଳି ବିଶ୍ୱେ",
          "କେଉଁ ଭାଗ୍ୟ ଅଛି ଆଉ"
        ]
      }
    ]
  },
  "sources": [
    {
