{
  "id": "oa-gita-000665",
  "name": {
    "en": "Sate ki ketaki gori",
    "or": "ସତେ କି କେତକୀ ଗୋରୀ ଥିବ ଜୀବ ଧରିରେ"
  },
  "composer": "oa-person-000119",
  "mula_raga": [
    "oa-raga-000104"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sate-ki-ketaki-gori-bangalasri/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସତେ କି କେତକୀ ଗୋରୀ ଥିବ ଜୀବ ଧରିରେ",
          "ରତେ କି ମୋତେ ତୋଷିବ ବାରେ ବିମ୍ବାଧରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଦନ ଶରେ ମୋ ଧନ ହୋଇଣ ବିରସରେ",
          "କଦନ ରମଣୀମଣି ଲୋଟିବଣି ରସାରେ",
          "ବଦନ ପୋତି ତେଜୁଥିବ ଶ୍ୱାସ",
          "ରଦନ ଛଦେ ନ ଥିବ ସେ ହାସ",
          "ଅଶନ ମଣୁଥିବ ସେ ଯେ ବିଷ",
          "ସଦନ ହିଁ ହେବ କାରା ସଦୃଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରମରେ ମୋର ଏହା ଥିଲା ସିନା ବିହିରେ",
          "ଭରମରେ ତା ଅନ୍ୟଥା ନ କଲା ତ ବିହିରେ",
          "ହର ମନମୋହିନୀ ଆରେ ସହି",
          "ଭରମ ଅଙ୍ଗୀ ମୋର ବିନୁ କେହି",
          "ପରମ ସୁନ୍ଦରୀ ବଞ୍ଚିବ ତହିଁ",
          "ଦରମରା ହୋଇଥିବ ଯେ ରହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନୀରଜ ନୟନୁଁ ନୀର ନିରନ୍ତରେ ବହିରେ",
          "ଜରଜର ହୋଉଥିବ ଉରଜ ତା ବହିରେ",
          "ଗରଜନରେ ପିକ ଭୃଙ୍ଗ ତତି",
          "ତରଜନା ଦେଉଥିବେ ଯେ ଅତି",
          "ବରଜ ନାଗରୀବର ଯେ ନିତି",
          "କରଜରେ ଚିରୁଥିବ ସେ କ୍ଷିତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହରାଇ ଦେଲା ସପନ ସୁନ୍ଦର ବଦନୀରେ",
          "ନୁହଇ ଏବେ ନିଶ୍ଚୟେ ସହି ଏ ବେଦନାରେ",
          "ବହଇ ମନ୍ଦରେ ମଧୁ ପବନ",
          "ଦହଇ ବିରହୀ ଜନ ଜୀବନ",
          "ଶୋହଇ ପୁଷ୍ପେ ଉପବନ ମାଳ",
          "କହଇ ଶ୍ୟାମକିଶୋର ଏସନ"
        ]
      }
    ]
  },
  "sources": [
