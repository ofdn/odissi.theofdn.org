{
  "id": "oa-gita-001007",
  "name": {
    "en": "Nachaila jaha se",
    "or": "ନଚାଇଲା ଯାହା ସେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000076"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nachaila-jaha-se-kanada-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନଚାଇଲା ଯାହା ସେ",
          "ଭୂରୁ ଚାପ ଚପଳ ଚମରୀଦୃଶା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋ ଧଇର୍ଯ୍ୟ ମୃଗକୁ ପାଞ୍ଚି",
          "ନୟନାନ୍ତ ବରଛି ଆଞ୍ଚି",
          "ବନ୍ଧୁଆ ବନ୍ଧୁକ ବନ୍ଧୁ ଅଧରରେ",
          "ବନ୍ଦୀ କରି କୁନ୍ଦପସନ୍ଦ ହସା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁନିଜନ ମାନସଭୁଲା",
          "ଭଲା ମୋତିଝଲକ ଝୁଲା",
          "ବାସବ ରତନ ନଥ ନରତନ",
          "ରସିକା ନାସିକା ପୁଟ ଉଲ୍ଲସା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଧନ୍ୟ କାମ ଅମୋଘ ଶର",
          "ମନ କାରା ଭଙ୍ଗୀ ତାହାର",
          "କନକାଚଳ ତ ଛନକା ହୋଇବ",
          "ସ୍ତନ କାନ୍ତି ଦେଖି କାହା ଭରସା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଳଙ୍କୃତ ନିତମ୍ବ ଫରି",
          "ଶୋଭା ଲୋଭେ ଅଳପ ଫେରି",
          "ଅନାଇଲା ବେଳେ ବିବେକ ଦଳିଲା",
          "କି ବେକତଳିଆ ଲହସା ଖୋସା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଛଣା ସୁଧା ବାଣୀ ବିକ୍ରମ",
          "ଜଣା କଲା ସେ ସବୁ କ୍ରମ",
          "ଏଣିକି ଚରମେ ବେଣୀକି ଫଣୀକି",
          "ପରି ଖେଳାଇବ ବରବରସା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗ ମହେନ୍ଦ୍ର ଭଣେ",
          "କିଶୋରୀଙ୍କ ଶୋଭା ବୀକ୍ଷଣେ",
          "ଅଖଣ୍ଡ ଶିଖଣ୍ଡମଣ୍ଡନ ମଦନ",
          "ପଦ ନଦେ ଭାସି କଲେ ପ୍ରଶଂସା"
        ]
      }
    ]
  },
  "sources": [
