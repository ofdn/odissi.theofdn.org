{
  "id": "oa-gita-001393",
  "name": {
    "en": "Jagannatha tattwa chautisa",
    "or": "ଜଗନ୍ନାଥ ତତ୍ତ୍ୱ ଚଉତିଶା"
  },
  "composer": "oa-person-000145",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jagannatha-tattwa-chautisa-achyutananda/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "କହଇ ଚୈତନ୍ୟ ବାରେ ଶୁଣ ରେ ମନାଇ",
          "କ୍ଷୀରସିନ୍ଧୁ ମଧ୍ୟେ ଦେଖ କଳ୍ପବଟ ଛାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୁପତ ହୋଇଛି ମହାନିତ୍ୟ ଯେଉଁଠାଇ",
          "ଘନ ଘନ ହୋଇ ନିଦ ମାଡ଼ଇ ସେଠାଇଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଉତ୍ତର ଦକ୍ଷିଣ ପୂର୍ବ ପଶ୍ଚିମରେ ହେଜ",
          "ଚାରିଦ୍ୱାରେ ଆବୋରି ରହିଛି ଚାରି ବେଦ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଛାମୁ ଦର୍ଶନକୁ ବାଟ ପଡ଼ିଛି ସଧୀରେ",
          "ଜଗନ୍ନାଥ ମହାପ୍ରଭୁ ସିଂହାସନ ପରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଝୀନ ଯେ ପତନୀ ଦେଖ ତାଙ୍କ ଅଙ୍ଗେ ଶୋଭା",
          "ନିତ୍ୟ କିଶୋରୀ ରାଧିକା ତାଙ୍କ ଅଙ୍ଗ ପ୍ରଭା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଟାକି ହର ବ୍ରହ୍ମା ଯାକୁ କରିଛନ୍ତି ଆଶ",
          "ଠୁଳ ଶୂନ୍ୟ ପରେ ଦେଖ ଲାଗିଛି ରାହାସ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଡାକହାକ ଶବଦ ନିର୍ଣ୍ଣୟ ଯେଉଁଠାଇଁ",
          "ଡୋଳା ସମାଧିକୁ ଚାହାଁ ଢୋଳାଇବାକୁ ନାହିଁ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ନାଦରେ ବିନ୍ଦୁକୁ ଯେବେ ପାରିବୁ ମିଶାଇ",
          "ତିନି ମୂର୍ତ୍ତି ଏକ ବ୍ରହ୍ମ ଦେଖିବୁ ସେଠାଇଁ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଥୟେ କରି ମନ ନେଇ ଭୂରୂମଧ୍ୟେ ଭର",
          "ଦୟା କ୍ଷମା ଶାନ୍ତି ହୋଇ ଦାସୀ ଅଙ୍ଗ ଧର"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଧର୍ମ ଅର୍ଥ କାମ ମୋକ୍ଷ ହେଉଅଛି ଦୂର",
          "ନେବା ଆଣିବାକୁ ଆଉ ନାହିଁ ଯେ ବିଚାର"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ପାଣି ନାହିଁ ପଙ୍କ ନାହିଁ ମାଡ଼ୁଛି ଲହଡ଼ା",
          "ଫୁଲ ଗୋଟି ଫୁଟିଅଛି ସହସ୍ର ପାଖୁଡ଼ା"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ବାରିବୁ ବାସନା ଯେବେ ଗୁରୁ ଆଜ୍ଞା ପାଇ",
          "ଭ୍ରମର ଚୁମ୍ବିବ ତେବେ କର୍ଣ୍ଣିକାରେ ରହି"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ମଲା ମଲା ବୋଲୁଛନ୍ତି ଶୁଣରେ କହ୍ନାଇଁ",
          "ଜଗତକୁ ମଲା ଜୀବ ରୋମେ ଟଳିନାହିଁ"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ର ଏଟି ରାଧିକାରୂପ ନିତ୍ୟରେ ରାଉଛି",
          "ଲୟେ କରି ଭୁଷଣ୍ଡ ଅମର ହୋଇଅଛି"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ବାଇ କି ପରଚେ ଯେବେ ହୋଇବୁ ସୁମନ",
          "ଶିଶୁବେଦ ଘରେ ଦେଖ ସୁଆଙ୍ଗ ଭଜନ"
        ]
      },
      {
        "n": 16,
        "lines": [
          "ସ୍ୟ ଟି ଯେ ଶେଷଦେବ ଫଣିମଣି ପରେ",
          "ସ୍ୱରୂପରେ ଥାଇ ଗୋପୀ ଅରୂପ ଦେଖିଲେ"
        ]
      },
      {
        "n": 17,
        "lines": [
          "ହ ଟି ଅଟନ୍ତି ହରି ହୃଦେ ତାଙ୍କୁ ଚିହ୍ନ",
          "ହରି-ଗୁଣି ମିଶାଇବୁ ସହଜ ସୂତ୍ରେଣ"
        ]
      },
      {
        "n": 18,
        "lines": [
          "କ୍ଷମାନିଧି ପାଦପଦ୍ମେ ପଶ ଯା ଶରଣ",
          "ଛାର ବାଇ ଦାସ ଟୋକା ଅଚ୍ୟୁତ ଅଧମ"
        ]
      }
    ]
  },
  "sources": [
