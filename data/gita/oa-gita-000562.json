{
  "id": "oa-gita-000562",
  "name": {
    "en": "Kipari madhura ghena re manasa",
    "or": "କିପରି ମଧୁର ଘେନ ରେ ମାନସ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000139"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kipari-madhura-ghena-re-manasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କିପରି ମଧୁର ଘେନ ରେ ମାନସ",
          "ଶ୍ରୀରାଧାଗୋବିନ୍ଦ ପ୍ରଣୟ ବିଳାସ",
          "କଥା ରସ ଆସ୍ୱାଦନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶୀତକରାମୃତ ସ୍ୱାଦୁ ଉନ୍ନତକୁ",
          "ଅବନତ କରି ପାଦେ",
          "ହରିପୁରର ସୁଧାର ଦୁର୍ଲ୍ଲକ୍ଷକ",
          "ହୋଇଛି ଯେ ପ୍ରତିପାଦେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ପରଶିଲାକ୍ଷଣି ରସନାରେ",
          "ବର୍ଣ୍ଣାବଳୀରୁ ଚାରି କି ପାଞ୍ଚ",
          "କଣ୍ଠ ଗଦ ଗଦ ହୋଇ କି ସୁଖରେ",
          "ତନୁ ହେଉଛି ରୋମାଞ୍ଚ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଈକ୍ଷଣରୁ ଆନନ୍ଦାଶ୍ରୁ ବହିବାର",
          "ବିରାମ ନୋହେ ହେ ଆଉ ।",
          "ପ୍ରାଣେଶ୍ୱରୀ ପ୍ରାଣନାଥଙ୍କ ସ୍ୱରୂପ",
          "ହୃଦରୁ ଯାଇକି ଆଉ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସ୍ୱେଦ କମ୍ପ ପୁରିଯାଇ ଏଣେ ଅଙ୍ଗ",
          "ଶ୍ରୀଗୁରୁ ଦତ୍ତ ଦେହରେ",
          "ନିଯୋଜନା ହୋଇବାର ଭାବନାରେ",
          "ତେଣେ ସ୍ୱାମିନୀ ସେବାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୋଟିଏ ଜନ୍ମରେ ମିଳିବ ନାହିଁଟି",
          "ପ୍ରଣୟ ଭକ୍ତି ସମ୍ଭୁତ",
          "ସାତ୍ତ୍ୱିକ ନବ ରତନ ଚିନ୍ତାମଣି",
          "ଗୋପାଳକୃଷ୍ଣ କଥିତ"
        ]
      }
    ]
  },
  "sources": [
    {
