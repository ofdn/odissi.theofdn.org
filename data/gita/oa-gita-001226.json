    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୃଶ କରନ୍ତୁ ସେ କୃଷ୍ଣ",
          "ଶୁଭାଶୁଭକୁ ଆମ୍ଭର ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭୁବନ ଗୁରୁଙ୍କର ଆଦର",
          "ଶ୍ରୀ ବ୍ରଜର ଜାର ଭାବ ଯାର",
          "ବ୍ରହ୍ମାର ବ୍ରାହ୍ମୀ ଉତ୍ତର",
          "ମୀମାଂସାରେ ଯେ ଗୋଚର ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶକ୍ରମଣି ମଦହର କାନ୍ତି",
          "ମୂରତିକି ନିରବଧି ଚିନ୍ତି",
          "ଭାବିଲେ ବୀର ପ୍ରତାପ",
          "ରୁଦ୍ରଦେବ ନୃପବର ହେ"
        ]
      }
    ]
  },
  "sources": [
