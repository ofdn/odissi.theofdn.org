{
  "id": "oa-gita-001310",
  "name": {
    "en": "Syama sanga ranga mora",
    "or": "ଶ୍ୟାମ ସଙ୍ଗ ରଙ୍ଗ ମୋର"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000106"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-sanga-ranga-mora-chalaghanta-kedara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ସଙ୍ଗ ରଙ୍ଗ ମୋର ଲାଗିଥାଉ",
          "ନାମ ଜପି ଜପି ତାର ଜୀବନ ଯାଉ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାମ ମୋହନ ମୂରତି ବିନା କେବା ଆନ ଗତି",
          "ତାର ପ୍ରୀତି ରସପାନେ ମତି ମୋ ଥାଉ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରାମ ଅନୁଜଙ୍କ ଗୁଣ ଗୁଣିଗୁଣି ନିଶି ଦିନ",
          "ରାଧା ଜୀବ ଯିବା ଶୁଭ ଯୋଗଟି ହେଉ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗ୍ରାମ ପାଟଣା ସହିତେ ଏ ଗୋପ ନଗରେ ଯେତେ",
          "ଅକୀର୍ତ୍ତି ହାଟ ବସିବ ବସିଯାଉ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତହିଁକି ନାହିଁ ମୋ ଡର ଜୀବନ ସର୍ବସ୍ୱ ମୋର",
          "ସୁନ୍ଦର ସେ ନନ୍ଦସୁତ ବଂଶୀବାହୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
