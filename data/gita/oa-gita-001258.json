{
  "id": "oa-gita-001258",
  "name": {
    "en": "Sangate asa go jiba",
    "or": "ସଙ୍ଗାତେ ଆସ ଗୋ ଯିବା"
  },
  "composer": "oa-person-000093",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangate-asa-go-jiba-dwija-lokanatha-krusnalila/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗାତେ ଆସ ଗୋ ଯିବା",
          "ବସୁଦେବ ବିଭାର ଉତ୍ସବ ଦେଖିବା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେହୁ ବୋଲେ ସଜନୀ ଗୋ ଆସ ତୁରିତ",
          "ଯାହା ହେଉଛି ଚିତ୍ତ",
          "ଏଥୁ ମଥୁରାପୁର ଦେଖ ଶୁଭେ ଚହଳ",
          "ନାମ ରସ କଉତୁକେ ନୃତ୍ୟ କରିବା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେ ବୋଲେ ସଜନୀ ବାଣୀ ଶୁଣ ମୋହର",
          "ପେଷିଅଛି ଯେ ଚାର",
          "ଦୁଷ୍ଟ କଂସ ପାପିଷ୍ଠ କରିଅଛି ଆକଟ",
          "ଅଙ୍ଗହାର ଭୂଷଣ ଗୋ ଆସ ଘେନିବା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆନନ୍ଦରେ ସର୍ବ ବାଳୀ ହରଷ ମନ",
          "ଗଲେ ଯେଝା ଭୁବନ",
          "ପିନ୍ଧି ପାଟପତନୀ ଅଳଙ୍କାର ଯେ ଘେନି",
          "ଚାଲିବାର ଗତି ମତ୍ତ କରୀ କି ଅବା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାଜପଥେ ରୁଣ୍ଡ ହୋଇ ବରଜବାଳୀ",
          "ଦେଇ ସେ ହୁଳହୁଳି",
          "ପଥେ କରି ଗମନ ସର୍ବେ ହରଷ ମନ",
          "କେହୁ ବୋଲଇ ଦେବକୀ ଆସ ଦେଖିବା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ହରଷେ ମିଳିଲେ ଯାଇ କଂସ ମନ୍ଦିରେ",
          "ବିଭାବେଦୀର ତଳେ",
          "କେହୁ ଯାଇ ବନ୍ଦାଇ ହୁଳହୁଳି କେ ଦେଇ",
          "କେହୁ ଯାଇ କରି ହସ୍ତଗଣ୍ଠି ଫେଡ଼ିବା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଆନନ୍ଦରେ କେହୁ ବାଳୀ ଜୂଅ ଖେଳାଇ",
          "ପରିହାସ କରଇ",
          "ଲୋକନାଥ ଏ ବାଣୀ ଚିନ୍ତି ମୁରଲୀପାଣି",
          "କିଞ୍ଚିତରେ ବାରେ ମୋତେ ଦୟା କରିବା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangate-asa-go-jiba-dwija-lokanatha-krusnalila/"
    }
  ],
