{
  "id": "oa-gita-000493",
  "name": {
    "en": "To upama tuhi ramamani",
    "or": "ତୋ ଉପମା ତୁହି ରାମାମଣି ଏ ସଂସାରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000019"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/to-upama-tuhi-ramamani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତୋ ଉପମା ତୁହି ରାମାମଣି ଏ ସଂସାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କର ତୁ ଏ ଅନୁମାନ ନାନା ବସୁସାରେ",
          "ତୋ ସମାନ ମନକୁ ନ ଆସଇ ସୁସାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରସିଥାଏ ଯେ ରସନା ସୁମଧୁର ସାରେ",
          "ଘେନ ତ ମୋ ଧନ ସେ କି ଖେଳଇ କଷାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୋହନା ମୁଁ ତୋହ ଅନୁଗ୍ରହ ଭରସାରେ",
          "ପ୍ରମୋଦେ ଚାଲଇ ଦେଇ ପ୍ରପଦ ରସାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନାଇଁ ତୁ ରସନ୍ତେ ମୋ ଉତ୍ସଙ୍ଗ ବସାରେ",
          "ବାସବ ମୋ ଦମ ନୁହେ ଅଖଣ୍ଡ ଦଶାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭୁଲାଉ ନୟନେ ଯେବେ ଲହସା ଖୋଷାରେ",
          "ଫୁଲଇ ମୋ ଛାତି ଭଲେ କୁଲାଏ ଓସାରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଉରୁବଶୀ ବେଶ ହେଲେ ତୋ ସାମ୍ୟ ଆଶାରେ",
          "ମରିବି ସେ ଉଲୀ ସତେ କି ଲୋକହସାରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ମଣ୍ଡୁଥାଉ ଓଷ୍ଠକୁ ଯେ ସୁମନ୍ଦ ହସାରେ",
          "ଜରଜର ହୁଏ ମୋ ନୟନ ଘନସାରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଜଳନ୍ତରାଧିରାଜର ସସ୍ନେହ ଭାଷାରେ",
          "ତିନ୍ତିଲା ସୁଦନ୍ତୀ ଲଜ୍ଜାଭର ବରଷାରେ"
        ]
      }
    ]
  },
  "sources": [
