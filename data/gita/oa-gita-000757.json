{
  "id": "oa-gita-000757",
  "name": {
    "en": "Maae kahin pain go",
    "or": "ମାଏ କାହିଁପାଇଁ ଗୋ"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/maae-kahin-pain-go-mohana-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାଏ କାହିଁପାଇଁ ଗୋ ମନା କରୁଛ ମୋତେ",
          "ଏକା ହୋଇ ମୁଁ ତ ବନକୁ ନ ଯିବି",
          "ସଙ୍ଗତରେ ଯିବେ ଗୋପାଳ ସୁତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁଦାମ ସୁବଳ ମଧୁମଙ୍ଗଳ",
          "ସର୍ବ ସଖା ହୋଇଥିବୁ ସୁମେଳ",
          "ଗ୍ରାମ ପାଶେ ଥିବୁ ଦୂରକୁ ନ ଯିବୁ",
          "ପୁରକୁ ଆସିବୁ ଦିବସ ଅନ୍ତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭାଇ ବଳରାମ ଥିବେ ମୋ ସଙ୍ଗେ",
          "ଖେଳ କଉତୁକ କରିବୁ ରଙ୍ଗେ",
          "ଯେ ଯମୁନା ତୀର ସେ ଗୋପ ନଗର",
          "ତହିଁ କିମ୍ପା ଡର ହୋଇବ ଚିତ୍ତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସକାଳରୁ ସ୍ନାନ ଭୋଜନ ସାରି",
          "ନଦୀ ତୀରେ ରଖିଥିବୁଁ ବାଛୁରୀ",
          "ଦ୍ୱିତୀୟ ଭୋଜନ ପାଇଁକି ଅଶନ",
          "ସାମଗ୍ରୀ ତ ନେଇଥିବୁଁ ସଙ୍ଗତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜନନୀଙ୍କ ଅଗ୍ରତରେ ଗୋବିନ୍ଦ",
          "କଲେ ଯେତେ ଯେତେ ରୂପେ ଆଚ୍ଛନ୍ଦ",
          "କେବେହେଁ ସେ ରାଣ ନ ବୁଝନ୍ତି ପୁଣି",
          "ଗଉରଚରଣ କହଇ ଗୀତେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
