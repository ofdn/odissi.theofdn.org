{
  "id": "oa-gita-000171",
  "name": {
    "en": "Chahinchi matra sikhanda lo",
    "or": "ଚାହିଁଛି ମାତ୍ର ଶିଖଣ୍ଡ ଲୋ"
  },
  "composer": "oa-person-000002",
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahinchi-matra-sikhanda-lo/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖି ଚାହିଁଛି ମାତ୍ର ଶିଖଣ୍ଡ ଲୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୁଚ୍ଛା ଅପବାଦେ ଚମକି ପଡ଼ିଛି",
          "ଏ ବ୍ରଜବଜାର ଦାଣ୍ଡ ଲୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚିକ୍କଣ ଶ୍ୟାମଳଚନ୍ଦ୍ର ନିକଟକୁ",
          "ଚାଳି ନାହିଁଟି ପହଣ୍ଡ ଲୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚୋରି ଯେବେ କରିଥିଲି ମୁଁ ତାଙ୍କରି",
          "ଚୁମ୍ବିଛି କି ଚାରୁ ଗଣ୍ଡ ଲୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚେଟୀ ହେଲେ ତାର ବରଷନ୍ତା ମୋର",
          "କ୍ଷୀର ଉପରେ ତ ଖଣ୍ଡ ଲୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚଳୁଆଟି ବଡ଼ ମୋ ଘର ଗଉଡ଼",
          "ଶୁଣିଲେ ହେବ ପ୍ରଚଣ୍ଡ ଲୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଚପରାସି ଚୟ ପେଷି କଂସରାୟ",
          "ନିର୍ଦ୍ଦୋଷେ ନେବ କି ତଣ୍ଡ ଲୋ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗେଶ୍ୱର ଭକ୍ତି ନତଶିର",
          "ଶ୍ୟାମ ପଦକଞ୍ଜେ ମଣ୍ଡ ଲୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahinchi-matra-sikhanda-lo/"
    }
  ],
