  "id": "oa-gita-000620",
  "name": {
    "en": "Aha ki karma kali",
    "or": "ଆହା କି କର୍ମ କଲି"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000017"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-ki-karma-kali-ahari-jadumani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା କି କର୍ମ କଲି",
          "ଜାଣି ଜାଣି ତ ବୁଦ୍ଧି ହୁଡ଼ିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆସିବା କାଳରେ ସୁମନା ମଣ୍ଡନା",
          "ସୁମନାର ମନା ବାଣୀ ଯେ",
          "ନ ଘେନିଲି ତିଳେ ପଡ଼ି ପାଦ ତଳେ",
          "କରୁଥିଲା ଯା ଦଇନି ଯେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯୋଷାରତନର ଓଷା ମୋ ବଚନ",
          "ପାଳିବାର ପ୍ରତି ନିତି ଯେ",
          "ଖୋଷା ମଞ୍ଜୁଳାକୁ ଏକାକିନୀ କରି",
          "ବିଦେଶରେ ଦେଲି ମତି ଯେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେଡ଼େ ପରମାଦ ପଡ଼ିଲା ଆସି ତ",
          "ବିଚାରି ପାରିଲି ନାହିଁ",
          "କ୍ରୋଡ଼େ ଘେନି ଗାଢ଼େ ନିଶି ଯା ନ ନେଲି",
          "ଧନକୁ ମୂର୍ଚ୍ଛିଲି କାହିଁ ଯେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯଦୁମଣି ଭଣେ ଅଦୂରେ ଦେଖି ଯେ",
          "ଆହାଲାଦେ ଭାଷେ ବାଣୀ",
          "ସେ ଦୁଃଖପାଶୋରା ନାଗରୀ ହୀରାକୁ",
          "ଦୂର କଲି ଜାଣି ଜାଣି ଯେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
