{
  "id": "oa-gita-001285",
  "name": {
    "en": "Aja kunda radana kahinki bimana",
    "or": "ଆଜ କୁନ୍ଦରଦନା କାହିଁକି ବିମନା"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000117"
  ],
  "mula_tala": [
    "oa-tala-000016"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-kunda-radana-kahinki-bimana-bhatiari-gourachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ କୁନ୍ଦରଦନା କାହିଁକି ବିମନା",
          "କେ କି ଲଗାଇ ମୋ ନାଁରେ କହିଛି ନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେବେ ନ ଥିଲା ଗୁମାନ ଆଜ କାହିଁକିରେ ଧନ",
          "ନ କହୁ ପ୍ରେମ ବଚନ ସ୍ନେହାଧୀନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରସାଳସା ରସାଭୂଷା ଯୋଷା ନ ଭାଙ୍ଗ ମୋ ଆଶାଅ",
          "ରସାଭୂଷା ଲୋକହସା ତୁ କରନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଳ୍ପଲତା ପ୍ରିୟସଙ୍ଗୀ ଅଳ୍ପକେ ଦେଉଛୁ ଭାଙ୍ଗି",
          "ସ୍ୱଳ୍ପ ହୋଇ ନାଶୁଛୁ ଦୟାଳୁ ବାନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରୋଷ ଥିଲେ ତୋ ଚିତ୍ତରେ ବାନ୍ଧି ବାହୁ ଯୁଗଳରେ",
          "ନଖାଙ୍କୁଶ ମୋ ଉରରେ ମାର ସିନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୌରଚନ୍ଦ୍ର ଗଜପତି ଭାଷନ୍ତି ମୃଦୁ ଭାରତୀ",
          "ଟେକି ତୋ ବଦନଶଶୀ ବାରେ ଅନା"
        ]
      }
    ]
  },
  "sources": [
