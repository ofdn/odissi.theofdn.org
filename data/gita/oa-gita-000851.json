{
  "id": "oa-gita-000851",
  "name": {
    "en": "Syama sundara he jana gala",
    "or": "ଶ୍ୟାମ ସୁନ୍ଦର ହେ ଜଣାଗଲା"
  },
  "composer": "oa-person-000127",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-sundara-he-jana-gala-raghunatha-rajaguru-mahapatra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ସୁନ୍ଦର ହେ ଜଣାଗଲା ତୁମ୍ଭ ରୀତି",
          "କେଉଁ ବାଳା ପ୍ରୀତିରୁ ହୋଇଗଲା ଏତେ ଗତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଙ୍ଗ ଅଳସ ଅନଙ୍ଗ ରତି ପର",
          "-ସଙ୍ଗ ମୋଦକ ଭୋଗରୁ",
          "ରଙ୍ଗ ଦିଶଇ କୁରଙ୍ଗ ନେତ୍ର",
          "ତରଙ୍ଗ ରହିତ ଉଦାରରୁ",
          "ଅଙ୍ଗନାର ଉତ୍ତୁଙ୍ଗ କୁଚ ପର",
          "-ସଙ୍ଗ ରସ ସମ୍ଭୋଗରୁ",
          "କର ଶୋଭା ଚନ୍ଦନ କସ୍ତୁରୀ ସଂଯୋଗରୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାର ନଖର କହ୍ଲାର କ୍ଷତକୁ",
          "ସ୍ୱୀକାର କରିଛ ଅପାର ହେ",
          "ସାର ଏଥକୁ ତୁଷାର କର ଗନ୍ଧ",
          "-ସାର ଲେପ ବିଚାରି ହେ",
          "ସାର ଝଗଡ଼ ସୁସାର ତନୁ ସୁକୁ",
          "-ମାର ନନ୍ଦକୁମାର ହେ",
          "ଲୁଚାଇଲେ ଲୁଚଇ କି ବିଟପ ବେଭାର ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାରମ୍ବାର ବିନତି କର ଏବେ ଉଚ୍ଚାର",
          "କର ଚାଟୁ ଉତ୍ତର ଗିରମାନରେ",
          "ମାର ମୁକୁର ମୁଦାହର ସୁଖ ହତ",
          "ସାର କହ କି ନିଦାନ ରେ",
          "ଯା ରମଣୀ ଯାରମଣି ମନକୁ ମଜା",
          "ରମଶ ରସ ଦାନରେ",
          "କଥା କହି ମଥା ତ ନ ପୋତ ବହନ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କପଟ ପଟୁତର ରଟିଲେ ବଟି",
          "ନିକି ପାରି ହେ",
          "ଲଟପଟ କିରି ଚାରୁ ଉରୁବିଟ",
          "ପିନ୍ଧି ଆସିଛ କି ତାରି ହେ",
          "ଜୀବଟି ତୁଟି ତୁଟି କି ସୁଖକୁଟି",
          "ହଟିବଟି ବିଚାରି ହେ",
          "ହାଟକୁ ପାରି ନିଖଟ ଝିଟ ଛଟ କରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବାଳ ଅର୍କ ପ୍ରବାଳ ଛବି",
          "ସୁରସାଳ ଅର୍ଦ୍ଧକ ହାଲରେ",
          "ଝାଳ ପଡ଼ି ତ ସୁଝାଳ ତନୁକୁ",
          "ସମ୍ଭାଳ ନମଶତ ଖାଲରେ",
          "ତା ଲଲାଟର ଲାଲ ସିନ୍ଦୂର",
          "ଭାଲରେ ଅଛି ହାଲରେ",
          "କହେ ବିପ୍ର ରଘୁନାଥ ପଡ଼ିଲ ପାଲରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-sundara-he-jana-gala-raghunatha-rajaguru-mahapatra/"
    }
  ],
