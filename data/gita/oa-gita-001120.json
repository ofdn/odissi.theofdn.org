{
  "id": "oa-gita-001120",
  "name": {
    "en": "Radha pari radha sina",
    "or": "ରାଧା ପରି ରାଧା ସିନା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radha-pari-radha-sina-gopalakrusna-malabagouda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧା ପରି ରାଧା ସିନା ରେ ସଙ୍ଗିନୀ",
          "ସ୍ତିରୀ ମାତରକ ଅଛନ୍ତି ଯେତେକ",
          "ସର୍ବେ ପିତ୍ତଳ ସେ ସୁନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦଳିତାଞ୍ଜନକୁ ହସୁଛି ଯା କାନ୍ତି",
          "ସେ ଶ୍ୟାମ ପାଶରେ ଥିଲେ",
          "ହରିତାଳ ବୋଳି ହେଲା ପରି ଦିଶେ",
          "କାନ୍ତିରେ କେ ତାହା ତୁଲେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଳାକର ତ କଳାକରେ ରହିଲା",
          "ମୁଖକୁ ନୋହି ତୁଳନା",
          "ତ୍ରପାରେ ତପ କରୁଛି ଗଙ୍ଗା ତଟେ",
          "ହର ଜଟା ବନେ ଅନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଖିକି ତାର ଅନାଇ ଦେଇ ମୁଖ",
          "ବୁଲାଇ ଦେଲେ ଏଣିକି",
          "ଦଶ ଦିଶ ଯାକ ନୀଳୋତ୍ପଳମୟ",
          "ଦିଶୁଛି ହେବା କଥା କି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାତିଯାକ ଜାତି ପାଖୁଡ଼ା ଶେଯରେ",
          "ପହୁଡ଼ି ଥାଉଛି ଲୋଟି",
          "ମଉଳୁ ନାହିଁ କିଞ୍ଚିତେ ହେଲେ ଅଙ୍ଗେ",
          "ଚିହ୍ନ ବସି ଦିଶେ ଫୁଟି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶତ କୋଟି ଗୋପୀ କାଲି ବୋଲୁଥିଲେ",
          "ଶୁଣୁଥିଲେ ତ ରାସରେ",
          "ଆମ୍ଭ ନେତ୍ର ପୁଣ୍ୟ ଫଳ ରାଧା ଥାଉ",
          "ସଦା ଶ୍ରୀକୃଷ୍ଣ କୋଳରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କହିଥିଲେ ଗର୍ଗ ପୂର୍ବେ ପୂର୍ଣ୍ଣବ୍ରହ୍ମ",
          "ସନାତନ ବୋଲି ଯାକୁ",
          "ସେ ବ୍ରଜବିଧୁ ଏ କେମନ୍ତ ନୋହିଲେ",
          "ଥିଲା ଅଧୀନ ହେବାକୁ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଗୋପ ବଧୁଙ୍କ ସଂଳାପଯାକ ଶୁଣି",
          "ଗୋପାଳକୃଷ୍ଣ ଚଳିଲା",
          "ସ୍ୱେଶ୍ୱରୀଙ୍କ ଅପହୁଡ଼ କାଳ ଜାଣି",
          "ପଦାମ୍ଭୋଜରେ ସେବିଲା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radha-pari-radha-sina-gopalakrusna-malabagouda/"
    }
  ],
