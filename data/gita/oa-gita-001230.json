{
  "id": "oa-gita-001230",
  "name": {
    "en": "Nabina kahinki mora bina",
    "or": "ନବୀନା କାହିଁକି ମୋର ବିନା"
  },
  "composer": "oa-person-000069",
  "mula_raga": [
    "oa-raga-000202"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nabina-kahinki-mora-bina-aparadhe-lakhminarayana-deba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବୀନା କାହିଁକି",
          "ମୋର ବିନା ଅପରାଧେ ମାନ କାହିଁକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାମ କଳାବତୀ ବୋଲେ ନ କର ନିରାଶ",
          "ଶରଣାଗତ ଜନରେ ଏ କି ପଉରୁଷ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୋ ଲେଖା କରଜ ଗାରେ ଧରାକୁ ନ ଚିର",
          "ଥାଉ ଏ କାମ କରଜେ ଚିଠି ଲେଖିବାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଙ୍କେରୁହ ଦୃଶା ତୁ ମୋ ଅଙ୍କେ ଗଜଗତି",
          "ନ ମଣ୍ଡୁ ବୃଥାରେ ବସିଅଛୁ ମଥା ପୋତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷେ ଲକ୍ଷ୍ମୀନାରାୟଣ ତୋ ସ୍ନେହେ ଅଧୀନ",
          "ମାନ ତେଜି ରସବତୀ ଦିଅ ଚୁମ୍ବଦାନ"
        ]
      }
    ]
  },
  "sources": [
    {
