{
  "id": "oa-gita-001302",
  "name": {
    "en": "Mo rama mane ki panchila re",
    "or": "ମୋ ରାମା ମନେ କି ପାଞ୍ଚିଲା ରେ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000199"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mo-rama-mane-ki-panchila-re-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋ ରାମା ମନେ କି ପାଞ୍ଚିଲା ରେ",
          "ବେନି କୁମ୍ଭ ପରେ ସାତ କୁମ୍ଭ ଥୋଇ",
          "ପଞ୍ଚ ମନକୁ ତୋଷିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏକେ ବେନି ମୁଖ ତାର ଚାରି ମୁଖ",
          "ଷଡ଼ଚକ୍ରରେ ଘୋଟିଲା",
          "ମନ୍ଦରସୁତା ସେ ମନରେ ହରଷେ",
          "ପନ୍ଦରନେତ୍ର ମୋହିଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରୀ ପରେ ହରି ହରି ପରେ କରୀ",
          "କି ରଙ୍ଗେ ଚଢ଼ାଇଥିଲା",
          "ଚନ୍ଦ୍ର ପରେ ସୂର୍ଯ୍ୟ ସୂର୍ଯ୍ୟ ପରେ ଚନ୍ଦ୍ର",
          "ତା ପରେ ତାରା ଖଞ୍ଜିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିମ୍ବଫଳ କିବା ଜମ୍ଭିଳ ଶ୍ରୀଫଳ",
          "ଫଳେ ପରିପୂର୍ଣ୍ଣ ହେଲା",
          "ଶମ୍ଭୁ ବୋଲିକରି ଦର୍ଶନ କରନ୍ତେ",
          "ଦୁକୂଳ ଘୋଡ଼ାଇଦେଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନାରୀ ବାର-ଚାରି ବରଷ କୁମାରୀ",
          "ପର ପୁରୁଷ ମୋହିଲା",
          "ବୋଲେ ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ ବୀରବର",
          "ନିଜ ମନ୍ଦିରେ ଚଳିଲା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mo-rama-mane-ki-panchila-re-bhanja/"
    }
  ],
