{
  "id": "oa-gita-000426",
  "name": {
    "en": "Sakhi se mohanare priti kari",
    "or": "ସଖୀ ସେ ମୋହନରେ ପ୍ରୀତି କରି"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000120"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-se-mohanare-priti-kari-bangala-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ସେ ମୋହନରେ ପ୍ରୀତି କରି",
          "ହେଲି ସିନା ମୁଁ ଏବେ ଏତେ ସରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପୋଡ଼ୁ ଏ କପାଳ ଦଶା ହେଲି ଯା ଭଗାରୀ ହସା",
          "ନିନ୍ଦା ଅପବାଦରେ ମୁଁ ଗଲି ସରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେ ଜାଣିଥିଲା ଏପରି କରିବେ ବୋଲି ଶ୍ରୀ ହରି",
          "ଦିନ ସରୁ ନାହିଁ ମିତ ଡରି ଡରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏ ବ୍ରଜବଜାର ଯାକ ବାଜେ ଅକୀର୍ତ୍ତି ଟମକ",
          "ନିରନ୍ତରେ ନେତ୍ରୁ ଝରେ ଅଶ୍ରୁବାରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କବି ବେଣୁଧର ଭଣି ଦୂତୀ ଭାଷେ ପ୍ରୀତି ବାଣୀ",
          "ହେଟି ଅଇଲେଣି ସେ ମୁରଲୀଧାରୀ"
        ]
      }
    ]
  },
  "sources": [
    {
