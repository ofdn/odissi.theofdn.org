{
  "id": "oa-gita-000809",
  "name": {
    "en": "Harili patha chhada mote",
    "or": "ହାରିଲି ପଥ ଛାଡ଼ ମୋତେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000119"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/harili-patha-chhada-mote-khambabati-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହାରିଲି ପଥ ଛାଡ଼ ମୋତେ ମୋହନ",
          "ଲାଜେ ମୁଁ ସରିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମାଳତୀ ହସିଲା କୋଇଲି ଭାଷିଲା",
          "ଶିଉଳି ଲସିଲା",
          "ସରସ ନଳିନ ମଳିନ",
          "ଦିଶିଲାନି ବାରିଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦିଅ ମୋର ନୀଳ ବାସ",
          "ଛଳ ଛାଡ଼ ପୀତବାସ",
          "ସଜାଡ଼ି ଦିଅ ମୋ ବେଶ",
          "ଚରଣ ଧରିଲି ସରିଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେ ସଖୀ ଜାଣିଲେ ହେଲେ",
          "ପଥେ ଚାଲିବି କି ଭଲେ",
          "କି ଲାଭ ଯେବେ ସେ ଗେଲେ",
          "ପଛେ ମୁଁ ଝୁରିଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୁଞ୍ଜ ତେଜ କଳାଶଶୀ",
          "ନିଶି ଶେଷେ କବିଶଶୀ",
          "ଗୁହାରି ଜଣାଏ ଆସି",
          "ଶରଣ ପଶିଲି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
