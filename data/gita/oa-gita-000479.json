{
  "id": "oa-gita-000479",
  "name": {
    "en": "Gostha chandrama asibe aja go saja saja",
    "or": "ଗୋଷ୍ଠଚନ୍ଦ୍ରମା ଆସିବେ ଆଜ ଗୋ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000034"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gostha-chandrama-asibe-aja-krusna-kedara-adatali-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୋଷ୍ଠଚନ୍ଦ୍ରମା ଆସିବେ ଆଜ ଗୋ ସାଜ ସଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଇଛନ୍ତି ଝରା ଧର ଧୀରାଧୀରା",
          "ରାସରଙ୍ଗିନୀ କାହିଁକି ଲାଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋ ବାଣୀ ପ୍ରତୀତ କର ପ୍ରାଣମିତ",
          "ଭାଳୁଭାଳୁ ହୋଇଯିବ ସଞ୍ଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜଗିଛନ୍ତି ବାଟ ଶିଖଣ୍ଡମୁକୁଟ",
          "ପଠାଇବୁ ବୋଲି ଲାଗି ସଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଘେନି ମୋ ବଚନ ହୁଅ ସୁପ୍ରସନ୍ନ",
          "ପରିପନ୍ଥୀଙ୍କର ଭାଙ୍ଗୁ ଓଜ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କଙ୍କତି ଟଙ୍କାରି ନଖରେ କିଙ୍କରୀ",
          "ଗୋପାଳକୃଷ୍ଣ ବୋଲଇ ବ୍ରଜ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
