{
  "id": "oa-gita-001119",
  "name": {
    "en": "Ke ki kahi kala mana re chandrabadana",
    "or": "କେ କି କହି କଲା ମନା ରେ ଚନ୍ଦ୍ରବଦନା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ke-ki-kahi-kala-mana-re-chandrabadana-sri-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେ କି କହି କଲା ମନା ରେ ଚନ୍ଦ୍ରବଦନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପାଶୋରି ଦେଲୁ କେମନ୍ତେ ଅଙ୍କେ ଧରି ସୁରତାନ୍ତେ",
          "ବୋଲୁ ମୋ ଗଣ୍ଠିର ସୁନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆଗେ ପଠାଇ ଆଳୀକି ଆସି ଥାଉ ଦେହଳୀକି",
          "ପାଛୋଟି ଘନ ଜଘନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତନୁ ନୀପ ଫୁଲ ପରି ହେଉ ଥାଇ ଜବାଧରୀ",
          "ଶୁଣିଲା କ୍ଷଣି ମୋର ନାଁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପ୍ରୀତି ବତ୍ସଳା ପଣରେ ନାରୀ ଜଗତ ଯାକରେ",
          "ତିଳେ ନ ଥିଲା ତୁଳନା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ହସି ହସି ଲାଜେ କଥା କହି ପୋତିବାର ମଥା",
          "କାହିଁ ଗଲା ସେ ଭାବନା ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ପୂର୍ବ ପରି ବେଶ ହୋଇ",
          "ଥରେ ଦିଶା ଦେଉ କିନା ରେ"
        ]
      }
    ]
  },
  "sources": [
