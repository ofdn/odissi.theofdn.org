{
  "id": "oa-gita-000457",
  "name": {
    "en": "Kahinki aja dwijaraja badane",
    "or": "କାହିଁକି ଆଜ ଦ୍ୱିଜରାଜ ବଦନେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinki-aja-dwijaraja-badane/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ଆଜ ଦ୍ୱିଜରାଜ ବଦନେ",
          "ଲାଜ ଭରି କିଶୋରୀ ନ ଚୁମ୍ବାଉ ଗୋ",
          "ଅରସବତୀ ଘନକୁନ୍ତଳା ବୋଲି ଜନ",
          "ନ ବୋଲନ୍ତୁ ତୋ ଊଣା ଯାଉ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରସାଇବାକୁ ତୋତେ ମିଳିବ ନାହିଁ ରତେ",
          "ମୋ ପରି ପରିଜନ ଆଉ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୋ ବଧୁଲି ଅଧର ସ୍ୱର୍ଗ ସୁଧା ମଧୁର",
          "ମୋର ରସନାକୁ ସମଜାଉ ଗୋ ।",
          "ଜାଣୁ ତ ପ୍ରାଣମିତ ମାର ମାର୍ଗଣ ଜାତ",
          "ସମୟ ଏ କେମନ୍ତ ଦାଉ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୋଟିଏ ଅଭଳାଷ ବହି ଆସିଛି ପାଶ",
          "ସମ୍ପ୍ରତି ଚରମକୁ ଥାଉ ଗୋ ।",
          "କୋଳେ ନିଶ୍ଚଳେ ବସ କରି ସବ୍ରୀଡ଼ ହାସ",
          "କବିମିହିର ଦୁଃଖ ଯାଉ ଗୋ"
        ]
      }
    ]
  },
