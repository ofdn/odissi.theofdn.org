  "id": "oa-gita-001451",
  "name": {
    "en": "Jibara jibana akhi buji dela ki he chakanayana",
    "or": "ଜୀବର ଜୀବନ, ଆଖି ବୁଜି ଦେଲ କି ହେ ଚକାନୟନ"
  },
  "composer": "oa-person-000013",
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jibara-jibana-akhi-buji-dela-ki-he-chakanayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୀବର ଜୀବନ, ଆଖି ବୁଜି ଦେଲ କି ହେ ଚକାନୟନ",
          "କରୁଣାସାଗର ପାଲଟି ପଥର",
          "ନିଦା ହୋଇଗଲ କି ହେ ଚକାନୟନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୀଳାଚଳନାଥ ହେଲ କି ଅଚଳ",
          "ସୁଧାଶୂନ୍ୟ ହେଲ କି ହେ ଚକାନୟନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଣିମାପଣକୁ କିଏ ନେଲା ହରି",
          "କୃପାବାରି ଶୁଖିଲା କି ଚକାନୟନ"
        ]
      }
    ]
  },
