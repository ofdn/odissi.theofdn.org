{
  "id": "oa-gita-001107",
  "name": {
    "en": "Sukhi hebi labhi priyaku",
    "or": "ସୁଖୀ ହେବି ଲଭି ପ୍ରିୟକୁ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000111"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sukhi-hebi-labhi-priyaku-utkanthita-kalyana-ahari-upendra-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିରହୋତ୍କଣ୍ଠିତା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରେ ସହଚରୀ ସୁଖୀ ହେବି ଲଭି ପ୍ରିୟକୁ",
          "ସୁନ୍ଦର ଚାଟୁରେ ଆଜ ଛଡ଼ାଇବେ ମୋର ଲାଜ",
          "ଦୂର କଲି କାମ ଭୟକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସନ୍ନିଧେ ମିଳନ୍ତେ ମୁହିଁ ବସାଇବେ କୋଳେ ନେଇ",
          "ମୁଖେ ଦେଇ ଚୁମ୍ବଚୟକୁ",
          "ଖସାଇ ଦେହରୁ ବାସ ସେ ଯେ କରିବେ ଆଶ୍ଳେଷ",
          "ଦେଖାଇ ନ ଦେବି କାୟକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୁରତି ରତରେ କିଣି ମନକୁ ରଖିବେ ପୁଣି",
          "ରଚି ଗତି ସମୁଦାୟକୁ",
          "ସନ୍ତୋଷେ କରିବିଟି କି ବଜାଇ କ୍ଷୁଦ୍ରଘଣ୍ଟିକି",
          "ମୁଁ ଗୋ ରତିରଣ ଜୟକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସେ ଯେ କରିବେ କରଜ କ୍ଷତ ବିଧିରେ ବିରାଜ",
          "ମୋ ଉରଜ ଶମ୍ଭୁ ଦ୍ୱୟକୁ",
          "ଶୁଝାଇବି ସୁଧା ପିଇ ଅଧରେ ଦନ୍ତ ବସାଇ",
          "ଏକ ଭାବେ ସେ ସମୟକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶୁଣନ୍ତିଟି ଆସି ଏହା ନାହା ଯାଇ ଦ୍ୱାରେ ଚାହା",
          "ରଖିଥିବେ ମୋରେ ଲୟକୁ",
          "ସଂଖ୍ୟାବାନ ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ କହେ ପ୍ରେମାନନ୍ଦ",
          "ଉତ୍କଣ୍ଠିତା ରସୋଦୟକୁ"
        ]
      }
    ]
  },
