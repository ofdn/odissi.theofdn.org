{
  "id": "oa-gita-001358",
  "name": {
    "en": "Asa nikunjaku srimati",
    "or": "ଆସ ନିକୁଞ୍ଜକୁ ଶ୍ରୀମତୀ"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000103"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asa-nikunjaku-srimati-regupta-gourahari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସ ନିକୁଞ୍ଜକୁ ଶ୍ରୀମତୀ",
          "ଆସି ଅର୍ଦ୍ଧ ହୋଇଗଲାନି ରାତି",
          "ଅସିତ ସୁଝୀନ ବାସ ପହରଣ",
          "ତୋଷ ବହି ହାସ ପ୍ରକାଶି ଅତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଉଦୟ ହେଲେ ନିଶାପତି",
          "ନିଦ ତେଜି ଆରେ ସୁକୁନ୍ଦ ଦନ୍ତୀ",
          "ସଦନକୁ ଛାଡ଼ି ବଦନ ସଜାଡ଼ି",
          "ମାଦକ ବିହି ହୃଦୟେ ଝଟତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସମସ୍ତେ କଲେନି ଶୟନ",
          "ଶ୍ୟାମ ଗଲେଣି ଗୋ ବୃନ୍ଦା ବିପିନ",
          "ପ୍ରେମଭରେ ବଂଶୀ ସୁମଧୁର ଘୋଷି",
          "କାମନା ତୁମ୍ଭ ଠାରେ ରଖିଛନ୍ତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୋକିଳ ମୟୂର ଭ୍ରମର",
          "ଡାକିଉଚ୍ଚେ କରୁଛନ୍ତି ଝଙ୍କାର",
          "କର୍କଶ ଛାଡ଼ି ଅର୍କସୁତା ନୀରସଂ",
          "-ପର୍କ କରି ବହିଲାନି ମାରୁତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୁନ୍ଦ ନାଗେଶ୍ୱର ବାସନ୍ତି",
          "ବୃନ୍ଦ ପୁଷ୍ପିତ ହୋଇ ରହିଛନ୍ତି",
          "ବୃନ୍ଦାବନ ଯାକ ଚନ୍ଦ୍ର କିରଣରେ",
          "ସାନ୍ଦ୍ର ହୋଇ କି ସୁନ୍ଦର ଦିଶନ୍ତି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚାହିଁ ଏ ସକଳ ଶୋଭାକୁ",
          "ରହିଥିବେ ବହି ଅତି ଦୁଃଖକୁ",
          "ଏହିକ୍ଷଣି ଯା ତୁହି ଭେଟ ସହି",
          "କହେ ଗୌରଚନ୍ଦ୍ର ଦେବ ଭାରତୀ"
        ]
      }
    ]
  },
  "sources": [
