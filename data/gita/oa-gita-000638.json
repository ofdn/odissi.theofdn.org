  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asa-asa-sakhi-jiba-punnaga-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସ ଆସ ସଖି ଯିବା ବାସକୁ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆଉ ରହିଲେ ଏ ବନେ ଅସତୀ ବୋଲିବେ ଜନେ",
          "ଅବଶ୍ୟ କରିବେ ଉପହାସକୁ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଖିଳ ଲାବଣ୍ୟ ଶିରୀ ଆଉ କି ଆସିବେ ହରି",
          "ଅରୁଣ ଭଜିଲା ପରକାଶକୁ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆମ୍ଭ ଅବସ୍ଥା ସଜନୀ ଆଗରେ ରଖି ପଦ୍ମିନୀ",
          "ଅଧରେ ଧରିଛି ଦରହାସକୁ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆନ ନାଗରୀକୁ ଧରି ଆରମ୍ଭିଲେ ନିଶ୍ଚେ ହରି",
          "ଅନଙ୍ଗ ରଙ୍ଗରେ ଅଭିଳାଷକୁ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆର୍ତ୍ତି କହେ ଜଗଦ୍ଦେବ ଆଉ କି ସତେ ଆସିବ",
          "ଅଭିନବ କୁଞ୍ଜବନ ରାସକୁ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
