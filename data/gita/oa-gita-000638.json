  "name": {
    "en": "Asa asa sakhi jiba",
    "or": "ଆସ ଆସ ସଖି ଯିବା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000005"
