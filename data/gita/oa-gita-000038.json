{
  "id": "oa-gita-000038",
  "name": {
    "en": "Ago duti aja rati syama priti",
    "or": "ଆଗୋ ଦୂତୀ ଆଜ ରାତି ଶ୍ୟାମ ପ୍ରୀତି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ago-duti-aja-rati-syama-priti-nohila/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଗୋ ଦୂତୀ ଆଜ ରାତି",
          "ଶ୍ୟାମ ପ୍ରୀତି ନୋହିଲା ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶେଯ କରି ମୁଁ ସୁପାତି ଜାଳିଲି କର୍ପୂର ବତୀ",
          "ରାତିଯାକ ଉଜାଗରେ ଦେଖ ଆସି ପାହିଲା ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାଳିଆ ପୁରୁଷ ପ୍ରୀତି ଅବଳା ନାରୀ ଯୁବତୀ",
          "କରତି ହେଉଛି ଛାତି ଧରତୀରେ ସହିଲା ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରିଥିଲି ପ୍ରତିଆଶା ହରି ଫେଡ଼ିବେ ଦୁର୍ଦ୍ଦଶା",
          "ମୋଠାରେ ଏଡ଼ିକି ଦଶା କେଉଁ ନାରୀ ବିହିଲା ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୀତେ କହେ ବନମାଳୀ ଏ ରସରେ ଭାଳି ଭାଳି",
          "ବାନ୍ଧିଥିଲି ଫୁଲଗଭା ବାସି ହୋଇ ରହିଲା ଗୋ"
        ]
      }
    ]
  },
