{
  "id": "oa-gita-000698",
  "name": {
    "en": "Priya sakhi karibi ki buddhi go",
    "or": "ପ୍ରିୟସଖି କରିବି କି ବୁଦ୍ଧି ଗୋ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000130"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priya-sakhi-karibi-ki-buddhi-go-kumbha-kamodi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରିୟସଖି କରିବି କି ବୁଦ୍ଧି ଗୋ",
          "ଗଲିନି ମୁଁ ଲାଜେ ସଢ଼ି",
          "କେଉଁ ଗୁଣେ ରସି ନିକୁଞ୍ଜବିଳାସୀ",
          "ଅଛନ୍ତି ମୋ ଠାରେ ଜଡ଼ି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁଁ ତ ଯଉବନ ମଦରେ ଗୁମାନ",
          "ମନ୍ଥର ଚାଲି ନ ଜାଣେ",
          "ମୋତେ ଜଳକେଳି ଅଳସୀ ମରାଳୀ",
          "ଗମନା ବୋଲନ୍ତି କେଣେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରଜେ କେତେ ବାମା ନାହାନ୍ତି ସୁଷମା",
          "ସମ୍ଭାରେ ରମ୍ଭାରୁ ବଳି",
          "ସେ ଶିଖଣ୍ଡଚୂଳ ନୟନ ଅଞ୍ଚଳ",
          "ଆନେ ତ ନ କଲା କେଳି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଁ ଚାହିଁ ନ ଜାଣେ ଲବେ ନେତ୍ର କୋଣେ",
          "ନଚାଇ ଭୂରୁକୁ ଗେଲେ",
          "ତେବେ ପୀତପଟ ନଟ ଖଞ୍ଜରୀଟ",
          "ନୟନା ମୋ ନାମ ଦେଲେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନ ଜାଣିବାକୁ ଯେଉଁ ଦିନ ଭଲେ",
          "ନ ମଜାଇ କଣ୍ଠ ଭୂଷା",
          "ବିଗୁଣ ନ ଘେନି ଦ୍ୱିଗୁଣ ସେ ଦିନ",
          "କରନ୍ତି ଶୋଭା ପ୍ରଶଂସା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏଥୁଁ ଅବା ଖେଦ ହେଉଛି କି ମୋଦ",
          "ନ ଜାଣନ୍ତି ଆନ ସଖୀ",
          "କ୍ଷିତିପତି ବୃନ୍ଦ ମୁକୁଟ ମୁକୁନ୍ଦ",
          "ଦେବ କେବଳ ମୋ ସାକ୍ଷୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
