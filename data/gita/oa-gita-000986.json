{
  "id": "oa-gita-000986",
  "name": {
    "en": "Ane priya mo nahin",
    "or": "ଆନେ ପ୍ରିୟ ମୋ ନାହିଁ"
  },
  "composer": "oa-person-000016",
  "mula_raga": [
    "oa-raga-000045"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ane-priya-mo-nahin-arabhi-bhimadeba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆନେ ପ୍ରିୟ ମୋ ନାହିଁରେ",
          "କେହି ବଞ୍ଚିବ ରାତି ସଖୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଦେଶ ଗଲା ଦିନୁ କମଳଦଳ ତନୁ",
          "ନ ରୁଚଇ ଚାରୁ ପଲଙ୍କ ସୁପାତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲୋତକ ଜଳେ ବୁଡ଼ି ରହିଲି ପ୍ରତି ଘଡ଼ି",
          "ନ ତୁଟଇ ବିରହ ବିଷମ ତାତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗାଢ଼େ କରଜ ଘାତ ନ ଦିଅନ୍ତି ମୋ କାନ୍ତ",
          "କେତେ ଦୁଃଖ ସହିଲା ଦାରୁଣ ଛାତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିଦେଶ ବିଚ୍ଛେଦରେ ନିଶି ଦିନ ନ ସରେ",
          "ମରମେ ମାରେ କାମ ବିଷମ କାତି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୃପା କରିବେ ଶିବ ସତେ ଭାଗ୍ୟ ଦିଶିବ",
          "କହେ ଶ୍ରୀ ଭୀମଦେବ ଏ ରସେ ମାତି"
        ]
      }
    ]
  },
  "sources": [
    {
