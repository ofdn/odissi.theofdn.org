{
  "id": "oa-gita-000439",
  "name": {
    "en": "E guru girisama garu hela re sakhi",
    "or": "ଏ ଗୁରୁ ଗିରୀଷମ ଗରୁ ହେଲାରେ ସଖୀ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000004"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/e-ghora-girisama-garu-hela-re-sakhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏ ଗୁରୁ ଗିରୀଷମ ଗରୁ ହେଲାରେ ସଖୀ",
          "ଝାଞ୍ଜି ପରଖରେ ବହିଲା ରେ",
          "ସରିତ ଝୁରି ସରି ସୁବେଶ ପରିହରି",
          "କଷାୟ ବାସେ ତନୁ ଛାଇଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୀଳ ନିଚୋଳ ତେଜି ବସନ୍ତ ସଙ୍ଗେ ହେଜି",
          "ଲତିକା ଶିରୀହରା ହୋଇଲା ରେ",
          "ଅଗୁରୁ ଗନ୍ଧସାର ହେଲା ତ ନାରଖାର",
          "ଗୋଳା ଗରଳ ସରି ଦହିଲା ରେ ।",
          "(ପଡ଼ି)",
          "ନଳିନୀ ଦଳ ଶେଯେ ଝାମ ଯାଉଛି ସେ ଯେ",
          "ନଳିନଦେହା ଏହା ସହିଲା ରେ",
          "ଅନୁଭବ ଯାହାର ମନୁ ଯିବ କି ତାର",
          "କବିଚନ୍ଦ୍ର ଏ ରସେ କହିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
