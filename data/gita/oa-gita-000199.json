{
  "id": "oa-gita-000199",
  "name": {
    "en": "Dekhili sri krusnaku go",
    "or": "ଦେଖିଲି ଶ୍ରୀକୃଷ୍ଣକୁ ଗୋ",
    "alternates": [
      "Dekhili Sri Krushnaku",
      "Dekhili Sri Krusnanku",
      "Dekhili Sri Krushnanku"
    ]
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekhili-sri-krusnanku-go-kalyana-upendra-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖିଲି ଶ୍ରୀକୃଷ୍ଣକୁ ଗୋ ଆଜ ମୁଁ ସଖୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯମୁନା ଘଟୁଆରୀ ଲଟ ଲବଣୀ ଚୋରି",
          "ଗୋପୀଙ୍କ ମନୋହାରୀ ପୀତଦୁକୂଳିଆଙ୍କୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାସେ ସିନ୍ଧୁ ଫଳ ଶୋହେ କାମକୁ ମୋହେ",
          "ଘନେ ଶୁକ୍ର ଉଦୟେ",
          "ହାର ପଦକ ଦେହେ ମଣି କଙ୍କଣ ବାହେ",
          "ନୂପୁର ପଦ୍ମ ପାୟେ ରତ୍ନ ମୁକୁଟିଆକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୁନ୍ଦରବର କାଳିଆ ବନମାଳିଆ",
          "କଦମ୍ବ ତରୁତଳିଆ",
          "ମକର କୁଣ୍ଡଳିଆ ବତ୍ସା ପ୍ରତିପାଳିଆ",
          "ସେବତୀ ଚୂଳିଆକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋକୁଳ ରାଜନନ୍ଦନ ନାଗରୀ ପ୍ରାଣ",
          "ଗୋପୀଙ୍କ ହୃଦଚନ୍ଦନ",
          "କାଳୀ ବିଷ ଖଣ୍ଡନ ବୃନ୍ଦାବନ ମଣ୍ଡନ",
          "ବ୍ରହ୍ମା ଗର୍ବଗଞ୍ଜନ ଘନ ଶ୍ୟାମଳିଆକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦେଖିଲା ବେଳୁ ନୟନ ଚନ୍ଦ୍ରବଦନ",
          "ଯାହା ହେଉଛି ମନ",
          "ଚିତ୍ତ ମୋ ଛନଛନ ଉଡ଼େ ତାଠାକୁ ମନ",
          "ଯୁବ ରାଜ ନନ୍ଦନ ଧ୍ୟାୟେ ସେହି ରୂପକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
