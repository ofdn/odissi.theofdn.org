{
  "id": "oa-gita-001430",
  "name": {
    "en": "Chahin de rama",
    "or": "ଚାହିଁଦେ ରେ ରାମା"
  },
  "composer": "oa-person-000035",
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahin-de-rama-saberi-ekatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହିଁଦେ ରେ ରାମା",
          "ତହିଁ କି ସୁଷମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବେଶ ରୁଚିର ସେ ନଟବର",
          "ବିରାଜେ ଆଜ ରସିକରାଜ",
          "(ପଡ଼ି)",
          "ସୁନ୍ଦର ରଦବାସ ମନ୍ଦ ମଧୁର ହାସ",
          "ବଦନ ରୁଚି ରୁଚିର ସଦନ ଅବା ଶୋଭାର",
          "ମଦନ ମଦକୁ ଦୂର କରଇ କିବା ନିକର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଦମ୍ବ ମୂଳେ ପୀତ ଦୁକୂଳେ",
          "ବଜାଏ ଧୀରେ ବଂଶୀ ଅଧରେ",
          "(ପଡ଼ି)",
          "ସେ ସ୍ୱର ବିମୋହନ ସର୍ବ ଦୁଃଖ ଦହନ",
          "ସକଳ ନିକେତନ ଉଚ୍ଛନ୍ନ କଲେ ପରାଣ",
          "ସୁଧାଧାର ବରଷଣ ବସୁଧାରେ କରେ ପୁଣ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
