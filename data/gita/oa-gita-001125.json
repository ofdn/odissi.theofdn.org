{
  "id": "oa-gita-001125",
  "name": {
    "en": "Sahi antila nahin ki",
    "or": "ସହି ଅଣ୍ଟିଲା ନାହିଁ କି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahi-antila-nahi-ki-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହି ଅଣ୍ଟିଲା ନାହିଁ କି",
          "ହେଲା ଉତ୍ତାରୁ ଏତେ ସରିକି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯା ପ୍ରସଙ୍ଗରେ ନିଜ ଅଙ୍ଗ ପାଶୋରୁ",
          "ଶ୍ରୀ ବୃନ୍ଦାରଣ୍ୟାଭିଷେକି",
          "ଆଜ ଦିନଯାକ ମୁଖ ଦେଖି ନାହୁଁ",
          "ମନେ ପଡ଼ିଲେ ନାହିଁ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଞ୍ଚୁଲୀ ହାର ଦୂର କରି ଯାହାକୁ",
          "ହୃଦୟରେ ଧରି ଜାକି",
          "ଲୋଟୁଛନ୍ତି ଏବେ ସେ ଅବନୀ ଶେଯେ",
          "ରାଧେ ରାଧେ ବୋଲି ଡାକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯାର ଶିର ଛାଇ ପଡ଼ିଲେ ଚରଣେ",
          "ପଳାଇ ଯାଉ ତେଣିକି",
          "ଏବେ ଦାସୀ ପଛେ ବୁଲାଇଲୁ ରାଧେ",
          "ପୋଛାଇ ନେତ୍ରୁ ପାଣିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଳି ବସିଥିଲା ତୋ ପଦ ଚିହ୍ନର",
          "ଧୂଳିରେ ତାହା ବିଲୋକି",
          "ବୋଳି ହୋଇ ଯାଉ ମୁଁ ହାତ ଧଇଲି",
          "ଆଣି ଦେବି ବୋଲି ଡାକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷଇ ମଜ୍ଜିଥିବା",
          "ମାନସ ଭାଜିଯାଇ କି",
          "ପରମାଣ କରି କହୁଥିଲେ କେଣେ",
          "ନ ଯିବି ବୋଲି କେଣିକି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
