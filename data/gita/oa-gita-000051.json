  "name": {
    "en": "Kara khyama sadaye sri kisori",
    "or": "କର କ୍ଷମା ସଦୟେ ଶ୍ରୀ କିଶୋରୀ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
