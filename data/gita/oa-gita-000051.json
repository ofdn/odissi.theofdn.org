    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କର କ୍ଷମା ସଦୟେ ଶ୍ରୀ କିଶୋରୀ",
          "ଦାସ ଦୋଷ ଦିବ୍ୟ ଚିତ୍ତେ ବିଚାରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୁମ୍ଭର ବିନା ଗତି",
          "ନାହିଁ ଆନ ଶ୍ରୀମତୀ",
          "ରକ୍ଷା କର ଶୁଣି ମୋର ଗୁହାରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆଉ ମୁହିଁ ଏପରି",
          "କରିବି ନାହିଁ ଗୋରୀ",
          "ଆସ ଆସ ସାଦରେ ରାସେଶ୍ୱରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାଷେ ଧୀରେ ତାରିଣୀ",
          "ଯା ହେବାର ହେଲାଣି",
          "ପୂରୁବର କଥା ଦିଅ ପାଶୋରି"
        ]
      }
    ]
  },
  "sources": [
