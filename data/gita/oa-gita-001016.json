{
  "id": "oa-gita-001016",
  "name": {
    "en": "Syama bandhu e nisi re",
    "or": "ଶ୍ୟାମ ବନ୍ଧୁ ଏ ନିଶିରେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000017"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-bandhu-e-nisi-re-asibe-ahari-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ବନ୍ଧୁ ଏ ନିଶିରେ",
          "ଆସିବେ କି ଗୋ ସଙ୍ଗିନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏ ମଦନ କଦନକୁ ନାଶିବେ କି ଗୋ",
          "ପଲ୍ୟଙ୍କରେ ନିଃଶଙ୍କରେ ବସିବେ କି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମତେ ଦେଖି ଡୋଳା ଢାଳି ହସିବେ କି ଗୋ",
          "ରଙ୍ଗେ ମୋ ଅଙ୍ଗରେ ଭୋଳେ ମିଶିବେ କି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହରଷେ ସରସେ ବାଣୀ ଭାଷିବେ କି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀମତୀ ମତିକି ସେ ଉଲ୍ଲାସିବେ କି ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦ୍ୱିଜ ରଘୁନାଥ ବୋଲେ ତୋଷିବେ କି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
