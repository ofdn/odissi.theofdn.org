{
  "id": "oa-gita-000751",
  "name": {
    "en": "Sari jauchi go sukhara jhulana jata",
    "or": "ସରିଯାଉଛି ଗୋ ସୁଖର ଝୁଲଣ ଯାତ"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sari-jauchi-go-sukhara-jhulana-jata/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରିଯାଉଛି ଗୋ ସୁଖର ଝୁଲଣ ଯାତ",
          "ଦେଖିଥାଅ ଥରେ ନୟନ ପଥରେ",
          "ମୋ ପ୍ରାଣସହି ସଙ୍ଗାତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀଭାନୁ ଦୁଲ୍ଲାଳୀ ତୁଲେ ବନମାଳୀ",
          "ଫୁଲ ଦୋଳିରେ ବିଜେ ତ",
          "ସଖୀଗଣ ମିଳି ଦେଇ ହୁଳହୁଳି",
          "ଝୁଲାନ୍ତି କି ରଙ୍ଗରେ ତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମର୍ଦ୍ଦଳ ମନ୍ଦିରା ବୀଣା ଏକତାରା",
          "ଶଙ୍ଖ ମହୁରୀ ବାଜେ ତ",
          "ରବା ଭେରୀ ତୂରୀ ବିଜୟ କାହାଳୀ",
          "ମଧୁର ସ୍ୱର ସହିତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୃଦଙ୍ଗ କଂସାଳ ଘଣ୍ଟା କରତାଳ",
          "ସାରଙ୍ଗୀ ବାଜେ ତା ସାଥ",
          "ନାଗରା ଟିକରା ଖଞ୍ଜଣୀ ଘୁମୁରା",
          "ବାଦ୍ୟ କେ କରିବ ଅନ୍ତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାଗ ଆଳାପିଣ କରୁଛନ୍ତି ଗାନ",
          "ମାନସ ଭୁଲା ସଙ୍ଗୀତ",
          "ଦେବଦୁନ୍ଦୁଭିର ତୁଲେ ଗୀତସ୍ୱର",
          "ଶୁଭୁଅଛି ଅଲୋକିତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗଉରଚରଣ ବୋଲେ ମୁଁ ଶରଣ",
          "-ରକ୍ଷଣ କୃଷ୍ଣଙ୍କ ଭୃତ୍ୟ",
          "ଦରଶନ କରି ସେ ଶୋଭା ମାଧୁରୀ",
          "ଛାମୁରେ କରିବି ନୃତ୍ୟ"
        ]
      }
    ]
  },
  "sources": [
    {
