{
  "id": "oa-gita-000275",
  "name": {
    "en": "Syama sari radha sudhakara muhi ki",
    "or": "ଶ୍ୟାମ ସରି ରାଧା ସୁଧାକରମୁହୀଁ କି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000057"
  ],
  "mula_tala": [
    "oa-tala-000009"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-sari-radha-sudhakara-muhi-ki-gopalakrusna-kusuma-kedara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ସରି ରାଧା ସୁଧାକର ମୁହୀଁ କି",
          "ପାଞ୍ଚିଲେ ଘଟଣା ପତି ନାରୀ ସୁନ୍ଦରପଣ କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିନେ ଦୂର ଦୂରରେ ବ୍ରଜରାଜ ପୁରରେ",
          "ବିଲୋକି ମୁଁ ଅନୁମାନିଥିଲି ଦୁହିଙ୍କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭାଳିବଟି ଚିତ୍ତରେ ତାରତମ୍ୟ ଉଚ୍ଚରେ",
          "ଏ ତା ଶ୍ରୁତିତଟ ସରି ହେବ ନାହିଁ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନ ଦେନ୍ତେ କି କୀର୍ତ୍ତିଦା ମାଗିଥିଲେ ଯଶୋଦା",
          "ଏବେ ଦେଖି ପୁଣି ନିନ୍ଦୁଛନ୍ତି ବିହିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯମୁନା କୂଳରେ ସୁନା କଞ୍ଜ ପରି ଭାବନା",
          "ଦିଶୁଥାନ୍ତା ଜନେ ମୂରୁଛନ୍ତେ ଚାହିଁ କି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷେ ରାଧା ଲାଜ ହରଷେ",
          "ହସି ହସି ଛଳେ ଚଳି ହେଲେ ଆଳୀକି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
