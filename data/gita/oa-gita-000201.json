{
  "id": "oa-gita-000201",
  "name": {
    "en": "Kanta bina diba rajani sajani",
    "or": "କାନ୍ତ ବିନା ଦିବା ରଜନୀ ସଜନୀ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kanta-bina-diba-rajani-sajani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାନ୍ତ ବିନା ଦିବା ରଜନୀ ସଜନୀ",
          "କୋଟି ଯୁଗ ସମ ହେଲାଟି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହିଁ ସେ ରହିଲେ କିମ୍ପାଇଁ ନଇଲେ",
          "ତେଣୁ କରି କାମ ଅନଳେ ଦହିଲେ",
          "କିବା କେଉଁ ନାରୀ କି ମନ୍ତ୍ରେ ମୋହିଲା",
          "ସେ ଦେଶେ ମଦନ ମଲାଟି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭାରି ହେଲା ଆସି ଅଙ୍ଗକୁ ବସନ",
          "ତଥି ପରେ ଆଭରଣ ଏ ଭୂଷଣ",
          "ଦେଖ ଦେଖ ସଖୀ ଏ ଝଞ୍ଜା ପବନ",
          "କାମ ବାଣେ ପ୍ରାଣ ନେଲାଟି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯେବେ ଥାନ୍ତେ କାନ୍ତ ବସନ୍ତ କାଳରେ",
          "ଘେନି ବଞ୍ଚୁଥାନ୍ତି ରଜନୀ କୋଳରେ",
          "କେତେ କେତେ ପ୍ରୀତିମାନ କରୁଥାନ୍ତି",
          "କେଡ଼େ ସୁଖ ତୁଟି ଗଲାଟି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତା ଲାଗି ଏ ଜୀବ ନାଶକୁ ଲଭିବ",
          "ହତ୍ୟା ଦୋଷରେ କି କାରେଣି ହୋଇବ",
          "କୁସୁମ ଭୂଷଣ ହେଲା ଅକାରଣ",
          "ଭଣେ ଉପଇନ୍ଦ୍ର ଭଞ୍ଜଟି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kanta-bina-diba-rajani-sajani/"
    }
  ],
