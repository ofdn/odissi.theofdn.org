{
  "id": "oa-gita-000817",
  "name": {
    "en": "E ki kalu re sumana",
    "or": "ଏ କି କଲୁ ରେ ସୁମନା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000021"
  ],
  "mula_tala": [
