{
  "id": "oa-gita-000086",
  "name": {
    "en": "Ehi para brajaraja nandana go",
    "or": "ଏହି ପରା ବ୍ରଜରାଜ ନନ୍ଦନ ଗୋ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ehi-para-brajaraja-nandana-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏହି ପରା । ବ୍ରଜରାଜ ନନ୍ଦନ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖିଲେ ନେତ୍ର ପବିତ୍ର । ହୋଇ ଯାଉଅଛି ମାତ୍ର ।",
          "କି ଶୋଭା ପାଉଛି ଚନ୍ଦ୍ରବଦନ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବୀନ ଘନ ବରନ । ନିନ୍ଦୁଅଛି ଅପଘନ ।",
          "କଟୀକି ଶୋଭିଛି ପୀତବସନ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୋଟିଏ ରବି ସରାଗ । ନିନ୍ଦୁଛି କୁଣ୍ଡଳ ଯୁଗ ।",
          "ଲକ୍ଷ କାହିଁ ହେବ ଛାର ମଦନ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ରସରେ ବନମାଳୀ । ଭାଳି କହେ ବ୍ରଜବାଳୀ- ।",
          "-ମାନଙ୍କ ଏ ନେତ୍ରାନନ୍ଦ ସଦନ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
