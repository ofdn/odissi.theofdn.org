{
  "id": "oa-gita-000579",
  "name": {
    "en": "Muncha manini mana timiram",
    "or": "ମୁଞ୍ଚ ମାନିନି ମାନତିମିରଂ"
  },
  "composer": "oa-person-000114",
  "mula_raga": [
    "oa-raga-000124"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/muncha-manini-mana-timiram/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "( ମଲ୍ଲାର ରାଗେଣ )",
          "ମୁଞ୍ଚ ମାନିନି ମାନତିମିରଂ ମୁଖସୁଧାକରମୁଜ୍ଜ୍ୱଳମ୍",
          "କୁରୁ କୃଶୋଦରି ବିରହଦହନୋ ଦହତୁ ନହି ମମ ମାନସମ୍"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିତର ସଖି ବିକଚାମ୍ବୁରୁହମୁଖି ମଧୁରତରମଧୁରାମୃତମ୍",
          "ଅଥ ତ୍ରିପୁଟଃ –",
          "ଭୁବନମୋହବିଧାୟି ଯଦ୍ୟପି କିମିହ କୁରୁତାମ୍",
          "କାମଗରଳଂ ନିଖିଳଦେହବିସର୍ପିତମ୍ ।",
          "ଅଥ ଯତିଃ –",
          "ମୟି କଥଂ କୁପିତାସି ଭାମିନି ବତ ବିଦେହି ଯଥୋଚିତମ୍ ।",
          "ଅଥାଭୋଗଃ –",
          "କର୍ଣ୍ଣକାର୍ମୁକମିଳିତମେତଂ ଲୋଳଲୋଚନଶାୟକମ୍ ।",
          "ତ୍ରିପୁଟଃ –",
          "ବପୁଷି ମମ କମଳାକ୍ଷି ନିକ୍ଷିପ ବିଫଳଭାବମ୍",
          "ଭଜତୁ ସହସା କୁପିତମନ୍ମଥଧନୁରିଦମ୍ ।",
          "ଯତିଃ –",
          "ମୁରଭିଦିତି ଚାଟୁପଟୁକୁଶଳୋ ଦିଶତୁ ଗଜପତିମଙ୍ଗଳମ୍ ।"
        ]
      }
    ]
  },
