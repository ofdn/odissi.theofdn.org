{
  "id": "oa-gita-000416",
  "name": {
    "en": "Naha rahile kaha sadane go",
    "or": "ନାହା ରହିଲେ କାହା ସଦନେ ଗୋ"
  },
  "composer": "oa-person-000075",
  "mula_raga": [
    "oa-raga-000117"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/naha-rahile-kaha-sadane-go/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ନାହା ରହିଲେ କାହା ସଦନେ ଗୋ",
          "ମୋର ଯାହା ହେଉଛି ଦେହ ମଦନେ ଗୋ",
          "କା ଆଗେ କହିବଇଁ ସାହା ତ କେହି ନାହିଁ",
          "ଆହା ବୋଲନ୍ତି ଚନ୍ଦ୍ରବଦନେ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆସିବେ ବୋଲି ନନ୍ଦକୁମର ଗୋ",
          "ବେଗେ ମଣ୍ଡନ କଲି କେଳିମନ୍ଦିର ଗୋ",
          "ନାନା କୁସୁମେ ଆଳୀ କରେ ଗୁନ୍ଥାଇ ମାଳି",
          "ଗୋଳି ରଖିଲି ଚୂଆ ଚନ୍ଦନ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାସକସଜ୍ଜା କେଳି ସଦନେ ଗୋ",
          "ସହି ନିଶି ବଞ୍ଚିଲି ଘୋର କଦନେ ଗୋ",
          "ରମଣୀ ଶିରୋମଣି କେଉଁ ମାନସ କିଣି",
          "ନେଲା କଟି କିଙ୍କିଣୀ ବାଦନେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୋମନାଥ ବୀରବର ବଦତି ଗୋ",
          "କୁଶଳେ ଅନୁଗୁଳ ଭୂପତି ଗୋ",
          "ବୋଲନ୍ତି ରାଜସୁତା ହୋଇଣ ଉତ୍କଣ୍ଠିତା",
          "ମତେ ନିବେଶି କେଳିସଦନ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
