{
  "id": "oa-gita-000911",
  "name": {
    "en": "Ahe nikhila mana mohana",
    "or": "ଆହେ ନିଖିଳ ମନମୋହନ"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000005"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-nikhila-mana-mohana-todi-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହେ ନିଖିଳ ମନମୋହନ ପୁଣ୍ଡରୀକ ନୟନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପର ଆୟତ୍ତରେ ଏହା ଅରଜିଲ ନୀଳବାହା",
          "ପାଇଥିବ ସେ ସୁଦେହା ଆହା କି କଦନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଘେନି ତୁମ୍ଭ ଆଦେଶ ଯାଇ ଲଳିତା ପାଶ",
          "କହିବି କରି ବିଶ୍ୱାସ ଗିରେ ତୋଷି ମନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପରବ ଶୀତମୟୂଖ ଗରବ ହର ଶ୍ରୀମୁଖ",
          "ନ ଶୁଖାଅ ଦେଖି ଦୁଃଖ ହୁଏ ମୋ ବର୍ଦ୍ଧନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏତେ କହି ବୃନ୍ଦା ଗଲେ ଲଳିତାକୁ ଭେଟିଲେ",
          "ରାଜେନ୍ଦ୍ର ଶ୍ରୀକୃଷ୍ଣ ପଦେ ନମେ ନିଶିଦିନ"
        ]
      }
    ]
  },
  "sources": [
