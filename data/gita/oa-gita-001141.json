{
  "id": "oa-gita-001141",
  "name": {
    "en": "Syama ja ja juhara to piratiki",
    "or": "ଶ୍ୟାମ ଯା ଯା ଜୁହାର ତୋ ପୀରତିକି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-ja-ja-juhara-to-piratiki-gopalakrusna-mohanaa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ଯା ଯା ଜୁହାର ତୋ ପୀରତିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୋର କଥାକୁ କୁଳଜା ପରତେ କରିଥିବ ଯା",
          "ହୃଦୟରେ ମାରି ନ ଘେନି କାତିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବରଜର ଗାରଡ଼ିଆ ଦେଖାଇ ଏ ଭୂରୁ ଡିଆଁ",
          "ମନମଥ ଭୂତ ଲଗାଉ ସତୀକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଁ ବୁଦ୍ଧି ହୁଡ଼ିଲିନି ତ ହୋଇଲା କାଳେ ବାଳୁତ",
          "ମାରି ପକାଇ ଥିଲା କେ ଯୁବତୀକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋବର୍ଦ୍ଧନ ମଲ୍ଲ ଘରୁ ଲୁଚି ଅଇଲା ବେଳରୁ",
          "ଚାହୁଁ ନ ଥିଲି ମୁଁ କି ସେ ପଦ୍ଧତିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ବୋଲନ୍ତି ସେ ମୁଁ ନୁହଇ",
          "ଛୁଅଁ ବୋଇଲେ ଛୁଇଁବି ଧରତୀକି"
        ]
      }
    ]
  },
