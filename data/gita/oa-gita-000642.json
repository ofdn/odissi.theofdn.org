{
  "id": "oa-gita-000642",
  "name": {
    "en": "Jauchi ma aau na pare",
    "or": "ଆଉ ନ ପାରେ ତାକୁ ଟାକି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jauchi-ma-aau-na-pare-sri-raga/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯାଉଛି ମା ଆଉ ନ ପାରେ ତାକୁ ଟାକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଂବେଶ ବେଶ ଭୋଜନେ ଲୋଡ଼ି ମୋତେ ଗୁରୁଜନେ",
          "ଚଳିହେଉଥିବେ ପରା ଡାକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିତି ଧରି ଦୂତୀ କର ଯତନେ ଅରଜିବାର",
          "ଚୋର ପୀରତିରେ ଏ କି ଚାକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହଜାର ହଜାର ଯାର ପ୍ରଣୟବତୀ ବଜାର",
          "ତହୁଁ କେହି ରଖିଥିବ ଜାକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବ୍ରଜୁଁ ହୁଅନ୍ତେ ବାହାର ତା ପଦପଙ୍କଜେ କାର",
          "କୁଚାଚଳେ ରହିଥିବ ଠାକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତୁଚ୍ଛାକୁ ତ ଶ୍ୟାମ ପ୍ରୀତି ଲମ୍ପଟା ବୋଲି ମୋ ଖ୍ୟାତି",
          "ନ ରହିବ ପୁଣି ସିନା ବାକି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଅବଶ୍ୟ ତୋ ଜୀବ ଯିବ ନେଲେ ନେବ ମନୋଭବ",
          "ରଖିଲେ ରଖିବେ ଶ୍ରୀ ପିନାକୀ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଜଗଦ୍ଦେବ ଭାଷା ଶୁଣି ଆଳି କହିଲେ ମୁଁ ଆଣି",
          "ଏବେ ଭେଟାଇଲେ କି ହେଲା କି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
