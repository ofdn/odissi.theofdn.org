{
  "id": "oa-gita-000803",
  "name": {
    "en": "Rusila nabina adose",
    "or": "ରୁଷିଲା ନବୀନା ଅଦୋଷେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000122"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rusila-nabina-adose-bageswari-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରୁଷିଲା ନବୀନା",
          "ଅଦୋଷେ ଧନୀ ଚନ୍ଦ୍ରବଦନା ନବୀନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳା ଖେଳା ଡୋଳା ଲୀଳା",
          "ତାରା ସେ କି ବିଳସିଲା",
          "ଘନ କେଶ ଘନ ଭେଦି",
          "ଚନ୍ଦ୍ରଶୋଭନା ସୁବଦନା ନବୀନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ଅବା ହିମ ଆଗମେ",
          "ଶିଶିର ନୀର ସଙ୍ଗମେ",
          "ଝାଉଁଳି ପଡ଼ିଲା ସେ କି",
          "କଞ୍ଜସୁମନା ଶିରୀଚୂନା ନବୀନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନଇଁଲା କି ଭୂରୁ ଚାପ",
          "ହେବ ଏ ବଇରୀ ତାପ",
          "ନୟନ ପିତୁଳା ଖରେ",
          "ବିନ୍ଦେ ଶୋଭନା ସୁନୟନା ନବୀନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସେ କାଳେ ଯେଉଁ ସମ୍ପତ୍ତି",
          "ଦେଲା ସେ ମୋ ଗଜପତି",
          "ସୁର ପଦ କବିଚନ୍ଦ୍ର",
          "ତଉଲରେ ଊଣା ସତେ ସିନା ନବୀନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
