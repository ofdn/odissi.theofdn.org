  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahi-kehi-mohila-go-sri-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହି କେହି ମୋହିଲା ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କହିଲେ ଯେତେ ମୋହିଲେ ତେତେ",
          "ରହିଲେ ଲୀଳା କାହିଁ ବିହି ସେ କେତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୋପରେ ଅତି ପରତାପ ହୋଇଛି ସ୍ମର",
          "ଧାପ ଦେଉଛି ଏବେ ମୋ ପରେ ନିରନ୍ତର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନ୍ଦପଣେ ତୁହାଇ ମନ୍ଦପାଳ ଡାକଇ",
          "ମନ୍ଦ ପବନ ଅରବିନ୍ଦ ବନୁ ବହଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦ୍ୱିଜ ରଘୁନାଥ ଭଜଇ ନିରତ",
          "ସେ ଯୁଗଳ ପଦ ହେଜ ଜନେ ନିରତ"
        ]
      }
    ]
  },
