{
  "id": "oa-gita-000472",
  "name": {
    "en": "Saja kanja nayana kunje",
    "or": "ସଜ କଞ୍ଜନୟନା କୁଞ୍ଜେ ଆରେ"
  },
  "composer": "oa-person-000013",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/saja-kanja-nayana-kunje/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜ କଞ୍ଜନୟନା କୁଞ୍ଜେ ଆରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଧୁର ତାନ ତୋଳି",
          "ଜୟ ଶ୍ରୀ ରାଧେ ବୋଲି",
          "ବାଜେ ଶ୍ୟାମ ମୁରଲୀ",
          "ସଞ୍ଜରେ କୁଞ୍ଜରେ ମଧୁରେ ମଧୁରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେତେ ବ୍ରଜ ଯୁବତୀ",
          "କୁଞ୍ଜେ କଲେଣି ଗତି",
          "ଭେଟିବେ ବୋଲି ବ୍ରଜରାଜରେ",
          "ନ ଯାରେ ନ ଯାରେ ନ ଯାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋପଦାଣ୍ଡ ଉଚ୍ଛୁଳେ",
          "ଯମୁନା ଜଳେ ଭୋଳେ",
          "ସାଜିଛି ଆଜି କାହ୍ନୁ",
          "ରାଜାରେ ନ ଯାରେ ନ ଯାରେ ନ ଯାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
