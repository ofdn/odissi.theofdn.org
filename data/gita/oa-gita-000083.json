{
  "id": "oa-gita-000083",
  "name": {
    "en": "Sariba ki e nisi go",
    "or": "ସରିବ କି ଏ ନିଶି ଗୋ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000036"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sariba-ki-e-nisi-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରିବ କି ଏ ନିଶି ଗୋ",
          "ନାଗର ମୋହନ ବିନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଣ୍ଟ ଦେଇ ବେଣୁଧାରୀ ନଇଲେ ମୋ କୁଞ୍ଜପୁରୀ",
          "କେ ସହିବ ମାର ବେଦନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଖୀ ମୁଁ ଯୋଡ଼ୁଛି କର ଏଥକୁ ଉପାୟ କର",
          "ଦୂର ହେବ ସନ୍ତାପ କିନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସକଳ କଲା ଅନ୍ଧାର ପ୍ରଖର ମଦନଶର",
          "ଘନଶ୍ୟାମ ଅନାଉଁ କିନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅସନ ମଣିଲି ବିଷ ଗରୁ ହେଲା ଝୀନବାସ",
          "କୃଷ୍ଣ କୃଷ୍ଣ ବୋଲି ଜପେ ନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀମତୀ ବିଳାପ ଜାଣି ମିଳିଲେ ସେ ବେଣୁପାଣି",
          "ବନମାଳୀ କରେ ଭାବନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
