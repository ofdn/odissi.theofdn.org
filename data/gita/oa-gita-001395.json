{
  "id": "oa-gita-001395",
  "name": {
    "en": "Lalita labanga lata",
    "or": "ଲଳିତ ଲବଙ୍ଗ ଲତା",
    "alternates": [
      "Lalitalavangalata",
      "Viharati Haririha Sarasavasante",
      "Biharati Haririha Sarasabasante",
      "Gita Govinda",
      "Geeta Govinda",
      "Gita Gobinda",
      "Jayadeva",
      "Jayadeba"
    ]
  },
  "composer": "oa-person-000161",
  "mula_raga": [
    "oa-raga-000043"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000010"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/lalita-labanga-lata-biharati-haririha-gitagovinda-gitagobinda/"
    },
    "stanzas": [
      {
        "n": 7,
        "lines": [
          "ବସନ୍ତେ ବାସନ୍ତୀ କୁସୁମ-ସୁକୁମାରୈରବୟବୈ",
          "-ର୍ଭ୍ରମନ୍ତୀଂ କାନ୍ତାରେ ବହୁବିହିତ-କୃଷ୍ଣାନୁସରଣମ୍ ।",
          "ଅମନ୍ଦଂ କନ୍ଦର୍ପ-ଜ୍ୱର-ଜନିତ-ଚିନ୍ତାକୁଳତୟା",
          "ବଳଦ୍‌ବାଧାଂ ରାଧାଂ ସରସମିଦମୂଚେ ସହଚରୀ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "। ତୃତୀୟଃ ପ୍ରବନ୍ଧ ।",
          "ବସନ୍ତରାଗଯତିତାଳାଭ୍ୟାଂ ଗୀୟତେ ।"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଅସ୍ୟ ଲକ୍ଷଣମ୍ ।",
          "ଶିଖଣ୍ଡବର୍ହୋଚ୍ଚୟବଦ୍ଧଚୂଡ଼ଃ ପୁଷ୍ଣନ୍ ପିକଂ ଚୂତଲତାଙ୍କୁରେଣ ।",
          "ଭ୍ରମନ୍ମୁଦାରାମମନଙ୍ଗମୂର୍ତ୍ତିର୍ମତୋ ମତଙ୍ଗସ୍ୟ ବସନ୍ତରାଗଃ ।"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଲଳିତ-ଲବଙ୍ଗ-ଲତା-ପରିଶୀଳନ-କୋମଳ-ମଳୟ-ସମୀରେ ।",
          "ମଧୁକର-ନିକର-କରମ୍ବିତ-କୋକିଳ-କୂଜିତ-କୁଞ୍ଜ-କୁଟୀରେ ।",
          "ବିହରତି ହରିରିହ ସରସ-ବସନ୍ତେ",
          "ନୃତ୍ୟତି ଯୁବତି-ଜନେନ ସମଂ ସଖି ବିରହି-ଜନସ୍ୟ ଦୁରନ୍ତେ । ଧ୍ରୁବମ୍"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ଉନ୍ମଦ-ମଦନ-ମନୋରଥ-ପଥିକ-ବଧୂଜନ-ଜନିତ-ବିଳାପେ ।",
          "ଅଳିକୁଳ-ସଂକୁଳ-କୁସୁମ-ସମୂହ-ନିରାକୁଳ-ବକୁଳ-କଳାପେ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ମୃଗମଦ-ସୌରଭ-ରଭସ-ବଶମ୍ବଦ-ନବ-ଦଳ-ମାଳ-ତମାଳେ ।",
          "ଯୁବଜନ-ହୃଦୟ-ବିଦାରଣ-ମନସିଜ-ନଖରୁଚି-କିଂଶୁକ-ଜାଳେ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ମଦନ-ମହୀପତି-କନକ-ଦଣ୍ଡ-ରୁଚି-କେଶର-କୁସୁମ-ବିକାଶେ ।",
          "ମିଳିତ-ଶିଳୀମୁଖ-ପାଟଳି-ପଟଳ-କୃତ-ସ୍ମର-ତୂଣ-ବିଳାସେ"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ବିଗଳିତ-ଲଜ୍ଜିତ-ଜଗଦବଲୋକନ-ତରୁଣ-କରୁଣ-କୃତହାସେ ।",
          "ବିରହି-ନିକୃନ୍ତନ-କୁନ୍ତ-ମୁଖାକୃତି-କେତକି-ଦନ୍ତୁରିତାଶେ"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ମାଧବିକା-ପରିମଳ-ଲଳିତେ ନବ-ମାଳିକ-ଜାତି-ସୁଗନ୍ଧୌ ।",
          "ମୁନି-ମାନସମପି ମୋହନ-କାରିଣି ତରୁଣାକାରଣ-ବନ୍ଧୌ"
        ]
      },
      {
        "n": 16,
        "lines": [
          "ସ୍ଫୁରଦତିମୁକ୍ତ-ଲତା-ପରିରମ୍ଭଣ-ମୁକୁଳିତ-ପୁଲକିତ-ଚୂତେ ।",
          "ବୃନ୍ଦାବନ-ବିପିନେ ପରିସର-ପରିଗତ-ଯମୁନା-ଜଳ-ପୂତେ"
        ]
      },
      {
        "n": 17,
        "lines": [
          "ଶ୍ରୀଜୟଦେବ-ଭଣିତମିଦମୁଦୟତି ହରି-ଚରଣ-ସ୍ମୃତି-ସାରମ୍ ।",
          "ସରସ-ବସନ୍ତ-ସମୟ-ବନ-ବର୍ଣ୍ଣନମନୁଗତ-ମଦନ-ବିକାରମ୍"
        ]
      }
    ]
  },
