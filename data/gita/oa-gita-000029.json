    "stanzas": [
      {
        "n": 0,
        "lines": [
          "(ଧ୍ରୁବପଦାଙ୍ଗ)"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସସାଗରା ଧରାପତି",
          "ନିଖିଳ ଭୁବନପତି",
          "ବିରାଜିତ ସଦା ନିତି",
          "ନିରେଖ ଚପଳମତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଷୟ ବାସନା ତ୍ୟଜ",
          "ନିରନ୍ତରେ ଧ୍ୟାନେ ମଜ୍ଜ",
          "ଦରଶନ ପରଶନ",
          "ପରାପତ ସଦଗତି । ଅନ୍ତରା ।"
        ]
      }
    ]
  },
