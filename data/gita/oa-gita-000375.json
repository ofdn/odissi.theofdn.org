{
  "id": "oa-gita-000375",
  "name": {
    "en": "Jane jete bhabe priti jubati",
    "or": "ଜାଣେ ଯେତେ ଭାବେ ପ୍ରୀତି ଯୁବତୀ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000104"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jane-jete-bhabe-priti-jubati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜାଣେ ଯେତେ ଭାବେ ପ୍ରୀତି ଯୁବତୀ",
          "ଜଗତେ ଆଉ କାହିଁ ଅଛି",
          "ଜୀବ ଥିବା ଯାଏ ପିଣ୍ଡେ ନାଗରୀକି ଦଣ୍ଡେ",
          "ନୋହିବ ମୂରୁଛି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେବେ ମାଗଇ ମୁଁ ପ୍ରେମସୁଧା ଦିଅ",
          "ହସି ଭାଷଇ ମୃଗାକ୍ଷୀ",
          "ଜାଣଇ କେ ତାହା କରି ସିନା ବୋଲି",
          "ସଜନୀମାନଙ୍କୁ ପୁଚ୍ଛି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାନୁ ଉପରେ ବସାଇଲେ ଗୋରୀକି",
          "ତଳେ ବସୁଥାଏ ଖସି",
          "ଜଳଜପାଦକୁ କର ବଢ଼ାଇଲେ",
          "ବେଗେ ଯାଏ ଅଙ୍ଗେ ମିଶି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜାଣିବାରେ ମୋର ମୋ ଆଡ଼କୁ ପଛ",
          "କରି ଦିନେ ଶୋଇ ନାହିଁ",
          "ଜୀବଧନର ଏ ଗୁଣ ସୁମରି ପୁଣ",
          "ଜୀବନେ ଅଛି ରହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜବାଧର ତାର ମଧୁ ପିଉଥିଲେ",
          "ଅମୃତ ପାନ ହିଁ ଛାର",
          "ଜପି କାମ କ୍ଷୀଣ ପ୍ରିୟଭାବ",
          "କହେ ଉପଇନ୍ଦ୍ର ରସସାର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jane-jete-bhabe-priti-jubati/"
    }
  ],
