  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/naba-basantagamane-kedaragouda-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବ ବସନ୍ତାଗମନେ କି ମୋଦ ନ ଦିଏ ମନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରସରୁ ଦକ୍ଷିଣାନିଳ ପଲ୍ଲବିତ ପାଦପ କୁଳ",
          "ବେଣୁ ବିଯୋଗିନୀ ତୁଳ ଦିଶେ ପତ୍ରାଳି ବିହୀନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାର ବନିତାଙ୍କ ପରି ପତ୍ର ପୁଷ୍ପେ ସର୍ବ ବଲ୍ଲରୀ",
          "ନବ ନବ ବେଶ ଧରି ନାଚନ୍ତି ମନ୍ଦ ସ୍ପର୍ଶନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନ୍ୟାୟପର ନରବର ନ୍ୟାୟ କୀର୍ତ୍ତି ଖ୍ୟାତି କାମର",
          "ବୃଦ୍ଧି କରିଲା ବାସର ସାଧବୀ ସ୍ନେହ ସମ୍ମାନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦରିଦ୍ର କୁଟୁମ୍ବାସକ୍ତ ମାନବର ଆୟୁଷବତ",
          "କ୍ରମେ କ୍ରମେ କ୍ଷୟପ୍ରାପ୍ତ ହେବ ତୁଷାର ନିଦାନେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସୁର ଗୁଲାପ ସ୍ତବକେ ଭୃଙ୍ଗ ଶାଳଗ୍ରାମ ଉତ୍ସୁକେ",
          "ସ୍ଥାପି ମରନ୍ଦାଭିଷେକେ ମଜିଛି ଶତ୍ରୁ ସାଧନେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପିକ ଚୂତ ସ୍ତବକରେ ଖେଳି ମନ୍ମଥ ସ୍ତବ କରେ",
          "ରାଜେନ୍ଦ୍ର ଅହର୍ନିଶରେ ରସିଲେ ଶ୍ରୀକୃଷ୍ଣ ଧ୍ଯାନେ"
        ]
      }
    ]
  },
