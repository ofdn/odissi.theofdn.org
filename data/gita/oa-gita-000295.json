{
  "id": "oa-gita-000295",
  "name": {
    "en": "Mana anare na rasi",
    "or": "ମନ ଆନରେ ନ ରସି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000068"
  ],
  "mula_tala": [
    "oa-tala-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-anare-na-rasi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନ ଆନରେ",
          "ନ ରସି ହୁଅ ତୁ ସାବଧାନ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଷୟାବିଷକୁ ଗଦ ଭକ୍ତ ଜନେ ପ୍ରମୋଦ",
          "ନନ୍ଦନନ୍ଦନ ପଦ ଗାନ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତେଜ କୁସଙ୍ଗ ସଙ୍ଗ କୁମତି କ୍ଷଣଭଙ୍ଗ",
          "ତ୍ୟଜ ଶରୀରୁ ଅହଙ୍କାର ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନେତ୍ରେ ନ ଦେଖୁ ଯାହା ସତ କି ମଣୁ ତାହା",
          "ସ୍ୱପନ ଧନ ପରି ଜାଣ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ଯେଉଁ କଳେବର ହେଜ ଅସ୍ଥିର ସ୍ଥିର",
          "ଭବସାଗରୁ ହେବ ପାର ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଧୀର ଶ୍ରୀ ବୀରବର ହୀର ମୁକୁଟ ଶିର",
          "ବୀରକିଶୋର ଦେବ ଗାନ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
