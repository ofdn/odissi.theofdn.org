{
  "id": "oa-gita-000731",
  "name": {
    "en": "Ki panchi bandhu basila",
    "or": "କି ପାଞ୍ଚି ବନ୍ଧୁ ବସିଲା ରୁଷି"
  },
  "composer": "oa-person-000122",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-panchi-bandhu-basila-jagannatha-gajapati-paraja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ପାଞ୍ଚି ବନ୍ଧୁ ବସିଲା ରୁଷି",
          "କେଉଁ ଦୋଷ ମୋର ଦେଖି ସୁଦୃଶୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁବେଶ କଲି ମୁଁ କେଡ଼େ ଯତନେ",
          "ପାଶେ ନ ବସିଲା କି ଭାବି ମନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଣ୍ଡିବା ସୁମନ ତଳପ ସାର",
          "ବ୍ୟର୍ଥ ହେଲା ଯା କେଳତି ଅଗାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରୁଣାମୟୀର କରୁଣା ଊଣା",
          "କାହିଁ ପାଇଁ ମୋରେ ନ ଗଲା ଜଣା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେତେ ପରି କଲି ଚାଟୁ ରଚନା",
          "ନ ଶୁଣିଲି ବୀଣା ଜିଣା ବଚନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚାହିଁଲା ନାହିଁ ତ ଆଡ଼ ନୟନେ",
          "ଚେଳାଞ୍ଚଳ ରଖି ଚାରୁ ଲପନେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଜଗନ୍ନାଥ ଦେବ ଭୂପତି ଭଣେ",
          "ବାଳାର ଚରିତ୍ର ବିଚିତ୍ର ମଣେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
