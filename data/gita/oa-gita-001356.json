{
  "id": "oa-gita-001356",
  "name": {
    "en": "Lata lagi jaithila eka",
    "or": "ଲଟ ଲାଗି ଯାଇ ଥିଲା ଏକା"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000056"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/lata-lagi-jaithila-eka-maruaa-gourahari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଲଟ ଲାଗି ଯାଇ ଥିଲା ଏକା ଆଜ",
          "ନଟବର ଘନଶ୍ୟାମଙ୍କର",
          "ଅଟକ ନ ମାନି ପଳାଇ ଆସିଲି",
          "ଲାଟପଣନ୍ତକୁ ଛଡ଼ାଇ ମୋହର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଛଟକରେ କେଉଁ ଠାରେ କିପରିରେ",
          "ଭେଟ ଅବା ଗଡ଼ିଯିବ ବୋଲି",
          "ଘଟ ଧରି କେବେ ହେଲେ ଏକା ଜଳ",
          "ଘାଟକୁ ଏ ଘେନି ନ ଯାଏ ଗୋ ପେଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୁଟ ହାଟକ ମୋ ଅଙ୍ଗ କାନ୍ତି ଚାହିଁ",
          "ଅଟକି ନ ପାରେ କ୍ଷଣେ ମତି",
          "ଘଟ ଛଳ କରି ଓଷ୍ଠ ଧରୁ କେତେ",
          "ଘାଟରୁ ମୋ ସୁଯୋଗରୁ ଗଲି ବରତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହଟ କରି ଜଗିଥାନ୍ତି ଗୋ କି ଘେନି",
          "ବାଟେ ହାଟେ ଦେଖା ହେବା ପାଇଁ",
          "ତୁଟଇ ନାହିଁ ପରା ଲୋଭ ଚିତ୍ତରୁ",
          "ଘଟଣା ହୋଇବା ଯାଇ ଆରେ ସହି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାଟକା ହୋଇ ଯାଉଛି ଗୋ ତାଙ୍କର",
          "କୂଟ ଆଚରଣ ଯାକ ଚାହିଁ",
          "ଭୋଟ କଥା ଜୋଟା ଯୋଟି ଦରିବାକୁ",
          "ଘଟ ଏକା ଘଟଣା କରିଛି ବିହି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପାଟକ କୁଳ ତୁମ୍ଭର ସେ ତ ନିଶ୍ଚେ",
          "ପାଟ ବ୍ରଜ ଯୁବରାଜ ହରି",
          "ସ୍ଫୁଟ କରି ଦ୍ୱିଜ ଗୌରହରି କହେ",
          "ଘଟଣା ହୋଇ ଯାଏ କେବେ କିପରି"
        ]
      }
    ]
  },
  "sources": [
    {
