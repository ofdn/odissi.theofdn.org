{
  "id": "oa-gita-000280",
  "name": {
    "en": "Balau ratilila bilasa manjula",
    "or": "ବଳାଉ ରତିଲୀଳା ବିଳାସମଞ୍ଜୁଳା"
  },
  "composer": "oa-person-000049",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/balau-ratilila-bilasa-manjula/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଳାଉ ରତିଲୀଳା ବିଳାସମଞ୍ଜୁଳା",
          "କଳାକଜ୍ଜ୍ୱଳକୁନ୍ତଳା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏଣିକି କଳାଡୋଳାକୁ ଚଳା",
          "ତନୁଚଞ୍ଚଳାକୁ ଖେଳା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସୁରସେ ଭୋଳା ହୋଇଣ ବାଳା",
          "କନ୍ଦର୍ପ ଦର୍ପକୁ ଦଳା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୋ ଦେହ ବଳାହକ ଚପଳା",
          "ନ ନାଶ ଦାସ ବତ୍ସଳା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମହୀମହିଳା ଚମ୍ପକମାଳା",
          "ହେବ ଯେ କୋଳେ ସୁଶୀଳା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗଳାକୁ ଗଳା ମିଳାଇ ବାଳା",
          "ପଦନ କହେ ଗରଳା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/balau-ratilila-bilasa-manjula/"
    }
  ],
