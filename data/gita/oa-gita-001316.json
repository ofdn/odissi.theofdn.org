{
  "id": "oa-gita-001316",
  "name": {
    "en": "Krusnanku besa kari sudama mali",
    "or": "କୃଷ୍ଣଙ୍କୁ ବେଶ କରି ସୁଦାମା ମାଳୀ"
  },
  "composer": "oa-person-000053",
  "mula_raga": [
    "oa-raga-000100"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/krusnanku-besa-kari-sudama-mali-mathura-mangala-kalahansa-kedara/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "କୃଷ୍ଣଙ୍କୁ ବେଶ କରି ସୁଦାମା ମାଳୀ",
          "ଚୂଳେ ଖଞ୍ଜିଲା ନେଇ କେତକୀ କଳି ଯେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆସେ କି କେଶରାହୁ ରସନା ଚାଳି",
          "ମୁଖ ଚନ୍ଦ୍ରଙ୍କୁ ଅବା ଦେବ ସେ ଗିଳି ଯେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବେଢ଼ାଇ ଦେଲା ନବ ବକୁଳ ଦାମ",
          "ଶୋଭାକୁ ଶକ୍ର ଚାପ ନୋହିବ ସମ ଯେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭୁଜଙ୍ଗଭୁକ ପୁଚ୍ଛ ତଥି ଉପରେ",
          "କୋଟି ଚନ୍ଦ୍ରିକା ସମ ନୋହିବେ ତାରେ ଯେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରଙ୍ଗ କୁସୁମ ବେଣୀ ପଛକୁ ପଡ଼ି",
          "ଯମୁନା ଜଳେ ରକ୍ତ କୁମୁଦ ଧାଡ଼ି ଯେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ସେହି ପ୍ରକାରେ ଦିଶୁଅଛି ଶୋଭନ",
          "ପୁଣି ଗଳାରେ ମାଳା ଜାତି କୁସୁମ ଯେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଅତି ସୁସଞ୍ଚ ଦିଶେ ଉର ଲିପନ",
          "ହେରି ରମ୍ଭା ତେଜିବ ସ୍ଵର୍ଗ ଭୁବନ ଯେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
