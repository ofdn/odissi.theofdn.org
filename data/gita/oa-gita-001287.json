{
  "id": "oa-gita-001287",
  "name": {
    "en": "Kahaku kahibi kisa re",
    "or": "କାହାକୁ କହିବି କିସ ରେ"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000040"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahaku-kahibi-kisa-re-ramakeri-aditala-gourachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହାକୁ କହିବି କିସ ରେ ସଙ୍ଗାତ",
          "ଯାହାକୁ ମୋହର କରି ଘେନିଥିଲି",
          "ତାହାକୁ ହୋଇଲି ବିଷ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆସିବେ ସେ ବୋଲି ଚାହିଁ ବସିଥିଲି",
          "ହୋଇ ଅଙ୍ଗେ ଦିବ୍ୟ ବେଶ",
          "ରହିଲେ ସେ କାହିଁ ରାତିକି ପୁଆଇ",
          "ଦେଇ ମୋତେ କାମ ତ୍ରାସ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରାତେ ଆସି ଯେତେ ରୂପେ ମୋ ଅଗ୍ରତେ",
          "ଭାଷିଲେ ବିନୟମାନ",
          "ପ୍ରତେ ତା କିଞ୍ଚିତେ ନ ଘେନି ମୁଁ ଚିତ୍ତେ",
          "ଅଧିକେ କଲି ଗୁମାନ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସରାଗରେ ପୁଣି ମୋତିହାର ଆଣି",
          "ମୋ ଆଗରେ ଯାଚୁଥିଲେ",
          "ବିରାଗ ମୁଁ ବହି ଅବହେଳେ ତହିଁ",
          "ଦୃଷ୍ଟିକି ନ ଦେଲି ଭଲେ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଟୁବର ବହୁ ଆରତରେ ତହୁଁ",
          "ଲୋଟିଲେହେଁ ପାଦ ତଳେ",
          "କଟୁ ପ୍ରାଏ ମଣି କପଟରେ ଗଣି",
          "ଛାଟିଦେଲି ସେହି କାଳେ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନିଜ ସଖୀ ବୋଧ ନ ରଖିଲି ମଧ୍ୟ",
          "ବ୍ରଜରାଜ ଗଲେ ଲାଜେ",
          "ଗଜପତି ଗୌରଚନ୍ଦ୍ର କହେ ଆଜ",
          "କରିବେ ଅବଶ୍ୟ ବିଜେ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
