{
  "id": "oa-gita-000092",
  "name": {
    "en": "Ke murali bajauchi",
    "or": "କେ ମୁରଲୀ ବଜାଉଛି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ke-murali-bajauchi-brundabane-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେ ମୁରଲୀ ବଜାଉଛି ବୃନ୍ଦାବନେ ଗୋ",
          "ତା ପରି ନାଗର ଆଉ ନାହିଁ ଜଣେ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ନାଦ କର୍ଣ୍ଣେ ବାଜିଲା । ପାଦ ମୋର ନ ଚଳିଲା ।",
          "ମାର ମରମେ ଭେଦିଲା ପଞ୍ଚବାଣେ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁରଲୀ ବଡ଼ ପ୍ରମାଦ । କଲା ମୋତେ ଅବସାଦ ।",
          "ପତିବ୍ରତା ଛଡ଼ାଇଲା ପରି ମଣେ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚିତ୍ରପଟେ ଲେଖାଇବି । ଯତନରେ ରଖାଇବି ।",
          "ଚିତ୍ତ ତହିଁ ଖଟାଇବି ଅନୁକ୍ଷଣେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଦାସ କହେ । ନନ୍ଦସୁତ ମନ ମୋହେ ।",
          "ଭଜି ମଜ୍ଜି ରହିଥିବି ଶ୍ରୀଚରଣେ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
