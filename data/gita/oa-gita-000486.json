{
  "id": "oa-gita-000486",
  "name": {
    "en": "Priti churi sanadia re",
    "or": "ପ୍ରୀତି ଛୁରୀ ଶାଣଦିଆ ରେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000131"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priti-churi-sanadia-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରୀତି ଛୁରୀ ଶାଣଦିଆ ରେ",
          "ବାଜିବ ଛାତିକି କର ଲୁହା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସ୍ନେହ ଲୁହା ଯତ୍ନେ ତତାଇ",
          "ଅଶ୍ରୁଜଳ ତହିଁରେ ଦେଇ",
          "ମାର କାରିଗର ଯତନେ ଗଢ଼ିଛି",
          "ତହିଁରେ କଳଙ୍କ ବିଷ ପିଆ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅତି ବଡ଼ ତୀକ୍ଷ୍ଣ ସେ ଧାର",
          "ନେତ୍ର ନ ଠାକଇ ତହିଁର",
          "ନବୀନ ଦର୍ପଣ ପରି ଝଟକଇ",
          "ସବୁଦିନେ ଦେଖ ଦିଶେ ନୂଆ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେ ଛୁରୀକି ଯେହୁ ଛୁଇଁବ",
          "ଜାତି କୁଳ ସବୁ ତେଜିବ",
          "ନ ପାରିଲେ ଧରି ନିଶ୍ଚେ ନାଶ ଯିବ",
          "ବିରହୀମାନଙ୍କ ପ୍ରାଣଖିଆ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୋଲେ ବନମାଳୀ ସେ ଛୁରୀ",
          "ସାନ ବଡ଼ ନୁହେଁ କାହାରି",
          "ଯାହା ସଙ୍ଗେ ଯେତେ ପୀରତି କରଇ",
          "ତେତିକି କରଇ କୁଆକୁଆ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
