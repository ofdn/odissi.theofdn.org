{
  "id": "oa-gita-000247",
  "name": {
    "en": "Kaha re sangini ke se nua lalana",
    "or": "କହରେ ସଙ୍ଗିନୀ କେ ସେ ନୂଆ ଲଳନା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000081"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-re-sangini-ke-se-nua-lalana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "(ମୋତେ) କହରେ ସଙ୍ଗିନୀ କେ ସେ ନୂଆ ଲଳନା",
          "କାନ୍ତି କୁଳ ଦେବତା କି କରି କଳନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦଶଦିଶ କାଞ୍ଚନାଭ ଦିଶୁଛି ଏ କି ଦୁର୍ଲ୍ଲଭ",
          "ଦଶାର୍ଦ୍ଧଶର କରିଛି ଏ କି ରଚନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁଣ ନୂପୁର ସୁରତ ମଣିଭୂଷାର ଶିଞ୍ଜିତ",
          "ବ୍ରଜର ଲକ୍ଷ୍ମୀ ପରାଏ ବରବରନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପରଂଧାମର ବିଭୂତି କିବା ମୋ ନେତ୍ରସମ୍ପତ୍ତି",
          "ମୂର୍ତ୍ତିବନ୍ତ ହୋଇ ବିଳସୁଛି କି ଅନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୃନ୍ଦାରଣ୍ୟ ଜନଙ୍କର କୋଟିଏ କୋଟି ଜନ୍ମର",
          "ଭାଗ୍ୟରାଶି ପରି ହେଉଛି ମୋ ଭାବନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷଣ ଯେ ନୂତନ ରଣରଣ",
          "ରହି ଅଳପ ଦିନରେ ଚିହ୍ନିବ ସିନା"
        ]
      }
    ]
  },
  "sources": [
    {
