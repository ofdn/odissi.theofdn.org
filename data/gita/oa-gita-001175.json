{
  "id": "oa-gita-001175",
  "name": {
    "en": "Kahaku mun karibain sakhi he chaka akhi",
    "or": "କାହାକୁ ମୁଁ କରିବଇଁ ସାକ୍ଷୀ ହେ ଚକାଆଖି"
  },
  "composer": "oa-person-000144",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahaku-mun-karibain-sakhi-he-chaka-akhi-sananda-dwija/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହାକୁ ମୁଁ କରିବଇଁ ସାକ୍ଷୀ ହେ ଚକାଆଖି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଡାକିଲେ ନାମ ଆରତେ ନ ଶୁଣ କିମ୍ପା ତୁରିତେ",
          "କି ବିଚାରି ହୃଦଗତେ ନ ଡେର ଶ୍ରବଣ ପଥେ",
          "ନାମ ଜପି କଣ୍ଠ ଗଲା ଶୁଖି ଶୁଖି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋ ଶୋଷ ଘଟ ମାତର ତୁମ୍ଭ କୃପା ଅକୂପାର",
          "ରଖିଛ ରଙ୍କ ଉଦର ତୃଷ୍ଣା ନ ରହଇ ମୋର",
          "ହେଉଅଛ ନିଷ୍ଠୁର କାହିଁକି ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନେବ ବୋଲି କିଛି ଲାଞ୍ଚ ମନେ କରିଅଛ ପାଞ୍ଚ",
          "ସେ କଥା ମନରୁ ମୁଞ୍ଚ ବଳିଗଲା ମନ ସ୍ୱଚ୍ଛ",
          "ଗୋପପୁରେ ପୟସର ଚାଖି ଚାଖି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପାଇ ନାନା ଉପବନ ସେବାରେ ହରଷ ମନ",
          "ଅଳସ କି ଅପଘନ ଘାରିଲା ନିଦ୍ରା ନୟନ",
          "ନ ଶୁଣୁଛ ସେ କାରଣୁ ନିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହଇ ସାନନ୍ଦ ଦ୍ୱିଜ ଆହେ ପ୍ରଭୁ ଚତୁର୍ଭୁଜ",
          "ଗଲାଣି କି ପୂର୍ବ ତେଜ ଦୁଃଖୀ ଦୁଃଖ ଯା ନ ବୁଝ",
          "ହୋଇବାରୁ ନୀଳାଚଳେ ତୁମ୍ଭେ ସୁଖୀ"
        ]
      }
    ]
  },
  "sources": [
