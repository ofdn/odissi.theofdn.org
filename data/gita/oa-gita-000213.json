  "name": {
    "en": "Syama bine sajani",
    "or": "ଶ୍ୟାମ ବିନେ ସଜନୀ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-bine-sajani-ane-banchibi-ki-malabagouda-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ବିନେ ସଜନୀ ଆନେ ବଞ୍ଚିବି କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୁଁ ତ କରିନାହିଁ ଦୋଷ ମୋରେ କାହିଁକି ନିରାଶ",
          "କରିଥିଲି କେତେ ଆଶ ଦହିଲେ କି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସେ ଶିଖିପୁଚ୍ଛ ଚୂଳିଆ ନବୀନ ଘନକାଳିଆ",
          "କଳାପ ଗୁଞ୍ଜମାଳିଆ ନଇଲେ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏ ଜୀବନ ଯିବ ଧନକୁ କେ ଭେଟାଇବ",
          "ଶ୍ରୀ ବୀରକିଶୋର ଦେବ ଭାଷିଲେ କି"
        ]
      }
    ]
  },
