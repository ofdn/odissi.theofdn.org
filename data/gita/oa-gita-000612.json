  "id": "oa-gita-000612",
  "name": {
    "en": "Brundaranya bihari he",
    "or": "ବୃନ୍ଦାରଣ୍ୟ ବିହାରି ହେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/brundaranya-bihari-he/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ବୃନ୍ଦାରଣ୍ୟ ବିହାରି ହେ ଶ୍ରୀ ନନ୍ଦାତ୍ମଜ",
          "ବୃନ୍ଦାରଣ୍ୟ ବିହାରି ବୃନ୍ଦାରକ ଉଦ୍ଧାରି",
          "କୁନ୍ଦାରବିନ୍ଦ ସହ ମନ୍ଦାର ମାଳା ଧାରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଜଳ ଜଳଦ ସୁନ୍ଦର ନିଜ ଶରୀର",
          "ସଜ ନୀଳୋତ୍ପଳ ରୁଚିର ।",
          "ଦ୍ୱିଜରାଜ ସୁହିମ ଦ୍ୱିଜ ହୀରକ ସମ",
          "ବ୍ରଜ ତାପନାଶନ ସୁଜନ ଚିତ୍ତ ଧାମ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଦନ ତୁମ୍ଭେ ତ ଗୁଣର ବଦନ ଛବି",
          "କଦନ ହରେ ନାରୀଙ୍କର ।",
          "ମଦନମୋହନ ଶୋଭା ହୃଦରେ ଭାବି ମୁଁ ଲୋଭା",
          "ଉଦୟ ହୁଅ ମୋ ଚିତ୍ତେ ସଦୟ ଭାବେ ସନ୍ତତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନିରତେ କବି ସୁଧାକର ରଘୁନାଥର",
          "ସ୍ମରଣ ଶ୍ରୀ ହରି ପୟର ।",
          "ହରଷେ ଜନେ ଚିନ୍ତ ସରସ କରି ଚିତ୍ତ",
          "ଦରଶନ ସେ ଦେବେ ଶରଣୁ ହେଲେ ସତ"
        ]
      }
    ]
  },
  "sources": [
    {
