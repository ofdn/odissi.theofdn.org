  "name": {
    "en": "Nahin ki mane tora syama nagara riti",
    "or": "ନାହିଁ କି ମନେ ତୋର ଶ୍ୟାମ ନାଗର ରୀତି"
  },
  "composer": "oa-person-000091",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nahin-ki-mane-tora-syama-nagara-priti/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାହିଁ କି ମନେ ତୋର ଶ୍ୟାମ ନାଗର ରୀତି",
          "କାହିଁକି ବୋଲୁଥାଉ ନାଆଁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଟରାଟ ସୁମନଲିଟ ପରି ତା ମନ",
          "ପ୍ରୀତି ଲୋଡ଼ଇ ନୂଆ ନୂଆ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁଞ୍ଚିଲା ବେଳେ ଜୀବ ସଞ୍ଚି ସଲିଳ ଲବ",
          "ବିଞ୍ଚି ଦେଉ ପରା ବାଆ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହେଉ ପଛକେ ନିନ୍ଦା ପ୍ରୀତି ପତାକା ବନ୍ଧା",
          "ନ ଯିବି ସଜନୀ ତୁ ଯାଆ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ଗୋପପୁରେ ଯେତେ ମୋ ପରି ଛନ୍ତି କେତେ",
          "ମହୀପଲଙ୍କ ପରେ ଶୁଆ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମୋତେ କଟୁ ତୋ କଥା ତୋତେ କହୁଛି ନ ଥା",
          "ନ ଥାନ୍ତୁ ଆଉ ଶାରୀ ଶୁଆ ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କହେ ମାନ ରାଧିକା କାହ୍ନୁ ହୋଇଛି ଏକା",
          "କୁଞ୍ଜଭୁବନକୁ ତୁ ଯାଆ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
