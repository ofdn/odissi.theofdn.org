{
  "id": "oa-gita-001313",
  "name": {
    "en": "Daya kara dinabandhu",
    "or": "ଦୟା କର ଦୀନବନ୍ଧୁ"
  },
  "composer": "oa-person-000037",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/daya-kara-dinabandhu-subhe-jaau-ramakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦୟା କର ଦୀନବନ୍ଧୁ ଶୁଭେ ଯାଉ ଆଜ ଦିନ",
          "କର ଯୋଡ଼ି ତୁମ୍ଭ ପଦେ କରୁଅଛି ନିବେଦନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅନାଦି ଅନନ୍ତ ହରି କ୍ଷୀରସାଗର ବିହାରୀ",
          "ଲକ୍ଷ୍ମୀ ଦେବୀ ମନୋହାରୀ ପ୍ରଭୁ ପତିତପାବନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜଗଜ୍ଜନ ହିତକାରୀ ଦଶ ଅବତାର ଧାରୀ",
          "ମଧୁସୂଦନ ମୁରାରି କାଳୀୟ ଦର୍ପ ଗଞ୍ଜନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁମ୍ଭେ ଧ୍ୟାନ ତୁମ୍ଭେ ଜ୍ଞାନ ଅନ୍ତର୍ଯ୍ୟାମୀ ଭଗବାନ",
          "ତୁମ୍ଭ ବିନୁ ନାହିଁ ଆନ କଳି କଳୁଷ ନାଶନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୁମ୍ଭେ ଏ ସଂସାର ସାର ଆଉ ସବୁ ମାୟା ଘୋର",
          "କୃତାନ୍ତ ଭୟୁଁ ଉଦ୍ଧର କହେ ରାମକୃଷ୍ଣ ଦୀନ"
        ]
      }
    ]
  },
  "sources": [
