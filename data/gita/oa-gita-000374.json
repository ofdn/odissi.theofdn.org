  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-keli-kautuki-sri-chhamure/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ କେଳିକଉତୁକୀ ଶ୍ରୀଛାମୁରେ",
          "ମୋର ମାଗୁଣି ଏତିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହାତୀଗମନାରେ ଛାତି ପରେ ମଣ୍ଡି",
          "ଧାତିକାରେ ରତି ଉତ୍ସବରେ ମାତି ।",
          "(ପଡ଼ି)",
          "ନିତମ୍ବ ଧୀରେ ଧୀରେ ଚଳା ଅତି ମଞ୍ଜୁଳେ",
          "ବାଜୁ ରତ୍ନ ନିର୍ମିତ କିଙ୍କିଣୀ ତ୍ରିପଟାରେ",
          "ନାଚିବ ତିଳପୁଷ୍ପଜିତ ନାସାପୁଟରେ",
          "ସୁରସ ନୀଳମଣି ନଥ ପଲ୍ଲବ ପରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚନ୍ଦ୍ରମୁଖ ଜିତ ଇନ୍ଦ୍ରଭୂତିଦାୟୀ",
          "ଆରେ ଅତୁଳବରନା ।",
          "ଡରୁ ଯେବେ ସରୁକଟି ଭାଜିବାରୁ",
          "ସମର୍ପ ମୋ କରେ କୁଚପଦ୍ମ ଦୁଇ ।",
          "(ପଡ଼ି)",
          "ନିତମ୍ବ ଧୀରେ ଧୀରେ ଚଳା ଅତି ମଞ୍ଜୁଳେ",
          "ବାଜୁ ରତ୍ନ ନିର୍ମିତ କିଙ୍କିଣୀ ତ୍ରିପଟାରେ",
          "ନାଚିବ ତିଳପୁଷ୍ପଜିତ ନାସାପୁଟରେ",
          "ସୁରସ ନୀଳମଣି ନଥ ପଲ୍ଲବ ପରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାର ପାମରକୁ ତାପ ବିନାଶକୁ",
          "ନବସପତ ବୟସୀ ।",
          "ମନ୍ଦହାସ ଘନସାର ସ୍ୱେଦ ବାରି",
          "ପନୀର ନୀରକୁ ଫିଙ୍ଗି ଇଷିତେ ।",
          "(ପଡ଼ି)",
          "ନିତମ୍ବ ଧୀରେ ଧୀରେ ଚଳା ଅତି ମଞ୍ଜୁଳେ",
          "ବାଜୁ ରତ୍ନ ନିର୍ମିତ କିଙ୍କିଣୀ ତ୍ରିପଟାରେ",
          "ନାଚିବ ତିଳପୁଷ୍ପଜିତ ନାସାପୁଟରେ",
          "ସୁରସ ନୀଳମଣି ନଥ ପଲ୍ଲବ ପରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଇସି ଇସି ଭାଷି କାମୋଦୀ ରାଗରେ",
          "ଗାଇବୁ ପିକବଚନା ।",
          "ଭାଷେ ବୀରବର କୃପାମୟ ଦେବ",
          "ପୁରସ୍କାର ଦେବି ମନ ରତନକୁ ।",
          "(ପଡ଼ି)",
          "ନିତମ୍ବ ଧୀରେ ଧୀରେ ଚଳା ଅତି ମଞ୍ଜୁଳେ",
          "ବାଜୁ ରତ୍ନ ନିର୍ମିତ କିଙ୍କିଣୀ ତ୍ରିପଟାରେ",
          "ନାଚିବ ତିଳପୁଷ୍ପଜିତ ନାସାପୁଟରେ",
          "ସୁରସ ନୀଳମଣି ନଥ ପଲ୍ଲବ ପରେ"
        ]
      }
    ]
  },
