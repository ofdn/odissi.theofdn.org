{
  "id": "oa-gita-000374",
  "name": {
    "en": "Aja keli kautuki sri chhamure",
    "or": "ଆଜ କେଳିକଉତୁକୀ ଶ୍ରୀଛାମୁରେ",
    "alternates": [
      "Aja Keli Koutuki"
    ]
  },
  "composer": "oa-person-000039",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
