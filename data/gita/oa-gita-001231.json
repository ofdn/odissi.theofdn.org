{
  "id": "oa-gita-001231",
  "name": {
    "en": "Bhismaka kumariki nela syama",
    "or": "ଭୀଷ୍ମକ କୁମାରୀକି ନେଲ ଶ୍ୟାମ"
  },
  "composer": "oa-person-000149",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhismaka-kumariki-nela-syama-rukmini-bibha-bibaha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରୁକ୍ମିଣୀବିଭା ଗୀତ",
          "ଭୀଷ୍ମକ କୁମାରୀକି",
          "ନେଲ ଶ୍ୟାମ କି ଛଟକେ ହରିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିଶୁପାଳ ହୋଇଥିଲା ବର ବେଶ",
          "ସ୍ୱୟମ୍ବରେ ଥିଲେ ଯେତେକ ନରେଶ",
          "ମେରୁ ଉହାଡ଼ରେ ରଖି ନନ୍ଦିଘୋଷ",
          "ହୋଇଥିଲ ମଧୁହାରୀ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଭା ଅଧିବାସ ମଙ୍ଗଳ ସମୟେ",
          "ଭବାନୀ ପୂଜାକୁ ରୁକ୍ମିଣୀ ବିଜୟେ",
          "ଆକର୍ଷି ମୋହନ ନେଲ କି ଉପାୟେ",
          "ବିକ୍ରମି କେଶରୀ ପରିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନେଲା ନେଲା ବୋଲି ଶୁଭିଲା କି ଗୋଳ",
          "ଆଗେ ରହି ରଣ କରେ ଶିଶୁପାଳ",
          "ବିକ୍ରମି ରଥରେ ବାନ୍ଧିଲେ ଗୋପାଳ",
          "ଫେଡ଼ିଦେଲେ ହଳଧାରୀ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବାଜେ ବାଦ୍ୟ ଘୋଷ ଟମକ ନିଶାଣ",
          "ପ୍ରଚଣ୍ଡେ ଶୁଭିଲା ବେଦ ଉଚ୍ଚାରଣ",
          "କୁସୁମ ବୃଷ୍ଟି ଯେ କଲେ ଦେବଗଣ",
          "ସର୍ବେ ଜୟ ଜୟ କରିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତକ୍ଷଣେ ବିଜୟେ ଦ୍ୱାରକା ନଗରେ",
          "ବିଜେ କଲେ ପ୍ରଭୁ ରତ୍ନବେଦୀ ପରେ",
          "ଶୁକ ସନକାଦି ହରଷ ମନରେ",
          "ବିଭା ବିଧାନକୁ ସାରିକି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବନ୍ଦାପନା ମଧୁଶଯ୍ୟାରେ ଶୟନ",
          "ବଢ଼ାଇ ସପତ ଦିନର ବିଧାନ",
          "ଭଣଇ ଗଣେଶ ଦୋଷ ମୋ ନ ଘେନ",
          "ସୁଜନ ଜନ ବିଚାରିକି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
