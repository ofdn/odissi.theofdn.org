{
  "id": "oa-gita-000657",
  "name": {
    "en": "Jana mo parana sangi",
    "or": "ଜାଣ ମୋ ପରାଣ ସଙ୍ଗୀନାହିଁ ନାହିଁ କାହିଁ ମନ ମୋହନ ଭଙ୍ଗୀ । ଘୋଷା । ସେ ଦିନ ତୁ ଥିଲୁ ସଙ୍ଗେହାସ୍ୟ ପରିହାସ ରଙ୍ଗେଚାହିଁଦେଲେ ଯା ନେତ୍ର କଟାରୀ ଫିଙ୍ଗି । ୧ । ଆଉ ଦିନେ ବିଶାଖିକାତୁଲେ ଆସିଥିଲି ଏକାଯା କଲେ ଖେଳାଇ ଡୋଳା ଭୂରୁ ଭୁଜଙ୍ଗ । ୨ । ଦିନକୁ ଦିନ ତ ନୂଆହୁନ୍ଦରିଆ ସେ କାହ୍ନୁଆପତିବ୍ରତ ମେରୁ ଗର୍ବ ଦେଲାଣି ଭାଙ୍ଗି । ୩ । ବେଣୁଧର ବୋଲେ ସତକୋଟି […]"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000056"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jana-mo-parana-sangi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜାଣ ମୋ ପରାଣ ସଙ୍ଗୀ",
          "ନାହିଁ ନାହିଁ କାହିଁ ମନ ମୋହନ ଭଙ୍ଗୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ଦିନ ତୁ ଥିଲୁ ସଙ୍ଗେ",
          "ହାସ୍ୟ ପରିହାସ ରଙ୍ଗେ",
          "ଚାହିଁଦେଲେ ଯା ନେତ୍ର କଟାରୀ ଫିଙ୍ଗି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆଉ ଦିନେ ବିଶାଖିକା",
          "ତୁଲେ ଆସିଥିଲି ଏକା",
          "ଯା କଲେ ଖେଳାଇ ଡୋଳା ଭୂରୁ ଭୁଜଙ୍ଗ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦିନକୁ ଦିନ ତ ନୂଆ",
          "ହୁନ୍ଦରିଆ ସେ କାହ୍ନୁଆ",
          "ପତିବ୍ରତ ମେରୁ ଗର୍ବ ଦେଲାଣି ଭାଙ୍ଗି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବେଣୁଧର ବୋଲେ ସତ",
          "କୋଟି ମନ୍ମଥ ସାମନ୍ତ",
          "ନିକୁଞ୍ଜ ମତ୍ତକେଶରୀ ତୁମ୍ଭେ କୁରଙ୍ଗ"
        ]
      }
    ]
  },
