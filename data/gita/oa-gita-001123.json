{
  "id": "oa-gita-001123",
  "name": {
    "en": "Kunja banare kalia debata buluchi",
    "or": "କୁଞ୍ଜ ବନରେ କାଳିଆ ଦେବତା ବୁଲୁଛି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunja-banare-kalia-debata-buluchi-sankarabharana-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁଞ୍ଜ ବନରେ କାଳିଆ ଦେବତା ବୁଲୁଛି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁସୁମ ତୋଳିଲା ପରି ନୁହଇଟି ଶ୍ରୀ କିଶୋରୀ",
          "ଦେଖିଦେଲେ ତୋ ମାଧୁରୀ ଘେନିଯିବ କୋଳ କରି",
          "ମୋତେ ଜଳଜଳ ଦିଶୁଛି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେ କହେ ଦଳିତାଞ୍ଜନ କେ ବୋଲୁଛି ନବଘନ",
          "କାନ୍ତି ପୁଣି ସାବଧାନ ହୋଇଥା ସେ ଗୋବର୍ଦ୍ଧନ",
          "ମଲ୍ଲ ଗୃହିଣୀକି ଲାଗିଛି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଙ୍ଗେ ସବୁ ଅଳଙ୍କାର ସଦା ଲାଗିରେ ଥିବାର",
          "ଶିରେ ଚୂଳ ଶିଖଣ୍ଡର କୋଟିଏ ସ୍ମର ସୁନ୍ଦର",
          "ରୂପ ବୋଲି ଶୁଣାଯାଉଛି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଥାଉ ସ୍ୱଚ୍ଛେ ଦେଖିବାର ପ୍ରସଙ୍ଗ ଶୁଣିଲେ ଯାର",
          "ନୟନୁ ବହୁଛି ନୀର ଅଥିର ହୋଇ ଶରୀର",
          "ପୁଲକରେ ପୂରିଯାଉଛି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଲତା ଗୃହକୁ ଯାଅନା କଞ୍ଜ କସ୍ତୁରୀ ବାସନା",
          "ଚହଟୁଛିଟି ସୁମନା ଶୁଭାଇ କଥା କହନା",
          "ହେଟି ଭୂଷା ସ୍ୱନ ଶୁଭୁଛି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କାନ୍ତିକୁଳ ଅଧୀଶ୍ୱରୀ ଭାରିଯିବେ ସହଚରୀ",
          "ତୋଳିବୁ ଗୁଞ୍ଜ ଆଉରି ଜାଲରେ କୁରଙ୍ଗୀ ପରି",
          "ପଡ଼ିଯିବୁ ପରା ଦିଶୁଛି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ରାଧା ବୋଲନ୍ତି ଆଳୀଙ୍କି ଆଗେ ହେଲେ କହିଲୁ କି",
          "କେ ସେ ପୁଣି ତ ଏଣିକି ଆସୁଛି ମୋ ସରଣୀକି",
          "ଗୋପାଳକୃଷ୍ଣ ତ କହୁଛି"
        ]
      }
    ]
  },
