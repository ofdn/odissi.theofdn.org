    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଧ ସୁର ସାଧରେ ଝିଞ୍ଜୋଟି ରାଗରେ",
          "ଅଙ୍ଗ ଉଭୟରେ",
          "ରସ ଶୃଙ୍ଗାର ରଙ୍ଗରେ ଶୁଦ୍ଧ ସକଳ ସୁରରେ",
          "କୋମଳ ନିଷାଦରେ ଜାତି ଔଡ଼ବ ସମ୍ପୂର୍ଣ୍ଣ",
          "ମେଳ ଘେନ ଶ୍ରୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାଦୀ କର ଗାନ୍ଧାର ସଂବାଦୀ ଧା ସ୍ୱର",
          "ସମୟ ଦ୍ୱିତୀୟ ପ୍ରହର ମଧୁର ଯାମିନୀରେ"
        ]
      }
    ]
  },
