{
  "id": "oa-gita-001052",
  "name": {
    "en": "Karaka radana pari kara",
    "or": "କରକ ରଦନା ପାରି କର"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/karaka-radana-pari-kara-todi-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କରକ ରଦନା ପାରି କର ସାର ନ ସାର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିନା ଦୋଷରେ ନବୀନା ମନା ନ କର କାମନା",
          "ଅନା ବିରସ ହୁଅନା ଜନାପବାଦେ ମଜ୍ଜନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରସବତୀ ଭାବେ ରସ ଭାଷ ସୁମଧୁର ଭାଷ",
          "ଦାସରେ ନୁହ ଉଦାସ ଆସ ନ ନାଶ ମୋ ଆଶ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରସାରେ ତୁ ମୋ ଭରସା ଭୁଷାନା କାମେ ସୁଭୂଷା",
          "ନିଶା ପୂରାଅ ମନୀଷା ରସା ସ୍ନେହରେ ସୁରସା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦରହାସୀ ମୋ ହୃଦର ତରଳ ତୁହି ମାତର",
          "ଧର ଉରଜା ଉଦ୍ଧର ହର ଏ ଦୁଃଖ ମୋହର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏ ବେଦନା ଦେଖି ଏବେ ଲବେ ଚିତ୍ତ ନ ପଲ୍ଲବେ",
          "ଭବେ ଏହା ନ ସମ୍ଭବେ ଭାବେ ରଘୁନାଥ ଭାବେ"
        ]
      }
    ]
  },
