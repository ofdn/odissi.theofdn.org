{
  "id": "oa-gita-000481",
  "name": {
    "en": "Ki rasika se birasa",
    "or": "କି ରସିକ ସେ ବିରସ"
  },
  "composer": "oa-person-000101",
  "mula_raga": [
    "oa-raga-000129"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-rasika-se-birasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ରସିକ ସେ",
          "ବିରସ ଯାହାର ମୁଖୁଁ ନିକସେ",
          "ପୁରୁଷ ହୋଇ ଯେ ନାରୀ ମନ ସୁନା",
          "ପ୍ରୀତି କଷଟୀରେ ଯେବେ ନ କଷେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳନା ନ ଯାଏ ଲଳନାର ମୁଖ",
          "କମଳ ପରାୟେ ସଦା ବିକଶେ",
          "ଅଳି ହୋଇ ଯେବେ ଚୁମ୍ବି ନ ପାରଇ",
          "ଅଳି କରିବାର ତାର ଧିକ ସେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚତୁରୀ ଚାତୁରୀ ବଚନ ଉଚ୍ଚାରି",
          "ମରମେ ନୟନ ଶରକୁ ପେଷେ",
          "ତହିଁକି ଯେ ପ୍ରତିଉତ୍ତର ନ ଦେଲା",
          "ଯୁବାବୃନ୍ଦ ମଧ୍ୟେ ଅବିବେକ ସେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭିତରେ ସଦୟ ବାହାରେ ସଭୟ",
          "ଦେଖାଇ କହନ୍ତି ମାତରକ ସେ",
          "ଖେଳାଇ କରି ଯେ ଛଳାଇ ନ ନେଲା",
          "ନ ଜାଣଇ କିଛି ବିତରକ ସେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଙ୍କଜାକ୍ଷୀ ବାଳା ଯା ଅଙ୍କେ ନ ବସେ",
          "କେଉଁ ଭାଗ୍ୟବନ୍ତ କି ଅଧିକ ସେ",
          "କହଇ ଶେଖର ମୋହିନୀ ଉତ୍ତର",
          "ଜାଣିମୁଁ ତାହାର ନିକରକ ସେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-rasika-se-birasa/"
    }
  ],
