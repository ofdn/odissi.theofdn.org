{
  "id": "oa-gita-000113",
  "name": {
    "en": "Chahinde kede manjula",
    "or": "ଚାହିଁଦେ କେଡ଼େ ମଞ୍ଜୁଳ"
  },
  "composer": "oa-person-000035",
  "mula_raga": [
    "oa-raga-000050"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahinde-kede-manjula-chahin-de-kede-manjula/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହିଁଦେ କେଡ଼େ ମଞ୍ଜୁଳ ସଖୀରେ",
          "ଦେଖ ଏ ବସନ୍ତ କାଳ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଋତୁରାଜ ବିଜୟ କେତୁ ସରି ଉଦୟ",
          "ଲଭିଛି କିଶଳୟ ଧରି ଶିରୀ ନିଚୟ",
          "(ପଡ଼ି)",
          "ମନ୍ଦେ ମନ୍ଦେ ବହି ମୃଦୁମଳୟ ଶୋହି",
          "ମଣ୍ଡେ ଆଦରେ ମହୀ ଚାଣ୍ଡେ ପରାଣ ମୋହି",
          "ଭାଷେ ତୋଷେ ମଞ୍ଜୁ ରସେ ପିକ ସୁକଳ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଫୁଟି ନାନା ପ୍ରସୂନ ଲୋଟି ଦିଶେ ପ୍ରସନ୍ନ",
          "ଉପବନ ବଦନ ହେଲା ଶୋଭା ସଦନ",
          "(ପଡ଼ି)",
          "ମଞ୍ଜୁ କୁଞ୍ଜବନ ଭୃଙ୍ଗ ମଧୁର ସ୍ୱନ",
          "ଗୁଞ୍ଜନ ବିମୋହନ ରଞ୍ଜନ କରେ ମନ",
          "ନାନା ରଙ୍ଗେ ନାଚେ ଢଙ୍ଗେ ଫୁଲ ଛବିଳ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନବ ଚୂତ ମୁକୁଳ ମଳୟ ବନ୍ଧୁ ମେଳ",
          "ଲଭି ଶୋଭି ଚଞ୍ଚଳ ଦୋଳେ ବଳେ ବିମଳ",
          "(ପଡ଼ି)",
          "କମ୍ପି କମ୍ପି ଧୀରେ ଧାରା ସୁରଭି ଝରେ",
          "ବାସ କାନନ ଭରେ ତୋଷ ମାନସ ଧରେ",
          "ଭାସି ଆସି ପ୍ରାଣ ତୋଷି କରେ ଶୀତଳ ରେ"
        ]
      }
    ]
  },
  "sources": [
