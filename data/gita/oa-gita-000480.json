    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିନାୟକ ବିଘ୍ନ ବିନାଶନକାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପାର୍ବତୀ ନନ୍ଦନ ପାପ ବିମୋଚନ",
          "ଏ ଭବସିନ୍ଧୁ ତରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୂଷିକ ବାହନ ଭୂଷିତ ଭୂଷଣ",
          "ପାଳିତ ଶିବ ଗୌରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଶ୍ରିତ ଯେ ଲୋକ ଶିବ ସୁଖ ଦାୟକ",
          "ବନ୍ଦିତ ସୁର ଶୌରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗଣପତି ଦେବ ଗଜପତି ଦେବ",
          "ମାନସକଞ୍ଜ ହାରୀ"
        ]
      }
    ]
  },
