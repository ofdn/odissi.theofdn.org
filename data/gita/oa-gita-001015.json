  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahare-nabina-nabina-ahari-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହାରେ ନବୀନା ନବୀନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁନ୍ଦନ ହେମଗୋରୀ କମନୀୟ କିଶୋରୀ",
          "କୁନ୍ଦଦଶନୀ ଅରବିନ୍ଦ ଚାରୁ ବଦନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସାହା ନୋହିଲେ ମୋତେ ସୁରସିକା ଜଗତେ",
          "ଆହା ବୋଲିବ କେହି ଆରତ ଦେଖି ସତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେଡ଼େ କରମ କଲି କିମ୍ପା ବୁଦ୍ଧି ହୁଡ଼ିଲି",
          "ଏଡ଼େ ଦୟାଳୁ ଲଭି ଇଚ୍ଛା ପୂର୍ଣ୍ଣ ନ ହେଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହଇ ରଘୁନାଥ କବି ରଜନୀନାଥ",
          "ରହରେ ରହି ଏହା କହିଲେ ନନ୍ଦସୁତ"
        ]
      }
    ]
  },
  "sources": [
    {
