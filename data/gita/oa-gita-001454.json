{
  "id": "oa-gita-001454",
  "name": {
    "en": "Kuru jadunandana",
    "or": "କୁରୁ ଯଦୁନନ୍ଦନ"
  },
  "composer": "oa-person-000161",
  "mula_raga": [
    "oa-raga-000040"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000010"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kuru-jadunandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁରୁ ଯଦୁନନ୍ଦନ ଚନ୍ଦନ-ଶିଶିରତରେଣ କରେଣ ପୟୋଧରେ",
          "ମୃଦମଗପତ୍ରକମ୍ ଅତ୍ର ମନୋଭବ ମଙ୍ଗଳ-କଳଶ-ସହୋଦରେ ।",
          "ନିଜଗାଦ ସା ଯଦୁନନ୍ଦନେ",
          "କ୍ରୀଡ଼ତି ହୃଦୟାନନ୍ଦନେ ।୧"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଳିକୁଳ-ଗଞ୍ଜନ-ସଞ୍ଜନକଂ ରତିନାୟକ-ସାୟକ-ମୋଚନେ",
          "ତ୍ୱଦଧର-ଚୁମ୍ବନ-ଲମ୍ବିତ-କଜ୍ଜ୍ୱଳମ୍ ଉଜ୍ଜ୍ୱଳୟ ପ୍ରିୟ-ଲୋଚନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନୟନ-କୁରଙ୍ଗ-ତରଙ୍ଗ-ବିକାଶ-ନିରାସକୃତି-ଶ୍ରୁତି-ମଣ୍ଡଳେ",
          "ମନସିଜ-ପାଶ-ବିଳାସଧରେ ଶୁଭ-ବେଶ ନିବେଶୟ କୁଣ୍ଡଳେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭ୍ରମର-ଚୟଂ ରଚୟନ୍ତମ୍ ଉପରି ରୁଚିରଂ ସୁଚିରଂ ମମ ସମ୍ମୁଖେ",
          "ଜିତ-କମଳେ ବିମଳେ ପରିକର୍ମୟ ନର୍ମଜନ-କମଳକଂ ମୁଖେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମୃଗମଦ-ରସ-ବଳିତଂ ଲଳିତଂ କୁରୁ ତିଳକମ୍ ଅଳିକ-ରଜନୀ-କରେ",
          "ବିଜିତ-କଳଙ୍କ-କଳଂ କମଳାନନ ବିଶ୍ରମିତ-ଶ୍ରମ-ଶୀକରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ମମ ରୁଚିରେ ଚିକୁରେ କୁରୁ ମାନଦ ମାନସଜ-ଧ୍ୱଜ-ଚାମରେ",
          "ରତିଗଳିତେ ମିଳିତେ କୁସୁମାନେ ଶିଖଣ୍ଡ-ବିଖଣ୍ଡକ-ଡାମରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ସରସ-ଘନେ ଜଘନେ ମମ ଶମ୍ବର-ଦାରଣ-ବାରଣ-କନ୍ଦରେ",
          "ମଣିରସନାବସନାଭରଣାନି ଶୁଭାଶୟ ବାସୟ ସୁନ୍ଦରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଶ୍ରୀ-ଜୟଦେବ-ବଚସି ଜୟଦେ ସଦୟଂ ହୃଦୟଂ କୁରୁ ମଣ୍ଡନେ",
          "ହରି-ଚରଣ-ସ୍ମରଣାଽମୃତ-କୃତ-କଳୁଷ-ଜ୍ୱର-ଖଣ୍ଡନେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ରଚୟ କୁଚୟୋଃ ପତ୍ରଂ ଚିତ୍ରଂ କୁରୁଷ୍ୱ କପୋଳୟୋର୍",
          "ଘଟୟ ଜଘନେ କାଞ୍ଚୀମଞ୍ଚ ସ୍ରଜା କବରୀଭରମ୍ ।",
          "କଳୟ ବଳୟଶ୍ରେଣୀଂ ପାଣୌ ପଦେ କୁରୁ ନୂପୁରା-",
          "ବିତି ନିଗଦିତଃ ପ୍ରୀତଃ ପୀତାମ୍ବରୋଽପି ତଥାକରୋତ୍ ।"
        ]
      }
    ]
  },
