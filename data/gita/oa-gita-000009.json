{
  "id": "oa-gita-000009",
  "name": {
    "en": "Chahanre rasarangini",
    "or": "ଚାହାଁରେ ରାସରଙ୍ଗିନୀ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000111"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahanre-rasarangini/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହାଁରେ ରାସରଙ୍ଗିନୀ ସଙ୍ଗିନୀ",
          "ଚାହିଁଥିବେ ନିକୁଞ୍ଜେ ତୋ ଯିବାର ସରଣୀ",
          "ଯିବା ପରା ନିକୁଞ୍ଜେ ହୁଅ ଗୋ ସଜ ଏକ୍ଷଣି ।",
          "ବୃଷଭାନୁ ନନ୍ଦିନୀ ମୋହନ ମନମାନୀ",
          "ବୋଲି କେବା ନ ଜାଣେ ଲାଜ ତେଜ ସଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "(ପଡ଼ି)",
          "ଚନ୍ଦ୍ରକ ଚୂଳ ସୁଚେଳ ନୀଳଘନ",
          "ଶ୍ୟାମଳ ସୁନ୍ଦର ମାର ବିମୋହନ",
          "ଗୋକୁଳ ପାଳକ ମଙ୍ଗଳ କାରକ",
          "ଗୋବର୍ଦ୍ଧନ ଗିରିଧାରୀ ମନମୋହିନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବୃନ୍ଦାବନ ବିହାରୀ କୁଞ୍ଜକାନନଚାରୀ",
          "ରାଧେ ବୋଲି ମୁରଲୀ ଡାକେ ଦିବା ରଜନୀ",
          "ଶ୍ରୀ ରାଧାକୃଷ୍ଣ ଦୁଇ ରୂପଟି ଏକ ଦେହୀ",
          "ଜଣା ସଂସାର ସାରା ଆଉ ଲାଜ କି ଘେନି",
          "(ପଡ଼ି)",
          "ବ୍ରଜରମଣୀ ମନ ଚାତକ ନବଘନ",
          "ସଜ ଜଳଜାନନ ନିଧୂବନ ରଞ୍ଜନ",
          "ଯମୁନା ତଟ ନୀପତରୁ ମୂଳ ଶୋଭନ",
          "ସେ ତୋ ଅଧୀନ ଆଜି ଭଜେ ତାରିଣୀ"
        ]
      }
    ]
  },
  "sources": [
    {
