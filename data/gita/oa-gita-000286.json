{
  "id": "oa-gita-000286",
  "name": {
    "en": "To lagi gopadanda mana re kalia suna",
    "or": "ତୋ ଲାଗି ଗୋପଦାଣ୍ଡ ମନା ରେ କାଳିଆ ସୁନା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000089"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/to-lagi-gopadanda-mana-re-kalia-suna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତୋ ଲାଗି ଗୋପଦାଣ୍ଡ ମନା ରେ କାଳିଆ ସୁନା",
          "ତୋ ଲାଗି ନ ଯିବି ଯମୁନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିତି ଏହି ବାଟେ ଯାଉ ରେ କାଳିଆ",
          "ନିତି ଏହି ବାଟେ ଯାଉ",
          "ଘାଟର କଉଡ଼ି ମାଗିଲେ କାଳିଆ",
          "ମୁରଲୀ ବଜାଉ ଥାଉ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୁହି ଗୋପପୁରେ ରଜା ରେ କାଳିଆ",
          "ତୁହି ଗୋପପୁରେ ରଜା",
          "କେମନ୍ତ ସଜରେ ମୁରଲୀ ବଜାଉ",
          "ଆଉରି ଟିକିଏ ବଜା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁହି ବଡ଼ଘର ପୁଅରେ କାଳିଆ",
          "ମୁହିଁ ବଡ଼ଘର ବୋହୂ",
          "ଶରମ ତୋ ମୁଖେ ନାହିଁ ରେ କାଳିଆ",
          "ମରମ କଥା ତୁ କହୁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୁହି ଅଟୁ ନନ୍ଦଚାଟ ରେ କାଳିଆ",
          "ତୁହି ଅଟୁ ନନ୍ଦଚାଟ",
          "ମଥୁରା ହାଟକୁ ଦଧି ବିକି ଗଲେ",
          "ନିତି ମାଗୁଥାଉ ଘାଟ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହଇ ବଲ୍ଲଭାନନ୍ଦ ଏ ରସରେ",
          "ଶୁଣ ଆଗୋ ସଖୀବୃନ୍ଦ",
          "ଯମୁନା କୂଳରେ ମୁରଲୀ ବଜାଏ",
          "ତୁମ୍ଭ ଘେନି କୃଷ୍ଣଚନ୍ଦ୍ର ରେ"
        ]
      }
    ]
  },
