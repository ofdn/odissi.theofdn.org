{
  "id": "oa-gita-000712",
  "name": {
    "en": "Sambhali na pare aau",
    "or": "ସମ୍ଭାଳି ନ ପାରେ ଆଉ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000024"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sambhali-na-pare-aau-rasa-kamodi-adatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରେ ସଙ୍ଗାତ ସମ୍ଭାଳି ନ ପାରେ ଆଉ",
          "ଅମ୍ଭୋରୁହାକ୍ଷର ଖେଳା କଟାକ୍ଷର",
          "ଦମ୍ଭୋଳିରୁ ବଳି ଦାଉ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୂରରୁ ପଡ଼ି ବୁଡ଼ିଯାଏ ହୃଦରେ",
          "ଲୋଡ଼ିଲେ ନ ଦିଶେ ଆଉ",
          "ମରମରେ ପଶି ଦରମରା କରେ",
          "ସରସ ସ୍ପରଶ ନୋହୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶବଦ ନ ଥାଇ ସ୍ତବଧ କରାଏ",
          "ସେ କି ରତି ଋଣ ସାହୁ",
          "ମିଆଦ ଟାଳିଲା ପିଆଦା ପରାଏ",
          "ମାର ଝିଙ୍କେ ଆସୁଯାଉ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନବଘନ ଅଙ୍ଗ ବିଶେଷ ତରଙ୍ଗ",
          "ରଙ୍ଗ ଦିଶେ ଦାଉ ଦାଉ",
          "ସୁଦିନ କୁଦିନ କରାଏ ଦୁର୍ଦ୍ଦିନ",
          "ଥରେ ଅନାଉଁ ଅନାଉଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗଲେ ହେଲେ ଜାତି ମହତ୍ତ୍ୱ ସମ୍ପତ୍ତି",
          "ଫିଟି ତୁଟି ଲୁଟିଯାଉ",
          "ଗଜପତି ଭାଷି ହୁଅ ତାଙ୍କ ଦାସୀ",
          "ପିଣ୍ଡେ ପ୍ରାଣ ଥାଉଁ ଥାଉଁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
