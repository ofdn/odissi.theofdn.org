{
  "id": "oa-gita-000901",
  "name": {
    "en": "Kisori manithili para",
    "or": "କିଶୋରୀ ମଣିଥିଲି ପରା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kisori-manithili-para-paraja-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କିଶୋରୀ ମଣିଥିଲି ପରା",
          "ପରଖ ସୁନା ତୁ ସତେ",
          "ବାରିଲି ଏଥର ହେବ କି ପିତଳ",
          "ସୁନା ପୁଟ ଦେଲେ ଯେତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଇ ଜଳାଞ୍ଜଳି କୁଳ ମାନ",
          "ହରି ତୁଲେ ହରି ନେଲୁ ଦିନ",
          "ବାଜଇ ବଜାରେ ଟମକ ହଜାରେ",
          "ମଥା କି ଟେକିବୁ ଗଲା ପଥେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କହିଲେ କେତେହେଁ ତୋତେ ଭଲ",
          "ରୁଷି ମନେ ସିନା ମଣୁ ଶଲ",
          "ଖସିଗଲା ପାଦ ତଳକୁ ତଳକୁ",
          "ବିଚାରିଲୁ ନାହିଁ ଯାହା ଏତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନା ନ ମାନି ତୁ ଦେଲୁ ତୋଳି",
          "ଜପୁ ଦିବା ନିଶି ଯାରେ ବାଳୀ",
          "କହେ କବିଚନ୍ଦ୍ର ଭାସି ସୁଅ ଜଳେ",
          "ଭଉଁରୀରେ ଭରମିବୁ କେତେ"
        ]
      }
    ]
  },
  "sources": [
