{
  "id": "oa-gita-001369",
  "name": {
    "en": "Kahin pain sahi go",
    "or": "କାହିଁ ପାଇଁ ସହି ଗୋ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000088"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahin-pain-sahi-go-chakrakeli/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁ ପାଇଁ ସହି ଗୋ",
          "ମୋହନ ଆସିଲେ ନାହିଁ",
          "କି ଦୋଷ ମୋହର ଦେଖି ବଂଶୀଧର",
          "ଏ ନିଶି ରହିଲେ କାହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବଡ଼ ଅଭାଗିନୀ ସଖୀ ଗୋ ମୁହିଁ",
          "ତାଙ୍କ ସେବା ଯୋଗ୍ୟ ମୋ ଭାଲେ ନାହିଁ",
          "ସେ ବାଙ୍କଚୂଳିଆ ବନ୍ଦୀ ହେଲେ କା ପ୍ରେମେ",
          "ଧନ୍ୟ ସେହି ଯୋଷା ମୋହନସ୍ନେହୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରସିକ ରତନ ବଦନ ଶଶୀ",
          "ଅଦର୍ଶନେ କେହ୍ନେ ବଞ୍ଚିବି ନିଶି",
          "ଆଗୋ ପ୍ରିୟସଖୀ ମୁଁ ଯେ ନିରିମାଖି",
          "ହୃଦୟ ମୋହର ହେଉଛି ଦହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବୃଥା ହେଲା ସବୁ ଚୂଆ ଚନ୍ଦନ",
          "ବାସ ଫୁଲହାର ବିଡ଼ିଆ ପାନ",
          "ନୟନ ସଙ୍ଖାଳି ମୋର ବନମାଳୀ",
          "କଣ୍ଟ ଦେଇଥିଲେ ମୁରଲୀ ଛୁଇଁ"
        ]
      }
    ]
  },
  "sources": [
