  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kare-dekhau-teja-re-khanjana-nayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାରେ ଦେଖାଉ ତେଜରେ ଖଞ୍ଜନ ନୟନା",
          "ବାରେ ମାନସେ ହେଜରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁନ୍ଦର ପୀତବାସ ଅଧରେ ମନ୍ଦହାସ",
          "କରି ସୁପରକାଶ କଲା ତୋ ଦମ୍ଭ ନାଶ ।",
          "(ପଡ଼ି)",
          "ବରଜ ଯୁବରାଜ କରଜରେ ଉରଜ",
          "ଚିରାଇ ଦ୍ୱିଜରାଜ ମୁଖୀ ହେଉଛି ସଜ",
          "ବାଜା ବଜାଇ ବ୍ରଜ ବଜାରେ ଯିବୁ ଆଜ",
          "ସଜ ସରୋଜ ନେତ୍ରୀ ମୁଖେ ନାହିଁକି ଲାଜ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତା ବିନା ନାରୀ ରାଣ ନାହିଁ ତୋ ପରିତ୍ରାଣ",
          "ବହି ମନରେ ମାନ ମିଛେ ଦେଖାଉ ଟାଣ ।",
          "(ପଡ଼ି)",
          "ବରଜ ଯୁବରାଜ କରଜରେ ଉରଜ",
          "ଚିରାଇ ଦ୍ୱିଜରାଜ ମୁଖୀ ହେଉଛି ସଜ",
          "ବାଜା ବଜାଇ ବ୍ରଜ ବଜାରେ ଯିବୁ ଆଜ",
          "ସଜ ସରୋଜ ନେତ୍ରୀ ମୁଖେ ନାହିଁକି ଲାଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚିତ୍ତରେ ବହି ତୋଷ ଭାଷ ମଧୁର ଭାଷ",
          "ଶ୍ୟାମରେ କଲେ ରୋଷ ଲଭିବୁ ଅପଯଶ ।",
          "(ପଡ଼ି)",
          "ବରଜ ଯୁବରାଜ କରଜରେ ଉରଜ",
          "ଚିରାଇ ଦ୍ୱିଜରାଜ ମୁଖୀ ହେଉଛି ସଜ",
          "ବାଜା ବଜାଇ ବ୍ରଜ ବଜାରେ ଯିବୁ ଆଜ",
          "ସଜ ସରୋଜ ନେତ୍ରୀ ମୁଖେ ନାହିଁକି ଲାଜ"
        ]
      }
    ]
  },
