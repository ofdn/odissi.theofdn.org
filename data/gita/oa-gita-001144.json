{
  "id": "oa-gita-001144",
  "name": {
    "en": "Pahi pahi mam",
    "or": "ପାହି ପାହି ମାଂ"
  },
  "composer": "oa-person-000136",
  "mula_raga": [
    "oa-raga-000047"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pahi-pahi-mam-tankadhara-malaba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପାହି ପାହି ମାଂ",
          "ତ୍ରାହି ଶ୍ରୀ ଜଗଦ୍‌ଗୁରୁ ପରଂବ୍ରହ୍ମ",
          "ରୋହିତ ସ୍ୱରୂପ ଧାରଣଂ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଉପଇନ୍ଦ୍ର ସପ୍ତ ଦ୍ୱୀପ ବ୍ୟାପକ",
          "ଦ୍ରୌପଦୀ ତ୍ରପା ନିସ୍ତାରଣ",
          "ପାପମାପଶାପ ଲୋପକ",
          "ତାପତ୍ରୟ ନିବାରଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚଣ୍ଡକର ମାରତଣ୍ଡ ବ୍ରହ୍ମାଣ୍ଡ",
          "ଭାଣ୍ଡ ଉଜ୍ଜ୍ୱଳ କାରଣ",
          "କୁଣ୍ଡଳାକୃତି ମଣ୍ଡଳଦୃତି",
          "ଦଣ୍ଡଧର ତମଖଣ୍ଡନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହୈମବତିଧବ ବ୍ୟୋମକୁନ୍ତଳ",
          "ଭୀମ ଭବ କାମ ଦହନ",
          "ହେ ମହେଶ୍ୱର ସୋମ ଶେଖର",
          "ବାମଦେବ ତ୍ରିଲୋଚନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପୁଷ୍ପଶର ବିରାଧୀଶ୍ୱର ମାର",
          "ବିଶ୍ୱଜୟ ଧନୁର୍ଧାରଣ",
          "ହେ ସ୍ମରପରମେଶ୍ୱରରାତ୍ମଜ",
          "ବିଶ୍ମକେତୁ ଝସକେତନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ୟେକଦନ୍ତ ଅନେକ ପାନନ",
          "ଶ୍ରୀକଣ୍ଠସୂନୁ ବିନାୟକ",
          "ଲୋକବନ୍ଦ୍ୟ ମୂଷିକ ବାହନ",
          "ସକଳ ବିଘ୍ନ ବିନାଶନ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶଙ୍କରାଦି ଦେବତାଙ୍କ ପ୍ରରପଦ",
          "ପଙ୍କଜକୁ ରଜନୀ ଦିନ",
          "ଟଙ୍କଧର ଭାବି ରଙ୍କ ପ୍ରାୟନୀ",
          "ଶଙ୍କରେ କରେ ବନ୍ଦନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
