{
  "id": "oa-gita-001385",
  "name": {
    "en": "Kene gheni jaucha jagannathanku",
    "or": "କେଣେ ଘେନି ଯାଉଛ ଜଗନ୍ନାଥଙ୍କୁ"
  },
  "composer": "oa-person-000025",
  "mula_raga": [
    "oa-raga-000083"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kene-gheni-jaucha-jagannathanku-salabega-mangala-gujjari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଣେ ଘେନି ଯାଉଛ ଜଗନ୍ନାଥଙ୍କୁ",
          "ଆମ୍ଭେ ଦ୍ରଶନ କରିବୁ କାହାକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖୁଣ୍ଟିଆ ଡାକ ଦେଲେ, ପହଣ୍ଡି ବିଜେ କଲେ",
          "ବିଜୟ କର ପ୍ରଭୁ ଚାପକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଳବଧୂଙ୍କ ରଡ଼ି, ପଣ୍ଡାଏ ଗଡ଼ାଗଡ଼ି",
          "ବିଧାତା ବାମ ହେଲା ଓଡ଼ିଶାକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବଡ଼ଦେଉଳୁଁ ବାହାରି, ଶଗଡ଼ିରେ ବିଜେ କରି",
          "ରେଣୁ ଯେ ପଡ଼ୁଥିବ ଶ୍ରୀମୁଖକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହଇ ସାଲବେଗ, ନିର୍ମାଲ୍ୟ କାହୁଁ ହେବ",
          "ଧିକ ଧକ ଆମ୍ଭ ଜୀବନକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
