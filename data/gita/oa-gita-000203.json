{
  "id": "oa-gita-000203",
  "name": {
    "en": "Kahinki sakhi balau mote go",
    "or": "କାହିଁକି ସଖୀ ବଳାଉ ମୋତେ ଗୋ"
  },
  "composer": "oa-person-000132",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinki-sakhi-balau-mote-go-sankarabharana-mohana-gosain/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ସଖୀ ବଳାଉ ମୋତେ ଗୋ ।",
          "ଜାଣିଛି ରେ ସଖୀ ସେ ଶଠ କାଳିଆ",
          "ଦଗାଦାର ହରି ନାହିଁ ତାଙ୍କୁ ପରତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହା କୁଞ୍ଜେ ବସି ପାହିଗଲା ନିଶି",
          "ମୋ ପୁରେ ନ ଆସି କାହା ସଙ୍ଗେ ରସି",
          "ବ୍ରଜପୁର ଶଶୀ ଅଟେ ଅବିଶ୍ୱାସୀ",
          "ପରନାରୀ ନାଶି ଦୟା ନୋହିଲା ଚିତ୍ତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସେ ମୁରଲୀଧର କଲେ ମୋତେ ପର",
          "ଜାଣିଲି ଏଥର ହୃଦୟ ତାଙ୍କର",
          "ସ୍ୱେଦ ଜରଜର ଅଙ୍ଗ ଥରଥର",
          "ନୟନରୁ ନୀର ବହିଲା ଅନୁବ୍ରତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପରାଣ ତେଜିବି ନିକୁଞ୍ଜେ ନ ଯିବି",
          "ତାଙ୍କ ପ୍ରୀତି ଭାବ ଆଉ ନ ଭାବିବି",
          "ବ୍ରଜପୁର ରବି ନନ୍ଦସୁତ ଛବି",
          "ମୁଖେ ନ ଆଣିବି ନ ଦେଖିବି ନେତ୍ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀମତୀଙ୍କ ପାଣି ଧରି କେ ସଙ୍ଗିନୀ",
          "ବୋଲେ ଗୋ ମିତଣୀ ନୁହଁ ଗୋ ମାନିନୀ",
          "ମୋହନ ଦୟିନୀ ଶୁଣ ଠାକୁରାଣୀ",
          "ତୁମ୍ଭ ଚିନ୍ତାମଣି ଚନ୍ଦ୍ରାବଳୀ ହସ୍ତେ"
        ]
      }
    ]
  },
  "sources": [
