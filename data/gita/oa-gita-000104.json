  "id": "oa-gita-000104",
  "name": {
    "en": "Jamunaku aau jaana",
    "or": "ଯମୁନାକୁ ଆଉ ଯାଆନା"
  },
  "composer": "oa-person-000014",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jamunaku-aau-jaana-jamuna-ku-au-jana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯମୁନାକୁ ଆଉ ଯାଆନା",
          "ବାଟ ଜଗି ବସିଥିବ ସେ ନନ୍ଦ କାହ୍ନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ଶ୍ୟାମ ବାଙ୍କଚାହାଣୀ",
          "ମରମ ଦେବଟି ହାଣି",
          "ନ ଯିବୁ ତୁ ନୀର ଆଣି",
          "ଘନ ଜଘନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦେଲୁଣିକିରେ ପାଶୋରି",
          "ଦଗାଦାର ବଂଶୀଧାରୀ",
          "ସରିଯିବୁରେ କିଶୋରୀ",
          "ନ ଘେନୁ ମନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେ ସୁନ୍ଦର ବନମାଳୀ",
          "ନାଚୁଥିବେ ଢଳି ଢଳି",
          "ଶିଖୀ ପୁଚ୍ଛ ବାମେ ଢାଳି",
          "କାଳିଆ ସୁନା"
        ]
      }
    ]
  },
  "sources": [
