  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-kahinki-syama-re-manini/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ କାହିଁକି",
          "ଶ୍ୟାମରେ ମାନିନୀ",
          "କାହିଁକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଫିଟା କମଳ ଶିରୀ ଫୁଟା ଶ୍ରୀମୁଖ ଝଳି",
          "ଛଟା ନାହିଁ ତ କିଶୋରୀ ।",
          "(ପଡ଼ି— ତ୍ରିପଟା)",
          "ବଲାଉ ନାହୁଁ ମନ ବେଶ ବାସରେ ଧନ",
          "ନାସା ତିଳ ସୁମନ ତେଜେ ଖର ପବନ",
          "ତନୁ ସହେ ଅତନୁ ଦହନ",
          "ଜୀବଧନ ରେ",
          "(ଝୁଲା)",
          "ସତେ ରେ ହେମଗୋରୀ ତୋ ଛାଇ ଅନୁସରି",
          "ଶ୍ୟାମଳତାର ସରି ସରିଗଲାଣି ହରି",
          "(ପହପଟ)",
          "ପଚାରେ କବିଶଶୀ ଶ୍ୟାମ ଶରଧା",
          "ମନେ ନାହିଁକି"
        ]
      }
    ]
  },
