{
  "id": "oa-gita-000974",
  "name": {
    "en": "Kaha bhabe majji aji",
    "or": "କାହା ଭାବେ ମଜ୍ଜି ଆଜି"
  },
  "composer": "oa-person-000055",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-bhabe-majji-aji-madanamohana-dharakote/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହା ଭାବେ ମଜ୍ଜି ଆଜି ହସୁଛୁ ଗୋ ଏତେ",
          "ତୋ ହୃଦ କୁମୁଦବନ୍ଧୁଙ୍କୁ ଦେଖିଲୁ କି ସତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପୁଲକିତ ମନେ ଉପବନେ ଚାହୁଁ",
          "ଗୁଣୁଗୁଣୁ ସ୍ୱରେ କି ସଙ୍ଗୀତ ଗାଉ",
          "ଗୁନ୍ଥିଛୁ କୁସୁମମାଳା ଅନୁରାଗ ଚିତ୍ତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛନ୍ନଛନ୍ନ ଆଜି ହେଉଛି ତୋ ମନ",
          "ଲୁଚାଇ ରଖିଛୁ କି କର୍ପୂର ଚନ୍ଦନ",
          "ସୁନ୍ଦର ମୁଖ ମୁକୁରେ ଦେଖୁଛୁ ନିରତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଭିମାନେ କଥା ନ କହୁ କାହିଁକି",
          "ଆମ୍ଭେମାନେ ସାଜି ଦିଅନ୍ତୁ ନାହିଁକି",
          "ତୋ ମନ ଭାବ ମୁଁ ସଖୀ ଜାଣଇ କିଞ୍ଚିତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନ ଚୋର ପାଇଁ ପାଶୋରି ଦେବୁ କି",
          "ଦିନେ ହେଲେ ମନେ ପଡ଼ିବ ନାହିଁକି",
          "ଯିବା ବେଳେ ଅଭିସାରେ ବୃନ୍ଦାବନ ପଥେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସାଧୁ ସଙ୍ଗେ ଧରାକୋଟ ନୃପବର",
          "ଦେଖିବା ପାଇଁକି କିଶୋରୀ କିଶୋର",
          "କୁଞ୍ଜଦ୍ୱାରେ ଉଭା ହୋଇ ଚାହିଁଛି ଚକିତେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-bhabe-majji-aji-madanamohana-dharakote/"
    }
  ],
