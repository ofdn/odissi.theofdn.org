{
  "id": "oa-gita-000482",
  "name": {
    "en": "Rasabati kahara jubati re",
    "or": "ରସବତୀ କାହାର ଯୁବତୀରେ"
  },
  "composer": "oa-person-000102",
  "mula_raga": [
    "oa-raga-000130"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasabati-kahara-jubati-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରସବତୀ କାହାର ଯୁବତୀରେ",
          "କହ କହ ପ୍ରାଣସହି",
          "ଖଣ୍ଡି ଯାଉଥିଲା ଚଣ୍ଡୀଶପଥ ସେ",
          "ମଣ୍ଡି ଦେଉଥିଲା ମହୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଦନକରର ମୁକୁରକୁ ନିନ୍ଦେ",
          "ବଦନ ପୂର୍ଣ୍ଣମୀ ଇନ୍ଦୁ",
          "ହସି ଯାଉଥିଲା ଅଳପ ଅଳପ",
          "ଖସି ପଡ଼ୁଥିଲା ମଧୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଖେଳି ଯାଉଥିଲା ଖଞ୍ଜନ ପରାୟେ",
          "ଢାଳି ଯାଉଥିଲା ଆଖି",
          "ନ ଭୁଲିବ ଅବା କେଉଁ ଯତି ତାର",
          "ଭ୍ରୂଲତା ତାଣ୍ଡବ ଦେଖି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପଙ୍କଜ ନୟନେ ଦୂର କରୁଥିଲା",
          "ଝଲକ ମୁଖମଣ୍ଡଳ",
          "ରଷାଣ କାଞ୍ଚନଗୋରୀକି ଦେଖିଲେ",
          "ପାଷାଣ ହିଁ ହେବ ଜଳ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଝୀନ ରଙ୍ଗଶାଢ଼ୀ ଫୁଟି ଦିଶୁଥିଲା",
          "ମୀନ ସୁଲୋଚନା କୁଚ",
          "ଯେଡ଼େ ଯତନେ ଘୋଡ଼ାଇ ଯାଉଥିଲା",
          "ତେଡ଼େ ଦିଶୁଥିଲା ଉଚ୍ଚ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଥଳକମଳ କି ଫୁଟି ଯାଉଥିଲା",
          "ଚରଣ ଚାଳିବା ବେଳେ",
          "କନକଲତା କି ଲୁଳି ଯାଉଥିଲା",
          "ଅନେକ ରତନ ଫଳେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ରଙ୍ଗେ ଯାଉଥିଲା ରମଣୀରତନ",
          "ଅଙ୍ଗେ ସାର ଶୋଭା ଘେନି",
          "ପାଦେ ଶୋହିବାର ବାଜେଣୀ ନୁପୂର",
          "ନାଦେ ମୋହୁଥିଲା ମୁନି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କହେ କବି ଦ୍ୱିଜ ଶ୍ରୀଧର ଶ୍ରୀ କୃଷ୍ଣ",
          "ରସେ ହାସ ଭାଷ ଦୂତୀ",
          "ଶମ୍ବରାରି ଶର ଭ୍ରମ କରାଇଲା",
          "ଭାଳ ତୁମ୍ଭ ପ୍ରିୟବତୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasabati-kahara-jubati-re/"
    }
  ],
