{
  "id": "oa-gita-001252",
  "name": {
    "en": "Aha mo ramani mani",
    "or": "ଆହା ମୋ ରମଣୀମଣି"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000150"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aha-mo-ramani-mani-todiparaja-biramitrodaya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା ମୋ ରମଣୀମଣି",
          "ରୋଷ କଲୁ କେଉଁ ଦୋଷ ମଣି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚିତ୍ତରେ କର ବିଚାର ଯେ ଯାହାର ପରିଚାର",
          "ତାର ଅପରାଧକୁ କି ଗଣି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବନ୍ଧୁ ସରଳ ହୃଦୟା ହେବାରୁ ସିନା ତୋ ଦୟା",
          "ସାଜିଥିଲା ସେ ପ୍ରୀତି ବିପଣୀ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖଚ ବଚନକୁ ଧରି ଲୋଚନେ ଲୋତକଭରି",
          "ଦେଲୁ ଡୁବାଇ ପ୍ରଣୟ ଖଣି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଧନ ତାର ହୃଦନ୍ତର ପୂର୍ଣ୍ଣ ସ୍ନେହ ରସେ ତୋର",
          "ଆନ ଯିବାକୁ ନାହିଁ ସରଣୀ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଧରି ବୃଥା ଅଭିମାନ କରିଥିଲୁ ସିନା ମାନ",
          "ଗୀତେ ବୀରମିତ୍ରୋଦୟ ଭଣି ରେ"
        ]
      }
    ]
  },
  "sources": [
