{
  "id": "oa-gita-000468",
  "name": {
    "en": "Prana sakhi sarasakhi rusila re",
    "or": "ପ୍ରାଣସଖୀ ସାରସାକ୍ଷୀ ରୁଷିଲା ରେ"
  },
  "composer": "oa-person-000035",
  "mula_raga": [
    "oa-raga-000125"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prana-sakhi-sarasakhi-rusila-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣସଖୀ ସାରସାକ୍ଷୀ ରୁଷିଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳ୍ପସୁନ୍ଦରୀ ବାଳା ଅଳ୍ପ ନ ଢାଳି ଡୋଳା",
          "ତଳ୍ପରୁ ତେଜି ଲୀଳା ତଳ ରସିଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମିନତି ଚାଟୁ ବାଣୀ ପ୍ରୀତି ବଚନ ଶୁଣି",
          "ଶ୍ରୁତି ନ ଡେରି ପୁଣି ନାହିଁ ଭାଷିଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେତେ ସରସ କଥା ସତେ ହୋଇଲା ବୃଥା",
          "କ୍ଷିତିରେ ପୋତି ମଥା ମାନେ ବସିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିଲୀନ ହେଲା ସୁଖ ମଳିନ କଲା ମୁଖ",
          "ନଳିନ ଯେଣୁ ଦୁଃଖ ବେଗେ ଗ୍ରାସିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
