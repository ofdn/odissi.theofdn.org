{
  "id": "oa-gita-001267",
  "name": {
    "en": "Kandana kandana are syamasundara",
    "or": "କାନ୍ଦନା କାନ୍ଦନା ଆରେ ଶ୍ୟାମସୁନ୍ଦର"
  },
  "composer": "oa-person-000093",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kandana-kandana-are-syamasundara-dwija-lokanatha-krusnalila/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାନ୍ଦନା କାନ୍ଦନା ଆରେ ଶ୍ୟାମସୁନ୍ଦର",
          "ପଛେ କ୍ଷୀର ଦେବି ତୋତେ ଧରି କୋଳର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜଞ୍ଜାଳ ନ କର ତୁହି ଦଧି ମନ୍ଥିବଇଁ ମୁହିଁ",
          "ମାସିକର ବୁଝିନିଏ ଦୁଷ୍ଟ ଅସୁର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସମ ବୟସ ଗୋପାଳ ଡାକୁଛନ୍ତି ହୋଇ ମେଳ",
          "ଖେଳ ଖେଳିବାର ଆଜ ହେଲା ଉଛୁର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାନ କାଟିନେବ କୋକ ନ କାନ୍ଦରେ ପଦ୍ମମୁଖ",
          "ଏଡ଼େ ଦୁଷ୍ଟ କାନକଟା ଅଛି ଏ ଘର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୋଳକୁ ମୁଁ ଡାକି ଆଗେ ଆସ କୋଳ ତୁହି ବେଗେ",
          "କହ୍ନାଇର କାନ କାଟି ନିଅ ସତ୍ୱର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଡରାଇ କହନ୍ତି ରାଣୀ ନ ଡରନ୍ତି ନୀଳମଣି",
          "ଚଳି ହୋଇ କରି ଗାଳି ଦ୍ୟନ୍ତି ଅପାର"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ତୁ ବଡ଼ ନବରଙ୍ଗିଆ କା ଦେହ ସହିବ ଏହା",
          "କାର କେତେ ସୁତ ନାହିଁ ଏ ଗୋପପୁର"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଦଧି ମନ୍ଥି ମୁଁ ସାରିଲେ ଧରି ବସିବି କୋଳରେ",
          "ଏଡ଼େ ଜଞ୍ଜାଳିଆ ପୁଅ ଅଛି କାହାର"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ମାତା ବାଣୀ କର୍ଣ୍ଣେ ଶୁଣି ସନ୍ତୋଷରେ କମ୍ବୁପାଣି",
          "ଦ୍ୱିଜ ଲୋକନାଥ ଭଜି କୃଷ୍ଣ ପୟର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kandana-kandana-are-syamasundara-dwija-lokanatha-krusnalila/"
    }
  ],
