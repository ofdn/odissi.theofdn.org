{
  "id": "oa-gita-000373",
  "name": {
    "en": "Ki upaya kale se syama murati",
    "or": "କି ଉପାୟ କଲେ ସେ ଶ୍ୟାମ ମୂରତି"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-upaya-kale-se-syama-murati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଉପାୟ କଲେ ସେ ଶ୍ୟାମ ମୂରତି",
          "ଚିତ୍ତରୁ ହେବ ପାସୋର । ରେ ମିତଣୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୂଆ ନୀଳ ଜଳଧର ଜିତ ତନୁ",
          "ନବ ଶିଖଣ୍ଡଶେଖର ରେ",
          "ନବୀନ କିଶୋର ନୂଆ ନଟବର",
          "ନୂଆ ବଂଶୀନ୍ୟାସାଧର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେଣେ ଚାହିଁଦେଲେ ତେଣେ ସେ ଦିଶୁଛି",
          "ନୟନ ବୁଜିଲେ ହୃଦରେ ନାଚୁଛି",
          "ଦେଖିଲେ ଆନନ୍ଦ ମୃତରେ ଭାସୁଛି",
          "ନ ଦେଖି ଦୁଃଖ ଲଭୁଛି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବନ କି ସଦନ ଏକ ନିଶି ଦିନ",
          "ଶୟନ ସ୍ୱପନ କିବା ଜାଗରଣ",
          "ରଖୁ ନାହିଁ ଜ୍ଞାନ ସେହି ଏକା ଧ୍ୟାନ",
          "ବଟି ହେଉଛି ବଚନ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୁଳଶୀଳ ବାରିଧିକି ରେ ନାଗରୀ",
          "କୁମ୍ଭଜ ପରାୟେ ଦେଲି ଚଳୁ କରି",
          "ବୋଲୁ କିଶୋରୀ ବୋଧିଲେ ସହଚରୀ",
          "ଭାଷେ ହରିବନ୍ଧୁ ସ୍ମରି ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-upaya-kale-se-syama-murati/"
    }
  ],
