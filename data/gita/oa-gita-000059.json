{
  "id": "oa-gita-000059",
  "name": {
    "en": "Bhaja mana anudina janardananku",
    "or": "ଭଜ ମନ ଅନୁଦିନ ଜନାର୍ଦ୍ଦନଙ୍କୁ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000031"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhaja-mana-anudina-janardananku-tarini-patra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭଜ ମନ ଅନୁଦିନ ଜନାର୍ଦ୍ଦନଙ୍କୁ",
          "ଭକ୍ରାଧୀନ ଭାବଗ୍ରାହୀ ଭଗବାନଙ୍କୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭବ ବନ୍ଧନୁ ହୁଗୁଳି ଛାଡ଼ କପଟ ଚାତୁରୀ",
          "ବେଗେ ଚଳ ନିତ୍ୟସ୍ଥଳୀ ବୃନ୍ଦାବନକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରହ୍ମାଦି ଶିବ ସନକ ସନନ୍ଦନ ଶେଷ ଶୁକ",
          "ଚିର ବାଞ୍ଛିତ ବନ୍ଦିତ ଶ୍ରୀଚରଣକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାବେ ତାରିଣୀ ଚରଣ ମଜ୍ଜି ସେ ମହାଭାବେଣ",
          "ଚିନ୍ତଇ ଅନ୍ତରେ ସଦା ନିତ୍ୟଧନକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
