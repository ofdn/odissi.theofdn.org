{
  "id": "oa-gita-000936",
  "name": {
    "en": "Kunje gamana go",
    "or": "କୁଞ୍ଜେ ଗମନ ଗୋ"
  },
  "composer": "oa-person-000130",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunje-gamana-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁଞ୍ଜେ ଗମନ ଗୋ ମତ୍ତ କୁଞ୍ଜର ଗାମିନୀ",
          "ବାଜେ କିଣି କିଣି କିଣି ଜଘନ କିଙ୍କିଣୀ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୁଙ୍ଗବିଦ୍ୟା ଡମ୍ପ ବାଜେ ଚମକି ବଜାଏ",
          "ରଙ୍ଗେ ନାଚେ ରଙ୍ଗଦେବୀ ସୁଦେବିକା ଗାଏ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାନା ନୃତ୍ୟ ଗୀତ ରସ ବିଳାସ ପ୍ରକଟେ",
          "ବନ ଘନ ଦିଗ ଦିଗାନ୍ତର ପୂରି ଉଠେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୌରୀ ଚନ୍ଦ୍ରମୁଖୀ ସରୋଜ ନୟନୀ",
          "କନ୍ଦର୍ପ ମୋହିନୀ ରମ୍ଭା ଚାରୁ ନିତମ୍ବିନୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାଧେ ରସବତୀ ପ୍ରେମାମୃତ ଉଦ୍ଗାରିଣୀ",
          "ବିନେ ହେମ ଗୌରୀ ବୃନ୍ଦା ବିପିନ ଶାୟିନୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୋଲେ ଶ୍ରୀଚନ୍ଦନ ପ୍ରେମତରଙ୍ଗ ପ୍ରକାଶ",
          "ଧ୍ୟାନେ ଜାଣି କଇଳାସେ ନାଚେ କୃତ୍ତିବାସ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunje-gamana-go/"
    }
  ],
