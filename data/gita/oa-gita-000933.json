{
  "id": "oa-gita-000933",
  "name": {
    "en": "Manini ratana dhani",
    "or": "ମାନିନୀ ରତନ ଧନୀ"
  },
  "composer": "oa-person-000130",
  "mula_raga": [
    "oa-raga-000082"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manini-ratana-dhani-gouda-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନିନୀ ରତନ ଧନୀ ମାନ ତେଜ ଏଣିକି",
          "ଆନନ୍ଦଦାୟୀ ଆନନ୍ଦେ ଭଜ ବେଣୁପାଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କରୁଛି ଦଇନୀ ରାଧେ ଧରୁଛି ତୋ ପାଣିକି",
          "ସେ ଶ୍ୟାମନାଗର ଦୋଷ ଫିଙ୍ଗିଦିଅ ପାଣିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯଦିବା ଦିନ ଛାଡ଼ିବ ବୋଲି ବୁଝି ମଣିକି",
          "ଚାହୁଁ ପରା ହରିତାଳିକାର ନିଶାମଣିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯାର ଲାଗି ମୂରୁଛିଲ କୁଳଶୀଳ ଆଣିକି",
          "ଜାଣୁ ଜାଣୁ ମଣି ତାକୁ ପର ପରି ମଣିକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପୀରତିବତ୍ସଳା ରଖ କୀରତି ନିଶାଣିକି",
          "ଦୁଃଖ ତେଜ ସୁଖ କର ଦୁଃଖୀ ଚିନ୍ତାମଣିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପଦେ ଦୋଷ କଲେ ପଦ୍ମ ଭୃଙ୍ଗ କି ନ ଗଣିକି",
          "ଉନ୍ମତ୍ତେ ଉନ୍ମତ୍ତେ ଫୁଲେ ବସିଛି ସେ ଜାଣିକି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ସେ ସ୍ନେହ ନ ମାନି ଏବେ ଗଲାଣି ସେ କେଣିକି",
          "କାହାର ଏ ଊଣା ନ ଘେନିଲ କୁହା ବାଣୀକି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ବୋଲେ ଶ୍ରୀଚନ୍ଦନ ବୃନ୍ଦା ଭାଷେ ଠାକୁରାଣୀକି",
          "ଦୋଷ ତେଜି ସୁଖୀ କର ବଙ୍କିମ ଚାହାଣୀକି"
        ]
      }
    ]
  },
