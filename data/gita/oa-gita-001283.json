{
  "id": "oa-gita-001283",
  "name": {
    "en": "Mo rana achiti tote",
    "or": "ମୋ ରାଣ ଅଛିଟି ତୋତେ"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000081"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mo-rana-achiti-tote-bihagada-gourachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋ ରାଣ ଅଛିଟି ତୋତେ ଲୋକହସା କର ନାହିଁ",
          "ବସନ ପ୍ରସାରି ମାଗି ଘେନୁଛି ପରାଣସହୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗଙ୍ଗାରୁ ବଳି ଗଭୀର ବୋଲି ହୃଦୟ ତୋହର",
          "ନ ଛପାଇ କହିଥିଲି ମନର କଥା ଫିଟାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୁଚ୍ଛାକୁ ଲୋକେ ତ ନିତି କୁତ୍ସା ମୋତେ କରୁଥାନ୍ତି",
          "ଜଣା ପଡ଼ିଯିବ ଯଦି ମହତ ନେବେ ଛଡ଼ାଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଫୁଟିଲା ଫୁଲର ବାସ ହୋଇଯିବ ପରକାଶ",
          "ପହିଲୁ ସଙ୍ଗିନୀ ଏଣୁ ଏକା ଡରୁଥାଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜାଣିବା ନ ଜାଣି ମୁଁ ତ ହୁଡ଼ିଦେଇ ଅଛି ପଥ",
          "ଗୌରଚନ୍ଦ୍ର ଗଜପତି ସ୍ନେହ ଭାବେ ଭୁଲିଯାଇ"
        ]
      }
    ]
  },
  "sources": [
