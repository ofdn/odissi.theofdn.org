{
  "id": "oa-gita-000670",
  "name": {
    "en": "Sajani ki hela mote",
    "or": "ସଜନୀ କି ହେଲା ମୋତେ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-ki-hela-mote-kamodi-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ କି ହେଲା ମୋତେ",
          "ମୋହନ ବିଗ୍ରହ ନେତ୍ରେ ନୃତ୍ୟ କଲା ଅନୁବ୍ରତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭ୍ରମରେ ହେଲେ ତ ଦିନେ",
          "ଭ୍ରମି ନାହିଁ ବଂଶୀ ସ୍ୱନେ",
          "ଏ କି ଲୋ ମା ଅକାରଣେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯାଉଁ ଯମୁନା କୂଳକୁ",
          "ଅଜାଗେ ନୀପ ମୂଳକୁ",
          "ଅନାଇ ଦେବା ମାତ୍ରକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରି କେତେ ଦୃଢ଼ ପଣ",
          "କଲେହେଁ ଯେତେ ବର୍ଜ୍ଜନ",
          "ତଥାପି ନ ମାନେ ମନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯିବାକୁ ନିକୁଞ୍ଜ ବନେ",
          "ପାଞ୍ଚି ନାହିଁ ତ ସ୍ୱପନେ",
          "କିମ୍ପା ରହି ନୁହେଁ କ୍ଷଣେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ଗିର",
          "ଏବେ ହେଲା ଚିନ୍ତା ସାର",
          "ଶାଶୁ କି ବୋଲିବେ ମୋର"
        ]
      }
    ]
  },
  "sources": [
