{
  "id": "oa-gita-000245",
  "name": {
    "en": "Kete belaku sri padabja disiba je",
    "or": "କେତେବେଳକୁ ଶ୍ରୀ ପଦାବ୍ଜ ଦିଶିବ ଯେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kete-belaku-sri-padabja-disiba-je-anandabhairabi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେତେ ବେଳକୁ ଶ୍ରୀ ପଦାବ୍ଜ ଦିଶିବ ଯେ",
          "ଜୀବ ଅଳି ଯାଇ ସୁଖେ ବସିବ ଯେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀ ଗୋବିନ୍ଦ ବକ୍ଷସ୍ଥଳ ସଂଯୋଗର ପରିମଳ",
          "ତହୁଁ ଲଭି ଲୋଭେ ମଜ୍ଜି ରହିବ ଯେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୋଷ୍ଠେନ୍ଦୁ ନୟନ ଭୃଙ୍ଗ ସଙ୍ଗତରେ କରି ରଙ୍ଗ",
          "ସ୍ୱେଦ ମକରନ୍ଦ କ୍ଷୋଦ ପିଇବ ଯେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୂକ୍ଷ୍ମ ଧୂଳି ପରାଗରେ ଲୋଟିବ ଅନୁରାଗରେ",
          "ସୁରମ୍ୟ ମଧୁର ନାଦ କରିବ ଯେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବ୍ରଜ ନବ ଯୁବାବର ଶ୍ରୀକରେ ଚିତ୍ର କଲାର",
          "ଯାବକ ପରିଧି ଯାକ ବୁଲିବ ଯେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସୌଭାଗ୍ୟ ରେଖାଦି ଚିହ୍ନ ଚିହ୍ନିବ କରି ଦର୍ଶନ",
          "ଭାବ ସୁଧା ବାରାଧିରେ ଭାସିବ ଯେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଅଶୋକ କଳିକା ବଳି ସୁସ୍ନିଗ୍ଧ କୋମଳାଙ୍ଗୁଳି",
          "ବିକଶିବ ବୋଲି ଆଶା ବଳିବ ଯେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଉର୍ଦ୍ଧ୍ୱରେ କେତକୀ କାନ୍ତି ତଳେ କୋକନଦ ଦ୍ୟୁତି",
          "ବିଲୋକ ଅତି ପ୍ରମୋଦ ମାତିବ ଯେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ସୁମନ କମ ରତ୍ନର ଭୂଷାରେ ନୂପୁରାଦିର",
          "ପୁଷ୍ପ ଭ୍ରମେ ଉଡ଼ିତ ସ୍ପରଶିବ ଯେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଶ୍ରୀ ରୂପମଞ୍ଜରୀ କର ଲଳିତ ମଧୁରତର",
          "ପରମାନନ୍ଦ ଆଗାର ପାଇବ ଯେ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଏ ଭାଗ୍ୟ ଭୋଗକୁ ହୋଇବ ଯୋଗ୍ୟ",
          "ଶ୍ରୀ ସ୍ୱାମିନୀ ଦୟା ଦୃଷ୍ଟି ପଡ଼ିବ ଯେ"
        ]
      }
    ]
  },
  "sources": [
