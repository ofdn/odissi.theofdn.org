{
  "id": "oa-gita-000024",
  "name": {
    "en": "Kahana lo ta katha mote",
    "or": "କହନା ଲୋ ତା କଥା ମୋତେ"
  },
  "composer": "oa-person-000017",
  "mula_raga": [
    "oa-raga-000016"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahana-lo-ta-katha-mote/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହନା ଲୋ ତା କଥା ମୋତେ",
          "ମୋହ ନାଁରେ ବ୍ରଜେ ହଟା କରିଦେଲା ଯେତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ମଧୁର ବାଣୀ ପୁଣି ଦେଖିଛୁ ସାକ୍ଷାତେ",
          "କହି ହଠଟା କଲା ନେଇ ଯା ସଙ୍କେତେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କପଟ ନ ଥିଲା ପରି କରିଥିଲି ପ୍ରତେ",
          "ନିପଟ ଜାଣିଲି ତାର ହୃଦେ ଘଟା ଏତେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିନ୍ଦା ଶୁଣାଇଲା ଦାଣ୍ଡ ହାଟ ବାଟେ ମୋତେ",
          "ଫନ୍ଦାଧନ ମୋର ବୋଲି ପାଞ୍ଚିଥିଲି ଚିତ୍ତେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷେ ରସେ ଶ୍ୟାମ ବନ୍ଧୁ କହିଛି ଏକାନ୍ତେ",
          "ପାଶେ ଛନ୍ଦାଚରଣରେ ବନ୍ଧା ମୁଁ ଲଳିତେ"
        ]
      }
    ]
  },
  "sources": [
    {
