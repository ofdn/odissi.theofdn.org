{
  "id": "oa-gita-000313",
  "name": {
    "en": "Daya nahinki",
    "or": "ଦୟା ନାହିଁକିଦୟାମୟ ହେ ନିର୍ଦ୍ଦୟ ହେଉଛ କାହିଁକି । ଘୋଷା । ସାନ କାଳୁଁ ଦାନବଙ୍କୁ ହତକରି ରଖିଛ ପରା ହେ ନାଥଏବେ ଗୋପୀଙ୍କି କରି ଅନାଥପଳାଇବ ପ୍ରେମ ପାଶ ଗଳାରେ ଦେଇକି । ୧ । କଂସ ଆଦେଶ ଘେନି ଅକ୍ରୂରକ୍ରୂରପଣକୁ ଦେଖାଇ ତାରସଜ କଲାଣି ସେ ଯାନବରଆଜ ବରଜୁ ବିଜେ ହେବେ ବେନି ଭାଇ କି । ୨ । ଶକ୍ର କୋପକୁ ଦେଖିଣ ଘୋରବକ୍ର ନୋହିଲ ହେ ତକ୍ର ଚୋରଛତ୍ରାକାର କରି ଗିରିବରଧଇଲ […]"
  },
  "composer": "oa-person-000055",
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/daya-nahinki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦୟା ନାହିଁକି",
          "ଦୟାମୟ ହେ ନିର୍ଦ୍ଦୟ ହେଉଛ କାହିଁକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାନ କାଳୁଁ ଦାନବଙ୍କୁ ହତ",
          "କରି ରଖିଛ ପରା ହେ ନାଥ",
          "ଏବେ ଗୋପୀଙ୍କି କରି ଅନାଥ",
          "ପଳାଇବ ପ୍ରେମ ପାଶ ଗଳାରେ ଦେଇକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଂସ ଆଦେଶ ଘେନି ଅକ୍ରୂର",
          "କ୍ରୂରପଣକୁ ଦେଖାଇ ତାର",
          "ସଜ କଲାଣି ସେ ଯାନବର",
          "ଆଜ ବରଜୁ ବିଜେ ହେବେ ବେନି ଭାଇ କି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶକ୍ର କୋପକୁ ଦେଖିଣ ଘୋର",
          "ବକ୍ର ନୋହିଲ ହେ ତକ୍ର ଚୋର",
          "ଛତ୍ରାକାର କରି ଗିରିବର",
          "ଧଇଲ ଏ ଗୋପପୁର ରଖିବା ପାଇଁକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବିଷ ଜଳରେ ହୋଇ ଆତୁର",
          "ନାଶ ବାଞ୍ଛିବାରୁ ଯେ ତୁମ୍ଭର",
          "ରୋଷ ବହି ମାନସ ଭିତର",
          "ନାଶ କଲ ପରା ପଦେ କାଳୀୟ ଅହିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଧରାକୋଟାଧିପ ଶ୍ରୀ ମଦନ",
          "ମୋହନ ସିଂହ ଦେବ ରଚନ",
          "ଦୂତ ନେଇ ଗୋପୀଙ୍କି କଦନ",
          "ମଦନମୋହନେ ନେବ ରଥେ ବସାଇ କି"
        ]
      }
    ]
  },
