{
  "id": "oa-gita-000342",
  "name": {
    "en": "Dwitiya jaminire mo pranasahi",
    "or": "ଦ୍ୱିତୀୟା ଯାମିନୀରେ ମୋ ପ୍ରାଣସହୀଦିନେ ପଲଙ୍କେ ଥିଲା ମୋ କୋଳେ ଶୋଇ ଯେ ।କୁସୁମବତୀ ହୋଇ ଅବନୀ ଶୋଭାତଳପ ତେଜି ତଳେ ହୋଇଛି ଉଭା ଯେ । ୧ । ଯେତେବେଳେ ଚେତନା ପାଇଲି ମୁଁ ଯେଲୋଡ଼ିଲି ପ୍ରାଣପ୍ରିୟା ନାହିଁ ମୋ ଶେଯେ ଯେ ।ହେ ଜୀବେଶ୍ୱରୀ ବୋଲି ଡାକନ୍ତେ ପୁଣିଚତୁରୀ ନ କହିଲା ତେବେହେଁ ବାଣୀ ଯେ । ୨ । ପ୍ରଦୀପ ହତ ଦେଖି କରନ୍ତେ ଲୋଡ଼ାତକ୍ଷଣେ ଫେଇଦେଲା ଗବାକ୍ଷ ପୁଡ଼ା ଯେ ।ଚନ୍ଦ୍ରକିରଣେ […]"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000100"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dwitiya-jaminire-mo-pranasahi/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଦ୍ୱିତୀୟା ଯାମିନୀରେ ମୋ ପ୍ରାଣସହୀ",
          "ଦିନେ ପଲଙ୍କେ ଥିଲା ମୋ କୋଳେ ଶୋଇ ଯେ ।",
          "କୁସୁମବତୀ ହୋଇ ଅବନୀ ଶୋଭା",
          "ତଳପ ତେଜି ତଳେ ହୋଇଛି ଉଭା ଯେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେତେବେଳେ ଚେତନା ପାଇଲି ମୁଁ ଯେ",
          "ଲୋଡ଼ିଲି ପ୍ରାଣପ୍ରିୟା ନାହିଁ ମୋ ଶେଯେ ଯେ ।",
          "ହେ ଜୀବେଶ୍ୱରୀ ବୋଲି ଡାକନ୍ତେ ପୁଣି",
          "ଚତୁରୀ ନ କହିଲା ତେବେହେଁ ବାଣୀ ଯେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରଦୀପ ହତ ଦେଖି କରନ୍ତେ ଲୋଡ଼ା",
          "ତକ୍ଷଣେ ଫେଇଦେଲା ଗବାକ୍ଷ ପୁଡ଼ା ଯେ ।",
          "ଚନ୍ଦ୍ରକିରଣେ ଚନ୍ଦ୍ରମୁଖ ଦିଶିଲା",
          "ବସନାଞ୍ଚଳ ମୁଖେ ଦେଇ ହସିଲା ଯେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏଡ଼େ କପଟ କିମ୍ପା ନିଜ ଦାସକୁ",
          "ବୋଲି ମୁଁ ଯାନ୍ତେ ପ୍ରାଣପ୍ରିୟା ପାଶକୁ ଯେ ।",
          "ଗଭାରୁ କରବୀର କୁସୁମ ତିନି",
          "ଘେନି ପକାଇ ଦେଲା ଘନଜଘନୀ ଯେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦେଖି କାତର ହେଲା ହୃଦୟ ମୋର",
          "ରୋମକେ କାଣ୍ଡେ କାଣ୍ଡେ ବିନ୍ଧିଲା ସ୍ମର ଯେ ।",
          "ଧାତାକୁ ନିନ୍ଦା କଲି ପୁରୁଷ ହୋଇ",
          "ପୁରୁଷେ ଏଡ଼େ ଦଣ୍ଡ ଦେଲା କିମ୍ପାଇଁ ଯେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କହଇ ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ ଏ ଗୀତେ",
          "ହର ପୂଜିବି ମୁହିଁ କାନ୍ତା ନିମନ୍ତେ ଯେ ।",
          "ସେବାରେ ମନାଇଁବି ପାର୍ବତୀବର",
          "ବନ୍ଧୁ ମୋ କୋଳରୁ ନୋହିବ ଅନ୍ତର ଯେ"
        ]
      }
    ]
  },
