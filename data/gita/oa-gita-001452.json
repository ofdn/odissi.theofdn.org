{
  "id": "oa-gita-001452",
  "name": {
    "en": "Chahan nayana chape madanamohana",
    "or": "ଚାହାଁ ନୟନ ଚାପେ ମଦନମୋହନ"
  },
  "composer": "oa-person-000003",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahan-nayana-chape-madanamohana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବଧା ପଡ଼ି ପ୍ରବନ୍ଧ",
          "ଚାହାଁ ନୟନ ଚାପେ ମଦନମୋହନ ।ଘୋଷା।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗଳେ ବାସ ବନଫୁଲ କି ଶୋଭା",
          "ଭାଲେ ରୋଚନା କି ମନଲୋଭା",
          "ଶ୍ୟାମ ତ୍ରିଭଙ୍ଗ ଛନ୍ଦେ ଉଭା",
          "ବାମେ ଅଳପ ଢଳିଛି ଗଭା",
          "(ପଡ଼ି)",
          "କାଳିୟଗରଗରଗଞ୍ଜନ",
          "କାମିନିଜନମନରଞ୍ଜନ",
          "କାନ୍ତି ନବଘନଶୋଭନ",
          "ମୋହନ ଶୋଭନ ଚନ୍ଦନମଣ୍ଡିତ ବରଚନ୍ଦ୍ରାନନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୋଟିମଦନ ଜିଣିଛି କାନ୍ତି",
          "କୁନ୍ଦସୁମନ ଦଶନାପନ୍ତି",
          "ଶ୍ରୀମୁଖ ଶତ ଶଶୀ ଖେଳନ୍ତି",
          "ଶ୍ୟାମସୁନ୍ଦର ନମଇଁ ନିତି",
          "(ପଡ଼ି)",
          "ଜଗବନ୍ଦନ ସୁତ ନନ୍ଦର",
          "ନବକଦମ୍ବବନସୁନ୍ଦର",
          "ତେଜି ରଚେ କେତେ ହୁନ୍ଦର",
          "ଅପଘନ ଘନ ଘନ ବହେ ମଧୁର ମନ୍ଦ ପବନ"
        ]
      }
    ]
  },
  "sources": [
    {
