{
  "id": "oa-gita-001146",
  "name": {
    "en": "Sakhi asa jiba dekhi",
    "or": "ସଖୀ ଆସ ଯିବା ଦେଖି"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000136"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-asa-jiba-dekhi-matiari-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ଆସ ଯିବା ଦେଖି",
          "ନନ୍ଦପୁରେ ନୀଳମାଧବଙ୍କୁ ଦେଖି",
          "ସୁଫଳ କରିବା ଆଖି ସଖୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେ ବୋଲେ ସଙ୍ଗାତ ଅତି ବିପରୀତ",
          "ବଚନ ତୁମ୍ଭେ ତ କହ",
          "ସାତଶ ପଞ୍ଚାଶ ବରଷରେ ନନ୍ଦ",
          "ରାଜା ପାଇଛନ୍ତି ପୁଅ ସଖୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରେ ଅର୍ଘ୍ୟଥାଳି ଘେନି ଗୋପବାଳୀ",
          "ନନ୍ଦମନ୍ଦିରକୁ ଚଳି",
          "କାଳିଆ କାହ୍ନୁକୁ ବନ୍ଦାପନା କରି",
          "ଉଚ୍ଚେ ଦେଲେ ହୁଳହୁଳି ସଖୀ",
          "କେ ବୋଲଇ ଦେଖ",
          "ଇନ୍ଦ୍ରଧନୁ ଜିଣି ଭ୍ରୂଲତାର ଠାଣି",
          "କି ସୁନ୍ଦର ଚନ୍ଦ୍ରମୁଖ ସଖୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେ ବୋଲଇ କରୀବର ଶୁଣ୍ଢ ଜିଣି",
          "ଆଜାନୁଲମ୍ବିତ ବାହୁ",
          "ଚାହିଁଦେଲେ ଆଖି ରହୁଅଛି ଲାଖି",
          "ମୂରୁଛି ନୁହଇ ଆଉ ସଖୀ",
          "କଟି ମୃଗରାଜ",
          "ଚରଣ ରଙ୍ଗକୁ ଡରିଣ ଅରୁଣ",
          "ଶରଣ ଗଲା କି ଆଜ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଖୀ କେ ବୋଲେ ରେ ବାମା ସଂସାର",
          "ଉପମା ଏହାଠୁ ସୁଷମା ନାହିଁ",
          "ଗୌର ଦ୍ୱିଜ ଭଣି ଶୁଣିଥା ମିତଣୀ",
          "ତାହାଙ୍କୁ ଉପମା ସେହି ସଖୀ",
          "ଶୁଣ ପ୍ରାଣସହୀ",
          "ଗୋପ ନବ ବାଳୀ ଯେତେକ ଅଛନ୍ତି",
          "ସବୁରି ସଙ୍ଖାଳି ସେହି ସଖୀ"
        ]
      }
    ]
  },
  "sources": [
