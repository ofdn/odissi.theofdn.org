  "name": {
    "en": "Khanjanakhi khiti mandana",
    "or": "ଖଞ୍ଜନାକ୍ଷୀ କ୍ଷିତିମଣ୍ଡନା"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/khanjanakhi-khiti-mandana-bichitra-kamodi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଖଞ୍ଜନାକ୍ଷୀ କ୍ଷିତିମଣ୍ଡନା",
          "କୋକିଳ କଳବଚନା",
          "କାହିଁକିରେ ଧନମଣି ଏ ଗୁମାନ କରି",
          "ମୋଠାରେ ରହିଛୁ ବରାଙ୍ଗନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କରିଛି କି ଦୋଷ କହରେ ନାରୀଶ",
          "ବାସ ଅଙ୍ଗୀବାସ ପଣନ୍ତର ଦାସ",
          "ଅଟେ ତୋର ପାଶ ନ କର ନିରାଶ",
          "ଶରଦିନ୍ଦୁ ହାସ କିଞ୍ଚିତେ ପ୍ରକାଶ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗଣ୍ଡଯୁଗେ ପାଣି ମଣ୍ଡନା ସିହାଣୀ",
          "କରଜେ ଧରଣୀ ଚିରୁ କିସ ମଣି",
          "ଶିଶୁ ବଣା ଏଣୀନୟନରୁ ପାଣି",
          "ମୁଞ୍ଚୁ ଶୂଳପାଣି ମିତ୍ର ଶିରେ ଆଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମତ୍ତକରୀଗତି ନୂତନା ସୁମତି",
          "ରେ ରତିମୂରତି ତୋ ବିନା କେ ଗତି",
          "ଆରେ ରସବତୀ ମୋ ନେତ୍ରସମ୍ପତ୍ତି",
          "ଆସ ଆସ ଯତିମୋହିନୀ ମୋର କତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଣାଉଛି ଧନ ମୋ ଦୟିନୀ ଘେନ",
          "ରମଣୀରତନ ତେଜ ଅଭିମାନ",
          "ବେଣୁଧର ଦୀନ କବି ନିଶାଈନ",
          "ବିନୟ ବଚନ ନ କର ତୁ ଆନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
