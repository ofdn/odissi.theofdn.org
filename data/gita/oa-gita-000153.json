{
  "id": "oa-gita-000153",
  "name": {
    "en": "Bandhua tu mo sabu bharasa",
    "or": "ବନ୍ଧୁଆ ତୁ ମୋ ସବୁ ଭରସା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bandhua-tu-mo-sabu-bharasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବନ୍ଧୁଆ ତୁ ମୋ ସବୁ ଭରସା",
          "ନ କର ଦରପଣନିଭ ରସା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭୁଷ ପଛେ ମୁନେ କରରୁହର",
          "ଏ ଗୁମାନ ପରିକରରୁ ହର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ରୀମୁଖ ପରବ ତୁହିନକର",
          "ଅରୁଣ ଭାବକୁ ତୁହି ନ କର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିଅର୍ଥ ଏ ଚନ୍ଦ୍ର କ୍ଷଣଦା ସରେ",
          "ଖେଳା ଚଞ୍ଚଳ ଈକ୍ଷଣ ଦାସରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୁଁ ସାଧ୍ୟ ନୋହିଲେ ତିଆରଣରେ",
          "ମାର ମଦନ ହଟିଆ ରଣରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସରିଲାଟି ଅଷ୍ଟଦୁର୍ଗନାଥ ରେ",
          "ଅନା ଅନା ସୁନାବରନା ଥରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bandhua-tu-mo-sabu-bharasa/"
    }
  ],
