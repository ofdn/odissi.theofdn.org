{
  "id": "oa-gita-000163",
  "name": {
    "en": "Mohana mo ankaku asa re",
    "or": "ମୋହନା ମୋ ଅଙ୍କକୁ ଆସରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000050"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohana-mo-ankaku-asa-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନା ମୋ ଅଙ୍କକୁ ଆସରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୁଃଖନଦ ଭେଳା । ଶୁଚିସ୍ମିତ ଖେଳା ।",
          "ମଧୁରାରୁଣ ରଦବାସରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୟନରୁ ବାରି । ପ୍ରସରି ନିବାରି ।",
          "ଭିଡ଼ିଦେ ହରେ ଭୁଜ ଫାଶରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖଳ ଜନ ବାଣୀ । ହୃଦୟକୁ ହାଣି ।",
          "ରୁଷନା ଧନ ନିଜ ଦାସରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୋ ମଣି କଠାଉ । ବହି ଦିନ ଯାଉ ।",
          "ନ ଛାଡ଼ୁ ମୋର ଏ ମୁହାଁସ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗିରକର ଆହା । ସରିଲିଟି ଚାହାଁ ।",
          "ମଦନାନନ୍ଦନିଳ ଝାସରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଚୁମ୍ବନ ବିଧାନେ । ମଧୁ ରସ ଦାନେ ।",
          "ହର ମୋ ମରମ ପରାଶ ରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ବସୁଦୁର୍ଗ ରାଜା । ସୁଖେ କର ତାଜା ।",
          "ରସିଯା ତଳପ ବିଳାସରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
