{
  "id": "oa-gita-000334",
  "name": {
    "en": "Kinchitare chittare mita re",
    "or": "କିଞ୍ଚିତରେ ଚିତ୍ତରେ ମିତ ରେ"
  },
  "composer": "oa-person-000065",
  "mula_raga": [
    "oa-raga-000068"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kinchitare-chittare-mita-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କିଞ୍ଚିତରେ ଚିତ୍ତରେ ମିତ ରେ",
          "କାନ୍ତରେ ଦୟା ନୋହିଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସହି ସେହି ତୋତେ ଭାଳିବଇଁ କେତେ",
          "ତୋହରି ପାଣିକି ଭଣି କି ମଣି କି ସ୍ନେହ ନୋହିଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯାର ପାଇଁ ନିତି ଛନ୍ନ ହୋଇ ଅତି",
          "ନୋହୁ ପରଶ ସୁବେଶ ଏ କିସ । ସ୍ନେହ ନୋହିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯେବେ ଏପରିରେ ଥିଲା ଏ ଗୋରୀରେ",
          "ସେହି ତା ପାଇଁ କିପାଇଁ ଅନାଇଁ ସ୍ନେହ ନୋହିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ଯୋଗେନ୍ଦ୍ର ଦେବ ପ୍ରଣୟ ସ୍ୱଭାବ",
          "ଜାଣି ନାହିଁ କି ସହୀକି ତୁହି କି ସ୍ନେହ ନୋହିଲା"
        ]
      }
    ]
  },
  "sources": [
