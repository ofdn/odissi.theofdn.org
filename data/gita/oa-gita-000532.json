{
  "id": "oa-gita-000532",
  "name": {
    "en": "Dhana ete belu tha’a mote kahi",
    "or": "ଧନ ଏତେବେଳୁଁ ଥାଅ ମୋତେ କହି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhana-ete-belu-thaa-mote-kahi-bichitra-kamodi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧନ ଏତେବେଳୁଁ ଥାଅ ମୋତେ କହି ରେ ପ୍ରିୟସହି",
          "ତହିଁରେ ନାହିଁ ଅବଗାହି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରଥମ ପ୍ରବେଶ କାଳେ",
          "ଆଚ୍ଛାଦି ଅଙ୍ଗ ଦୁକୂଳେ",
          "ଉଭା ହେବି ସିନା ତଳେ",
          "କେଳି ତଳପକୁ ବଳେ",
          "ଘେନିଯିବେ ସେହି ସ୍ନେହ ବହିରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମାର ମନେ ଖେଳୁଥିବ",
          "ପ୍ରଦୀପ ଯେ ଜଳୁଥିବ",
          "ବିବେକ ତ ଟଳୁଥିବ",
          "ଲାଜ ତ ପ୍ରବଳୁଥିବ",
          "ତାଙ୍କ ମୁଖ ଅନାଇବ କେହିରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଦନ ମଦ ଅମଳେ",
          "ଚେତା ନ ଥିବାରୁ ଭଲେ",
          "ଲୋଭବଶୁଁ ଅବା ଗେଲେ",
          "ପୁନଃପୁନଃ ଚୁମ୍ବ ଦେଲେ",
          "ସ୍ଥିର ହୋଇ ରହି କି ନ ରହିଲେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗନାଥ ଭଣେ",
          "ତୋଷ ଗୋ ସଖି ଜଣାଣେ",
          "ମଣ୍ଡି ଆଣି ଆଭରଣେ",
          "ବନ୍ଦିବା ଶିବା ଚରଣେ",
          "ଆସିଲେ ମୁଁ ଲୋକହସା ନୋହିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
