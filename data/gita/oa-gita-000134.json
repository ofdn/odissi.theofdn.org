{
  "id": "oa-gita-000134",
  "name": {
    "en": "Kunda kali dasana",
    "or": "କୁନ୍ଦକଳିଦଶନା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kunda-kali-dasana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁନ୍ଦକଳିଦଶନା",
          "ନନ୍ଦନନ୍ଦନ ଶୋଭାକୁ ଅନାଁ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଇନ୍ଦ୍ରନୀଳସାର ଶରୀର ଏହାର",
          "କଟିତଟପଟ ସୁନା ଗୋ",
          "ତ୍ରିଭଙ୍ଗୀରେ ଉଭା ହେବା ଛବିକି ମୁଁ",
          "ଲୁଚି ହୋଇଯାଏଁ କିନା ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶରଦଚନ୍ଦ୍ର ବିମ୍ବରେ ଏ ଦ୍ୟୁତିରୁ",
          "ନାହିଁ ବୋଲି ଅଧ ଚିନା ଗୋ",
          "କମ୍ପୁଛି ଅଖଣ୍ଡ ଶିଖଣ୍ଡମଣ୍ଡନ",
          "ମୁକୁଟ କପଟବାନା ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଧୁର ଅଧର ବଧୂଲୀକି ତହିଁ",
          "ମୁରଲୀ ମୋହନ ସ୍ୱନା ଗୋ",
          "କହି କହି କୁଳବ୍ରତ ଲତାମୂଳ",
          "ଏହି ଟାଳୁଅଛି ସିନା ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀଅଙ୍ଗ ଛୁଇଁ ଆସିବା ମରୁତର",
          "କରୁଅଛି ଆଶ୍ୱାସନା ଗୋ",
          "ମୃଗମଦସାର ଦଳ ଇନ୍ଦୀବର",
          "ମିଶାମିଶି ସୁବାସନା ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୁଙ୍କୁମ ଚନ୍ଦନ ମୃଗମଦ",
          "ଘନସାର ଶିର ଗୋରୋଚନା ଗୋ",
          "ଏହାଙ୍କୁ ସେବି କୃତକୃତ୍ୟ ହେବାକୁ",
          "କରିଛି ଧାତା ରଚନା ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଜଗତୀ ଧୃତି ବିଧ୍ୱଂସ ନୁହଇ ଏ",
          "ନେତ୍ରାଞ୍ଚଳ ଖେଳ ବିନା ଗୋ",
          "ବୋଲେ ଜଗଦ୍ଦେବ ଏଥୁଁ ମନୋଭବ",
          "ମାର୍ଗଞଣ କି ଶୁଣା ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
