    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଜ ସାଜ ତୁ ଆଜ ରାଜକୁମାରୀ",
          "ଆଜି ଏ ସଞ୍ଜକୁ ସଖୀ ତୋ କୁଞ୍ଜକୁ",
          "ଆସିବେ କୁଞ୍ଜବିହାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବୀଣାବାଣୀ ତୋର ଚିତ୍ତ ବିତ୍ତ ଚୋର",
          "ମୋହନ ମୁରଲୀଧାରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତେଜ ମନୁ ମାନ ଆରେ ଜୀବଧନ",
          "ତାର ପ୍ରେମକୁ ବିଚାରି"
        ]
      }
    ]
  },
