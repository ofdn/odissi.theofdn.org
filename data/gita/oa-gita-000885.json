  "id": "oa-gita-000885",
  "name": {
    "en": "Ki kahibu ambhe tora",
    "or": "କି କହିବୁ ଆମ୍ଭେ ତୋର"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000084"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "kabya": {
    "id": "oa-kabya-000007"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-kahibu-ambhe-tora-panchama-baradi-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି କହିବୁ ଆମ୍ଭେ ତୋର ଛାମୁରେ ରମଣୀବର",
          "ଶ୍ରୀ ହରିଙ୍କି କରି ଦୂର ରାଧିକା କୋପ ପ୍ରଖର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘଉଡ଼ି ସଖୀଙ୍କି ତୂର୍ଣ୍ଣ ତମାଳେ ଲିପାଇ ଚୂର୍ଣ୍ଣ",
          "ନିୟମିଛି କୃଷ୍ଣବର୍ଣ୍ଣ ନ ପଡ଼ିବ ନେତ୍ରେ ତାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦର୍ପଣରେ ନିଜ କଳାକେଶ ଭୂରୁ ନେତ୍ର ଡୋଳା",
          "ଦେଖି କ୍ରୋଧେ ନବ ବାଳା ତରେ ଭାଙ୍ଗିଲା ମୁକୁର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାଲଟି ନୀଳ ବସନ ଶୁଭ୍ର ବସ୍ତ୍ର ପରିଧାନ",
          "କରି ସୁନୀଳ ଭୂଷଣ ତେଜିଛି ଲଳନାବର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭୃଙ୍ଗ ପରଭୃତ ଶାରୀ ଦିଶିଲେ ଲୋଡ଼ଇ ମାରି",
          "ହୋଇଛି ବାତୁଳୀ ପରି ବୃଷଭାନୁଜା ନିକର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବିକ୍ରମାର୍ଚ୍ଚିତ ରାଧିକା ରହିଅଛି କୁଞ୍ଜେ ଏକା",
          "ତା ଛାମୁକୁ ଛାଡ଼ି ଦକା ଯିବାକୁ ଦମ୍ଭ କାହାର"
        ]
      }
    ]
  },
