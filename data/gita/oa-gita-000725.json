{
  "id": "oa-gita-000725",
  "name": {
    "en": "Mana jami ja sindhu jema pranadhane",
    "or": "ମନ ଜମି ଯା ସିନ୍ଧୁଜେମା ପ୍ରାଣଧନେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000065"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-jami-ja-sindhu-jema-pranadhane/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନ ଜମି ଯା ସିନ୍ଧୁଜେମା ପ୍ରାଣଧନେ",
          "ସିତପଙ୍କଜନୟନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରମ୍ୟଯାନପଦକରେ ମୁନି ହୃଦ ପଦକରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶରଣାଗତ ବନ୍ଧୁରେ କରୁଣା ସୁଧାସିନ୍ଧୁରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦୀନଜନ ବିଭବରେ ନୀଳାଦ୍ରି କଣ୍ଠୀରବରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦଳିତ କଳୁଷପୁଞ୍ଜେ ଇନ୍ଦ୍ରବନ୍ଦ୍ୟ ପଦକଞ୍ଜେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନିଗମ କୁଞ୍ଜ କୁଞ୍ଜରେ ଭବ ଭୟାଳୁ ପୁଞ୍ଜରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଛୋଟରାୟ ଦେବ କହେ ଦୁଃଖତମର ବିଗ୍ରହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-jami-ja-sindhu-jema-pranadhane/"
    }
  ],
