{
  "id": "oa-gita-000285",
  "name": {
    "en": "Jhulanti range rai sange syamasundara",
    "or": "ଝୁଲନ୍ତି ରଙ୍ଗେ ରାଈ ସଙ୍ଗେ ଶ୍ୟାମସୁନ୍ଦର"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jhulanti-range-rai-sange-syamasundara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଝୁଲନ୍ତି ରଙ୍ଗେ ରାଈ ସଙ୍ଗେ ଶ୍ୟାମସୁନ୍ଦର",
          "ରାଗରେ ଅନୁରାଗେ କରନ୍ତି",
          "ବଂଶୀ ହୁନ୍ଦର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଝଳି ମରକତ ନୀଳେନ୍ଦ୍ରମଣି",
          "ଲାବଣ୍ୟ ପ୍ରତିମା ତ୍ରିଭଙ୍ଗୀ ଠାଣି",
          "ମୃଦୁ ମୃଦୁ ହାସ ନୟନ ବିଳାସ",
          "କେଡ଼େ ମଧୁର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମାଳତୀ କୁସୁମେ ରଚିତ ଦୋଳି",
          "ଝୁଲାଇ ଦିଅନ୍ତି ବରଜବାଳୀ",
          "ଗାଇ ଗୀତମାନ କରନ୍ତି ନର୍ତ୍ତନ",
          "ବାଇ ନୂପୁର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେ ବଜାଏ ବୀଣା ଅବା କାହାଳୀ",
          "କେ ବାଏ ମର୍ଦ୍ଦଳ ଉକୁଟ ଚାଳି",
          "କେବଣ ସୁଧୀରା ବଜାଏ ମନ୍ଦିରା",
          "ପ୍ରେମେ ଆତୁର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଟପ ଟପ ଝପ ଝପ ବରଷା",
          "ଶୀତଳ ପବନ ଚନ୍ଦ୍ରମା ନିଶା",
          "ପାରା ଶୁକ ଶାରୀ ମୟୂର ମୟୂରୀ",
          "ଆନନ୍ଦେ ଭୋର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଝୁଲଣ ଉଚ୍ଛବ କୁଞ୍ଜସଦନେ",
          "ଦେଖି ସୁଖୀ ହୋଇ ଅମରୀମାନେ",
          "ବୋଲେ ବନମାଳୀ ଦେଲେ ପୁଷ୍ପାଞ୍ଜଳି",
          "ରହି ଶୂନ୍ୟର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
