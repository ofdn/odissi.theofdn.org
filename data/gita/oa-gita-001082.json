{
  "id": "oa-gita-001082",
  "name": {
    "en": "Syama bandhu rupa sakhi",
    "or": "ଶ୍ୟାମ ବନ୍ଧୁ ରୂପ ସଖୀ"
  },
  "composer": "oa-person-000026",
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-bandhu-rupa-sakhi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ବନ୍ଧୁ ରୂପ ସଖୀ",
          "ଦେଖି ଆଖି ରହେ ଲାଖି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିରେ ତା ସେବତୀ ଚୂଳ ଭଲା ଦିଶଇ ମଞ୍ଜୁଳ",
          "ଅଳକା ଶୋହେ କପାଳ କେଉଁ ବିହି ନିର୍ମାଣିଛି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଧରେ ମୋହନ ବେଣୁ ବତ୍ସା ଘେନି ଆସେ ବନୁ",
          "ନୀଳମଣି ଜିଣି ତନୁ ଦେଖି ତ ମନ ଝୁରୁଛି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୟରେ ଶୋହେ ବାଜେଣୀ ବାଜୁଥାଏ କିଣିକିଣି",
          "ଶୁଣି ହୃଦ ହୁଏ ହାଣି କେ ଧଇର୍ଯ୍ୟ ପାରେ ରଖି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷଇ ଯେ ବନମାଳୀ ଏ ରସରେ ଭାଳି ଭାଳି",
          "ଦେଲା ମୋ ହୃଦୟ ଜାଳି ମଦନ ଶରକୁ ଯୋଖି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-bandhu-rupa-sakhi-banamali/"
    }
  ],
