{
  "id": "oa-gita-000689",
  "name": {
    "en": "Nabina bahana aau",
    "or": "ନବୀନା ବହନା ଆଉ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000150"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nabina-bahana-aau-todiparaja-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବୀନା ବହନା ଆଉ ଗୁମାନ",
          "ବିଅର୍ଥ ଗଲା ଏ ଦିନରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବେଶେ କରିବାକୁ ତୋରା ବନାଇଛି ଝରା",
          "କୁରଙ୍ଗୀ ନୟନା ହେଲୁ ଯା ବିମନା",
          "ବାଜି ବିରସ ପସରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମନ୍ଦେ ହସି ନାରୀ ରାଜ ବିରାଜ ମୋ କୋଳେ",
          "ଆରେ ବୀଣାଭାଷୀ କିଣା ଜନେ ରୋଷି",
          "ନୋହିଁ ଚୁମ୍ବ ଗଣ୍ଡସ୍ଥଳ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିପରୀତେ ମାତି ପୁହାଇବି ରାତି ବୋଲି",
          "କରିଥିଲି ଆଶା ତୁଟିଲା ଭରସା",
          "ସ୍ମର ଶରେ ଏବେ ମଲି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରଜରେ ଅବନୀକି ନ ଚିରରେ ବାଳା",
          "ଚନ୍ଦ୍ରମା ବଦନା ନ ହୋଇ ବିମନା",
          "ବାରେ ଚାହାଁ ଢାଳି ଡୋଳା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଖଡ଼ିଆଳ ଯୁବରାଜ ଶ୍ରୀ ବୀରବିକ୍ରମ",
          "ବୋଲଇ ଅଧୀର ହେଲା ଚିତ୍ତ ମୋର",
          "ବଞ୍ଚିବା କଥା ବିଷମ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nabina-bahana-aau-todiparaja-birabikrama/"
    }
  ],
