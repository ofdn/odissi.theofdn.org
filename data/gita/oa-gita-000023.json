{
  "id": "oa-gita-000023",
  "name": {
    "en": "Podu mo karama manda",
    "or": "ପୋଡ଼ୁ ମୋ କରମ ମନ୍ଦ"
  },
  "composer": "oa-person-000017",
  "mula_raga": [
    "oa-raga-000015"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/podu-mo-karama-manda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପୋଡ଼ୁ ମୋ କରମ ମନ୍ଦ ଗୋ । ପ୍ରିୟସଖି ।",
          "କିଏ ଯାଉନାହିଁ ଯମୁନାଜଳକୁ",
          "ମୁଁ ଗଲେ ଲାଗଇ ଦ୍ୱନ୍ଦ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପଡ଼ୁଅଛି ଡକା ଏ ବ୍ରଜରେ ଏକା",
          "ମୋ ନାମରେ ଅପବାଦ ଗୋ",
          "ସଡ଼ୁଅଛି ମୁହିଁ ମାତ୍ର ନାହିଁ ନାହିଁ",
          "କଲେ କି ହେବ ପସନ୍ଦ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜଡ଼ୁନାହିଁ କେହି ଏ ଗୋପରେ ସହି",
          "ଶୁଣି ଶ୍ୟାମ ବଂଶୀନାଦ ଗୋ",
          "ଲୋଡ଼ୁଛନ୍ତି ମୋର ଛିଦ୍ରଭେଦ ପରି",
          "କିଏ ଜାଣେ ଏତେ ଛନ୍ଦ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଛାଡ଼ୁନାହିଁ ପ୍ରାଣ ଏ ପିଣ୍ଡରୁ ଜାଣ",
          "କାହିଁକି ସହି ପ୍ରମାଦ ଗୋ",
          "ବଢ଼ୁଅଛି ମୋର ସନ୍ତାପସାଗର",
          "କି ନ କହଇ ନଣନ୍ଦ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯୋଡ଼ୁଅଛି କର ଏ ଶ୍ୟାମସୁନ୍ଦର",
          "ଲଭିବାରୁ ସେ ସମ୍ପଦ ଗୋ",
          "ଗଡ଼ୁଥିବ ଶିର ମୋର ନିରନ୍ତର",
          "ସେହି ନନ୍ଦସୁତ ପଦ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
