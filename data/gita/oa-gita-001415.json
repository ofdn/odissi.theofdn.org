    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସକଳ ଶୁଦ୍ଧ ସୁର ମଧୁର",
          "ମୂରଛନାରେ ଦେଇ ଭରି",
          "ଚତୁର ଗୁଣୀଜନ ସାଧ",
          "ଆଳାପି ରାଗ ବିଲାହରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନଟ ମେଳରେ ବାଦୀ ଗାନ୍ଧାର",
          "ରଖି ସଂବାଦୀ ଧୈବତ ସ୍ୱର",
          "ଦିବା ଦ୍ୱିତୀୟ ପ୍ରହରେ ଗାଅ",
          "ଜାତି ଔଡ଼ବ ସମ୍ପୂର୍ଣ୍ଣ କରି"
        ]
      }
    ]
  },
