{
  "id": "oa-gita-000565",
  "name": {
    "en": "Kene asilu mana rahi na jai",
    "or": "କେଣେ ଆସିଲୁ ମନ ରହି ନ ଯାଇ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kene-asilu-mana-rahi-na-jai-gopalakrusna-todi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଣେ ଆସିଲୁ ମନ ରହି ନ ଯାଇ",
          "ସମୟ ବଳିଯିବ ହେଲୁ କି ବାଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୋଷ୍ଠାଚଳ ଚନ୍ଦ୍ରମା ଶ୍ରୀ ବୃଷଭାନୁ ଜେମା",
          "ପଦାରବିନ୍ଦ ସେବା ତୁ ଛାଡ଼ିଦେଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିଭୃତ କୁଞ୍ଜରେ ତ ଅଳି କରିବେ ରୁତ",
          "ଡାକି କଖ୍‌ଖଟୀ ଏବେ ଦେବ ଉଠାଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ହୋଇଲେ ଅପହୁଡ଼ ଧରି କାଞ୍ଚୀ ପାହୁଡ଼",
          "ସ୍ୱାମିନୀ ଆଗେ ଯାନ୍ତୁ ପଥ କଢ଼ାଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୂର୍ଯ୍ୟ ପୂଜା ବେଳରେ ସ୍ୱାମିନୀ ଅଞ୍ଜଳିରେ",
          "ବେଗେ ଅର୍ଘ୍ୟ ନୀରେ ଦିଅନ୍ତୁ ବଢ଼ାଇ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନନ୍ଦପୁରକୁ ବିଜେ କଲେ ଗହଣେ ତୁ ଯେ",
          "ଥାଇ ପ୍ରାଙ୍ଗଣେ ପଦ ଦିଅନ୍ତୁ ଧୋଇ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ନାଗେଶ୍ୱର କୁଞ୍ଜରେ ଶ୍ରୀ ରତନ ଦୋଳାରେ",
          "ବିଜେକଲୁ ତୁ ଦେଖନ୍ତୁ ପହଞ୍ଚାଇ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ସାରି ଜଳଲୀଳାକୁ ବାସ ଲାଗି ହେବାକୁ",
          "ବସ୍ତ୍ରାଚରଣ କରନ୍ତୁ ପରା ଥାଇ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ସ୍ୱେଶ୍ୱରୀ ତୋର ହସ୍ତେ ବଂଶୀଦେଲେ ଗୁପତେ",
          "ଯତନେ ରଖିଥାନ୍ତୁ ପରା ଲୁଚାଇ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଶ୍ରୀମତୀ ଗୁମାନରେ ଲଳିତାଙ୍କ ପଦରେ",
          "ଜଣାନ୍ତୁ ଜଣାଣ ଶ୍ରୀ ଗୋବିନ୍ଦଙ୍କ ପାଇଁ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ପ୍ରାଣନାଥ ଛାମୁକୁ ବିଜେକଲା କାଳକୁ",
          "ଲୋଡ଼ିବେ ବେଗେ ଏବେ ଯାଅ ପଳାଇ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "କେତେ ପ୍ରହେଳି ଗାନ ଆହା ରାସ ନର୍ତ୍ତନ",
          "ଶ୍ରମ ନାଶିବୁ ଫୁଲପଙ୍ଖା ପକାଇ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ନାଗରେନ୍ଦ୍ର ଛାମୁରୁ ବୃନ୍ଦା ଆସୁ ଦୂରରୁ",
          "ସ୍ୱେଶ୍ୱରୀଙ୍କି ରହରେ ଦେବୁ ଭେଟାଇ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ନାରୀ ଶିର ଭୂଷାଙ୍କୁ ନାଗର ମୁକୁଟଙ୍କୁ",
          "ମୂରୁଛିଲୁ କିପରି ତୁ ନ ଲୋଭାଇ"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ମଧୁପାନ ଉତ୍ତାରେ ଜଗିଥାନ୍ତୁ ଲାଗରେ",
          "ପୁଧା ସଂଳାପ ଶୁଣି ହସିଲା ହୋଇ"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ନିକୁଞ୍ଜ ପ୍ରାଙ୍ଗଣରେ ଚନ୍ଦ୍ରମା କିରଣରେ",
          "ପ୍ରହେଳୀ କଉତୁକ ଶୁଣିଲୁ ନାହିଁ"
        ]
      },
      {
        "n": 16,
        "lines": [
          "ପଶାଖେଳ ବେଳରେ ସ୍ୱାମିନୀ ନ ବସିଲେ",
          "ବଳେ ଲଳିତା ଦେବେ ଧରି ବସାଇ"
        ]
      },
      {
        "n": 17,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭଣେ ପ୍ରାଣକୁ ତୋ ଗୃହେ",
          "ନିଅ ଭାବନା ଦେହ ଭିତରେ ଲାଇ"
        ]
      }
    ]
  },
