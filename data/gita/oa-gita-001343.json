    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-se-mohane-kaha-sabari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ସେ ମୋହନେ କହ ଯାଇ ଏତିକି ଗୋ",
          "କାହୁଁ ଶିଖିଲେ ଶ୍ୟାମ ଏ ଘରବୁଡ଼ା ରୀତିକି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମୋହନ ବଂଶୀ ବଜାଇ ଚେତନା ଦେଲେ ହଜାଇ",
          "କରି ଏତେ ଲୋକହସା ଦେଲେ ଅପଖ୍ୟାତିକି ଗୋ",
          "(ପଡ଼ି)",
          "ପ୍ରୀତି ରସେ ରସାଇଲେ ନିନ୍ଦା ହାଟ ବସାଇଲେ",
          "କୁଳ କଳଙ୍କିନୀ କରି ଲଭିଲେ କି ଖ୍ୟାତିକି ଗୋ"
        ]
      }
    ]
  },
