{
  "id": "oa-gita-000934",
  "name": {
    "en": "Ago radhe se mohane",
    "or": "ଆଗୋ ରାଧେ ସେ ମୋହନେ"
  },
  "composer": "oa-person-000130",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ago-radhe-se-mohane/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଗୋ ରାଧେ ସେ ମୋହନେ ମାନ କରୁ କାହିଁକି",
          "ମିଛେ ବୋଲୁ ମୁଁ ତାଙ୍କର ସତକୁ ବଞ୍ଚାଇ କି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିନ ମଧ୍ୟେ ଦିନଈଶ ପୂଜୁ ଯାହା ପାଇଁକି",
          "ଗଉରୀପ୍ରିୟରେ ପରା କରି ଜଳସାହିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୀଳ ଗଉର ସୁମନ ଗୁନ୍ଥୁ ଯାହା ପାଇଁକି",
          "ତାର ସ୍ନେହେ ରହିଥାଉ ମରକତ ବାହିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜଣାଅଛି ଯେବେ ଭଜିଥିଲୁ ଅବିବାହିକି",
          "ନାମ ଶୁଣି କଣ୍ଠହାର ଦେଇଛୁ ବଧାଇ କି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାହାର ମୁରଲୀ ଗୀତେ ଲଭୁ ସୁଖ ପାଇକି",
          "ମୋର କର ଧରି ପଠିଆଉ ତାର ତହିଁକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନିଜ ଜନେ ପର କଲେ ଏଥି ଯଶ ପାଇକି",
          "ଆପଣାର ବ୍ୟାଧି ହେଲେ ପରରେ ବଥାଇକି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କାମଦ ବଲ୍ଲରୀ ହୃଦେ ବାମ ଗୁଣ ଥାଇକି",
          "ସୁଧାକର ଚକୋରକୁ ଗରଳ ଚଖାଇକି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କମଳ ଚୁମ୍ବିବା ଅଳି କୂଟ ଯେ ନ ଯାଇକି",
          "ପୁଣି ତା ପାଶେ ଆସନ୍ତେ ସେ କରେ କି ନାହିଁକି"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ବୋଲେ ଶ୍ରୀଚନ୍ଦନ ଆହେ ରାଧେ ହେଲ ବାଇକି",
          "ଏ ରୀତିକି ଛାଡ଼ି ଭଜ ନବୀନ କହ୍ନାଇକି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ago-radhe-se-mohane/"
    }
  ],
