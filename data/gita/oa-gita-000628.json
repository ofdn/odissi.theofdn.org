{
  "id": "oa-gita-000628",
  "name": {
    "en": "Sari jibani jibane naba kisori",
    "or": "ସରିଯିବନି ଜୀବନେ ନବ କିଶୋରୀ"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000103"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sari-jibani-jibane-naba-kisori-regupta-tripata-jadumani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରିଯିବନି ଜୀବନେ ନବ କିଶୋରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନାଗରୀ ରତନେ ନିଷେଧଇ ଯତନେ",
          "ଉଡ଼େ ତୋ ସୁନ୍ଦରୀ ନାମ କେତନ ନୂତନେ",
          "ବଂଶୀ ନିଃସ୍ୱନରେ ଶ୍ରୀ ବୃନ୍ଦାବନରେ",
          "ଆଣି ଲଗାଇଲା ବିହି ପ୍ରତିଫଳ ପୁଣ୍ୟରେ ।",
          "(ପଡ଼ି)",
          "ଛାଡ଼ିଲା ନିକେତନ ଭ୍ରମେ ହେଲେ ପତନ",
          "କେତେ କଲେ ଯତନ ନୁହଇ ସଚେତନ",
          "ସ୍ୱର୍ଣ୍ଣ ଗାତ୍ର ବିବର୍ଣ୍ଣ ଚିତ୍ର",
          "ଚିତ୍ର ଦିଶୁଅଛି ନେତ୍ର",
          "ପ୍ରାନ୍ତରେ ପୂର୍ଣ୍ଣ କାତରେ ବିରହ କରତରେ",
          "କରତି ଦେଉଅଛି ଘୋର ଆର୍ତ୍ତରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶିରୀଷଦେହାକୁ ନ କରୁ ଆହାକୁ",
          "ପାଞ୍ଚିଲି କେହି ନାହିଁ ସାହାକୁ ଯାହାକୁ",
          "ପଲ୍ଲବ ଶୟନେ ଚାହିଁ ଏ ଅୟନେ",
          "ବଞ୍ଚଇ ଏକା ତବ ଗାୟନେ ।",
          "(ପଡ଼ି)",
          "ନୋହବାକୁ ବରତି ପକାଇଲ କରତି",
          "କର ଭଲ ପୀରତି ହେଲା ଆଚ୍ଛା କୀରତି",
          "କରଇ ତର୍ଜ୍ଜନ ଘୋର ଗର୍ଜ୍ଜନ",
          "ଗୁଣ ମାର୍ଜ୍ଜନ ମାରେ ଦୁର୍ଜ୍ଜନ",
          "କଞ୍ଜ ଖଞ୍ଜନ ନୟନୁ ଅଞ୍ଜନ",
          "ବାରି ମଜ୍ଜନେ ଦିଶେ ଅରଞ୍ଜନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଲ କି ଦାରୁଣ ପଣ ହେ ତରୁଣ",
          "ଶୁଣ ଯାଇ ଏବେ ସହୀର କରୁଣ",
          "ଅରୁଣ ଅତୁଲ୍ୟ ଚରଣେ ନ ରହି ରଣେ",
          "ସତ କେହି ବଳିଲା ହେ ତାହାର ମରଣେ ।",
          "(ପଡ଼ି)",
          "ଧନ୍ୟ ତୁମ୍ଭର ଗୁଣ ଚିହ୍ନି ଘେନିଲୁଁ ପୁଣ",
          "ଦୋଷକୁ କେତେ ଗୁଣ କରି ଯା ଦେଲ ପୁଣ",
          "ଫିଟିଛି କୁଟିଳ ନୀଳ କୁନ୍ତଳ",
          "ଲୋଟୁଛି ଭୂତଳ ଘୋଟିଛି ଦୁର୍ବଳ",
          "କଣ୍ଠ କପୋଳରୁ ସ୍ରବଇ ଶ୍ରମ ଜଳ",
          "ଘଡ଼ିକି ଘଡ଼ି ଛାଡ଼ି ନାଡ଼ୀ ହେଉଅଛି ମେଳ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତେଜ ଏ ରୀତିକି ଲାଜ ପୀରତିକି",
          "ମାନଧାତା ବାଣୀ ଆଣ ଶ୍ରୁତିକି",
          "ମତିକି ମଦନମୋହନ ନ ଗଲେ ବହନ",
          "କାହାର ହେବ ରାଧା ହେଲେ ଦହନ ।",
          "(ପଡ଼ି)",
          "ଆଜ ନିଶ୍ଚେ ପରାଣ ସଖୀ ପଞ୍ଚପରାଣ",
          "ନେବ ମଦନ ବାଣ ବୋଲି ଦେଉଛି ରାଣ",
          "ଗରଳବତ ମଣି ଅନ୍ନ ଭକ୍ଷଣ",
          "ବରଣ କରିଅଛି ମରଣ ଲକ୍ଷଣ",
          "ଅରକ୍ଷ ରକ୍ଷଣ କର କର ହେ ରକ୍ଷଣ",
          "ଶରଣ ଗଲି ବୋଲୁଅଛି କ୍ଷଣକୁ କ୍ଷଣ"
        ]
      }
    ]
  },
