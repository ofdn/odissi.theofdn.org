{
  "id": "oa-gita-000402",
  "name": {
    "en": "Ja ja mo pasu bahana he mohana",
    "or": "ଯା ଯା ମୋ ପାଶୁଁ ବହନ ହେ ମୋହନ"
  },
  "composer": "oa-person-000087",
  "mula_raga": [
    "oa-raga-000112"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ja-ja-mo-pasu-bahana-he-mohana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହେ ମୋହନ । ଯା ଯା ମୋ ପାଶୁଁ ବହନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାଣିଲି ତୋର ମତି ଦଗା ଦେବାର ରୀତି",
          "ଆଉ ନ ଭାଷ ବଚନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗତ କାଲି ରଜନୀ ହେଲି ମୁଁ ଏକାକିନୀ",
          "ରହିଲୁ କାହା ସଦନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କହୁ ଥାଉ ତୁ ପରା ଆରେ ମହତସରା",
          "ନ ସରୁ ଯୁବତୀ ଆନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏବେ କାର ବସନ କରିଛ ପରିଧାନ",
          "ଶ୍ରୀଅଙ୍ଗେ ଦିଶେ କି ଚିହ୍ନ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସେ ବିମ୍ବାଧରୁ ମଧୁ ପିଇଅଛି କେ ବଧୂ",
          "ଶୁଖିଛି ଚନ୍ଦ୍ରବଦନ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପୁଣି ସେ ଗଣ୍ଡଦେଶ ଲାଗି ତାମ୍ବୁଳ ରସ",
          "ହୋଇଛି କେଡ଼େ ଶୋଭନ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଛି ଛି ଏଡ଼େ ଲମ୍ପଟୀ ଦେଖି ନାହିଁ ମୁଁ ସୃଷ୍ଟି",
          "ଲଜ୍ଜା ନାହିଁ ତୋ ଲପନ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ଏପରି ତୁ କପଟୀ ଜାଣିଥିଲେ ମୁହିଂଟି",
          "ରସିଥାନ୍ତା କି ମୋ ମନ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଆଜିଠାରୁ ଶ୍ରୀପତି ତେଜିଲି ତୋ ପୀରତି",
          "ପଙ୍କଜ କରଇ ଧ୍ୟାନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ja-ja-mo-pasu-bahana-he-mohana/"
    }
  ],
