{
  "id": "oa-gita-000766",
  "name": {
    "en": "Syama sundara sange",
    "or": "ଶ୍ୟାମ ସୁନ୍ଦର ସଙ୍ଗେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000054"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-sundara-sange-kedaragouda-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ସୁନ୍ଦର ସଙ୍ଗେ",
          "କହିଥିଲି ରସନା ମଜ୍ଜିଲୁ ତ ତରଙ୍ଗେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖଣ୍ଡିଲୁ ସୁଖ ଆଣି ମଣ୍ଡି ଗଣ୍ଡରେ ପାଣି",
          "ଦଣ୍ଡି ହେଲୁ ଅନଙ୍ଗେ ଭଣ୍ଡିଲେ ସେ ଅନଙ୍ଗେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମନ୍ଦହାସ ତ ତେଜିଲୁ ଭାନୁନନ୍ଦୀ",
          "କହିଛି ତା ନ ହେଜିଲୁ",
          "ପ୍ରେମ ଶଠରେ ରଚି ହେମଅଙ୍ଗୀ ନ ବଞ୍ଚି",
          "ଯାମକୁ ଯାମ ସିନା କାମକାଣ୍ଡ ଭୋଗିଲୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରୀତି ଦୁର୍ଲ୍ଲଭ ଜନରେ ସୁଗତି",
          "ଅକୀର୍ତ୍ତି ହେଜିଲୁ ନାହିଁ ମନରେ",
          "ଘୋଷରେ ନନ୍ଦାତ୍ମଜ ଦୋଷ ଗୁଞ୍ଜର ବୀଜ",
          "ଘୋଷନ୍ତି ବ୍ରଜଜନେ ରୋଷ ନ କଲୁ ଦିନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ତା କହଇ ମୋହନ",
          "ସୁସ୍ମିତ ସାଧ୍ୱୀଙ୍କ ମତି ମୋହଇ",
          "ବୃଷଙ୍କୁ ତେଜି ଶଚୀ ବୃଷାସନଙ୍କୁ ମୁଞ୍ଚି",
          "ଚଞ୍ଚଳେ ଚଳେ ଶିବା ମଞ୍ଚରେ ଅଛି କେବା"
        ]
      }
    ]
  },
  "sources": [
