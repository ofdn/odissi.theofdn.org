{
  "id": "oa-gita-000210",
  "name": {
    "en": "Sahi re muhi bada dukhini",
    "or": "ସହିରେ ମୁହିଁ ବଡ଼ ଦୁଃଖିନୀ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahi-re-muhi-bada-dukhini-kaphi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହିରେ ମୁହିଁ ବଡ଼ ଦୁଃଖିନୀ",
          "କି କହିବି ମୋ ଅନ୍ତର କାହାଣୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆଲୋକ ବିଶ୍ରୁତ ମାଧୁରୀ ଯାର",
          "ଅନୁରତ ଚିତ୍ତ ସହିତା ପ୍ରତି ମୋର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିରନ୍ତର ଘର ଗମ୍ଭୀରି କୋଣେ",
          "ଆବଦ୍ଧ ହେଲି ସହି ଡରି ଗୁରୁଜନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରବାସକୁ ଯାନ୍ତି ଲୋକେ ଯେପରି",
          "ମୋ ପକ୍ଷେ ଦେହଳୀ ଦ୍ୱାର ସେପରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଶା ଉତ୍କଣ୍ଠା ଯାହା ପାଇଁକି",
          "କେତେ ବାଧା ବିଘ୍ନ ପଡ଼େ ତହିଁକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏଣେ ଗୁରୁଜନ ସର୍ବେ ବଇରୀ",
          "ବିଡ଼ମ୍ବନା ଗ୍ରନ୍ଥା ମୁଁ କୁଳନାରୀ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶୁଣି ସ୍ୱାମିନୀଙ୍କ କାତର ବାଣୀ",
          "ବୋଧେ ଗୋପାଳକୃଷ୍ଣ ଯୋଡ଼ି ବେନି ପାଣି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahi-re-muhi-bada-dukhini-kaphi-gopalakrusna/"
    }
  ],
