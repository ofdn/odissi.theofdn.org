  "id": "oa-gita-000290",
  "name": {
    "en": "Na tejibi muralidhara",
    "or": "ନ ତେଜିବି ମୁରଲୀଧରା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-tejibi-muralidhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ ତେଜିବି ମୁରଲୀଧରା",
          "ବାଜୁ ପଛେ ଅପବାଦ ନାଗରା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାନ୍ଧବୀ ମୋ ଚରିତ ଗାଇ",
          "ହସନ୍ତୁ ବା ତାଳି ବଜାଇ",
          "ଯେ କହିବ ସିନା ମନ ଭଙ୍ଗାଇ",
          "କିଏ ଦେବ ଶ୍ୟାମ ପ୍ରୀତି ଲଗାଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୟନ ମୋ ପ୍ରେମ ଇଙ୍ଗିତ",
          "ଭଙ୍ଗୀ ସଙ୍ଗୀ ହେବାରୁ ମିତ",
          "ଅବିହିତକୁ ମୁଁ ମଣେ ବିହିତ",
          "କି କରିବେ ପରଲୋକ କହି ତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୁରୁ ଗୁରୁଜନ ଗଞ୍ଜଣା",
          "ଦେଲେ ଦେବେ ପଛକେ ସିନା",
          "ଏକା ଶ୍ୟାମବନ୍ଧୁ ସଙ୍ଗ କାମନା",
          "ହେଲେ ହେବି ଜାତି ପାଟକେ ମନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ କହେ ଏ ଗିର",
          "ମୋହନ ମୋ ହୃଦୟ ହାର",
          "ଏ ପରାଣ ମନ କିଣା ଯାହାର",
          "ତା ସ୍ନେହରୁ କି ମୁଁ ହେବି ବାହାର"
        ]
      }
    ]
  },
  "sources": [
