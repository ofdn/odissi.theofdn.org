  "name": {
    "en": "Bhaba tarana karana narayana",
    "or": "ଭବ ତାରଣ କାରଣ ନାରାୟଣ"
  },
  "composer": "oa-person-000008",
  "mula_raga": [
    "oa-raga-000030"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhaba-tarana-karana-narayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭବ ତାରଣ କାରଣ ନାରାୟଣ",
          "କର ନାମ ନିରନ୍ତର ପାରାୟଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପରମାନନ୍ଦ ଭଜ ଗୋବିନ୍ଦ",
          "ଶାନ୍ତି ସୁଧାରସ ଧାରାୟଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପରମ ପ୍ରେମ ପରମାରାମ",
          "ସାଧୁ ସନ୍ଥ ଭକ୍ତପରାୟଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୂରଣ ବ୍ରହ୍ମ ପ୍ରାଣ ଆରାମ",
          "ଶକ୍ତି ଭକ୍ତି ମୁକ୍ତି ସନ୍ଧାୟନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନିର୍ଭେଦ ଧର୍ମ ନିଷ୍କାମ କର୍ମ",
          "ତାରିଣୀର ଲକ୍ଷ୍ୟ ସାରାୟନ"
        ]
      }
    ]
  },
  "sources": [
