{
  "id": "oa-gita-000823",
  "name": {
    "en": "Gheri gheri kalia ghana",
    "or": "ଘେରି ଘେରି କାଳିଆ ଘନ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000048"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gheri-gheri-kalia-ghana-chhayanata-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘେରି ଘେରି କାଳିଆ ଘନ ଘାରିଲା ସହି",
          "ବାସି ହେଲା ତ ଫୁଲହାର ତା ପଥ ଚାହିଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମରମେ ମରେ ତାରେ ଝୁରି ଝୁରି ସଜନୀ",
          "ନୟନେ ନିଶିଦିନ ନୀର ଘର କଲାଣି",
          "ଚପଳା ହସେ ଘନେ ମୋତେ ଅନାଇଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାହିଁକି ସରଜିଲା ବିଯୋଗୀ ଏ ଜଗତେ",
          "ଧିକ ପୋଡ଼ା ଦଇବ ଧିକ ବିଧାନ ସତେ",
          "ଟାପରା କରେ ପରା ବନ ବରହୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆନ ମୁଁ ଦେଇଥିଲି ସଖୀ ସପତ ବାର",
          "ଆନ କଲେ ବଚନ ସେ ଗୋ ବାରକୁ ବାର",
          "ମୋ ସରି ଦୁଃଖିନୀ କେ ଅଛି ଏ ମହୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
