{
  "id": "oa-gita-000020",
  "name": {
    "en": "Kulasila chhadili",
    "or": "କୁଳଶୀଳ ଛାଡ଼ିଲି"
  },
  "composer": "oa-person-000017",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kulasila-chhadili/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁଳଶୀଳ ଛାଡ଼ିଲି",
          "ଶ୍ୟାମେ ଅନାଦର ହେବି ବୋଲି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବଳ କଲି ମନେ ଖଳକୁ ବଚନେ",
          "ନିଜ ଜନ କେ ତେଜିବ ଗୋ",
          "ସ୍ଥଳ ବିଶେଷରେ ବିପରୀତ ଫଳ",
          "କି ଅଦୃଷ୍ଟ ମୋର ଭାବ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହସାଇବେ ପର ବସାଇ ପାଶର",
          "ଏହା ମୁଁ ଜାଣି ନ ଥିଲି ଗୋ",
          "ଦଶା ଅବଳରୁ ସିନା କଳ୍ପତରୁ",
          "ସେବି ଯାତନା ଲଭିଲି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦିନେ ହେଲେ ପୁଣି ସାରାସାର ସବୁ",
          "ମନକୁ ମନ ବୁଝିବ ଗୋ",
          "କାନେ କହି ଯେହୁ ପ୍ରୀତି ଭେଦ କଲା",
          "କେଉଁ ସୁଖ୍ୟାତି ଅର୍ଜ୍ଜିବ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଖା ହୋଇ କରି ମଧୁ ଉପକାରୀ",
          "ହେବେ ବୋଲି ମନେ ଥିଲା ଗୋ",
          "ପ୍ରକାଶନ୍ତେ ସିନା ଅନ୍ତରଙ୍ଗ ଗୁଣ",
          "ବହିରଙ୍ଗରେ ମଜ୍ଜିଲା ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯେତେ ଯେତେ ପରାଭବ ଦେଲେ ହେଲେ",
          "ତାଙ୍କ ଲାଗି ଜୀବ ଯିବ ଗୋ",
          "କେତେ ନିଷ୍ଠୁର ହୃଦୟ ଶ୍ୟାମବନ୍ଧୁ",
          "ଠାରେ ସବୁ ଜଣାଯିବ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
