{
  "id": "oa-gita-000392",
  "name": {
    "en": "Na sare mo dina dinabandhu lagi",
    "or": "ନ ସରେ ମୋ ଦିନ ଦୀନବନ୍ଧୁ ଲାଗି"
  },
  "composer": "oa-person-000084",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-sare-mo-dina-dinabandhu-lagi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ ସରେ ମୋ ଦିନ ଦୀନବନ୍ଧୁ ଲାଗି ।",
          "ଦୀନ ଚାତକିନୀ ଏ ଦିବା ରଜନୀ",
          "ବସିଛି ପଥ ଜଗି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୁନ୍ଥିବାକୁ ଦିନ ହେବ ଗୋ ସୁଦିନ",
          "ଦୀନବନ୍ଧୁ ଯେବେ ଦେବେ ଦରଶନ",
          "ଏ ଦିନ କି ଯାଇ ହୋଇବ ସେ ଦିନ",
          "ସୁଖ ସମ୍ପଦ ଭୋଗୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଞ୍ଜବନ ତେଜି କୁଞ୍ଜ ବିନୋଦିଆ",
          "ହରିଣୀନେତ୍ରୀକି କଲେ ଯା ନିର୍ଦ୍ଦୟା",
          "ମଞ୍ଜୁ ଗୁଞ୍ଜମାଳ ଗୁନ୍ଥିଅଛି ନୂଆ",
          "କିଏ ହୋଇବ ଲାଗି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜଳ ନ ପାଇଣ ମୀନ ଯେହ୍ନେ ଜଳେ",
          "ବନ ଦାବାନଳେ ବନ ଯେହ୍ନେ ଜଳେ",
          "କୃଷ୍ଣ ଖେଦାନଳେ ବିରହିଣୀ ଜଳେ",
          "ଜଳ ବିନା ଅଭାଗୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ କୁଳ ସେ କୁଳ ଗଲା ବେନି କୁଳ",
          "ନିରତେ ଆକୁଳ ହୁଅଇ ଗୋକୁଳ",
          "କହେ ହୃଦାନନ୍ଦ ଏ ଯମୁନା କୂଳ",
          "ଗୋକୁଳେ ହେବି ଯୋଗୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-sare-mo-dina-dinabandhu-lagi/"
    }
  ],
