{
  "id": "oa-gita-000663",
  "name": {
    "en": "Radhika pasaku chala bahana",
    "or": "ରାଧିକା ପାଶକୁ ଚଳ ବହନ"
  },
  "composer": "oa-person-000076",
  "mula_tala": [
    "oa-tala-000009"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhika-pasaku-chala-bahana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହେ ମୋହନ ରାଧିକା ପାଶକୁ ଚଳ ବହନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଦନାନଳ ପ୍ରବଳ ମିଶି ବିରହ ଅନଳ",
          "ମୋ ସଖୀ ଅଙ୍ଗ ହେଉଛି ଦହନ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅର୍ଦ୍ଧେକ ଯମୁନା ଜଳ ଅର୍ଦ୍ଧେକ ପଡ଼ିଛି କୂଳ",
          "ଏବେ ସରିଲାଟି ପ୍ରେମ ବିହନ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁମ୍ଭ ପାଦେ ଆଶ୍ରେ କରି ଏହା ଅର୍ଜ୍ଜିଲା କିଶୋରୀ",
          "ଏବେ ହରାଇଲା ପ୍ରାଣ ବହନ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରସରାୟେ ଏହା ଶୁଣି ମୃତ୍ୟୁ ସଞ୍ଜୀବନୀ ଗୁଣି",
          "ଶୀଘ୍ରେ ଚଳ କବିସୂର୍ଯ୍ୟ ବହନ ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhika-pasaku-chala-bahana/"
    }
  ],
