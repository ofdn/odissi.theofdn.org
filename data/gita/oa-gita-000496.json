  "name": {
    "en": "Bandhabi jana re",
    "or": "ବାନ୍ଧବୀ ଜାଣରେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000076"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bandhabi-jana-re-kabichandra-kanada/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାନ୍ଧବୀ ଜାଣରେ",
          "ମାନ ନ କର ଗୋରୀ ଚାରୁ ବିମ୍ବାଧରୀ",
          "ବାମ ହେଲୁ ତୁ କାମବାଣ ନେବଟି ପ୍ରାଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଖି ଏ କି ତୋ ରୀତି ଆଜ ରେ ଗଜଗତି",
          "ହୋଇ ଗୁମାନବତୀ ବସିଛୁ ମଥା ପୋତି",
          "(ପଡ଼ି)",
          "ତୋ ବିନା ମୋ ଅରାତି ହେଲା ଏ ଶଶି ରାତି",
          "ବୋଲାଇ ଦୟାବତୀ ଏ କି ଅପକୀରତି",
          "ତାର ତାର ମାରେ ମାର ଆନ ମାନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହୋଇ ସୁଜାଣମଣି ରସିକା କୁତୁକିନୀ",
          "ନଖେ ଚିରୁ ମେଦିନୀ ନୟନେ ଭରି ପାଣି",
          "(ପଡ଼ି)",
          "ଛାର କଥାରେ ରୁଷା ସାର କଲୁରେ ଯୋଷା",
          "ବରବରନା ଆଶା ଭରସା ତୁ ନ ଭସା",
          "ଦାସ ଦୋଷ ନାଶ ଆସ ଜୀବଧନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଉ ଏଣିକି କେବେ ଟାଳିବି ତୋତେ ଯେବେ",
          "ନ ଚାହିଁ ମୋତେ ଲବେ ଦଣ୍ଡିବୁ ରାମା ତେବେ",
          "(ପଡ଼ି)",
          "କବିଶଶୀ ବଦତି ଆସ ଆସ ମୋ କତି",
          "ସୁରପୁର ସମ୍ପତ୍ତି ପାତି ରଖିଛି ଛାତି",
          "ପାଶେ ବସ ରସି ଭାଷ ତୋଷ ମନ"
        ]
      }
    ]
  },
  "sources": [
