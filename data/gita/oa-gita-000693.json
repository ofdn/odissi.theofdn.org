{
  "id": "oa-gita-000693",
  "name": {
    "en": "Ebe janibu kede bisama",
    "or": "ଏବେ ଜାଣିବୁ କେଡ଼େ ବିଷମ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000171"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ebe-janibu-kede-bisama-suratha-mallara-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଏବେ ଜାଣିବୁ କେଡ଼େ ବିଷମ ସେ ଶ୍ୟାମ ପୀରତି",
          "ରସି ବଂଶୀ ନାଦରେ ଥିବାର ଉନ୍ନିଦ୍ରରେ",
          "ନୀଳ ପଦ୍ମ ସାଦରେ ଲଗାଇବା ହୃଦରେ",
          "(ଝୁ)",
          "ଏହା ନ କର ବୋଲି ତୋତେ ଯେତେ କହିଲି",
          "କିଞ୍ଚିତେ ଚିତ୍ତେ ହେଲେ ନ ଘେନିଲୁ ଛଇଳୀ",
          "ନବଘନ ସୁନ୍ଦର ଛବିକି ଗଲୁ ଭୁଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଛଳି ପ୍ରଶଂସି ଆଳି ଭାବିକି ମନେ କେଳି",
          "କଦମ୍ବ ତଳ ଧୂଳି ଅଙ୍ଗେ ହେବାର ବୋଳି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଳିନ୍ଦସୁତା ତଟେ ନୀପ ଛାଇ ନିକଟେ",
          "ମିତ୍ର ପୂଜିବା ହଟେ ବସିବାର ଲମ୍ପଟେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏକାକୀ ହୋଇ ବରବରନା ବାରବାରେ",
          "ନିକୁଞ୍ଜ କାନନର କୁସୁମ ତୋଳିବାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହିତ କହିବା ମୋର ମିତ ଯା କଲୁ ଦୂର",
          "ସତ କି ମିଛ ବୀରବିକ୍ରମ ଦେବ ଗିର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
