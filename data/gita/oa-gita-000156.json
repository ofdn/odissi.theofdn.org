{
  "id": "oa-gita-000156",
  "name": {
    "en": "Bhasiliti asi darahasi",
    "or": "ଭାସିଲିଟି ଆସି ଦରହାସୀ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000072"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bhasiliti-asi-darahasi-thare-rakha-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଭାସିଲିଟି ଆସି ଦରହାସୀ ଥରେ ରଖ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିଧୂବନ ବିଚକ୍ଷଣା । ଜାଣି ତୋ କରୁଣା ଉଣା ।",
          "ମାରି ଗିରୀଶାରି ମୋତେ ସାରିଦେଲା ଦେଖ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶରଣ ତୁହିଟି ବୋଲି । ଚରଣକଞ୍ଜ ଧଇଲି ।",
          "ଚାହିଁଲୁ ଯା ନାହିଁ ଧନ କାହିଁକି ଏ ଦୁଃଖ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନ ଶୁଣି ମୋ ଚାଟୁ ବାଣୀ । ଗଣ୍ଡଦେଶେ ମଣ୍ଡି ପାଣି ।",
          "ଭୀରୁ କି ମତରୁ ମହୀ ଚିରୁଅଛୁ ନଖରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଧରୁଛି ପଲ୍ଲବ କର । ଏବେ କୃପା ଲବ କର ।",
          "ହାସ ସମୁଲ୍ଲାସ ପରକାଶ ବିଧୁମୁଖରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆରେ ନବୀନ ବନିତା । ଲଗାଇଣ ପ୍ରୀତିଲତା ।",
          "କାଟି ପକାନାଟି ସେ ଏକାଠି ସବୁ ସୁଖ ରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଅଷ୍ଟଦୁର୍ଗନାଥ ଶରେ । କଷ୍ଟ ନାଶି ହସି ଦରେ ।",
          "ଧରାଶିରହୀରା ଆସି ବିରାଜିଲା ପାଶରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
