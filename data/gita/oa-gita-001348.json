{
  "id": "oa-gita-001348",
  "name": {
    "en": "Anusarita prabhu kala jaka",
    "or": "ଅନୁସରିତ ପ୍ରଭୁ କାଳ ଯାକ ଗଲା ସରିତ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/anusarita-prabhu-kala-jaka-gopalakrusna-bhairabi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନୁସରିତ ପ୍ରଭୁ କାଳ ଯାକ ଗଲା ସରିତ",
          "କଣ ବିତରଣ କଲେ କେତେ ଉଣା",
          "ହୁଅନ୍ତା କରୁଣା ସରିତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଶରଣ ଜନ ବନ୍ଧୁ ପଣ ଯଶ",
          "ସଂସାରେ ହୋଇଛ ଉଦିତ",
          "ପଥର ହୋଇ ପଥରେ ପଡ଼ିଥିଲା",
          "ଅହଲ୍ୟାକୁ ଦେଲ ତାରିତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପାଞ୍ଚିଳୀକି ଦୁଃଶାସନ ଘଞ୍ଚାଳିଲା",
          "ବଞ୍ଚାଇଲ ବାସ ଦେଇତ",
          "ଘୁଞ୍ଚାଇଲ ନାହିଁ ମୋ ଛାର କଦନ",
          "ପୋଛାଇଲ ନେତ୍ରୁ ବାରି ତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାହିଁ ଥିଲା ଚକ୍ର କାହିଁ ଥିଲା ନକ୍ର",
          "ପଲକ ପତନ ନୋହୁ ତ",
          "ଛିଡ଼ିଗଲା ମଥା ରହିଗଲା କଥା",
          "ଡାକିଲା ମାତ୍ର କରୀ ତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାଳକିଙ୍କର ଭୟରେ ଅଜାମିଳ",
          "ପୁତ୍ରୋପଚାରରେ ଡାକି ତ",
          "ପରମ ପଦ ପାଇଲା ଆପଣଙ୍କ",
          "ନାମ ମହିମା ଏପରି ତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନିରୁପାଧି କୃପାକର ବୋଲି ବିଧି",
          "ଭବାଦିରେ ଆଉ କଥିତ",
          "ମୁଁ କଲା ଦୋଷ କି ନାଶିଛ କି",
          "ବକୀ ପିଆଉଁ ତା ଦୁରିତ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହେ ଜଗନ୍ମଙ୍ଗଳ",
          "ଯାହା କରିବ ତୁମ୍ଭ ଚିତ୍ତ",
          "ଆପଣା କୃପାଳୁପଣକୁ ବଳି ମୋ",
          "ଦୁଷ୍କୃତ ନୁହଇ ଭାରି ତ"
        ]
      }
    ]
  },
  "sources": [
    {
