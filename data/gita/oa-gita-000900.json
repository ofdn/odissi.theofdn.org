{
  "id": "oa-gita-000900",
  "name": {
    "en": "Kahinki mana mohane",
    "or": "କାହିଁକି ମାନ ମୋହନେ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000164"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinki-mana-mohane-sena-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ମାନ ମୋହନେ",
          "କିଶୋରୀ ଗୋରୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରୂପ ତୋ ସୁମରି ପୀତବାସ ହରି",
          "ତୋ ଲାଗିରେ ପରା ସେ ମୁରଲୀଧରା",
          "ଯମୁନାର ତୀରେ ଥାଏ ଅନୁସରି ଝୁରିଝୁରି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରଗତ ମଣି କାଚକଣି ମଣି",
          "ନ ଦିଅ ତୁ ଫିଙ୍ଗି ଆରେ ଜୀବସଙ୍ଗୀ",
          "ହେବୁ ସିନା ପଛେ ଶ୍ୟାମ ଲାଗି ଘାରି ଝୁରିଝୁରି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କବିଚନ୍ଦ୍ର ବୋଲେ ଦୂରେ ଥିଲେ ହେଲେ",
          "ଯେ ଯାର ସେ ତାର ଯାଏ କି ପାଶୋର",
          "ବିରହେ ନୟନୁ ପଡ଼େ ବାରି ଝରି ଝୁରିଝୁରି ରେ"
        ]
      }
    ]
  },
  "sources": [
