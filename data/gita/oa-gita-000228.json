{
  "id": "oa-gita-000228",
  "name": {
    "en": "Saja aja tu saja re",
    "or": "ସାଜ ଆଜ ତୁ ସଜରେ"
  },
  "composer": "oa-person-000035",
  "mula_raga": [
    "oa-raga-000045"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/saja-aja-tu-saja-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଜ ଆଜ ତୁ ସଜରେ । ରାଜୀବନୟନା ।",
          "ରାଜିବୁ ଯିବୁ କୁଞ୍ଜରେ ।",
          "ମାନ ଗୁମାନ ମାନ ମାନସରୁ ତେଜ",
          "କାଶ ବିକାଶ ହାସ ଧୀରେ ଅଧରେ ସୃଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେଶେ କୁସୁମ ସମ୍ଭାଳି । ପରାଣ ଆଳି ।",
          "ଖଞ୍ଜିବୁ ମଞ୍ଜୁଳେ ବାଳୀ ।",
          "ଚାମର ଜିଣି କାନ୍ତି ଚାରୁ ଚିକୁରପନ୍ତି",
          "ଫିଟି ଲୋଟିବ କ୍ଷିତି ତୁଟିବ ଯେବେ ଧୃତି ।",
          "(ପଡ଼ି)",
          "ମାର ଉତ୍ସବରେ ବାରବାର ଧୀରେ",
          "ସାରସାକ୍ଷୀ ମଜ୍ଜି ସାର ଉତ୍ସବରେ",
          "ଛାର ହୃଦଖେଦ ଭାର ଫିନ୍ଦି ଦୂରେ",
          "ଗାର କରଜର ହାର କରିବୁ ଉରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୁକୁତା ମୋତି ଭୂଷଣ । ସୁଜାଣ ଜାଣ ।",
          "ପିନ୍ଧିବୁ ବାନ୍ଧିବୁ ଟାଣ ।",
          "ଚେତନା ଛାଡ଼ି ବଳେ ବିଭୋର ହେଲା ବେଳେ",
          "ଅଳଙ୍କାର ଚଞ୍ଚଳେ ଛିଡ଼ି ପଡ଼ିବ ତଳେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୟରେ ଖଞ୍ଜି ନୂପୁର । ମଞ୍ଜୁ ମଞ୍ଜୀର ।",
          "ରଚିବ ରୁଚିର ସ୍ୱର ।",
          "ଯତ୍ନେ ସଜାଡ଼ି ଭିଡ଼ି ପିନ୍ଧିବୁ ନୀଳଶାଢ଼ୀ",
          "ବୁଦ୍ଧି ନ ଯିବୁ ହୁଡ଼ି ବନ୍ଧୁରେ ଗଲେ ଜଡ଼ି"
        ]
      }
    ]
  },
  "sources": [
