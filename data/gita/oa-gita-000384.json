{
  "id": "oa-gita-000384",
  "name": {
    "en": "Kahuthili ago radhe na ghenilu mana",
    "or": "କହୁଥିଲି ଆଗୋ ରାଧେ ନ ଘେନିଲୁ ମନା"
  },
  "composer": "oa-person-000091",
  "mula_raga": [
    "oa-raga-000068"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahuthili-ago-radhe-na-ghenilu-mana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହୁଥିଲି ଆଗୋ ରାଧେ ନ ଘେନିଲୁ ମନା",
          "ବାଟ ଜଗି ଘାଟ ମାଗେ ନନ୍ଦପୁଅ କହ୍ନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁନ୍ଦରୀ ବ୍ରଜ ରମଣୀବୃନ୍ଦ ମଧ୍ୟେ ଶିରୋମଣି",
          "ମୁଁ ଦୟିନୀ କରୁଛି ତୁ ନ ଯିବୁ ଯମୁନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୋତେ ଦେଖିବାକୁ ମନ ହେଉଥାଇ ପ୍ରତିଦିନ",
          "ପଥେ ଜଗି ବସିଅଛି ସେ ଛଇଳ କହ୍ନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଲୁ ତାକୁ ହୃଦେ ହାର ହେଲୁ କୁଳରୁ ବାହାର",
          "ବାଜୁଅଛି ବଂଶୀସ୍ୱନେ ବୃନ୍ଦାବନେ ତୋ ନାଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମାନଗୋବିନ୍ଦ କହଇ ମାନ କଲେ ନ ରହଇ",
          "ତା ନୟନମୁନ ବାଜି ହୋଇଯାଏ ଚୂନା"
        ]
      }
    ]
  },
  "sources": [
