{
  "id": "oa-gita-000308",
  "name": {
    "en": "Sakhi re aha ki karma kali",
    "or": "ସଖୀ ରେ ଆହା କି କର୍ମ କଲି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-re-aha-ki-karma-kali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ରେ ଆହା କି କର୍ମ କଲି",
          "ଦାରୁଣ ମାନ ଯା ଅର୍ଜ୍ଜି ବସିଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ଶ୍ୟାମନାଗର ଆସି ମୋ ପାଶେ",
          "କେତେ ବିନୟୀ ହେଲେ ନିଶି ଶେଷେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅନାଦର କରି ଯା ନ ଚାହିଁଲି",
          "ରୋଷେ ଆହା କର ଛିଞ୍ଚାଡ଼ି ଦେଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି ନିଷ୍ଠୁର ଛାତି ଏହା ସହିଲା",
          "ପ୍ରାଣନାଥ ବୋଲି ଦୟା ନୋହିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ବୋଲେ ସନ୍ତାପୀ ନୁହଁ",
          "କାହାର କି ଦୋଷ ଏଥିରେ କହ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
