{
  "id": "oa-gita-000166",
  "name": {
    "en": "Rati pahi gala he hati",
    "or": "ରାତି ପାହିଗଲା ହେ ହାତୀ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rati-pahi-gala-he-hati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାତି ପାହିଗଲା ହେ ହାତୀ",
          "ହୁଅ ଅପହୁଡ଼ ତେଜ ସୁପାତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେମ ହେଲା ଉରମୁକୁତା",
          "ପାନ କଳ ଲାଗିଲା ପିତା",
          "କରଟ କୁମ୍ଭାଟ ଚମକି ରଟନ୍ତି",
          "ରାଜିଲା ଅରୁଣ କିରଣ କାନ୍ତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଛୁଇଁ ଗଙ୍ଗଶିଉଳି ବନ",
          "ବହିଲାଣି ମୃଦୁ ପବନ",
          "ରଥାଙ୍ଗ ଦମ୍ପତ୍ତି ହୃଦୟରୁ କିଛି",
          "ଦୂର ହୋଇଲାଣି ବିରହ ତାତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିଳସିଲେ କୁମୁଦ ନିଦ",
          "ଅଳିକୁଳ ହେଲେ ପ୍ରମୋଦ",
          "ଲାଗିଲାଣି ଭୟ ସଙ୍ଗିନୀ ନିଶ୍ଚୟ",
          "ଇଙ୍ଗିତରେ ଘେନି ଯିବେ ମୋ ଜାତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନ ମୋର ଧୃତି ନ ଟଳୁ",
          "ଧନ ମୋତେ ମେଲାଣି ମିଳୁ",
          "ରାଧା ନନ୍ଦସୁତ ମାତିଲେ ବୋଲି ତ",
          "ତୁଚ୍ଛାକୁ ଏ ବ୍ରଜମଣ୍ଡଳେ ଖ୍ୟାତି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଜଳନ୍ତର ଭୂପତି କହେ",
          "ଅଙ୍ଗରାଗ ଅଛି ମୋ ଦେହେ",
          "ଅତି ସେ ନ ଜରୁ ହେମ ଉରୋଜରୁ",
          "ଶିଥିଳାଇ ଦିଅ ଅଳପ ଛାତି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
