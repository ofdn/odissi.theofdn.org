{
  "id": "oa-gita-000019",
  "name": {
    "en": "Chandrabadani rama",
    "or": "ଚନ୍ଦ୍ରବଦନୀ ରାମା"
  },
  "composer": "oa-person-000016",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chandrabadani-rama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚନ୍ଦ୍ରବଦନୀ ରାମା",
          "ରସେ ରସାଉ କି ନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦଣ୍ଡକ ମଦନରେ ଦେଲା କେତେ ଦଣ୍ଡ",
          "କାଣ୍ଡ ତୂଣୀରୁ କାଢ଼ି କାଟୁଅଛି ପିଣ୍ଡ",
          "ଗଣ୍ଡରୁ କର ତେଜି ଚୁମ୍ବନ ମଣ୍ଡ",
          "ଭଣ୍ଡନା ଅନାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅନ୍ତର କଲେ ମୁଁ ଯେ ହୋଇବି କାହାର",
          "କର ଧରି କହୁଅଛି ଶୁଣ ରାମାବର",
          "କାତର ଦେଖି ମୋର ଚିତ୍ତେ ଦୟା କର",
          "ଗୁମାନୀ ହୋ ନାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦ୍ୱନ୍ଦ ଲଗାଇ ତୁ ମନ୍ଦ ମନ୍ଦ ହସ",
          "ଛନ୍ଦ ଦେଇ ଗଳାରେ ବାନ୍ଧ ବାହୁପାଶ",
          "ଅନ୍ଧକାର ଦିଶିଲାଣି କନ୍ଦର୍ପର ତ୍ରାସ",
          "କେ କଲା ମନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସାର କରି କଥାଏ ନ କହିଲୁ ମୋତେ",
          "ହାର କରି ଗଳାରେ ବାନ୍ଧିଥିଲି ତୋତେ",
          "ବାରମ୍ବାର ଭୀମଦେବ କହଇ ଏ ଗୀତେ",
          "ଶ୍ରୀଫଳ ସ୍ତନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
