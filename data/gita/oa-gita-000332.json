{
  "id": "oa-gita-000332",
  "name": {
    "en": "Pachara sahi go",
    "or": "ପଚାର ସହି ଗୋ"
  },
  "composer": "oa-person-000044",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pachara-sahi-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପଚାର ସହି ଗୋ ତାଙ୍କ ଆନକୁ",
          "ମୋହ ରାଣକୁ ଦେଇ",
          "ଏପରିରେ ଯେବେ ଥିଲା ତାଙ୍କ ମନେ",
          "କିମ୍ପା କହୁଥିଲେ ମୁରଲୀକି ଛୁଇଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କନ୍ଦର୍ପ ସୁନ୍ଦର ରୂପକୁ ଚାହିଁ",
          "ବନ୍ଦୀ କଲା କେଉଁ ଚନ୍ଦ୍ରମାମୁହିଁ",
          "ଛନ୍ଦ କରି କାହା ମନ୍ଦିରେ ରହିଲେ",
          "ମନ୍ଦପଣ ମୋର ଦେଖାଇବେ ବୋଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆସିବା ନିଶ୍ଚୟ ଜାଣି ତାଙ୍କର",
          "ନିଶିଯାକ ଏହି ପରି ବେଭାର",
          "ରସି କରାଇବା କେଡ଼େ ସମ୍ଭାର",
          "ବାସି କରାଇଦେଲେ କାହିଁକି ବୋଲି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଛାଡ଼ିଦେଇ ଲାଜ କୁଳ ଭୀତିକି",
          "ଜଡ଼ିଗଲି ଶ୍ୟାମବନ୍ଧୁ ପ୍ରୀତିକି",
          "ଏଡ଼ିଦେଇ ତାଙ୍କୁ ଅନ୍ୟ ଯୁବତୀକି",
          "ଲୋଡ଼ିବାରୁ ସିନା ହେଲି ଏବେ ସରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜଗନ୍ନାଥ ଦେବ ଭାଷି କହନ୍ତି",
          "ମୋ ପୁରକୁ କିମ୍ପା ନଇଲେ ଦୂତୀ",
          "କାହା ପୁରେ ମାତି କଟାଇଲେ ରାତି",
          "ଭଗାରିଙ୍କ ମୁଖେ ହସାଇବେ ବୋଲି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପାଠାନ୍ତର :",
          "ଲକ୍ଷ୍ମୀନାରାୟଣ ଦେବ ଭାଷନ୍ତି",
          "ରାଗରେ ଦୂତୀକି କହେ ଶ୍ରୀମତୀ",
          "ଜାଗରେ ପୁହାଇଦେବାର ଏ ରାତି",
          "ଭଗାରିଙ୍କ ମୁଖେ ହସାଇବେ ବୋଲି"
        ]
      }
    ]
  },
  "sources": [
