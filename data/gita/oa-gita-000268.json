{
  "id": "oa-gita-000268",
  "name": {
    "en": "Akarane dukhi re ajanma sukhi",
    "or": "ଅକାରଣେ ଦୁଃଖୀରେ ଆଜନ୍ମସୁଖୀ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/akarane-dukhi-re-ajanma-sukhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅକାରଣେ ଦୁଃଖୀରେ ଆଜନ୍ମସୁଖୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନନ୍ଦନନ୍ଦନ ମନ୍ଦ ନ ଜାଣୁ ତୁ ତା ଛନ୍ଦ",
          "ଫାନ୍ଦରେ ପକାଇ ତୋ ମହତ୍ତ୍ୱକୁ",
          "ନେବ ବୋଲନ୍ତେ କ୍ଷାମଉଦରୀ ହେଲୁ ତମ",
          "ଛଳି ଶ୍ୟାମ ପ୍ରେମରେ ମୋ ପରକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମତ୍ସର ହୀନ ଯାର ସେ ଭଜିବ ସେ ଜାର",
          "ଇତର କଲେ ତାର ନାହିଁ ଗତି",
          "ବୋଲି ବହନ୍ତେ ତୋତେ ନ ଘେନିଲୁ କିଞ୍ଚିତେ",
          "ପ୍ରତେ ହେଲା କି ଏବେ ଏ ସଙ୍ଗତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୁରୁଜନ ତର୍ଜ୍ଜନା ଜରତୀର ଭର୍ତ୍ସନା",
          "ଯାହା ଲାଗି ଶୋଚନା ନ ଘେନିଲୁ",
          "ସେ କି ଜାଣିଲା ତାହା ଆହା ଶିରୀଷଦେହା",
          "ମୁଁ ଆଉ କଷ୍ଟ ଦେହ ସୁହାଇଲୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏହି ଲାଗି ବିନତି ପ୍ରିୟ ହେଲେ ଆରତି",
          "ଧରି ନ ପାରୁ ଧୃତି ଦୟାବତୀ",
          "ନୋହିଲେ ଇଷିତରେ ଶିଖିପିଚ୍ଛ କୂଳରେ",
          "ଲୋଟିବାର ଦେଖନ୍ତେ ସଖୀତତି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଲଳିତା ହିତ ବାଣୀ ବୃଷଭାନୁଜା ମଣି",
          "ଲଭୁ ଧୈର୍ଯ୍ୟ ସେକ୍ଷଣି ମାନସରେ",
          "ଜାଣି ହୋଇଲା ତୃଷ୍ଣ କବି ଗୋପାଳକୃଷ୍ଣ",
          "କୃଷ୍ଣ ଅଇଲେ ସେହି ଅବସରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
