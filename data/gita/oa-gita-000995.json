{
  "id": "oa-gita-000995",
  "name": {
    "en": "Bandhu mo kahun kisa sunila re",
    "or": "ବନ୍ଧୁ ମୋ କାହୁଁ କିସ ଶୁଣିଲା ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
