  "id": "oa-gita-000816",
  "name": {
    "en": "Pasori heba ki bandhuku",
    "or": "ପାଶୋରି ହେବ କି ବନ୍ଧୁକୁ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pasori-heba-ki-bandhuku-dhanasri-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପାଶୋରି ହେବ କି ବନ୍ଧୁକୁ",
          "ଶ୍ୟାମକୁ ତା ତିନିଭଙ୍ଗୀ ଠାମକୁ",
          "ଦଳିତ ଅଞ୍ଜନ କଳା ଛବି ଜିଣେ କାମକୁ",
          "ନବୀନ ନୀରଦ ନିନ୍ଦେ ମୁରଲୀଧର ତାର",
          "ଢଳା ଚୂଳ ବାମକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଦମ୍ବ ମୂଳିଆ କାହ୍ନୁ ହଟିଆ ନାଗର",
          "ସତୀ ମତି ଧୃତିହରା ରାସ ରସସାଗର",
          "(ପଡ଼ି)",
          "ପୀତପଟ ଧିଟ ଶଠ ନଟକୂଟିଆ",
          "କୁଞ୍ଜବନେ ରାଇ ରାଇ ସ୍ୱନେ",
          "ମୁରଲୀ ବଜାଏ ଘର ପାଶୋରାଏ",
          "ଘାରି ମରମକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କବିଚନ୍ଦ୍ର କହେ ସଖି ପଚାର ତୁ ଅନ୍ତରେ",
          "ମରୁ କି ନା ନିଶିଦିନ ଝୁରି ପ୍ରୀତି ମନ୍ତରେ",
          "(ପଡ଼ି)",
          "ମଧୁ ଆସେ ପାଶେ ଆସେ ମଧୁରସିଆ",
          "ଚନ୍ଦ୍ରମୁଖୀ ଏତେ ଘେନ ମନେ",
          "ତୋ ଘେନି ମୋହନା ନ ମାନେ କି ମନା",
          "ରଟେ ତୋ ନାମକୁ"
        ]
      }
    ]
  },
