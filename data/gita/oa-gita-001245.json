{
  "id": "oa-gita-001245",
  "name": {
    "en": "Na pare muruchi re se syama",
    "or": "ନ ପାରେ ମୂରୁଛି ରେ ସେ ଶ୍ୟାମ"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-pare-muruchi-re-se-syama-jhuruchi-re-mukhari-biramitrodaya-ekatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ ପାରେ ମୂରୁଛି ରେ ସେ ଶ୍ୟାମ ଝୁରୁଛି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାମ ପାଣିରେ ଦେହଳୀ ଧରିଣ ଅଳପ ଢଳି",
          "ମଣ୍ଡିବା ବେଳେ ପ୍ରତୋଳି ଚନ୍ଦ୍ରବଦନକୁ ତୋଳି",
          "(ପଡ଼ି)",
          "ବାରବାର ନଥ ମୋତିକି ଦୋହଲାଇ",
          "ନବ କୁରୁବିନ୍ଦାଧରେ ମଧୁର ହସି",
          "ପ୍ରଫୁଲ୍ଲ ସୁନ୍ଦର ସରସିଜ ନୟନକୁ",
          "ଢାଳି ଚଞ୍ଚଳରେ ଚାହିଁବାର ଭଙ୍ଗୀକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଜାଇ ଶିଖଣ୍ଡ ଚୂଳେ କେଳି କଦମ୍ବର ମୂଳେ",
          "ଉଭା ବେଳେ ସଖୀ ତୁଲେ ଯିବାରେ ଯମୁନା କୂଳେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରାଗ ବଶେ କ୍ରୀଡ଼ା କୁଞ୍ଜେ ଆଗରୁ ସେ ଥିଲେ ତୁ ଯେ",
          "ଧରି ଲାଜ ଭୀତିକି ଯେ କରିବା ସମୟେ ବିଜେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦେଖିବାକୁ ସଖୀ ତୁଲେ ଥିଲେ ତୁ ସଉଧ ଚୂଳେ",
          "ବନରୁ ବାହୁଡ଼ା ବେଳେ ଚାଲନ୍ତେ ସେ ଗେଲେ ଗେଲେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସ୍ୱର୍ଣ୍ଣପୁର ଯୁବପତି କହଇ ଧନ ଶ୍ରୀପତି",
          "ବହି ବିରହ ବିପତ୍ତି ଦହି ନେଉଛି ସମ୍ପ୍ରତି"
        ]
      }
    ]
  },
