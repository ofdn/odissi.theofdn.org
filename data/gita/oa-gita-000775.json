{
  "id": "oa-gita-000775",
  "name": {
    "en": "Sajani tora dharuchi kara",
    "or": "ସଜନୀ ତୋର ଧରୁଛି କର"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000031"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-tora-dharuchi-kara-baradi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ ତୋର ଧରୁଛି କର ଗୋ",
          "ଆଣିଦିଅ ମୋତେ ଶ୍ୟାମସୁନ୍ଦର ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେଣେ ଚାହିଁଦେଲେ ସେ ବେଣୁଧର",
          "ଦିଶି ଯାଉଛନ୍ତି ଏ କି ହୁନ୍ଦର ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜାଣନ୍ତି ସେ କି ମୋହିନୀ ମନ୍ତର",
          "ନିରନ୍ତରେ ନେତ୍ରେ କଲେ ତ ଘର ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅନ୍ତରେ ବାହାରେ ସେ ଚିତ୍ତ ଚୋର",
          "ଇନ୍ଦ୍ରଜାଲ ପରି ମୋତେ ଗୋଚର ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କି କରିବି ସଖୀ ଉପାୟ କର",
          "ଦିଅ କିନା ପ୍ରୀତିଛଡ଼ା ମନ୍ତର ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବନମାଳୀ ବୋଲେ ଚିନ୍ତା ନ କର",
          "ଅବଶ୍ୟ ଆସିବେ ମୁରଲୀଧର ଗୋ"
        ]
      }
    ]
  },
  "sources": [
