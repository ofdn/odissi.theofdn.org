{
  "id": "oa-gita-000617",
  "name": {
    "en": "Anukampa dhari hari",
    "or": "ଅନୁକମ୍ପାଧାରୀ ହରି"
  },
  "composer": "oa-person-000042",
  "mula_raga": [
    "oa-raga-000055"
  ],
  "mula_tala": [
    "oa-tala-000007"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/anukampa-dhari-hari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନୁକମ୍ପାଧାରୀ ହରି ହର ମୋହର ଆତଙ୍ଗ",
          "ଦନୁଜାରି ଚକ୍ରାୟୁଧ ହେ ଶିରୀପତି ଶ୍ରୀରଙ୍ଗ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁଞ୍ଜରବର ତାରଣ କୁଞ୍ଜର ମତ୍ତ ବାରଣ",
          "କୁଞ୍ଜର ନାଶକ ଗୁଞ୍ଜ ଆବଳୀ ଭୂଷିତ ଅଙ୍ଗ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାସବର ଗର୍ବଗଞ୍ଜା ଯାମଳା ଅର୍ଜ୍ଜୁନ ଭଞ୍ଜା",
          "ଗୋପିନୀ ମାନସ ରଞ୍ଜା ଶ୍ରୀ ବୃନ୍ଦାରଣ୍ୟ ଅନଙ୍ଗ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଉରଦେଶ ଧଳା କଳା ବଳାହକ କାନ୍ତି କଳା",
          "-ବତୀ ଶ୍ରୀ ଭାନୁଜା ଗଳାମାଳା ଧାରକ ସାରଙ୍ଗ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବଇକୁଣ୍ଠ କଣ୍ଠୀରବ ତବ ମହିମା ପ୍ରଭାବ",
          "ଦେଖାଅ ନ କରି ଲବ ଅବହେଳା ମଣିଖଙ୍ଗ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବିପତି ପତି ବିପତ୍ତି ବେଳକୁ ଉତ୍ପତ୍ତି ଅତି",
          "କି ପତିଆରା ମୋ ଆଉ ଗ୍ରାସୁଛି କାଳ ଭୁଜଙ୍ଗ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପ୍ରପନ୍ନ ଯଦୁମଣିର ଯଦୁମଣି ବାଧା ଘୋର",
          "ପ୍ରସନ୍ନେ ହରି ପଦାବ୍ଜେ ରଖ କରି ମତ୍ତ ଭୃଙ୍ଗ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
