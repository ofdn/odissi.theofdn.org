{
  "id": "oa-gita-000354",
  "name": {
    "en": "Basanta kale mita loduthibe mo udanta",
    "or": "ବସନ୍ତ କାଳେ ମିତ ଲୋଡ଼ୁଥିବେ ମୋ ଉଦନ୍ତ"
  },
  "composer": "oa-person-000029",
  "mula_raga": [
    "oa-raga-000043"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/basanta-kale-mita-loduthibe-mo-udanta/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବସନ୍ତ କାଳେ ମିତ",
          "ଲୋଡ଼ୁଥିବେ ମୋ ଉଦନ୍ତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବନପ୍ରିୟ ପ୍ରେମଭରେ ମାତି ବସି ପଲ୍ଲବ ଡାଳରେ",
          "ପଞ୍ଚସ୍ୱରେ ଗାଉଥିବେ ଗୀତ",
          "ସେ ଧ୍ୱନି ଶୁଣି ରମଣୀ ଆସନ କରେ ଧରଣୀ",
          "କାମଶରେ ହୋଇ ବିହ୍ୱଳିତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲାଗି ଦକ୍ଷିଣା ପବନ ବିକାଶେ କୁସୁମମାନ",
          "ଅଳିବୃନ୍ଦ ହୋଇ ଉପଗତ",
          "କରୁଥିବେ ମଧୁପାନ ତା ଦେଖି ଜୀବଜୀବନ",
          "କପାଳରେ ମାରୁଥିବ ହାତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାବନାରେ ରାମାବର ଗଣ୍ଡେ ଦେଇ ବେନି କର",
          "ଚାହୁଁଥିବେ ମୋ ଆସିବା ପଥ",
          "କେ ଜାଣି କିସ ହେବନି ନବ ବାଳା ପୀନସ୍ତନୀ",
          "ନିଶ୍ଚେ ହେବ ଧନୀ ପ୍ରାଣେ ହତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାମଚନ୍ଦ୍ର ଗୀତେ ଭାଷି ଭରସା ବୁଡ଼ିଲା ଆସି",
          "ଅସ୍ଥିର ହେବନି ଧନୀ ଚିତ୍ତ",
          "ହରାଇ ଆପଣା ବୁଦ୍ଧି ଅରଜିଲି ଚିନ୍ତାବ୍ୟାଧି",
          "ବିଚ୍ଛେଦରୁ ରଖ ଉମାକାନ୍ତ"
        ]
      }
    ]
  },
  "sources": [
