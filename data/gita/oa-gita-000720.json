{
  "id": "oa-gita-000720",
  "name": {
    "en": "Rasanidhi bhala acharila",
    "or": "ରସନିଧି ଭଲା ଆଚରିଲା"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasanidhi-bhala-acharila-purabi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରସନିଧି ଭଲା ଆଚରିଲା ମୋହପରି ବିଧି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କିଙ୍କିଣୀ ତାଳକୁ ରଚୁଥିଲା",
          "ଝୁଲି ଝୁଲି ନଥ ନାଚୁଥିଲା",
          "ନେତ୍ର ପୁଣ୍ୟଫଳ ପାଚୁଥିଲା",
          "ମୋତେ ବ୍ରହ୍ମପଦ ସୁଖ ଯାଚୁଥିଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅଧୋମୁଖେ ରତ୍ନସାନୁ ଥିଲା",
          "ତା ନିକଟେ ସୁଧାଭାନୁ ଥିଲା",
          "ତହିଁ ତିଳଫୁଲ ତଳେ ଝଲମଲ",
          "ବୁଲାକି ଝୁଲା କି ମାନୁଥିଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆନେ ତା ଚାକିର ଲବ କାହିଁ",
          "ବିବେକ ବାକି ରହିଲା ନାହିଁ",
          "ବିନ୍ଦୁ ବିନ୍ଦୁ ଝାଳ ସୁନ୍ଦର କପୋଳ",
          "ମୁକୁରେ ମକରୀ ଲୀଳା ଚାହିଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନ୍ଧୁ ମୋ କି ଲାଜ ଭଜୁଥିଲା",
          "ଥରେ ଥରେ ନେତ୍ର ବୁଜୁଥିଲା",
          "ଥରେ ଥରେ ଚାହିଁଦେଇ ଇନ୍ଦୀବରେ",
          "ମଦନ ଦେବକୁ ପୂଜୁଥିଲା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନୀଳ କୁଞ୍ଚିତ କୁନ୍ତଳତତି",
          "ଭଜୁଥିଲା ଅସ୍ତବ୍ୟସ୍ତ ଭୀତି",
          "ମିଶୁଥିଲା ଗଭା କ୍ରମରେ ଖସିବା",
          "କୁସୁମ ରସନିଧି ଭଲା ଆଚରିଲା  ଧୃତି"
        ]
      }
    ]
  },
  "sources": [
