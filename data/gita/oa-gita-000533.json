{
  "id": "oa-gita-000533",
  "name": {
    "en": "Asuchanti brajabasi dhire dhire chali chali",
    "or": "ଆସୁଛନ୍ତି ବ୍ରଜବାସୀ ଧୀରେ ଧୀରେ ଚାଲି ଚାଲି"
  },
  "composer": "oa-person-000029",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asuchanti-brajabasi-dhire-dhire-chali-chali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସୁଛନ୍ତି ବ୍ରଜବାସୀ",
          "ଧୀରେ ଧୀରେ ଚାଲି ଚାଲି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିନ ଶେଷ ସମୟରେ",
          "ରହି ସୁରଭୀ ପଛରେ",
          "ବଜାଉଛନ୍ତି ମୁରଲୀ",
          "ଧୀରେ ଧୀରେ ଚାଲି ଚାଲି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଇନ୍ଦ୍ରନୀଳମଣି ତନୁ",
          "ପରିହାସ ଜାତ ମନୁ",
          "ଝୁଲନ୍ତି ବରହୀ ଚାଲି",
          "ଧୀରେ ଧୀରେ ଚାଲି ଚାଲି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଖିବା ସଜନୀ ଚାଲ",
          "ନୋହିବାଟି କଲବଲ",
          "ଫିଙ୍ଗିବେ ସେ ନେତ୍ର ଭାଲି",
          "ଧୀରେ ଧୀରେ ଚାଲି ଚାଲି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନାଗେଶ୍ୱର ନାଦ ପରି",
          "କଟୀ କିଙ୍କିଣୀକି କରି",
          "ଖେଳାନ୍ତି ଅହି ଭ୍ରୂବଲ୍ଲୀ",
          "ଧୀରେ ଧୀରେ ଚାଲି ଚାଲି ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରାମଚନ୍ଦ୍ର ଦେବ ଭଣି",
          "ଭାଷଇ କେଉଁ ରମଣୀ",
          "କଲେ କେତେ ଭଙ୍ଗୀ କାଲି",
          "ଧୀରେ ଧୀରେ ଚାଲି ଚାଲି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
