  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pankaruha-drusa-mora-kousiki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପଙ୍କରୁହ ଦୃଶା ମୋର ଅଙ୍କେ ବସ ଆସି ରେ",
          "ଗୁମାନ ମନେ ନ ଧର ତୁ ମାନ ମୋହର ଗିର",
          "ପ୍ରେମାନନ୍ଦେ ଚାହଁ ବାରେ ମନ୍ଦେ ମନ୍ଦେ ହସି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୋରୀ ରେ ପରାଣେଶ୍ୱରୀ ପରିରମ୍ଭେ ପ୍ରୀତି କରି",
          "ଜରିଅଙ୍ଗୀ ପରି ଯାଅ ମୋ ଅଙ୍ଗେ ମିଶିରେ ।",
          "(ପଡ଼ି)",
          "ଭାଷିଲେ ଶ୍ରୀ ଜଗଦ୍ଦେବ ରେ",
          "ନାଶି ନିଶ୍ଚେ କାମଦେବ ରେ",
          "ରସିକା ତୁ ଥାଉ ଥାଉ ରେ",
          "ଯିବି ସିନା ମୁଁ ଭାସି ରେ"
        ]
      }
    ]
  },
