{
  "id": "oa-gita-000573",
  "name": {
    "en": "Gala gokula dharma bhasi ta",
    "or": "ଗଲା ଗୋକୁଳ ଧର୍ମ ଭାସି ତ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000057"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gala-gokula-dharma-bhasi-ta-banamali-kusuma-kedara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗଲା ଗୋକୁଳ ଧର୍ମ ଭାସି ତ",
          "ଶ୍ୟାମ ଜାତି ମହତ ଦେଲା ଧ୍ୱଂସି ତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ଭଙ୍ଗୀରେ ହୁଏ ଛିଡ଼ା ନ ରଖେ ଆଖି ପିଛଡ଼ା",
          "କୁଳବତୀ ବ୍ରୀଡ଼ା ଛାଡ଼ି ଆସି ତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସ୍ୱର୍ଗେ ନ ଥିବ ସୁଧାରେ ନ ଦିଶଇ ବସୁଧାରେ",
          "ବହେ ଯା ପୀୟୂଷ ଧାରେ ଭାଷିତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କାମ ଛୁରୀ ଚାହିଁବାର ହୃଦେ ପଶେ ବାର ବାର",
          "ଥରେ ଅନାଇଲେ ବାର ମାସୀ ତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲାଞ୍ଚ ଦେବି ଦେବତାରେ କେ ବୋଲିବ ସେବ ତାରେ",
          "ନାହିଁ ମୁଁ ଜହ୍ନୁ ସୁତାରେ ଭାସି ତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ବନମାଳୀ ସାର ବ୍ରଜ ନରେନ୍ଦ୍ର କୁମାର",
          "ଶ୍ରୀଅଙ୍ଗକୁ ଛାର ମାର ଭର୍ତ୍ସିତ"
        ]
      }
    ]
  },
  "sources": [
