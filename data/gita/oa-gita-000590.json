{
  "id": "oa-gita-000590",
  "name": {
    "en": "Mo bachana mana",
    "or": "ମୋ ବଚନ ମାନ"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mo-bachana-mana-haribandhu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋ ବଚନ ମାନ",
          "କର ତୁ ସେହି ଗୁମାନରେ ମାନିନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧୈର୍ଯ୍ୟ କରି ରହିଥାରେ ନାଗରୀ ରତନ",
          "ସେ ଶ୍ୟାମକୁ ଆଣି ତୋ ସମୟ ଜାଣି",
          "ଭେଟାଇ ଦେବି ସଘନରେ ମାନିନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସେହି ତ କେଣିକି ଯିବେ ଏକ୍ଷଣି ଆସିବେ",
          "ଆରେ ଏଣୀକ୍ଷଣୀ ଧରି ମୋର ପାଣି",
          "କହିବେ କାକୁ ବଚନରେ ମାନିନୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିଧୁଜିତ ଶ୍ରୀମୁଖକୁ ନ କର ମଳିନ",
          "ଲୀନ ହୋଇ ସହି ଶରଣ ପଶିବେ",
          "ତୋ ପଦେ ମଧୁସୂଦନରେ ମାନିନୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଳୀର ସୁବାଣୀ ଶୁଣି ଶ୍ରୀ କିଶୋରୀ ମଣି",
          "ତେଜିଣ ବିରସ ହୋଇଣ ହରଷ",
          "ଭାବେ ହରିବନ୍ଧୁ ଭଣିରେ ମାନିନୀ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
