{
  "id": "oa-gita-000675",
  "name": {
    "en": "Mun ki kali sahi",
    "or": "ମୁଁ କି କଲି ସହି"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000020"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mun-ki-kali-sahi-sri-birabikrama-deba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୁଁ କି କଲି ସହି ସଙ୍ଗ ତେଜିଲି",
          "ମାର ଶର ମୁଖେ ସମର୍ପି ଦେଲି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବସିଲେ ବାନ୍ଧବୀ ମୋ ପ୍ରୀତି ଭାଳି",
          "ଆଳି ମିଳି ମୋତେ ଦେବେ ତ ଗାଳି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲଉଲି ବୟସୀ ନେତ୍ର ପିତ୍ତୁଳୀ",
          "କେହି ସହୁଥିବ ଅନଙ୍ଗ ଅଳି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଖି ଦେବ ଯେବେ ସୁମନେ ଅଳି",
          "ବେଳୁଁ ବେଳ ଦୁଃଖ ଯିବନି ବଳି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ବୋଲେ ନ ମଲି",
          "ଭେଟିଲେ ସହି କହିବି କି ବୋଲି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
