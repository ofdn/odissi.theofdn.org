{
  "id": "oa-gita-000973",
  "name": {
    "en": "Sangini re manda karama mora",
    "or": "ସଙ୍ଗିନୀରେ ମନ୍ଦ କରମ ମୋର"
  },
  "composer": "oa-person-000133",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangini-re-manda-karama-mora/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗିନୀରେ ମନ୍ଦ କରମ ମୋର",
          "ବ୍ରଜବିହାରୀ ହରି କଲେ ଅନ୍ତର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏକାନ୍ତେ ବସି ପାହିଲା ନିଶି",
          "ନ ଆସିଲେ ମୋର ପୁରେ ନଟନାଗର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏ ରାଧା ନାମ ନ ପଡ଼େ ମନ",
          "କେଉଁ ରମଣୀ କଲା ଗଳାକୁ ହାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୋ ଠାରୁ ବଳି ସେ ଥିଲା ବାଳୀ",
          "ସେ ହେତୁ କି ନ ପଡ଼ିଲି ମନେ ତାଙ୍କର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାଅ ଲଳିତେ ଆଣ ତୁରିତେ",
          "ଧୈର୍ଯ୍ୟ ଧରିବି ଭାବେ କାର୍ତ୍ତିକ ତୋର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangini-re-manda-karama-mora/"
    }
  ],
