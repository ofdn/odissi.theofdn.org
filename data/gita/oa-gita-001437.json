  "name": {
    "en": "Kahibu parana bandhuku bandhuku",
    "or": "କହିବୁ ପରାଣବନ୍ଧୁକୁ ବନ୍ଧୁକୁ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000052"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahibu-parana-bandhuku-bandhuku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହିବୁ ପରାଣବନ୍ଧୁକୁ ବନ୍ଧୁକୁ । ପଦ ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାହୁ ପ୍ରାୟେ ରତୀଶ",
          "ନିରତେ କରେ ଗ୍ରାସ",
          "ନ ଛାଡ଼େ ମୋ ହୃଦୟବିଧୂକୁ ବିଧୁକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚିର ତୃଷିତ ପରି",
          "ହୋଇଛି ସହଚରୀ",
          "ବିରସ ତୋ ଅଧରମଧୁକୁ ମଧୂକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଦା ଝୁରେ ନୟନ",
          "ସେ ରମଣୀ ରତନ",
          "ଘଟନ ତା ସିନ୍ଦୂରବିନ୍ଦୁକୁ ବିନ୍ଦୂକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ବଦତି",
          "ଶୁଣ ବୋଲେ ଶ୍ରୀମତୀ",
          "ନିବେଶି ତା ଭାବନାସିନ୍ଧୂକୁ ସିନ୍ଧୂକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahibu-parana-bandhuku-bandhuku/"
    }
  ],
