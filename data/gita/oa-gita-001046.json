{
  "id": "oa-gita-001046",
  "name": {
    "en": "Ahe braja pura nara raja suta",
    "or": "ଆହେ ବ୍ରଜପୁର ନରରାଜା ସୁତ"
  },
  "composer": "oa-person-000038",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ahe-braja-pura-nara-raja-suta-jhinjhoti-dwija-padmanabha/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହେ ବ୍ରଜପୁର ନରରାଜା ସୁତ",
          "ମୋ ପୁରରୁ ଯା ଯା",
          "କରି ବିନତି କହ ତା ଠାରେ",
          "ଯହିଁ ଜାଗର କଲ ତାଜା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହୃଦେ ଅଙ୍କିତ କରଜ ରେଖ",
          "ମୁଁ କେତେ କହିବି ଅତି ଅଲେଖ",
          "ଆହେ ବିବେକ ମୁକୁର ଦେଖ",
          "ଦିଶେ ମୁଖ ପ୍ରତିଭା ଯା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଅରୁଣାଧରେ ଦଶନ ଘାତ",
          "ଘୂର୍ଣ୍ଣିତ ନୟନ ପଲକପାତ",
          "କହୁଁ କହୁଁ ଗିର ହୁଅ ଅଚେତ",
          "ବାସରେ ଥରେ ବାସରେ ଥରେ ଶୋ ଯା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବନଜବଦନ ମଳିନ ତୋର",
          "ନୀଳବସନ ପାଲଟ କର",
          "ଯାବକ ହୃଦ ବହିଛି ଯାର",
          "ମାନସେ କର ହେଢ଼ା ଯା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭାଷଇ ଦ୍ୱିଜ ପଦ୍ମନାଭ",
          "ଭାବରେ ଯହୁ କଲ ଅଭାବ",
          "ଲଭିବ ପୀରତି ପରମ ଲାଭ",
          "ଚନ୍ଦ୍ରବଦନ ଧୋ ଯା"
        ]
      }
    ]
  },
  "sources": [
    {
