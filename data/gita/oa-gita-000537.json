  "id": "oa-gita-000537",
  "name": {
    "en": "Khela khanjarita drusa",
    "or": "ଖେଳା ଖଞ୍ଜରୀଟ ଦୃଶା"
  },
  "composer": "oa-person-000002",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "kabya": {
    "id": "oa-kabya-000004"
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/khela-khanjarita-drusa-ratnakara-champu-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଖଟାଅ ମୋତେ ତା ବେହରଣ ଫୁଲ ଖଟ ତଳେ ଦିବା ନିଶା",
          "ସଙ୍ଗାତରେ ଖେଳା ଖଞ୍ଜରୀଟ ଦୃଶା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖିଲାଇ ମାତ୍ରକ ବିନ୍ଦୁମିତମଧୁ ବନ୍ଧୁକବନ୍ଧୁ ଅଧରୁ",
          "ଖିଆଲ ରସ ପ୍ରସଙ୍ଗ ସଙ୍ଗିନୀଙ୍କ ଜଣେ ମୋତେ ଗଣା କରୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖିଲିଖିଲି କରି ଖୁଆଇବି ଶିରୀମୁଖେ କର୍ପୂର ବିଡ଼ିଆ",
          "ଖଲି ମୃଗମଦ ଚିତ୍ରିବି ପ୍ରମୋଦ ଭରେ ଊରଜ ନଡ଼ିଆ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଖଣ୍ଡ ସହୋଦର ମଧୁର ତା ଗୀର ବରତନ ବୋଲି ଭାବି",
          "ଖୁଣ ନ ଥିବାର ଅଲକତ ସାର ଚିତ୍ରପଦେ ଲେଖୁଥିବି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଖଟା ଲେଶ ଚିତ୍ତେ ନ ରଖି ଲଳିତେ ଘେନାଅ ବାଳା ପୁରତେ",
          "ଖରାପ ନୁହେଁଟି ପର ଉପକୃତି ବୋଲେ କବିରବି ଗୀତେ"
        ]
      }
    ]
  },
