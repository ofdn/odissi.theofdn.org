{
  "id": "oa-gita-000137",
  "name": {
    "en": "Chandranisa re",
    "or": "ଚନ୍ଦ୍ରନିଶା ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chandra-nisa-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚନ୍ଦ୍ରନିଶା ରେ",
          "ଦେଲା ସୁନ୍ଦରୀମଣି ମହେନ୍ଦ୍ରଭୂତି ମୋରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଫୁଲବନେ କେଳିସର କୂଳେ",
          "ନବ ସଙ୍କେତ କଙ୍କେଳିମୂଳେ",
          "ଶେଯ ସାଜି ନାନା ପୁଷ୍ପଦଳେ",
          "ବସିଥିଲି ସେ ରମ୍ଭୋରୁ ସମ୍ଭୋଗ ଆଶାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏ ସମୟେ ମୋ ଜୀବନଧନ",
          "ଘେନି ଘନ ସର୍ବାଙ୍ଗ ଚନ୍ଦନ",
          "ତେଜି ବାଜିବା ମଣ୍ଡନମାନ",
          "ବିଜେ କଲା ମଲ୍ଲୀଗଭା ଭୂଷିତ ଖୋଷାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶଙ୍ଖକଣ୍ଠୀକି ମୁଁ ଦେଖିକରି",
          "ରଙ୍କ ରତନ ଲଭିଲା ପରି",
          "ଅଙ୍କପର୍ଯ୍ୟଙ୍କେ ବସନ୍ତେ ଧରି",
          "ଗଲା ଅଙ୍ଗ ଅନଙ୍ଗ ମର୍ଦ୍ଦିବା ଦୁର୍ଦ୍ଦଶାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଉରେ ଜମାଇ ଉରୋଜ କୁମ୍ଭ",
          "କରୁ କରୁ ଗାଢ଼େ ପରିରମ୍ଭ",
          "କଲି ସହସ୍ର ଚୁମ୍ବ ଆରମ୍ଭ",
          "ମନ ବଳିଲା ନାହିଁ ପୀୟୂଷ ପ୍ରଶଂସାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଫେଡ଼ୁ ଫେଡ଼ୁ ବାଳାବର ନୀବି",
          "ଯେତେ ଭାବ ତା କି ବରନିବି",
          "ବିବସନ କାଳେ ଯେଉଁ ଛବି",
          "ଆଖି ଦେଖିଲା କେଉଁ ଭାଗ୍ୟରୁ ଏ ରସାରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଝୁମିଝୁମି କାମ ମଦ ଭୋଳେ",
          "ଝୁଲୁଝୁଲୁ ନାସାଭୂଷା ଲୋଳେ",
          "ଝଲଝଲ ଝଟକିଲା ବେଳେ",
          "ଝିଙ୍କିନେଲା ସ୍ୱର୍ଗସୁଖ ମାର୍ଗକୁ ସୁସାରେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କହେ ଅଷ୍ଟଦୁର୍ଗ ହରିହୟ",
          "ପରସ୍ପର ପ୍ରେମ ରସମୟ",
          "ଜାତ ହେଲା ଯାହା ସେ ସମୟ",
          "ଝରଝର ଅପୂରୁବ ରସ ବରଷାରେ"
        ]
      }
    ]
  },
  "sources": [
