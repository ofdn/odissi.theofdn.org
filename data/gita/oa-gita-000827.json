{
  "id": "oa-gita-000827",
  "name": {
    "en": "Kaha ja mohane sajani",
    "or": "କହ ଯା ମୋହନେ ସଜନୀ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000177"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kaha-ja-mohane-sajani-sindhuda-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହ ଯା ମୋହନେ ସଜନୀ",
          "ପୁହାଇବେ ଚନ୍ଦ୍ରାବଳୀ ପୁରେ ସାରା ରଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦଳିଲା ସୁମନ ସରି ନୁହଇ ସହୀ କିଶୋରୀ",
          "ଅଛି ତ ଯମୁନା ବାରି ତା ଲାଗି ରେ ସଜନୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନିତି ନିତି ସହି ସେହି କେତେ ସତେ ହେବି ଦହି",
          "ସେ ସିନା ନିଲଜ ବ୍ରଜନାରୀ ମୁଁ ରେ ସଜନୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜଗତିରେ ବାଜେ ବାଜା ଯା ଲାଗି ତେଜିଲି ଲଜ୍ଜା",
          "କଲା ସେ କପଟ କୁଞ୍ଜେ ଜଗାଇ ରେ ସଜନୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆସିଲେ ପୁରେ ଏଥର କବିଶଶୀ କହେ ଗିର",
          "ହେବୁ କି ରେ ଧନୀ ସତେ ମାନିନୀ ରେ ସଜନୀ"
        ]
      }
    ]
  },
