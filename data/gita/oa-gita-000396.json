{
  "id": "oa-gita-000396",
  "name": {
    "en": "Ki sobha go kunje madanamohana",
    "or": "କି ଶୋଭା ଗୋ କୁଞ୍ଜେ ମଦନମୋହନ"
  },
  "composer": "oa-person-000039",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-sobha-go-kunje-madana-mohana-ananda-bhairabi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଶୋଭା ଗୋ କୁଞ୍ଜେ ମଦନମୋହନ",
          "ଚାହାଁରେ ପ୍ରାଣମିତଣୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାମେ ନବକିଶୋରୀ କି ବା ରୂପ ମାଧୁରୀ",
          "ଘେନି ସର୍ବ ମଞ୍ଜରୀ ମଧ୍ୟେ ଶ୍ରୀ ବେଣୁପାଣି",
          "(ପଡ଼ି)",
          "ତ୍ରିଭଙ୍ଗୀ ଛନ୍ଦେ ଛିଡ଼ା ଶିରେ ମୟୂର ଚୂଡ଼ା",
          "ଶୋହେ ସେବତୀବେଢ଼ା ସତୀଙ୍କ ଦମ୍ଭଛଡ଼ା",
          "ତ୍ରିଭଙ୍ଗୀରେ ଚାହାଣୀ ନିଏ ହୃଦୟ କିଣି",
          "କେଡ଼େ ସୁନ୍ଦର ରାଧା ନାଟୁଆ ନୀଳମଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲବଙ୍ଗଲତିକା ଚିତ୍ରା ଇନ୍ଦୁରେଖା",
          "ଚାମର ଧରି ଢାଳନ୍ତି ।",
          "ବୃନ୍ଦାଦି ସଖୀଗଣ ହୋଇ ଊର୍ଦ୍ଧ୍ୱ ବଦନ",
          "ଚୂଆ ଚନ୍ଦନ ଆଣି ଶ୍ରୀଅଙ୍ଗରେ ଲେପନ୍ତି",
          "(ପଡ଼ି)",
          "କାନନରେ ମିଳି ପୁଷ୍ପମାନ ତୋଳି",
          "ଜାଇ ଯୂଇ ମଲ୍ଲୀ ଚମ୍ପା କୁରୁବେଲ୍ଲୀ",
          "ଟଗର ଗୋଲାପ କେତକୀ ନିଆଳୀ",
          "ମହା ଆନନ୍ଦେ ବୃନ୍ଦାବନେ କରନ୍ତି କେଳି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରଙ୍ଗଦେବୀ ମହାତାନ-ମାନ-ଭରେ",
          "ଗାୟନ ଆରମ୍ଭ କରି ।",
          "ମାଳବ ଆଶାବରୀ ପହପଟ ମଞ୍ଜରୀ",
          "ରାମକେରୀ ଗଉରୀ ଗାଆନ୍ତି କେ ଚତୁରୀ ।",
          "(ପଡ଼ି)",
          "କେହୁ ମର୍ଦ୍ଦଳ ଧରି ନୃତ୍ୟ ଆରମ୍ଭ କରି",
          "ବଜାଇ ଭେରୀ ତୂରୀ ସର୍ବ ବ୍ରଜନାଗରୀ",
          "ବଂଶୀଧାରୀଙ୍କି ଘେରି ସକଳ ସହଚରୀ",
          "ଦେବତାମାନେ ସ୍ୱର୍ଗୁଁ କୁସୁମ ବୃଷ୍ଟି କରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନବ ନବ ବାଳୀ ଦେଇ ହୁଳହୁଳି",
          "ବନ୍ଦାନ୍ତି ଗୋଅର୍ଘ୍ୟ ଥାଳି ।",
          "କେହୁ ବଜାଇ ତାଳି ନାଚନ୍ତି ଢଳି ଢଳି",
          "ଆନନ୍ଦେ ରାସସ୍ଥଳୀ ମହୀ ପଡ଼େ ଉଚ୍ଛୁଳି",
          "(ପଡ଼ି)",
          "ବଡ଼ଖେମୁଣ୍ଡି ପତି କ୍ଷିତିପତି ଦୁର୍ଗତି",
          "କୁଳଚନ୍ଦ୍ର ସୁଶୀଳ ଶ୍ୟାମଳ ଶାନ୍ତମୂର୍ତ୍ତି",
          "ବୀରାଧି ବୀରବର ବୀର ଶ୍ରୀ ଗଜପତି",
          "ଶ୍ରୀ କୃପାମୟ ଦେବ ବୋଲନ୍ତି ଏ ଭାରତୀ"
        ]
      }
    ]
  },
