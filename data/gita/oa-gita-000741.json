    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ମୋ ଜୀବଧନ ଏ ବ୍ରଜମୋହନ",
          "ହୃଦୟ ରଞ୍ଜନ ଶ୍ୟାମ ନୟନ ଅଞ୍ଜନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିନେ ମୋ ପୁରେ ପ୍ରବେଶି",
          "ବସି ମନ୍ଦେ ମନ୍ଦେ ହସି",
          "ବୋଇଲେ ରେ ମଦାଳସୀ",
          "ମୁହିଁ ତୋର କିଣାଜନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦିନେ ନାପିତୁଣୀ ବେଶ",
          "ଧରି ସେହି ପୀତବାସ",
          "ମୋ ପାଦେ ଲାକ୍ଷା ରସରେ",
          "ଲେଖିଲେ ଗୋ ଶ୍ୟାମଘନ"
        ]
      }
    ]
  },
