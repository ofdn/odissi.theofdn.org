{
  "id": "oa-gita-000801",
  "name": {
    "en": "Jeun dinu dekhili nanda kisora",
    "or": "ଯେଉଁ ଦିନୁ ଦେଖିଲି ନନ୍ଦକିଶୋର"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000088"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jeun-dinu-dekhili-nanda-kisora-chakrakeli-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯେଉଁ ଦିନୁ ଦେଖିଲି ନନ୍ଦକିଶୋର",
          "ସବୁ ବିଷୟ ଗଲା ମୋର ପାଶୋର ସଖୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁଳବତୀ କଳଙ୍କ ଆଣି ଗୋପରେ",
          "ରଖାଇ ବିହି ହସାଇଲା ଗୋପରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରଖାଉ ନାହିଁ ଗୁରୁ କୁଳରେ ଲାଜ",
          "ଲଖାଉଅଛି ହୃଦେ ଫୁଲ ନାରାଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଉପାୟ ହୋଇ ଆଉ ନ ଦିଶେ ସତ",
          "ଯେଉଁ ଦିନୁ ମୋ ଚିତ୍ତେ ହେଲି ଆସକ୍ତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହସନ୍ତୁ ସାଧୁ ମୋତେ ନିନ୍ଦନ୍ତୁ ବନ୍ଧୁ",
          "ତେଜି ନ ପାରିବି ମୁଁ ଗୋକୁଳ ଇନ୍ଦୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବନମାଳୀ କହଇ ଗୋପୀଙ୍କ ପ୍ରୀତି",
          "ଜାଣି ପାରି ନାହାନ୍ତି ଆଜ ହିଁ ଶ୍ରୁତି"
        ]
      }
    ]
  },
  "sources": [
