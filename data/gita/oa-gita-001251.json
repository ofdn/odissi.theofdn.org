{
  "id": "oa-gita-001251",
  "name": {
    "en": "Sahi syame rusa na",
    "or": "ସହି ଶ୍ୟାମେ ରୁଷନା"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000061"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sahi-syame-rusa-na-lalitaa-biramitrodaya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହି ଶ୍ୟାମେ ରୁଷନା",
          "କହିଲି ପହିଲୁ କୁନ୍ଦକଳି ଦଶନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତାର ଗୁଣ କୀରତି ସ୍ମରଜିତ ମୂରତି",
          "ଚାହିଁ କେଉଁ ଯୁବତୀ ନୋହିବ ସ୍ନେହବତୀ",
          "ବର୍ତ୍ତାଇବ କେ ପତିବ୍ରତୀ ଧୈର୍ଯ୍ୟ ସମ୍ପତ୍ତି",
          "ଚାପି ରସନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତ୍ରିଭଙ୍ଗ ଉଭା ଠାଣି ଲୋଭନୀୟ ଚାହାଣୀ",
          "ଅନଙ୍ଗ ମନ୍ତ୍ର ଜାଣି ଜନରଞ୍ଜନ ବାଣୀ",
          "ଶୁଣି କେଉଁ ତରୁଣୀ ଋଣୀ ନ ହେବ ପୁଣି",
          "ପ୍ରୀତି ବାସନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଟେକି ଥରେ ମୁରଲୀ ଫୁଙ୍କିଦେଲେ ତରଳି",
          "ଯିବ ତୋ ହୃଦ ଜଳିଯିବ ସନ୍ତାପାବଳୀ",
          "ହେବୁ ବିରହେ ଦଳି ନେବୁ ଦିନ କିଭଳି",
          "ନୀଳ ବସନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କନକପୁର ଧରାଜନକ ବଦେ ତ୍ୱରା",
          "ନୁହ ରଙ୍କ ପସରା ଲୁହ ନୟନୁ ସରା",
          "ହରି ତୋତେ ରେ ପରା କରିଛି ପ୍ରାଣ ପରା",
          "ଦମ୍ଭ ନାଶନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
