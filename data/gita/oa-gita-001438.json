{
  "id": "oa-gita-001438",
  "name": {
    "en": "Ki dekhili benupani",
    "or": "କି ଦେଖିଲି ବେଣୁପାଣି"
  },
  "composer": "oa-person-000140",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-dekhili-benupani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଦେଖିଲି ବେଣୁପାଣିରେ ମିତଣୀ । ପଦ ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଳିନ୍ଦଜା କୂଳେ",
          "ନୀପତରୁ ମୂଳେ",
          "ଥିଲା ତ୍ରିଭଙ୍ଗିମା ଠାଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୁରଟ ମୁକୁଟ",
          "ଶିରେ ଝଟଝଟ",
          "ପୁଚ୍ଛ ଗୁଚ୍ଛ ତାଏ ପୁଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତା କର୍ଣ୍ଣେ କୁଣ୍ଡଳ",
          "ନାସା ମୋତିବାର",
          "ଆହା କି ମନ୍ଦ ଦେଲାଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚଳଚଳ ବେଣୀ",
          "କୁଟିଳ ଚାହାଣୀ",
          "ହୃଦୟ ଦେଲା ମୋ ହାଣି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଭାଲେ ଗୋରଚନା",
          "ଅଧର ରଙ୍ଗିମା",
          "ସ୍ମିତଯୁତ ମୃଦୁବାଣୀ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗଳେ ତାର ହାର",
          "ହୃଦେ ବନମାଳ",
          "ନିନ୍ଦେ ଚେଳ ସୌଦାମିନୀ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଚରଣେ କିଙ୍କିଣି",
          "ପ୍ରେମେ ଅନୁକ୍ଷଣି",
          "ଶବ୍ଦ କରେ କିଣିକିଣି"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ସେ ଶ୍ୟାମଳ ତନୁ",
          "ଅନାଉଁ ଅତନୁ",
          "ଶର ବିନ୍ଧେ ମୋତେ ଟାଣି"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଶ୍ରୀମତୀଙ୍କ ଭାବ",
          "ଗୌରଚନ୍ଦ୍ର ଦେବ",
          "ଗଜପତି ସଦା ଭଣି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-dekhili-benupani/"
    }
  ],
