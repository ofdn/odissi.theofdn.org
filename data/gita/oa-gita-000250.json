{
  "id": "oa-gita-000250",
  "name": {
    "en": "Rasa sarasi disa de re thare",
    "or": "ରସ ସରସୀ ଦିଶା ଦେ ରେ ଥରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasa-sarasi-disa-de-re-thare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରସ ସରସୀ ଦିଶା ଦେ ରେ ଥରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରାଚୀର ପ୍ରାଚୀ ଅଚଳେ ଶ୍ରୀମୁଖ ଚନ୍ଦ୍ରମା",
          "ପୂର୍ବ ପରି କରାଅ ଉଦେ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କଥା ଶିଖାଇଲା ପରି ସାରୀକି ସୁଧୀରା",
          "ଶୁଭା ହେଲେ ବଚନ ପଦେ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାଗୁଣି ମାଗୁଛି ଏତେ ଡକାଇଲ ଛାମୁକୁ",
          "ଲେଖା ହେଲେ ଯାବକ ପଦେରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦେଖିଲା ଉତ୍ତାରୁ ତୋତେ ଯାଉ ପଛେ ପ୍ରାଣ",
          "ଦାରୁଣ ମଦନ ବିପଦରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହଇ ଗୋପାଳ ପଟ୍ଟନାୟକ ଧନ",
          "ଅନା ଆସି କରୁଣା ହୃଦରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
