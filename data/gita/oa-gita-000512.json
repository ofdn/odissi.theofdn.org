{
  "id": "oa-gita-000512",
  "name": {
    "en": "Jaya jaya pitabasana banamali",
    "or": "ଜୟ ପୀତବସନ ବନମାଳୀ"
  },
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaya-jaya-pitabasana-banamali-banikantha-nimai-harichandan/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜୟ ଜୟ ପୀତବସନ ବନମାଳୀ",
          "ଶ୍ୟାମତନୁ ମନହାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଉଦିତ ଅରୁଣଜିତ ଶ୍ରୀରଙ୍ଗଚରଣ ଭବଭୟ ତ୍ରୟତାପ ହାରୀ",
          "କୋଟି କୋଟି ଜୀବ ଶରଣପଞ୍ଜର ମରଣକ୍ଳେଶ ନିବାରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୂର୍ଣ୍ଣ କଳାକର କାନ୍ତି ଚୂର୍ଣ୍ଣକର ଶ୍ରୀମୁଖ ଲାବଣ୍ୟଧାରୀ",
          "ଜଗଜ୍ଜନ ମନୋରଥ ସାରଥୀ ଶ୍ରୀପତି ପାପ ପୁଣ୍ୟ ଅଧିକାରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଭୟ ଚରଣଯୁଗ ଭବଭୟ ବାରଣ ଶରଣଜନ ମୋକ୍ଷକାରୀ",
          "ସୁରଧୁନୀ ନିର୍ଝର ଶୁଦ୍ଧ ମକରନ୍ଦ ଆଦିକନ୍ଦ ଦଇତାରି"
        ]
      }
    ]
  },
  "sources": [
