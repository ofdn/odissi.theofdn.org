{
  "id": "oa-gita-000165",
  "name": {
    "en": "Ratantare natantare",
    "or": "ରତାନ୍ତରେ ନତାନ୍ତରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000065"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ratantare-natantare/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରତାନ୍ତରେ ନତାନ୍ତରେ",
          "ହେଲେ କେଡ଼େ ଅଳି ଲୋଳ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିଥିଳ କବରୀ ବାନ୍ଧୁ ବାନ୍ଧୁ",
          "ତରତରେ ଶାଢ଼ୀ ପିନ୍ଧୁ ପିନ୍ଧୁ",
          "କୋଟି ରାଣ ବୋଲି ପ୍ରାଣବନ୍ଧୁ ଭିଡ଼ି",
          "କଲେ କୋଳ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଇସି ମଲି ବୋଲି ବୋଲୁ ବୋଲୁ",
          "କର ସରସିଜେ ପେଲୁ ପେଲୁ",
          "ନଖ ଶିଖ ଖେଳ ସୁଖ କରାଇଲେ",
          "ପରବଳ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିବିଧ ବିନୟ କରୁ କରୁ",
          "ଚରଣ ପଲ୍ଲବ ଧରୁ ଧରୁ",
          "ଦନ୍ତକ୍ଷତ ପରିଚିତ କରିଦେଲେ",
          "ଗଣ୍ଡସ୍ଥଳ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନ ପାରଇ ବୋଲି କହୁ କହୁ",
          "ମୋ ଦେହ ବଞ୍ଚାଇ ରହୁ ରହୁ",
          "କାମ ଅମଳରେ ଶ୍ୟାମ ହେଲେ ଅତି",
          "ଅସମ୍ଭାଳ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କହେ ଅଷ୍ଟଦୁର୍ଗ ଧରାନାହା",
          "ଶୁଣି ସଖୀ ଜଣାଇଲେ ଏହା",
          "ପ୍ରିୟସହି ତୋର ସେହି ମନୋରଥ",
          "ଲତା ଫଳ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ratantare-natantare/"
    }
  ],
