{
  "id": "oa-gita-000435",
  "name": {
    "en": "Baraja bidhure ana",
    "or": "ବରଜ ବିଧୁରେ ଅନା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000193"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/baraja-bidhure-ana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବରଜ ବିଧୁରେ ଅନା ଅନା ଫେରି ସହୀ ରେ",
          "ନୀରଜ ନୟନୁ ନୀର ଝରି ପଡ଼େ ମହୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘୋର ଶୀତ ଆସେ ମାଡ଼ି",
          "ଘେରିଲା ଘନ କୁହୁଡ଼ି",
          "ଏ କାଳେ ତୋ ମାନ ଗୋରୀ ଦିଏ ମନ ଦହି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁମୁଦ ଗଲା ମଉଳି",
          "ଶଶୀ ତ ନ ଗଲା ଟଳି",
          "ତା ସରିକି ପ୍ରୀତି ରୀତି ଭାଳୁ ଚାନ୍ଦମୁହୀଁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରବି କମଳ ମିଳନ",
          "ସୁସାର ନୁହଁ ରେ ଧନ",
          "ଘେନାଘେନି କରି ମନ ଲୁଚେ ନିଶି କାହିଁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାଏ ବିତି ହିମ ରାତି",
          "କବିଶଶୀ ଏ ବଦତି",
          "କ୍ଷୀର ନୀର ସରି ସାରା ସରାଗ ତୋ ଚାହିଁ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
