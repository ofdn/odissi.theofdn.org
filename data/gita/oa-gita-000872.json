  "id": "oa-gita-000872",
  "name": {
    "en": "Mada gajagati mora",
    "or": "ମଦ ଗଜଗତି ମୋର"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000041"
  ],
  "mula_tala": [
    "oa-tala-000011"
