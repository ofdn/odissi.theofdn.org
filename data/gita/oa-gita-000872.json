    "id": "oa-kabya-000007"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mada-gajagati-mora-lalita-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଦ ଗଜଗତି ମୋର ବେଦନା କହ ସତ୍ୱର",
          "ମଦନମୋହନଙ୍କୁ ତୁ ମୁଦେ ଘେନି ଆରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାଦବ ଶେଖର ସଙ୍ଗ ଭେଦରୁ କ୍ଷୀଣ ମୋ ଅଙ୍ଗ",
          "ଖେଦ ମୁଁ ପାଉଛି ହୋଇ ମୋଦ ପଡ଼ିଆରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପତି ବର୍ଜନରୁ ପର ମୋର ହେଲେ ଭୃଙ୍ଗ କୀର",
          "ଶୀତକର କର ବାୟୁ ଧାତକୀ କିଆରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରିୟ ସଙ୍ଗ ବିହୀନରୁ ପ୍ରିୟ ସଖୀ ମୋର ଚାରୁ",
          "କାୟ ଜାଳୁଅଛି କାମ ଶାୟକ ନିଆଁରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଞ୍ଜନେତ୍ରେ ନାଚେ ମୋର ମଞ୍ଜୁତର ଲୀଳାସାର",
          "କୁଞ୍ଜେ ବିକ୍ରମ ସଙ୍ଖାଳି ଗୁଞ୍ଜମାଳିଆରେ"
        ]
      }
    ]
  },
