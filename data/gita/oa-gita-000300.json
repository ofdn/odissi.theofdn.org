{
  "id": "oa-gita-000300",
  "name": {
    "en": "Sangini re chahan benupaniki",
    "or": "ସଙ୍ଗିନୀ ରେ ଚାହାଁ ବେଣୁପାଣିକି"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000093"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangini-re-chahan-benupaniki/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗିନୀ ରେ ଚାହାଁ ବେଣୁପାଣିକି",
          "ଚିତ୍ତବିତ୍ତ ଚୋରା ଚିନ୍ତାମଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବକୁଳ ସେବତୀ ମଲ୍ଲୀ ନିଆଳୀ କିଆ",
          "ନାନା କୁସୁମେ କି ଶୋଭା ବାଙ୍କ ଟାହିଆ",
          "ତହିଁ ଖଞ୍ଜିଅଛି ରଙ୍ଗ ଜାମୁଡାଳି",
          "ସଙ୍ଗରେ ମୟୂର ଚନ୍ଦ୍ରିକା ପକ୍ଷୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭଲା ତାର ଯେଉଁ ନୟନ ଠାର",
          "ସେ କି ମାର ବୀର ଜୟକୁଠାର",
          "ଭୂରୁ ବାଙ୍କଛୁରୀ ଚାଲିବା ଚାତୁରୀ",
          "ଚଉଦପୁରେ କେ ନ ଥିବେ ଦେଖି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଧନ୍ୟ ତାର ଯେଉଁ ମୁରୁକି ହସା",
          "ସତେ କି ସେ ସୁଧା ନୀର ବରଷା",
          "ଚାହିଁଦେଲେ ଥରେ ଥରି ମନ୍ମଥରେ",
          "ଧଇର୍ଯ୍ୟ ଗୁମାନ କେ ପାରେ ରଖି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦାସ ବନମାଳୀ ବୋଲେ ଗୋ ଶୁଣ",
          "ଗୋପ ନନ୍ଦସୁତ ମୋହନ ଗୁଣ",
          "କୁଳବତୀ ବ୍ରତ କରିବାକୁ ହତ",
          "ନୂଆ ମଦନ ଏ ବରଜେ ଟିକି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
