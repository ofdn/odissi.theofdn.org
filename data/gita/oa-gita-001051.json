{
  "id": "oa-gita-001051",
  "name": {
    "en": "Jaa jaa re sangini tu",
    "or": "ଯା ଯା ରେ ସଙ୍ଗିନୀ ତୁ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000065"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jaa-jaa-re-sangini-tu-suratha-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯା ଯା ରେ ସଙ୍ଗିନୀ ତୁ",
          "ତା ଠାରେ ସାର ନାହିଁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କ୍ଷଣକ କଥା କ୍ଷଣକୁ ଯାର ନାହିଁ ରେ",
          "ତା ଭାବରେ ଭୁଲିଲେ ଉଦ୍ଧାର ନାହିଁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯେମନ୍ତ ଘନେ ବିଜୁଳି ଥିର ନାହିଁ ରେ",
          "ସେହିପରି ତୋ ସ୍ନେହରେ ଚିର ନାହିଁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ତାରେ ତ ଭିତର ବାହାର ନାହିଁ ରେ",
          "ସେ ଘେନି କହୁଛି ମୋର ମନ ନାହିଁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରଘୁନାଥ କହେ ଯା ସ୍ୱୀକାର ନାହିଁ ରେ",
          "ତାକୁ ବଳେ ନେବାକୁ ତ ଜୋର ନାହିଁ ରେ"
        ]
      }
    ]
  },
  "sources": [
