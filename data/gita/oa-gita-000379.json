{
  "id": "oa-gita-000379",
  "name": {
    "en": "Ki bhangi kala lo mita",
    "or": "କି ଭଙ୍ଗୀ କଲା ଲୋ ମିତ କି ଭଙ୍ଗୀ କଲା"
  },
  "composer": "oa-person-000076",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-bhangi-kala-lo-mita/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଭଙ୍ଗୀ କଲା ଲୋ ମିତ କି ଭଙ୍ଗୀ କଲା",
          "ମୁରଲୀ ସ୍ୱନେ ମୋ ଚିତ୍ତ ହଜାଇ ଦେଲା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରବି ପୂଜିବାକୁ ଗଲି ଯମୁନାର କୂଳକୁ",
          "ତ୍ରିଭଙ୍ଗିମା ଛବି ଦେଖି ଗଲି ନୀପମୂଳକୁ",
          "ଛନକାଇଲା ଲୋ ମିତ ଛନକାଇଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କର୍ଣ୍ଣକୁ ଶୁଭିଲା ମୋର କଟିଘଣ୍ଟି ଘାଗୁଡ଼ି",
          "ହସ୍ତରୁ ଝଡ଼ି ପଡ଼ିଲା ରବିପୂଜା ଚାଙ୍ଗୁଡ଼ି",
          "ଛନକାଇଲା ଲୋ ମିତ ଛନକାଇଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସେତେବେଳକୁ ଦକଦକ ହେଉଛି ମୋ ଶରୀର",
          "ଧରମରୁ ବଳିଗଲା ସରିଥିଲା ବିହାର",
          "କରମେ ଥିଲା ଲୋ ମିତ କରମେ ଥିଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜାଣୁ ଜାଣୁ କଳାକାହ୍ନୁ ଫାନ୍ଦରେ ମୁଁ ପଡ଼ିଲି",
          "କହେ କବିସୂର୍ଯ୍ୟ ବ୍ରହ୍ମା ଘରେ ରହି ସଢ଼ିଲି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
