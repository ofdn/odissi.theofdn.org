  "name": {
    "en": "Mana uddharana kara he karana",
    "or": "ମାନ ଉଦ୍ଧାରଣ କର ହେ କାରଣ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000023"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-uddharana-kara-he-karana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନ ଉଦ୍ଧାରଣ କର ହେ କାରଣ",
          "ଶରଣ ମୁଁ ତୁମ୍ଭ ପାଦତଳେ ।",
          "ଅନାଥର ନାଥ ନୀଳଗିରି ନାଥ",
          "ଜଗନ୍ନାଥ ନାମ ନୀଳାଚଳେ ।",
          "ମହୋଦଧୀ କୂଳେ କଳ୍ପବଟ ମୂଳେ",
          "ବିଜେ କରିଛ ବଡ଼ ଦେଉଳେ ।",
          "ଲକ୍ଷେ ଯୋଜନରେ ବାରଣ ଚିନ୍ତିଲା",
          "ତା ଡାକ ଶୁଣିଲ ପଶା ଖେଳେ ।",
          "ମାରକଣ୍ଡ ୠଷି ଯାଉଥିଲେ ଭାସି",
          "ଉଦ୍ଧରି ଧଇଲ ବାହୁତଳେ ।",
          "କିଷ୍କିନ୍ଧାକୁ ଗଲ ବାଳି ବିନାଶିଲ",
          "ବନ୍ଧ ହେ ବାନ୍ଧିଲ ସିନ୍ଧୁଜଳେ ।",
          "ଲଙ୍କାରେ ରାବଣ ବଧିଲ ଆପଣ",
          "ଜନକ ନନ୍ଦିନୀ ସୀତାଛଳେ ।",
          "ଯୁଧିଷ୍ଠିର ବୋଲେ ହସ୍ତିନାକୁ ଗଲ",
          "ଭୋଜନ କଲ ବିଦୁର ଘରେ ।",
          "କୁରୁସଭା ତଳେ ପାଞ୍ଚାଳି ଚିନ୍ତିଲା",
          "କୋଟି ବସ୍ତ୍ର ଦେଲ ଅବହେଳେ ।",
          "ବନପୋଡ଼ି କାଳେ ଘୋର ଦାବାନଳୁ",
          "ଉଦ୍ଧରି ଧଇଲ ବ୍ରଜବାଳେ ।",
          "ଭଣେ ଉପଇନ୍ଦ୍ର କବିକୁଳଚନ୍ଦ୍ର",
          "ଶରଣ ମୁଁ ତୁମ୍ଭ ପାଦତଳେ ।"
        ]
      }
    ]
  },
