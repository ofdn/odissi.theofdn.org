{
  "id": "oa-gita-000254",
  "name": {
    "en": "Ki nadare prana sangini",
    "or": "କି ନାଦରେ ପ୍ରାଣ ସଙ୍ଗିନୀ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-nadare-prana-sangini-bhairabi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ନାଦରେ ପ୍ରାଣ ସଙ୍ଗିନୀ ଶୁଭୁଛି କଦମ୍ବ ବନେ",
          "ଶ୍ରୁତିରେ ସୁଧା ବରଷି ଧୃତି ନାଶେ ମଜ୍ଜି ମନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିଗ ବିଦିଗେ ପ୍ରସରି ଖଗ ମୃଗ ଜଡ଼ କରି",
          "କୁଳବତୀ ନୀବି ଗ୍ରନ୍ଥୀ ଫିଟାଉଛି ଅଯତନେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜଳ ସ୍ତମ୍ଭ ଗ୍ରାବ ଦ୍ରବ ହୋଇଲା କି ଅସମ୍ଭବ",
          "ଆଜନମୁଁ ଆଜକୁ ମୁଁ ଶୁଣି ତ ନଥିଲି ଦିନେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆସୁ କିନା ମୋ ପାଶକୁ ଲଭିଲିଟି କି ଦଶାକୁ",
          "ନୀପ ଫୁଲ ପରି ଲୋମ ପୂରିଲା ମୋ ଅପଘନେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୋଳିଲା କୁସୁମ କରୁ ଗଳିପଡ଼ିଲା ରମ୍ଭୋରୁ",
          "ରହି ପାରିବି ନାହିଁ ମୁଁ ଛାଡ଼ି ଦେ ନେଇ ସଦନେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବଜାଉଛି ରସାଳସୀ ନିକୁଞ୍ଜ ଦେବତା ବଂଶୀ",
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷଇ ପ୍ରକଟିଲା ତ୍ରିଭୁବନେ"
        ]
      }
    ]
  },
  "note": {
    "en": "(Alternate version— Raga Bhairabi, Rupaka)"
  },
  "sources": [
