  "id": "oa-gita-001062",
  "name": {
    "en": "Ki abhimana kali prana dhana",
    "or": "କି ଅଭିମାନ କଲି ପ୍ରାଣଧନ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-abhimana-kali-prana-dhana-asabari-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଅଭିମାନ କଲି ପ୍ରାଣଧନ ଗୋ",
          "କର ଧରି କହୁ କହୁ ନ କହି ବଚନ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେ ପରାଣରୁ ଅଧିକ ତାହାକୁ ଅଧୀରେ",
          "ପର ପରି କରିଦେଲି ଦାରୁଣ ବୁଦ୍ଧିରେ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୟୂଖ ପଟଳୀ ସେବା ନିତି ଯାହା ଲାଗି",
          "ତାକୁ ରୁଷିବା କଥାକୁ ନ ପାରିଲି ଜଗି ଯେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯେ ଜଗତ ମୋହିପାରେ ମୁରଲୀ ବଜାଇ",
          "ତାହାକୁ ଦେଲି ମଦନେ ବିବେକ ହଜାଇ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୃଧା କ୍ରୋଧାବେଶେ ମୋର ମାନସ ମଜ୍ଜାଇ",
          "ଚିନ୍ତାହଜା ଚିନ୍ତାମଣି କରରୁ ହଜାଇ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦ୍ୱିଜ ରଘୁନାଥ ବୋଲେ ରାଧା ଗିରେ ତୋଷେ",
          "ସଖୀ ଆଣି ଭେଟାଇଲେ ଘନଶ୍ୟାମ ରସେ ସେ"
        ]
      }
    ]
  },
  "sources": [
    {
