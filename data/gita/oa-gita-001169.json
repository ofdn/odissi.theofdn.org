{
  "id": "oa-gita-001169",
  "name": {
    "en": "Malasri",
    "or": "ମାଗୋ ତାଳୁରେ ଚୂଳ ତା ପୀତବସନ"
  },
  "composer": "oa-person-000111",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/malasri-mahapurusa-jasobanta-dasa/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ମାଗୋ ତାଳୁରେ ଚୂଳ ତା ପୀତବସନ",
          "ଅଧର ରଙ୍ଗ ପଙ୍କଜ ଲୋଚନ",
          "ବାହୁବଳିଣ କଟି ପାଟଡୋର",
          "ପୁଣି ଅଧର ରଙ୍ଗ ଲାଳେ ଜରଜର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୃଷ୍ଣ ତୁଣ୍ଡେ ମାୟେ ଦେଲେ ଲବଣୀ",
          "ବୋଇଲେ ଝୁଲ ବେଣୁଧର ପାଣି",
          "ମାତାଙ୍କ ବଚନେ ଝୁଲେ ମାଧୋଇ",
          "ପୁଣି କୃଷ୍ଣ ଝୁଲନ୍ତେ ଜଗତ୍ର ଝୁଲଇ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅଶେଷ ବ୍ରହ୍ମାଣ୍ଡ ଯେଉଁ ପ୍ରଭୁ ଠାକୁର",
          "ଝୁଲନ୍ତେଣ ମହୀ ଝୁଲେ",
          "ତ୍ରାସ ପାଇଂ ମାୟେ ଧଇଲେ କୋଳେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମାୟେ ବୋଇଲେ ୟେ ଗୋ ବିପରୀତ",
          "କୃଷ୍ଣ ଝୁଲନ୍ତେ ଝୁଲନ୍ତି ଜଗତ",
          "ପୁଅକୁ ନିକି କିଛି ମୋର ଥାଇ",
          "ଅଯାଗେ ନିକି ଦୃଷ୍ଟି ପଡ଼ିଥାଇ",
          "ହରଚଣ୍ଡୀକି ସୁମରଣା କରନ୍ତେ",
          "ପୁଅ ରିଷ୍ଟ ଯାଉ ନାଶ",
          "ପୁଣି ଯଶୋବନ୍ତ ଦାସ ଦାସର ଦାସ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/malasri-mahapurusa-jasobanta-dasa/"
    }
  ],
