  "name": {
    "en": "Na ja tapanaja tataku",
    "or": "ନ ଯା ତପନଜା ତଟକୁ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-ja-tapanaja-tataku-asabari-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ ଯା ତପନଜା ତଟକୁ",
          "ଗଲେ ଭେଟିବୁଟି ବିଟରାଟକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପତିବ୍ରତୀ ତତିଙ୍କି ଦେଖି",
          "ଭୂରୁଭଙ୍ଗୀ କରି ତା ଆଖି",
          "କଟାରୀ ଓଟାରି ନିଠାଇ ମାରଇ",
          "ଫଟାଇ ଦିଅଇ ଧୃତି ଘଟକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନଟବର ପୀତପଟିଆ",
          "ଲମ୍ପଟିଆ ନଟକୂଟିଆ",
          "ଘାଟ ଦିଅ ବୋଲି ବାଟ ଓଗାଳିବ",
          "ଲଗାଇବ କେତେ ରୂପେ ନଟକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଟାବଟା କରି କହିବ",
          "ହଟହଟା କରାଇ ଦେବ",
          "ମିଠା କଥାଯାକ ସିଠା ଲାଗିବଟି",
          "ଶୁଭିଯିବ ଯେବେ ବ୍ରଜ ହାଟକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାଟି ତୋର ମରଜୀ ଗୀତ",
          "ରଟିବାକୁ ସନ୍ତତେ ମିତ",
          "ଜଟିଳା କୁଟିଳା ତ୍ରୁଟି ନ କରିବ",
          "କହିଦେବ ମଧୁପୁର ଘାଟକୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯୁବରାଜ ବୀରବିକ୍ରମ",
          "ଦେବ ଭାଷେ ଛାଡ଼ ତା ପ୍ରେମ",
          "ଫିଟାଇ କହୁଛି ନିପଟ କପଟ",
          "ମୂରତି ଜାଣ ସେ ନନ୍ଦଚାଟକୁ"
        ]
      }
    ]
  },
  "sources": [
