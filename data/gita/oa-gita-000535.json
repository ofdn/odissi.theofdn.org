{
  "id": "oa-gita-000535",
  "name": {
    "en": "Mohana madhuri dekhithila nari",
    "or": "ମୋହନ ମାଧୁରୀ ଦେଖିଥିଲା ନାରୀ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohana-madhuri-dekhithila-nari-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନ ମାଧୁରୀ ଦେଖିଥିଲା ନାରୀ",
          "ନିଦ ଯିବକି ଆହୁରି ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୃଷ୍ଟିପାତ ଠାରେ ଅନୁବରତରେ",
          "ଛବି ଦିଶିବ ତାହାରି ରେ",
          "ପାଶକୁ ଆସିଲା ପରି ଲାଗୁଥିବ",
          "ହସି ହସି ବଂଶୀଧାରୀ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ସହିବ ନାହିଁ କେଉଁ ଦେବତାଙ୍କୁ",
          "ତା ପ୍ରୀତି ପାଇଁ ଜୁହାରି ରେ",
          "ସବୁ ବରତ କରିବି ବୋଲୁଥିବ",
          "ପାଇଲେ କୁଞ୍ଜବିହାରୀ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୃଷ୍ଣ ବୋଲି କେଣେ କାହିଁକି କେ ତେଣେ",
          "ଡାକିଲେ ପୂରୁଁ ବାହାରି ରେ",
          "ଚଉଦିଗକୁ ଚାହିଁ ମାର ମୋଦରେ",
          "ହୋଇ ନ ଯିବକି ଘାରି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଳିନ୍ଦଜା ତୀରେ ନିକୁଞ୍ଜ କୁଟୀରେ",
          "ନିଛାଟ କାଳ ବିଚାରିରେ",
          "ମିଳିବା ପାଇଁକି କେତେ ଥର ହେଲେ",
          "ଆଣି ନ ଯିବ କି ବାରି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସୁଗୁଣ ସୁନ୍ଦରପଣ ଯାକ ଗୁଣି",
          "ଏକାଇ ତାକୁ ହିଆରି ରେ",
          "ବୋଲେ ଗୋପାଳକୃଷ୍ଣ ଜୀବ ଥିଲେକି",
          "ଯିବ ମନରୁ ପାଶୋରିରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohana-madhuri-dekhithila-nari-gopalakrusna/"
    }
  ],
