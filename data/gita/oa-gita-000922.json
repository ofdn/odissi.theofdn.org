    "id": "oa-kabya-000005"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chala-chala-pranasahi-sankarabharana-basanta-rahasa-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାଲ ଚାଲ ପ୍ରାଣସହି ଦେଖିବା ଯାଇ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାସରସ ରଙ୍ଗିଲା ହୋଇ କେତେ ଛଇଲା",
          "ମୋହନ ମନକୁ ଆଜି ଅଛନ୍ତି ମୋହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ଯାମ ଲବ କରୁଣା ଲଭି କେତେ ପ୍ରବୀଣା",
          "ରାସୋତ୍ସବେ ମାତି କମ୍ପାଉଥିବେ ମହୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆହା ସେ ସୁଖ ଭାଗ୍ୟ ଲଭିବାକୁ ମୁଁ ଯୋଗ୍ୟ",
          "ନ ହେଲି ପୂର୍ବେ ତ ସୁକୃତ କରିନାହିଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶୁଣି ଶ୍ରୀମତୀ ଗିର ସଖୀ ନେଇ ସତ୍ୱର",
          "ଦେଖାଏ ରାଜେନ୍ଦ୍ର ଭଣେ କୃଷ୍ଣଙ୍କୁ ଧ୍ୟାଇ"
        ]
      }
    ]
  },
  "sources": [
