{
  "id": "oa-gita-001282",
  "name": {
    "en": "Radhe mohana thare kopa",
    "or": "ରାଧେ ମୋହନ ଠାରେ କୋପ"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000158"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radhe-mohana-thare-kopa-ghantaraba-gourachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧେ ମୋହନ ଠାରେ କୋପ ବହିଲୁ",
          "ଦୁଃଖସରେ ମନହଂସ ଖେଳାଇଲୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୟାମ ତୋ ଗଳାମାଳି ବଂଶୀରେ ହେଲି ବୋଲି",
          "ଡାକୁଥିଲେ ଶ୍ରବଣରେ ନ ଶୁଣିଲୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାରଣ ବିନା ଗୋରୀ ଏଡ଼ିଲୁ ସୁଖ ଶିରୀ",
          "ପାଖେ ଉଭା ହୋଇଲେ ସେ ନ ଚାହିଁଲୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବ୍ରଜରେ ତୋର ପରି ନାହାନ୍ତି କେତେ ନାରୀ",
          "କରେ କର ଧରନ୍ତେ ତୁ ଛାଟିଲୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାହାର ଖଚ ଗୀର କରିଣ ଜପାମାଳ",
          "ସ୍ମରକାଣ୍ଡରେ ଏବେ ଘାରିହୋଇଲୁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୌରଚନ୍ଦ୍ର ଭୂପତି ଭାଷନ୍ତି ଗୋ ଶ୍ରୀମତୀ",
          "ବନ ମାଳତୀ ଗତି ତୁହି ପାଇଲୁ"
        ]
      }
    ]
  },
  "sources": [
