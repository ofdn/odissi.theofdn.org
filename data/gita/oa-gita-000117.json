{
  "id": "oa-gita-000117",
  "name": {
    "en": "Mo bhale thila ki lihi",
    "or": "ମୋ ଭାଲେ ଥିଲା କି ଲି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000021"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mo-bhale-thila-ki-lihi-gouri-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋ ଭାଲେ ଥିଲା କି ଲିହି",
          "କଲି ମଲ୍ଲୀ ରୋପଣ ତହୁଁ ଜନ୍ମିଲା ତୃଣ",
          "ଚିନ୍ତା ରତନଗଣ ହେଲା ପାଷାଣ କଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚୂତ ଫଳିଲା ନାଗରଙ୍ଗ",
          "କଟି ମେଖଳା ହେଲା ଭୁଜଙ୍ଗ",
          "ତଟିନୀ ତଟେ ବାସ କରି ନ ଗଲା ଶୋଷ",
          "ପିଇବାର ପୀୟୂଷ ପାନରେ ହେଲା ବିଷ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଧୁ ଶାକର ହେଲା ନିମ୍ବ",
          "ରବି ପରି ହେଲା ଚନ୍ଦ୍ରବିମ୍ବ",
          "ଧାତାର କି ବିବେକ ଚଞ୍ଚୁଜିତ କିଂଶୁକ",
          "ପଢ଼ା ପଣ୍ଡିତ ଶୁକ ହେଲା ମୋ ଦ୍ରୋଣ କାକ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନ୍ଦାକିନୀରେ ନିମଜ୍ଜିଲି",
          "ନିନ୍ଦା କାହିଁକି ଅରଜିଲି",
          "ଚଢ଼ିଲି ମେରୁଚୂଳ ଭୋଗ ହେଲା ଅତଳ",
          "ବ୍ରହ୍ମଜାତି ପାଟଳ ହୀରା ହେଲା ପିତ୍ତଳ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଉ ନ ରମିବି ନବୀନା",
          "ଜୀବନ ଯିବ ତାଙ୍କ ବିନା",
          "ଏ ଚିନ୍ତାର ମନ୍ଦିର ହେଲେ ଶ୍ୟାମସୁନ୍ଦର",
          "ବନ୍ଦଇ ଜଳନ୍ତର ଅବନୀ ପୁରନ୍ଦର"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
