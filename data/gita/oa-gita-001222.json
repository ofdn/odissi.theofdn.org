{
  "id": "oa-gita-001222",
  "name": {
    "en": "Parameswara sri krusna brajendra kumara he",
    "or": "ପରମେଶ୍ୱର ଶ୍ରୀ କୃଷ୍ଣ ବ୍ରଜେନ୍ଦ୍ର କୁମାର ହେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/parameswara-sri-krusna-brajendra-kumara-he-malabagouda-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପରମେଶ୍ୱର ଶ୍ରୀ କୃଷ୍ଣ ବ୍ରଜେନ୍ଦ୍ର କୁମାର ହେ",
          "ଯୁଗାନୁସାରରେ କରୁଛନ୍ତି ଅବତାର ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ରୀ ବଳରାମ ଶ୍ରୀ ନାରାୟଣ ଯା ବିଳାସ ହେ",
          "ଶ୍ରୀ ନୃହରି ବାମନ ରଘୁବର",
          "କେ କେତେ କଳାରେ ହେଲେ ପ୍ରଚାର",
          "ଅଂଶ ଲେଶଟି ଆନ ଅବତାର",
          "ସର୍ବୋତ୍ତଂସ ଶ୍ରୀ ରାଧା ପ୍ରାଣ ଯାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୃତ ଯୁଗରେ କୋଟି ଦ୍ୟୁମଣି ଚନ୍ଦ୍ର ଦ୍ୟୁତି ହେ",
          "ଧରି ହେଲେ ଅଦ୍ୱିତୀୟ ନୃକେଶରୀ ମୂର୍ତ୍ତି ହେ",
          "ସୁପର୍ବଣଙ୍କ ଦୁଃଖ ନିର୍ବାପଣ",
          "କରିବାକୁ ହୋଇ ଅତି ଭୀଷଣ",
          "ପୁଣ୍ୟଜନ କୁଳ ଚକ୍ରବର୍ତ୍ତୀର",
          "ପ୍ରାଣ ନେଲେ ନଖେ ଚିରି ଶରୀର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତ୍ରେତା ଯୁଗେ ଅଭିରାମ ରାମ ରୂପ ଧରି ହେ",
          "ଦଶରଥ ପୁଣ୍ୟପୁଞ୍ଜ ଅରଣ୍ୟେ ବିହରି ହେ",
          "ଧରାଭରା ଦଶ ଶିର ସଗୋତ୍ର",
          "ସହ ନାଶି କଲେ ଲୋକେ ପବିତ୍ର",
          "ସୁର ପୁରକୁ ସ୍ୱଦାସ ନିକର",
          "ସଙ୍ଗେ ନେଇ କଲେ ଦେବ ଶରୀର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦେବକୀ ସୁତ ରୂପରେ ହୋଇ ଆବିର୍ଭାବ ହେ",
          "ଦ୍ୱାପରେ ଗୋପ ପୁରରେ ପାଳି ଗୋବ ଗାବ ହେ",
          "ପୂର୍ଣ୍ଣ ପୂର୍ଣ୍ଣୋତ୍ତର ରୂପେ ପ୍ରକାଶ",
          "ହୋଇ ପିଷ୍ଟପ ଦୁଷ୍ଟ ନାଶ",
          "ମଥୁରା ଦ୍ୱାରାବତୀରେ ବିହାର",
          "ଦ୍ୱିସପ୍ତ ଲୋକେ ହୋଇଛି ପ୍ରଚାର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପୂର୍ଣ୍ଣୋତ୍ତମ ରାଧା ପ୍ରାଣନାଥ କୃପାସିନ୍ଧୁ ହେ",
          "ବ୍ରଜ ଯୁବତୀ ନିରଭସନ୍ଧ ପ୍ରେମ ବନ୍ଧୁ ହେ",
          "ସ୍ୱପ୍ରେମ ଦେବାକୁ କଳିଯୁଗରେ",
          "ସଂକୀର୍ତ୍ତନ ପ୍ରିୟ ଶଚୀ ଗର୍ଭରେ",
          "ଜନ୍ମିଲେ ଶ୍ରୀ ପ୍ରତାପରୁଦ୍ରଙ୍କର",
          "ଜୀବନର ପ୍ରଭୁ ଗୌରସୁନ୍ଦର"
        ]
      }
    ]
  },
