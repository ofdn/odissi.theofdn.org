{
  "id": "oa-gita-000584",
  "name": {
    "en": "Sarada sangi brundabana sundara",
    "or": "ଶରଦସଂଗି ବୃନ୍ଦାବନ ସୁନ୍ଦର"
  },
  "composer": "oa-person-000114",
  "mula_raga": [
    "oa-raga-000154"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sarada-sangi-brundabana-sundara-suda-krusna-dasa-badajena-mahapatra-gitaprakasa/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "( ଧନ୍ନାସୀରାଗେଣ — ସୂଡ଼ପ୍ରବନ୍ଧ )"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶରଦସଂଗି ବୃନ୍ଦାବନ ସୁନ୍ଦର",
          "ପୂର୍ଣ୍ଣଚନ୍ଦ୍ରରୁଚି ଭାଜିଦିଗନ୍ତର",
          "କାଶଭାସଶୁଭମେଦିନି ପରିସର",
          "ନିର୍ଜଳଜଳଧର ପାଣ୍ଡର ଅମ୍ବର ।",
          "କମଳକୁମୁଦଶୁଚି କାଳିନ୍ଦିନୀର",
          "ରାଜହଂସସିତ ପୁଳିନ ମନୋହର",
          "ନନ୍ଦନନ୍ଦନ ଆନନ୍ଦେନ କିମେ",
          "ଶୁଦ୍ଧ ବେଶ ଋତୁ ରାଜିତୁ ଆ । ଇତ୍ୟାଦିତାଳଃ ।"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶରଦ ଋତୁରାଜ ଏହୁ ରାଜିତ ଦିଗନ୍ତା",
          "ପେଖ୍‌ଖି ବହୁ ହରଷ ହରି ମଦନରସବନ୍ତା ।",
          "କାଳିନ୍ଦିତଟନିକଟ କୁଞ୍ଜେ ବସନ୍ତା",
          "ରାସରସେ କେଳି ମନ ସହ ଗୋପକାନ୍ତା ।",
          "ନିଖିଳଜନ ନୟନମନ ରୂପେ ହରନ୍ତା",
          "ନିରୁପମା ଲାବଣ୍ୟ ସକଳସୁଖଦେନ୍ତା । ଇତି ଝମ୍ପକଃ ।"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆ ବେଣୁଧରି ହରି ବାଦନ କରୁରେ",
          "ବନ ହରିଣ ପକ୍ଷିଗଣ ଧୁନି ଶୁନିରେ",
          "ଆରେ ନିଶ୍ଚଳା ତନୁଜନୁ ଯୋଗ ସାଧନୁରେ । ଇତି ଅଡ୍ଡତାଳଃ ।"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବେଣୁଧୁନି ଶୁଣି ଗୋପିଜନ୍ନା",
          "କୁସୁମଶରଶର ବେଧି ତନ୍ନା",
          "ଏକୁ ସମୟେ ତେଜୁ ଭବନା",
          "ସର୍ବସୁଖ ଜଳ କହୁ ଆ । ଇତି ତ୍ରିପୁଟଃ ।"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆ ଆ ନନ୍ଦନନ୍ଦନ ଲାଗି କାମିନି ନଗନ ଲେ ଆ । ଇତି ଯତିଃ ।"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବେଣୁଧୁନ୍ନି ଅନ୍ନୁସାରି ଗୋପନାରିରଙ୍ଗିନୀ",
          "ପୁଲକପୂର ପୁରି କପୋଳ ସ୍ୱେଦବିନ୍ଦୁସଙ୍ଗିନୀ ।",
          "ଧାଇ ବେଗ ମନ୍ତ୍ର ଆଗ ପାଛୁଲାଗ ସହଚରୀ",
          "ପ୍ରାଣନାଥ ଅଭିସରଳ୍ଳ କଳସଙ୍ଗ ପରିହାରି । ଇତି ମଣ୍ଠଃ ।"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ପେଖତୁରେ ବ୍ରଜତରୁଣୀଜନ ବୃନ୍ଦାବନନୟନାନନ୍ଦନ",
          "କାୟକାନ୍ତି ନବଘନଶୋଭନ ତରୁଣ ମନମୋହନ ଇଆ ।",
          "ଶିଖିଶିଖଣ୍ଡମଣ୍ଡିତକୁନ୍ତଳ",
          "ମାଳତିମାଳ ଗୁଞ୍ଜ ମଞ୍ଜୁଳ",
          "ଗଣ୍ଡସ୍ଥଳବିଲୁଳିତ ମୁଖଜିତବିଧୁମଣ୍ଡଳ ଇଆ । ଇତି ନିଃସାରିକଃ ।"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କନକକଳିତ କଙ୍କଣକର କିଙ୍କିଣିପଦଲମ୍ବିତମ୍",
          "ମଧୁରମୁରଲୀ ମୋହନଧୁନି ଅଧର ବିମ୍ବଚୁମ୍ବିତମ୍ ।",
          "ପ୍ରାଣନାଥ ସନିଧ ମିଳଳେ ରଙ୍ଗେ ଗୋପବାଳିକା",
          "ସାନନ୍ଦେ ଦେଇ ନୟନେ ନୟନ ନୀଳନଳିନମାଳିକା । ଇତି ଉପାଡ୍ଡତାଳଃ ।"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ନାସେ ମୁକୁତାଗଳ ଉରେ ବନମାଳା",
          "ଅରୁଣକମଳଦଳନୟନ ବିଶାଳା",
          "ପୀତବସନ ଶ୍ୟାମସୁନ୍ଦର ଦେହା",
          "ନୀଳଜଳଦେ ଜନୁ ବିଜୁଳି ରେହା । ଇତି କୁଡୁକ୍କଃ । ପଡ଼ିତାଳ ଇତି ପ୍ରସିଦ୍ଧିଃ ।"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଆଜୁ ଭେଟଲ୍ଲ ନନ୍ଦକିଶୋରା",
          "ମଦନମୋହନରୂପ ଜୀବନ ହମାରା । ଇତି ରୂପକଃ ।"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ପରମ ମୋହନରୂପ ପରଂବ୍ରହ୍ମମୟ",
          "ମନୁଜ ଭକ୍ତ ଗୋପୀଜନ",
          "ବାଞ୍ଛାପୂରଣ ଉଚିତ ରାସବନ୍ଦନାଖଚିତ",
          "ସୂଡ଼ ପ୍ରବନ୍ଧ କୃଷ୍ଣଦାସ କବି ବିରଚିତ",
          "ପ୍ରଚରତୁ ଆଚନ୍ଦ୍ରତାରକ ଇଆ । ଇତ୍ୟାଲୋପୋଽତାଳଃ ।"
        ]
      },
      {
        "n": 12,
        "lines": [
          "କମଳାସନ ଶିବ ସହିତ ପୁରନ୍ଦର",
          "ମୁଖ୍ୟ ଅମରବର ପୂରିତ ଅମ୍ବର",
          "ପୁଷ୍ପବୃଷ୍ଟିକର କିନ୍ନର ଅପସର",
          "ଦୁନ୍ଦୁଭିଶବଦ ଦିଗନ୍ତର ଆ ।",
          "ରାସେ ରସିକ ମୁରାରି ନାରିଗଣ",
          "ସଙ୍ଗ ରଙ୍ଗରସ ବିରଚିତ ବିହରଣ",
          "ଚଉଦିଶ ଉଦିଲେ ଅମୃତ କିରଣ",
          "ଅମଳକମଳଯୁଗ ଧାରଣୁଆ । ଇତ୍ୟେକତାଳୀ ।"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ଶରଦସଙ୍ଗ ଇତ୍ୟତ୍ର ମାନମ୍ ।"
        ]
      }
    ]
  },
