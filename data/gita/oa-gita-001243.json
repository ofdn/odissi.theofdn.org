{
  "id": "oa-gita-001243",
  "name": {
    "en": "Mohana banchai kahile ki heba aau",
    "or": "ମୋହନ ବଞ୍ଚାଇ କହିଲେ କି ହେବ ଆଉ"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mohana-banchai-kahile-ki-heba-aau-kamodi-aditala-biramitrodaya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋହନ ବଞ୍ଚାଇ କହିଲେ କି ହେବ ଆଉ",
          "ଶ୍ୟାମ ହେ ଛନ୍ଦ ବଚନରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପାଳି ସ୍ନେହ ତୋଷରେ କାଲି କାହା ବାସରେ",
          "ବଳୀଶୋଭୀ ପାଶରେ ମିଳି ସୁବେଶରେ",
          "ସଲୀଳ ହାସରେ",
          "ଛଳି ବାନ୍ଧି ରଖିଲା ଦୃଢ଼ ଭୁଜପାଶରେ",
          "ଭୁଲି ପରିହାସରେ",
          "କଳି କି ନ ପାରିଲ ରଜନୀ ବିଶେଷରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବ ଚତୁରୀବର ଅବଧାନ ମାତର",
          "ଅବଶେ ତରତର ହେ ନବ ଜଳଧର",
          "ସୁବର୍ଣ୍ଣ ସୁନ୍ଦର",
          "ଅବଶ୍ୟ ଭିଡ଼ିଥିବ ଲଗାଇ ଭୁଜାନ୍ତର",
          "ତବ କଳେବର",
          "ଅବଲୋକନେ ଦିଶେ କୁଙ୍କୁମେ ଜରଜର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଧରି କି ଅଭିମାନ ପରିଚାର ଗୁମାନ",
          "କରିଥିଲା ସେ ମାନ ହରି ତା ସମ୍ମାନ",
          "କରି ଗୁଣଗାନ",
          "ଧରି ଚରଣ ଶିର ଲଗାଇ କଲ ମାନ୍ୟ",
          "ପରିଶେଷ ମାନ",
          "କରିଛି ପଦ ଲାକ୍ଷା ଚନ୍ଦ୍ରକେ ଦ୍ୟୋତମାନ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରସିକା ସେ କୋଳରେ ବଞ୍ଚିବାର କାଳରେ",
          "ମିଶି ପ୍ରେମ ଭୋଳରେ ହସି ଚପଳରେ",
          "ରସି କପୋଳରେ",
          "ଘଷି ଗଣ୍ଡ ଚୁମ୍ବିଛି ତା ତାମ୍ବୂଳ ବୋଳରେ",
          "ବସିଛି ଉଜ୍ଜ୍ୱଳରେ",
          "ଭାଷିଲା ବୀରମିତ୍ରୋଦୟ କହି ଛଳରେ"
        ]
      }
    ]
  },
