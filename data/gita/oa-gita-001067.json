{
  "id": "oa-gita-001067",
  "name": {
    "en": "Chhadi dia manu chinta",
    "or": "ଛାଡ଼ି ଦିଅ ମନୁ ଚିନ୍ତା"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000068"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhadi-dia-manu-chinta-he-mohana-benudhara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଛାଡ଼ି ଦିଅ ମନୁ ଚିନ୍ତା ହେ ମୋହନ",
          "ଛାଡ଼ି ଦିଅ ମନୁ ଚିନ୍ତା",
          "ଆହା ଧନମାଳୀ ଶିଖଣ୍ଡମଉଳି",
          "ପାଇଲେଣି କେତେ ବ୍ୟଥା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚଞ୍ଚଳ ବିଜୟ କର କଳାକାହ୍ନୁ",
          "ଚଞ୍ଚଳ ବିଜୟ କର",
          "ଅଞ୍ଚଳରେ ମୁହଁ ପୋଛି ପୋଛି ଯାଅ",
          "ଯାହାର ସେ ଜରଜର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କହିବ ହେଲେ ତା ଆଗେ ହେ ମୋହନ",
          "କହିବ ହେଲେ ତା ଆଗେ",
          "କରୁଣା ବଡ଼ୀଶେ ଅରୁଣ ଅଧରୀ",
          "ଘେନିବେ ଅତି ସରାଗେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତହୁଁ କହିଲେ ମୋହନ କାନ୍ଦି କାନ୍ଦି",
          "ତହୁଁ କହିଲେ ମୋହନ",
          "କବିଚନ୍ଦ୍ର ବେଣୁଧର କହେ ଦୁଃଖେ",
          "ଛନ୍ଦା ପାଦେ କରି ଧ୍ୟାନ"
        ]
      }
    ]
  },
  "sources": [
