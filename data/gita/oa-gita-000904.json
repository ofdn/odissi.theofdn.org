{
  "id": "oa-gita-000904",
  "name": {
    "en": "Chahinchi sina syamala",
    "or": "ଚାହିଁଛି ସିନା ଶ୍ୟାମଳ"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chahinchi-sina-syamala-khambaja-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚାହିଁଛି ସିନା ଶ୍ୟାମଳ ଶ୍ୟାମ ଠାମକୁ",
          "ଯମୁନା କଦମ୍ବ ମୂଳେ ଉଭା ସେ ଜିଣି କାମକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମିଶିଗଲା ଯେବେ ଆଖି କି ଅଠାରେ ଗଲା ଲାଖି",
          "କେତେ ବିଚାରିଲି ସଖୀ ତୁଟାଇବୁ ଯୋଖାଯୋଖି",
          "(ପଡ଼ି)",
          "ପଲକ ଫେରି ମୋର ସତେ ବିନ୍ଧିଲା ଶର",
          "କହି ସେ କି ମନ୍ତର ଦହିନେଲା ଅନ୍ତର",
          "ଅବଶ ହେଲା ଗୋ ଅଙ୍ଗ ଭଜିଲି ପରା ଝାମକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କାହିଁକି ଦୋଷୁରୁ ସଖି କାଳ ମୋର ପୋଡ଼ା ଆଖି",
          "କଜଳର ଗିରା ସାକ୍ଷୀ ସବୁ ତ ସେ ଅଛି ଦେଖି",
          "(ପଡ଼ି)",
          "ଅଦେଖା ଲେଖାଲେଖି ଆଖିରେ ଦେଲା ଡାକି",
          "ଦେଲି ଜୀବନ ଟେକି ହେଲି ତା ପାଦେ ବିକି",
          "କବିଚନ୍ଦ୍ର ଭଣେ ସେ ତ ଟାଣିନେଲା ତା ବାମକୁ"
        ]
      }
    ]
  },
