{
  "id": "oa-gita-000501",
  "name": {
    "en": "Kahibaku laja maduchhi",
    "or": "କହିବାକୁ ଲାଜ ମାଡ଼ୁଛି ସଜନୀ ଗୋନ କହି ତ ରହି ପାରୁ ନାହିଁ ଗୋଆହେ ଘନଶ୍ୟାମ ଯାହା କଲେ ଆଗୋଶୁଣିଗଲେ । ଘୋଷା । ସହିପାରେ କେହି ପାଶରେ ନ ଥିଲେବସି ଫୁଲ ଗୁନ୍ଥୁଥିଲି ମୁହିଁମୁହିଁ ଅନୁରାଗ ପାଞ୍ଚେ ତନୁ ସଙ୍ଗଗାଉଥିଲେ ଗୀତ ହର୍ଷ ହୋଇ ରହିଥିଲେ କାହିଁ ସେ କଳାକହ୍ନାଇଦିନେ"
  },
  "composer": "oa-person-000027",
  "mula_raga": [
    "oa-raga-000132"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
