    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କହିବାକୁ ଲାଜ ମାଡ଼ୁଛି ସଜନୀ ଗୋ",
          "ନ କହି ତ ରହି ପାରୁ ନାହିଁ ଗୋ",
          "ଆହେ ଘନଶ୍ୟାମ ଯାହା କଲେ ଆଗୋ",
          "ଶୁଣିଗଲେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସହିପାରେ କେହି ପାଶରେ ନ ଥିଲେ",
          "ବସି ଫୁଲ ଗୁନ୍ଥୁଥିଲି ମୁହିଁ",
          "ମୁହିଁ ଅନୁରାଗ ପାଞ୍ଚେ ତନୁ ସଙ୍ଗ",
          "ଗାଉଥିଲେ ଗୀତ ହର୍ଷ ହୋଇ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରହିଥିଲେ କାହିଁ ସେ କଳାକହ୍ନାଇ",
          "ଦିନେ"
        ]
      }
    ]
  },
