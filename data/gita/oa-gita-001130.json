{
  "id": "oa-gita-001130",
  "name": {
    "en": "Sundara tote e riti",
    "or": "ସୁନ୍ଦର ତୋତେ ଏ ରୀତି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sundara-tote-e-riti-kaphi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସୁନ୍ଦର ତୋତେ ଏ ରୀତି କି ରେ ନବ ରସବତୀ",
          "ସଂପ୍ରତି ଶଯ୍ୟା କଲୁ ଧରତୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତେଜି ଅଶନ ଶୟନ ସୁବର୍ଣ୍ଣ ତୋରା ବରନ",
          "ଜୀବନ ବନ୍ଧୁ କଲୁ ମଳିନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାଳୁତ କାଳୁ ସେ ହରି ଜାଣିଛୁ ନାଶିଛି ନାରୀ",
          "କିଶୋରୀ ଦେଲୁ କି ରେ ବିସୋରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବ୍ରଜବଧୂ ଶତଭୁକ୍ତ ମୁକ୍ତ ଜନେ ଅନରକ୍ତ",
          "ଅଯୁକ୍ତ ବୋଲୁ ହେଲୁ ଆସକ୍ତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷଇ ଲଳିତା ଅଙ୍କେ ପକାଇ",
          "ଘେନାଇ କହିବାର ଚିହ୍ନାଇ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
