        "lines": [
          "ଗୌଡ଼ ରାଗ ରୂପ ମଧୁର",
          "ଆଦରେ ଗାଅ ଗୁଣି ଚତୁର"
        ]
      },
      {
        "n": 1,
        "lines": [
