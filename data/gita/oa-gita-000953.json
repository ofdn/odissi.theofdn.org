{
  "id": "oa-gita-000953",
  "name": {
    "en": "Ghana barana madana mohananku",
    "or": "ଘନ ବରନ ମଦନମୋହନଙ୍କୁ"
  },
  "composer": "oa-person-000132",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ghana-barana-madana-mohananku/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘନ ବରନ ମଦନମୋହନଙ୍କୁ",
          "ଛନ୍ନଛନ୍ନ ହୋଇ ଚାହିଁଲୁକି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବନ ପାଇଁ ଯାଇ ବନ ପଛେ ରହି",
          "ଥନଥନ ନେତ୍ରେ ଥରିଲୁକି ଗୋ",
          "ନନ୍ଦନନ୍ଦନ ବଦନ ଚନ୍ଦ୍ରମାକୁ",
          "ଦେଖି ପ୍ରିୟସଖୀ ଡରିଲୁକି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଜନଶୂନ୍ୟ ଯମୁନାତଟ ଘାଟରେ",
          "ଏକୁଟିଆ ଠିଆ ହୋଇଲୁକି ଗୋ",
          "ନଟକୂଟିଆ କପଟିଆ ଭୟରେ",
          "କରୁ କଳସୀ ଖସାଇଲୁକି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଧନ ଜୀବନ ଯୌବନ ରତନକୁ",
          "ତା ରୂପ ସ୍ରୋତେ ଭସାଇଲୁକି ଗୋ",
          "ତାର ନୟନ କୃପାଣେ ଖରଶାଣ ବାଣେ",
          "ହୃଦପଥର ଘଷାଇଲୁକି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନମନ୍ଦିରେ କାଳନ୍ଦୀ ନଦୀ ତୀରେ",
          "କାଳିଆ ନାଗକୁ ପାଳିଲୁକି ଗୋ",
          "ଢାଳି କାଳକୂଟ ଜାଳିଦେଲା ବେଳେ",
          "ଆଳିସଙ୍ଗେ ଭାଳି ନୋହିବୁକି ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମାନସରେ ଭାଳି ସେହି ବନମାଳୀ",
          "ଚାହାଣୀ ଛଟକେ ଢଳିଲୁକି ଗୋ",
          "ଭାଷଇ ମୋହନ ମନମୋହନଙ୍କ",
          "ଆଶାତରୁ ଫଳ ଫଳିଲୁକି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
