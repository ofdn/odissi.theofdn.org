  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-sakhi-mohana-ritiki-ahari-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖ ସଖୀ ମୋହନ ରୀତିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚନ୍ଦ୍ରାବଳୀ ସଙ୍ଗେ ରାତି ଅତି ସରସରେ ମାତି",
          "ଏବେ ଢୁଳି ଢୁଳି ଆସେ କତିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋତେ ରଖି ବନ ଭାଗେ ରହିଲା ତାର ସରାଗେ",
          "କି ବୋଲି ବୋଲିବା ତାର ଧୃତିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲାଜ ନାହିଁ ତାର ମୁଖେ ଆସୁଅଛି କେଉଁ ସୁଖେ",
          "ପୁର ଛଡ଼ାଇଣ କୁଳବତୀକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ବିକ୍ରମଦେବ ନୁତ ଶଠାଗ୍ରଣୀ ଗୋପସୁତ",
          "ଏବେ କରିବ କେତେ ବିନତିକି"
        ]
      }
    ]
  },
  "sources": [
