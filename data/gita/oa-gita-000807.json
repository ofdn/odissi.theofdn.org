{
  "id": "oa-gita-000807",
  "name": {
    "en": "Mana na manile mora",
    "or": "ମନା ନ ମାନିଲେ ମୋର"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000014"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-na-manile-mora/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନା ନ ମାନିଲେ ମୋର",
          "ଏଡ଼ିକି ଛଇଳ ସତେ ହେଲେ ମନଚୋର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପହୁଡ଼ିଥିଲି ରେ ସଖି ବକୁଳ ବିତାନେ",
          "ଅଜାଣତେ ବାସ ମୋର ଥିଲା ଅଯତନେ",
          "ହସୁଥିଲେ ଚାହିଁ ପରା ନବୀନ କିଶୋର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଗୁରୁଜନ ପାଶେ ଥିଲେ ମାରି ଆଖିଠାର",
          "ପରିହାସ କରି ହସାଇବେ ବାରମ୍ବାର",
          "ଛଟକି ନୟନେ ସତେ ଦୂରୁ ମୋ ଜୁହାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗଣ୍ଡରେ ଚୁମ୍ବନ ଦେବେ କଲେ ନାହିଁ ନାହିଁ",
          "ଦେଖ ଲୋ ସଜନୀ ଛାଇ ଏବେ ଲିଭି ନାହିଁ",
          "ତୋତେ ସିନା କହିଲି ମୁଁ ନୋହୁ ବୋଲି ପର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ କି ଲାଜ କଥା ସଖି କହିବୁ ବନ୍ଧୁରେ",
          "ବୁଡ଼ାଇବେ ନାହିଁ ମୋତେ ଶରମ ସିନ୍ଧୁରେ",
          "ଫେରି ମାଗୁଥିଲେ ଆଜି ଚୁମ୍ବ ଉପହାର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କବିଚନ୍ଦ୍ର କହେ ସଖୀ ଟାଣ କର ଛାତି",
          "ରସିକା ମଣ୍ଡଳେ ଦିନେ ଟେକାଇବୁ ଛତି",
          "ବାରିବୁ ରେ ସତ ମିଛ ଅନୁଭବେ ତୋର"
        ]
      }
    ]
  },
  "sources": [
