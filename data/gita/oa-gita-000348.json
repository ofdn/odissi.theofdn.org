{
  "id": "oa-gita-000348",
  "name": {
    "en": "Priti lagi hebu para bala bairagi",
    "or": "ପ୍ରୀତି ଲାଗି ହେବୁ ପରା ବାଳା ବଇରାଗୀ"
  },
  "composer": "oa-person-000063",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/priti-lagi-hebu-para-bala-bairagi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରୀତି ଲାଗି",
          "ହେବୁ ପରା ବାଳା ବଇରାଗୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଫୁଲରି ଫୁଲ ତ ବିଷ । ଉଲୁରିଅଛି ଅନିଶ ।",
          "କଙ୍କତିକାର ସ୍ପରଶ । ରଙ୍କ ତ ହେଲାଣି କେଶ ।",
          "ହେବୁ ପରା ଜଟା ଅନୁରାଗୀ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରହ୍ମଯୋଗ ଧ୍ୟାନ କରି । ଉନ୍ମୀଳନେ ନେତ୍ର ଗୋରୀ ।",
          "ଏକା ଏ ମଉନ ଧରି । ରହିବୁ ନବକିଶୋରୀ ।",
          "ବସିଲୁଣି ଦିବା ନିଶି ଜାଗି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଞ୍ଚିଲୁଣି ତ ଅଶନ । ଆବର ବେଶ ଭୂଷଣ ।",
          "ପ୍ରିୟଜନ ପରସନ୍ନ । ମନ୍ତର ପୁରଶ୍ଚରଣ ।",
          "ପଣ୍ଡିତା ବିଭୂତି ହୋଇ ଲାଗି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅପାଙ୍ଗ ସୂଚୀରେ ସିଇ । କାହା ମନବାସକୁ ହିଁ ।",
          "ମୁଣିଏ ଅଛୁ ଭିଆଇ । ପରମାନନ୍ଦ କହଇ ।",
          "ଯିବୁ ପରା ପ୍ରୀତିଭିକ୍ଷା ମାଗି ରେ"
        ]
      }
    ]
  },
  "sources": [
