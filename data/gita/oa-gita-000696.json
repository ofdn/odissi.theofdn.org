{
  "id": "oa-gita-000696",
  "name": {
    "en": "Jubati mati kie kaliba re",
    "or": "ଯୁବତୀ ମତି କିଏ କଳିବ ରେ"
  },
  "composer": "oa-person-000121",
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jubati-mati-kie-kaliba-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯୁବତୀ ମତି କିଏ କଳିବ ରେ",
          "ମୁଖେ ଥାଏ ନାହିଁ ଚିତ୍ତେ ଥାଏ ରହି",
          "ଅଙ୍ଗୀକାର ସଦା ପ୍ରେମିକ ପ୍ରତି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରହିଥିଲେ ସଜନୀଙ୍କ ସମାଜେ",
          "ସମ୍ମୁଖେ କେବେ ନ ଅନାଏ ଲାଜେ",
          "ପଛ କରି ନିଜେ ଦେଖିବାର ବ୍ୟାଜେ",
          "ଝୁଣ୍ଟିଆକୁ କରେ ସଳଖୁଥାନ୍ତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦଇବେ ନୟନ ହେଲେ ମିଳନ",
          "ଦିଶୁଥାନ୍ତି ହେଲା ପରି ଉଚ୍ଛନ୍ନ",
          "ହୋଇଗଲେ ଭିନ୍ନ ନ ରୁଚଇ ଆନ",
          "ଝୁରି ନ ସରଇ ଦିବସ ରାତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାରତୀ ଶ୍ରବଣେ ହୋଇ ଉତ୍ସୁକ",
          "କଲେ ହେଲେ ପରିଶ୍ରମ ଅନେକ",
          "ବୁଡ଼ାଇ ବିବେକ ମଉନେ ଅଧିକ",
          "ବସିବା ନିଜ ସମ୍ମାନ ମଣନ୍ତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ଦେବ ବୋଲଇ",
          "ବସିଥିଲେ ହେଲେ ମଥା ନୁଆଁଇ",
          "ଡୋଳାକୁ ବୁଲାଇ କି ଚଞ୍ଚଳେ ନେଇ",
          "ପ୍ରତି ଅଙ୍ଗେ ନିଉଛାଳି କରନ୍ତି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jubati-mati-kie-kaliba-re/"
    }
  ],
