    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କଣ୍ଟ କରି କାଲି ରଜନୀ ସଜନୀ",
          "ନଇଲେ ମୋ ବଂଶୀଧାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କୁଞ୍ଚି ନୀଳବାସ ହୋଇଥିଲି ବେଶ",
          "ଡକାଇ ମୁଁ ବେଶକାରୀ",
          "ଜାଳି ରତ୍ନଦୀପ ଟାଣି ଚନ୍ଦ୍ରାତପ",
          "ଝରୀରେ ରଖିଛି ବାରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚୂଆ ଚନ୍ଦନକୁ ଗୋଳି ମୋହନକୁ",
          "ଦିଅନ୍ତା ଏ ପରିଚାରୀ",
          "ଭାଙ୍ଗି ରଖିଥିଲି ଯତ୍ନେ ନାଗବଲ୍ଲୀ",
          "ଭୁଞ୍ଜିବେ କୁଞ୍ଜବିହାରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେଉଁ ସୁନ୍ଦରୀର ମନ୍ଦିରେ ସୁନ୍ଦର",
          "ରହିଲେ କିସ ବିଚାରି",
          "କୃଷ୍ଣ ଚିତ୍ତବିତ୍ତ ଚୋରାଇ ନେଲା ରେ",
          "ଧନ୍ୟ ସେ ଚୋରଣୀ ନାରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦେଖୁ ଦେଖୁ ସହି ରାତ୍ର ଗଲା ପାହି",
          "ବିଷେ ତନୁ ମଥା ଘାରି",
          "କହଇ ପଦନ ଆଦରେ ମଦନ",
          "ବିଶେଷେ ହେଲା ଭଗାରି"
        ]
      }
    ]
  },
