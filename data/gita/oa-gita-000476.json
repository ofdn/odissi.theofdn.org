{
  "id": "oa-gita-000476",
  "name": {
    "en": "Janili janili dhana pirati",
    "or": "ଜାଣିଲି ଜାଣିଲି ଧନ ପୀରତି"
  },
  "composer": "oa-person-000024",
  "mula_raga": [
    "oa-raga-000027"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/janili-janili-dhana-pirati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜାଣିଲି ଜାଣିଲି ଧନ ପୀରତି ବିଷମ ରେ",
          "ଲାଗିଲେ ସେ ନ ଛାଡ଼ଇ ହୁଅଇ ବିଷମ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯେ କରେ ପାପ ପୀରତି ସେହି ମୂଢ଼ ଜନ ରେ",
          "ଚିନ୍ତି ଚକ୍ରଧର ସ୍ତବ ମୋର ଏହି କାମ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମାନିନୀ ହୋଲୁ ରାଧେ ନ ଟେକୁ ଆନନ ରେ",
          "ଏ ଘୋର ସଙ୍କଟ ଦେଲୁ ଧିକ ତୋର ସ୍ନେହ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏ ଲୋଭରେ ମତ୍ତ କେହି ନ ଭାଳି ଶମନ ରେ",
          "ନିଶ୍ଚୟ ଜାଣିଲି ମୋର କରମଟି ବାମ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୃଷ୍ଣଚନ୍ଦ୍ର ବୋଲେ ଚିତ୍ତେ ଭାବିଣ ଏସନ ରେ",
          "ଏ ହେତୁ ପ୍ରୀତିକି ନିନ୍ଦା ନ ଧର ତା ନାମ ରେ"
        ]
      }
    ]
  },
  "sources": [
