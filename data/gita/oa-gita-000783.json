{
  "id": "oa-gita-000783",
  "name": {
    "en": "Bansi dhwani radhe uchanna",
    "or": "ବଂଶୀ ଧ୍ୱନି ରାଧେ ଉଚ୍ଛନ୍ନ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000143"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bansi-dhwani-radhe-uchanna-lalita-kamodi-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଂଶୀ ଧ୍ୱନି",
          "ରାଧେ ଉଚ୍ଛନ୍ନ କଲାଣି ପୁର ତିନି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏହାର ମହିମା ଅତିରେକ",
          "ଭାଙ୍ଗିଦିଏ ସତୀ ବ୍ରତ ଟେକ",
          "ଛଡ଼ାଏ ଗୁମାନ ଲାଭ ଭୟ ମାନ",
          "ଛାର ଧୃତି ଅବା ସେ କେତେକ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦୂରେ ବାଜୁଥିଲେ ଧୀର କରି",
          "ଲାଗୁଥାଇ ତ ନିକଟ ପରି",
          "ଯୁବା ନାରୀ ଦମ୍ଭ କୁମ୍ଭର ଆରମ୍ଭ",
          "ଚୂନା କରିଦିଏ ଯେ ବାଂଶରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସପତ ସ୍ୱରେ ପଞ୍ଚମ ରାଗେ",
          "ବାଏ ଯେ ନାଗର ଅନୁରାଗେ",
          "ତପତ କାଞ୍ଚନ ବରନୀମାନଙ୍କୁ",
          "ଝାଙ୍କେ ସେ ମାଦକ ଆସି ବେଗେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଛଣା ପୀୟୂଷରୁ ବଳି ସ୍ୱାଦୁ",
          "ପରମାଦ ଅତି ପରମାଦୁ",
          "ବୋଲେ ବନମାଳୀ ଏ ରସରେ ଭାଳି",
          "ଚାଖିବି କି ସତେ ଏକ ବିନ୍ଦୁ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
