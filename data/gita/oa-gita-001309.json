{
  "id": "oa-gita-001309",
  "name": {
    "en": "Prabhu madana mohana",
    "or": "ପ୍ରଭୁ ମଦନମୋହନ"
  },
  "composer": "oa-person-000050",
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prabhu-madana-mohana-chandana-karindra-danta-dinakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରଭୁ ମଦନମୋହନ",
          "କରୀନ୍ଦ୍ର ଦନ୍ତ ପଲଙ୍କ ତେଜି ପ୍ରଭୁ",
          "ନରେନ୍ଦ୍ର ଚାପେ ଗମନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଧନ୍ୟ ବେଶକାରୀ କି ସଜାଡ଼ କରି",
          "ଖଞ୍ଜିଅଛି ମାଳମାନ",
          "ଚନ୍ଦନ ଯାତ୍ରାକୁ ବିଜେ କରିଛନ୍ତି",
          "ସିନ୍ଧୁସୁତା ପ୍ରାଣଧନ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଇନ୍ଦ୍ର ନଈଋତ ବରୁଣ କୁବେର",
          "ଧାତା ଆଦି ଦେବଗଣ",
          "ଖଦି ଆଲଟ ଚାମର ପଙ୍ଖା ଘେନି",
          "ବ୍ରହ୍ମା ଲେପନ୍ତି ଚନ୍ଦନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଲକ୍ଷେ ଚନ୍ଦ୍ରଦୀପ ଦିହୁଡ଼ି ଜଳୁଛି",
          "ଦିଶୁଅଛି ଝଟଝଟ",
          "ପଟୁଆରୀମାନେ ଆଗରେ ଚାଲନ୍ତି",
          "ମାହାରୀ କରନ୍ତି ନାଟ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କି ଶୋଭା ଦିଶୁଛି ପୁଷ୍ପକ ବିମାନ",
          "ମୋହୁଅଛି ତ୍ରିଭୁବନ",
          "ପଟୁଆରେ ବିଜେ କରି ଯାଉଛନ୍ତି",
          "ସଙ୍ଗେ ଘେନି ଭକ୍ତଜନ ୪ ।"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନରେନ୍ଦ୍ର କୋଣରୁ କି ଶୋଭା ଦିଶୁଛି",
          "ଜଗମୋହନକୁ ବୋଲି",
          "ଭୋଦେବ ମଣିମା ଡାକ ଶୁଭୁଅଛି",
          "ମହା ମତ୍ତଗଜ ଚାଲି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ନରେନ୍ଦ୍ର ତଡ଼ାଗ ଚଉପାଶେ ବେଢ଼ି",
          "ଜନେ ଦେଖନ୍ତି ଚନ୍ଦନ",
          "ଧନ୍ୟ ସେହୁ ପୁରୀ ଧନ୍ୟ ସେହୁ ନାରୀ",
          "ଆଗେ କରନ୍ତି ଦର୍ଶନ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ତପନ ତନୟା ତଟରେ ମୋହନ",
          "କରନ୍ତି ମୁରଲୀ ସ୍ୱନ",
          "ବୋଲେ ଦୀନକୃଷ୍ଣ ତୁମ୍ଭ ଶ୍ରୀଚରଣେ",
          "ନିରନ୍ତରେ ରହୁ ଧ୍ୟାନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prabhu-madana-mohana-chandana-karindra-danta-dinakrusna/"
    }
  ],
