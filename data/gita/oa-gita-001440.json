{
  "id": "oa-gita-001440",
  "name": {
    "en": "Chhati karidelu nida pathara",
    "or": "ଛାତି କରିଦେଲୁ ନିଦା ପଥର"
  },
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chhati-karidelu-nida-pathara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସହି ଏଥର",
          "ଛାତି କରିଦେଲୁ ନିଦାପଥର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପରସଙ୍ଗ ପରସଙ୍ଗତ ବିଷମ",
          "ଏଥର ଏଣିକି ହେଲାଣି",
          "ପୂର୍ବ ଗାରିମା ମହତ ବଡ଼ପଣ",
          "ପ୍ରଥମରୁ ଜଣାଗଲାଣି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କର ବଢ଼ାଇ ଚନ୍ଦ୍ରମାକୁ ଧରି",
          "ୟେହି ତା ମାଦକ ଶିମୂଳ ।",
          "ଦେଖାଇଲୁ କାହିଁ ଆଶା ଲତା ମୋର",
          "ଫଳିଲା ହଟହଟା ଫଳ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶରଧାରେ ପଡ଼ି ନଣନ୍ଦ ବଚନେ",
          "ବଳେ ସିନା ଏହା ଲୋଡ଼ିଲି",
          "ପ୍ରତିଷ୍ଠାପଣକୁ ତଳକୁ ପକାଇ",
          "ଜାଣି ପ୍ରମାଦରେ ପଡ଼ିଲି"
        ]
      }
    ]
  },
  "sources": [
    {
