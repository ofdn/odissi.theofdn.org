    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aau-asa-nahin-prane-tarini-charan-patra-gouda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଉ ଆଶା ନାହିଁ ପ୍ରାଣେ ଘନଶ୍ୟାମ ବିନେ",
          "ଏପରି ଅନାଥ ହେବି ବୋଲି ମୁହିଁ",
          "କଳପି ତ ନ ଥିଲି ଦିନେ ସ୍ୱପନେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଖି ମୋର କି ଦୋଷ ମାନସେ ବହି ରୋଷ",
          "ଏଡ଼େ ଦଣ୍ଡ ବିହିଲେ ନ ଭାବି ଧ୍ୟାନେ",
          "(ପଡ଼ି)",
          "ଭାଷେ ଦୀନ ତାରିଣୀ ଜଳକା ହୋଇଲିଣି",
          "ଚାହିଁ ତାଙ୍କ ସରଣୀ ରଜନୀ ଦିନ"
        ]
      }
    ]
  },
