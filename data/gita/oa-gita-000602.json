  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-helani-sajani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନା ହେଲାନି ସଜନୀ",
          "ହରି ତୁମ୍ଭ ପ୍ରୀତି ଘେନି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସହଚରୀ ସଙ୍ଗେ ବୃନ୍ଦାବନକୁ",
          "ସୁମନେ କୁସୁମ ତୋଳିଯିବାକୁ",
          "ପରସନ୍ନ ମୁଖ ଦରପଣେ ଦେଖି",
          "ମୃଗମଦ ଘେନିବାକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୀଳ ନାୟକ ଭୂଷଣମାନଙ୍କ",
          "ମରକତ ଚୂଡ଼ି ଲାଗି ହେବାକୁ",
          "କଳାଧଡ଼ୀ ପଡ଼ି ଶାଢ଼ୀକି ସଜାଡ଼ି",
          "ନିତି ନିତି ପିନ୍ଧିବାକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅଶିତ ବରନ ଫୁଲଗଡ଼ାକୁ",
          "ସାଜି କବରୀ ମଣ୍ଡନ ହେବାକୁ",
          "ଅଶନ ବସନ ନ ରୁଚଇ କିଛି",
          "ତୁମ୍ଭ ସଙ୍ଗ କାମନାକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲକ୍ଷ୍ମୀ ନାରାୟଣ ଭୀମଦେବକୁ",
          "ଗୋଚର ପଚାର ଏ ବିଧାନକୁ",
          "କେତେ ପରାଭବ ସାରିବଦନରୁ",
          "ତୁମ୍ଭ ନାମ ଶୁଣିବାକୁ"
        ]
      }
    ]
  },
