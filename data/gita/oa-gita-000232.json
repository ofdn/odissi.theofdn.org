{
  "id": "oa-gita-000232",
  "name": {
    "en": "Gostha chandramanku asa boli re sahi",
    "or": "ଗୋଷ୍ଠଚନ୍ଦ୍ରମାଙ୍କୁ ଆସ ବୋଲିରେ ସହି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000002"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/gostha-chandramanku-asa-boli-re-sahi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୋଷ୍ଠଚନ୍ଦ୍ରମାଙ୍କୁ ଆସ ବୋଲିରେ ସହି",
          "କହିଦେଲୁନି କିରେ ।",
          "ଏତିକି ବେଳୁ ମୋ ତନୁ ଥରିଲାନି",
          "ଦେଖି ନାହିଁ ମୁଖ ଆଉରି ଆଖିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଗୃହ କୃତ୍ୟ ସ୍ଫୂର୍ତ୍ତି ହେଲା ନାହିଁ ତିନି",
          "ପହରରୁ ମତିରେ",
          "କେତେବେଳେ କେ ଦେଖି ଦେବଟି ବୋଲି",
          "ଦମଦମ ହୃଦ ହେଉଛି ଭୀତିରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ବୁଦ୍ଧି କରିବି କୁଟିଳା ମର୍କଟ",
          "-ମୁଖୀ ଅଛି ପୁରତେ",
          "ଅଗଣାକୁ ଗଲେ ଦେଇ ଅପବାଦ",
          "ମାରି ତାଳି ଆସି ନାଚିବ ଦୁଆରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କି କରୁଥିଲେ ତୁହି ଗଲାବେଳକୁ",
          "ଥିଲେ କେଉଁ ଠାବରେ",
          "କି ବୋଇଲୁ କିସ ପଚାରିଲେ ତୋତେ",
          "କହୁ ସିନା ଚାଲ ଯିବା ରହସ୍ୟରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନ ଆସ ବୋଲି ଜଣାଅ ଯାଇ ହେଲେ",
          "ସଖୀ ଜୁହାରୁଛି ମା",
          "ଚନ୍ଦ୍ରାବଳୀ ହେଲା ପରି ହେବି ସିନା",
          "ଜଳଜଳ ମୋତେ ଦିଶୁଛି ଆଖିରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷେ ଜଗିଥିଲେ ସେ",
          "ତୋ ପାଇଁ ପ୍ରାଙ୍ଗଣରେ",
          "ଲାଗ ହୋଇ ଏଣେ ତେଣେ ଚାହିଁ ଧୀରେ",
          "ଭାଷିଲେ ଥାଉଛି ପୁଷ୍ପ ବାଟିକାରେ"
        ]
      }
    ]
  },
