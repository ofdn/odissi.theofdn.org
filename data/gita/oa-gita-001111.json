{
  "id": "oa-gita-001111",
  "name": {
    "en": "Chitra pata dekhu dekhu",
    "or": "ଚିତ୍ରପଟ ଦେଖୁ ଦେଖୁ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000169"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chitra-pata-dekhu-dekhu-karunasri-bhanja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଚିତ୍ରପଟ ଦେଖୁ ଦେଖୁ ଦିନେ ପ୍ରିୟ ତାର",
          "ଚାହିଁ କୋକନଦ କଲା ନେତ୍ର ଇନ୍ଦୀବର",
          "ଚନ୍ଦ୍ରବଦନା ଯେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚାଟୁ କହି ତୋ ରୂପ ସେ ବୋଲି ପ୍ରାଣପତି",
          "ଚିତ୍ତ ଯେ ଜଡ଼ାଇ ମନ ନାନା ରସେ ମାତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚନ୍ଦ୍ରାର୍ଦ୍ଧ ଚିହ୍ନ ଅନାଇ ଦିନେ ବର ଉରେ",
          "ଚନ୍ଦ୍ରକୁ ରଖିଲା ବିକଶିତ କମଳରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚିତୁଅତୋଗତ ନିଶି ଚିହ୍ନ ବୋଲୁ ଇଶ",
          "ଚତୁରୀ ହେଜି ମଜ୍ଜିଲା ହୋଇ ହସ ହସ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚରିତ ଏ ରୂପେ ରୋଷ ତୋଷ ହୋଇବାର",
          "ଚିତ୍ତ ଅନ୍ତର ନୁହଇ ନିମିଷେ ପ୍ରିୟର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚାରୁକୁସୁମ୍ଭ ରାଗ ଏ ଜଗତ ବିଦିତା",
          "ଚିନ୍ତେ ଉପଇନ୍ଦ୍ର ରାମ ଜନକଦୁହିତା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
