{
  "id": "oa-gita-001288",
  "name": {
    "en": "Ki gheni manasare karichi",
    "or": "କି ଘେନି ମାନସରେ କରିଛି"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000139"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-gheni-manasare-karichi-nadaramakeri-aditala-gourachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଘେନି ମାନସରେ କରିଛି ବିନା ଦୋଷରେ",
          "କୋପ ମୋ ଠାରେ ରେ ସଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କେତେ ପରି ମୁହିଁ କହିଲି ମନାଇ",
          "ନ ଶୁଣିଲା ଥରେ ତା ଶ୍ରୁତି ପଥରେ",
          "ଅଶ୍ରୁ ଧାର କରି ହାର",
          "ବସିଲା ଗୁରୁ ଗୁମାନରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନ ଜାଣିଲି ବୋଲି ବସନ ପ୍ରସାରି",
          "କହିଲେ ମୁଁ ଯେତେ ମୁଖ ମୋଡ଼ି ତେତେ",
          "ନାରୀ ଈଶ ବହି ରୋଷ",
          "ନ ଚାହେଁ ନେତ୍ର କୋଣେ ଥରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କିଣାଦାସ ତୋର ମୁହିଁ ରାମାବର",
          "ତୋ ହତାଦରରେ ମାର ଶର ମାରେ",
          "କର ତ୍ରାହି ପ୍ରାଣସହୀ",
          "ବୋଲୁ ଅଧିକ ରୁଷିଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କରଜ ମୁନରେ ଗାର ଧରଣୀରେ",
          "କାଟି ନିରନ୍ତର ଦେଲା ସେ ଅପାର",
          "ଦୁଃଖ ମୋତେ ଏବେ ଚିତ୍ତେ",
          "ଚିନ୍ତା ଅନଳ ଜାଳିଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗଜପତି ଗୌରଚନ୍ଦ୍ର ଦେବ ମୋର",
          "ଅଟେ ଗଳାହାର ବୋଲି ଘୋଷିବାର",
          "ପାଶୋରିଲା ନବ ବାଳା",
          "ଦେଖିଲେ ମୁଖ ପୋତିଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
