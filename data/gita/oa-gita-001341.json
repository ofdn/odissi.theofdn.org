{
  "id": "oa-gita-001341",
  "name": {
    "en": "Dekha sakhi ghana rase",
    "or": "ଦେଖ ସଖୀ ଘନ ରସେ"
  },
  "composer": "oa-person-000047",
  "mula_raga": [
    "oa-raga-000124"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekha-sakhi-ghana-rase-mallara-ekatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖ ସଖୀ ଘନ ରସେ ପୂରାଇଲେ ଜଳରେ",
          "ନଇଲେ କାନ୍ତ ଏ ଘୋର କମଳଦ କାଳରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଝଟ ଝଟ ଝଟକେ ତ ଚଞ୍ଚଳା ଚପଳରେ",
          "ଝାଙ୍କି ଝାଙ୍କି ବହେ ଝଞ୍ଜା ବାତ ଅତି ବଳରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଏକାନ୍ତେ କେମନ୍ତେ ମୁଁ ଗୋ ବଞ୍ଚିବି ନିଷ୍ଫଳରେ",
          "ଭଲା ବିହି ଭାଲେ ଲିହିଥିଲା କି ଏ ଫଳରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସତେ କି ସଜନୀ ମୁଁ ଦେଖିବିନି କି ଡୋଳାରେ",
          "ବୋଲେ କହ୍ନାଇ ଯେ ରାମା ରୋଦଇ ଆକୁଳରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
