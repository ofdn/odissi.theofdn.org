{
  "id": "oa-gita-001101",
  "name": {
    "en": "Josabara re jatharatha re jana",
    "or": "ଯୋଷାବର ରେ ଯଥାର୍ଥରେ ଜାଣ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ja Patala",
      "or": "ଯ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/josabara-re-jatharatha-re-jana-ja-champu-kabisurjya-mukhari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯୋଷାବର ରେ",
          "ଯଥାର୍ଥରେ ଜାଣ ମୁଁ ତୋହର ରେ",
          "ଯାମଳ ଭୂଧର ନିଭ ପୟୋଧର",
          "ମରଦନିଆ ଚାକର ରେ ।ପଦ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାବକ ତୋ ପଦକଞ୍ଜର ସମଦ",
          "ଗଜଗତି ମୋ ଶେଖର ରେ",
          "ଯତୀନ୍ଦ୍ର ସମାଧି ଖଣ୍ଡନା ତୁ ନିଧି",
          "ମୁଁ ରଙ୍କମାନଙ୍କ ବର ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯମକ କି ତୁହି ପୂର୍ଣ୍ଣଚନ୍ଦ୍ର ମୁହୀଁ",
          "ମୋ ମହା ଶୁଭ ଦଶାର ରେ",
          "ଯତ୍ନେ ସମ୍ପାଦିବା ଚିନ୍ତାମଣି ଅବା",
          "ମୋ କରେ ହେଲୁ ସୁସାରରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯୁବତୀ କଦମ୍ବ ରାଜା ଅବଲମ୍ବ",
          "ହୋଇଲୁ ଯେବେ ନିକର ରେ",
          "ଯୁଦ୍ଧକୁ ସନ୍ନଦ୍ଧ ହେଉ ଅତି କ୍ରୁଦ୍ଧ",
          "ହୋଇ ପଛେ ପଞ୍ଚଶରରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯମୁନା ବାହିନୀ ତଟରୁହ ବନୀ",
          "ଅବନୀ ଅନାଇବାର ରେ",
          "ଯଶ ରଖି ନିନ୍ଦା ପଟଳୀରୁ ବୃନ୍ଦା",
          "କରାଇଲା ତ ନିବାର ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯଶୋଦା କୁମର ଗିରେ ରାଧା ଶିର",
          "ନୁଆଇଁଲେ ଲଜ୍ଜାଭର ରେ",
          "ଯୁଗଳ ବିଗ୍ରହ କର ଅନୁଗ୍ରହ",
          "ଅଷ୍ଟଦୁର୍ଗ ପୁରନ୍ଦରରେ"
        ]
      }
    ]
  },
  "sources": [
    {
