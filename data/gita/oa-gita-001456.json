{
  "id": "oa-gita-001456",
  "name": {
    "en": "Chaka nayanaku patita kehi",
    "or": "ଚକାନୟନକୁ ପତିତ କେହି"
  },
  "composer": "oa-person-000172",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/chaka-nayanaku-patita-kehi-jadumani/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଚକାନୟନକୁ ପତିତ କେହି",
          "ତକାଇ ଖର ନିଃଶ୍ୱାସ ପକାଇ",
          "ଡକା ପକାଇ ଗରୁଡ଼ ପଛରେ",
          "ବକାରି ମୋ ଆର୍ତ୍ତ ଶୁଣ ସତ୍ୱରେ ହେ",
          "ଢକ୍କା ବାଜୁଛି ମହିମା ହେ",
          "ଠକାର କରି କର୍ଣ୍ଣେ ଗିର ନ ଶୁଣ କାହିଁକି ବିଚିତ୍ରକର୍ମା ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କରୀ ହରିଣୀ ଦ୍ରୌପଦୀ ବିପତ୍ତି",
          "ହରି ହରିଛ ପରା ଡେରି ଶ୍ରୁତି",
          "ଦରିଦ୍ର ସୁଦାମାକୁ କୋଟିନିଧି",
          "ପରିପୂର୍ଣ୍ଣେ ଦେଲ କୃପାବାରିଧି ହେ",
          "ଧରି ଯା ମହିମା ଚିତ୍ତେ ହେ",
          "ସରି ତ ଯାଉଛି ହରି ଆଉ ଥରେ ନ ଚାହିଁଲେ କୃପାନେତ୍ରେ ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଜାନୁବାହୁ ମୁଁ ପତିତ ଜଣେ",
          "ଅଜାମିଳୁଁ ବଳି ସହସ୍ର ଗୁଣେ",
          "ଲଜ୍ଜା ହରି ନ ତାରିଲେ ନିକର",
          "ଧ୍ୱଜା ଚକ୍ରରୁ ବହନ ଉତ୍ତାର ହେ",
          "ମଜ୍ଜାରେ ମୁଁ ଏହା ଭାବେ ହେ",
          "ବଜାଇ ଜୟ ଆର୍ତ୍ତତ୍ରାଣ ଡିଣ୍ଡିମ ହଜାଇ ଦେଉଛ ଏବେ ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପିତାମାତା ସେବା ମୋର ବିଭଙ୍ଗ",
          "ଲିତାକୁ ଲିତା ମୋ ଅସତ ସଙ୍ଗ",
          "ସୀତାରେ ଅବଗାହି ନାହିଁ ଦିନେ",
          "ଗୀତା ଭାଗବତ ନ ଶୁଣେ କର୍ଣ୍ଣେ ହେ",
          "ପୀତାମ୍ବର ଚିତ୍ତେ ଚିନ୍ତ ହେ",
          "କିତାପ ଚିତ୍ରଗୁପତୁଁ ଚିରାଇବ ମୋ ଅନ୍ତକାଳେ ଯେମନ୍ତ ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବଟପୁଟବାସି ଆରତତ୍ରାଣ",
          "ଘଟ ଘଟକେ ରହି ସର୍ବ ଜାଣ",
          "ଖଟନ୍ତି ଯେଉଁ ଚରଣେ କମଳା",
          "ହଟ କରି ମୋ ଦୁର୍ଦ୍ଦଶା ନ ଗଲା ହେ",
          "ନଟବର ବେଶଧାରି ହେ",
          "ଝଟତିରେ ପ୍ରଭୁ ଶ୍ରୁତି ଡେରି ଶୁଣ ଏ ଦୀନଜନ ଗୁହାରି ହେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପାଣ୍ଡବପ୍ରିୟ ଦଣ୍ଡୁଛ କି ଦୋଷେ",
          "ଦାଣ୍ଡକୁ ଏ କଥା କେମନ୍ତ ଦିଶେ",
          "ଚାଣ୍ଡରେ ମଇତ୍ର ଛଳେ ଆପଣ",
          "କାଣ୍ଡକରେ ନେଲ ବାଳୀର ପ୍ରାଣ ହେ",
          "ତାଣ୍ଡବ ନୃତ୍ୟକାରୀଙ୍କି ହେ",
          "ଭାଣ୍ଡ କରିଦେଲ ବିଷ୍ଣୁକୂଟ ମାୟା ଲଗାଇ ଦେଇ ଭେଳିକି ହେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଆର ତ କେହି ନାହିଁ ମୋର ପ୍ରଭୁ",
          "ଆରତତ୍ରାଣ ପରିତ୍ରାଣ ସବୁ",
          "ସାରଥି ହୋଇ ପାର୍ଥରଥେ ଶ୍ୟାମ",
          "ଭାରତ ଯୁଦ୍ଧେ ଭରତିଆ ଡିମ ହେ",
          "ସାର ଘଣ୍ଟେ ଘୋଡ଼ାଇଣ ହେ",
          "ମାରପିଅର ତା ପରାଣ ରଖିଣ ରୁହାଇଛ ବଡ଼ପଣ ହେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ପକ୍ଷହୀନଜନ ରକ୍ଷଣ ବୋଲି",
          "ଲକ୍ଷଣଅଗ୍ରଜଙ୍କୁ ଆଶ୍ରେ କଲି",
          "ପକ୍ଷଦାୟକ ହେ ଲକ୍ଷଣସୁଖ",
          "ଦକ୍ଷପଣେ ରଖିବାରେ ନିରକ୍ଷ ହେ",
          "ଲକ୍ଷ୍ୟ କେ ତୁମ୍ଭର ଅଛି ହେ",
          "ବକ୍ଷ ବିଦାରିଛ ନଖେ ହିରଣ୍ୟର ପ୍ରହଲ୍ଲାଦ ମାନ ଇଚ୍ଛି ହେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଧଣ୍ଡାମାଳବୁହା ଦୁର୍ଦ୍ଦଶାରାହୁ",
          "ଚଣ୍ଡାଳ ଗ୍ରାସୁଅଛି ଚାହୁଁ ଚାହୁଁ",
          "ଭଣ୍ଡାରେ ଖଣ୍ଡା ନାହିଁ କି ମଣିମା",
          "ଗଣ୍ଡାକର ଦିଶୁନାହିଁ ମହିମା ହେ",
          "ହଣ୍ଡା ମୋ ଯାଉଛି ଫାଟି ହେ",
          "ଥଣ୍ଡା କରି କୃପାଜଳ ବୃଷ୍ଟି କର ମୋ ଚିତ୍ତଚାତକ ପାଟି ହେ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ମନ୍ଦରଧର ନୀଳଗିରିବାସି",
          "କନ୍ଦରବାସୀ ପ୍ରାୟେ ଅଛ ବସି",
          "ପନ୍ଦରନେତ୍ର ଧାତା ପୁରନ୍ଦର",
          "ବନ୍ଦନ କରନ୍ତି ଯେଉଁ ପୟର ହେ",
          "ଛନ୍ଦ ଛାଡ଼ ଦେବରାଜେ ହେ",
          "ନନ୍ଦନନ୍ଦନ ଶ୍ରୀଚରଣାରବିନ୍ଦେ ଚନ୍ଦନ ହଜୁରୀ ଭଜେ ହେ"
        ]
      }
    ]
  },
