{
  "id": "oa-gita-000740",
  "name": {
    "en": "Banchana tu ghena mo",
    "or": "ବଞ୍ଚାନା ତୁ ଘେନ ମୋ ବଚନକୁ ରେ"
  },
  "composer": "oa-person-000122",
  "mula_raga": [
    "oa-raga-000010"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/banchana-tu-ghena-mo-jagannatha-gajapati-saberi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଞ୍ଚାନା ତୁ ଘେନ ମୋ ବଚନକୁ ରେ",
          "ସଞ୍ଚ ତୁ ସ୍ନେହକୁ ରେ ।",
          "ପାଞ୍ଚି ପାଞ୍ଚଶର ମାରେ ତା ମରମର",
          "ପ୍ରାଣ ତ୍ରାଣ କର ଜାଣୁ ରମଣୀବର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚମକି ଚାହିଁ ଚଉଦିଗକୁ",
          "ମୋହନ ଚେତି ବୋଲଇ ଆହା",
          "ଚନ୍ଦ୍ରବଦନୀ ମୋର ନିରାଶ ହେବ ଯଦି",
          "ଆନ କେ ଅଛି ସାହା",
          "ସୁଧାକର ଚନ୍ଦନ ବିଷ ସମ ମଣଇଁ",
          "ମନ୍ଦ ଗନ୍ଧ ଶୀତଳ ମଳୟ ମରୁତ ବହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୋକିଳ ବାଣୀ କଳକଳ ଶୁଣି",
          "ନାଗର ବିଳକ ହୁଅଇ ନିରତେ",
          "ସକଳ ସଖା ମିଳି ସଜଳ ନଳିନୀ ଦଳେ",
          "ତଳ୍ପ ରଚିଲେ ପୁରତେ",
          "ଅଳ୍ପକ କାଳକୁ କଳ୍ପ କରି ମଣଇଁ",
          "ବିଳାପ କରଇ କେତେ",
          "ବେଳକୁ ବେଳ ତାର ବିରହରେ ପ୍ରବଳ",
          "ପାଳି ପୀରତି ବନମାଳୀକି ରଖ ସହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଜନୀ ଆଜ ବେଶ ସାଜ",
          "ବିହର ବ୍ରଜରାଜ ତନୁଜ ସଙ୍ଗରେ",
          "କୁସୁମ ଶର ତାପ ନିବାର ସହି",
          "ମାତି ସୁରତି ରଙ୍ଗରେ",
          "ଏ ବାଣୀ ଶୁଣି ହରଷିତ ରମଣୀମଣି",
          "ମୃଗମଦ ଲିପି ଅଙ୍ଗରେ",
          "ମିଳିଲେ ଯାଇ ଶ୍ରୀକୃଷ୍ଣ ପାଶରେ ଶ୍ରୀମତୀ",
          "ଶ୍ରୀ ଜଗନ୍ନାଥ ଦେବ ଏ ରସେ ବଦତି"
        ]
      }
    ]
  },
