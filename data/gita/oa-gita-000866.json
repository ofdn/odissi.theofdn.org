{
  "id": "oa-gita-000866",
  "name": {
    "en": "Pahi sankari",
    "or": "ପାହି ଶଙ୍କରି"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000070"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/pahi-sankari-bihaga-sanskrit-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପାହି ଶଙ୍କରି ପାଟଳାଧରି",
          "ତ୍ରାହିମାଂ ସମସ୍ତ ନିର୍ଜରା ଭୟଙ୍କରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଞ୍ଜଲୋଚନି କଷ୍ଟମୋଚନି",
          "ଚାରୁଶାରଦାମ୍ବୁଜାତଶାତ୍ରବାନନି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସର୍ବମଙ୍ଗଳେ ଭକ୍ତବତ୍ସଳେ",
          "ମତ୍ତଭୃଙ୍ଗଜାଳ ନୀଳଦିବ୍ୟକୁନ୍ତଳେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାପହାରିଣି ଶୂଳଧାରିଣି",
          "କ୍ରୂରଦାନବାଳିଗର୍ବଖର୍ବକାରିଣି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସିଂହବାହିନି ଶମ୍ଭୁମୋହିନି",
          "ବିକ୍ରମେଶ ଚିତ୍ତ ନୀରଜାତ ବାସିନି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
