{
  "id": "oa-gita-000167",
  "name": {
    "en": "Syama kede abujhana",
    "or": "ଶ୍ୟାମ କେଡ଼େ ଅବୁଝାଣ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-kede-abujhana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ କେଡ଼େ ଅବୁଝାଣ ଗୋ",
          "ତା ଲାଗି ଯିବ ଏ ପରାଣ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚୋରପଣେ ଆସି ମୋର ପାଶେ ବସି",
          "ଘୋର ଆଚରଇ ଟାଣ ଗୋ",
          "ସ୍ମର ମରଦଇ ତା ବଚନ ପାଇ",
          "ବିଷମ ଶର ପଠାଣ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପଚାଇ ଦେବାକୁ ଅଭିଳାଷ ଫଳ",
          "ନଚାଇ ଭୂରୁ କମାଣ ଗୋ",
          "ଫଟାଇ ଦିଅଇ ଧୃତିକି ପ୍ରହାରି",
          "କଟାକ୍ଷ କପଟବାଣ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋଟିଏ ଗୋଟିଏ ଅଳପ କଥାକୁ",
          "କୋଟିଏ ପକାଏ ରାଣ ଗୋ",
          "ସରେ ସେହି ଅବସରେ ସବୁ ସହି",
          "କରେ ଯେଡ଼େ ହଇରାଣ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜମି ରହେ ମନ ତା ଭଙ୍ଗୀରେ କାହିଁ",
          "ନ ମିଳଇ ପରିତ୍ରାଣ ଗୋ",
          "ଲାଜ ବିହଙ୍ଗକୁ ଝାମ୍ପଇ ତା ଶୋଭା",
          "ଦମ୍ଭ ଚପଳ ସଞ୍ଚାଣ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଜଣାଇଲେ ସଖୀ ଧୂର୍ତ୍ତ ସେ ଭୁଜଙ୍ଗ",
          "-ପଟା ନାଟୁଆ ପ୍ରମାଣ ଗୋ",
          "ଜଗଦ୍ଦେବ କହେ ତା ସ୍ନେହ ବିରହେ",
          "ପବିପାତ ଭଲ ଜାଣ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-kede-abujhana/"
    }
  ],
