{
  "id": "oa-gita-001446",
  "name": {
    "en": "Bitalaku alingana",
    "or": "ବିତଳକୁ ଆଲିଙ୍ଗନ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000118"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bitalaku-alingana/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ବିତଳକୁ ଆଲିଙ୍ଗନ     କରି ଜାହ୍ନବୀ ଶୋଭନ",
          "ହରେ ସୁରବର ତାପ ଚାରୁ ଧାରା ସେ",
          "ବହେ ମକର କେତନ     ଉଚ୍ଛନ୍ନ ରତି ସମାନ",
          "ପୂରିତ ହୋଇଛି ପୁଣି ଅଶେଷ ରସେ",
          "ବିଦ୍ୟ ହୈମବତୀ ପଦରେ",
          "ବିଷକଣ୍ଠ ତୋଷ ଦାନୀ ବେନି ମତରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିଷ୍ଣୁପଦୀ ବିଷ୍ଣୁପଦ     ଈକାର ଭେଦ ଶବଦ",
          "ତରଣୀର ଗତାଗତ ତହିଁ ଉଚିତ",
          "ବିଶାରଦ ସେ ସାମନ୍ତ     ମତ୍ତରେ ଦାସ ସେବିତ",
          "ଡାକୁ ନ ଶୁଣନ୍ତେ ରଘୁନାଥ କଥିତ",
          "ବିଷଧର ପ୍ରାୟେକ ତୁହି",
          "ବେଳେ ନେତ୍ର ଢାଳି ଶୁଣ ଉଦାର ନୋହି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବଧୀର ନୁହଇ ବୀର     ବୋଇଲା ତହୁଁ ଧୀବର",
          "ଶୁଣିଲିଣି ପଥରେ ପଥର ଅବଳା",
          "ବାଲି ପଡ଼ି ତୋ ଚରଣୁ     ଆଶଙ୍କା ଉପୁଜେ ଏଣୁ",
          "ନଉକା ନାୟିକା ହେଲେ ବୁଡ଼ିବ ଭେଳା",
          "ବୃତ୍ତିଏ ମୋ ପୋଷେ କୁଟୁମ୍ବ",
          "ବସାଇ ନ ଦେବି ପାଦ ନ ଧୋଇ ନାବ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବଢ଼ାଇ ଦେଲେ ପୟର     ଭାବଗ୍ରାହୀ ରଘୁବୀର",
          "ପୟରେ କ୍ଷାଳିତ କରି ବସନେ ପୋଛି",
          "ବ୍ରହ୍ମାରେ ଧୌତ ଯେ ପାଦ     ନୋହିଛି ଶିବ ବିଷାଦ",
          "ନ ପାଇ ଚରଣାମୃତ ପାନକୁ ଇଚ୍ଛି",
          "ବିଜ୍ଞାନୀ କୈବର୍ତ୍ତ ଧୋଇଲା",
          "ବିଶ୍ବେ ପତିତପାବନ ନାମ ରହିଲା"
        ]
      }
    ]
  },
  "sources": [
