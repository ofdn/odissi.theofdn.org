{
  "id": "oa-gita-000069",
  "name": {
    "en": "Ago duti syama priti kemante murchhibi go",
    "or": "ଆଗୋ ଦୂତୀ ଶ୍ୟାମ ପ୍ରୀତି"
  },
  "composer": "oa-person-000087",
  "mula_raga": [
    "oa-raga-000032"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ago-duti-syama-priti-kemante-murchhibi-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଗୋ ଦୂତୀ ଶ୍ୟାମ ପ୍ରୀତି",
          "କେମନ୍ତେ ମୂର୍ଚ୍ଛିବି ଗୋ",
          "କେମନ୍ତେ ମୂର୍ଚ୍ଛିବି କହ",
          "କେମନ୍ତେ ମୂର୍ଚ୍ଛିବି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ମୋହନ ମୋ ଜୀବନ",
          "ତା ଠାରୁ ହୋଇ ମୁଁ ଆନ",
          "ଏକାକିନୀ ହୋଇ କହ",
          "କେମନ୍ତେ ବଞ୍ଚିବି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋର ଯେ ଶାଶୁ ନଣନ୍ଦ",
          "ତାର ଯୋଗୁଁ ଅପବାଦ",
          "ଦେଇଣ ଲଗାନ୍ତି ଦ୍ୱନ୍ଦ",
          "କେତେ ତା ସହିବି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯମୁନାକୁ ଯିବା ପାଇଁ",
          "ମନା କଲେଣି ଗୋ ସହୀ",
          "ରହିଲେଣି ଜଗି ମୋତେ",
          "କି ବୁଦ୍ଧି କରିବି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଖୀ ସେ ବଂଶୀବଦନ",
          "ଦିନେ ନ ଦେଲେ ଦର୍ଶନ",
          "ଘାଣ୍ଟି ହୁଏ ମନ ଯାହା",
          "ତାହା କି କରିବି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶୁଣ ଗୋ ପ୍ରାଣସଜନୀ",
          "ହେବି ପଛେ କଳଙ୍କିନୀ",
          "ମୋ ପ୍ରାଣସଙ୍ଖାଳି ସେହି",
          "ତାକୁ ନ ତେଜିବି ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଭାଷେ ପଙ୍କଜ ଚରଣ",
          "ହେଲେ ହୋଇଣ ଦୂଷଣ",
          "ସେବି ସେ କୃଷ୍ଣ ଚରଣ",
          "ଦିନ କାଳ ନେବି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
