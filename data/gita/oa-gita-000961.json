{
  "id": "oa-gita-000961",
  "name": {
    "en": "Kundahasi hasi rasija",
    "or": "କୁନ୍ଦହାସୀ ହସି ରସିଯା"
  },
  "composer": "oa-person-000039",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kundahasi-hasi-rasija-krupamaya-deba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁନ୍ଦହାସୀ ହସି ରସିଯା",
          "ମନ୍ଦପସନ୍ଦ ବଚନାରେ",
          "କୁନ୍ଦନ ବରନୀ ସୁନ୍ଦର ଦଶନୀ",
          "ମନ୍ଦ ସୁଗମନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖଞ୍ଜନାକ୍ଷୀ ସୁମଞ୍ଜୁଳ",
          "ପଞ୍ଜରୀ ଫିଟା ଚଞ୍ଚଳ",
          "ଖଞ୍ଜନ ନୟନେ ଅଞ୍ଜନ ଗୁଣକୁ",
          "ରଞ୍ଜି ହୁଅ ସୁମନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଞ୍ଚିତ ନୀଳ କୁନ୍ତଳା",
          "ରଚି ନିଧୁବନ ଲୀଳା",
          "ପଞ୍ଚଶର ତ୍ରାସ ନାଶିବାକୁ ଆସ",
          "ସଜ ହୁଅ ସୁମନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖଣ୍ଡ ଦରପଣ ଝଳି",
          "ଗଣ୍ଡମଣ୍ଡନା ମୋ ବାଳୀ",
          "ମଣ୍ଡି ମୋର କୋଳ ଖଣ୍ଡ ଅମଙ୍ଗଳ",
          "ପଣ୍ଡିତାଳୀ ମୋହନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାଜରାଜାଙ୍କ ମୁକୁଟ",
          "ଗଜପତି ମହାରାଟ",
          "ଇନ୍ଦ୍ରଖେମୁଣ୍ଡିର ବୀର କୃପାମୟ",
          "ସାନ୍ଦ୍ର ଗୁଣି ରଚନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kundahasi-hasi-rasija-krupamaya-deba/"
    }
  ],
