{
  "id": "oa-gita-000244",
  "name": {
    "en": "Bajuchi sahi baja re",
    "or": "ବାଜୁଛି ସହି ବାଜାରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bajuchi-sahi-baja-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାଜୁଛି ସହି ବାଜାରେ ତୋ ନାଁରେ ବ୍ରଜବଜାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଟ୍ଟାଳୀରେ ତୁ ଥିବାର କାନନୁ ସେ ଆସିବାର",
          "ଅନାଅନି ଚମତ୍କାର ଭାବନା ତୋର ତାହାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବ୍ରଜବନ୍ଧୁ ପୀତପଟ ତୋ ନୀଳଶାଢ଼ୀ ପାଲଟ",
          "ହୋଇବାର ବାଟ ଘାଟ ଯାକରେ ହେଲାନି ସ୍ଫୁଟ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯାଇ ଯମୁନା ପାଣିକି ତୁ ନ ବୁଡ଼ାଇ ଘଡ଼ିକି",
          "ନୀପରୁ ଶ୍ୟାମ ଛାଇକି ଅନାଇଁଥିଲୁ ନାହିଁକି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହୁଥିଲା ଚନ୍ଦ୍ରାବଳୀ ଶେଯେ ଶିଖଣ୍ଡମଉଳି",
          "ହେଉଥିବାର ବାଉଳି ଜୟ ରାଧେ ରାଧେ ବୋଲି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ଗୋପୀଙ୍କି ସବୁ ଆସଇ",
          "ଆପଣାର ଦୋଷ ନେଇ ପରେ ଦିଅନ୍ତି ଲଗାଇ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
