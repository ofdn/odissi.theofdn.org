{
  "id": "oa-gita-000187",
  "name": {
    "en": "Na kara re rama mana",
    "or": "ନ କରରେ ରାମା ମାନ"
  },
  "composer": "oa-person-000023",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/na-kara-re-rama-mana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନ କରରେ ରାମା ମାନ । କହୁଛି ବିନୟ ଘେନ ।",
          "କିଣାଜନ ଠାରେ ମାନ କଲେ କି ହେବ ସମାନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତୁ ମୋ ଗଳା ରତ୍ନମାଳା । ବାଳାରେ ନେତ୍ରପିତ୍ତୁଳା ।",
          "କାମସିନ୍ଧୁରେ ମୋ ଭେଳା ନ ବୁଡ଼ା ନବଛଇଳା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲଗାଇ ପ୍ରୀତି ବଲ୍ଲରୀ । ନ ଛେଦ ଶ୍ରୀହସ୍ତେ ଧରି ।",
          "ବାନ୍ଧବୀ ମୁଁ କିଣା ପରିଜନ ତୋର ବିମ୍ବାଧରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମୁଁ ଯେବେ ହୋଇଲି ଦୋଷୀ । ତୁ ପରା କରୁଣାରାଶି ।",
          "ଶରଣ ପଶିଲି ଆସି ରଖ ମୋତେ ମଦାଳସୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କାନ୍ତା କାନ୍ତ ବାଣୀ ଶୁଣି । ହରଷେ ରମଣୀମଣି ।",
          "ଆରମ୍ଭିଲେ ପ୍ରୀତି ପୁଣି ଉପଇନ୍ଦ୍ର ଭଞ୍ଜ ଭଣି"
        ]
      }
    ]
  },
