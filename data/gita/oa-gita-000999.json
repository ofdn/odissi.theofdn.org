{
  "id": "oa-gita-000999",
  "name": {
    "en": "Sadhi kahin deba debati he",
    "or": "ଶାଢ଼ୀ କାହିଁ ଦେବ ଦେବଟି ହେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000141"
  ],
  "kabya": {
    "id": "oa-kabya-000004"
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sadhi-kahin-deba-debati-he-bhairaba-kabisurjya-ratnakara-champu/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶାଢ଼ୀ କାହିଁ ଦେବ ଦେବଟି ହେ",
          "ସଙ୍କୋଚେ ମୋର ପ୍ରାଣ ଯିବଟି ହେ",
          "ସୁନ୍ଦର ହେ ମଲି ଏ ବଡ଼ ଛଇଳି",
          "ଛାଉଲିରେ ଜାତି ନେବଟି ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାକ୍ଷାତ ଦେଖିଲେ ହେଲେ ଲୋଚନେ",
          "ସମସ୍ତଙ୍କୁ ଜଟି ହୁଏ ବଚନେ",
          "ସାଧିଅଛ ଏ କି ସର୍ବଜ୍ଞ ଦେବୀ କି",
          "ଏହାକୁ ପାରିବ କେ ବଟି ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସହସ୍ର କୋଟି ସପତଟି ମୋର",
          "ସତେ କାହିଁ ଛପାଇଛ ଅମ୍ବର",
          "ସୁନା ପୁଅ ପରା ସଖୀ ଆଗେ ଧରା",
          "ନ ପଡ଼ୁ ମୋତେ ରଖିବଟି ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସୁଖସଙ୍ଗାଳି ହେ ଦୁଃଖପାଶୋରା",
          "ସେ ବିଧିକି ନ ମଙ୍ଗିବାରୁ ପରା",
          "ସଢ଼ାଉଛି ଲାଜ ଯନ୍ତ୍ରେ ନିଶି ଆଜ",
          "ସବୁ ସେହିପରି ହେବଟି ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସରୁକଟିରେ ପୀତଚେଳ ଭିଡ଼ି",
          "ସୀମା ପାର କରିଅଛ ମୋ ଶାଢ଼ୀ",
          "ସମର୍ପିତ ଜତ ସଙ୍କୋଚରେ ଲୀନ",
          "ହେଲେ ଆପଣା ଲାଘବଟି ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସଂସାରେ ନ ଥିବାର ତୁମ୍ଭ ସ୍ନେହ",
          "ସୁରତ ସରିଲେ ସହାୟ ନୁହଁ",
          "ସରୋଜାକ୍ଷିଜାତି କଦମ୍ବ ବ୍ରତତୀ",
          "ମନ୍ଦିରେ ସପନ ଦେଖିବଟି ହେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ସମ୍ପାଦିଛ ସତେ କାହିଁ ଆପଣ",
          "ସୀମନ୍ତିନୀକି ସଢ଼ାଇବା ଗୁଣ",
          "ସ୍ମରୁଥିବ ଅନୁଦିନେ କବିଭାନୁ",
          "ରାୟଗୁରୁ ବଳଦେବଟି ହେ"
        ]
      }
    ]
  },
  "sources": [
