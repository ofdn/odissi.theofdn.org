{
  "id": "oa-gita-001097",
  "name": {
    "en": "Dukhi dhana dambha dekhibaku",
    "or": "ଆରେ ଦୁଃଖୀ ଧନ ଦମ୍ଭ ଦେଖିବାକୁ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Da Patala",
      "or": "ଦ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dukhi-dhana-dambha-dekhibaku-da-champu-bhatiari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆରେ ଦୁଃଖୀ ଧନ",
          "ଦମ୍ଭ ଦେଖିବାକୁ ସିନା କଲି ଛନ",
          "ଦୁଃଖମୟ ନ କର ସରସ ମନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦୂରୁ ମୁଁ ଯିବାର ଜାଣି ହରି",
          "ଦରିଦ୍ର ନିଧି ଲଭିଲା ପରି",
          "ଦ୍ୱିଗୁଣ ଆଦରେ ପ୍ରମୋଦ ନଦରେ",
          "ମଜ୍ଜି ଘେନିଗଲେ କରଧରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦୟାଜରଜର କରି ଚିତ୍ତ",
          "ଦନ୍ତବାସେ ରଖି ଦରସ୍ମିତ",
          "ଦଶବାର ଅନାମୟ ମୋତେ ଘେନା",
          "-ଘେନି କରି ପଚାରିଲେ ମିତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଖିଲି ଯାହା ଶ୍ରୀଅଙ୍ଗ ଦ୍ୟୂତି",
          "ଦଳି ହୋଇଗଲା ମୋର ଛାତି",
          "ଦ୍ୱିତୀୟାର ଶଶିଲେଖା ପରି ଦିଶି",
          "-ଗଲେଣି ସେ ଇନ୍ଦ୍ରନୀଳହାତୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦୁର୍ବାର ତୋ ନେତ୍ରାଞ୍ଚଳ ଶର",
          "ଦେବାରୁ ଦୁଃଖ ଦୁଃସହତର",
          "ଦିବାଲା ହେବାର ଦେହ ମଜ୍ଜାସାର",
          "ଜାଣି ଯା ହେଲା ମାନସ ମୋର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦୁର୍ବଳ ସାଳସ ଦେଖି ଚାଲି",
          "ଦୁରୂହରେ କିଛି ପଚାରିଲି",
          "ଦୀର୍ଘ ତପତ ନାସାନିଳ ତେଜିଲେ",
          "ଆହା ମରଇ ତ ବିଚାରିଲି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦେବ ଦଇବ ତୋ ଅଭିମତ",
          "ଦୂର କର ଦ୍ୱାପରକୁ ଚେତ/ମିତ",
          "ଦବିଷ୍ଠ ଏ କଷ୍ଟଯାକ ହେବ ଅଷ୍ଟ",
          "-ଦୁର୍ଗ ନାଥର ଏ ବିରଚିତ"
        ]
      }
    ]
  },
  "sources": [
    {
