{
  "id": "oa-gita-001140",
  "name": {
    "en": "Dhrutiki dhariba re sajani ki kari",
    "or": "ଧୃତିକି ଧରିବ ରେ ସଜନୀ କି କରି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000056"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dhrutiki-dhariba-re-sajani-ki-kari-maruaa-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଧୃତିକି ଧରିବ ରେ ସଜନୀ କି କରି",
          "ନିତିକି ନିତି ହେଲେ ଏପରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପ୍ରେମ ବିଭିନ୍ନରୁ ଯେତେ ଯାତନା ରେ",
          "ବୈରୀବତତ ନ ଘେନନ୍ତି ହରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରୀତି ନ ଜାଣିଲା ସ୍ଥିତି ଏ ଲାଗରେ",
          "ସ୍ୱୈରିଣୀ ବୋଲନ୍ତି ଏ ବ୍ରଜ ନାରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାରିଛି ଦୁର୍ବଳ ନାହିଁ ବିବେକ ରେ",
          "ଶୌରିସୁତରେ କି ଦୋଷ ମୁଁ ନାରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆନ ନ ଘେନନ୍ତି ଏ ଦୁଃଖ ନ ଜାଣୁ",
          "ଗୌରୀ କାଳୁ ସଙ୍ଗତ ସହଚରୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ଶ୍ରୀମତୀ ଗୋ",
          "ଗୌରୀ ତୀର୍ଥକୁ ଗମିଲେ ମୁରାରି"
        ]
      }
    ]
  },
