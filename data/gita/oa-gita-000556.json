{
  "id": "oa-gita-000556",
  "name": {
    "en": "Patha chhadi de mu jibi phula toli",
    "or": "ପଥ ଛାଡ଼ିଦେ ମୁଁ ଯିବି ଫୁଲ ତୋଳି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/patha-chhadi-de-mu-jibi-phula-toli/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପଥ ଛାଡ଼ିଦେ ମୁଁ ଯିବି ଫୁଲ ତୋଳି ରେ ବନମାଳୀ",
          "ସ୍ନାନ କରିଛି ପୂଜିବି କରମାଳି ରେ ବନମାଳୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବୃନ୍ଦାବନେ ପୁଷ୍ପ ତୋଳୁ ରଙ୍ଗେ",
          "ଗୋଷ୍ଠ ସୁଧାକର ରାଧା ଆଗେ",
          "ମିଳନ୍ତେ ଅନାଇଁ ଚମକି ଭାଷନ୍ତି",
          "ଛନ୍ନ ହୋଇ ମନ ଉଦବେଗେ ଯେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚାହିଁବାକୁ ଆଖି ଢାଳି ଢାଳି",
          "ନୁହଇଟି ମୁଁ ସେ ଚନ୍ଦ୍ରାବଳୀ",
          "ବରଜ ଦାଣ୍ଡରେ ବଜାର ବସାଇ",
          "ବଇରୀ ହାତେ ନ ମରା ତାଳି ଯେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବନ ମଧ୍ୟେ ଏ କି କଉତୁକ",
          "ଯା ଯା ବାଟେ ବାଟେ ଯିବା ଲୋକ",
          "ଯେ ତୋ ସଙ୍ଗତେ ଛାଉଲି ହେଉଥିବ",
          "ତା ଆଗେ ହୁଅ ଏ ଭଙ୍ଗୀଯାକ ଯେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୁରଲୀ ଛୁଆଇଁ ଦେଲା ଲାଗେ",
          "ପୁଲକ ପୂରିଗଲା ଶ୍ରୀଅଙ୍ଗେ",
          "ଥରି ଅପସରି ଆଣି ନେତ୍ରୁ ବାରି",
          "ଭାଷନ୍ତି ଲାଗନାଟି ମୋ ସଙ୍ଗେ ଯେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବାଳକ ବୁଦ୍ଧି ତ ହୁଡ଼ି ନାହୁଁ",
          "ଛୁଇଁଦେଲୁ ରହ କହୁ କହୁ",
          "ବଳି ଯାଉଛିନା ଉପଦ୍ରବ ଯାକ",
          "ଯାଉ ବୋଲୁ ସବୁ ସହୁ ସହୁ ଯେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ନୁହଇ ମୁଁ ତୋ ଟାପରା ଭଳି",
          "ରଖ ଯା ଘରେ ଏ ଚାତୁରାଳି",
          "ନିକଟେ ଅଛନ୍ତି ଲଳିତା ଜାଣିଲେ",
          "ମୁଖକୁ ନ ଚାହିଁ ଦେବେ ଗାଳି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ହଟାକୁ ଡରି ଶୁଭାଇ ଡାକି",
          "ନ ପାରିବାରୁ ମୁଁ ସଜନୀଙ୍କି",
          "ନିର୍ମଳ କୁଳ ପତିବ୍ରତା ବରତ",
          "ନାଶ କରୁଛୁ ଏ ଧରମ କି ଯେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ହୋଇବାରୁ ଲାଗ ଲାଗ ହରି",
          "ଲୀଳା କମଳ ଶ୍ରୀହସ୍ତେ ଧରି",
          "ମାରି ହସିଲା ହୋଇ ଧୀରେ ବୋଲନ୍ତି",
          "ପଳାଅ ଅଇଲେ ସହଚରୀ ଯେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "ଯାଅ ହୁଅନା ମୋ ପାଶ ପାଶ",
          "ନାଶ କରିଦେଲୁ ସୁମନସ",
          "ହାତକୁ ହାତ ବଜାଇ ଦେଇ ପୁଣି",
          "ବୋଲୁଛୁ ଆହୁରି କାହା ଦୋଷ ଯେ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "ଛିଡ଼ିଗଲା ଲୀଳା ଅରବିନ୍ଦ",
          "ଏହିକ୍ଷଣି ଆସି ଆଳୀବୃନ୍ଦ",
          "ପଚାରିଲେ ତାଙ୍କୁ କି ବୋଲି କହିବି",
          "ହସୁଛି ଆହୁରି ମନ୍ଦ ମନ୍ଦ ଯେ"
        ]
      },
      {
        "n": 11,
        "lines": [
          "ଓଗାଳୁ ସରଣୀ ଗଲେ ଯେଣେ",
          "ଚରମ ବାସ ଓଟାରୁ କେଣେ",
          "ପଚାରିବି କି ତୋ ଜନନୀଙ୍କି ଯାଇ",
          "ଏ ରୀତିଯାକ ଯେ ଗୋଷ୍ଠାଙ୍ଗଣେ ଯେ"
        ]
      },
      {
        "n": 12,
        "lines": [
          "ପରାର୍ଦ୍ଧ ମଦନ ରୂପୋଦ୍ଧତି",
          "ନବାଞ୍ଜନ ପୁଞ୍ଜ ପରି କାନ୍ତି",
          "କୁଞ୍ଜବନ ଯାକ ଦେବତା ବୁଲୁଛି",
          "ଏହା ଦେଖି ପରା କହୁଥାନ୍ତି ଯେ"
        ]
      },
      {
        "n": 13,
        "lines": [
          "ନାରୀ ମନଧନ ହରିବାର",
          "ଖଣ୍ଟ କୁଳଗୁରୁ ତୁ ନାଗର",
          "ରୂପ ଗୁଣ ବଂଶୀ ଆକୃତି ପ୍ରକୃତି",
          "ଘଟାଇ ଦେଇଛି ବେଦବର ଯେ"
        ]
      },
      {
        "n": 14,
        "lines": [
          "ଆହା ମୁଖରା ଆସନ୍ତା ହେଲେ",
          "ପଳାଇ ଯାଆନ୍ତି ଭାରି ଗଲେ",
          "ଆଉ ଏ ବରଜ ବନକୁ ଆସିବି",
          "ନାହିଁ ମୋ ଦେହରେ ପ୍ରାଣ ଥିଲେ ଯେ"
        ]
      },
      {
        "n": 15,
        "lines": [
          "ହେଟି ବାଲି ଧୂଳି ଖେଳିବାର",
          "ଝାଳେ ଦିଶେ ତନୁ ଜର ଜର",
          "ଚୂର୍ଣ୍ଣ କୁନ୍ତଳ ମୁଖକୁ ପଡ଼ୁଥିଲା",
          "ତର୍ଣ୍ଣକ ପଛରେ ଧାଇଁବାର ଯେ"
        ]
      },
      {
        "n": 16,
        "lines": [
          "ଦର ବିଚଳିତ ବାଲ୍ୟାବସ୍ଥା",
          "ଏଡ଼େ ବେଗି କାହୁଁ ଏଡ଼େ କଥା",
          "ପର ରମଣୀକି ଦେଖିଲେ ଦୂରରୁ",
          "ନଇଁ ଯାଉଥାନ୍ତା ସିନା ମଥା ଯେ"
        ]
      },
      {
        "n": 17,
        "lines": [
          "ପତ୍ନୀ ଶ୍ରଦ୍ଧା ଥିଲେ ବ୍ରଜେଶ୍ୱରୀ",
          "ଆଗେ କହ ଦେବେ ବିଭାକରି",
          "ପର ପରମଦା ପରେ ଆଶା କଲେ",
          "ମନୁ ଯିବ କେତେ ସଧ ସରି ଯେ"
        ]
      },
      {
        "n": 18,
        "lines": [
          "ଜନ୍ମ ଜନ୍ମାନ୍ତରେ ତପ କରି",
          "ପତି ପାଇଥିଲେ ଏହିପରି",
          "ହାତ ପଛଆଡ଼େ ଲୁହ ପୋଛୁ ପୋଛୁ",
          "ଦିନ ନେବ ସିନା ମନ ମାରି ଯେ"
        ]
      },
      {
        "n": 19,
        "lines": [
          "ଯମୁନା ତଟରୁ ନାରୀଙ୍କର",
          "ଲାଟ ବାସ ଚୋରୀ କରିବାର",
          "ଗୋପରେ ଆଜକୁ ବାଜୁଛି ଘୋଷଣା",
          "ଅଣ୍ଟି ନାହିଁ ଲାଜ ଥରକର ଯେ"
        ]
      },
      {
        "n": 20,
        "lines": [
          "ଏହି ଦିନୁ ଏଡ଼େ ଉଚ୍ଛୃଙ୍ଖଳ",
          "ଆହୁରି ଅଛି ତ କାଳ ବେଳ",
          "ଯଉବନ ଯାକ ଛୁଇଁଛି କି ନାହିଁ",
          "ବ୍ରଜ ହୋଇଗଲା କୋଳାହଳ ଯେ"
        ]
      },
      {
        "n": 21,
        "lines": [
          "ବ୍ରଜବଧୂ ଗଲେ ଦଧି ବିକି",
          "ଯମୁନାରେ ବାହି ତରଣୀକି",
          "ସ୍ରୋତ ମଧ୍ୟେ ନାବ ରଖି ତାଙ୍କୁ କଲା",
          "ଉଦାସୀ ଧରଣୀ ଧରିବ କି ଯେ"
        ]
      },
      {
        "n": 22,
        "lines": [
          "ସଖୀମାନେ କହୁଥିଲେ ଯାହା",
          "ଅନୁଭବ ଆଜ କଲି ତାହା",
          "ଶ୍ରୀ ଗୋଷ୍ଠେଶ୍ୱରୀଙ୍କ ଗର୍ଭରୁ ସମ୍ଭୂତ",
          "ହୋଇବାକୁ ଏକା ଥିଲା ଏହା ଯେ"
        ]
      },
      {
        "n": 23,
        "lines": [
          "ଗୋପ ଜାତିରେ ବରହୋତ୍ତଂଶ",
          "ବଂଶୀ ବଜାଇ କେ ନଟ ବେଶ",
          "ହୋଇ ନାଚୁଥିଲା ବିହି କି ବିହିଲା",
          "କରିବାକୁ ସାଧ୍ୱୀବ୍ରତ ଧ୍ୱଂସ ଯେ"
        ]
      },
      {
        "n": 24,
        "lines": [
          "ଯାହାକୁ ସନ୍ତତେ ଡରୁଥିଲି",
          "ତା ଆଗେ ଏକାକୀ ପଡ଼ିଗଲି",
          "କାହାକୁ ଡାକିବି କାନନ ମଧ୍ୟରେ",
          "କେହି ନାହିଁ ଜାତି ହରାଇଲି ଯେ"
        ]
      },
      {
        "n": 25,
        "lines": [
          "ଘରକୁ ଗଲେ ସେ ବିଶାଖାକୁ",
          "ପଚାରିବି ସିନା କାନନକୁ",
          "ଫୁଲ ତୋଳି ଯିବା ବୋଲି ଡାକି ଆସି",
          "କରାଇଲା ଏ ବିଡ଼ମ୍ବନାକୁ ଯେ"
        ]
      },
      {
        "n": 26,
        "lines": [
          "ଗୃହପତି ଜନନୀ ଜଟିଳା",
          "ଗରଳୁ ବଳି ତା ବାଣୀ ଜ୍ୱାଳା",
          "ଏପରି ଥିବାର ଦେଖିଲେ କାଟିବ",
          "କଟାଳ କୁଠାରେ ମୋର ଗଳା ଯେ"
        ]
      },
      {
        "n": 27,
        "lines": [
          "ଗଉରୀ ତୀର୍ଥକୁ ଚନ୍ଦ୍ରାବଳୀ",
          "ଗଲା ପୂଜି ସାରିବନି କାଳୀ",
          "ମନ କାମନା ପୂରାଇବ ସେ ସିନା",
          "ଯାହା ଲୋଡ଼ୁଥିଲେ ତାର ଆଳୀ ଯେ"
        ]
      },
      {
        "n": 28,
        "lines": [
          "ପାଶେ ଥିବାବେଳେ ଆର୍ଯ୍ୟଗଣ",
          "କାହିଁ ଥାଇଟି ଏ ଧୂର୍ତ୍ତପଣ",
          "ଦଶ ଆଙ୍ଗୁଳିକି ଅନାଇ ଚାଲିଲା",
          "ପରି ଦିଶୁଥାଇଁ ଆଚରଣ ଯେ"
        ]
      },
      {
        "n": 29,
        "lines": [
          "ଗୋଷ୍ଠେନ୍ଦ୍ର ନନ୍ଦନ ଅଲୌକିକ",
          "ସୁନ୍ଦରପଣ ସୁଗୁଣ ଯାକ",
          "ଛାରୀ ପରବଧୂ ପରସଙ୍ଗ ରଙ୍ଗ",
          "ଆଶାରେ ନ ବୁଡ଼ା ଏଡ଼େ ଟେକ ଯେ"
        ]
      },
      {
        "n": 30,
        "lines": [
          "କେ ଦେଖିଲେ ପ୍ରୀତି ଥିଲା ପରି",
          "ଏବେ ପଡ଼ିଯିବ ବ୍ରଜେ ହୁରି",
          "ପାଟକ ଜାତି ମୋ ଶିଖଣ୍ଡ ମୁକୁଟ",
          "କୁଳରୁ ଦେବେ ବିଟାଳ କରି ଯେ"
        ]
      },
      {
        "n": 31,
        "lines": [
          "ନାଗର ହଟ ନ କର ବୃଥା",
          "ଲୁଚିବ ନାହିଁଟି ଏ ସର୍ବଥା",
          "ବଦନେ ବାସ ଦେଇ ଲୋକେ ହସିବେ",
          "କାଳକୁ ବୋଲି ରହିବ କଥା ଯେ"
        ]
      },
      {
        "n": 32,
        "lines": [
          "ଏହିକ୍ଷଣଟି ଆର୍ତ୍ତରେ ଧାଇଁ",
          "ସଖାଏ ଆପଣା ନାମ ଦେଇ",
          "ଡାକି ଡାକି ଏହି ପଥେ ଗଲେ ମୁହିଁ",
