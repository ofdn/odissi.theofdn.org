{
  "id": "oa-gita-000788",
  "name": {
    "en": "Jamuna jiba nohila mita",
    "or": "ଯମୁନା ଯିବା ନୋହିଲା ମିତ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000144"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jamuna-jiba-nohila-mita-lalita-kedara-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଯମୁନା ଯିବା ନୋହିଲା ମିତ",
          "ବାଟେ ଜଗି ବସିଅଛି ନନ୍ଦସୁତ ସେହି କଳା ଭୂତ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେ ପୀତପଟିଆ ପଥେ କରି ଠିଆ",
          "ବୋଲୁଥାନ୍ତି ବାଣୀ ଆଚମ୍ବିତ",
          "କରି ବଂଶୀ ସ୍ୱନ ମୋହି ଆମ୍ଭ ମନ",
          "ଚିତ୍ତକୁ କରନ୍ତି ବିହ୍ୱଳିତ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କି ମନ୍ତ୍ର ପଢ଼ାଇ ନିଅନ୍ତି କଢ଼ାଇ",
          "ନ ରହଇ ଆମ୍ଭର ଆୟତ୍ତ",
          "ଯମୁନା କୂଳରେ କୌତୁକ ମୂଳରେ",
          "ବସାଇ ନିଅନ୍ତି ହୁରୁମତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଜଳରେ ପୂରାଇ କୌତୁକ ଭିଆଇ",
          "ବସ୍ତ୍ର ହରି କଲେ ହରକତ",
          "ବୋଲନ୍ତି ଜଳରେ ଉଲଗ୍ନ ହୋଇଲ",
          "କର ଯୋଡ଼ି କର ଦଣ୍ଡବତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କେ ବୋଲେ ଗୋ ସହି ଜଳ ନେବା ପାଇଁ",
          "ଯମୁନା ଘାଟ ହେଲା ଦୁର୍ଘଟ",
          "ହୋଇଲେ ବାହାର ଚିତ୍ତ ଥରହର",
          "ଥିବେ ଚିତ୍ତଚୋରା ଡକାୟତ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଜଳରୁ ବାହାରି ଯେଝା ବସ୍ତ୍ର ଧରି",
          "ପିନ୍ଧି ଫେରି ଅଇଲେ ତୁରିତ",
          "ବୋଲେ ବନମାଳୀ ଆଗୋ ବ୍ରଜବାଳୀ",
          "କୃଷ୍ଣ ଚରଣେ ରଖିଥା ଚିତ୍ତ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
