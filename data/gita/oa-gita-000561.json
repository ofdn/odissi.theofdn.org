{
  "id": "oa-gita-000561",
  "name": {
    "en": "Radha gobinda boli pala re parana",
    "or": "ରାଧାଗୋବିନ୍ଦ ବୋଲି ପଳା ରେ ପରାଣ"
  },
  "composer": "oa-person-000001",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radha-gobinda-boli-pala-re-parana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରାଧାଗୋବିନ୍ଦ ବୋଲି ପଳା ରେ ପରାଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବ୍ରଜବନକୁ ଯାଇ ସ୍ୱାମିନୀ କୁଣ୍ଡେ ରହି",
          "ବୋଲ ହୋଇଲି ମୁଁ ଶରଣରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ରୀ ରାସେଶ୍ୱରୀଙ୍କର କିଙ୍କରୀ ତୁ ପୂର୍ବର",
          "କହିଲି ନିଶ୍ଚେ ଏବେ ଜାଣରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନୁହଇ କେ କାହାର ବୋଲୁ ସବୁ ମୋହର",
          "ହୋଇ ଯିବୁଟି ଅକାରଣରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହଜିଛି ଯେଉଁଠାରେ ଲୋଡ଼ ଯାରେ ରହିଁରେ",
          "ବାହାରେ କରନା ଭ୍ରମଣ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ଭାଷେ ନ ଯାଉଁ ତ ନିମିଷେ",
          "ମିଳିବ ସେଶ୍ୱରୀ ଚରଣରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/radha-gobinda-boli-pala-re-parana/"
    }
  ],
