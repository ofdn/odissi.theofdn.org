{
  "id": "oa-gita-000257",
  "name": {
    "en": "Brajaku chora asichi",
    "or": "ବ୍ରଜକୁ ଚୋର ଆସିଛି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000013"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/brajaku-chora-asichi-gheni-neba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବ୍ରଜକୁ ଚୋର ଆସିଛି ଘେନିନେବ",
          "ଶୁଅ ତୁନି ହୋଇ ରେ",
          "ରଙ୍କର ଧନ ମୋ ଗୋକୁଳ ଚନ୍ଦ୍ରମା",
          "ନିଶି ପାହି ନାହିଁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାତି ଗୋଟାଯାକ ମାତିଲୁ ନାଟରେ",
          "ପଲକ ନ ପକାଇ ରେ",
          "ଗ୍ରାମ ନିଶବଦ ହେଲାନି କି ତୋତେ",
          "ନିଦ୍ରା ଆସୁ ନାହିଁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେ ଶିଖାଇ ଦେଲା ଡୋଳା ଢାଳିବାର",
          "ତାଳ ଉକୁଟାଇ ରେ",
          "ପାଦ ବଥାଇବ ପରା ଆହୁରି କି",
          "ନାଟ ଅଣ୍ଟି ନାହିଁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିମଞ୍ଚନ ଯିବି କେତେ ଝାଳ ବହି",
          "ଗଲା କ୍ଷୁଧା ପାଇ ରେ",
          "ଆସ ଆସ ସ୍ତନ୍ୟପାନ କରାଇବି",
          "ବାବୁ କାଖିଆଇ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଶୁପେନ୍ଦ୍ର କୁଳ ପ୍ରଦୀପ ତୁ ଦେଖ",
          "ଖେଳ ଛାଡ଼ି ଦେଇ ରେ",
          "କେତେବେଳ ହେଲା ଶୟନ କଲାଣି",
          "ବଳରାମ ଯାଇ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଚୁମ୍ବନ ଶିରେ ଦେଇ ନେଲେ ଯଶୋଦା",
          "ହୃଦରେ ଲଗାଇ ଯେ",
          "କର୍ଣ୍ଣ ମୂଳେ ଧୀରେ ଧୀରେ କର ମାରି",
          "ଦେଲେ ପହୁଡ଼ାଇ ଯେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ନିମ୍ବପର୍ଣ୍ଣ ହରିଦ୍ରା ଚୂର୍ଣ୍ଣ ଘଷନ୍ତି",
          "ଅନଳେ ପକାଇ ଯେ",
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ଧୂପ ଦେଲେ",
          "ଧନିଷ୍ଠିକା ନେଇ ଯେ"
        ]
      }
    ]
  },
  "sources": [
    {
