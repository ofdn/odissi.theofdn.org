{
  "id": "oa-gita-001250",
  "name": {
    "en": "Basanta kala re hela kala re",
    "or": "ବସନ୍ତ କାଳରେ ହଲା କାଳ ରେ"
  },
  "composer": "oa-person-000051",
  "mula_raga": [
    "oa-raga-000124"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/basanta-kala-re-hela-kala-re-mallara-adatali-biramitrodaya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବସନ୍ତ କାଳରେ ହଲା କାଳ ରେ",
          "ପ୍ରିୟା କୋଳରେ ନାହିଁ ଯା କେଳିଲୋଳରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆସଇ କାଳିନ୍ଦୀ ତୀର ସମୀର ହିଲ୍ଲୋଳରେ",
          "ମିଶି ଅରବିନ୍ଦ ସୂନ ସୁଗନ୍ଧ ଶୀତଳରେ",
          "ଦହିବା ପାଇଁ ବିରହୀ ବହେ ରହି ରହି",
          "ଯେମନ୍ତେ ଚଣ୍ଡବରହୀ",
          "ଜ୍ୱଳଇ ନିରତେ ହୁଏ ପରତେ",
          "ସ୍ପରଶ ମାତ୍ରକେ ଚିତ୍ତ କରଇ ଚଞ୍ଚଳ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଫୁଟିଲେ ଉପବନରେ ନାନା ଜାତି ଫୁଲ ରେ",
          "ନିଆଳୀ ମଲ୍ଲୀ କେତକୀ ଚମ୍ପକ ବକୁଳ ରେ",
          "କାନନର ଅଳଙ୍କାର ମଦନ ଗୁଣ ଟଙ୍କାର",
          "ସମାନ କରି ଝଙ୍କାର",
          "ଭ୍ରମିଲେ ଭ୍ରମରେ ବାସ ଭ୍ରମରେ",
          "କୁସୁମ ଲତା ପାଦପ ପାଶେ ମାଳ ମାଳରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଣ୍ଡିଲେ ରସା ବଳୟ ରସାଳ ମୁକୁଳ ରେ",
          "କରି ଦିଗବିଦିଗକୁ ସୌରଭ ସଙ୍କୁଳ ରେ",
          "ଢାଳିଦେଲେ ବନପ୍ରିୟ ନିରୟ ଶ୍ରବଣପ୍ରିୟ",
          "ସଙ୍ଗୀତ ଲହରୀ ପ୍ରିୟ",
          "ବିନା ଅନ୍ତର ହେଲା କାତର",
          "ଭାଲ ତଟେ ରଖି କର ହେଲେ ଅସମ୍ଭାଳ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସ୍ୱର୍ଣ୍ଣପୁର ଯୁବରାଜ ଭାଷେ ଏତେ ବେଳରେ",
          "ଉଚିତ ନୁହଇ କରିବାର ମାନ ଗେଲରେ",
          "କେଉଁ ଉପାୟ ରଚିବି କିପରି ଦିନ ବଞ୍ଚିବି",
          "ଚିତ୍ତେ ଧଇର୍ଯ୍ୟ ସଞ୍ଚିବି",
          "ନ ଲାଗେ ଭରସା ବନ୍ଧୁ ଭରସା",
          "ଜଗତୀ ତଳରେ ଗତି ମୋହର କେବଳ ରେ"
        ]
      }
    ]
  },
