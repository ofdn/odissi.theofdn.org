{
  "id": "oa-gita-000703",
  "name": {
    "en": "Se ki sarasara jane",
    "or": "ସେ କି ସାରାସାର ଜାଣେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000066"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/se-ki-sarasara-jane-mukhari-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ କି ସାରାସାର ଜାଣେ",
          "ପ୍ରୀତି ରୀତି ନ ପାଳେ ଯେ ଅଣୁ ପରମାଣେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରାଜମାର୍ଗ ଛାଡ଼ି ଉଠେ ଅବାଟ ଉଠାଣେ",
          "ଦ୍ୱିଜ ସଙ୍ଗ ବିବର୍ଜ୍ଜି ଯେ ମିଶଇ ପଠାଣେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶୁକସାରୀ ମାରି ଫଳ ଯେ ଦିଏ ସଞ୍ଚାଣେ",
          "ଯେ କୁନ୍ଦନେ ଖଞ୍ଜେ ମଣି ନ ବସାଇ ଶାଣେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଫଳ ବିନା ଅତି ଲୋଭ ରଖି ଛାର ପ୍ରାଣେ",
          "ଜଳଧିରେ ଯେ ନ ପଡ଼େ ପ୍ରିୟଜନ ରାଣେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତାହାକୁ କି କଳାବତୀ ନଜରକୁ ଆଣେ",
          "ବିନ୍ଧା ହୋଇ ନାହିଁ ଥରେ ଯେ କୁସୁମ ବାଣେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କନକ ବନିବ ବୋଲି ରୀତି କି ରସାଣେ",
          "ସତ୍ୟ ବୁଦ୍ଧି କରୁଥାଏ ଯେ ଶଶ ବିଷାଣେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଯେ ବାମା ଅଧର ମଧୁ ବସନରେ ଛାଣେ",
          "ମୃଦୁଳ ମାଳତୀ ମାଳା ହୀରାମୁନେ ହାଣେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଯେ ଲେଖି ସୁଚିତ୍ରପଟ ସମରପେ କାଣେ",
          "ମାଗିବା ଲୋକର କରେ ନ ଦିଅଇ ମାଣେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କନକ କୁଡ଼ୁଆ ଥାଉ ଯେ ପିଏ ପିହାଣେ",
          "ଜାଈ ଥାଉଁ ଗିରିମଲ୍ଲୀ ଯେ ଲଗାଏ ଘ୍ରାଣେ"
        ]
      },
      {
        "n": 9,
        "lines": [
          "କର୍ଣ୍ଣ ଯେ ସମର୍ପି ନାହିଁ ଭ୍ରମରେ ପୁରାଣେ",
          "ହରିଙ୍କି ଯେ କରି ନାହିଁ ସ୍ଥୂଳ ପରିତ୍ରାଣେ"
        ]
      },
      {
        "n": 10,
        "lines": [
          "କହେ ଜଗଦ୍ଦେବ ଶିକ୍ଷା ହେଲେ ହେଲେ ଟାଣେ",
          "କେ କାହା ସ୍ୱଭାବ ଛାଡ଼େ ପରାଣ ପ୍ରୟାଣେ"
        ]
      }
    ]
  },
  "sources": [
