  "name": {
    "en": "Pheri ja gale go",
    "or": "ଫେରି ଯା ଗଲେ ଗୋ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000103"
  ],
  "mula_tala": [
    "oa-tala-000004"
