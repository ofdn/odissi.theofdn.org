{
  "id": "oa-gita-001312",
  "name": {
    "en": "Jagata karata natha",
    "or": "ଜଗତ କରତା ନାଥ"
  },
  "composer": "oa-person-000002",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/jagata-karata-natha-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଜଗତ କରତା ନାଥ ମିଛେ ହରି ବୋଲାଉଛ",
          "ଅନ୍ତରେ କପଟ ବହି କ୍ଷିତିରେ ଦାତା ହୋଇଛ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେଲ ଯାହା ନେଲ ତାହା ନ ଜାଣ କି ଚଉବାହା",
          "ଏଥକୁ ଭାର୍ଗବୀନାହା ପତାକା ଯା ଉଡ଼ାଇଛ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଳୀ ରାଜା ଦାନ କାଳେ ତାକୁ ଚାପିଲ ପାତାଳେ",
          "ଗୋପେ ସୁଦାମାକୁ ବଳେ ଅଇଶ୍ୱର୍ଯ୍ୟ ଦିଆଇଛ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଗୋପୀଙ୍କ ବସ୍ତ୍ର ଗୋକୁଳେ ଚୋରି କଲ ଅବହେଳେ",
          "ଦ୍ରୌପଦୀ ଆତଙ୍କ କାଳେ କୋଟି ବସ୍ତ୍ର ଦିଆଇଛ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶୁକ୍ର ମନ୍ତ୍ରୀ ନେତ୍ରେ କୁଶ ମାରି ଲଭିବାର ଯଶ",
          "ଧୂଳି ଖେଳେ ପୀତବାସ ଅନ୍ଧେ ଲୋଚନ ଦେଇଛ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କଂସର ଯେ କୁବଳୟା ତା ଠାରେ କରିଣ ମାୟା",
          "ଗଜକୁ କରିଣ ଦୟା ଚକ୍ରେ କୁମ୍ଭୀର ହାଣିଛ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ହୃଦୟ ବଡ଼ କଠିନ କମଠ ପୃଷ୍ଠରୁ ଟାଣ",
          "ବଳଦେବକୁ କଷଣ ଭୁଜ ତଳେ ରୁହାଇଛ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
