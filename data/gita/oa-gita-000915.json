  "id": "oa-gita-000915",
  "name": {
    "en": "Sangini mada matta pika",
    "or": "ସଙ୍ଗିନୀ ମଦ ମତ୍ତ ପିକ"
  },
  "composer": "oa-person-000085",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "kabya": {
    "id": "oa-kabya-000005"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sangini-mada-matta-pika-jhinjhoti-kisorachandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଙ୍ଗିନୀ ମଦ ମତ୍ତ ପିକ ମଞ୍ଜୁବାଣୀ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜନମନ ବିମୋହନ ଏ ମୋହନ ଠାଣିରେ",
          "ମୋହି ହୋଇ ନ ଯା ନାରୀବର ମଥାମଣି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମୋ କଣ୍ଠରେ ତୁ ନିବିଡ଼େ ଭିଡ଼ି ରଖ ପାଣି ରେ",
          "ସମ୍ଭାଳି ରହ ଧଇର୍ଯ୍ୟ ଧରି ସୁନୀଳ ବେଣୀ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦେଖ କି ମଧୁର କୃପା କଟାକ୍ଷ ଚାହାଣୀ ରେ",
          "ଚକିତେ ଚାହିଁଲା ପରି ଗଣବଣା ଏଣୀ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପୀତ ଚିର ଫେର ମାର ବିଜୟ ନିସାଣି ରେ",
          "ବାସବରତନ କାନ୍ତି ଧୃତି ନିଏ ଟାଣି ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଜଟିଳା ଆସିବ ଜାଣି ଗଲେ ସେ ତରୁଣୀ ରେ",
          "ଭାଷେ ହରି ଦୁଃଖେ ଭଣେ ରାଜ ବଜ୍ରପାଣି ରେ"
        ]
      }
    ]
  },
