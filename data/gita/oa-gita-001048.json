{
  "id": "oa-gita-001048",
  "name": {
    "en": "Darahasi ebe adara",
    "or": "ଦରହାସି ଏବେ ଆଦର"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/darahasi-ebe-adara-bhairabi-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 1,
        "lines": [
          "ଦରହାସି ଏବେ ଆଦର ଦର ନାଶ ହୃଦର",
          "ହର ଦୁଃଖ ମୋହର କର ଉଦ୍ଧାର",
          "କାର ଛାର ଗିର ସାର ନ କର ଶର",
          "ବାରବାର ମାର ମାରଇ ଉରେ ତାର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯଶ ଶଶୀକି ତୁ ପ୍ରକାଶ ନାଶ ସ୍ମର ତମସ",
          "ବସ କୋଳେ ନାରୀଶ ରସ ବରଷ",
          "ଦାସ ଆଶ ତୁ ନ ନାଶ ସରସ ରସ",
          "ଭାଷ ଭାଷ କାଶହାସ ବଶେ ତୋଷ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିହି ରଘୁନାଥ କହଇ ଏହି ଭାଷେ ସୁଦେହୀ",
          "ତହିଁ କି କର ସହୀ କହିଲି ମୁହିଁ",
          "କାହିଁପାଇଁ ସହୀ ଚାହିଁ ବସିଛୁ ମହୀ",
          "ନାହିଁ ନାହିଁ କେହି ତ୍ରାହି ବିହିବୁ ତୁହି"
        ]
      }
    ]
  },
  "sources": [
