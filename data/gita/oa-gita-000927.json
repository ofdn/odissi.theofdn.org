{
  "id": "oa-gita-000927",
  "name": {
    "en": "Naba basanta samaya",
    "or": "ନବ ବସନ୍ତ ସମୟ"
  },
  "composer": "oa-person-000130",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/naba-basanta-samaya-srichandana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନବ ବସନ୍ତ ସମୟ",
          "ନବ ବୃନ୍ଦାବନ ରସମୟ ହେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମଳୟ ଅଚଳ ସମ୍ପତି ପ୍ରଚଳ",
          "ଦକ୍ଷିଣା ପବନ ବହିଲା",
          "ତରୁଲତା ସର୍ବ ନୂତନ ପଲ୍ଲବ",
          "ରସାଳ ମୁକୁଳ ଧଇଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବ ମାଧବିକା ମଧୁପ ଜୀବିକା",
          "ମଲ୍ଲୀ ବଲ୍ଲୀ ଫୁଲ ଫୁଟିଲା",
          "ନିଆଳୀ କମଳ ନୀଳ ଉତପଳ",
          "ଗନ୍ଧ ଗନ୍ଧବହ ଧଇଲା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସକଳୀ ପଲାଶ ନାସିଆ ପଲାଶ",
          "କୁସୁମେ ଉଲ୍ଲାସ ହୋଇଲା",
          "ନିକୁଞ୍ଜ ଭୁବନେ ରମ୍ୟ ଚୂତବନେ",
          "କୋକିଳ ପଞ୍ଚମ ଗାଇଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୋକିଳ ସମୀରେ ମୃଦୁ କମ୍ପନରେ",
          "ଲଳିତ ଲବଙ୍ଗ ଲତିକା",
          "କାନ୍ତର ତକ୍ଷଣେ କରଜେ ଯେମନ୍ତେ",
          "ରମଣୀ ମୃଦୁଳ ଶୀତିକା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମତ୍ତ ମଧୁକର କରିଲା ଝଙ୍କାର",
          "ଅଶୋକ ପ୍ରଫୁଲ୍ଲେ ଘେରିଲା",
          "ବୋଲେ ଶ୍ରୀଚନ୍ଦନ ନନ୍ଦର ନନ୍ଦନ",
          "ଏସନ ସମୟେ ହେରିଲା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/naba-basanta-samaya-srichandana/"
    }
  ],
