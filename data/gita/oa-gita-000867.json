{
  "id": "oa-gita-000867",
  "name": {
    "en": "More karunaku kara sridhara",
    "or": "ମୋରେ କରୁଣାକୁ କର ଶ୍ରୀଧର"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000009"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/more-karunaku-kara-sridhara-kedara-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋରେ କରୁଣାକୁ କର ଶ୍ରୀଧର",
          "ବାରେ ଭବସାଗରରୁ ଉଦ୍ଧର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଜ ହର ରଞ୍ଜନ ବିଜନପ ବାହନ",
          "ବ୍ରଜ ବନିତାଗଣ କଜତରୁଣାରୁଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନନ୍ଦତନୟ ବରକୁନ୍ଦନ ପଟଧର",
          "କୁନ୍ଦରଦନ ଅରବିନ୍ଦ ମୁଖ ରୁଚିର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅରିକୁଳ ମାରକ କରିପତି ପାଳକ",
          "ଗିରିବର ଧାରକ ଦୂରିତ ନିବାରକ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶକ୍ରମୁଖ ବିବୁଧ ଚକ୍ର ବହୁ ଶୁଭଦ",
          "ଚକ୍ରକର ମୁକୁନ୍ଦ ବିକ୍ରମନୁତ ପଦ"
        ]
      }
    ]
  },
  "sources": [
