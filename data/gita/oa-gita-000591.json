{
  "id": "oa-gita-000591",
  "name": {
    "en": "Nila nirada nibha sundara",
    "or": "ନୀଳ ନୀରଦ ନିଭ ସୁନ୍ଦର"
  },
  "composer": "oa-person-000030",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nila-nirada-nibha-sundara/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନୀଳ ନୀରଦ ନିଭ ସୁନ୍ଦର ମୋହନ",
          "ମୂରତିକି ସହି ଅନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଚଳଚପଳା ଜାଳେଜ୍ଜ୍ୱଳ ପୀତ ଦୁକୂଳ",
          "କଳାପି ପିଚ୍ଛ ଚୂଳ ଇନ୍ଦ୍ର ଧନୁର ପରା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହୃଦର ମୋତି ହାର କରକା ତୁଲେ ତୀର",
          "ଝଡ଼ି ପଡ଼ୁଛି କି ରସାରେ ।",
          "ଆହା ମୁରଲୀ ସ୍ୱନ ଗୋପ ଯୁବତୀ ମାନ",
          "ଦମ୍ଭଧର ଛେଦନ ଦମ୍ଭୋଳି କି ପ୍ରଧାନ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କୁଟିଳାଳକାବଳୀ ମୁଖ ପଙ୍କଜେ ଅଳି",
          "ଆଳି ବେଢ଼ି ଅଛନ୍ତି କି ରେ ।",
          "ଶୋଭା ରତ୍ନ କୁଣ୍ଡଳ ଆଭା କି ମନୋହର",
          "ଲୋଭା କରିଣ ଚିତ୍ତ ବିତ୍ତ କରୁଛି ହତ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଳିନ୍ଦ ସୁତା କୂଳେ କେଳି କଦମ୍ବ ମୂଳେ",
          "ତ୍ରିଭଙ୍ଗ ଭଙ୍ଗିମା ଠାଣିକି ।",
          "ଚାହୁଁ ଶ୍ରୀ ହରିବନ୍ଧୁ ଭାବିଣ ହରିବନ୍ଧୁ",
          "ପଟ୍ଟନାୟକ ସୁଧା ସିନ୍ଧୁରେ ହେଲା ମଗ୍ନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
