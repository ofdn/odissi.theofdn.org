{
  "id": "oa-gita-001131",
  "name": {
    "en": "Bauni bauni re guna",
    "or": "ବାଉନି ବାଉନି ରେ ଗୁଣ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000112"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bauni-bauni-re-guna-gopalakrusna-misra-mukhari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବାଉନି ବାଉନି ରେ ଗୁଣ ମଉନି ହେଲେଣି ମା",
          "ଲୋଟୁଛନ୍ତି କଳିନ୍ଦଜା ତୀର",
          "ଫୁଲବନୀ ଅବନୀରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁମରି ସୁମରି ହରି",
          "ଜାଣ ତୋ ସୁଷମା ଶ୍ରୀ କିଶୋରୀ",
          "ଗାଉଥିଲେ ଗୀତ କରି",
          "ଧରି ବୀଣା ପ୍ରାଣ ସଙ୍ଗିନୀ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରସାରି କର ସାରିକି",
          "ବସାଇ ଧୀରେ ଗୋ ସ୍ୱାମିନୀକି",
          "ଡାକ ଆସିବେ ଏଣିକି",
          "ବୋଲୁ ନେତ୍ର ଥନଥନ ନୀରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆସୁଥିବୁ ପରା ବୋଲି",
          "ଘଡ଼ି ଘଡ଼ିକି ନବ ଛଇଳୀ",
          "ତୋଳି ସଘନେ ଭ୍ରୂବଲ୍ଲୀ",
          "ଚାହୁଁଥିଲେ ଚନ୍ଦ୍ରବଦନୀ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶ୍ୟାମ କରିବାର ଦୋଷ",
          "ସହୀ ମୋହର ହେଲା ଗୋ ଆସ",
          "ହୁଅ କି ନ ହୁଅ ବେଶ",
          "ବ୍ରଜ ଯୋଷା ଶିରମଣ୍ଡନୀ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନଖରୁ ଶିଖ ପର୍ଯ୍ୟନ୍ତେ",
          "ଆଳୀ ସାଜିଲେ ବେଶ ତ୍ୱରିତେ",
          "ଗୋପାଳକୃଷ୍ଣ ପୁରତେ",
          "ଘେନିଗଲା ଲାଗ ବର୍ତ୍ତନୀ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/bauni-bauni-re-guna-gopalakrusna-misra-mukhari/"
    }
  ],
