{
  "id": "oa-gita-001113",
  "name": {
    "en": "Sara saja sarasa lapana re",
    "or": "ସାର ସଜ ସାରସ ଲପନା ରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sara-saja-sarasa-lapana-re-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାର ସଜ ସାରସ ଲପନା ରେ",
          "ସାଜ ମୋ ପରି ସଜ କୋପନା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବୀଣାଜିଣା ବଚନା କିଣା ଜନେ ବିମନା",
          "ହେଉ କିମ୍ପାଇଁ ସ୍ନେହ ଅଧୀନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାଗରତ କୋପନା ନାଗରେ ତୁ ହସ ନା",
          "ନାଗରା ବାଜେ ତୋର ମୁଁ ସିନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଏ ରାତିରେ ନବୀନା ହରା ରାତି ବେଦନା",
          "ସହି ହେବ କି ବନ୍ଧୁ ତୋ ବିନା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସୁନାରୀଶ ସୁମନା ତୁ ହୋଇଲେ ବିମନା",
          "କି ଗତି ଅଛି ମୋରଟି ଅନା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କର ଧରୁଛି ଅନା ମଥା ପୋତି ବସନା",
          "ଗୋପାଳକୃଷ୍ଣେ ଦୟା ତେଜନା ରେ"
        ]
      }
    ]
  },
