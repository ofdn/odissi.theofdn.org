{
  "id": "oa-gita-000233",
  "name": {
    "en": "Ghena ghena re mana",
    "or": "ଘେନ ଘେନ ରେ ମନ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000078"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ghena-ghena-re-mana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘେନ ଘେନ ରେ ମନ",
          "ଶ୍ରୀକୁଣ୍ଡବାସୀଙ୍କର ଶିକ୍ଷାବଚନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯାହାଙ୍କର ମଧୁର ସୌନ୍ଦର୍ଯ୍ୟ ଛଟା",
          "ରତି ଗଉରୀ ଲୀଳା ସୌନ୍ଦର୍ଯ୍ୟ ହଟା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯାହାଙ୍କର ସୌଭାଗ୍ୟ ତ୍ରିଲୋକେ ନାହିଁ",
          "ଶଚୀ ଲକ୍ଷ୍ମୀ ଆଦିଙ୍କି ପରା ଭାବଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯାହାଙ୍କର ସୁଗୁଣାବଳୀ ଅପାର",
          "ଚନ୍ଦ୍ରାଦି ବ୍ରଜ ଯୋଷା ହେଲେଟି ଦୂର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସେହି ଶ୍ରୀ ସ୍ୱାମିନୀଙ୍କି ତୁ ନିରନ୍ତର",
          "କିଙ୍କରୀ ଅଭିମାନେ ଭଜନା କର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ସୌନ୍ଦର୍ଯ୍ୟ ସଉଭାଗ୍ୟ ସୁଗୁଣବତୀ",
          "ସେ କୃଷ୍ଣପ୍ରିୟା ରାଧା ଦେବେ ସୁଗତି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶ୍ରୀବ୍ରଜେ ବାସ ବାଞ୍ଛା କରି ମାନସ",
          "ଗୋପାଳକୃଷ୍ଣ ହରୁ ତ୍ରିତାପ କ୍ଳେଶ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
