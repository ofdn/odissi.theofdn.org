{
  "id": "oa-gita-000064",
  "name": {
    "en": "Karunanidhana kamalanayana",
    "or": "କରୁଣାନିଧାନ କମଳନୟନ"
  },
  "composer": "oa-person-000033",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/karunanidhana-kamalanayana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କରୁଣାନିଧାନ କମଳନୟନ ଶ୍ରୀବୃନ୍ଦାବନଚନ୍ଦ୍ରମା",
          "କରୁଛି ଯୁହାର କୋଟି କୋଟି ବାର",
          "ମୋ ଦୋଷକୁ କର କ୍ଷମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କଞ୍ଜ ବେନି ପୟରେ",
          "କିଶୋରୀମଣିଙ୍କ ସହିତରେ",
          "କୁଞ୍ଜେ ବିଜେ ହେବା ଅବସରେ",
          "କିଛି ଜଣାଇବି ଖେଦବାରେ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଳ ଦେବତା ମୋହର",
          "ଶ୍ରୀପ୍ରଭୁ କି ନ ଜାଣ ମନ କଥା",
          "କଳପନା କରି କୁଛିତ ଲୋକେ ମୋ",
          "ପୋତାଇ ଦେବାକୁ ମଥା ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କପଟୀ କରୁଛନ୍ତି ବିଚାର",
          "କଳାପୀଙ୍କି ବେଗେ ଶିକ୍ଷାକରି",
          "କ୍ରୋଧେ ଦଣ୍ଡନ୍ତୁ କୁମ୍ପୁନି ଘର ହେ",
          "କୃପା ଅପାଙ୍ଗ ପଡ଼ୁ ମୋହ ପର ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କନକ ରଜତ ଭୂଷଣ",
          "ଯାବତ ସହିତେ ନେଇ",
          "କରି ଦୁର୍ବିଚାର ଖୋଜୁଛନ୍ତି ମୋର",
          "ଇଜ୍ଜତ ନେବାର ପାଇଁ ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କନ୍ଦଳ ଲଗାଇ ତାଲୁକା ଯାକର",
          "ପ୍ରଜାଙ୍କୁ କରାଇ ମେଳି",
          "କଉଡ଼ିମାନଙ୍କ ଆସିବା ବାବତ",
          "ନ ଦେଇ କଲେଣି ଗାଳି ହେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କରୁ ନାହଁ କିପାଁ ମୋରେ ଦୟା କେଣେ",
          "ଲଗାଇଛ ଏତେ ମାୟା",
          "କେତେ ବୋଇଲେଣି ମୋତେ ବାୟା ହେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କରଚକ୍ର ଯେବେ ଥରେ ମାତ୍ର",
          "ଯେବେ ଚଳନ୍ତା ତାଙ୍କ ଉପରେ",
          "କରି ମୁଁ ଗୁହାରି ବାହାରନ୍ତି କିପାଁ",
          "ତୁମ୍ଭେ ଶୁଣିଲେ ସତ୍ୱରେ ହେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "କମଳାଦେବୀପତି କପଟ",
          "ମୋଠାରେ କଲ ଅତି ହେ",
          "କହିବି କାରେ ମୁଁ ତୁମ୍ଭ ଚରିତ ହେ",
          "ବ୍ରଜସୁନ୍ଦର ଭୂପତି ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/karunanidhana-kamalanayana/"
    }
  ],
