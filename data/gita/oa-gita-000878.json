  "name": {
    "en": "Sajani kari nahin dosa",
    "or": "ସଜନୀ କରି ନାହିଁ ଦୋଷ"
  },
  "composer": "oa-person-000128",
  "mula_raga": [
    "oa-raga-000056"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "kabya": {
    "id": "oa-kabya-000007"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sajani-kari-nahin-dosa-maruaa-vikram-deb-varma/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜନୀ କରି ନାହିଁ ଦୋଷ",
          "ତୋ ବେନି ପାଦ ସାରସରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାହା ବାଣୀ ଶୁଣି ଗୁଣମଣି ଏଡ଼େ ରୋଷରେ",
          "କିଣାଜନ ଠାରେ ମାନ କରିବାରେ",
          "କେତେ ଲଭିବୁ ପୌରୁଷରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୋର ବିନା କାହାକୁ ନ ଜାଣଇଁ ଅବଶ୍ୟ",
          "ତୋ ଅଙ୍ଗକୁ ଛୁଇଁ ନିୟମକୁ ମୁହିଁ",
          "କରିବି ଲଭି ହରଷରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ହୃଦୟ ହାରଫଣୀ କରୁ ମୋର ନାଶ",
          "ମୋହର ବଚନେ ରେଣୁର ସମାନେ",
          "ମିଛ ପାଇଲେ ପ୍ରକାଶରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଲି ଯେବେ ଦଣ୍ଡ ଭଳି ଅକ୍ରମ ତୋ ପାଶ",
          "ନଖକୁନ୍ତେ ତୋର ବିଦାରି ମୋ ଉର",
          "ବଜ୍ରଦନ୍ତେ ଗଣ୍ଡ ଦଂଶରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବିକ୍ରମ ବନ୍ଦିନୀ ମାନ ତେଜ କୋଳେ ବସ",
          "ଦାସ ନାଶ ଗଲା ବେଳେ କଲେ ହେଳା",
          "ରହିବଟି ଅପଯଶରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
