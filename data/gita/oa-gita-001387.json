{
  "id": "oa-gita-001387",
  "name": {
    "en": "Girija haramohini maa",
    "or": "ଗିରିଜା ହରମୋହିନୀ ମା"
  },
  "composer": "oa-person-000015",
  "mula_raga": [
    "oa-raga-000076"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/girija-haramohini-maa-kanada-kabichandra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗିରିଜା ହରମୋହିନୀ ମା",
          "ଭବସାଗର ତାରିଣୀ । ଘୋଷା।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶଙ୍କର ହୃଦ ପର ବାସିନୀ",
          "କିଙ୍କର ଜନ ମନ ତୋଷିଣୀ",
          "ପଙ୍କଜ ପଦ ଦରନାଶିନୀ ମା,",
          "ସୁଖଦା, ଶୁଭଦା, ବରଦେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମହiଷାସୁର ମର୍ଦ୍ଦିନୀ ମା",
          "ସୁର ନର ମୋଦବର୍ଦ୍ଧିନୀ",
          "ଚନ୍ଦ୍ରମଉଳି ଅରଧାଙ୍ଗିନୀ",
          "ଚଣ୍ଡାସୁର ରଣରଙ୍ଗିନୀ",
          "ଚଣ୍ଡୀ ଦଳ ବଳ ସଙ୍ଗିନୀ",
          "ଫଳଦା, କୁଳଦା, ବରଦେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶରଣାଗତ ପାଳିନୀ ମା",
          "କରୁଣାମୟୀ ଶୂଳିନୀ",
          "ଛବି ତବ କୋଟି ଭୁବନ ନନ୍ଦେ",
          "ରବି ଶଶଧର କିରଣ ନିନ୍ଦେ",
          "କବିଶଶୀ ନିତି ଚରଣ ବନ୍ଦେ",
          "କରୁଣା, କର ମା, ବରଦେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
