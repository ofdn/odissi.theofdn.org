  "id": "oa-gita-000365",
  "name": {
    "en": "Hati basichi kisori",
    "or": "ହଟି ବସିଛି କିଶୋରୀ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000085"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hati-basichi-kisori/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହଟି ବସିଛି କିଶୋରୀ",
          "ଭେଟିବାକୁ ବଂଶୀଧାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନ ଜଡ଼ାଇ ଚିତ୍ତ କାହିଁରେ ଗୋରୀ",
          "ରାଜଡ଼ା ଉପଚାର ପରିହରି",
          "ସଜଡ଼ାଇ ରଖିଥିବା ଘନସାର",
          "ଅଜଡ଼ାଇ ଦେଇକରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଝଡ଼ି ନୟନୁ ଅଶ୍ରୁଧାରା ବାରି",
          "ମାଡ଼ି ବସିଛି ଚିତ୍ତେ ଚିନ୍ତାଗିରି",
          "ଛାଡ଼ି ଦେଇଛି ଅଖିଳ ସୁଖ ଶିରୀ",
          "ଲୋଡ଼ି ତାହା ସଙ୍ଗଶିରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନ୍ଦରଧରାକୁ ସଙ୍ଗରେ ଧରି",
          "ବୃନ୍ଦାବନେ ଭେଟାଇବା ଶ୍ରୀ ହରି",
          "ଫନ୍ଦା ସରିଯିବା ଠାରୁ ଆଉ ଅବା",
          "ନିନ୍ଦାକୁ କି ପାଇଁ ଡରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦ୍ୱିଜ ରଘୁନାଥ ଚିତ୍ତେ ବିଚାରି",
          "ସଜନୀ ଲାଗି ମୁଁ ହେବି ସଞ୍ଚାରୀ",
          "ଆଜ ଭେଟାଇବି ବ୍ରଜରାଜ ଜେମା",
          "ଲାଜ ଭୟ ଦୂର କରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hati-basichi-kisori/"
    }
  ],
