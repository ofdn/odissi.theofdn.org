{
  "id": "oa-gita-000502",
  "name": {
    "en": "Brajendra kumara tarani tanaya",
    "or": "ବ୍ରଜେନ୍ଦ୍ର କୁମାର ତରଣୀ ତନୟା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/brajendra-kumara-tarani-tanaya-bhairabi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସେ ବ୍ରଜେନ୍ଦ୍ର କୁମାର",
          "ତରଣୀ ତନୟା ତରଣୀରେ ଆଜ",
          "କଲା କେତେ ହରବର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପାରି କରିଦେବି ବୋଲି ସେ ପାରିକି",
          "ହାତ ଧରି ଘେନିଗଲା",
          "ତରୀରେ ବସାଇ ଅଗାଧ ବାରିରେ",
          "କ୍ଷେପଣୀ ଭସାଇ ଦେଲା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ରୀକିଶୋରଶଶୀ କରେ ଧରି ବଂଶୀ",
          "ଅଳପ ଅଳପ ହସି",
          "ସେ ପ୍ରାନ୍ତରେ ରହି ଦେଲା ମା ଝୁଲାଇ",
          "ଗଲା ଗଲା ବୋଲି ଭାସି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଦ୍ୱୀପ ନିକଟରେ କଣ୍ଠ ଦଘ୍ନ ନୀରେ",
          "ନଉକା ଥକାଇ ଦେଲା",
          "ଜଣ ଜଣକୁ କାଖିଆଇ ପହଁରି",
          "ଏ ପାଖରେ ଛାଡ଼ିଦେଲା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆଣୁ ମୁଖେ ମୁଖ ଲଗାଇ ଦିଅଇ",
          "ଅଣାୟତ୍ତ ହେଲା ପରି",
          "ନିତମ୍ବରେ ହାତ ଦିଅଇ ଊର୍ଦ୍ଧ୍ୱକୁ",
          "ଟେକିଲା ପରାୟେ କରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ କହଇ ତୁନି ହୁଅ",
          "ସେଠାରେ ଗଲା ସେ କଥା",
          "ବ୍ରଜଯାକ ସ୍ଫୁଟ ହୋଇଯିବ ଏବେ",
          "ଲାଜେ ନୁଆଁଇବ ମଥା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
