    "section": {
      "en": "Śa Patala",
      "or": "ଶ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-sikhanda-chula-kabisurjya-champu-nagaballi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ଶିଖଣ୍ଡ ଚୂଳ",
          "ଶ୍ରମ କି ଆଜ ଯାକେ ହେଲା ସଫଳ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶର୍ବରୀ ନିଦ୍ରା ବିନା ଗଲା କି ସରି",
          "ଶମ୍ବରପର ପୁର କଲ କି ଜୂରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ରୀଅଙ୍ଗ ବେଶ କିମ୍ପା ଏପରି ଆଜ",
          "ଶରଦଚନ୍ଦ୍ର ଚୁମ୍ବୁ ନାହିଁ କି ଲାଜ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶିଶୁ ହେଲେହେଁ ତୁମ୍ଭେ କଲଭ ସରି",
          "ଶଶ କିଶୋରୀଟିକି ଦେଲ ଯେ ସାରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଶିରୀଷ ମାଳା ଦଳିଦେଇ କୁଠାରେ",
          "ଶଙ୍କା ନ କଲ ସଖୀମାନଙ୍କ ଠାରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶରମପ୍ରଦ ଆଜ ସରିକି ହେଲା",
          "ଶମନ ସ୍ୱସା ତଟ ଅଟବୀ ବୁଲା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶିର ସୁନ୍ଦର ଦିଶେ ଯାବକ ବୋଳେ",
          "ଶରଣ ବୋଲି କି ପଡ଼ିଲ ପା’ତଳେ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଶପଥ ଶତ ଶତ କହଟି ସତ",
          "ଶ୍ରୀ ବାଲୁଙ୍କେଶ ନୃପ ରଚିଲେ ଗୀତ"
        ]
      }
    ]
  },
  "sources": [
    {
