{
  "id": "oa-gita-000306",
  "name": {
    "en": "Sakhi e ki bidambana",
    "or": "ସଖୀ ଏ କି ବିଡ଼ମ୍ବନା"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000061"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sakhi-e-ki-bidambana-lalitaa-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଖୀ ଏ କି ବିଡ଼ମ୍ବନା",
          "କାହିଁ ଯିବେ କୁଳବତୀ ନ ହାରି ଚେତନା ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୀପତରୁ ମୂଳେ ଯାହା ଦେଖିଲି ମୁଁ ଆଜ",
          "ତୋ ଆଗେ କହୁଛି ଫେଡ଼ି ଛାଡ଼ି ଭୟ ଲାଜ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସେ କିଏ କାହା କୁମର ମୁଁ ତ ନାହିଁ ଚିହ୍ନି",
          "ବାଇ କରାଇଲେ ଚିତ୍ତ କାହିଁକି କି ଘେନି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବିକି ହୋଇଗଲି ତାଙ୍କ ନୟନ ଇଙ୍ଗିତେ",
          "କି କି ବା ନ କଲେ ମୋତେ ମୃଦୁ ବଂଶୀଗୀତେ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଲାବଣ୍ୟ ରସରେ ତନୁ ଗୋଟିକ ତା ଗଢ଼ା",
          "ମୋହନ ମୂରତି ତ୍ରିଭଙ୍ଗୀରେ ଥିଲେ ଛିଡ଼ା ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଇନ୍ଦ୍ରନୀଳମଣି ଜିଣି ତେଜ ଦାଉ ଦାଉ",
          "ଦେଖିଲା ମାତ୍ରକେ ପାଦ ନ ଚଳିଲା ଆଉ ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶାଶୁଙ୍କ ଡରେ ଅତ୍ୟନ୍ତ କଷ୍ଟେ ମୁଁ ଅଇଲି",
          "ବିଶ୍ୱାସେ ଆଜି ତୋ ଆଗେ ସ୍ୱରୂପ କହିଲି ଗୋ"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ବୋଲେ ବନମାଳୀ ରାଧା ବାଧା ବାଣୀ ଶୁଣି",
          "ସେହିଟି ତୁମ୍ଭର କଣ୍ଠତଟ ରତ୍ନମଣି ଗୋ"
        ]
      }
    ]
  },
