{
  "id": "oa-gita-001427",
  "name": {
    "en": "Mana baligala tahun",
    "or": "ମନ ବଳିଗଲା ତହୁଁ"
  },
  "composer": "oa-person-000166",
  "mula_raga": [
    "oa-raga-000143"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-baligala-tahun/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନ ବଳିଗଲା ତହୁଁ ଆସୁ ନାହିଁ",
          "ଲୌହ ଚୁମ୍ବକ ପାଷାଣ ପରା ହୋଇ ।ପଦ।"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଲଳିତା ବିଶାଖା ସଖୀ ବେନିଙ୍କର",
          "ଏହି ବାଣୀ ଶୁଣି ଧନୀ",
          "କାତର ହରଷେ ତରତରେ ଭାଷେ",
          "ନାଶ କଲେ ମୋତେ ଜଣ ତିନି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୃଷ୍ଣ ବୋଲି ଯେଉଁ ଦ୍ୱିଅକ୍ଷର",
          "ଅତ୍ୟନ୍ତ ମଧୁର ମନୋହର",
          "ଲଳିତା ବଦନୁଁ ଶ୍ରୀ ବୃନ୍ଦା କାନନୁଁ",
          "ପହିଲେ ଶୁଣିଲି ନାମ କାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅତ୍ୟନ୍ତ ମୃଦୁ ମଧୁର ସ୍ୱର",
          "ଦ୍ୱିତୀୟେ ଶୁଣିଲି ବଂଶୀ କାର",
          "ତହୁଁ ପରମାଦ ଚିତ୍ତେ ଉନମାଦ",
          "ଆନ ନ ରୁଚଇ କର୍ଣ୍ଣଦ୍ୱାର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଏ ଚିତ୍ରପଟରେ ନବମୂର୍ତ୍ତି",
          "ନବଘନ ଜିଣି ତନୁଦ୍ୟୁତି",
          "ସୁନ୍ଦରପଣରେ କୋଟି ମଦନରେ",
          "ନ ଥିବ ଯାହାର ନଖକାନ୍ତି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଅଲକ୍ଷ୍ୟ ଶ୍ରୀମୁଖ ଦେଖି ଯାର",
          "ହୃଦ ହୋଇଯାଏ ରସପୂର",
          "ବିନା ପ୍ରୟୋଜନେ ଉତ୍ସାହ ସଘନେ",
          "ବଢ଼ି ଉଚ୍ଛୁଳଇ ବାରବାର"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଏ ତିନି ପୁରୁଷେ ରତି ପ୍ରୀତି",
          "ହେବାଠାରୁ ମୃତ୍ୟୁ ଶ୍ରେୟ ଅତି",
          "ନିର୍ଲ୍ଲଜ ଜୀବନ ଶମନଭବନ",
          "ନ ଯାଇ ଯାହା ରହିଛି ଏଥି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ଛଡ଼ାଇଲେ ଛାଡ଼ ନ ଗଲା ତ",
          "ନ ଛାଡ଼ିଲେ ପରାଣ ଗଲା ତ",
          "ଶ୍ୟାମବନ୍ଧୁ କହି ରାୟୀ ଭାଷେ ଅହି",
          "ଚୁଚୁନ୍ଦ୍ରା ଧରିଣ ହେବା ମତି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mana-baligala-tahun/"
    }
  ],
