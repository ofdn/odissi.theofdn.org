{
  "id": "oa-gita-001006",
  "name": {
    "en": "Nahin kari nahin ta mun",
    "or": "ନାହିଁ କରି ନାହିଁ ତ ମୁଁ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000031"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nahin-kari-nahin-ta-mun-kabisurjya-baradi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାହିଁ କରି ନାହିଁ ତ ମୁଁ କାହିଁକି ଗୋ ରାଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ତାଙ୍କ ସୁଖ ପାଇଁ ସିନା ଶଙ୍କରଙ୍କ ଉପାସନା",
          "ଏ ଦେହ ଏ ଭୋଗ ଏ ପରାଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଶ୍ୟାମ ମୋର ଉନ୍ମାଦକ ଶ୍ୟାମ ମୋ ଗଳା ପଦକ",
          "ଶ୍ୟାମ ତ ମୋ ହୃଦ ପଞ୍ଚବାଣ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବ୍ରଜବନ୍ଧୁ ମୋ ରତନ ମୋ ସେବାର ବରତନ",
          "ସେହି ତ ମୋ ବରତ ବସାଣ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନ ଜାଣି ଅଛି ଭଜି ଜାଣି ଜାଣି ମୋ ମରଜି",
          "ଧନ ମୋର କେଡ଼େ ଅବୁଝାଣ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦୁଃଖ ଥିବ ପରା ମନେ ତାଙ୍କ ପଦକଞ୍ଜ ସ୍ତନେ",
          "ଲଗାଇ ଚୁମ୍ବାଇଦିଅ ଆଣ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ନୃପ ଜଗଦ୍ଦେବ ଭାଷେ ମୋ ବେଶ ସେ ମୋ ଶୋଭା ସେ",
          "ତାହା ବାହାରେ କେ ପରିତ୍ରାଣ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nahin-kari-nahin-ta-mun-kabisurjya-baradi/"
    }
  ],
