{
  "id": "oa-gita-000406",
  "name": {
    "en": "Syama sanga ke mo chhadaila re",
    "or": "ଶ୍ୟାମ ସଙ୍ଗ କେ ମୋ ଛଡ଼ାଇଲା ରେ"
  },
  "composer": "oa-person-000090",
  "mula_raga": [
    "oa-raga-000071"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-sanga-ke-mo-chhadaila-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ସଙ୍ଗ କେ ମୋ ଛଡ଼ାଇଲା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନୟନ ପିତ୍ତୁଳୀ ନୟନ ମୋ ଖୋଳି",
          "ନେଇ ମହୀ ମଧ୍ୟେ ଛଡ଼ାଇଲା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲଗାଇ ପ୍ରେମ ଲତା ପ୍ରେମ ଫଳ ଫଳିବା",
          "ସମୟେ କି ଝଟା ପକାଇଲା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବହୁ କାଳ ଭୋଖି ସୁଧାଭାଣ୍ଡ କରୁ",
          "ଲଗାଇ ସତେ କି ଛଡ଼ାଇଲା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମଧୁକର ପ୍ରୀତି କେତକୀ ପାଶକୁ",
          "ଯିବା ପଥେ କଣ୍ଟା ପକାଇଲା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦାସ ମଧୁ କହି ଏତେ ଦୁଃଖ ସହି",
          "ନ ମାରି ଯା ଦେହ ସଜାଇଲା ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
