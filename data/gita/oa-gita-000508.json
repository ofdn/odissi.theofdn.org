{
  "id": "oa-gita-000508",
  "name": {
    "en": "Prana bandhua aja ta anauni",
    "or": "ପ୍ରାଣବନ୍ଧୁଆ ଆଜ ତ ଅନାଉଣି ନୂଆ ରେ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000003"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/prana-bandhua-aja-ta-anauni-nua-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ପ୍ରାଣବନ୍ଧୁଆ",
          "ଆଜ ତ ଅନାଉଣି ନୂଆ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସ୍ମିତ କାନ୍ତି ପ୍ରସରୁ",
          "ସରୁମଧ୍ୟାରେ କରୁ",
          "ବସୁଧା ସୁଧାରେ ଗାଧୁଆ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହିଆରେ ଢଳି ମୋର",
          "ସୁଆଦ ରଦାମ୍ବର",
          "ପିଆଇ ଧନ ମୋତେ ଜିଆ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିଶ ମରଦୁ ଅଛି",
          "କି ସମଜୁଛୁଛି ଛି",
          "ବିଷମ ବିଶିଖ ମଦୁଆ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅମଳ ମୃଦୁ ଦେହା",
          "ଶ୍ୟାମଳ ଉରେ ବୁହା",
          "ଯାମଳ ପୀୟୁଷ ମାଠିଆ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀ ଜଗଦ୍ଦେବ ଭାଷେ",
          "ଦେବୀ ସବ୍ରୀଡ଼ ହାସେ",
          "ଅଣିମାଦି ସୁଖକୁ ଦିଆ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
