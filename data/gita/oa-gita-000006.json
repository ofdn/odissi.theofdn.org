  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Kha Patala",
      "or": "ଖ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kharapa-tu-helu-re-kha-champu-kedara-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଖେଳଲୋଳ ଖଞ୍ଜନାକ୍ଷି କି ସାହସ କଲୁ ରେ",
          "ଖରାପ ତୁ ହେଲୁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଖର୍ବ ହୋଇ ସୁରତରୁ କୁସୁମ ବାଞ୍ଛିଲୁ ରେ",
          "ଖେଦ ବୀଜ ନିଜ ହୃଦ କେଦାରେ ବିଞ୍ଚିଲୁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଖିଆଲ ପରି କି ଧନ ମନରେ ଭାଳିଲୁ ରେ",
          "ଖଳିକାର ନୋହିଁ କଳା ନାଗକୁ ଚାଳିଲୁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖରା ସ୍ମରି ଝାଉଁଳିବା ଶ୍ରୀଅଙ୍ଗ ପାଇଲୁ ରେ",
          "ଖମଣି ମଣ୍ଡଳକୁ ତୁ କର ବଢାଇଲୁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଖାଇ ଦେଇ କି ଅମଳ ଅଚେତା ହୋଇଲୁ ରେ",
          "ଖାରା ଖଣ୍ଡାଧାରା ଖଟ ବିଚାରି ଶୋଇଲୁ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଖଟେ ଅଷ୍ଟଦୁର୍ଗ ନାଥ ତୋ ପଦେ ପହିଲୁ ରେ",
          "ଖଣ୍ଟ କରେ ଧନ ଦେଇ ପଦେ ନ କହିଲୁ ରେ"
        ]
      }
    ]
  },
