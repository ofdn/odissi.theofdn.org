    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ରୀ ବୃନ୍ଦାବନ ଚନ୍ଦ୍ରମା ଘନବରନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାମ କୋଟି ଅଭିରାମ ନଟବର",
          "କିଣା ଦାସୀଜନେ କେଣେ ଏ ନିଷ୍ଠୁର",
          "ଜୀବନେ ମରଣେ ଶୟନେ ସ୍ୱପନେ",
          "ତୁମେ ମୋର ସୁଖ ସୀମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଭଣେ ତାରିଣୀ ଘୁଞ୍ଚାଅ ମୋ ଦୁର୍ଦ୍ଦଶା",
          "ବିତର ପରାଣରେ ଆଶା ଭରସା",
          "କଲେ ଅବହେଳା ବୁଡ଼ିବ ମୋ ଭେଳା",
          "ବରଜରାଜ ସୁଷମା"
        ]
      }
    ]
  },
