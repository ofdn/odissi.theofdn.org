{
  "id": "oa-gita-000711",
  "name": {
    "en": "Saja hoitha re gajaraja gati aja",
    "or": "ସଜ ହୋଇଥାରେ ଗଜରାଜ ଗତି ଆଜ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000040"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/saja-hoitha-re-gajaraja-gati-aja-ramakeri-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସଜ ହୋଇଥାରେ ଗଜରାଜ ଗତି ଆଜ",
          "ରଜନୀ ଆସିବେ ସଜ ନୀଳୋତ୍ପଳ",
          "ଶ୍ୟାମ ବ୍ରଜ ଯୁବରାଜ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସୁନା ଲତିକାରେ ମୀନା ପରି କଳା",
          "ଝୀନ ଶାଢ଼ୀ ଯତ୍ନେ ପିନ୍ଧି",
          "ବଳାପହ ମଣି ନୀଳ କୁନ୍ତଳରେ",
          "କଳାପ କମର ବାନ୍ଧି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପୁଣ୍ଡରୀକବର ଯୁଗେ ଇନ୍ଦୀବର",
          "ଯୁଗଳୀ ଲଢ଼ାଇବାକୁ",
          "ମର୍ଦ୍ଦିବା ଲାଞ୍ଛନ ତାପିଞ୍ଛେ କନକ",
          "ମଞ୍ଜରୀ ମିଳାଇବାକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମସାରମଣି ହେମସାର ସମୂହ",
          "ମିଶିବାର ବୁଝିବାକୁ",
          "ବରତୁଳ ପୟୋଧରେ ରତିବର",
          "ତୁଲେ ଥରେ ଯୁଝିବାକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କୁଞ୍ଜାଳୟ ଝଷଧ୍ୱଜ କେଳିରସ",
          "ଭୁଞ୍ଜାଇ ଭୁଞ୍ଜିବୁ ପରା",
          "କଞ୍ଜାୟତାକ୍ଷିରେ ଖଞ୍ଜାଇ ଲଲାମ",
          "ତା ପରେ ପୁନ୍ନାଗ ଝରା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦେଖି ସେ ଉତ୍ସବ ନେତ୍ରେ ଆମ୍ଭେମାନେ",
          "ସୁଖୀ ହୋଇ ଜୀଇବାକୁ",
          "ଦୁହେଁ ତ ଦୁହିଙ୍କ ଜୀବ ଜୀବ",
          "-ବନ୍ଧୁ ଯିବ ମଧୁ ପିଇବାକୁ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଶୁଣି ଲଳିତାଙ୍କୁ ଲୀଳା ତାମରସ",
          "ଉଞ୍ଚାଇଲେ ଦେବୀ ସ୍ନେହେ",
          "ସେ ସମୟେ କରି ବନ୍ଦନାକୁ ହରି",
          "-ଚନ୍ଦନ ଭୂନାଥ କହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
