    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆହା ହେବ କି ବୁଦ୍ଧି",
          "ଯାହା ତେଜିଲି କରୁଁ ଜାଣି ଜାଣି ମୁଁ ନିଧି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କରେ ଥିଲା ଚିନ୍ତାବଲ୍ଲୀ",
          "କାମ ପୂର୍ଣ୍ଣ ନୋହିଲି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯୁବତିଏ ଏହି ମତ",
          "ଭାବରେ ହରନ୍ତି ଚିତ୍ତ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଙ୍କେଳି କୁଞ୍ଜରେ ବୋଲି",
          "ସଙ୍କେତ ଦେଲା ଛଇଳି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହେ ରସେ ରଘୁନାଥ",
          "କୁଞ୍ଜେ ବସି ଦେଖ ପଥ"
        ]
      }
    ]
  },
  "sources": [
