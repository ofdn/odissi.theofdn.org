{
  "id": "oa-gita-000572",
  "name": {
    "en": "Kusunia gilichhi nia",
    "or": "କୁଷୁନିଆଁ ଗିଳିଛି ନିଆଁ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000026"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kusunia-gilichi-nia-kusunian-gilichhi-nian/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୁଷୁନିଆଁ ଗିଳିଛି ନିଆଁ",
          "ପୋଡ଼ିଦେବଟି ତୋ ପ୍ରୀତି ସୁନିଆଁ",
          "ହେ ଦରହାସୀ ତୁ ନଜର ଫେରାଇ",
          "କଦର କରି ତାଠାରୁ ଘେନିଆଁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାଣୁ କିନା ପୂତନା ଦାସୀ",
          "କ୍ଷୀର ପାନେ ଦେଇଛି ନାଶି",
          "ଶିଶୁଟି ଦିନରୁ ସେ ବଡ଼ ସାହସୀ",
          "ଛନ୍ଦା ଚରଣିଆ ବୃନ୍ଦାବନିଆଁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଂଶୀ ସ୍ୱରେ ନାମ ଉଚ୍ଚାରି",
          "ଦଂଶି ଓଷ୍ଠ କିସ ବିଚାରି",
          "ବସି ନୀପ ମୂଳେ କି ମନ୍ତ୍ର ପଢ଼ଇ",
          "ରସିକ ରତନ ରାଜଧାନିଆଁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାଟ କରି ଓଗାଳେ ବାଟ",
          "ଘାଟଜଗା ସେ ନନ୍ଦଚାଟ",
          "ଛାଟ ଧରି କଲେ ଯେତେହେଁ ଆକଟ",
          "କାହାକୁ ନ ମାନେ ସେ ଅମାନିଆଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଜାଣଇ ସେ ମୋହିନୀ ଲଗା",
          "ବେଳ ଦେଖି ଦିଅଇ ଦଗା",
          "ତା ପାଲରେ ଜୁଟି ତୋ ପରି କେତୋଟି",
          "ଗୋଟି ଗୋଟି ହୋଇଲେଣି ଛାନିଆଁ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରସେ ବନମାଳୀ ବଦତି",
          "କିଶୋରୀଙ୍କି ବୋଲନ୍ତି ଦୂତୀ",
          "ହାସ ଭାଷ ଭଙ୍ଗୀ ଚାହାଣୀ ଛଟାରେ",
          "ଭୁଲାଇ ଜାଣେ ସେ ଗୋପ କନିଆଁ"
        ]
      }
    ]
  },
  "sources": [
