{
  "id": "oa-gita-000089",
  "name": {
    "en": "Ki dekhila aja netra",
    "or": "କି ଦେଖିଲା ଆଜ ନେତ୍ର"
  },
  "composer": "oa-person-000026",
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ki-dekhila-aja-netra-sajani/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କି ଦେଖିଲା ଆଜ ନେତ୍ର ସଜନୀ",
          "କି ଦେଖିଲା ଆଜ ନେତ୍ର",
          "ଲଳିତ ମୂରତି କଳି ତ ନୋହିଲା",
          "ଦଳିତ ଅଞ୍ଜନ ଗାତ୍ର ଲୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଳକା କପୋଳେ ଚପଳା କି ଖେଳେ",
          "କେକୀପୁଚ୍ଛ ଚନ୍ଦ୍ରଚୂଳ",
          "ରତନେ ଜଡ଼ିତ ଯତନେ କୁଣ୍ଡଳ",
          "ଝଲକେ ଗଣ୍ଡମଣ୍ଡଳ ଲୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହୃଦରେ ପଦକ କରଇ ମାଦକ",
          "ବାଦ କରେ ନିଶାକରେ",
          "କାମିନୀ ଚିତ୍ତକୁମୁଦ ପ୍ରଫୁଲ୍ଲିତ",
          "କରୁଥାଇ ଲୋକନରେ ଲୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କରେ ତା କଙ୍କଣ ମୁରଲୀବାଦନ",
          "ପୟରେ ନୂପୁର ଶୋହେ",
          "ସୁବାସ କୁସୁମ ମାଳ ମାଳ ମାନ",
          "ବାର ବେନି ପୁର ମୋହେ ଲୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବାଛି ପିନ୍ଧିବାର କାଛି ପୀତାମ୍ବର",
          "ଅତର କର୍ପୂର ଉଛି",
          "ବାରିବାକୁ ଆଉ ଅଛି କି ସେ ଶ୍ୟାମ",
          "ସୁନ୍ଦରପଣକୁ କିଛି ଲୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବୋଲେ ବନମାଳୀ ସେ ପଟ୍ଟନାୟକ",
          "ଭାଷନ୍ତି କିଶୋରୀମଣି",
          "ନଟ ଲଗାଇବା ହଟ ବଡ଼ ତାର",
          "ନଟବର ବେଶ ଠାଣି ଲୋ"
        ]
      }
    ]
  },
  "sources": [
    {
