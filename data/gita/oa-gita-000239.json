{
  "id": "oa-gita-000239",
  "name": {
    "en": "Manarijha pirati ke",
    "or": "ମନରିଝା ପୀରତି କେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000058"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manarijha-pirati-ke-malabagouda-jati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମନରିଝା ପୀରତି କେ କଲାନି ମନା",
          "ଭିନ୍ନ କଲେ କରଇ ଦଇବ ସିନା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଜାତି ନୀତି ଧନ ମହତ୍ତ୍ୱ ଗୁମାନ",
          "ତେଜିବାକୁ ଅଛି ଯାର ଆଲୋଚନା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଚାର କି ଚାକର ଚାହିଁଲେ ତାହାର",
          "କରଇ ଯେ ପ୍ରଭୁ ସମ ସମ୍ଭାବନା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯା ଲାଗି ଯା ପ୍ରାଣ ଯିବ ଏ ପ୍ରମାଣ",
          "ଦେଲେ ଛାଡ଼ିବ କି ତା ତୁଳରେ ସୁନା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ନୟନ ଅୟନେ ଶୟନେ ସ୍ୱପନେ",
          "ନ ଦିଶଇ ଆନ ତା ମୂରତି ବିନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଯିବା ଯାଏ ଶିର ଯାର ଅଙ୍ଗୀକାର",
          "କଥା ପଦକୁ ଥାଇ କି ତା ଶୋଚନା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କହଇ ଗୋପାଳକୃଷ୍ଣ ସ୍ନେହଜଳ",
          "-ନିଧି କରିବେ କି ଜନେ ଅକଳନା"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
