{
  "id": "oa-gita-001050",
  "name": {
    "en": "Syama pritiki kisori re",
    "or": "ଶ୍ୟାମ ପ୍ରୀତିକି କିଶୋରୀ ରେ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/syama-pritiki-kisori-re-paraja-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ୟାମ ପ୍ରୀତିକି କିଶୋରୀ ରେ",
          "ସତେ ଦେବୁକି ପାଶୋରି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଏ ରସ ବସନ୍ତ ସମୟ ହୋଇଛି ଯେ",
          "ପିକ ଡାକରେ ଧୃତି ଖସୁଛି",
          "ଯେତେବେଳେ ବିଧୁ ଉଦେ ହୋଇଯିବ ଆସି ଗୋ",
          "ସାହା ହେବ ସେ ହର ଅରାତିକିରେ ରାତିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଯାହାର ହାର ବିହାର ଆହାର ସହିତେ ଗୋ",
          "ବାହାର ହେଲାନି ତୋ ବାହାରେ",
          "ୟେତେକ ହେଲେ ତୋ ମନ ନୁହେ ସମାଧାନ ଗୋ",
          "ଏଥୁ ବଳି ଦେବୁ କି ବିପତ୍ତିକି ରେ ପତିକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଘେନାଘେନିରେ ମନାଇ ଥିବାର ପୀରତି ଗୋ",
          "ମନା ହୁଅଇ ସେ ଯେବେ ଆସି",
          "ମନା କରି ପୁଣି ଲୋଡ଼ି ଆଣିବି ବୋଇଲେ ଗୋ",
          "ଆଉ କେହି ଅଛି ଗଜଗତି କିରେ ଗତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଯାହାକୁ ଦେଖିଲେ ପଶୁପକ୍ଷୀ ମତି ଭୁଲେ ଗୋ",
          "ଯତି ସତୀ ରୀତି କେ ପଚାରେ",
          "ତୋହୋର ସ୍ନେହିକୁ ସେ ରହିଲେ ଅନୁସରି ଗୋ",
          "କାହିଁକି ନୋହୁଛି ସେ ମୂରତି କରେ ରତିକି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କବି କୁମୁଦବାନ୍ଧବ ରଘୁନାଥ କହେ ଯେ",
          "ହାସ ରସ କଉତୁକେ ମାତି",
          "ଯୁଗଳ ହୋଇ ଯେ ରହୁଥାଇ ନିତି ନିତି ଯେ",
          "ଦୂର କରେ ଆସିଲି ମୁଁ କତିକି ରେ କତିକି"
        ]
      }
    ]
  },
