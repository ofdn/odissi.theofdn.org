{
  "id": "oa-gita-001213",
  "name": {
    "en": "Kahinki syama murati go",
    "or": "କାହିଁକି ଶ୍ୟାମ ମୂରତି ଗୋ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000126"
  ],
  "mula_tala": [
    "oa-tala-000008"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kahinki-syama-murati-go-ananda-kamodi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାହିଁକି ଶ୍ୟାମ ମୂରତି ଗୋ",
          "ସଦା ଦିଶୁଛି ମୋତେ ଦିନ ରାତି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ପଛୁ ଆସିଲା ପରି ହୁଏ ମତି",
          "ଚାହିଁଲେ କେ ନ ଦିଶେ ଏ କି ରୀତି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆସି ଆଗେ ରହୁ ହେଟି ଜରତୀ",
          "ବୋଲୁ ମୋ ହୃଦେ ଲୁକୁଛି ଝଟତି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆଖି ବୁଜିଲେ କୁଞ୍ଜବନେ ନିତି",
          "ସ୍ୱପ୍ନେ ବୁଲାଉଛି ଏ କି ବିପତ୍ତି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଘରୁ ଅଗଣାକୁ ଯିବାକୁ ଭୀତି",
          "ଲାଗିଲାନି ମୋତେ କହ କି ଗତି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "କୃଷ୍ଣ କୃଷ୍ଣ ବୋଇଲାର ଭାରତୀ",
          "କାନରେ ପଡ଼ିଲେ ଥରୁଛି ଛାତି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଗୋପାଳକୃଷ୍ଣ ବୋଲଇ ବିଚ୍ଛିତି",
          "ବଂଶରୁ ଏପରି ହେଉଛି ସ୍ଫୁର୍ତ୍ତି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
