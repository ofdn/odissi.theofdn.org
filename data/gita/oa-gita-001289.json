{
  "id": "oa-gita-001289",
  "name": {
    "en": "Kehi se naba nagara",
    "or": "କେହି ସେ ନବ ନାଗର"
  },
  "composer": "oa-person-000140",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kehi-se-naba-nagara-todi-gourachandra-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରେ ସହୀ କେହି ସେ ନବ ନାଗର",
          "ଚାହିଁଦେବାରେ ତା ବଦନ ଚନ୍ଦ୍ରକୁ",
          "ରହିଲା ନେତ୍ର ଚକୋର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶକ୍ରଚାପ ଭୂରୁ ଚାରୁ ନୟନର",
          "ଅଞ୍ଜନ ରଞ୍ଜନ ଗୁଣ",
          "ବକ୍ର ଚାହାଣୀ ଶରେ ମାରିନେଉଛି",
          "ହୃଦ ହରିଣର ପ୍ରାଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନବୀନ ତମାଳ ତରୁ ଜିତ କଳେ",
          "-ବର ନୀରଦ ତାହାର",
          "ଛବି ଦେଖିଦେଲେ ଦ୍ରବି ହୋଇଯିବେ",
          "ପବି ଭୟେ ଗିରିବର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଚଳାପାଙ୍ଗୀ ମୋର ମାନସେ ମଣିଲି",
          "ନିଶ୍ଚେ ଏ ଘନ କାଳିଆ",
          "ଖେଳାଉଛି ହୃଦେ ହାର ଚପଳାକୁ",
          "ଦେଖାଇ ଶିଖିଚୂଳିଆ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କଟୀ ପୀତାମ୍ବର ଉପରେ କିଙ୍କିଣୀ",
          "ସ୍ତନିତରେ ଦଶ ଦିଶ",
          "ଘୋଟି ଆସି କି ମୋ ମନ ଚାତକକୁ",
          "ଦେବ ପ୍ରେମ ଘନ ରସ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଏପରି ରମଣୀମଣି ବାଣୀ ଶୁଣି",
          "ଗୋପ ନାରୀବର ସେହି",
          "ଭୂପତି ତାରକାବୃନ୍ଦ ଚନ୍ଦ୍ର ଗୌର",
          "-ଚନ୍ଦ୍ର ଗଜପତି କହି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
