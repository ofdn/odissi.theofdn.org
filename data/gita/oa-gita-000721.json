{
  "id": "oa-gita-000721",
  "name": {
    "en": "Tara gire ki biswasa",
    "or": "ତାର ଗିରେ କି ବିଶ୍ୱାସ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000100"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/tara-gire-ki-biswasa-kalahansa-kedara-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତାର ଗିରେ କି ବିଶ୍ୱାସ",
          "ତାର ସ୍ନେହେ କି ବିଶ୍ୱାସ",
          "ତାର ପରେ କି ବିଶ୍ୱାସ",
          "ଯାର ଜାରବିଳାସ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବୋଲେ ଶତ ଥର ଶପଥରେ ମୋର",
          "ଆନେ ନାହିଁ ଅଭିଳାଷ",
          "ହୋଇଥାଏ ବୋଲି ଚନ୍ଦ୍ରାବଳୀ କେଳି",
          "ନିକୁଞ୍ଜ କୁସୁମବାସ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦନ୍ତବାସେ ସତୀ ଯୁବତୀଙ୍କ ଜାତି",
          "ନେବା ଭଙ୍ଗୀମିଶା ହାସ",
          "କଥାକୁ ଶାଶୁଙ୍କ ମଥାକୁ ଛୁଅଇଁ",
          "ଏପରି ଯାହା ସାହସ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପ୍ରତି ରାତି ନାରୀମଣିର ରମଣେ",
          "ତରେ ବଳାଏ ମୁହାଁସ",
          "ପାଚେରି ଡେଇଁବା ଆପଦୁ ଯା ପଦ",
          "ଜଳଜ ତଳ ପରାସ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ହୁଏ କେଡ଼େ ପ୍ରିୟ ଗିରେ ସବିନୟ",
          "ପ୍ରକାଶି ମୋହନ ରସ",
          "ମୁରଲୀ ବଜାଇ ଡାକେ ଯହୁଁ ଯାଇ",
          "ଆଚରେ ବଡ଼ ନିରାଶ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମୁଁ ନଗର ଯୁବରାଜ ବୋଲି ଅବ",
          "-ଲେପରେ ବହେ ଉଲ୍ଲାସ",
          "ଯେ ପୁଣି କପଟେ ଲୁଚି ନଦୀ ତଟେ",
          "ଲୁଟଇ ପାଲଟାବାସ ଗୋ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ତେବେ ହେଲେ ଏ କି ଚିତ୍ର ଧିକ ତାର",
          "ଧନ ଜୀବନ ନିବାସ",
          "ଅଷ୍ଟଦୁର୍ଗ ପୁରନ୍ଦର ବୋଲେ ଯାର",
          "ଗତି ନୁହେ ପୀତବାସ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
