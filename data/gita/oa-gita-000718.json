{
  "id": "oa-gita-000718",
  "name": {
    "en": "Rusibara sina janu",
    "or": "ରୁଷିବାର ସିନା ଜାଣୁ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000024"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rusibara-sina-janu-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରେ କିଶୋରି ରୁଷିବାର ସିନା ଜାଣୁ",
          "ରସ ଜଳଧିରେ ଅବଗାହି ଧୀରେ",
          "ତହୁଁ ତ ସାର ନ ଛାଣୁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରମଣୀୟ ଜାଣି ରସି ଯହିଁ ପୁଣି",
          "ନ ଡରି ପରିବାଦକୁ",
          "ରୋଷ ଅଙ୍ଗୀକାର କରି କି ତାହାର",
          "ଅଳପ କଥା ପଦକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରତ୍ନ ତ ମୃଦୁଳ ନୋହେ ତାକୁ ଅଳ",
          "-ଙ୍କାରକୁ ନିକି ନ ଆଣି",
          "ରସିକାଙ୍କ ଶିଖାମଣି ଘେନୁ ଶିଖା",
          "ଶିଖି ତୁହି କାହୁଁ ଶୁଣି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରକତ ବ୍ୟକତ ହେଲେ ଯଦି କ୍ଷତ",
          "ହୁଅଇ ଆସେଚନକ",
          "ରଦାଗ୍ର ସ୍ପରଶ ଅବା କେଡ଼େ ଦୋଷ",
          "ନ କରି ଚିତ୍ତେ ବିବେକ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରତିଈଶ ରଣ ଯାହାର ଶରଣ",
          "ଦେଖିଥିଲେ ତାକୁ ନେତ୍ରେ",
          "ରହନ୍ତୁ କି ଲାଜ କ୍ରୋଧେ ଜମି ଆଜ",
          "ଭୁଜେ ଭିଡ଼ି ଦେବା ମାତ୍ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରଙ୍କରତନ ଲାଭକୁ ପରି ଏବେ",
          "ରଚି ଯତନକୁ ଭଲେ",
          "ରମ୍ୟ ଶ୍ୟାମ ଛବି କିଶୋରରେ କବି",
          "-ରବି ରାୟଗୁରୁ ବୋଲେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
