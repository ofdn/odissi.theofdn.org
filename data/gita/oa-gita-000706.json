{
  "id": "oa-gita-000706",
  "name": {
    "en": "Go rasanati krusna nama chhadi",
    "or": "ଗୋ ରସନାଟି କୃଷ୍ଣ ନାମ ଛାଡ଼ି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000015"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/go-rasanati-krusna-nama-chhadi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଗୋ ରସନାଟି",
          "କୃଷ୍ଣ ନାମ ଛାଡ଼ି ଆନେ ରସ ନା ଟି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅଟକି ନ ରହି ଅଳସରେ",
          "ରଟ ରଟ ଚଳ ବିଳାସରେ",
          "କୃଷ୍ଣ କେଶବ କେଶିକଂସଦଳନ",
          "ବଲ୍ଲବୀଜନ ବଲ୍ଲଭ ହରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଉପଳ ଶାକର ରସଫେଣା",
          "ମଧୁ ମଧୁରସା ସରପଣା",
          "ସୁଧା ତାମରସ ନେତ୍ରା ରସବାସ",
          "ଏ ସବୁ ଶ୍ୟାମ ନାମରୁ ଊଣା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମକରନ୍ଦ ପକ୍ୱ ଚୂତ ରସ",
          "ପ୍ରବାହେ ନ ରଖ ତୁ ତରସ",
          "ବିଲକ୍ଷଣ ହରିନାମଙ୍କ ମାଧୁରୀ",
          "ଇତର ସକଳ ଗତରସ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବୃନ୍ଦାବନ ବ୍ୟୋମ କଳାକର",
          "ବିରାଜ ଧ୍ୱଜ ହେ ବିଶ୍ୱମ୍ଭର",
          "ଅଜ ବାସୁଦେବ ମୁକୁନ୍ଦ ମାଧବ",
          "ଗୋବିନ୍ଦ ବୋଲି କୀର୍ତ୍ତନ କର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଖଣ୍ଡ ମରିଚ କର୍ପୂର ଚୂରି",
          "ଦେଲେହେଁ ସୁରଭୀ କ୍ଷୀରେ ଭରି",
          "ଶ୍ୟାମ ରମଣୀୟ ମୋହନ ବିଗ୍ରହ",
          "ନାମର କଳାକୁ ନୋହେ ସରି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ବୋଲ ବୋଲ କଂସ ନିସୂଦନ",
          "ଜୟ ଜୟ ଦେବ ଜନାର୍ଦ୍ଦନ",
          "ଅଷ୍ଟଦୁର୍ଗ ପତି କହିବା ଭାରତୀ",
          "ଇଷ୍ଟ ସୁଧାରସ ପରି ଘେନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/go-rasanati-krusna-nama-chhadi-kabisurjya/"
    }
