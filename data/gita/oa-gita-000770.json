{
  "id": "oa-gita-000770",
  "name": {
    "en": "Sri radhe mora daini ete",
    "or": "ଶ୍ରୀ ରାଧେ ମୋର ଦଇନୀ ଏତେ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000046"
  ],
  "mula_tala": [
    "oa-tala-000012"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-radhe-mora-daini-ete-jhinjhoti-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଶ୍ରୀ ରାଧେ ମୋର ଦଇନୀ ଏତେ",
          "ସେବା ପରିଚାରୀ ହେବି ଦେହାନ୍ତେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କରୁଣାମୟୀ ଗୋ ଅରୁଣାଧରୀ",
          "ମଣିବ ସଖୀଙ୍କ କିଙ୍କରୀ କରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁଞ୍ଜ ଅଭିସାରେ ଥିବି ଗହଣେ",
          "ନ ହୋଇବି ଛାମୁଛଡ଼ା ମୁଁ କ୍ଷଣେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପହଣ୍ଡମଣା ନଉକରୀ ପଣେ",
          "ଆଳିଗଣେ ମୋତେ ଗଣିବ ଜଣେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରବି ପୂଜା କାଳେ ଘେନିବ ସଙ୍ଗେ",
          "ଅଙ୍ଗରାଗ ଲେପିବାକୁ ଶ୍ରୀଅଙ୍ଗେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରଚିବା ପାଇଁକି ବେଶ ବିଧାନ",
          "ମୋ ପ୍ରତି ହେବ ଦିବ୍ୟ ଅବଧାନ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ନିଭୃତ ନିକୁଞ୍ଜେ ଯୁଗଳ ଠାଣି",
          "ଦରଶନେ ହେବି ମନ ଫୁଲାଣି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "କାକୁସ୍ଥେ କହେ ବନମାଳୀ ଦାସ",
          "ଏ ଦିନୁ ନାହିଁ ଆନ ଅଭିଳାଷ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sri-radhe-mora-daini-ete-jhinjhoti-banamali/"
    }
  ],
