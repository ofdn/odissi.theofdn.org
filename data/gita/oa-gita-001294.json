{
  "id": "oa-gita-001294",
  "name": {
    "en": "Ana lo syama ki range",
    "or": "ଅନା ଲୋ ଶ୍ୟାମ କି ରଙ୍ଗେ"
  },
  "mula_raga": [
    "oa-raga-000005"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ana-lo-syama-ki-range-misra-kaphi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଅନା ଲୋ ଶ୍ୟାମ କି ରଙ୍ଗେ ନାଚନ୍ତି ତ୍ରିଭଙ୍ଗ",
          "ତା କିଟ ତାକ ତା ତା କିଟ ତାକ",
          "ଝମ କିଟ ତାକ ତା ତା କିଟ ତାକ",
          "ତା ଝମ ଝମ କିଟ ତାକ ବାଜେ ମୃଦଙ୍ଗ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବାଜେ ବୀଣା ଗାମାପା ନିନିସା ନି ସା",
          "ରାଗ ସରାଗେ ଆଳାପେ କେ ମଦାଳସା",
          "ସଙ୍ଗୀତେ ମୃଦୁ ଇଙ୍ଗିତ ଦେଇ",
          "ଫିଙ୍ଗିଦିଏ ସତୀ ଧୃତି ଅନଙ୍ଗ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବାନ୍ଧୁ ମୁଖର ମଞ୍ଜିରା ପଦକଞ୍ଜେ",
          "ଛନ୍ଦି କଟୀ ପୀତଧଟୀ ମନ ରଞ୍ଜେ",
          "ପିନ୍ଧି ବନମାଳ ରୁଞ୍ଜଗୁଞ୍ଜପୁଞ୍ଜେ",
          "ନିନ୍ଦି ଚନ୍ଦ୍ରମାକୁ ଚନ୍ଦ୍ରିକାଚୂଳ ସାଜେ",
          "(ପଡ଼ି)",
          "ପାଆରେ ଯୋଡ଼ିପୟର ଦିଶନ୍ତି କି ସୁନ୍ଦର",
          "ଢଳି ଢଳି ଆମୋଦେ କରି ଅଙ୍ଗସଞ୍ଚାର",
          "ପାରି ଚିରା ଚଉକ ଦିଶେ କି ମନୋହର",
          "ଘାରି ଦିଏ ମରମେ ଚାହିଁ ନେତ୍ରବାଣ"
        ]
      }
    ]
  },
