{
  "id": "oa-gita-000340",
  "name": {
    "en": "Sari jibani jibane kisori he bansidhari",
    "or": "ସରି ଯିବନି ଜୀବନେ କିଶୋରୀ ହେ ବଂଶୀଧାରୀ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000067"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sari-jibani-jibane-kisori-he-bansidhari/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରି ଯିବନି",
          "ଜୀବନେ କିଶୋରୀ ହେ ବଂଶୀଧାରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିରହରେ ସଖୀ ହୋଇଛି କାତର",
          "ସରୁଁ ସରିଲାଣି ସରୋଜପତର",
          "ଦେଖିଲି ସଖୀର କଣ୍ଠର ମାତର",
          "ଜୀବନକୁ ଅଛି ଧରି ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଲାଗୁ ନ ଥିଲା ମୋ କରକୁ ନାଟିକା",
          "ସଜନୀମାନେ ଦେଖି ହେଲେ ତାଟକା",
          "ଧାଇଁଅଇଲି ମୁଁ ଶୁଣି ତାଙ୍କ ଡକା",
          "ଥିବ କି ଜୀବନେ ସରି ହେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନାସାଗ୍ରତେ ତୁଳ ଦେଲେ ତତପର",
          "ନ ଚଳିଲା ପରି ଦିଶିଲା ନାଗର",
          "ସଜନୀମାନେ ବସିଣ ସେହି ପୁର",
          "ହା ରାବରେ ଥିଲା ପୂରି ହେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତୁମ୍ଭ ଭଳି ଯେବେ ନୋହିଲା ପାତର",
          "ପଚାରୁଛି ଶ୍ୟାମ ନ ଦିଅ ଉତ୍ତର",
          "ଅନ୍ତର୍ଗତେ ଯେବେ ଥିଲାଟି ଅନ୍ତର",
          "ଚିତ୍ତ କିମ୍ପା କଲ ଚୋରି ହେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଲାଗିଥିଲେ ଜବାଧରୀର ସେବାରେ",
          "ଆଶା ଅଛି ମୋହ ଯିବା ଆସିବାରେ",
          "ହଟି ବସିଅଛି ଜୀବନ ନେବାରେ",
          "ପାପୀ କାମ ଯମ ପରି ହେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦୀନବନ୍ଧୁ ଥାଉଁ ବିରହ ତୁଷାର",
          "ନାଶ କଲେ ପଦ୍ମିନୀକି ଏ ଅସାର",
          "ବୋଲେ କବିରବି ହେବଟି ଅସାର",
          "ହସିବେ ସିନା ଭଗାରି ହେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
