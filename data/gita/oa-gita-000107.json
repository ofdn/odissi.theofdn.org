{
  "id": "oa-gita-000107",
  "name": {
    "en": "Kananara bitanare",
    "or": "କାନନର ବିତାନରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kananara-bitanare-kanana-ra-bitana-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କାନନର ବିତାନରେ ଏ କି ଗାନ ଶୁଭୁଛି ମା",
          "କାନରେ ଏ ନିସ୍ୱନ ପ୍ରସରି ଜ୍ଞାନ ହରୁଛି ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନିବିଡ଼ ନୀବିଗ୍ରନ୍ଥୀ ସାଧବୀ ବିଥୀର ଫିଟୁଛି ମା",
          "କି ବିହିଛିଟି ବିହି ବିବେକ ବୁଦ୍ଧି ନାଶୁଛି ମା"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନାଦର ଏ କି ମାଦକ ଉନୁମାଦ କରୁଛି ମା",
          "ଆଦର ରହୁ ପାଦରେ ସୁଧାସ୍ୱାଦ ଦଳୁଛି ମା"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଭାବ ଏ କି ପ୍ରଭାବ ରବର ଗ୍ରାବ ଦ୍ରବୁଛି ମା",
          "ଏ ବରଜର ଯୁବତୀ ଆବୁର ନେବ ମଣୁଛି ମା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସ୍ୱାନ୍ତକର ଏ ତନ୍ତ୍ର ଜାଣ ଯନ୍ତ୍ର ରଚିଛି ମା",
          "ମନ୍ତର ପଢ଼ି ଅନ୍ତରକୁ ମୋ କୁନ୍ତ ମାରୁଛି ମା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଆଳୀ କରେ ନିଆଳୀ ମାଳିକା ଯେ ପଠାଇଛି ମା",
          "ପାଳୀ କହନ୍ତି କେଳି ମୁରଲୀ ସେ ବଜାଉଛି ମା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପରମାକ୍ଷର ଅର୍ଥ ଧ୍ୱନିରେ ପ୍ରକଟ ହୋଇଛି ମା",
          "ଭରମ କେଣେ ଗୋପାଳକୃଷ୍ଣ ଶୁଣ ଜଣାଉଛି ମା"
        ]
      }
    ]
  },
