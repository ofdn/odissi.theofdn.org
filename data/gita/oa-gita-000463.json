{
  "id": "oa-gita-000463",
  "name": {
    "en": "Madhure manda manda hoi",
    "or": "ମଧୁରେ ମନ୍ଦ ମନ୍ଦ ହୋଇ"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ma Patala",
      "or": "ମ ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/madhure-manda-manda-hoi-ma-champu-kamodi-tripata-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମଧୁରେ ମନ୍ଦ ମନ୍ଦ ହୋଇ ଗନ୍ଧବହ ପ୍ରସରିଲା",
          "କଦମ୍ବ ନିକୁଞ୍ଜ ସୀମାରେ",
          "ମରନ୍ଦ ସେକେ ଚମକି ଲୋକେ ଭାଷିଲେ ଇଷି ମାରେ",
          "ମିଳିନ୍ଦ ଲତା ଦମ୍ଭବନିତା ବଦନେ ମିଶି ମାରେ",
          "ମଣ୍ଡିତ ହେଲା ସେ ବନସ୍ଥଳ",
          "ମହାରଜତ ମହେନ୍ଦ୍ର ନୀଳ",
          "ମୟୂଖ ଶିରୀମୟ ମଞ୍ଜରୀ",
          "ବିସର ସୁଷମାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ମିଶିଲା ଚାରି ଲୋଚନ ବାରିରୁହ ମଦନୁ ଲଭିଲା ଚାରି",
          "ମିଳିଲା ଶ୍ୟାମ ଗଉର ଦୁଇ ମହ",
          "ମଧୁପ ଯୁବା ଲଭିଲା ଅବା ନବ ସରସୀରୁହ",
          "ମାନସ ଅଙ୍ଗଭେଦ ପ୍ରସଙ୍ଗ ଭଙ୍ଗ ରଚିଲା ସ୍ନେହ",
          "ମଉଳିଗଲା ଶେଷ ସାତ୍ତ୍ୱିକ",
          "ମୃଡ଼ନୟନ ସଂଖ୍ୟକଯାକ",
          "ମଜ୍ଜାଇ ଦେଲା ଦୁହିଙ୍କ ମନ",
          "ମହାମୋଦ ପ୍ରବାହ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମଦଦ୍ୱିରଦ ମଥିତହ୍ରଦ ମୂର୍ଚ୍ଛିତ ମହୋତ୍ପଳ ଆମୋଦ",
          "ଫୁଲ୍ଲପରାଗ ଶ୍ରୀଅଙ୍ଗରାଗ ବାସ",
          "ମୃଗଲାଞ୍ଛନ ମରୀଚି ଚୂର୍ଣ୍ଣ ଧାବଲ୍ୟ ପରକାଶ",
          "ମଧୁମାଦକ ଗୁଣସୂଚକ କୋକିଳ କଳଘୋଷ",
          "ମଣିମଣ୍ଡିତ କିଙ୍କିଣୀ ଯୁତ",
          "ମଞ୍ଜୁ ମଞ୍ଜୀର ଭୂଷା ଶିଞ୍ଜିତ",
          "ରସନା ରଣତ୍କାର ଶ୍ରବଣ କଲା ବିବେକ ମୋଷ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମଧୁ ମଧୁର ବଧୂ ଅଧର କିଶୋରବର ରଦନାମ୍ବର",
          "ବିମ୍ବ ଚୁମ୍ବନ ଚୁଁକୃତି ସ୍ୱନ ମେଳା",
          "ମୃଦୁ ମନ୍ମନ ଧ୍ୱନି ଜନନ କଲାଟି କ୍ରୋଡ଼ଖେଳା",
          "ମହେନ୍ଦ୍ରମଣି ବଳୟ ଶ୍ରେଣୀ ରଟିଲା ହୋଇ ଲୋଳା",
          "ମନୋଜ୍ଞ ଚାଟୁ ପୀୟୂଷମୟ",
          "ମିଶ୍ରିତ ହେଉ ହେଉ ସମୟ",
          "ମାର ମହତ୍ତ୍ୱ ଗଲା କି ନାହିଁ",
          "ହେଲା ସଂଶୟ ଦୋଳା"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମନ୍ଦାର ବନ ସେ ବନ ରସାଚକ୍ରେ ରଚିଲା ସୂନ ବରଷା",
          "ରସିଲେ ସର୍ବ ଗନ୍ଧର୍ବମାନେ ଗାନେ",
          "ମାତି ତାଣ୍ଡବ ରଚିଲେ ଦେବଦାସୀଏ ସାବଧାନେ",
          "ମର୍ଦ୍ଦଳ ଘୋଷ ହେଲା ତ୍ରିଦଶ ମଣ୍ଡଳେ ସବୁସ୍ଥାନେ",
          "ମୁକତ ପ୍ରାୟ ହେଲା ତ୍ରିଲୋକ",
          "ମାନସୁ ମ୍ଳାନ କଲେ ପାତକ",
          "ଶ୍ରୀ ଜଗଦ୍ଦେବ ହରିଚନ୍ଦନ",
          "ସେ ମହୋତ୍ସବ ଧ୍ୟାନେ"
        ]
      }
    ]
  },
