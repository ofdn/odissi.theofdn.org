{
  "id": "oa-gita-000558",
  "name": {
    "en": "Krupa na kale je",
    "or": "କୃପା ନ କଲେ ଯେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000179"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/krupa-na-kale-je-kahinki-gopalakrusna-kousika/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କୃପା ନ କଲେ ଯେ କାହିଁକି ଧରିବି ପରାଣ",
          "ବ୍ରଜେନ୍ଦୁ ହୃଦ ବିହାରିଣୀ ରାଧେ",
          "ହୋଇଯିବି ତ ଅକାରଣ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ନ ମିଳିବ କେବେ ହେଲେ ଯଦି",
          "ସେବା ଅମଳ ଶ୍ରୀକଞ୍ଜ ଚରଣ",
          "ପ୍ରାଣନାଥ ସଖୀ ମଞ୍ଜରୀ ମାନଙ୍କୁ",
          "ଏହିପାଇଁ ନିତି ଜଣାଣ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରାସାବସାନରେ କୁସୁମ ବ୍ୟଞ୍ଜନ",
          "ଆଳୀ ଦେଲେ ମୋତେ ଡାକି",
          "କୋଟିଏ ଜନ୍ମର ତପସ୍ୟାର ଫଳ",
          "ବ୍ରଜ ପ୍ରାପ୍ତି ଆଉ ନାହିଁକି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କେଶର କୁଞ୍ଜର ପ୍ରାଣେଶ ସଙ୍ଗରେ",
          "ନ ଦେଖିବି ଯଦି ଦୁହିଁକି",
          "ଆଖି ବହିବାର ହୋଇଯିବ ସିନା",
          "ଯେମନ୍ତ ଚିତ୍ର ବିରାଟକୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପରମ ଅଭୀଷ୍ଟ ସ୍ୱାମିନୀ ସୁଜୁଷ୍ଟ",
          "ନ ପାଇବ ଯଦି ରସନା",
          "ବିଷୟା ବିଷ ଘଟର ଦର୍ବୀ ତୁଲେ",
          "ହୋଇଥିବ ସିନା ତୁଳନା"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ବ୍ରଜ ଯୁବରାଜ ପିନ୍ଧାଇ ଥିବାର",
          "ସୁମନସ ସ୍ରଜ ହାରେ",
          "ସଜ ସାଜିବାକୁ ଫିଟାଉଁ ସଜନୀ ନ",
          "ଦେବେ ଯଦି ମୋ ହାତରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ପରମ ଦୟାମୟୀ ନାମ ଶୁଣି",
          "ମୁଁ ପ୍ରତ୍ୟାଶ କରିଛି ସ୍ୱାମିନୀ",
          "ଦନ୍ତେ ତୃଣ ଧରି ଭାଷଇ ଗୋପାଳକୃଷ୍ଣ",
          "ହେ କୃଷ୍ଣ ପ୍ରଣୟିନୀ"
        ]
      }
    ]
  },
  "sources": [
    {
