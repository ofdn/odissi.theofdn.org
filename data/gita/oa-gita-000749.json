{
  "id": "oa-gita-000749",
  "name": {
    "en": "Nisedhi thili para pahilu re",
    "or": "ନିଷେଧି ଥିଲି ପରା ପହିଲୁ ରେ"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000001"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nisedhi-thili-para-pahilu-re/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନିଷେଧି ଥିଲି ପରା ପହିଲୁ ରେ",
          "କାହିଁକି ତୁ ତେଣିକି ଚାହିଁଲୁ ରେ",
          "ସେ ଯମୁନା ଅୟନ ଜଗୁଆଳୀ ନୟନ",
          "କୁନ୍ତକୁ ବକ୍ଷ ଯା ପତାଇଲୁ ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବିଷମ ବ୍ୟାଧି ଏବେ ଘୋଟିଗଲାଣି କେବେ",
          "ନ ଭୋଗିବାର ଦଶା ପାଇଲୁ ରେ",
          "କଳା ନାଗର ବିଷ ଘାରିବ ଅହର୍ନିଶ",
          "ପୀୟୂଷ ମଣି ଯାହା ଖାଇଲୁ ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କେଉଁ ସାହସେ ଧନ ସମର୍ପି ଦେଲୁ ମନ",
          "ଯୁବତୀ ସଂସାରେ କି ରହିଲୁ ରେ",
          "ଏଥିକି ରସନିଧି ନାହିଁ ତ ମହୌଷଧି",
          "ଜାଣି ଦୁଃସହ ତାପ ସହିଲୁ ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋର ଏ ଅଭିଳାଷ ଥିଲା ଯେବେ ବାଳୀଶ",
          "ଆଗରୁ ମୋତେ ଯା ନ କହିଲୁ ରେ",
          "କି ବାଇଆଣୀ ରୀତି ଆଚରିଲୁ ଶ୍ରୀମତୀ",
          "ଛାଏଁ ତ ନିନ୍ଦା ବୋଝ ବୋହିଲୁ ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଅସରନ୍ତି ତୋ ଦିନ ହେବଟି ଏ ନିଦାନ",
          "କେଉଁ କୁଳରେ ହାଦେ ନୋହିଲୁ ରେ",
          "ଗାରିମା ଗିରିଧାରୀ ସାରି ଦେଇଛି ଠାରି",
          "ବିରହାନଳେ ତନୁ ଦହିଲୁ ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଦ୍ୱିଜ ଗଉର ବୋଲେ ଶ୍ୟାମ ଶୋଭା ସଲିଳେ",
          "ନ ବିଚାରି ତ ଅବଗାହିଲୁ ରେ",
          "ଏଣିକି ବିମ୍ବାଧରୀ ରହ କର୍ମ ଆଦରି",
          "କେ କି କରିବ ଆପେ ଭ୍ୟାଇଲୁ ରେ"
        ]
      }
    ]
  },
  "sources": [
    {
