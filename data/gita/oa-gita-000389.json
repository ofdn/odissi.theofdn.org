  "name": {
    "en": "Duru kalu ki bichari re kisori",
    "or": "ଦୂରୁ କଲୁ କି ବିଚାରି ରେ କିଶୋରୀ"
  },
  "composer": "oa-person-000046",
  "mula_raga": [
    "oa-raga-000107"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/duru-kalu-ki-bichari-re-kisori/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦୂରୁ କଲୁ କି ବିଚାରି ରେ କିଶୋରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କାର ବାଣୀ ଶୁଣି ଆରେ ଗୁଣମଣି",
          "ତୁ ମୋତେ ଦେଲୁ ପାସୋରି ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତୁ ଆସିବା ପାଇଁ ଜଗି ବସିଥାଇ",
          "ଚନ୍ଦ୍ରକୁ ଚକୋର ପରି ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୁ ଅବା ଚିତ୍ତରେ ମଣିଥିବୁ ଥରେ",
          "କାହାକୁ ଚାହିଁଲା ପରି ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଭଣିଲେ ପ୍ରତାପରୁଦ୍ର ଦେବ ଭୂପ",
          "ଯୁଗଳ ପାଦେ ଜୁହାରି"
        ]
      }
    ]
  },
  "sources": [
