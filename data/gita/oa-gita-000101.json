{
  "id": "oa-gita-000101",
  "name": {
    "en": "Uthilu ede begi kahinki re",
    "or": "ଉଠିଲୁ ଏଡ଼େ ବେଗି କାହିଁକିରେ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000044"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/uthilu-ede-begi-kahinki-re-dukhidhana-gopalakrusa-kalinga-gouda/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଉଠିଲୁ ଏଡ଼େ ବେଗି କାହିଁକିରେ ଦୁଃଖୀଧନ",
          "ଦଧି ମନ୍ଥାଇ ଦେବୁ ନାହିଁକିରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦେହ ପାଶୋରି ଦଣ୍ଡେ ନିଦ ନ ଗଲୁ ଏଡ଼େ",
          "ବିଟୋଳ ହେଲୁ ମୋର ପାଇଁକିରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଖେଳିବୁ ରାମ ତୁଲେ ପଛେ ରାତି ପାହିଲେ",
          "ଶୁଆଇ ଦେବି ଗୀତ ଗାଇକିରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମନ୍ଥିବି ମୁଁ କେମନ୍ତ ଖୁଆ ଦଣ୍ଡରୁ ହାତ",
          "ଛାଡ଼ ଦେଉଛି ସର ଖୋଇକିରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଆହା ଏ କି ପ୍ରମାଦ ଛନ୍ଦନା ବାବୁ ପାଦ",
          "ଡାକ ଯା ବଳରାମ ଭାଇକିରେ"
        ]
      },
      {
        "n": 8,
        "lines": [
          "ପଣନ୍ତରେ ବଦନ ପୋଛି ଦେଲେ ଚୁମ୍ବନ",
          "ଗୋପାଳକୃଷ୍ଣ ଚିନ୍ତେ ଦୁହିଁଙ୍କିରେ"
        ]
      }
    ]
  },
