{
  "id": "oa-gita-000103",
  "name": {
    "en": "Teja manu mana",
    "or": "ତେଜ ମନୁ ମାନ"
  },
  "composer": "oa-person-000038",
  "mula_raga": [
    "oa-raga-000011"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/teja-manu-mana-manu-mana-teja/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତେଜ ମନୁ ମାନ ।",
          "ମନୁ ମାନ ତେଜ ସଜକଞ୍ଜନୟନା",
          "ପୀରତି ବିଚକ୍ଷଣାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆରେ ମହୀଶୁଆ ଉଠ ସୁନାଦେହା",
          "ଆଉ କଟାଳ କରନା",
          "ଗଣ୍ଡମଣ୍ଡଳେ ପାଣି ମଣ୍ଡନା",
          "ଜବାଧରା ଧୀରା ଧରା ଚିରନା",
          "ପୀରତି ବିଚକ୍ଷଣାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୟନୁ ଲୋତକ ନିର୍ବାର ଗୋ ମୁଖ",
          "ଟେକ ଶ୍ରୀକୁନ୍ଦରଦନା",
          "ରସେ ରସିକରାଜଙ୍କୁ ଅନା",
          "ହସି ଭାଷ ମୃଦୁ ମଧୁ ବୀଣାବଚନା",
          "ପୀରତି ବିଚକ୍ଷଣାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ତୋ ବିହୁନେ ଘାରି ହୋଇ ବଂଶୀଧାରୀ",
          "ସହି ବିରହ ବେଦନା",
          "ପାଇଲେଣି ଅଶେଷ ଯାତନା",
          "ବିନା ଦୋଷେ ରୁଷି ବସୁ ହୋଇ ବିମନା",
          "ପୀରତି ବିଚକ୍ଷଣାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚାଲ ଚାଲ ଆଜ ସାଜିଦେବି ସାଜ",
          "ସୁଝୀନ ନୀଳବସନା",
          "ଚାଲ କୁଞ୍ଜେ କୁଞ୍ଜରଗମନା",
          "ରାସ ବେଳେ ରାସବିହାରୀଙ୍କୁ ଅନା",
          "ପୀରତି ବିଚକ୍ଷଣାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
