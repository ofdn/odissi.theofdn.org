{
  "id": "oa-gita-001232",
  "name": {
    "en": "Balahaka kuntala",
    "or": "ବଳାହକ କୁନ୍ତଳା"
  },
  "composer": "oa-person-000042",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/balahaka-kuntala-asi-la-jadumani-mahapatra/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବଳାହକ କୁନ୍ତଳା ନୀଳାଚଳରେ ଖେଳା",
          "ଚଳାଇଛନ୍ତି ଚକାଡୋଳା",
          "ଚଞ୍ଚଳା ଭୋଳାହେଳା ଭାବେ ହୋଇ ନର୍ମଳା",
          "ଦାରୁଣ ମୁରାସୁର ଦଳା",
          "ସେ ହୁଳା ହୁଳା",
          "ପ୍ରବଳ ଭାବେ ଷୋଳ କଳା",
          "ଦୈତ୍ୟକୁଳାଜଳାଳୟରେ ପ୍ରହ୍ଲାଦ କଳା",
          "ନିର୍ବଳା କଲ ଜ୍ୱାଳା କିଲା । ୧ । (ସତ୍ୟ)"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଭୂପାଳକ କୌଶଲ୍ୟା ବଳାରେ ଯାଗଶାଳା",
          "ରକ୍ଷା ମିଳାଗମେଽଳର୍ଗଳା",
          "ଅଖିଳା କୁଳାକୁଳା ତୁଳାକନ୍ୟା ତୁଳାର୍ଥେ",
          "ମାର୍ଗେ ପର୍ଶୁଶିଳାଙ୍ଘ୍ରିଧୂଳା",
          "ହେ ଶିଳାବଳା",
          "ଝଳାବାଳା କରି ମିଥିଳା",
          "ଖଳାୟତେନର୍ଗଳା ଗଳାଦଶାଦି ଭେଳା",
          "ଲଙ୍କାଖଳାରେ ଧୂଳାମଳା । ୨ । (ତ୍ରେତା)"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବଳାନୁଜେ ବିକଳା ବିମଳା ଗର୍ଭସ୍ଥଳା",
          "ଯଶୋଦାବତ୍ସଳା ବର୍ତ୍ତୁଳା",
          "ନନ୍ଦଘର ଉଜ୍ଜ୍ୱଳା ମଉଳା ଅଷ୍ଟକୀଳା",
          "ମଲ୍ଲଙ୍କୁ ଝଳାଇଲ ଭୋଳା",
          "ହେ କଳାଧଳା",
          "କଳାଭୁଜଙ୍ଗ ଶିରଦଳା",
          "ଗୋଳାଚନ୍ଦନବୋଳା ଶ୍ୟାମଳାଙ୍ଗେ ନିର୍ମଳା",
          "ଖେଳାବଂଶୀବଦନ ନଳା । ୩ । (ଦ୍ୱାପର)"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ମାଳା ଧରି ପିତୁଳା ପରି ସାଧୁ କଲ୍ଲୋଳା",
          "କୁଶଳାନନ୍ଦେ କରି ଲୀଳା",
          "ଭବାର୍ଣ୍ଣବକୁ ଭେଳା ଦେଇ ହେ ଚକ୍ରଚଳା",
          "ପଳାଇଯାଅ ଦୁଃଖାକୁଳା",
          "ହେ କଳାଧଳା",
          "ଯଦୁମଣିର ଗଳା ହେଳା ହେବ ମୁକୁଳା",
          "ତେଣୁ ଏ ହୋଇଲା ଅଶୀଳା । ୪ । (କଳି)"
        ]
      }
    ]
  },
  "sources": [
