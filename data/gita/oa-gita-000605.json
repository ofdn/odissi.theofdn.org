{
  "id": "oa-gita-000605",
  "name": {
    "en": "Mo krusna chandrama pari",
    "or": "ମୋ କୃଷ୍ଣଚନ୍ଦ୍ରମା ପରି"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/mo-krusna-chandrama-pari-2/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମୋ କୃଷ୍ଣଚନ୍ଦ୍ରମା ପରି ଆନଟି କେ ଅଛି ସରି ମା"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରତ୍ନ ଚିନ୍ତାମଣି ମୋର ତ୍ରିଭୁବନ ଅଳଙ୍କାର",
          "ଦୁଃଖୀର ସଙ୍ଖାଳି ଦରିଦ୍ରର ଧନ ମୋ ଶ୍ରୀ ହରି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଝାଳରେ ତିନ୍ତି ଅଳକ ଲିଭିଯାଇଛି ତିଳକ",
          "ସ୍ତନ୍ୟ ଦେଇ ମୁଖ ବାସେ ପୋଛି ଭାଷେ ବ୍ରଜେଶ୍ୱରୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଖେଳୁଥିଲୁ କାହା ଘରେ ଧୂଳି ପୂରିଛି ଦେହରେ",
          "ଦେଖାଟି ମାଇଁକି ମୋର ବାବୁ ତୋ ବଦନ ଶିରୀ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦେଖ କାହିଁ ନାହିଁ କିଛି ଉଦର ବଳି ହେଉଛି",
          "ମୂଢ଼ ପଣେ ମୁଁ ରହିଲି ତେଣେ ଗୃହକୃତ୍ୟ କରି"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତୁମ୍ଭର ଆଶୀଷ ପାଇ ଥାଉ ଚିରଞ୍ଜିବୀ ହୋଇ",
          "ବୋଲି ମୁଖେ ମୁଖ ଦେଇ ଚୁମ୍ବନ୍ତି କାଖରେ ଧରି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କାହିଁ ରହିଥିଲୁ ଯାଇ ମୋତେ ମନେ ନ ପକାଇ",
          "ବୋଲଇ ଗୋପାଳକୃଷ୍ଣ ଖେଳରେ ଦେଲେ ପାଶୋରି"
        ]
      }
    ]
  },
  "sources": [
    {
