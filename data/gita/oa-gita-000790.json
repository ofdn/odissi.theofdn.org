{
  "id": "oa-gita-000790",
  "name": {
    "en": "Sari jiba sukha eniki go",
    "or": "ସରିଯିବ ସୁଖ ଏଣିକି ଗୋ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000098"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sari-jiba-sukha-eniki-go-bhupala-banamali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସରିଯିବ ସୁଖ ଏଣିକି ଗୋ ରାଧେ",
          "ଦରିଦ୍ରନିଧି ଘେନ ବାଣୀକି ଗୋ",
          "ନାରୀ କୁଳେ କେହି ବର୍ତ୍ତିବ ନ ଚାହିଁ",
          "ସେ ଶ୍ୟାମସୁନ୍ଦର ଠାଣିକି ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କରୀଗମନା ହରିସୁତ ଶର",
          "ମାରିଲେ ବେଳକୁ କି ଗତି ତୋର",
          "ଘାରିହେବାର ତ ହୋଇବ ନିରତ",
          "ଝୁରି ଝୁରି ବଂଶୀପାଣିକି ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବାସ ପ୍ରସାରି ଦୋଷ ମାଗିବାର",
          "ବେଳେ କରିବା ନିରାଶ ବିଚାର",
          "ହେଲା କି ମାତର ମଣିଲୁ ଇତର",
          "ପରାୟେ ତୋ ଚିନ୍ତାମଣିକି ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପାଣି ଧରି ଜଣାଉଛି ତୋ ହିତ",
          "ଜାଣି ଜାଣି ମଣି ମଣୁ ଅହିତ",
          "ଛାଣି ସୁଧା ଆଣି ଶ୍ରୀକରେ ଧରି ଯା",
          "ପାଣିକି ଫିଙ୍ଗିଲୁ ପୁଣି କି ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପଡ଼ିଲେ ତା ଗୁଣ ମନରେ ଥରେ",
          "ଘାରିହୁଏ ହୃଦ ମନମଥରେ",
          "ବୋଲେ ବନମାଳୀ ଏ ରସରେ ଭାଳି",
          "ପାଇବୁ କି ଗୁଣମଣିକି ଗୋ"
        ]
      }
    ]
  },
  "sources": [
