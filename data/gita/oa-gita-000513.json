{
  "id": "oa-gita-000513",
  "name": {
    "en": "Sukha lodi dukha re jadili",
    "or": "ସୁଖ ଲୋଡ଼ି ଦୁଃଖରେ ଜଡ଼ିଲି ଗୋ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sukha-lodi-dukha-re-jadili/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସୁଖ ଲୋଡ଼ି ଦୁଃଖରେ ଜଡ଼ିଲି ଗୋ",
          "ନାଗର ରାଜଙ୍କୁ ଚାହିଁ ।",
          "ମୋହ ପାପ ଆଖି ମୋତେ କଲା ଦୁଃଖୀ",
          "କାହାକୁ କହିବି ସହୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "କି ସୁଖରେ ଥିଲି ଜାଣି ମୁଁ ନ ଥିଲି",
          "ଅନାଇଁ ଦେଲେ ପ୍ରମାଦ",
          "ଦେଖି ଛାଡ଼ି ନୋହେ ଛାଡ଼ିଲେ ବିଦେହେ",
          "ଚଳେ ଲୋକ ଅପବାଦ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ନୟନ ଯୁଗଳୁଁ ଜାଣିବାରେ ଜଳ",
          "ବହି ନ ଥିଲା ମୋହର",
          "ଏବେ ସେ କଜ୍ଜ୍ୱଳ ସହିତରେ ବୋଳ",
          "ବହି ହେଲା ହୃଦ ହାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନିରତରେ ଜର କରି ଜରଜର",
          "ସ୍ୱେଦରେ ହୋଇଲା ତନୁ",
          "ରଜନୀ ବାସର ହୋଇଲା ଅସର",
          "ନିମିଷେ ନ ଯାଏ ମନୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ବନମାଳୀ ଭଣି ଆଗୋ ଠାକୁରାଣୀ",
          "ଶିରୋମଣି ଶୁଣ ଶୁଣ",
          "ନେତ୍ରରଟି ବଶ ହୋଇଗଲେ ନାଶ",
          "କରଇ ଉତ୍ତମ ଗୁଣ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/sukha-lodi-dukha-re-jadili/"
    }
  ],
