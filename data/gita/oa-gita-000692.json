{
  "id": "oa-gita-000692",
  "name": {
    "en": "Hrude nachai se bhaba",
    "or": "ହୃଦେ ନାଚଇ ସେ ଭାବ"
  },
  "composer": "oa-person-000121",
  "mula_raga": [
    "oa-raga-000059"
  ],
  "mula_tala": [
    "oa-tala-000002"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/hrude-nachai-se-bhaba-punnaga-birabikrama/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ହୃଦେ ନାଚଇ ସେ ଭାବ ତୋର",
          "ନବ ରସିକାବର"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଦିନେ ଏକାନ୍ତରେ ଏକାନ୍ତ ଚିତ୍ତରେ",
          "ଶୋଇଥିଲୁ ମାଡ଼ି କର",
          "ନୀବିକି ତୋହର ଧରନ୍ତେ ସୁଧୀର",
          "ଡାକିଲୁ କାହିଁର ଚୋର"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ବିପରୀତ ରତେ ସୁରତ ପ୍ରମତ୍ତେ",
          "କମ୍ପୁଥାଇ କଳେବର",
          "ସେହି କାଳେ ବଳେ ଗଣ୍ଡେ ତୋ ଚୁମ୍ବିଲେ",
          "କରୁ ଯା ଅଙ୍ଗ ବିକାର"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଲେ ମୁହିଁ ଦୋଷ କଲା ପରି ରୋଷ",
          "ନ କହୁ ସହର୍ଷ ଗିର",
          "ହେଲେ ମୁଁ ବିନୟୀ ବାରେ ନ ଅନାଇ",
          "ପଛ କରୁକି ସୁନ୍ଦର"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଦିନେ ନିଧୁବନେ ବିରସ ବଦନେ",
          "ମୋ ଉରେ ଦେଇ ତୁ କର",
          "ଇଷି ଇଷି ଭାଷି ହୋଇଣ ପ୍ରେୟସୀ",
          "ବୋଇଲୁ ନୁହଁ ନିଷ୍ଠୁର"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ଶ୍ରୀ ବୀରବିକ୍ରମ ବୋଲେ ମୋତେ ବାମ",
          "ହେଲେ ଗଙ୍ଗାଧର ପର",
          "ବିଚାରି ସୁଚିତ୍ତେ ଆଶ୍ୱାସିଣ ମୋତେ",
          "କହୁ ଯେମନ୍ତ ପ୍ରକାର"
        ]
      }
    ]
  },
  "sources": [
    {
