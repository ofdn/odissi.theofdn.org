      "url": "https://odissimusic.co.in/index.php/song/saja-saja-baraji-aja-mukhari-ekatali/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ସାଜ ସଜ ବରଜି ଆଜ ଲାଜ",
          "ସାଜ ଧନୀ ସଜନୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସାରସାକ୍ଷୀ ଘନନୀଳ କୁନ୍ତଳା",
          "ଘନେ ଚପଳା ପରାୟ ଚପଳା",
          "ଘନ ନିତମ୍ବିନୀ ସଘନ କମ୍ପନ",
          "ଦେଖରେ ବାରିଦେ",
          "(ପଡ଼ି)",
          "ବକାଳିକା ମାଳିକା ଚାଳିଲେଣି ତରକା",
          "ଶ୍ରୁତି ବରଷିଲାଣି",
          "ତୃଷାତୁର ତୃପତି ମତି",
          "ମୁଞ୍ଚ ପଞ୍ଚଶର ଚାହିଁ",
          "ସଜନୀ ସଜନୀ ସଜନୀ"
        ]
      }
    ]
  },
