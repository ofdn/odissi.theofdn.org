{
  "id": "oa-gita-000105",
  "name": {
    "en": "Aja mu dekhili ghanasyamaku go",
    "or": "ଆଜ ମୁଁ ଦେଖିଲି ଘନଶ୍ୟାମକୁ ଗୋ"
  },
  "composer": "oa-person-000037",
  "mula_raga": [
    "oa-raga-000037"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/aja-mu-dekhili-ghanasyamaku-go/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆଜ ମୁଁ ଦେଖିଲି ଘନଶ୍ୟାମକୁ ଗୋ",
          "ଦେଖିଲି ଦେଖିଲି ଘନଶ୍ୟାମକୁ ଗୋ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସେବତୀ ପାଖୁଡ଼ା ବେଢ଼ା",
          "ସତୀଙ୍କ ବରତଛଡ଼ା",
          "କିଛି ଢଳିଅଛି ଚୂଳ ବାମକୁ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ତା ଛବି ଉପରେ ମିତ",
          "ପଡ଼ି ବୁଡ଼ିଗଲା ଚିତ୍ତ",
          "କେ ଗଢ଼ିଛି ଏ ସୁନ୍ଦର ଧାମକୁ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଆହା ସେ ଲାବଣ୍ୟମୂର୍ତ୍ତି",
          "ଦର୍ଶନେ ହରିବ ଧୃତି",
          "ନିଉଛାଳି ହେବି ନନ୍ଦକାହ୍ନୁକୁ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରାମକୃଷ୍ଣ ବୋଲେ ମିତ",
          "ଯାହା ହେଉଅଛି ଚିତ୍ତ",
          "ପୂର୍ଣ୍ଣ କରି ନ ପାରିଲି କାମକୁ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
