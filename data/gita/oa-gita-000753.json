{
  "id": "oa-gita-000753",
  "name": {
    "en": "Kede sobha kunja bana",
    "or": "କେଡ଼େ ଶୋଭା କୁଞ୍ଜବନ"
  },
  "composer": "oa-person-000110",
  "mula_raga": [
    "oa-raga-000150"
  ],
  "mula_tala": [
    "oa-tala-000011"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/kede-sobha-kunja-bana-todiparaja-gouracharana/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଡ଼େ ଶୋଭା କୁଞ୍ଜବନ ଗୋ ସଜନୀ",
          "କେଡ଼େ ଶୋଭା କୁଞ୍ଜବନ",
          "ନାନା କୁସୁମିତ ତରୁଲତା ବ୍ରାତ",
          "ଅନା ଅନା କି ଯତନ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଯହିଁ ବିହରନ୍ତି ନୀଳମଣି ହାତୀ",
          "ଯଶୋଦା ନନ୍ଦନନ୍ଦନ",
          "କି ଉପମା ଦେବା ସରିକି ମଘବା",
          "ନିଳୟ ନନ୍ଦନ ବନ ଗୋ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁନ୍ଦନ ପ୍ରତିମା ବୃଷଭାନୁ ଜେମା",
          "ଯହିଁ କରେ ବିହରଣ",
          "ଭୂମି ଚିନ୍ତାମଣି କଳ୍ପଦ୍ରୁମ ଶ୍ରେଣୀ",
          "ଅଗଣନ ବିଦ୍ୟମାନ ଗୋ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଶୁକ ପିକ ସାରୀ ମୟୂର ମୟୂରୀ",
          "ଭୃନ୍ଦ ଭ୍ରମରିକାଗଣ",
          "ଜୟ ରାଧେ ଶ୍ୟାମ ବୋଲିକି ସୁଷମ",
          "କରୁଛନ୍ତି ମୃଦୁ ଗାନ ଗୋ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ପରା ଚିରଦିନ ବସନ୍ତ ରାଜନ",
          "ଷଡ଼ଋତୁ ସହିତେଣ",
          "ସେବଇ ସନ୍ତତ ଯୁଗଳ ଚରଣ",
          "ଫୁଟାଇ ସର୍ବ ସୁମନ ଗୋ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରତ୍ନବେଦିକାରେ ରତନ ଆସନେ",
          "ବିଜୟେ ରାଧା ମୋହନ",
          "ସତେ ଏଡ଼େ ଭାଗ୍ୟ ଦରଶନ ଯୋଗ୍ୟ",
          "ହେବ ଗଉରଚରଣ ଗୋ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
