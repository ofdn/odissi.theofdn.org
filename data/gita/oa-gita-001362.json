    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ତାଙ୍କୁ ମନା ରେ ସଜନୀ",
          "ମୁଁ ନୁହଇଁ ଚନ୍ଦ୍ରାବଳୀ ସୁମନା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସତ ନାହିଁ ଯାର ସତୀଙ୍କ ଠାରେ",
          "ତା ସଙ୍ଗେ ମୁଁ ପ୍ରୀତି କଲି ବୃଥାରେ",
          "(ପଡ଼ି)",
          "ପରତେ ନ ଯିବି ଆଉ ଏଣିକି",
          "କୂଟ କପଟିଆ ଚିନ୍ତାମଣିକି",
          "ବୋଲେ ବେଣୁଧର ଆଗୋ କିଶୋରୀ",
          "ସତେ କି ବନ୍ଧୁକୁ ଦେବୁ ପାଶୋରି"
        ]
      }
    ]
  },
