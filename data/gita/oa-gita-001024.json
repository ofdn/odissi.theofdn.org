{
  "id": "oa-gita-001024",
  "name": {
    "en": "Asile nahin kahin pain",
    "or": "ଆସିଲେ ନାହିଁ କାହିଁ ପାଇଁ"
  },
  "composer": "oa-person-000061",
  "mula_raga": [
    "oa-raga-000063"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "kabya": {
    "id": "oa-kabya-000009"
  },
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/asile-nahin-kahin-pain-syama-asabari-raghunatha-parichha-gopinatha-ballabha-nataka/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଆସିଲେ ନାହିଁ କାହିଁ ପାଇଁ ଶ୍ୟାମ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଆସିବି ବୋଲି କହି ଆଣି କୁଞ୍ଜେ ଜଗାଇ",
          "ତୋଷିଲେ କାହା ମନ ସେହି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ସଖାଏ କଉତୁକେ ସଙ୍ଗେ ହୋଇ ଉତ୍ସୁକେ",
          "ରଖାଇଲେ କି ଅଟକାଇ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଅନ୍ଧକାର ବଣରେ ଆସନ୍ତେ ସଙ୍କେତରେ",
          "ବନ୍ଦ ହେଲେ କି କେଉଁଠାରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "କହଇ ରଘୁନାଥ କବି ରଜନୀନାଥ",
          "ଶ୍ରୀହରି ପାଦପଦ୍ମ ଧ୍ୟାଇ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
