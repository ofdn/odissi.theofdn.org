    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନିନୀ ରେ ମାନ ତେଜ ଏଣିକି"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ସଜଳ ନୟନେ କଜ୍ଜ୍ୱଳ ଲଗାଇ",
          "ସଜାଇ ଦେଲା କେ ଫୁଲ ବେଣୀ",
          "(ପଡ଼ି)",
          "ଅଭିସାରେ ସାଜ ସାଜି ଆଜି ଗୋରୀ",
          "ନୂପୁର ବଜାଇ ଚାଲେ ଥିରିଥିରି",
          "କଟୀରେ କିଙ୍କିଣୀ ବାଜେ କିଣିକିଣି",
          "ଏଣୀନୟନା ସେ ମଧୁ ଛାଣିକି"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଡାକେ ମୁରଲୀ ରାଧା ରାଧା ବୋଲି",
          "ନୀଳ ନଭେ ଶଶୀ ଖେଳେ ଲୁଚକାଳି",
          "ଯମୁନା ତଟିନୀ ବହଇ ଊଜାଣି",
          "ସରାଗରେ ଘେନି ସଖୀ ଶ୍ରେଣୀକି"
        ]
      }
    ]
  },
