{
  "id": "oa-gita-000730",
  "name": {
    "en": "Nagariki e kale tejili",
    "or": "ନାଗରୀକି ଏ କାଳେ ତେଜିଲି"
  },
  "composer": "oa-person-000122",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "mula_tala": [
    "oa-tala-000003"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nagariki-e-kale-tejili-jagannatha-gajapati/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନାଗରୀକି ଏ କାଳେ ତେଜିଲି",
          "ମୋ ବିନା କେହି ବଞ୍ଚିବ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଅନଳପ ଶତପତ୍ର ପାତ ପତ୍ରାବଳୀ",
          "ଅଳପ ମହୀ ତଳପ",
          "ଅଳପ ମହୀ ଅଙ୍ଗେ ସଙ୍ଗେ ରଙ୍ଗେ",
          "ଝାଞ୍ଜିବଜା ବାତେ ଲତିକା ପରାୟେ",
          "ଲୁଳେ ଲୁଳିବ ଧରାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମନୋହର ଘନସାର ନଳଦା ଅଗୁରୁ ଧୂପ",
          "ସମ୍ବର ମଣିଧର ନୀଳକଣ୍ଠ ବିଷର",
          "ଧାର ବରଜିବ ଲେଖା ପରି ବୃଷ",
          "ନିଶି କାରେ ରସିବେ ସରସେ ଧରାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ବ୍ରଜରାଜ ସୁତ ବାଣୀ ଦୂତିକା ଶୁଣି ସେକ୍ଷଣି",
          "ହରଷେ କିଶୋରୀ ପାଶେ",
          "ନିବେଦନ କଲା ଅବିଳମ୍ବରେ",
          "ଶ୍ୟାମ ମନ ରଖି ମହିଳାବର ଭାଷେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସହଚରୀ ସମ୍ବୋଧନେ ଶ୍ରୀମତୀ ପ୍ରଫୁଲ୍ଲ ମନେ",
          "ବିଜେ କଲେ ବୃନ୍ଦାବନେ ସଖି ନିକର ଚଳିଲେ",
          "ସମ୍ଭାର ସାଜି ଗହଣେ",
          "ରାଜକୁମାର ଶ୍ରୀ ଜଗନ୍ନାଥ ଦେବ ରସେ ଭଣେ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
