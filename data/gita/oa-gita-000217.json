  "id": "oa-gita-000217",
  "name": {
    "en": "Rasalasa re rasi puni",
    "or": "ରସାଳସା ରେ ରସି ପୁଣି"
  },
  "composer": "oa-person-000002",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "kabya": {
    "id": "oa-kabya-000001",
    "section": {
      "en": "Ra Patala",
      "or": "ର ପଟଳ"
    }
  },
  "song_type": "champu",
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/rasalasa-re-ra-champu-bhairabi-kabisurjya/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ରସାଳସା ରେ",
          "ରସି ପୁଣି ଏକି ଲୋକହସା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ରକ୍ତିମା ଚୁମ୍ବିଲା ଇନ୍ଦ୍ର ଆଶାରେ",
          "ରାଜୀବେ ପ୍ରଫୁଲ୍ଲ ହେଲେ କାସାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ରତିନାଥ ସମର ପ୍ରଶଂସାରେ",
          "ରମଣୀ କେ ନ ରସନ୍ତି ସଂସାରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ରସିକେ ରସନ୍ତି ସିନା ନିଶାରେ",
          "ରଜନୀ ଶେଷରେ ଏ କି ଦଶା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ରହୁନା ଅଯଶ ଆଉ ରସାରେ",
          "ରସାରୁହରୁ ଲତାକୁ ଖସା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ରମଣୀୟ ହେମକୁ ସୁଦୃଶା ରେ",
          "ରଖିଲୁ କେଡ଼େ ନିବିଡ଼େ ମସାରେ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ରାଜା ଅଷ୍ଟଦୁର୍ଗର ଏ ଭାଷା ରେ",
          "ରଚେ ବିଜେ ଏବେ ହେଉ ସୁସାରେ"
        ]
      }
    ]
  },
  "sources": [
    {
