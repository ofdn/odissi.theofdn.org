{
  "id": "oa-gita-000566",
  "name": {
    "en": "Manasa bhaba radha madhaba",
    "or": "ମାନସ ଭାବ ରାଧା ମାଧବ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000140"
  ],
  "mula_tala": [
    "oa-tala-000001"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/manasa-bhaba-radha-madhaba/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ମାନସ ଭାବ ରାଧା ମାଧବ",
          "ନୂତନ ଭେଟ ମହୋତ୍ସବ ମାଧୁରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶ୍ୟାମ କୁଞ୍ଜରେ ରାଧା ଆଜିରେ",
          "ତାର ତରଳ ଡୋଳା ଖେଳା ଚାତୁରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଆଳି ନିକରେ କେଳି ମନ୍ଦିରେ",
          "ଦୁଆରେ ଛାଡ଼ି ଦେବାର କର ଧରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ସଙ୍ଗିନୀ ବାସ ନ ତେଜ ରାସ",
          "ରଙ୍ଗିନୀ ଥକିବାର ଲାଜେ ଓହରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ସଖୀ ହସନ୍ତି ଥରୁଁ ଶ୍ରୀମତୀ",
          "ଆସୁ ନିକଟକୁ ନିକୁଞ୍ଜ ବିହାରୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ପ୍ରମତ୍ତେ ଗଜ ହେମ ପଙ୍କଜ",
          "ନେଲାପରି ହେବାର ନବ କିଶୋରୀ"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ହେଲା ସତୃଷ୍ଣ ଗୋପାଳକୃଷ୍ଣ",
          "ଧୀରେ କବାଟ ପୁଟ ଆଣି ଓଟାରି"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
