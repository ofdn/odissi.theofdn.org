{
  "id": "oa-gita-001187",
  "name": {
    "en": "Keun dina jana ghora dukha",
    "or": "କେଉଁ ଦୀନଜନ ଘୋର ଦୁଃଖ"
  },
  "composer": "oa-person-000043",
  "mula_raga": [
    "oa-raga-000134"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/keun-dina-jana-ghora-dukha-dinabandhuraja-harichandana-todi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "କେଉଁ ଦୀନଜନ ଘୋର ଦୁଃଖ ଲଭି ମନରେ",
          "ଦୁଃଖ ନିବେଦନା କରେ ନିଜ ପ୍ରଭୁ",
          "ଶ୍ରୀ ରାଧାକାନ୍ତ ଛାମୁରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ହେ ପ୍ରଭୁ କର ମୋରେ ଅବଧାନ",
          "ସଦୟ ବା ନିର୍ଦ୍ଦୟ ବା ହୁଅ",
          "ତୁମ୍ଭ ବିନା ତ ମୋ ନାହିଁ ଆନ ହେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ପ୍ରଭୁ ମୋ ଅପରାଧ ବଳରୁ",
          "ସର୍ବଜନ ହୋଇଲେଣି ଦୁଃଖୀ",
          "ଏଥି ଯେ ଉଚିତ ବିଚାରି ହେ ପ୍ରଭୁ",
          "ତୁମ୍ଭ ସ୍ଥାନ କର ସୁଖୀ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ଯମନ ଶମନ ପରା ବେଢ଼ିଛନ୍ତି",
          "ଗମନ ଶକ୍ତି ମୋ ନାହିଁ",
          "ବାତଘାତ ବଜ୍ରଘାତରୁ ବଳିଛି",
          "ସୁଖ ଲେଶ ମୋର କାହିଁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ମୋ ଦଶା ଦେଖି ଛାଡ଼ିଲେଣି କୁଟୁମ୍ବ",
          "ଭୃତ୍ୟ ମିତ୍ରାଦି ସକଳେ",
          "ଜାଣୁ ନାହିଁ କେଉଁ ହେତୁରୁ ରହିଛି",
          "ପରାଣ ଅତି ବିକଳେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ତୁମ୍ଭେ ମୋ ପ୍ରଭୁ କୁଳଦେବ ଏ ଦୁଃଖ",
          "ନାଶିବ କେ ତୁମ୍ଭ ବିନା",
          "ଜୀବନ ଥାଇ ମୃତ୍ୟୁ ପ୍ରାୟେ ହେବାର",
          "ଏ ଲଜ୍ଜ୍ୟା ତୁମ୍ଭର ସିନା"
        ]
      },
      {
        "n": 6,
        "lines": [
          "ଦିନେ ତୁମ୍ଭ ଜନ ସଙ୍ଗେ ତୁମ୍ଭ ମୂର୍ତ୍ତି",
          "ଶୋଭା ନ କଲି ଲୋକନ",
          "ବୋଲେ ଦୀନବନ୍ଧୁ ବ୍ୟର୍ଥ ଜନ୍ମ ହେଲା",
          "ଧିକ ହାରି ମୋ ଜୀବନ"
        ]
      }
    ]
  },
  "sources": [
    {
      "source": "oa-source-000001",
