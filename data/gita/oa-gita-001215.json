{
  "id": "oa-gita-001215",
  "name": {
    "en": "Ghanasyama prema bhabana",
    "or": "ଘନଶ୍ୟାମ ପ୍ରେମ ଭାବନା"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000022"
  ],
  "mula_tala": [
    "oa-tala-000006"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/ghanasyama-prema-bhabana-bhairabi-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଘନଶ୍ୟାମ ପ୍ରେମ ଭାବନା",
          "ବନଜାକ୍ଷି ଜାଣୁ ତୁ ସିନା",
          "ମାନ କଲା ପରି ମନ ଘେନିବାର",
          "ଆନ ଜାଣିବ କେହି ତୋ ବିନାରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଡାକୁ ବନମାଳୀ ଲୁକୁଯାଇ ଆଳି",
          "ଆଳୀ ପଛରେ ତୁ ଲୋଳଲୋଚନା ରେ",
          "ମୁନି ପରି ତୁନି ହୋଇ ଚନ୍ଦ୍ରାନନୀ",
          "ଶାଢ଼ୀ ବାଡ଼ ନଖେ ଘଷୁ ସୁମନାରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ଦଣ୍ଡେ ନ ଦେଖିଲେ ଗଣ୍ଡେ କର ଦେଇ",
          "କେତେ ଲୁହ ପୋଛୁ ହୋଇ ବିମନା ରେ",
          "ଆସିଲେ ଛାମୁକୁ ନ ଚାହିଁ ମୁହଁକୁ",
          "ସହୀ ମୂଳେ କରାଉ ସମ୍ଭାବନା ରେ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ନୀରଦ ନିବହ ନିରେଖି ଯା ଦେହ",
          "ତୁଲ ରୁଚି ଭାବି ହରୁ ଚେତନା ରେ",
          "ନିକଟ ହେଲେ ସେ ନିକୁଞ୍ଜ ପ୍ରବେଶେ",
          "ଥରି ଥାଉ ତୁ କୁଙ୍କୁମ ବରନା ରେ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଚନ୍ଦନ ଗୋଳାଇ ପ୍ରିୟ ଆଗେ ଯାଇ",
          "ରହୁ ଉଭା ହୋଇ କୁନ୍ଦରଦନା ରେ",
          "ଲାଜେ ଦରହାସୀ ଦନ୍ତବାସ ଦଂଶି",
          "ବୋଳୁ ତୋଳି ଭୁଜ ଘନଜଘନା ରେ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ନତି କଲେ ହରି ନାହିଁ କଲା ପରି",
          "ଏଣେ ଆଚରୁ ଧରଣୀ ମଣ୍ଡନା ରେ",
          "ଗୋପାଳକୃଷ୍ଣ ସେ ଶ୍ରୀମତୀଙ୍କୁ ଭାଷେ",
          "ତେଣେ ପୂରାଉ ପ୍ରାଣେଶ କାମନା ରେ"
        ]
      }
    ]
  },
  "sources": [
