    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ବିନା କାରଣରେ ତୁ ସୁନାଜିତ",
          "ବରବରନା କେଣେ ହେଉ ବିମନା ରେ ।",
          "ମନାସି କିସ ମନେ ଅନାଦର ବହିଛୁ",
          "ଅନା ଶ୍ୟାମେ ହୋଇ ସୁମନା ରେ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଘେନାଇ କହିଲେ ନ ଅନାଉ ଭାଳି ଭାଳି",
          "ସୁନାଦେହକୁ କରୁ ଚୂନା ରେ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ମନା କର ନା ଧନ ମନାଇ କହୁଛି",
          "ସେ ସିନା ଆମ ଜୀବନ କିନା ରେ"
        ]
      }
    ]
  },
  "sources": [
