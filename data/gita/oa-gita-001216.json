{
  "id": "oa-gita-001216",
  "name": {
    "en": "Dekhaiba ki sate daiba",
    "or": "ଦେଖାଇବ କି ସତେ ଦଇବ"
  },
  "composer": "oa-person-000001",
  "mula_raga": [
    "oa-raga-000064"
  ],
  "mula_tala": [
    "oa-tala-000005"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/dekhaiba-ki-sate-daiba-radha-gobinda-madhuri-paraja-gopalakrusna/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ଦେଖାଇବ କି ସତେ ଦଇବ ରାଧାଗୋବିନ୍ଦ ମାଧୁରୀ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ବ୍ରଜେନ୍ଦ୍ର ପୁରରେ ରନ୍ଧନ କାଳରେ",
          "ରସବତୀରେ ଶ୍ରୀ ରାସେଶ୍ୱରୀ",
          "ସୁବେଶ ହୋଇ ରମଣ ଆହା ସେ ଚାରି ଈକ୍ଷଣ",
          "ଢଳାଢଳି ହୋଇବାର ଚାତୁରୀ ରେ ଚାତୁରୀ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "କୁସୁମ ଅବଚୟନ କାଳରେ ଆସି ମୋହନ",
          "ରହିଲେ ଶ୍ରୀକିଶୋରୀ ଛାମୁରେ",
          "ଗଣ୍ଡଦେଶରେ ବସନ ସଲଜ୍ଜେ କରି ଆଚ୍ଛନ୍ନ",
          "ବଲ୍ଲୀ ଆଡ଼କୁ ଯିବାର ବାହାରି ରେ ବାହାରି"
        ]
      },
      {
        "n": 3,
        "lines": [
          "ପୁଷ୍ପେ ତୋଳି ବନମାଳୀ ଯାଚିଲେ କରି ଅଞ୍ଜଳୀ",
          "ନ ଅନାଇ ତୁନି ହୋଇ ରହି",
          "ଶାଢ଼ୀ ବାଡ଼ ନଖେ ଘଷୁ ଶ୍ୟାମ ନିକଟକୁ ଆସୁ",
          "ଛୁଅନା ବୋଲିବାର ସେ ଓହରି ରେ ଓହରି"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ଉଦିତ ନାନା ବିକାର ଭୂଷାରେ ଶ୍ରୀକଳେବର",
          "ଭୂଷିତ ହୋଇ ପ୍ରଣୟ ଜ୍ୟୋତି",
          "ଜାଣୁନି ଲଳିତା ସହୀ ଛନ୍ତି ଦେବେଟି କହି",
          "ବୋଲିବାର ନଚାଇ ସେ ଭ୍ରୂବଲ୍ଲୀ ରେ ଭ୍ରୂବଲ୍ଲୀ"
        ]
      },
      {
        "n": 5,
        "lines": [
          "ମଧୁବ୍ରତ ବେଢ଼ୁ ପାଶେ ମୋହନ ରହି ପାରୁଶେ",
          "ବାସ ଶେଷେ ନିବାରୁ ଦେବାରୁ",
          "ଯାଉଛି ବୋଲି ବାହାରି ସି ହସି ଶ୍ରୀକିଶୋରୀ",
          "ଚାଳୁ ପଦ ଚେଳ ଅଙ୍କେ ସମ୍ଭରି ରେ ସମ୍ଭରି"
        ]
      },
      {
        "n": 6,
        "lines": [
          "କରି ଅରଣ୍ୟ ଭ୍ରମଣ ଜଗତ ବଇଲକ୍ଷଣ",
          "ସୁମନସ ସ୍ରଜର ସୁଷମା",
          "କି ଉପମା ରମା ଉମା କି ମଦନ କି ଚନ୍ଦ୍ରମା",
          "ନ ଥିବ ଯେ ପରଂବ୍ୟୋମ ସେପାରି ରେ ସେପାରି"
        ]
      },
      {
        "n": 7,
        "lines": [
          "ନାଗକେଶର କୁଞ୍ଜର ରତ୍ନ ବୋଳାର ବେହାର",
          "ସହୀ ସହି କରି ଆରୋହଣ",
          "ବୃନ୍ଦା ଧୀରେ ପହଞ୍ଚାଉ ଆହା ହୁଳହୁଳି ଦେଉ",
          "ଉଚ୍ଛଳନ୍ତା ଆନନ୍ଦାବ୍ଧି ମୋହରି ରେ ମୋହରି"
        ]
      }
    ]
  },
