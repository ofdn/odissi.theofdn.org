{
  "id": "oa-gita-001363",
  "name": {
    "en": "Nirekhi chahan re sakhi",
    "or": "ନିରେଖି ଚାହାଁରେ ସଖୀ"
  },
  "composer": "oa-person-000026",
  "mula_raga": [
    "oa-raga-000012"
  ],
  "mula_tala": [
    "oa-tala-000004"
  ],
  "text": {
    "edition": {
      "source": "oa-source-000001",
      "url": "https://odissimusic.co.in/index.php/song/nirekhi-chahan-re-sakhi/"
    },
    "stanzas": [
      {
        "n": 0,
        "lines": [
          "ନିରେଖି ଚାହାଁରେ ସଖୀ ସେ କଦମ୍ବ ମୂଳକୁ",
          "ସଂସାର ସାର ସୁଷମା ହୋଇବ କି ତୁଳକୁ"
        ]
      },
      {
        "n": 1,
        "lines": [
          "ଶିରେ ବାଙ୍କଚୂଳ ଶିଖୀପୁଚ୍ଛ ଚଳାଚଳକୁ",
          "ବିଲୋକିଲେ ସତୀଧୃତି ରହିବ କି କାଳକୁ"
        ]
      },
      {
        "n": 2,
        "lines": [
          "ହୃଦେ ବନମାଳ କର୍ଣ୍ଣେ ମକର କୁଣ୍ଡଳକୁ",
          "ହସାମିଶା ଭାଷା ଭଙ୍ଗୀ ହୃଦାଞ୍ଚଳ ତଳକୁ"
        ]
      },
      {
        "n": 3,
        "lines": [
          "କଟୀରେ ପୀତ ଅମ୍ବର କ୍ଷୁଦ୍ର ଘଣ୍ଟିମାଳାକୁ",
          "ମଞ୍ଜୁ ମଞ୍ଜରୀ ଚରଣେ ହୋଇଅଛି ମେଳକୁ"
        ]
      },
      {
        "n": 4,
        "lines": [
          "ତ୍ରିତାପେ ତାପିତ ହୋଇ ସଦା ଭବଜଳକୁ",
          "ଦୀନ ବନମାଳୀ ହେଜୁଥାଇ ପଦତଳକୁ"
        ]
      }
    ]
  },
  "sources": [
    {
